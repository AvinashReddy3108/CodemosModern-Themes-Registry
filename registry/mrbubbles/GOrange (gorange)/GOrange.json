        "titleBar.inactiveBackground": "#ff5800",
        "titleBar.inactiveForeground": "#ffffff",
        "titleBar.border": "#ff5800",
        "window.activeBorder": "#ff5800",
        "window.inactiveBorder": "#ff5800"
