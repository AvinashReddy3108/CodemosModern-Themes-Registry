    "semanticHighlighting": true,
    "semanticTokenColors": {
        "comment": { "foreground": "#5A7585", "fontStyle": "normal" },
        "string": "#869900",
        "keyword": "#CB4C16",
        "number": "#D4A52A",
        "type": "#A15DA1",
        "class": "#A15DA1",
        "function": "#268BD2",
        "method": "#268BD2",
        "property": "#2DA198",
        "variable": "#A8BCC9",
        "parameter": "#D4A52A",
        "interface": "#A15DA1",
        "enum": "#A15DA1",
        "enumMember": "#D4A52A",
        "struct": "#A15DA1",
        "typeParameter": "#A15DA1",
        "operator": "#CB4C16",
        "namespace": "#A15DA1",
        "decorator": "#268BD2",
        "macro": "#268BD2",
        "regexp": "#2DA198",
        "variable.readonly": "#A8BCC9",
        "variable.defaultLibrary": "#CB4C16",
        "function.defaultLibrary": "#CB4C16",
        "method.defaultLibrary": "#CB4C16",
        "class.defaultLibrary": "#A15DA1",
        "type.defaultLibrary": "#A15DA1",
        "selfParameter": { "foreground": "#D4A52A", "fontStyle": "normal" },
        "magicFunction": { "foreground": "#268BD2", "fontStyle": "normal" }
    },
    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "fontStyle": "italic", "foreground": "#5A7585" }
        },
        {
            "name": "String",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#869900" }
        },
        {
            "name": "Number",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#D4A52A" }
        },
        {
            "name": "Boolean",
            "scope": ["constant.language.boolean"],
            "settings": { "foreground": "#D4A52A" }
        },
        {
            "name": "Null",
            "scope": ["constant.language.null", "constant.language.undefined"],
            "settings": { "foreground": "#D4A52A" }
        },
        {
            "name": "Keyword",
            "scope": ["keyword", "keyword.control"],
            "settings": { "foreground": "#CB4C16" }
        },
        {
            "name": "Storage",
            "scope": ["storage", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#CB4C16" }
        },
        {
            "name": "Operator",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#CB4C16" }
        },
        {
            "name": "Function",
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#268BD2" }
        },
        {
            "name": "Method",
            "scope": ["entity.name.method"],
            "settings": { "foreground": "#268BD2" }
        },
        {
            "name": "Type",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.type",
                "support.class"
            ],
            "settings": { "foreground": "#A15DA1" }
        },
        {
            "name": "Variable",
            "scope": ["variable", "entity.name.variable", "variable.other"],
            "settings": { "foreground": "#7A94A0" }
        },
        {
            "name": "Parameter",
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#D4A52A" }
        },
        {
            "name": "Property",
            "scope": ["variable.other.property", "support.type.property-name"],
            "settings": { "foreground": "#2DA198" }
        },
        {
            "name": "Constant",
            "scope": ["constant", "variable.other.constant"],
            "settings": { "foreground": "#D4A52A" }
        },
        {
            "name": "Tag",
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#D4A52A" }
        },
        {
            "name": "Attribute",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#2DA198" }
        },
        {
            "name": "Punctuation",
            "scope": ["punctuation"],
            "settings": { "foreground": "#A8BCC9" }
        },
        {
            "name": "Self Parameter Python",
            "scope": [
                "variable.language.special.self.python",
                "variable.parameter.function.language.special.self.python"
            ],
            "settings": { "foreground": "#D4A52A", "fontStyle": "normal" }
        },
        {
            "name": "Magic Function Python",
            "scope": ["support.function.magic.python"],
            "settings": { "foreground": "#268BD2", "fontStyle": "normal" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#CC5555" }
        },
        {
            "name": "Colors",
            "scope": ["constant.other.color"],
            "settings": { "foreground": "#A8BCC9" }
        },
        {
            "name": "Operator, Misc",
            "scope": [
                "keyword.control",
                "constant.other.color",
                "punctuation.definition.tag",
                "punctuation.separator.inheritance.php",
                "punctuation.definition.tag.html",
                "punctuation.definition.tag.begin.html",
                "punctuation.definition.tag.end.html",
                "punctuation.section.embedded",
                "keyword.other.template",
                "keyword.other.substitution"
            ],
            "settings": { "foreground": "#CB4C16" }
        },
        {
            "name": "Function, Special Method",
            "scope": [
                "entity.name.function",
                "variable.function",
                "support.function",
                "keyword.other.special-method"
            ],
            "settings": { "foreground": "#268BD2" }
        },
        {
            "name": "Block Level Variables",
            "scope": ["meta.block variable.other"],
            "settings": { "foreground": "#A8BCC9" }
        },
        {
            "name": "Other Variable, String Link",
            "scope": ["support.other.variable", "string.other.link"],
            "settings": { "foreground": "#A8BCC9" }
        },
        {
            "name": "Number, Constant, Function Argument, Tag Attribute, Embedded",
            "scope": [
                "constant.numeric",
                "support.constant",
                "constant.character",
                "constant.escape",
                "keyword.other.unit",
                "keyword.other",
                "constant.language.boolean"
            ],
            "settings": { "foreground": "#D4A52A" }
        },
        {
            "name": "String, Symbols, Inherited Class",
            "scope": [
                "string",
                "constant.other.symbol",
                "constant.other.key",
                "meta.group.braces.curly constant.other.object.key.js string.unquoted.label.js"
            ],
            "settings": { "foreground": "#869900" }
        },
        {
            "name": "Class, Support",
            "scope": [
                "entity.name",
                "support.type",
                "support.class",
                "support.other.namespace.use.php",
                "meta.use.php",
                "support.other.namespace.php",
                "markup.changed.git_gutter",
                "support.type.sys-types"
            ],
            "settings": { "foreground": "#A15DA1" }
        },
        {
            "name": "CSS Class and Support",
            "scope": [
                "source.css support.type.property-name",
                "source.sass support.type.property-name",
                "source.scss support.type.property-name",
                "source.less support.type.property-name",
                "source.stylus support.type.property-name",
                "source.postcss support.type.property-name",
                "support.type.vendored.property-name.css",
                "source.css.scss entity.name.tag",
                "variable.parameter.keyframe-list.css",
                "meta.property-name.css",
                "variable.parameter.url.scss",
                "meta.property-value.scss",
                "meta.property-value.css"
            ],
            "settings": { "foreground": "#A8BCC9" }
        },
        {
            "name": "Sub-methods",
            "scope": [
                "entity.name.module.js",
                "variable.import.parameter.js",
                "variable.other.class.js"
            ],
            "settings": { "foreground": "#CC5555" }
        },
        {
            "name": "Language methods",
            "scope": ["variable.language"],
            "settings": { "foreground": "#8299AC" }
        },
        {
            "name": "entity.name.method.js",
            "scope": ["entity.name.method.js"],
            "settings": { "foreground": "#A8BCC9" }
        },
        {
            "name": "meta.method.js",
            "scope": [
                "meta.class-method.js entity.name.function.js",
                "variable.function.constructor"
            ],
            "settings": { "foreground": "#A8BCC9" }
        },
        {
            "name": "Attributes",
            "scope": [
                "entity.other.attribute-name",
                "meta.property-list.scss",
                "meta.attribute-selector.scss",
                "meta.property-value.css",
                "entity.other.keyframe-offset.css",
                "meta.selector.css",
                "entity.name.tag.reference.scss",
                "entity.name.tag.nesting.css",
                "punctuation.separator.key-value.css"
            ],
            "settings": { "foreground": "#2DA198" }
        },
        {
            "name": "HTML Attributes",
            "scope": [
                "text.html.basic entity.other.attribute-name.html",
                "text.html.basic entity.other.attribute-name"
            ],
            "settings": { "foreground": "#268BD2" }
        },
        {
            "name": "CSS Classes",
            "scope": [
                "entity.other.attribute-name.class",
                "entity.other.attribute-name.id",
                "meta.attribute-selector.scss",
                "variable.parameter.misc.css"
            ],
            "settings": { "foreground": "#268BD2" }
        },
        {
            "name": "CSS ID's",
            "scope": [
                "source.sass keyword.control",
                "meta.attribute-selector.scss"
            ],
            "settings": { "foreground": "#A8BCC9" }
        },
        {
            "name": "Inserted",
            "scope": ["markup.inserted"],
            "settings": { "foreground": "#4A9A4A" }
        },
        {
            "name": "Deleted",
            "scope": ["markup.deleted"],
            "settings": { "foreground": "#CC5555" }
        },
        {
            "name": "Changed",
            "scope": ["markup.changed"],
            "settings": { "foreground": "#CCAD31" }
        },
        {
            "name": "Regular Expressions",
            "scope": ["string.regexp"],
            "settings": { "foreground": "#2DA198" }
        },
        {
            "name": "Escape Characters",
            "scope": ["constant.character.escape"],
            "settings": { "foreground": "#8299AC" }
        },
        {
            "name": "URL",
            "scope": ["*url*", "*link*", "*uri*"],
            "settings": { "fontStyle": "underline", "foreground": "#3F9ACA" }
        },
        {
            "name": "Decorators",
            "scope": [
                "tag.decorator.js entity.name.tag.js",
                "tag.decorator.js punctuation.definition.tag.js"
            ],
            "settings": { "foreground": "#268BD2" }
        },
        {
            "name": "ES7 Bind Operator",
            "scope": [
                "source.js constant.other.object.key.js string.unquoted.label.js"
            ],
            "settings": { "fontStyle": "normal", "foreground": "#CC5555" }
        },
        {
            "name": "JSON Keys (All Levels)",
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#268BD2" }
        },
        {
            "name": "Markdown - Plain",
            "scope": [
                "text.html.markdown",
                "punctuation.definition.list_item.markdown"
