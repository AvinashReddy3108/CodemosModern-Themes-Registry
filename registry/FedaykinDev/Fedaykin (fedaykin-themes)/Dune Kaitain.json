                "markup.heading.markdown punctuation.definition.heading.markdown",
                "markup.heading",
                "markup.inserted.git_gutter"
            ],
            "settings": { "foreground": "#268BD2" }
        },
        {
            "name": "Markup - Italic",
            "scope": ["markup.italic"],
            "settings": { "fontStyle": "normal", "foreground": "#A8BCC9" }
        },
        {
            "name": "Markup - Bold",
