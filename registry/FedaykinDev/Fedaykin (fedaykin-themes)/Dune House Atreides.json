    "semanticHighlighting": true,
    "semanticTokenColors": {
        "comment": { "foreground": "#8b9cae", "fontStyle": "normal" },
        "string": "#4a9fa5",
        "keyword": "#22d3ee",
        "number": "#60a5fa",
        "type": "#94a3b8",
        "class": "#94a3b8",
        "function": "#3b82f6",
        "method": "#3b82f6",
        "property": "#10b981",
        "variable": "#e4edf7",
        "parameter": "#60a5fa",
        "interface": "#94a3b8",
        "enum": "#94a3b8",
        "enumMember": "#60a5fa",
        "struct": "#94a3b8",
        "typeParameter": "#94a3b8",
        "operator": "#22d3ee",
        "namespace": "#94a3b8",
        "decorator": "#3b82f6",
        "macro": "#3b82f6",
        "regexp": "#10b981",
        "variable.readonly": "#e4edf7",
        "variable.defaultLibrary": "#22d3ee",
        "function.defaultLibrary": "#22d3ee",
        "method.defaultLibrary": "#22d3ee",
        "class.defaultLibrary": "#94a3b8",
        "type.defaultLibrary": "#94a3b8",
        "selfParameter": { "foreground": "#60a5fa", "fontStyle": "normal" },
        "magicFunction": { "foreground": "#3b82f6", "fontStyle": "normal" }
    },
    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "fontStyle": "italic", "foreground": "#8b9cae" }
        },
        {
            "name": "String",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#4a9fa5" }
        },
        {
            "name": "Number",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#60a5fa" }
        },
        {
            "name": "Boolean",
            "scope": ["constant.language.boolean"],
            "settings": { "foreground": "#60a5fa" }
        },
        {
            "name": "Null",
            "scope": ["constant.language.null", "constant.language.undefined"],
            "settings": { "foreground": "#60a5fa" }
        },
        {
            "name": "Keyword",
            "scope": ["keyword", "keyword.control"],
            "settings": { "foreground": "#22d3ee" }
        },
        {
            "name": "Storage",
            "scope": ["storage", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#22d3ee" }
        },
        {
            "name": "Operator",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#22d3ee" }
        },
        {
            "name": "Function",
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#3b82f6" }
        },
        {
            "name": "Method",
            "scope": ["entity.name.method"],
            "settings": { "foreground": "#3b82f6" }
        },
        {
            "name": "Type",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.type",
                "support.class"
            ],
            "settings": { "foreground": "#94a3b8" }
        },
        {
            "name": "Variable",
            "scope": ["variable", "entity.name.variable", "variable.other"],
            "settings": { "foreground": "#f0f6fc" }
        },
        {
            "name": "Parameter",
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#60a5fa" }
        },
        {
            "name": "Property",
            "scope": ["variable.other.property", "support.type.property-name"],
            "settings": { "foreground": "#10b981" }
        },
        {
            "name": "Constant",
            "scope": ["constant", "variable.other.constant"],
            "settings": { "foreground": "#60a5fa" }
        },
        {
            "name": "Tag",
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#60a5fa" }
        },
        {
            "name": "Attribute",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#10b981" }
        },
        {
            "name": "Punctuation",
            "scope": ["punctuation"],
            "settings": { "foreground": "#e4edf7" }
        },
        {
            "name": "Self Parameter Python",
            "scope": [
                "variable.language.special.self.python",
                "variable.parameter.function.language.special.self.python"
            ],
            "settings": { "foreground": "#60a5fa", "fontStyle": "normal" }
        },
        {
            "name": "Magic Function Python",
            "scope": ["support.function.magic.python"],
            "settings": { "foreground": "#3b82f6", "fontStyle": "normal" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#ef4444" }
        },
        {
            "name": "Colors",
            "scope": ["constant.other.color"],
            "settings": { "foreground": "#e4edf7" }
        },
        {
            "name": "Operator, Misc",
            "scope": [
                "keyword.control",
                "constant.other.color",
                "punctuation.definition.tag",
                "punctuation.separator.inheritance.php",
                "punctuation.definition.tag.html",
                "punctuation.definition.tag.begin.html",
                "punctuation.definition.tag.end.html",
                "punctuation.section.embedded",
                "keyword.other.template",
                "keyword.other.substitution"
            ],
            "settings": { "foreground": "#22d3ee" }
        },
        {
            "name": "Function, Special Method",
            "scope": [
                "entity.name.function",
                "variable.function",
                "support.function",
                "keyword.other.special-method"
            ],
            "settings": { "foreground": "#3b82f6" }
        },
        {
            "name": "Block Level Variables",
            "scope": ["meta.block variable.other"],
            "settings": { "foreground": "#e4edf7" }
        },
        {
            "name": "Other Variable, String Link",
            "scope": ["support.other.variable", "string.other.link"],
            "settings": { "foreground": "#e4edf7" }
        },
        {
            "name": "Number, Constant, Function Argument, Tag Attribute, Embedded",
            "scope": [
                "constant.numeric",
                "support.constant",
                "constant.character",
                "constant.escape",
                "keyword.other.unit",
                "keyword.other",
                "constant.language.boolean"
            ],
            "settings": { "foreground": "#60a5fa" }
        },
        {
            "name": "String, Symbols, Inherited Class",
            "scope": [
                "string",
                "constant.other.symbol",
                "constant.other.key",
                "meta.group.braces.curly constant.other.object.key.js string.unquoted.label.js"
            ],
            "settings": { "foreground": "#4a9fa5" }
        },
        {
            "name": "Class, Support",
            "scope": [
                "entity.name",
                "support.type",
                "support.class",
                "support.other.namespace.use.php",
                "meta.use.php",
                "support.other.namespace.php",
                "markup.changed.git_gutter",
                "support.type.sys-types"
            ],
            "settings": { "foreground": "#94a3b8" }
        },
        {
            "name": "CSS Class and Support",
            "scope": [
                "source.css support.type.property-name",
                "source.sass support.type.property-name",
                "source.scss support.type.property-name",
                "source.less support.type.property-name",
                "source.stylus support.type.property-name",
                "source.postcss support.type.property-name",
                "support.type.vendored.property-name.css",
                "source.css.scss entity.name.tag",
                "variable.parameter.keyframe-list.css",
                "meta.property-name.css",
                "variable.parameter.url.scss",
                "meta.property-value.scss",
                "meta.property-value.css"
            ],
            "settings": { "foreground": "#e4edf7" }
        },
        {
            "name": "Sub-methods",
            "scope": [
                "entity.name.module.js",
                "variable.import.parameter.js",
                "variable.other.class.js"
            ],
            "settings": { "foreground": "#ef4444" }
        },
        {
            "name": "Language methods",
            "scope": ["variable.language"],
            "settings": { "foreground": "#c5d3e0" }
        },
        {
            "name": "entity.name.method.js",
            "scope": ["entity.name.method.js"],
            "settings": { "foreground": "#e4edf7" }
        },
        {
            "name": "meta.method.js",
            "scope": [
                "meta.class-method.js entity.name.function.js",
                "variable.function.constructor"
            ],
            "settings": { "foreground": "#e4edf7" }
        },
        {
            "name": "Attributes",
            "scope": [
                "entity.other.attribute-name",
                "meta.property-list.scss",
                "meta.attribute-selector.scss",
                "meta.property-value.css",
                "entity.other.keyframe-offset.css",
                "meta.selector.css",
                "entity.name.tag.reference.scss",
                "entity.name.tag.nesting.css",
                "punctuation.separator.key-value.css"
            ],
            "settings": { "foreground": "#10b981" }
        },
        {
            "name": "HTML Attributes",
            "scope": [
                "text.html.basic entity.other.attribute-name.html",
                "text.html.basic entity.other.attribute-name"
            ],
            "settings": { "foreground": "#3b82f6" }
        },
        {
            "name": "CSS Classes",
            "scope": [
                "entity.other.attribute-name.class",
                "entity.other.attribute-name.id",
                "meta.attribute-selector.scss",
                "variable.parameter.misc.css"
            ],
            "settings": { "foreground": "#3b82f6" }
        },
        {
            "name": "CSS ID's",
            "scope": [
                "source.sass keyword.control",
                "meta.attribute-selector.scss"
            ],
            "settings": { "foreground": "#e4edf7" }
        },
        {
            "name": "Inserted",
            "scope": ["markup.inserted"],
            "settings": { "foreground": "#10b981" }
        },
        {
            "name": "Deleted",
            "scope": ["markup.deleted"],
            "settings": { "foreground": "#ef4444" }
        },
        {
            "name": "Changed",
            "scope": ["markup.changed"],
            "settings": { "foreground": "#f59e0b" }
        },
        {
            "name": "Regular Expressions",
            "scope": ["string.regexp"],
            "settings": { "foreground": "#10b981" }
        },
        {
            "name": "Escape Characters",
            "scope": ["constant.character.escape"],
            "settings": { "foreground": "#c5d3e0" }
        },
        {
            "name": "URL",
            "scope": ["*url*", "*link*", "*uri*"],
            "settings": { "fontStyle": "underline", "foreground": "#3b82f6" }
        },
        {
            "name": "Decorators",
            "scope": [
                "tag.decorator.js entity.name.tag.js",
                "tag.decorator.js punctuation.definition.tag.js"
            ],
            "settings": { "foreground": "#3b82f6" }
        },
        {
            "name": "ES7 Bind Operator",
            "scope": [
                "source.js constant.other.object.key.js string.unquoted.label.js"
            ],
            "settings": { "fontStyle": "normal", "foreground": "#ef4444" }
        },
        {
            "name": "JSON Keys (All Levels)",
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#3b82f6" }
        },
        {
            "name": "Markdown - Plain",
