    "tokenColors": [
        {
            "scope": ["comment"],
            "settings": { "foreground": "#6e6a86", "fontStyle": "italic" }
        },
        { "scope": ["constant"], "settings": { "foreground": "#be95ff" } },
        {
            "scope": [
                "constant.numeric",
                "constant.language",
                "constant.charcter.escape"
            ],
            "settings": { "foreground": "#be95ff" }
        },
        { "scope": ["entity.name"], "settings": { "foreground": "#be95ff" } },
        {
            "scope": [
                "entity.name.section",
                "entity.name.tag",
                "entity.name.namespace",
                "entity.name.type"
            ],
            "settings": { "foreground": "#be95ff" }
        },
        {
            "scope": [
                "entity.other.attribute-name",
                "entity.other.inherited-class"
            ],
            "settings": { "foreground": "#f6e1f4", "fontStyle": "italic" }
        },
        { "scope": ["invalid"], "settings": { "foreground": "#574f7d" } },
        {
            "scope": ["invalid.deprecated"],
            "settings": { "foreground": "#908caa" }
        },
        { "scope": ["keyword"], "settings": { "foreground": "#d16996" } },
        {
            "scope": ["meta.tag", "meta.brace"],
            "settings": { "foreground": "#E7D2C5" }
        },
        {
            "scope": ["meta.import", "meta.export"],
            "settings": { "foreground": "#d16996" }
        },
