    "tokenColors": [
        {
            "scope": ["comment"],
            "settings": { "foreground": "#9893a5", "fontStyle": "italic" }
        },
        { "scope": ["constant"], "settings": { "foreground": "#c48200" } },
        {
            "scope": [
                "constant.numeric",
                "constant.language",
                "constant.charcter.escape"
            ],
            "settings": { "foreground": "#292a73" }
        },
        { "scope": ["entity.name"], "settings": { "foreground": "#292a73" } },
        {
            "scope": [
                "entity.name.section",
                "entity.name.tag",
                "entity.name.namespace",
                "entity.name.type"
            ],
            "settings": { "foreground": "#3a9efd" }
        },
        {
            "scope": [
                "entity.other.attribute-name",
                "entity.other.inherited-class"
            ],
            "settings": { "foreground": "#f600b9", "fontStyle": "italic" }
        },
        { "scope": ["invalid"], "settings": { "foreground": "#3e4491" } },
        {
            "scope": ["invalid.deprecated"],
            "settings": { "foreground": "#797593" }
        },
        { "scope": ["keyword"], "settings": { "foreground": "#c48200" } },
        {
            "scope": ["markup.inserted.diff"],
            "settings": { "foreground": "#3a9efd" }
        },
        {
            "scope": ["markup.deleted.diff"],
            "settings": { "foreground": "#3e4491" }
