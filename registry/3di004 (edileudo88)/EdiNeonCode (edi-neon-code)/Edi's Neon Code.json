            "settings": { "foreground": "#f567e9" }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "parameter": "#ffc13a",
        "comment": "#a7a7a7",
        "selfParameter": "#6078ff",
        "variable": "#e4e4e4",
        "method": "#15ff00",
        "namespace": "#ff9900",
        "class.typeHint.builtin": "#00c3ffc5",
        "class.builtin": "#00ff80c5",
        "function": "#e64343",
        "module": "#ff7ef4"
    },
    "$schema": "vscode://schemas/color-theme"
}
