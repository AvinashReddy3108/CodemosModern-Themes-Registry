{
    "$schema": "vscode://schemas/color-theme",
    "name": "PPL Dark Theme (Recomendado)",
    "type": "dark",
    "colors": {
        "editor.background": "#1E1E1E",
        "editor.foreground": "#9CDCFE",
        "editor.selectionBackground": "#264F78",
        "editor.lineHighlightBackground": "#2A2A2A",
        "editorCursor.foreground": "#AEAFAD",
        "activityBar.background": "#333333",
        "activityBar.foreground": "#FFFFFF",
        "sideBar.background": "#252526",
        "sideBar.foreground": "#CCCCCC",
        "sideBarSectionHeader.background": "#252526",
        "sideBarSectionHeader.foreground": "#CCCCCC",
        "list.hoverBackground": "#2A2A2A",
        "list.activeSelectionBackground": "#37373D",
        "list.inactiveSelectionBackground": "#37373D",
        "statusBar.background": "#007ACC",
        "statusBar.foreground": "#FFFFFF",
        "statusBar.noFolderBackground": "#68217A",
        "tab.activeBorder": "#FFFFFF",
        "tab.activeBackground": "#1E1E1E",
        "tab.inactiveBackground": "#2D2D2D",
        "tab.inactiveForeground": "#888888",
        "editorGroupHeader.tabsBackground": "#252526",
        "dropdown.background": "#3C3C3C",
        "input.background": "#3C3C3C",
        "button.background": "#0E639C",
        "button.foreground": "#FFFFFF",
        "panel.background": "#1E1E1E",
        "panelTitle.activeBorder": "#E7E7E7",
        "peekView.border": "#007ACC",
        "peekViewEditor.background": "#252526",
        "peekViewResult.background": "#252526",
        "peekViewTitle.background": "#1E1E1E",
        "editorWidget.background": "#252526"
    },
    "tokenColors": [
        {
            "name": "Reglas Genéricas (para Python, JS, CSS, JSON, MD, TS, etc.)",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#76be81" }
        },
        { "scope": "string", "settings": { "foreground": "#dca864" } },
        {
            "scope": "constant.numeric",
            "settings": { "foreground": "#dcdcdc" }
        },
        {
            "scope": [
                "constant.language",
                "constant.language.boolean",
                "constant.numeric.symbol"
            ],
            "settings": { "foreground": "#ffea3f" }
        },
        {
            "scope": "constant.character.escape",
            "settings": { "foreground": "#ffc049" }
        },
        {
            "scope": ["keyword", "keyword.control", "keyword.control.flow"],
            "settings": { "foreground": "#ff6671" }
        },
        {
            "scope": [
                "storage",
                "storage.type",
                "storage.modifier",
                "keyword.operator.logical"
            ],
            "settings": { "foreground": "#af8bff" }
        },
        {
            "scope": [
                "keyword.operator",
                "keyword.operator.assignment",
                "keyword.operator.arithmetic",
                "keyword.operator.comparison"
            ],
            "settings": { "foreground": "#ffc049" }
        },
        {
            "scope": "support.function",
            "settings": { "foreground": "#4EC9B0" }
        },
        {
            "scope": "entity.name.function",
            "settings": { "foreground": "#e0ae51" }
        },
        {
            "scope": ["variable", "variable.parameter", "meta.parameter"],
            "settings": { "foreground": "#4EC9B0" }
        },
        {
            "scope": ["variable.language", "variable.language.this"],
            "settings": { "foreground": "#dd38a4" }
        },
        {
            "scope": ["entity.name.type", "entity.name.class", "support.class"],
            "settings": { "foreground": "#c678dd" }
        },
        { "scope": "entity.name.tag", "settings": { "foreground": "#ff6671" } },
        {
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#d19a66" }
        },
        {
            "name": "JSON - Claves",
            "scope": "support.type.property-name.json",
            "settings": { "foreground": "#c678dd" }
        },
        {
            "name": "Markdown - Cabeceras",
            "scope": "entity.name.section.markdown",
            "settings": { "foreground": "#ff6671", "fontStyle": "bold" }
        },
        {
            "name": "--- REGLAS ESPECÍFICAS DE PPL (Anulan las genéricas) ---",
            "scope": [],
            "settings": {}
        },
        {
            "name": "Comentarios PPL",
            "scope": "comment.line.double-slash.hpprgm",
            "settings": { "foreground": "#fbfbfb74" }
        },
        {
            "name": "Operadores PPL",
            "scope": [
                "keyword.operator.assignment.hpprgm",
                "keyword.operator.assignment.word.hpprgm",
                "keyword.operator.arithmetic.symbol.hpprgm",
                "keyword.operator.arithmetic.word.hpprgm",
                "keyword.operator.comparison.hpprgm"
            ],
            "settings": { "foreground": "#ffc049" }
        },
        {
            "name": "Strings (Cadenas) PPL",
            "scope": "string.quoted.double.hpprgm",
            "settings": { "foreground": "#76be81" }
        },
        {
            "name": "Funciones PPL (Core, Drawing, CAS, Catalog)",
            "scope": [
                "support.function.ppl.hpprgm",
                "support.function.drawing.hpprgm",
                "support.function.arrow.hpprgm",
                "support.function.cas.hpprgm",
                "support.function.catalog.hpprgm"
            ],
            "settings": { "foreground": "#4EC9B0" }
        },
        {
            "name": "Funciones de App PPL",
            "scope": "support.function.app.hpprgm",
            "settings": { "foreground": "#66D9EF" }
        },
        {
            "name": "Números PPL",
            "scope": [
                "constant.numeric.integer.hex.hpprgm",
                "constant.numeric.integer.octal.hpprgm",
                "constant.numeric.integer.binary.hpprgm",
                "constant.numeric.integer.decimal.hpprgm",
                "constant.numeric.float.hpprgm"
            ],
            "settings": { "foreground": "#dcdcdc" }
        },
        {
            "name": "Keywords (Control) PPL (IF, FOR, etc.)",
            "scope": ["keyword.control.hpprgm"],
            "settings": { "foreground": "#ff6671" }
        },
        {
            "name": "Keywords (Declaración) PPL (LOCAL, EXPORT...)",
            "scope": ["storage.type.hpprgm", "keyword.operator.logical.hpprgm"],
            "settings": { "foreground": "#af8bff" }
        },
        {
            "name": "Variables Integradas (A, B, G0, L1...)",
            "scope": [
                "variable.language.built-in.hpprgm",
                "variable.language.built-in.real.hpprgm"
            ],
            "settings": { "foreground": "#dd38a4" }
        },
        {
            "name": "Variables de Usuario (variable_1...)",
            "scope": "variable.other.readwrite.hpprgm",
            "settings": { "foreground": "#9CDCFE" }
        },
        {
            "name": "Funciones de Math PPL",
            "scope": [
                "support.function.math.hpprgm",
                "constant.language.hpprgm",
                "constant.numeric.symbol.hpprgm"
            ],
            "settings": { "foreground": "#ffea3f" }
        },
        {
            "name": "Llamadas a Apps (AppName)",
            "scope": ["entity.name.type.class.hpprgm"],
            "settings": { "foreground": "#d676df" }
        },
        {
            "name": "Lamadas a Funsiones UI-(name)",
            "scope": ["support.function.hp-ui-lib.hpprgm"],
            "settings": { "foreground": "#87b923" }
        },
        {
            "name": "Llamadas a Apps (FuncName) y Funciones de Usuario",
            "scope": [
                "entity.name.function.qualified.hpprgm",
                "entity.name.function.user.hpprgm"
            ],
            "settings": { "foreground": "#be9342", "fontStyle": "bold" }
        }
    ]
}
