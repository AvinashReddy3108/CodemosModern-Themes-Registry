        "editorWidget.foreground": "#f0f3f7",
        "editorSuggestWidget.background": "#181b2a",
        "editorSuggestWidget.foreground": "#f0f3f7",
        "editorSuggestWidget.selectedBackground": "#23263a",
        "editorSuggestWidget.highlightForeground": "#b3e6ff",
        "editorSuggestWidget.border": "#23263a",
        "editorGroupHeader.tabsBackground": "#181b2a"
