    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#4a6b8a" }
        },
        {
            "name": "Strings",
            "scope": ["string", "string.quoted"],
            "settings": { "foreground": "#f8bbd9" }
        },
        {
            "name": "Keywords",
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#ffab91" }
        },
        {
            "name": "Functions",
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#90caf9" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "variable.other"],
            "settings": { "foreground": "#ffb74d" }
        },
        {
            "name": "Constants",
            "scope": ["constant", "constant.numeric", "constant.language"],
            "settings": { "foreground": "#e1bee7" }
        },
        {
            "name": "Types",
            "scope": ["entity.name.type", "support.type"],
            "settings": { "foreground": "#64b5f6" }
        },
        {
            "name": "Classes",
            "scope": ["entity.name.class"],
            "settings": { "foreground": "#ffd54f" }
        },
        {
            "name": "Operators",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#ffcc80" }
        },
        {
            "name": "Punctuation",
            "scope": ["punctuation"],
            "settings": { "foreground": "#90a4ae" }
        },
        {
            "name": "Brackets",
            "scope": ["punctuation.definition"],
            "settings": { "foreground": "#ffab91" }
        },
        {
            "name": "HTML Tags",
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#ff8a65" }
        },
        {
            "name": "CSS Properties",
            "scope": ["support.type.property-name.css"],
            "settings": { "foreground": "#ffab91" }
        },
        {
            "name": "CSS Values",
            "scope": ["support.constant.property-value.css"],
            "settings": { "foreground": "#ffcc80" }
        },
        {
            "name": "JavaScript Objects",
            "scope": ["variable.other.object"],
            "settings": { "foreground": "#ffd54f" }
        },
        {
            "name": "JSON Keys",
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#ffab91" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
