    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#702000", "fontStyle": "italic" }
        },
        {
            "name": "String",
            "scope": [
                "string",
                "string.quoted",
                "string.template",
                "string.interpolated"
            ],
            "settings": { "foreground": "#005e8b" }
        },
        {
            "name": "String escape",
            "scope": ["constant.character.escape", "string.regexp"],
            "settings": { "foreground": "#a60000" }
        },
        {
            "name": "Constant",
            "scope": [
                "constant",
                "constant.language",
                "constant.character",
                "support.constant"
            ],
            "settings": { "foreground": "#00663f" }
        },
        {
            "name": "Number",
            "scope": [
                "constant.numeric",
                "constant.numeric.integer",
                "constant.numeric.float",
                "constant.numeric.hex",
                "constant.numeric.octal",
                "constant.numeric.binary"
            ],
            "settings": { "foreground": "#000000" }
        },
        {
            "name": "Boolean",
            "scope": "constant.language.boolean",
            "settings": { "foreground": "#00663f" }
        },
        {
            "name": "Keyword",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.new",
                "keyword.operator.expression",
                "keyword.operator.cast",
                "keyword.operator.sizeof",
                "keyword.operator.alignof",
                "keyword.operator.typeid",
                "keyword.operator.logical",
                "keyword.operator.wordlike"
            ],
            "settings": { "foreground": "#a0132f" }
        },
        {
            "name": "Operator",
            "scope": [
                "keyword.operator",
                "keyword.operator.assignment",
                "keyword.operator.arithmetic",
                "keyword.operator.bitwise",
                "keyword.operator.comparison",
                "keyword.operator.relational",
                "keyword.operator.increment",
                "keyword.operator.decrement",
                "keyword.operator.ternary"
            ],
            "settings": { "foreground": "#000000" }
        },
        {
            "name": "Storage",
            "scope": ["storage", "storage.modifier"],
            "settings": { "foreground": "#a0132f" }
        },
        {
            "name": "Storage type",
            "scope": "storage.type",
            "settings": { "foreground": "#3548cf" }
        },
        {
            "name": "Storage type namespace (C/C++)",
            "scope": [
                "storage.type.namespace.directive.cpp",
                "storage.type.namespace.definition.cpp"
            ],
            "settings": { "foreground": "#3548cf" }
        },
        {
            "name": "Type",
            "scope": [
                "entity.name.type",
                "entity.name.type.class",
                "entity.name.type.struct",
                "entity.name.type.interface",
                "entity.name.type.enum",
                "entity.name.type.type-parameter",
                "support.type",
                "support.type.primitive",
                "support.type.builtin"
            ],
            "settings": { "foreground": "#3548cf" }
        },
        {
            "name": "Type parameter",
            "scope": "entity.name.type.parameter",
            "settings": { "foreground": "#3548cf" }
        },
        {
            "name": "Function name",
            "scope": [
                "entity.name.function",
                "entity.name.function.member",
                "support.function",
                "meta.function-call entity.name.function"
            ],
            "settings": { "foreground": "#3f578f" }
        },
        {
            "name": "Method",
            "scope": [
                "entity.name.function.method",
                "meta.method.identifier entity.name.function"
            ],
            "settings": { "foreground": "#3f578f" }
        },
        {
            "name": "Function parameter",
            "scope": ["variable.parameter", "meta.parameter"],
            "settings": { "foreground": "#005f5f" }
        },
        {
            "name": "Variable",
            "scope": [
                "variable",
                "variable.other",
                "variable.other.readwrite",
                "variable.other.object",
                "variable.other.object.access.cpp"
            ],
            "settings": { "foreground": "#005f5f" }
        },
        {
            "name": "Variable property",
            "scope": [
                "variable.other.property",
                "variable.other.object.property",
                "meta.object-literal.key"
            ],
            "settings": { "foreground": "#005f5f" }
        },
        {
            "name": "Variable language (this/self)",
            "scope": "variable.language",
            "settings": { "foreground": "#a0132f", "fontStyle": "italic" }
        },
        {
            "name": "Class",
            "scope": ["entity.name.class", "support.class"],
            "settings": { "foreground": "#3548cf" }
        },
        {
            "name": "Namespace / scope qualifier",
            "scope": ["entity.name.namespace", "entity.name.scope-resolution"],
            "settings": { "foreground": "#00663f" }
        },
        {
            "name": "Built-in",
            "scope": [
                "support.function.builtin",
                "support.variable",
                "support.type.property-name"
            ],
            "settings": { "foreground": "#721045" }
        },
        {
            "name": "Decorator",
            "scope": [
                "meta.decorator",
                "meta.decorator entity.name.function",
                "punctuation.decorator"
            ],
            "settings": { "foreground": "#531ab6" }
        },
        {
            "name": "Preprocessor",
            "scope": [
                "meta.preprocessor",
                "entity.name.function.preprocessor",
                "keyword.control.directive",
                "keyword.control.import",
                "keyword.control.export",
                "keyword.control.from",
                "keyword.control.as"
            ],
            "settings": { "foreground": "#531ab6" }
        },
        {
            "name": "Preprocessor punctuation (# in C/C++)",
            "scope": [
                "punctuation.definition.directive",
                "punctuation.definition.directive.c",
                "punctuation.definition.directive.cpp"
            ],
            "settings": { "foreground": "#531ab6" }
        },
        {
            "name": "Include path (C/C++ angle brackets)",
            "scope": [
                "string.quoted.other.lt-gt.include",
                "string.quoted.other.lt-gt.include.c",
                "string.quoted.other.lt-gt.include.cpp"
            ],
            "settings": { "foreground": "#005e8b" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation",
                "punctuation.separator",
                "punctuation.terminator",
                "meta.brace"
            ],
            "settings": { "foreground": "#000000" }
        },
        {
            "name": "String punctuation (quotes, angle brackets in includes)",
            "scope": "punctuation.definition.string",
            "settings": { "foreground": "#005e8b" }
        },
        {
            "name": "Bracket",
            "scope": [
                "punctuation.definition.block",
                "punctuation.definition.parameters",
                "punctuation.section",
                "punctuation.definition.begin",
                "punctuation.definition.end"
            ],
            "settings": { "foreground": "#000000" }
        },
        {
            "name": "Tag",
            "scope": ["entity.name.tag", "meta.tag"],
            "settings": { "foreground": "#a0132f" }
        },
        {
            "name": "Tag attribute",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#005f5f" }
        },
        {
            "name": "CSS property",
            "scope": "support.type.property-name.css",
            "settings": { "foreground": "#005f5f" }
        },
        {
            "name": "CSS value",
            "scope": [
                "support.constant.property-value.css",
                "support.constant.font-name",
                "meta.property-value"
            ],
            "settings": { "foreground": "#00663f" }
        },
        {
            "name": "CSS selector",
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css",
                "entity.other.attribute-name.pseudo-class.css",
                "entity.other.attribute-name.pseudo-element.css"
            ],
            "settings": { "foreground": "#3f578f" }
        },
        {
            "name": "CSS unit",
            "scope": "keyword.other.unit",
            "settings": { "foreground": "#000000" }
        },
        {
            "name": "JSON key",
            "scope": "support.type.property-name.json",
            "settings": { "foreground": "#005f5f" }
        },
        {
            "name": "YAML key",
            "scope": "entity.name.tag.yaml",
            "settings": { "foreground": "#005f5f" }
        },
        {
            "name": "TOML key",
            "scope": "support.type.property-name.toml",
            "settings": { "foreground": "#005f5f" }
        },
        {
            "name": "TOML table",
            "scope": "support.type.property-name.table.toml",
            "settings": { "foreground": "#3548cf" }
        },
        {
            "name": "Markdown heading",
            "scope": [
                "heading.1.markdown",
                "heading.2.markdown",
                "heading.3.markdown",
                "heading.4.markdown",
                "heading.5.markdown",
                "heading.6.markdown",
                "markup.heading"
            ],
            "settings": { "foreground": "#000000", "fontStyle": "bold" }
        },
        {
            "name": "Markdown bold",
            "scope": "markup.bold",
            "settings": { "foreground": "#000000", "fontStyle": "bold" }
        },
        {
            "name": "Markdown italic",
            "scope": "markup.italic",
            "settings": { "foreground": "#000000", "fontStyle": "italic" }
        },
        {
            "name": "Markdown inline code",
            "scope": ["markup.inline.raw", "markup.fenced_code.block"],
            "settings": { "foreground": "#005e8b" }
        },
        {
            "name": "Markdown link",
            "scope": ["markup.underline.link", "string.other.link"],
            "settings": { "foreground": "#005e8b" }
        },
        {
            "name": "Markdown list marker",
            "scope": [
                "punctuation.definition.list.begin.markdown",
                "markup.list"
            ],
            "settings": { "foreground": "#595959" }
        },
        {
            "name": "Markdown quote",
            "scope": "markup.quote",
            "settings": { "foreground": "#595959", "fontStyle": "italic" }
        },
        {
            "name": "Shell variable",
            "scope": [
                "variable.other.normal.shell",
                "variable.other.special.shell",
                "variable.other.positional.shell"
            ],
            "settings": { "foreground": "#005f5f" }
        },
        {
            "name": "Regex group",
            "scope": [
                "string.regexp.group",
                "punctuation.definition.group.regexp",
                "keyword.operator.quantifier.regexp"
            ],
            "settings": { "foreground": "#a60000" }
        },
        {
            "name": "Regex escape",
            "scope": [
                "constant.other.character-class.regexp",
                "constant.character.escape.backslash.regexp"
            ],
            "settings": { "foreground": "#721045" }
        },
        {
            "name": "Diff inserted",
            "scope": "markup.inserted",
            "settings": { "foreground": "#005079" }
        },
        {
            "name": "Diff deleted",
            "scope": "markup.deleted",
            "settings": { "foreground": "#8f1313" }
        },
        {
            "name": "Diff changed",
            "scope": "markup.changed",
            "settings": { "foreground": "#6f1343" }
        },
        {
            "name": "Documentation string",
            "scope": ["string.quoted.docstring", "comment.block.documentation"],
            "settings": { "foreground": "#224960", "fontStyle": "italic" }
        },
        {
            "name": "Documentation markup",
            "scope": [
                "comment.block.documentation keyword",
                "comment.block.documentation variable",
                "storage.type.class.jsdoc",
                "entity.name.type.instance.jsdoc",
                "variable.other.jsdoc"
            ],
            "settings": { "foreground": "#7c318f" }
        },
        {
            "name": "Enum member",
            "scope": "variable.other.enummember",
            "settings": { "foreground": "#00663f" }
        },
        {
            "name": "Label",
            "scope": "entity.name.label",
            "settings": { "foreground": "#a0132f" }
        },
        {
            "name": "Info token",
            "scope": "token.info-token",
            "settings": { "foreground": "#005e8b" }
        },
        {
            "name": "Warning token",
            "scope": "token.warn-token",
            "settings": { "foreground": "#721045" }
        },
        {
            "name": "Error token",
            "scope": "token.error-token",
            "settings": { "foreground": "#b21100" }
        },
        {
            "name": "Debug token",
            "scope": "token.debug-token",
            "settings": { "foreground": "#531ab6" }
        }
    ],
    "semanticTokenColors": {
        "type": "#3548cf",
        "function": "#3f578f",
        "method": "#3f578f",
        "variable": "#005f5f",
        "keyword": "#a0132f",
        "comment": { "foreground": "#702000", "fontStyle": "italic" },
        "string": "#005e8b",
        "number": "#000000",
        "regexp": "#a60000",
        "operator": "#000000"
    }
}
