    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#ff9070", "fontStyle": "italic" }
        },
        {
            "name": "String",
            "scope": [
                "string",
                "string.quoted",
                "string.template",
                "string.interpolated"
            ],
            "settings": { "foreground": "#00d3d0" }
        },
        {
            "name": "String escape",
            "scope": ["constant.character.escape", "string.regexp"],
            "settings": { "foreground": "#ff5f59" }
        },
        {
            "name": "Constant",
            "scope": [
                "constant",
                "constant.language",
                "constant.character",
                "support.constant"
            ],
            "settings": { "foreground": "#88ca9f" }
        },
        {
            "name": "Number",
            "scope": [
                "constant.numeric",
                "constant.numeric.integer",
                "constant.numeric.float",
                "constant.numeric.hex",
                "constant.numeric.octal",
                "constant.numeric.binary"
            ],
            "settings": { "foreground": "#ffffff" }
        },
        {
            "name": "Boolean",
            "scope": "constant.language.boolean",
            "settings": { "foreground": "#88ca9f" }
        },
        {
            "name": "Keyword",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.new",
                "keyword.operator.expression",
                "keyword.operator.cast",
                "keyword.operator.sizeof",
                "keyword.operator.alignof",
                "keyword.operator.typeid",
                "keyword.operator.logical",
                "keyword.operator.wordlike"
            ],
            "settings": { "foreground": "#ff7f86" }
        },
        {
            "name": "Operator",
            "scope": [
                "keyword.operator",
                "keyword.operator.assignment",
                "keyword.operator.arithmetic",
                "keyword.operator.bitwise",
                "keyword.operator.comparison",
                "keyword.operator.relational",
                "keyword.operator.increment",
                "keyword.operator.decrement",
                "keyword.operator.ternary"
            ],
            "settings": { "foreground": "#ffffff" }
        },
        {
            "name": "Storage",
            "scope": ["storage", "storage.modifier"],
            "settings": { "foreground": "#ff7f86" }
        },
        {
            "name": "Storage type",
            "scope": "storage.type",
            "settings": { "foreground": "#79a8ff" }
        },
        {
            "name": "Storage type namespace (C/C++)",
            "scope": [
                "storage.type.namespace.directive.cpp",
                "storage.type.namespace.definition.cpp"
            ],
            "settings": { "foreground": "#79a8ff" }
        },
        {
            "name": "Type",
            "scope": [
                "entity.name.type",
                "entity.name.type.class",
                "entity.name.type.struct",
                "entity.name.type.interface",
                "entity.name.type.enum",
                "entity.name.type.type-parameter",
                "support.type",
                "support.type.primitive",
                "support.type.builtin"
            ],
            "settings": { "foreground": "#79a8ff" }
        },
        {
            "name": "Type parameter",
            "scope": "entity.name.type.parameter",
            "settings": { "foreground": "#79a8ff" }
        },
        {
            "name": "Function name",
            "scope": [
                "entity.name.function",
                "entity.name.function.member",
                "support.function",
                "meta.function-call entity.name.function"
            ],
            "settings": { "foreground": "#4ae2ff" }
        },
        {
            "name": "Method",
            "scope": [
                "entity.name.function.method",
                "meta.method.identifier entity.name.function"
            ],
            "settings": { "foreground": "#4ae2ff" }
        },
        {
            "name": "Function parameter",
            "scope": ["variable.parameter", "meta.parameter"],
            "settings": { "foreground": "#6ae4b9" }
        },
        {
            "name": "Variable",
            "scope": [
                "variable",
                "variable.other",
                "variable.other.readwrite",
                "variable.other.object",
                "variable.other.object.access.cpp"
            ],
            "settings": { "foreground": "#6ae4b9" }
        },
        {
            "name": "Variable property",
            "scope": [
                "variable.other.property",
                "variable.other.object.property",
                "meta.object-literal.key"
            ],
            "settings": { "foreground": "#6ae4b9" }
        },
        {
            "name": "Variable language (this/self)",
            "scope": "variable.language",
            "settings": { "foreground": "#ff7f86", "fontStyle": "italic" }
        },
        {
            "name": "Class",
            "scope": ["entity.name.class", "support.class"],
            "settings": { "foreground": "#79a8ff" }
        },
        {
            "name": "Namespace / scope qualifier",
            "scope": ["entity.name.namespace", "entity.name.scope-resolution"],
            "settings": { "foreground": "#88ca9f" }
        },
        {
            "name": "Built-in",
            "scope": [
                "support.function.builtin",
                "support.variable",
                "support.type.property-name"
            ],
            "settings": { "foreground": "#feacd0" }
        },
        {
            "name": "Decorator",
            "scope": [
                "meta.decorator",
                "meta.decorator entity.name.function",
                "punctuation.decorator"
            ],
            "settings": { "foreground": "#b6a0ff" }
        },
        {
            "name": "Preprocessor",
            "scope": [
                "meta.preprocessor",
                "entity.name.function.preprocessor",
                "keyword.control.directive",
                "keyword.control.import",
                "keyword.control.export",
                "keyword.control.from",
                "keyword.control.as"
            ],
            "settings": { "foreground": "#b6a0ff" }
        },
        {
            "name": "Preprocessor punctuation (# in C/C++)",
            "scope": [
                "punctuation.definition.directive",
                "punctuation.definition.directive.c",
                "punctuation.definition.directive.cpp"
            ],
            "settings": { "foreground": "#b6a0ff" }
        },
        {
            "name": "Include path (C/C++ angle brackets)",
            "scope": [
                "string.quoted.other.lt-gt.include",
                "string.quoted.other.lt-gt.include.c",
                "string.quoted.other.lt-gt.include.cpp"
            ],
            "settings": { "foreground": "#00d3d0" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation",
                "punctuation.separator",
                "punctuation.terminator",
                "meta.brace"
            ],
            "settings": { "foreground": "#ffffff" }
        },
        {
            "name": "String punctuation (quotes, angle brackets in includes)",
            "scope": "punctuation.definition.string",
            "settings": { "foreground": "#00d3d0" }
        },
        {
            "name": "Bracket",
            "scope": [
                "punctuation.definition.block",
                "punctuation.definition.parameters",
                "punctuation.section",
                "punctuation.definition.begin",
                "punctuation.definition.end"
            ],
            "settings": { "foreground": "#ffffff" }
        },
        {
            "name": "Tag",
            "scope": ["entity.name.tag", "meta.tag"],
            "settings": { "foreground": "#ff7f86" }
        },
        {
            "name": "Tag attribute",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#6ae4b9" }
        },
        {
            "name": "CSS property",
            "scope": "support.type.property-name.css",
            "settings": { "foreground": "#6ae4b9" }
        },
        {
            "name": "CSS value",
            "scope": [
                "support.constant.property-value.css",
                "support.constant.font-name",
                "meta.property-value"
            ],
            "settings": { "foreground": "#88ca9f" }
        },
        {
            "name": "CSS selector",
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css",
                "entity.other.attribute-name.pseudo-class.css",
                "entity.other.attribute-name.pseudo-element.css"
            ],
            "settings": { "foreground": "#4ae2ff" }
        },
        {
            "name": "CSS unit",
            "scope": "keyword.other.unit",
            "settings": { "foreground": "#ffffff" }
        },
        {
            "name": "JSON key",
            "scope": "support.type.property-name.json",
            "settings": { "foreground": "#6ae4b9" }
        },
        {
            "name": "YAML key",
            "scope": "entity.name.tag.yaml",
            "settings": { "foreground": "#6ae4b9" }
        },
        {
            "name": "TOML key",
            "scope": "support.type.property-name.toml",
            "settings": { "foreground": "#6ae4b9" }
        },
        {
            "name": "TOML table",
            "scope": "support.type.property-name.table.toml",
            "settings": { "foreground": "#79a8ff" }
        },
        {
            "name": "Markdown heading",
            "scope": [
                "heading.1.markdown",
                "heading.2.markdown",
                "heading.3.markdown",
                "heading.4.markdown",
                "heading.5.markdown",
                "heading.6.markdown",
                "markup.heading"
            ],
            "settings": { "foreground": "#ffffff", "fontStyle": "bold" }
        },
        {
            "name": "Markdown bold",
            "scope": "markup.bold",
            "settings": { "foreground": "#ffffff", "fontStyle": "bold" }
        },
        {
            "name": "Markdown italic",
            "scope": "markup.italic",
            "settings": { "foreground": "#ffffff", "fontStyle": "italic" }
        },
        {
            "name": "Markdown inline code",
            "scope": ["markup.inline.raw", "markup.fenced_code.block"],
            "settings": { "foreground": "#00d3d0" }
        },
        {
            "name": "Markdown link",
            "scope": ["markup.underline.link", "string.other.link"],
            "settings": { "foreground": "#00d3d0" }
        },
        {
            "name": "Markdown list marker",
            "scope": [
                "punctuation.definition.list.begin.markdown",
                "markup.list"
            ],
            "settings": { "foreground": "#989898" }
        },
        {
            "name": "Markdown quote",
            "scope": "markup.quote",
            "settings": { "foreground": "#989898", "fontStyle": "italic" }
        },
        {
            "name": "Shell variable",
            "scope": [
                "variable.other.normal.shell",
                "variable.other.special.shell",
                "variable.other.positional.shell"
            ],
            "settings": { "foreground": "#6ae4b9" }
        },
        {
            "name": "Regex group",
            "scope": [
                "string.regexp.group",
                "punctuation.definition.group.regexp",
                "keyword.operator.quantifier.regexp"
            ],
            "settings": { "foreground": "#ff5f59" }
        },
        {
            "name": "Regex escape",
            "scope": [
                "constant.other.character-class.regexp",
                "constant.character.escape.backslash.regexp"
            ],
            "settings": { "foreground": "#feacd0" }
        },
        {
            "name": "Diff inserted",
            "scope": "markup.inserted",
            "settings": { "foreground": "#9fdfdf" }
        },
        {
            "name": "Diff deleted",
            "scope": "markup.deleted",
            "settings": { "foreground": "#ffbfbf" }
        },
        {
            "name": "Diff changed",
            "scope": "markup.changed",
            "settings": { "foreground": "#e3cfff" }
        },
        {
            "name": "Documentation string",
            "scope": ["string.quoted.docstring", "comment.block.documentation"],
            "settings": { "foreground": "#a0d7f2", "fontStyle": "italic" }
        },
        {
            "name": "Documentation markup",
            "scope": [
                "comment.block.documentation keyword",
                "comment.block.documentation variable",
                "storage.type.class.jsdoc",
                "entity.name.type.instance.jsdoc",
                "variable.other.jsdoc"
            ],
            "settings": { "foreground": "#caa6df" }
        },
        {
            "name": "Enum member",
            "scope": "variable.other.enummember",
            "settings": { "foreground": "#88ca9f" }
        },
        {
            "name": "Label",
            "scope": "entity.name.label",
            "settings": { "foreground": "#ff7f86" }
        },
        {
            "name": "Info token",
            "scope": "token.info-token",
            "settings": { "foreground": "#00d3d0" }
        },
        {
            "name": "Warning token",
            "scope": "token.warn-token",
            "settings": { "foreground": "#feacd0" }
        },
        {
            "name": "Error token",
            "scope": "token.error-token",
            "settings": { "foreground": "#ff6740" }
        },
        {
            "name": "Debug token",
            "scope": "token.debug-token",
            "settings": { "foreground": "#b6a0ff" }
        }
    ],
    "semanticTokenColors": {
        "type": "#79a8ff",
        "function": "#4ae2ff",
        "method": "#4ae2ff",
        "variable": "#6ae4b9",
        "keyword": "#ff7f86",
        "comment": { "foreground": "#ff9070", "fontStyle": "italic" },
        "string": "#00d3d0",
        "number": "#ffffff",
        "regexp": "#ff5f59",
        "operator": "#ffffff"
    }
}
