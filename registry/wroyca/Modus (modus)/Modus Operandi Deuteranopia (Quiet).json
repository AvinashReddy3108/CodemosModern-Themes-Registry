    "tokenColors": [
        {
            "name": "Type",
            "scope": "type",
            "settings": { "foreground": "#005f5f" }
        },
        {
            "name": "Variable",
            "scope": ["variable", "variable.other.object.access.cpp"],
            "settings": { "foreground": "#005e8b" }
        },
        {
            "name": "Function",
            "scope": "function",
            "settings": { "foreground": "#973300" }
        },
        {
            "name": "Method",
            "scope": "method",
            "settings": { "foreground": "#973300" }
        },
        {
            "name": "Comment",
            "scope": "comment",
            "settings": { "foreground": "#77492f", "fontStyle": "italic" }
        },
        {
            "name": "String",
            "scope": "string",
            "settings": { "foreground": "#3548cf" }
        },
        {
            "name": "Keyword",
            "scope": "keyword",
            "settings": { "foreground": "#0000b0" }
        },
        {
            "name": "Number",
            "scope": "number",
            "settings": { "foreground": "#000000" }
        },
        {
            "name": "Regexp",
            "scope": "regexp",
            "settings": { "foreground": "#77492f" }
        },
        {
            "name": "Operator",
            "scope": "operator",
            "settings": { "foreground": "#000000" }
        },
        {
            "name": "Info token",
            "scope": "token.info-token",
            "settings": { "foreground": "#0031a9" }
        },
        {
            "name": "Warning token",
            "scope": "token.warn-token",
            "settings": { "foreground": "#695500" }
        },
        {
            "name": "Error token",
            "scope": "token.error-token",
            "settings": { "foreground": "#973300" }
        },
        {
            "name": "Debug token",
            "scope": "token.debug-token",
            "settings": { "foreground": "#531ab6" }
        }
    ],
    "semanticTokenColors": {
        "type": "#005f5f",
        "function": "#973300",
        "method": "#973300",
        "variable": "#005e8b",
        "parameter": "#005e8b",
        "keyword": "#0000b0",
        "comment": { "foreground": "#77492f", "fontStyle": "italic" },
        "string": "#3548cf",
        "number": "#000000",
        "regexp": "#77492f",
        "operator": "#000000",
        "namespace": "#000000",
        "class": "#000000",
        "enum": "#000000",
        "interface": "#000000",
        "struct": "#000000",
        "typeParameter": "#000000",
        "property": true,
        "enumMember": "#000000",
        "decorator": "#000000",
        "event": "#000000",
        "macro": "#000000",
        "label": "#000000",
        "modifier": "#000000",
        "function.defaultLibrary": "#000000",
        "method.defaultLibrary": "#000000",
        "variable.readonly": "#000000",
        "variable.defaultLibrary": "#000000",
        "property.readonly": "#000000"
    }
