    "tokenColors": [
        {
            "name": "Type",
            "scope": "type",
            "settings": { "foreground": "#11c777" }
        },
        {
            "name": "Variable",
            "scope": ["variable", "variable.other.object.access.cpp"],
            "settings": { "foreground": "#4ae2f0" }
        },
        {
            "name": "Function",
            "scope": "function",
            "settings": { "foreground": "#f78fe7" }
        },
        {
            "name": "Method",
            "scope": "method",
            "settings": { "foreground": "#f78fe7" }
        },
        {
            "name": "Comment",
            "scope": "comment",
            "settings": { "foreground": "#ef8386", "fontStyle": "italic" }
        },
        {
            "name": "String",
            "scope": "string",
            "settings": { "foreground": "#2fafff" }
        },
        {
            "name": "Keyword",
            "scope": "keyword",
            "settings": { "foreground": "#79a8ff" }
        },
        {
            "name": "Number",
            "scope": "number",
            "settings": { "foreground": "#ffffff" }
        },
        {
            "name": "Regexp",
            "scope": "regexp",
            "settings": { "foreground": "#b6a0ff" }
        },
        {
            "name": "Operator",
            "scope": "operator",
            "settings": { "foreground": "#ffffff" }
        },
        {
            "name": "Info token",
            "scope": "token.info-token",
            "settings": { "foreground": "#11c777" }
        },
        {
            "name": "Warning token",
            "scope": "token.warn-token",
            "settings": { "foreground": "#d0bc00" }
        },
        {
            "name": "Error token",
            "scope": "token.error-token",
            "settings": { "foreground": "#ff5f59" }
        },
        {
            "name": "Debug token",
            "scope": "token.debug-token",
            "settings": { "foreground": "#b6a0ff" }
        }
    ],
    "semanticTokenColors": {
        "type": "#11c777",
        "function": "#f78fe7",
        "method": "#f78fe7",
        "variable": "#4ae2f0",
        "parameter": "#4ae2f0",
        "keyword": "#79a8ff",
        "comment": { "foreground": "#ef8386", "fontStyle": "italic" },
        "string": "#2fafff",
        "number": "#ffffff",
        "regexp": "#b6a0ff",
        "operator": "#ffffff",
        "namespace": "#ffffff",
        "class": "#ffffff",
        "enum": "#ffffff",
        "interface": "#ffffff",
        "struct": "#ffffff",
        "typeParameter": "#ffffff",
        "property": true,
        "enumMember": "#ffffff",
        "decorator": "#ffffff",
        "event": "#ffffff",
        "macro": "#ffffff",
        "label": "#ffffff",
        "modifier": "#ffffff",
        "function.defaultLibrary": "#ffffff",
        "method.defaultLibrary": "#ffffff",
        "variable.readonly": "#ffffff",
        "variable.defaultLibrary": "#ffffff",
        "property.readonly": "#ffffff"
    }
}
