{
    "$schema": "vscode://schemas/color-theme",
    "name": "Classic Terminal Ink",
    "type": "dark",
    "semanticHighlighting": true,
    "include": "./obsidian-core-black.json",
    "colors": {
        "editor.background": "#0E0E0D",
        "editor.foreground": "#D4D0C8",
        "editor.lineHighlightBackground": "#161614",
        "editor.lineHighlightBorder": "#161614",
        "editor.selectionBackground": "#3A3934AA",
        "editor.inactiveSelectionBackground": "#3A393477",
        "editor.findMatchBackground": "#C9AF6A44",
        "editor.findMatchHighlightBackground": "#C9AF6A24",
        "editorCursor.foreground": "#C9AF6A",
        "editorIndentGuide.background1": "#34332EB3",
        "editorIndentGuide.activeBackground1": "#504D45",
        "editorLineNumber.foreground": "#58554D",
        "editorLineNumber.activeForeground": "#D4D0C8",
        "editorError.foreground": "#D7817B",
        "editorWarning.foreground": "#C9AF6A",
        "editorGutter.addedBackground": "#9BB987",
        "editorGutter.modifiedBackground": "#C9AF6A",
        "editorGutter.deletedBackground": "#D7817B",
        "activityBarBadge.background": "#C9AF6A",
        "activityBarBadge.foreground": "#0C0C0B",
        "list.activeSelectionBackground": "#C9AF6A1F",
        "list.highlightForeground": "#D7BF86",
        "statusBarItem.remoteBackground": "#C9AF6A",
        "statusBarItem.remoteForeground": "#0C0C0B",
        "terminalCursor.foreground": "#C9AF6A",
        "button.background": "#C9AF6A",
        "button.foreground": "#0C0C0B",
        "button.hoverBackground": "#D4BB7F99",
        "badge.background": "#C9AF6A",
        "badge.foreground": "#0C0C0B",
        "editorSuggestWidget.highlightForeground": "#D7BF86",
        "peekView.border": "#D7BF86",
        "diffEditor.insertedTextBackground": "#9BB98722",
        "diffEditor.removedTextBackground": "#D7817B22",
        "gitDecoration.addedResourceForeground": "#9BB987",
        "gitDecoration.modifiedResourceForeground": "#C9AF6A",
        "gitDecoration.deletedResourceForeground": "#D7817B",
        "gitDecoration.untrackedResourceForeground": "#8FA6BE",
        "minimap.errorHighlight": "#D7817B",
        "minimap.warningHighlight": "#C9AF6A",
        "minimap.findMatchHighlight": "#D7BF8666",
        "minimapGutter.addedBackground": "#9BB987",
        "minimapGutter.modifiedBackground": "#C9AF6A",
        "minimapGutter.deletedBackground": "#D7817B",
        "notificationLink.foreground": "#D7BF86",
        "progressBar.background": "#C9AF6A",
        "textLink.foreground": "#D7BF86",
        "textSeparator.foreground": "#C9AF6A",
        "extensionButton.prominentBackground": "#C9AF6A",
        "extensionButton.prominentForeground": "#0C0C0B",
        "settings.modifiedItemIndicator": "#D7BF86",
        "welcomePage.progress.foreground": "#C9AF6A"
    },
    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#6B665E", "fontStyle": "italic" }
        },
        {
            "name": "String",
            "scope": [
                "string",
                "string.quoted",
                "string.template",
                "punctuation.definition.string.begin",
                "punctuation.definition.string.end"
            ],
            "settings": { "foreground": "#9BB987" }
        },
        {
            "name": "Numbers",
            "scope": ["constant.numeric", "constant.character"],
            "settings": { "foreground": "#C9AF6A" }
        },
        {
            "name": "Constants",
            "scope": ["constant.language", "constant.other"],
            "settings": { "foreground": "#D7BF86" }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.other",
                "storage",
                "storage.type",
                "storage.modifier",
                "keyword.operator.new"
            ],
            "settings": { "foreground": "#BFA07A" }
        },
        {
            "name": "Operators",
            "scope": [
                "keyword.operator",
                "keyword.operator.logical",
                "keyword.operator.arithmetic",
                "keyword.operator.assignment",
                "keyword.operator.relational",
                "keyword.operator.comparison"
            ],
            "settings": { "foreground": "#C8C1B4" }
        },
        {
            "name": "Function",
            "scope": [
                "entity.name.function",
                "support.function",
                "variable.function",
                "meta.method-call",
                "entity.name.function.member"
            ],
            "settings": { "foreground": "#8FA6BE" }
        },
        {
            "name": "Type",
            "scope": [
                "entity.name.class",
                "entity.name.type",
                "entity.name.type.class",
                "entity.name.type.namespace",
                "entity.name.namespace",
                "support.class",
                "support.type"
            ],
            "settings": { "foreground": "#CDBB92" }
        },
        {
            "name": "Property",
            "scope": [
                "variable.object.property",
                "variable.other.property",
                "support.variable.property",
                "meta.object-literal.key"
            ],
            "settings": { "foreground": "#ADB8C2" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#D7817B" }
        }
    ],
    "semanticTokenColors": {
        "namespace": "#CDBB92",
        "class": "#CDBB92",
        "type": "#CDBB92",
        "interface": "#8FA6BE",
        "struct": "#8FA6BE",
        "enum": "#CDBB92",
        "enumMember": "#BFA07A",
        "typeParameter": "#9BB987",
        "parameter": "#C5BDB0",
        "variable": "#D4D0C8",
        "variable.readonly": "#D7BF86",
        "property": "#ADB8C2",
        "property.readonly": "#D7BF86",
        "function": "#8FA6BE",
        "method": "#8FA6BE",
        "macro": "#9BB987",
        "decorator": "#9BB987",
        "keyword": "#BFA07A",
        "string": "#9BB987",
        "number": "#C9AF6A",
        "regexp": "#C2A0AA",
        "operator": "#C8C1B4"
    }
}
