    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#5A6A54", "fontStyle": "italic" }
        },
        {
            "name": "String",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#A8C99E" }
        },
        {
            "name": "String punctuation",
            "scope": [
                "punctuation.definition.string.begin",
                "punctuation.definition.string.end"
            ],
            "settings": { "foreground": "#A8C99E" }
        },
        {
            "name": "Number",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#DCDCAA" }
        },
        {
            "name": "Built-in constant",
            "scope": ["constant.language"],
            "settings": { "foreground": "#DCDCAA" }
        },
        {
            "name": "User-defined constant",
            "scope": ["variable.other.constant"],
            "settings": { "foreground": "#D4A959" }
        },
        {
            "name": "Variable",
            "scope": ["variable", "variable.other.readwrite"],
            "settings": { "foreground": "#C8D5C2" }
        },
        {
            "name": "Variable parameter",
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#B0BDA8", "fontStyle": "italic" }
        },
        {
            "name": "Variable language (this, self)",
            "scope": [
                "variable.language",
                "variable.language.this",
                "variable.language.self"
            ],
            "settings": { "foreground": "#E06C75" }
        },
        {
            "name": "Keyword",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.new",
                "keyword.other"
            ],
            "settings": { "foreground": "#C4A7E7" }
        },
        {
            "name": "Storage",
            "scope": ["storage", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#C4A7E7" }
        },
        {
            "name": "Operator",
            "scope": [
                "keyword.operator",
                "keyword.operator.logical",
                "keyword.operator.arithmetic",
                "keyword.operator.assignment",
                "keyword.operator.relational",
                "keyword.operator.comparison"
            ],
            "settings": { "foreground": "#B0BDA8" }
        },
        {
            "name": "Special operators",
            "scope": [
                "keyword.operator.ternary",
                "keyword.operator.optional",
                "keyword.operator.expression.instanceof",
                "keyword.operator.expression.typeof"
            ],
            "settings": { "foreground": "#C4A7E7" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation",
                "punctuation.definition",
                "punctuation.separator",
                "punctuation.terminator",
                "punctuation.section"
            ],
            "settings": { "foreground": "#B0BDA8" }
        },
        {
            "name": "Function name",
            "scope": [
                "entity.name.function",
                "meta.require",
                "support.function",
                "variable.function"
            ],
            "settings": { "foreground": "#95C561" }
        },
        {
            "name": "Method",
            "scope": [
                "meta.method-call",
                "meta.method",
                "entity.name.function.member"
            ],
            "settings": { "foreground": "#95C561" }
        },
        {
            "name": "Class, Type",
            "scope": [
                "entity.name.class",
                "entity.name.type",
                "entity.name.type.class",
                "support.class",
                "support.type"
            ],
            "settings": { "foreground": "#6A9FB5" }
        },
        {
            "name": "Type namespace",
            "scope": ["entity.name.type.namespace", "entity.name.namespace"],
            "settings": { "foreground": "#D4A959" }
        },
        {
            "name": "Property",
            "scope": [
                "variable.object.property",
                "variable.other.property",
                "support.variable.property"
            ],
            "settings": { "foreground": "#78B0A0" }
        },
        {
            "name": "Object key",
            "scope": ["meta.object-literal.key"],
            "settings": { "foreground": "#78B0A0" }
        },
        {
            "name": "Tag",
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#6A9FB5" }
        },
        {
            "name": "Tag attribute",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#D4A959" }
        },
        {
            "name": "Decorator",
            "scope": ["meta.decorator", "punctuation.decorator"],
            "settings": { "foreground": "#A8C99E" }
        },
        {
            "name": "Template expression",
            "scope": [
                "punctuation.definition.template-expression.begin",
                "punctuation.definition.template-expression.end",
                "punctuation.section.embedded"
            ],
            "settings": { "foreground": "#C4A7E7" }
        },
        {
            "name": "JSON Key",
            "scope": [
                "support.type.property-name.json",
                "meta.structure.dictionary.key.json"
            ],
            "settings": { "foreground": "#78B0A0" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#E06C75" }
        },
        {
            "name": "Source - Default",
            "scope": ["source"],
            "settings": { "foreground": "#C8D5C2" }
        },
        {
            "name": "Bold text",
            "scope": ["markup.bold"],
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Underline text",
            "scope": ["markup.underline"],
            "settings": { "fontStyle": "underline" }
        },
        {
            "name": "Strikethrough text",
            "scope": ["markup.strikethrough"],
            "settings": { "fontStyle": "strikethrough" }
        }
    ]
}
