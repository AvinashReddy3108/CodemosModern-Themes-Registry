    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#5A5A88", "fontStyle": "italic" }
        },
        {
            "name": "String",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#95E6CB" }
        },
        {
            "name": "String punctuation",
            "scope": [
                "punctuation.definition.string.begin",
                "punctuation.definition.string.end"
            ],
            "settings": { "foreground": "#95E6CB" }
        },
        {
            "name": "Number",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#FFD580" }
        },
        {
            "name": "Built-in constant",
            "scope": ["constant.language"],
            "settings": { "foreground": "#FFD580" }
        },
        {
            "name": "User-defined constant",
            "scope": ["variable.other.constant"],
            "settings": { "foreground": "#C4A7E7" }
        },
        {
            "name": "Variable",
            "scope": ["variable", "variable.other.readwrite"],
            "settings": { "foreground": "#D0D0E8" }
        },
        {
            "name": "Variable parameter",
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#B8B8D0", "fontStyle": "italic" }
        },
        {
            "name": "Variable language (this, self)",
            "scope": [
                "variable.language",
                "variable.language.this",
                "variable.language.self"
            ],
            "settings": { "foreground": "#FF6480" }
        },
        {
            "name": "Keyword",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.new",
                "keyword.other"
            ],
            "settings": { "foreground": "#A277FF" }
        },
        {
            "name": "Storage",
            "scope": ["storage", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#A277FF" }
        },
        {
            "name": "Operator",
            "scope": [
                "keyword.operator",
                "keyword.operator.logical",
                "keyword.operator.arithmetic",
                "keyword.operator.assignment",
                "keyword.operator.relational",
                "keyword.operator.comparison"
            ],
            "settings": { "foreground": "#86E1FC" }
        },
        {
            "name": "Special operators",
            "scope": [
                "keyword.operator.ternary",
                "keyword.operator.optional",
                "keyword.operator.expression.instanceof",
                "keyword.operator.expression.typeof"
            ],
            "settings": { "foreground": "#A277FF" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation",
                "punctuation.definition",
                "punctuation.separator",
                "punctuation.terminator",
                "punctuation.section"
            ],
            "settings": { "foreground": "#B8B8D0" }
        },
        {
            "name": "Function name",
            "scope": [
                "entity.name.function",
                "meta.require",
                "support.function",
                "variable.function"
            ],
            "settings": { "foreground": "#82AAFF" }
        },
        {
            "name": "Method",
            "scope": [
                "meta.method-call",
                "meta.method",
                "entity.name.function.member"
            ],
            "settings": { "foreground": "#82AAFF" }
        },
        {
            "name": "Class, Type",
            "scope": [
                "entity.name.class",
                "entity.name.type",
                "entity.name.type.class",
                "support.class",
                "support.type"
            ],
            "settings": { "foreground": "#FFD580" }
        },
        {
            "name": "Type namespace",
            "scope": ["entity.name.type.namespace", "entity.name.namespace"],
            "settings": { "foreground": "#FFD580" }
        },
        {
            "name": "Property",
            "scope": [
                "variable.object.property",
                "variable.other.property",
                "support.variable.property"
            ],
            "settings": { "foreground": "#C4A7E7" }
        },
        {
            "name": "Object key",
            "scope": ["meta.object-literal.key"],
            "settings": { "foreground": "#C4A7E7" }
        },
        {
            "name": "Tag",
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#FF6480" }
        },
        {
            "name": "Tag attribute",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#FFD580" }
        },
        {
            "name": "Decorator",
            "scope": ["meta.decorator", "punctuation.decorator"],
            "settings": { "foreground": "#95E6CB" }
        },
        {
            "name": "Template expression",
            "scope": [
                "punctuation.definition.template-expression.begin",
                "punctuation.definition.template-expression.end",
                "punctuation.section.embedded"
            ],
            "settings": { "foreground": "#A277FF" }
        },
        {
            "name": "JSON Key",
            "scope": [
                "support.type.property-name.json",
                "meta.structure.dictionary.key.json"
            ],
            "settings": { "foreground": "#82AAFF" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#FF6480" }
        },
        {
            "name": "Source - Default",
            "scope": ["source"],
            "settings": { "foreground": "#D0D0E8" }
        },
        {
            "name": "Bold text",
            "scope": ["markup.bold"],
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Underline text",
            "scope": ["markup.underline"],
            "settings": { "fontStyle": "underline" }
        },
        {
            "name": "Strikethrough text",
            "scope": ["markup.strikethrough"],
            "settings": { "fontStyle": "strikethrough" }
        }
    ]
}
