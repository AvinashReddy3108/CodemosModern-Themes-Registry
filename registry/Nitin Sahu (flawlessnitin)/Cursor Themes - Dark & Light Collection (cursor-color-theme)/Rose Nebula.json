        "peekViewEditor.matchHighlightBackground": "#7FD9FF44",
        "peekViewResult.background": "#0D0A14",
        "peekViewResult.fileForeground": "#FFFFFF",
        "peekViewResult.lineForeground": "#FFFFFF66",
        "peekViewResult.matchHighlightBackground": "#7FD9FF44",
        "peekViewResult.selectionBackground": "#3B3252",
        "peekViewResult.selectionForeground": "#FFFFFF",
        "peekViewTitle.background": "#1E1A29",
        "peekViewTitleDescription.foreground": "#FFFFFF",
        "peekViewTitleLabel.foreground": "#FFFFFF",
        "diffEditor.insertedTextBackground": "#9EE7B822",
        "diffEditor.removedTextBackground": "#FF8BA722",
        "gitDecoration.addedResourceForeground": "#9EE7B8",
        "gitDecoration.modifiedResourceForeground": "#F5CD79",
        "gitDecoration.deletedResourceForeground": "#FF8BA7",
        "gitDecoration.untrackedResourceForeground": "#7FD9FF",
        "gitDecoration.ignoredResourceForeground": "#6E6388",
        "minimap.background": "#100E17",
        "minimap.selectionHighlight": "#2C2540",
        "minimap.errorHighlight": "#FF8BA7",
        "minimap.warningHighlight": "#F5CD79",
        "minimap.findMatchHighlight": "#7FD9FF66",
        "minimapGutter.addedBackground": "#9EE7B8",
        "minimapGutter.modifiedBackground": "#F5CD79",
        "minimapGutter.deletedBackground": "#FF8BA7",
        "breadcrumb.background": "#13111A",
        "breadcrumb.foreground": "#C7BCD999",
        "breadcrumb.focusForeground": "#FFFFFF",
        "breadcrumb.activeSelectionForeground": "#FFFFFF",
        "breadcrumbPicker.background": "#0D0A14",
        "quickInput.background": "#0D0A14",
        "quickInput.foreground": "#E3DCF2DD",
        "quickInputList.focusBackground": "#7FD9FF1F",
        "quickInputTitle.background": "#FFFFFF10",
        "menu.background": "#0D0A14",
        "menu.foreground": "#E3DCF2",
        "menu.separatorBackground": "#6E6388",
        "menubar.selectionBackground": "#E3DCF233",
        "notificationLink.foreground": "#7FD9FF",
        "notificationCenter.border": "#1E1A29",
        "notificationCenterHeader.background": "#13111A",
        "notificationCenterHeader.foreground": "#E3DCF2",
        "notifications.background": "#0D0A14",
        "notifications.foreground": "#FFFFFF",
        "notifications.border": "#1E1A29",
        "notificationToast.border": "#1E1A29",
        "progressBar.background": "#E78AF7",
        "textLink.foreground": "#7FD9FF",
        "textLink.activeForeground": "#8FB3FF",
        "textPreformat.foreground": "#9EE7B8",
        "textSeparator.foreground": "#E78AF7",
        "debugToolBar.background": "#13111A",
        "debugExceptionWidget.background": "#3B3252",
        "debugExceptionWidget.border": "#0D0A14",
        "extensionButton.prominentBackground": "#E78AF7",
        "extensionButton.prominentForeground": "#0D0A14",
        "extensionButton.prominentHoverBackground": "#EEA2FA",
        "settings.headerForeground": "#F0EAFE",
        "settings.modifiedItemIndicator": "#7FD9FF",
        "welcomePage.background": "#13111A",
        "welcomePage.tileBackground": "#13111A",
        "welcomePage.tileBorder": "#1E1A29",
        "welcomePage.progress.background": "#1E1A29",
        "welcomePage.progress.foreground": "#E78AF7",
        "walkThrough.embeddedEditorBackground": "#0D0A14",
        "widget.shadow": "#00000088",
        "tree.indentGuidesStroke": "#6E638855"
    },
    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#6E6388", "fontStyle": "italic" }
        },
        {
            "name": "String",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#9EE7B8" }
        },
        {
            "name": "String punctuation",
            "scope": [
                "punctuation.definition.string.begin",
                "punctuation.definition.string.end"
            ],
            "settings": { "foreground": "#9EE7B8" }
        },
        {
            "name": "Number",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#F8B985" }
        },
        {
            "name": "Built-in constant",
            "scope": ["constant.language"],
            "settings": { "foreground": "#F5CD79" }
        },
        {
            "name": "User-defined constant",
            "scope": ["variable.other.constant"],
            "settings": { "foreground": "#E78AF7" }
        },
        {
            "name": "Variable",
            "scope": ["variable", "variable.other.readwrite"],
            "settings": { "foreground": "#E3DCF2" }
        },
        {
            "name": "Variable parameter",
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#CDC3E1", "fontStyle": "italic" }
        },
        {
            "name": "Variable language",
            "scope": [
                "variable.language",
                "variable.language.this",
                "variable.language.self"
            ],
            "settings": { "foreground": "#FF8BA7" }
        },
        {
            "name": "Keyword",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.other",
                "keyword.operator.new"
            ],
            "settings": { "foreground": "#E78AF7" }
        },
        {
            "name": "Storage",
            "scope": ["storage", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#E78AF7" }
        },
        {
            "name": "Operator",
            "scope": [
                "keyword.operator",
                "keyword.operator.logical",
                "keyword.operator.arithmetic",
                "keyword.operator.assignment",
                "keyword.operator.relational",
                "keyword.operator.comparison"
            ],
            "settings": { "foreground": "#92E1FF" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation",
                "punctuation.definition",
                "punctuation.separator",
                "punctuation.terminator",
                "punctuation.section"
            ],
            "settings": { "foreground": "#BCB1D2" }
        },
        {
            "name": "Function name",
            "scope": [
                "entity.name.function",
                "meta.require",
                "support.function",
                "variable.function"
            ],
            "settings": { "foreground": "#7FD9FF" }
        },
        {
            "name": "Method",
            "scope": [
                "meta.method-call",
                "meta.method",
                "entity.name.function.member"
            ],
            "settings": { "foreground": "#7FD9FF" }
        },
        {
            "name": "Class, Type",
            "scope": [
                "entity.name.class",
                "entity.name.type",
                "entity.name.type.class",
                "support.class",
                "support.type"
            ],
            "settings": { "foreground": "#F5CD79" }
        },
        {
            "name": "Type namespace",
            "scope": ["entity.name.type.namespace", "entity.name.namespace"],
            "settings": { "foreground": "#F8B985" }
        },
        {
            "name": "Property",
            "scope": [
                "variable.object.property",
                "variable.other.property",
                "support.variable.property"
            ],
            "settings": { "foreground": "#8FB3FF" }
        },
        {
            "name": "Object key",
            "scope": ["meta.object-literal.key"],
            "settings": { "foreground": "#8FB3FF" }
        },
        {
            "name": "Support",
            "scope": ["support.constant", "support.variable"],
            "settings": { "foreground": "#9EE7B8" }
        },
        {
            "name": "Tag",
            "scope": ["entity.name.tag", "entity.name.tag.html"],
            "settings": { "foreground": "#7FD9FF" }
        },
        {
            "name": "Tag attribute",
            "scope": [
                "entity.other.attribute-name",
                "entity.other.attribute-name.js",
                "entity.other.attribute-name.ts",
                "entity.other.attribute-name.jsx",
                "entity.other.attribute-name.tsx"
            ],
            "settings": { "foreground": "#E78AF7", "fontStyle": "italic" }
        },
        {
            "name": "Decorator",
            "scope": [
                "meta.decorator",
                "punctuation.decorator",
                "meta.function.decorator.python"
            ],
            "settings": { "foreground": "#9EE7B8" }
        },
        {
            "name": "Template expression",
            "scope": [
                "punctuation.definition.template-expression.begin",
                "punctuation.definition.template-expression.end",
                "punctuation.section.embedded"
            ],
            "settings": { "foreground": "#E78AF7" }
        },
        {
            "name": "Regex",
            "scope": ["string.regexp"],
            "settings": { "foreground": "#F0A4D7" }
        },
        {
            "name": "Escape characters",
            "scope": ["constant.character.escape"],
            "settings": { "foreground": "#F8B985" }
        },
        {
            "name": "JSON Key",
            "scope": [
                "support.type.property-name.json",
                "meta.structure.dictionary.key.json"
            ],
            "settings": { "foreground": "#7FD9FF" }
        },
        {
            "name": "JSON Value String",
            "scope": [
                "source.json meta.structure.dictionary.json > value.json > string.quoted.json",
                "source.json meta.structure.array.json > value.json > string.quoted.json"
            ],
            "settings": { "foreground": "#9EE7B8" }
        },
        {
            "name": "CSS Property",
            "scope": [
                "support.type.property-name.css",
                "meta.property-name.css"
            ],
            "settings": { "foreground": "#8FB3FF" }
        },
        {
            "name": "CSS Value",
            "scope": [
                "support.constant.property-value.css",
                "meta.property-value.css"
            ],
            "settings": { "foreground": "#9EE7B8" }
        },
        {
            "name": "Markup Heading",
            "scope": ["markup.heading", "entity.name.section"],
            "settings": { "fontStyle": "bold", "foreground": "#7FD9FF" }
        },
        {
            "name": "Markup Code",
            "scope": [
                "markup.inline.raw",
                "markup.fenced_code",
                "markup.inline.raw.markdown",
                "markup.inline.raw.string.markdown"
            ],
            "settings": { "foreground": "#9EE7B8" }
        },
        {
            "name": "Diff - Inserted",
            "scope": ["markup.inserted.diff"],
            "settings": { "foreground": "#9EE7B8" }
        },
        {
            "name": "Diff - Deleted",
            "scope": ["markup.deleted.diff"],
            "settings": { "foreground": "#FF8BA7" }
        },
        {
            "name": "Diff - Changed",
            "scope": ["markup.changed.diff"],
            "settings": { "foreground": "#F5CD79" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#FF8BA7" }
        },
        {
            "name": "Source - Default",
            "scope": ["source"],
            "settings": { "foreground": "#E3DCF2" }
        }
    ],
    "semanticTokenColors": {
        "namespace": "#F8B985",
        "class": "#F5CD79",
        "type": "#F5CD79",
        "interface": "#7FD9FF",
        "struct": "#7FD9FF",
        "enum": "#F5CD79",
        "enumMember": "#E78AF7",
        "typeParameter": "#9EE7B8",
        "parameter": "#CDC3E1",
        "variable": "#E3DCF2",
        "variable.readonly": "#F5CD79",
        "property": "#8FB3FF",
        "property.readonly": "#F5CD79",
        "function": "#7FD9FF",
        "method": "#7FD9FF",
        "macro": "#9EE7B8",
        "decorator": "#9EE7B8",
        "keyword": "#E78AF7",
        "string": "#9EE7B8",
        "number": "#F8B985",
        "regexp": "#F0A4D7",
        "operator": "#92E1FF"
    }
}
