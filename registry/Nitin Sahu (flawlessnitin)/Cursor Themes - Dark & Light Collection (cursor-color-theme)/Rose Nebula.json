        "editorSuggestWidget.background": "#0D0A14",
        "editorSuggestWidget.border": "#1E1A29",
        "editorSuggestWidget.foreground": "#FFFFFF",
        "editorSuggestWidget.highlightForeground": "#7FD9FF",
        "editorSuggestWidget.selectedBackground": "#3B3252",
        "editorHoverWidget.background": "#13111A",
        "editorHoverWidget.border": "#1E1A29",
        "peekView.border": "#7FD9FF",
