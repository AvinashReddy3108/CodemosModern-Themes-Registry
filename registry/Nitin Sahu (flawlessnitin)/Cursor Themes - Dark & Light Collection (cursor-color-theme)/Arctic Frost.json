    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#94A3B8", "fontStyle": "italic" }
        },
        {
            "name": "String",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#059669" }
        },
        {
            "name": "String punctuation",
            "scope": [
                "punctuation.definition.string.begin",
                "punctuation.definition.string.end"
            ],
            "settings": { "foreground": "#059669" }
        },
        {
            "name": "Number",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#D97706" }
        },
        {
            "name": "Built-in constant",
            "scope": ["constant.language"],
            "settings": { "foreground": "#D97706" }
        },
        {
            "name": "User-defined constant",
            "scope": ["variable.other.constant"],
            "settings": { "foreground": "#0D9488" }
        },
        {
            "name": "Variable",
            "scope": ["variable", "variable.other.readwrite"],
            "settings": { "foreground": "#334155" }
        },
        {
            "name": "Variable parameter",
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#475569", "fontStyle": "italic" }
        },
        {
            "name": "Variable language (this, self)",
            "scope": [
                "variable.language",
                "variable.language.this",
                "variable.language.self"
            ],
            "settings": { "foreground": "#DC2626" }
        },
        {
            "name": "Keyword",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.new",
                "keyword.other"
            ],
            "settings": { "foreground": "#7C3AED" }
        },
        {
            "name": "Storage",
            "scope": ["storage", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#7C3AED" }
        },
        {
            "name": "Operator",
            "scope": [
                "keyword.operator",
                "keyword.operator.logical",
                "keyword.operator.arithmetic",
                "keyword.operator.assignment",
                "keyword.operator.relational",
                "keyword.operator.comparison"
            ],
            "settings": { "foreground": "#475569" }
        },
        {
            "name": "Special operators",
            "scope": [
                "keyword.operator.ternary",
                "keyword.operator.optional",
                "keyword.operator.expression.instanceof",
                "keyword.operator.expression.typeof"
            ],
            "settings": { "foreground": "#7C3AED" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation",
                "punctuation.definition",
                "punctuation.separator",
                "punctuation.terminator",
                "punctuation.section"
            ],
            "settings": { "foreground": "#475569" }
        },
        {
            "name": "Function name",
            "scope": [
                "entity.name.function",
                "meta.require",
                "support.function",
                "variable.function"
            ],
            "settings": { "foreground": "#2563EB" }
        },
        {
            "name": "Method",
            "scope": [
                "meta.method-call",
                "meta.method",
                "entity.name.function.member"
            ],
            "settings": { "foreground": "#2563EB" }
        },
        {
            "name": "Class, Type",
            "scope": [
                "entity.name.class",
                "entity.name.type",
                "entity.name.type.class",
                "support.class",
                "support.type"
            ],
            "settings": { "foreground": "#D97706" }
        },
        {
            "name": "Property",
            "scope": [
                "variable.object.property",
                "variable.other.property",
                "support.variable.property"
            ],
            "settings": { "foreground": "#0D9488" }
        },
        {
            "name": "Object key",
            "scope": ["meta.object-literal.key"],
            "settings": { "foreground": "#0D9488" }
        },
        {
            "name": "Tag",
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#DC2626" }
        },
        {
            "name": "Tag attribute",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#D97706" }
        },
        {
            "name": "Decorator",
            "scope": ["meta.decorator", "punctuation.decorator"],
            "settings": { "foreground": "#059669" }
        },
        {
            "name": "Template expression",
            "scope": [
                "punctuation.definition.template-expression.begin",
                "punctuation.definition.template-expression.end",
                "punctuation.section.embedded"
            ],
            "settings": { "foreground": "#7C3AED" }
        },
        {
            "name": "JSON Key",
            "scope": [
                "support.type.property-name.json",
                "meta.structure.dictionary.key.json"
            ],
            "settings": { "foreground": "#0D9488" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#DC2626" }
        },
        {
            "name": "Source - Default",
            "scope": ["source"],
            "settings": { "foreground": "#334155" }
        },
        {
            "name": "Bold text",
            "scope": ["markup.bold"],
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Underline text",
            "scope": ["markup.underline"],
            "settings": { "fontStyle": "underline" }
        },
        {
            "name": "Strikethrough text",
            "scope": ["markup.strikethrough"],
            "settings": { "fontStyle": "strikethrough" }
        }
    ]
}
