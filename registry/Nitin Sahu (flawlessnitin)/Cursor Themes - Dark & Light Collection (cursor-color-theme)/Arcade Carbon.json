{
    "$schema": "vscode://schemas/color-theme",
    "name": "Arcade Carbon",
    "type": "dark",
    "semanticHighlighting": true,
    "include": "./obsidian-core-black.json",
    "colors": {
        "editor.background": "#0F0F0E",
        "editor.foreground": "#E1DCD3",
        "editor.lineHighlightBackground": "#171716",
        "editor.lineHighlightBorder": "#171716",
        "editor.selectionBackground": "#B7A3FF33",
        "editor.inactiveSelectionBackground": "#B7A3FF24",
        "editor.selectionHighlightBackground": "#6EDCF12D",
        "editor.findMatchBackground": "#6EDCF144",
        "editor.findMatchHighlightBackground": "#6EDCF124",
        "editorCursor.foreground": "#6EDCF1",
        "editorIndentGuide.background1": "#33322FB3",
        "editorIndentGuide.activeBackground1": "#514E46",
        "editorLineNumber.foreground": "#5D5A52",
        "editorLineNumber.activeForeground": "#FF78C8",
        "editorError.foreground": "#FF857D",
        "editorWarning.foreground": "#F2CA72",
        "editorGutter.addedBackground": "#9CE08E",
        "editorGutter.modifiedBackground": "#F2CA72",
        "editorGutter.deletedBackground": "#FF857D",
        "activityBarBadge.background": "#FF78C8",
        "activityBarBadge.foreground": "#0C0C0B",
        "list.activeSelectionBackground": "#6EDCF11F",
        "list.highlightForeground": "#6EDCF1",
        "statusBarItem.remoteBackground": "#FF78C8",
        "statusBarItem.remoteForeground": "#0C0C0B",
        "terminalCursor.foreground": "#6EDCF1",
        "button.background": "#FF78C8",
        "button.foreground": "#0C0C0B",
        "button.hoverBackground": "#FF93D399",
        "badge.background": "#FF78C8",
        "badge.foreground": "#0C0C0B",
        "editorSuggestWidget.highlightForeground": "#6EDCF1",
        "peekView.border": "#6EDCF1",
        "diffEditor.insertedTextBackground": "#9CE08E22",
        "diffEditor.removedTextBackground": "#FF857D22",
        "gitDecoration.addedResourceForeground": "#9CE08E",
        "gitDecoration.modifiedResourceForeground": "#F2CA72",
        "gitDecoration.deletedResourceForeground": "#FF857D",
        "gitDecoration.untrackedResourceForeground": "#6EDCF1",
        "minimap.errorHighlight": "#FF857D",
        "minimap.warningHighlight": "#F2CA72",
        "minimap.findMatchHighlight": "#6EDCF166",
        "minimapGutter.addedBackground": "#9CE08E",
        "minimapGutter.modifiedBackground": "#F2CA72",
        "minimapGutter.deletedBackground": "#FF857D",
        "notificationLink.foreground": "#6EDCF1",
        "progressBar.background": "#FF78C8",
        "textLink.foreground": "#6EDCF1",
        "textSeparator.foreground": "#FF78C8",
        "extensionButton.prominentBackground": "#FF78C8",
        "extensionButton.prominentForeground": "#0C0C0B",
        "settings.modifiedItemIndicator": "#6EDCF1",
        "welcomePage.progress.foreground": "#FF78C8"
    },
    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#6A665E", "fontStyle": "italic" }
        },
        {
            "name": "String",
            "scope": [
                "string",
                "string.quoted",
                "string.template",
                "punctuation.definition.string.begin",
                "punctuation.definition.string.end"
            ],
            "settings": { "foreground": "#9CE08E" }
        },
        {
            "name": "Numbers and constants",
            "scope": [
                "constant.numeric",
                "constant.language",
                "constant.character",
                "constant.other"
            ],
            "settings": { "foreground": "#F2CA72" }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.other",
                "storage",
                "storage.type",
                "storage.modifier",
                "keyword.operator.new"
            ],
            "settings": { "foreground": "#FF78C8" }
        },
        {
            "name": "Operators",
            "scope": [
                "keyword.operator",
                "keyword.operator.logical",
                "keyword.operator.arithmetic",
                "keyword.operator.assignment",
                "keyword.operator.relational",
                "keyword.operator.comparison"
            ],
            "settings": { "foreground": "#6EDCF1" }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "support.function",
                "variable.function",
                "meta.method-call",
                "entity.name.function.member"
            ],
            "settings": { "foreground": "#6EDCF1" }
        },
        {
            "name": "Types",
            "scope": [
                "entity.name.class",
                "entity.name.type",
                "entity.name.type.class",
                "entity.name.type.namespace",
                "entity.name.namespace",
                "support.class",
                "support.type"
            ],
            "settings": { "foreground": "#B7A3FF" }
        },
        {
            "name": "Properties and keys",
            "scope": [
                "variable.object.property",
                "variable.other.property",
                "support.variable.property",
                "meta.object-literal.key"
            ],
            "settings": { "foreground": "#8EB6FF" }
        },
        {
            "name": "Tags and attrs",
            "scope": [
                "entity.name.tag",
                "entity.name.tag.html",
                "entity.other.attribute-name"
            ],
            "settings": { "foreground": "#FF9B85" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#FF857D" }
        }
    ],
    "semanticTokenColors": {
        "namespace": "#B7A3FF",
        "class": "#B7A3FF",
        "type": "#B7A3FF",
        "interface": "#6EDCF1",
        "struct": "#6EDCF1",
        "enum": "#B7A3FF",
        "enumMember": "#FF78C8",
        "typeParameter": "#9CE08E",
        "parameter": "#CDC5B9",
        "variable": "#E1DCD3",
        "variable.readonly": "#F2CA72",
        "property": "#8EB6FF",
        "property.readonly": "#F2CA72",
        "function": "#6EDCF1",
        "method": "#6EDCF1",
        "macro": "#9CE08E",
        "decorator": "#9CE08E",
        "keyword": "#FF78C8",
        "string": "#9CE08E",
        "number": "#F2CA72",
        "regexp": "#F1A5D4",
        "operator": "#6EDCF1"
    }
}
