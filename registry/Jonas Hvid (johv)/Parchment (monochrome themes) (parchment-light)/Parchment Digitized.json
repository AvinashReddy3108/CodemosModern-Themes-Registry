    "tokenColors": [
        {
            "scope": "comment",
            "settings": { "foreground": "#796092", "fontStyle": "bold" }
        },
        { "scope": "keyword", "settings": { "fontStyle": "bold" } },
        { "scope": "storage", "settings": { "fontStyle": "bold" } },
        { "scope": "entity.name.type", "settings": { "fontStyle": "italic" } },
        {
            "scope": "punctuation.separator",
            "settings": { "foreground": "#9e9e9e" }
        },
        {
            "scope": "punctuation.terminator",
            "settings": { "foreground": "#9e9e9e" }
        },
        {
            "scope": "string",
            "settings": { "foreground": "#525252", "fontStyle": "italic" }
        },
        {
            "scope": "punctuation",
            "settings": { "foreground": "#b9b9b9", "fontStyle": "bold" }
        },
        {
            "scope": "meta.brace",
            "settings": { "foreground": "#b9b9b9", "fontStyle": "bold" }
        },
        {
            "scope": "string.unquoted.plain.out.yaml",
            "settings": { "foreground": "#777777", "fontStyle": "normal" }
        },
        {
            "scope": "string.quoted.double.yaml",
            "settings": { "foreground": "#777777", "fontStyle": "normal" }
        },
        {
            "scope": "string.quoted.double.json",
            "settings": { "foreground": "#777777", "fontStyle": "normal" }
        },
        {
            "scope": "constant.numeric.json",
            "settings": { "foreground": "#777777", "fontStyle": "bold" }
        },
        {
            "scope": "constant.numeric.integer.yaml",
            "settings": { "foreground": "#777777", "fontStyle": "bold" }
        },
        {
            "scope": "constant.numeric.float.yaml",
            "settings": { "foreground": "#777777", "fontStyle": "bold" }
        },
        {
            "scope": "constant.language.json",
            "settings": { "foreground": "#777777", "fontStyle": "bold" }
        },
        {
            "scope": "constant.language.boolean.yaml",
            "settings": { "foreground": "#777777", "fontStyle": "bold" }
        },
        {
            "scope": "support.type.property-name.json",
            "settings": { "foreground": "#5e5e5e", "fontStyle": "bold" }
        },
        {
            "scope": "entity.name.tag.yaml",
            "settings": { "foreground": "#5e5e5e", "fontStyle": "bold" }
        },
        { "scope": "markup.heading", "settings": { "fontStyle": "bold" } },
        { "scope": "markup.inline", "settings": { "foreground": "#525252" } },
        { "scope": "markup.italic", "settings": { "fontStyle": "italic" } },
        { "scope": "markup.bold", "settings": { "fontStyle": "bold" } },
        {
            "scope": "markup.quote",
            "settings": { "foreground": "#525252", "fontStyle": "italic" }
        },
        {
            "scope": "markup.raw.block",
            "settings": { "foreground": "#525252" }
        },
        {
            "scope": "markup.fenced_code",
            "settings": { "foreground": "#525252" }
        },
        {
            "scope": "fenced_code.block.language",
            "settings": { "foreground": "#919191" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
