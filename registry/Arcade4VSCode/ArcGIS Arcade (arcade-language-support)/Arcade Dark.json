{
    "name": "Arcade foncé (dark)",
    "type": "dark",
    "colors": {
        "editor.background": "#1E1E1E",
        "editor.foreground": "#D4D4D4",
        "editorCursor.foreground": "#FFFFFF",
        "editor.lineHighlightBackground": "#2A2A2A",
        "editor.selectionBackground": "#264F78",
        "editor.inactiveSelectionBackground": "#3A3D41",
        "editorIndentGuide.background": "#404040",
        "editorIndentGuide.activeBackground": "#707070"
    },
    "tokenColors": [
        {
            "scope": "comment",
            "settings": { "foreground": "#00A298", "fontStyle": "italic" }
        },
        { "scope": "number.arcade", "settings": { "foreground": "#D24A19" } },
        { "scope": "operator.arcade", "settings": { "foreground": "#74879A" } },
        {
            "scope": "punctuation.bracket.arcade",
            "settings": { "foreground": "#0088D1" }
        },
        { "scope": "string.quoted", "settings": { "foreground": "#E42E30" } },
        {
            "scope": "keyword.function.arcade",
            "settings": { "foreground": "#839B0C", "fontStyle": "bold" }
        },
        {
            "scope": "keyword.control.arcade",
            "settings": { "foreground": "#6C71C4", "fontStyle": "bold" }
        },
        {
            "scope": "keyword.null.boolean.arcade",
            "settings": { "foreground": "#BF4900", "fontStyle": "bold" }
        },
        {
            "scope": ["variable.language.arcade", "keyword.constant.arcade"],
            "settings": { "foreground": "#598E4C" }
        },
        {
            "scope": "invalid.deprecated.arcade",
            "settings": { "foreground": "#FF3333" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
