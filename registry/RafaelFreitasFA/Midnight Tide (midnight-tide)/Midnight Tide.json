    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#5b6078", "fontStyle": "italic" }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.new",
                "keyword.operator.expression",
                "keyword.operator.logical",
                "storage.modifier",
                "storage.type.class",
                "storage.type.function",
                "storage.type.interface",
                "storage.type.enum",
                "storage.type.type"
            ],
            "settings": { "foreground": "#c6a0f6" }
        },
        {
            "name": "Storage types (var, let, const)",
            "scope": ["storage.type"],
            "settings": { "foreground": "#c6a0f6" }
        },
        {
            "name": "Storage modifiers",
            "scope": [
                "storage.modifier",
                "storage.modifier.readonly",
                "keyword.control.readonly"
            ],
            "settings": { "foreground": "#91d7e3" }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "meta.function-call entity.name.function",
                "support.function",
                "meta.function-call.generic"
            ],
            "settings": { "foreground": "#8aadf4" }
        },
        {
            "name": "Entity Name Type",
            "scope": ["entity.name.type"],
            "settings": { "foreground": "#7fbbb3" }
        },
        {
            "name": "Classes and Types",
            "scope": [
                "entity.name.class",
                "entity.name.type",
                "entity.name.interface",
                "entity.name.enum",
                "support.class",
                "support.type",
                "meta.type.annotation entity.name.type",
                "meta.type.parameters entity.name.type"
            ],
            "settings": { "foreground": "#8bd5ca" }
        },
        {
            "name": "Built-in types",
            "scope": [
                "support.type.primitive",
                "support.type.builtin",
                "keyword.type"
            ],
            "settings": { "foreground": "#8bd5ca" }
        },
        {
            "name": "Strings",
            "scope": [
                "string",
                "string.quoted",
                "string.template",
                "punctuation.definition.string"
            ],
            "settings": { "foreground": "#a6da95" }
        },
        {
            "name": "Numbers",
            "scope": ["constant.numeric", "constant.language.boolean"],
            "settings": { "foreground": "#f5a97f" }
        },
        {
            "name": "Constants",
            "scope": ["constant.language", "constant.character"],
            "settings": { "foreground": "#f5a97f" }
        },
        {
            "name": "Properties TSX",
            "scope": ["variable.other.property.tsx"],
            "settings": { "foreground": "#b8c0e0" }
        },
        {
            "name": "Properties",
            "scope": [
                "variable.other.property",
                "variable.object.property",
                "meta.object.member",
                "support.variable.property",
                "variable.other.object.property"
            ],
            "settings": { "foreground": "#b8c0e0" }
        },
        {
            "name": "Function parameters",
            "scope": [
                "variable.parameter",
                "meta.function.parameters variable.other",
                "meta.parameters variable.other"
            ],
            "settings": { "foreground": "#f9b38a" }
        },
        {
            "name": "Variables",
            "scope": [
                "variable",
                "variable.other",
                "variable.other.readwrite",
                "variable.other.local",
                "variable.other.block"
            ],
            "settings": { "foreground": "#cad3f5" }
        },
        {
            "name": "Operators",
            "scope": [
                "keyword.operator",
                "keyword.operator.assignment",
                "keyword.operator.comparison",
                "keyword.operator.arithmetic",
                "keyword.operator.type"
            ],
            "settings": { "foreground": "#91d7e3" }
        },
        {
            "name": "Decorators",
            "scope": [
                "entity.name.function.decorator",
                "meta.decorator",
                "punctuation.decorator"
            ],
            "settings": { "foreground": "#e8a0b8" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation",
                "meta.brace",
                "punctuation.definition.block",
                "punctuation.separator",
                "punctuation.terminator"
            ],
            "settings": { "foreground": "#6e738d" }
        },
        {
            "name": "Template literal expressions",
            "scope": [
                "punctuation.definition.template-expression",
                "punctuation.section.embedded"
            ],
            "settings": { "foreground": "#c6a0f6" }
        },
        {
            "name": "Namespace / module names",
            "scope": ["entity.name.namespace", "entity.name.module"],
            "settings": { "foreground": "#8bd5ca" }
        },
        {
            "name": "Tags (HTML/JSX)",
            "scope": ["entity.name.tag", "support.class.component"],
            "settings": { "foreground": "#8aadf4" }
        },
        {
            "name": "Tag attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#e0a3c8" }
        },
        {
            "name": "CSS property names",
            "scope": ["support.type.property-name.css", "entity.name.tag.css"],
            "settings": { "foreground": "#8aadf4" }
        },
        {
            "name": "CSS values",
            "scope": ["support.constant.property-value.css"],
            "settings": { "foreground": "#a6da95" }
        },
        {
            "name": "Invalid / deprecated",
            "scope": ["invalid", "invalid.deprecated"],
            "settings": {
                "foreground": "#ed8796",
                "fontStyle": "strikethrough"
            }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
