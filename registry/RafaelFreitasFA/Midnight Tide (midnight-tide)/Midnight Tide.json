        "gitDecoration.ignoredResourceForeground": "#494d64",
        "gitDecoration.conflictingResourceForeground": "#eed49f",
        "diffEditor.insertedTextBackground": "#a6da9520",
        "diffEditor.removedTextBackground": "#ed879620",
