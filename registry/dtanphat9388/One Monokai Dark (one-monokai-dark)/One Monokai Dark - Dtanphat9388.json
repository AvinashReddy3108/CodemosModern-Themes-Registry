{
    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "string.comment"],
            "settings": { "foreground": "#676f7d", "fontStyle": "italic" }
        },
        {
            "name": "--c7c7c7",
            "scope": [
                "meta.template.expression",
                "meta.array.literal.js",
                "meta.brace.round.js",
                "meta.objectliteral",
                "variable.other.readwrite",
                "support.type.property-name.json",
                "punctuation.definition.tag.begin.html",
                "punctuation.definition.tag.end.html",
                "support.type.property-name.css",
                "punctuation.section.property-list.begin.bracket.curly.css",
                "punctuation.section.property-list.end.bracket.curly.css",
                "punctuation.separator.key-value.css",
                "punctuation.terminator.rule.css"
            ],
            "settings": { "foreground": "#c7c7c7" }
        },
        {
            "name": "--c7c7c7 italic",
            "scope": ["storage.type.function.arrow"],
            "settings": { "fontStyle": "italic", "foreground": "#c7c7c7" }
        },
        {
            "name": "--11b9ac",
            "scope": [
                "constant.numeric",
                "constant.language.boolean",
                "constant.character",
                "constant.other",
                "storage",
                "entity.name.tag.class",
                "entity.name.tag.id",
                "support.constant",
                "variable.css",
                "variable.scss",
                "variable.less",
                "variable.sass",
                "function.css",
                "function.scss",
                "function.less",
                "function.sass",
                "entity.other.attribute-name.js",
                "entity.other.attribute-name.jsx",
                "entity.other.attribute-name.ts",
                "entity.other.attribute-name.html",
                "punctuation.separator.key-value.html",
                "punctuation.definition.string.begin.html",
                "punctuation.definition.string.end.html",
                "structure.dictionary.property-name.json",
                "support.type.object.module",
                "markup.heading.markdown",
                "meta.separator.markdown"
            ],
            "settings": { "foreground": "#11b9ac" }
        },
        {
            "name": "--11b9ac bold",
            "scope": ["constant.other.character-class.regexp"],
            "settings": { "fontStyle": "bold", "foreground": "#11b9ac" }
        },
        {
            "name": "--e06c75",
            "scope": [
                "keyword",
                "variable.language",
                "constant.language",
                "entity.name.tag",
                "entity.name.tag.class.js",
                "entity.name.tag.class.jsx",
                "support.class.component.js",
                "punctuation.definition.template-expression.begin.js",
                "punctuation.definition.template-expression.end.js",
                "punctuation.definition.template-expression.begin.ts",
                "punctuation.definition.template-expression.end.ts",
                "markup.fenced_code.block.markdown",
                "markup.inline.raw.string.markdown",
                "punctuation.definition.list.begin.markdown",
                "punctuation.separator.key-value",
                "keyword.control.anchor.regexp"
            ],
            "settings": { "foreground": "#e06c75" }
        },
        {
            "name": "--EBD996",
            "scope": [
                "string.quoted.double.js",
                "string.quoted.single.js",
                "string.template.js",
                "meta.object-literal.key",
                "entity.name.tag.css",
                "meta.selector.css",
                "constant.other.character-class.range.regexp",
                "string.quoted.double.ts",
                "string.quoted.single.ts",
                "string.template.ts",
                "variable.other.enummember.ts",
                "string.regexp",
                "meta.group.regexp",
                "constant.character.escape.backslash.regexp",
                "meta.attribute",
                "string.quoted.double.json",
                "string.quoted.double.dockerfile",
                "markup.quote.markdown"
            ],
            "settings": { "foreground": "#EBD996" }
        },
        {
            "name": "--62BAE4",
            "scope": [
                "keyword.control.conditional",
                "keyword.control.loop",
                "meta.function-call",
                "variable.readwrite",
                "variable.readwrite.other.block",
                "variable.language.super",
                "new.expr",
                "meta.attribute.event-handler.click.html",
                "markup.underline.link",
                "meta.type.annotation",
                "meta.return.type"
            ],
            "settings": { "foreground": "#5ab8e4" }
        },
        {
            "name": "--5ab8e4 bold",
            "scope": [
                "punctuation.definition.character-class.regexp",
                "punctuation.definition.group.regexp"
            ],
            "settings": { "fontStyle": "bold", "foreground": "#5ab8e4" }
        },
        {
            "name": "--e8a464 italic",
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#e8a464" }
        },
        {
            "name": "--ffffff bold",
            "scope": ["markup.bold.markdown", "storage.type.class.jsdoc"],
            "settings": { "fontStyle": "bold", "foreground": "#ffffff" }
        },
        {
            "name": "--ffffff italic",
            "scope": ["markup.italic.markdown"],
            "settings": { "fontStyle": "italic", "foreground": "#ffffff" }
        }
    ],
