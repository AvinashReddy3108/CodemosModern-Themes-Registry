        {
            "scope": [
                "comment",
                "punctuation.definition.comment",
                "string.quoted.docstring",
                "meta.setting.documentation.robotframework",
                "meta.testcase_setting.documentation.robotframework"
            ],
            "settings": { "foreground": "#536060" }
        },
        {
            "scope": "keyword.codetag.notation",
            "settings": { "foreground": "#ff7e50" }
        },
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "fontStyle": "italic" }
        },
        { "scope": "comment.block", "settings": { "fontStyle": "" } }
    ]
