    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#476639", "fontStyle": "italic" }
        },
        {
            "name": "Strings",
            "scope": ["string", "string.quoted", "meta.string"],
            "settings": { "foreground": "#de9876" }
        },
        {
            "name": "Template Strings",
            "scope": ["string.template", "string.template variable"],
            "settings": { "foreground": "#de9876" }
        },
        {
            "name": "String Punctuation",
            "scope": [
                "punctuation.definition.string.begin",
                "punctuation.definition.string.end"
            ],
            "settings": { "foreground": "#de987688" }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword.control",
                "keyword.operator",
                "keyword",
                "storage.type",
                "storage.modifier"
            ],
            "settings": { "foreground": "#c586c0" }
        },
        {
            "name": "Keywords Control Flow",
            "scope": ["keyword.controlpanel"],
            "settings": { "foreground": "#ff7b72" }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "support.function",
                "entity.name.method"
            ],
            "settings": { "foreground": "#dbd09e" }
        },
        {
            "name": "Function Calls",
            "scope": ["meta.function-call", "variable.function"],
            "settings": { "foreground": "#dbd09e" }
        },
        {
            "name": "Variable",
            "scope": ["variable", "variable.other", "meta.definition.variable"],
            "settings": { "foreground": "#9cdcfe" }
        },
        {
            "name": "Parameters",
            "scope": ["variable.parameter", "variable.parameter.function"],
            "settings": { "foreground": "#c9d1d9" }
        },
        {
            "name": "Constants",
            "scope": ["variable.other.constant", "variable.other.readwrite"],
            "settings": { "foreground": "#79c0ff" }
        },
        {
            "name": "Types & Classes",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.type",
                "support.class",
                "entity.name.type.class"
            ],
            "settings": { "foreground": "#00cfa5" }
        },
        {
            "name": "Numbers",
            "scope": ["constant.numeric", "constant.language"],
            "settings": { "foreground": "#b5cea8" }
        },
        {
            "name": "Booleans & Null",
            "scope": ["constant.language.boolean", "constant.language.null"],
            "settings": { "foreground": "#569cd6" }
        },
        {
            "name": "Operators",
            "scope": ["keyword.operator", "punctuation.accessor"],
            "settings": { "foreground": "#d4d4d4" }
        },
        {
            "name": "Punctuation",
            "scope": ["punctuation", "meta.brace", "meta.delimiter"],
            "settings": { "foreground": "#8b949e" }
        },
        {
            "name": "HTML/XML Tags",
            "scope": ["entity.name.tag", "meta.tag"],
            "settings": { "foreground": "#bababa" }
        },
        {
            "name": "HTML/XML Brackets",
            "scope": ["punctuation.definition.tag"],
            "settings": { "foreground": "#757575" }
        },
        {
            "name": "HTML/XML Titles",
            "scope": ["entity.name.tag.html", "entity.name.tag.xml"],
            "settings": { "foreground": "#569cd6" }
        },
        {
            "name": "HTML/XML Attributes",
            "scope": ["entity.other.attribute-name", "meta.attribute"],
            "settings": { "foreground": "#bedaeb" }
        },
        {
            "name": "NOT Other Attributes",
            "scope": [
                "entity.not.other.attribute-name",
                "meta.not.other.attribute"
            ],
            "settings": { "foreground": "#d2a8ff" }
        },
        {
            "name": "CSS Selectors",
            "scope": [
                "entity.other.attribute-name.class",
                "entity.other.attribute-name.id"
            ],
            "settings": { "foreground": "#ffa657" }
        },
        {
            "name": "CSS Properties",
            "scope": [
                "support.type.property-name.css",
                "support.type.property-name"
            ],
            "settings": { "foreground": "#79c0ff" }
        },
        {
            "name": "CSS Values",
            "scope": ["support.constant.property-value"],
            "settings": { "foreground": "#a5d6ff" }
        },
        {
            "name": "Markdown Headings",
            "scope": [
                "markup.heading",
                "markup.heading punctuation.definition.heading"
            ],
            "settings": { "foreground": "#58a6ff", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Bold",
            "scope": ["markup.bold"],
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Markdown Italic",
            "scope": ["markup.italic"],
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "Markdown Code",
            "scope": ["markup.inline.raw", "markup.raw"],
            "settings": { "foreground": "#d18762" }
        },
        {
            "name": "JSON Keys",
            "scope": [
                "support.type.property-name.json",
                "string.quoted.key.json"
            ],
            "settings": { "foreground": "#79c0ff" }
        },
        {
            "name": "Regex",
            "scope": ["string.regexp"],
            "settings": { "foreground": "#a5d6ff" }
        },
        {
            "name": "Escape Characters",
            "scope": ["constant.character.escape"],
            "settings": { "foreground": "#ff7b72" }
        },
        {
            "name": "Diff Inserted",
            "scope": ["markup.inserted"],
            "settings": { "foreground": "#3fb950" }
        },
        {
            "name": "Diff Deleted",
            "scope": ["markup.deleted"],
            "settings": { "foreground": "#F14C4C" }
        },
        {
            "name": "Diff Changed",
            "scope": ["markup.changed"],
            "settings": { "foreground": "#d29922" }
        },
        {
            "name": "Invalid / Deprecated",
            "scope": ["invalid", "invalid.deprecated"],
            "settings": {
                "foreground": "#F14C4C",
                "fontStyle": "strikethrough"
            }
        },
        {
            "name": "Links",
            "scope": ["markup.underline.link", "string.other.link"],
            "settings": { "foreground": "#58a6ff", "fontStyle": "underline" }
        },
        {
            "name": "Default Text",
            "scope": ["source", "text"],
            "settings": { "foreground": "#f4f4f4" }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "namespace": "#ffa657",
        "type": "#ffa657",
        "class": "#ffa657",
        "enum": "#ffa657",
        "interface": "#ffa657",
        "struct": "#ffa657",
        "typeParameter": "#ffa657",
        "function": "#dbd09e",
        "method": "#dbd09e",
        "property": "#79c0ff",
        "variable": "#9cdcfe",
        "parameter": "#58a6ff",
        "enumMember": "#79c0ff",
        "macro": "#ff7b72",
        "keyword": "#ff7b72",
        "modifier": "#ff7b72",
        "operator": "#ff7b72",
        "comment": "#476639",
        "string": "#d18762",
        "number": "#a5d6ff",
        "regexp": "#a5d6ff",
        "decorator": "#d2a8ff",
        "label": "#c9d1d9"
    },
    "$schema": "vscode://schemas/color-theme"
}
