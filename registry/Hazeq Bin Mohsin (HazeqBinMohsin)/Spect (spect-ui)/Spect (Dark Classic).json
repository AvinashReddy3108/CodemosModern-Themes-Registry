    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#476639", "fontStyle": "italic" }
        },
        {
            "name": "Strings",
            "scope": ["string", "string.quoted", "meta.string"],
            "settings": { "foreground": "#fc9867" }
        },
        {
            "name": "Template Strings",
            "scope": ["string.template", "string.template variable"],
            "settings": { "foreground": "#de9876" }
        },
        {
            "name": "String Punctuation",
            "scope": [
                "punctuation.definition.string.begin",
                "punctuation.definition.string.end"
            ],
            "settings": { "foreground": "#fc986788" }
        },
        {
            "name": "Regular Expressions & Escape Characters",
            "scope": ["string.regexp", "constant.character.escape"],
            "settings": { "foreground": "#a5d6ff" }
        },
        {
            "name": "Symbol Constants",
            "scope": ["constant.other.symbol"],
            "settings": { "foreground": "#de9876" }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword.control",
                "keyword",
                "storage.type",
                "storage.modifier",
                "storage"
            ],
            "settings": { "foreground": "#da95f0" }
        },
        {
            "name": "Keywords Control Flow",
            "scope": ["keyword.controlpanel"],
            "settings": { "foreground": "#ff7b72" }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "support.function",
                "entity.name.method"
            ],
            "settings": { "foreground": "#dbd09e" }
        },
        {
            "name": "Function Calls",
            "scope": [
                "meta.function-call",
                "variable.function",
                "meta.function-call.generic"
            ],
            "settings": { "foreground": "#dbd09e" }
        },
        {
            "name": "Function Arguments",
            "scope": ["variable.parameter", "meta.parameter"],
            "settings": { "foreground": "#c9d1d9" }
        },
        {
            "name": "Library Functions",
            "scope": ["support.function", "support.macro"],
            "settings": { "foreground": "#dbd09e" }
        },
        {
            "name": "Variable",
            "scope": ["variable", "variable.other", "meta.definition.variable"],
            "settings": { "foreground": "#b3e4ff" }
        },
        {
            "name": "Member Variable",
            "scope": ["variable.member"],
            "settings": { "foreground": "#b3e4ff" }
        },
        {
            "name": "Language Variable (this, self, super)",
            "scope": ["variable.language"],
            "settings": { "fontStyle": "italic", "foreground": "#79c0ff" }
        },
        {
            "name": "Parameters",
            "scope": ["variable.parameter.function"],
            "settings": { "foreground": "#c9d1d9" }
        },
        {
            "name": "Constants",
            "scope": ["variable.other.constant", "variable.other.readwrite"],
            "settings": { "foreground": "#79c0ff" }
        },
        {
            "name": "Types & Classes",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.type",
                "support.class",
                "entity.name.type.class"
            ],
            "settings": { "foreground": "#00cfa5" }
        },
        {
            "name": "Inherited Classes",
            "scope": ["entity.other.inherited-class"],
            "settings": { "fontStyle": "italic", "foreground": "#00cfa5" }
        },
        {
            "name": "Library Types",
            "scope": ["support.type", "support.class"],
            "settings": { "foreground": "#00cfa5" }
        },
        {
            "name": "Numbers",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#b5cea8" }
        },
        {
            "name": "Built-in Constants",
            "scope": ["constant.language"],
            "settings": { "foreground": "#b5cea8" }
        },
        {
            "name": "Booleans & Null",
            "scope": ["constant.language.boolean", "constant.language.null"],
            "settings": { "foreground": "#569cd6" }
        },
        {
            "name": "Operators",
            "scope": ["keyword.operator", "punctuation.accessor"],
            "settings": { "foreground": "#d4d4d4" }
        },
        {
            "name": "Separators (; , .)",
            "scope": ["punctuation.separator", "punctuation.terminator"],
            "settings": { "foreground": "#8b949e" }
        },
        {
            "name": "Punctuation Sections",
            "scope": ["punctuation.section"],
            "settings": { "foreground": "#8b949e" }
        },
        {
            "name": "Punctuation",
            "scope": ["punctuation", "meta.brace", "meta.delimiter"],
            "settings": { "foreground": "#8b949e" }
        },
        {
            "name": "Template Expression Punctuation",
            "scope": ["punctuation.definition.template-expression"],
            "settings": { "foreground": "#c586c0" }
        },
        {
            "name": "Embedded Punctuation (Ruby interpolation)",
            "scope": ["punctuation.section.embedded"],
            "settings": { "foreground": "#c586c0" }
        },
        {
            "name": "Embedded Text",
            "scope": ["meta.embedded"],
            "settings": { "foreground": "#f4f4f4" }
        },
        {
            "name": "HTML/XML Tags",
            "scope": ["entity.name.tag", "meta.tag.sgml"],
            "settings": { "foreground": "#58a6ff" }
        },
        {
            "name": "HTML/XML Brackets",
            "scope": [
                "punctuation.definition.tag.begin",
                "punctuation.definition.tag.end",
                "punctuation.definition.tag"
            ],
            "settings": { "foreground": "#75757588" }
        },
        {
            "name": "HTML/XML Titles",
            "scope": ["entity.name.tag.html", "entity.name.tag.xml"],
            "settings": { "foreground": "#569cd6" }
        },
        {
            "name": "HTML/XML Attributes",
            "scope": ["entity.other.attribute-name", "meta.attribute"],
            "settings": { "foreground": "#bedaeb" }
        },
        {
            "name": "JSX Component",
            "scope": ["support.class.component"],
            "settings": { "foreground": "#00cfa5" }
        },
        {
            "name": "Decorators & Annotations",
            "scope": [
                "meta.decorator variable.other",
                "meta.decorator punctuation.decorator",
                "storage.type.annotation",
                "entity.name.function.decorator"
            ],
            "settings": { "foreground": "#d2a8ff" }
        },
        {
            "name": "Imports & Packages",
            "scope": ["entity.name.import", "entity.name.package"],
            "settings": { "foreground": "#9cdcfe" }
        },
        {
            "name": "CSS Selectors",
            "scope": [
                "entity.other.attribute-name.class",
                "entity.other.attribute-name.id"
            ],
            "settings": { "foreground": "#ffa657" }
        },
        {
            "name": "CSS Pseudo-classes",
            "scope": ["entity.other.attribute-name.pseudo-class"],
            "settings": { "foreground": "#79c0ff" }
        },
        {
            "name": "CSS Tag Names",
            "scope": [
                "source.css entity.name.tag",
                "source.scss entity.name.tag",
                "source.sass entity.name.tag",
                "source.less entity.name.tag"
            ],
            "settings": { "foreground": "#bababa" }
        },
        {
            "name": "CSS Properties",
            "scope": [
                "support.type.property-name.css",
                "support.type.property-name"
            ],
            "settings": { "foreground": "#79c0ff" }
        },
        {
            "name": "CSS Values",
            "scope": ["support.constant.property-value"],
            "settings": { "foreground": "#a5d6ff" }
        },
        {
            "name": "CSS Vendor Prefix",
            "scope": [
                "source.css support.type",
                "source.scss support.type",
                "source.sass support.type",
                "source.less support.type"
            ],
            "settings": { "foreground": "#8b949e" }
        },
        {
            "name": "Markdown Headings",
            "scope": [
                "markup.heading",
                "markup.heading punctuation.definition.heading",
                "markup.heading entity.name"
            ],
            "settings": { "foreground": "#58a6ff", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Bold",
            "scope": ["markup.bold"],
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Markdown Italic",
            "scope": ["markup.italic", "emphasis"],
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "Markdown Bold+Italic",
            "scope": ["markup.italic markup.bold", "markup.bold markup.italic"],
            "settings": { "fontStyle": "bold italic" }
        },
        {
            "name": "Markdown Underline",
            "scope": ["markup.underline"],
            "settings": { "fontStyle": "underline" }
        },
        {
            "name": "Markdown Code",
            "scope": ["markup.inline.raw", "markup.raw"],
            "settings": { "foreground": "#d18762" }
        },
        {
            "name": "Markdown Code Block",
            "scope": ["markup.raw.block"],
            "settings": { "foreground": "#d18762" }
        },
        {
            "name": "Markdown Blockquote",
            "scope": ["markup.quote"],
            "settings": { "fontStyle": "italic", "foreground": "#8b949e" }
        },
        {
            "name": "Markdown Separator",
            "scope": ["meta.separator"],
            "settings": { "fontStyle": "bold", "foreground": "#8b949e" }
        },
        {
            "name": "Markdown List Bullet",
            "scope": ["markup.list punctuation.definition.list.begin"],
            "settings": { "foreground": "#58a6ff" }
        },
        {
            "name": "Markdown Strike",
            "scope": ["markup.strike"],
            "settings": { "foreground": "#8b949e" }
        },
        {
            "name": "Markdown Table",
            "scope": ["markup.table"],
            "settings": { "foreground": "#79c0ff" }
        },
        {
            "name": "Markdown Strong",
            "scope": ["markup.strong"],
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "JSON Keys",
            "scope": [
                "support.type.property-name.json",
                "string.quoted.key.json"
            ],
            "settings": { "foreground": "#79c0ff" }
        },
        {
            "name": "Diff Header",
            "scope": ["meta.diff", "meta.diff.header"],
            "settings": { "foreground": "#8b949e" }
        },
        {
            "name": "Diff Inserted",
            "scope": ["markup.inserted"],
            "settings": { "foreground": "#b8d663" }
        },
        {
            "name": "Diff Deleted",
            "scope": ["markup.deleted"],
            "settings": { "foreground": "#F14C4C" }
        },
        {
            "name": "Diff Changed",
            "scope": ["markup.changed"],
            "settings": { "foreground": "#d29922" }
        },
        {
            "name": "Invalid / Deprecated",
            "scope": ["invalid", "invalid.deprecated"],
            "settings": {
                "foreground": "#F14C4C",
                "fontStyle": "strikethrough"
            }
        },
        {
            "name": "Search Results Line Numbers",
            "scope": ["constant.numeric.line-number.find-in-files"],
            "settings": { "foreground": "#484f58" }
        },
        {
            "name": "Search Results Matched Line",
            "scope": ["constant.numeric.line-number.match"],
            "settings": { "foreground": "#d29922" }
        },
        {
            "name": "Search Results File Names",
            "scope": ["entity.name.filename.find-in-files"],
            "settings": { "foreground": "#9cdcfe" }
        },
        {
            "name": "Error Messages",
            "scope": ["message.error"],
            "settings": { "foreground": "#F14C4C" }
        },
        {
            "name": "Links",
            "scope": ["markup.underline.link", "string.other.link"],
            "settings": { "foreground": "#58a6ff", "fontStyle": "underline" }
        },
        {
            "name": "Default Text",
            "scope": ["source", "text"],
            "settings": { "foreground": "#f4f4f4" }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "namespace": "#ffa657",
        "type": "#ffa657",
        "class": "#ffa657",
        "class.defaultLibrary": "#00cfa5",
        "enum": "#ffa657",
        "enum.defaultLibrary": "#00cfa5",
        "interface": "#ffa657",
        "struct": "#ffa657",
        "typeParameter": "#ffa657",
        "function": "#dbd09e",
        "method": "#dbd09e",
        "property": "#79c0ff",
        "variable": "#9cdcfe",
        "parameter": "#c9d1d9",
        "enumMember": "#79c0ff",
        "macro": "#ff7b72",
        "keyword": "#ff7b72",
        "modifier": "#ff7b72",
        "operator": "#d4d4d4",
        "comment": "#476639",
        "string": "#d18762",
        "number": "#a5d6ff",
        "regexp": "#a5d6ff",
        "decorator": "#d2a8ff",
        "label": "#c9d1d9"
    },
    "$schema": "vscode://schemas/color-theme"
}
