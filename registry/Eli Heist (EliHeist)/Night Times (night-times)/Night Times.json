        "inputOption.activeForeground": "#ffffff",
        "input.placeholderForeground": "#a6a6a6",
        "textLink.foreground": "#ff0048",
        "tab.inactiveBackground": "#191b24",
        "tab.border": "#ccc1",
        "editorGroupHeader.tabsBackground": "#181921",
        "scrollbarSlider.background": "#ccf1",
        "scrollbarSlider.hoverBackground": "#ccf5",
        "scrollbarSlider.activeBackground": "#ccf2",
        "notificationToast.border": "#ccc1",
        "notifications.background": "#20232e",
        "notificationCenterHeader.background": "#181921",
        "notificationCenter.border": "#ccc1",
        "notificationCenterHeader.foreground": "#ff0048"
