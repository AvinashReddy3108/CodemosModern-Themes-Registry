        "activityBar.inactiveForeground": "#cccccc70",
        "activityBarBadge.foreground": "#ffffff",
        "activityBar.border": "#181921",
        "activityBar.activeBackground": "#181921",
        "activityBar.activeBorder": "#ff1649",
        "sideBar.background": "#181921",
        "sideBar.foreground": "#ccc",
        "sideBar.border": "#181921",
        "sideBarSectionHeader.background": "#181921",
        "sideBarSectionHeader.foreground": "#fff",
        "sideBarTitle.foreground": "#ff2353",
        "sideBarSectionHeader.border": "#181921",
        "list.inactiveSelectionForeground": "#ccc",
        "list.hoverForeground": "#ccc",
        "list.activeSelectionBackground": "#282936",
        "list.activeSelectionForeground": "#ffffff",
        "list.dropBackground": "#0d0008",
        "list.highlightForeground": "#d4003c",
        "list.focusBackground": "#181921",
        "list.focusForeground": "#ffffff",
        "listFilterWidget.background": "#181921",
        "listFilterWidget.outline": "#ccc1",
        "listFilterWidget.noMatchesOutline": "#d4003c",
        "list.errorForeground": "#ff2b2b",
        "list.hoverBackground": "#ccc1",
        "list.warningForeground": "#fd951e",
        "list.focusOutline": "#2f3140",
        "statusBar.foreground": "#ccc",
        "statusBar.background": "#181921",
        "statusBarItem.hoverBackground": "#ffffff1f",
        "statusBar.debuggingBackground": "#1f2233",
        "statusBar.debuggingForeground": "#ffffff",
        "statusBar.noFolderBackground": "#181921",
        "statusBar.noFolderForeground": "#d4003c",
        "statusBarItem.remoteBackground": "#16825d",
        "statusBarItem.remoteForeground": "#ffffff",
        "statusBar.border": "#181921",
        "statusBar.debuggingBorder": "#ff1649",
        "statusBar.noFolderBorder": "#0000",
        "statusBarItem.errorBackground": "#ff1919",
        "titleBar.activeBackground": "#181921",
        "titleBar.activeForeground": "#cccccc",
        "titleBar.inactiveBackground": "#1f1f1f",
        "titleBar.inactiveForeground": "#ccc8",
        "menubar.selectionForeground": "#fff",
        "menubar.selectionBackground": "#d4003c",
        "menu.foreground": "#cccccc",
        "menu.background": "#181921",
        "menu.selectionForeground": "#ffffff",
        "menu.selectionBackground": "#d4003c",
        "menu.separatorBackground": "#ccc5",
        "menu.border": "#181921",
        "button.background": "#ff2353",
        "button.foreground": "#ffffff",
        "button.hoverBackground": "#ff0048",
        "button.secondaryForeground": "#ffffff",
        "button.secondaryBackground": "#913252",
        "button.secondaryHoverBackground": "#ff0048",
        "input.background": "#181921",
        "input.border": "#ccc2",
        "input.foreground": "#cccccc",
        "inputOption.activeBackground": "#ff0048",
