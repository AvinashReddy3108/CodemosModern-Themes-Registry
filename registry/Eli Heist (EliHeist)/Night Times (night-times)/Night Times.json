        "peekViewResult.matchHighlightBackground": "#ff164990",
        "peekViewResult.selectionBackground": "#189cbd50",
        "peekViewTitle.background": "#2b2b2b",
        "peekViewTitleDescription.foreground": "#ffafc0",
        "peekViewTitleLabel.foreground": "#ffffff",
        "activityBarBadge.background": "#ff2353",
        "activityBar.background": "#181921",
