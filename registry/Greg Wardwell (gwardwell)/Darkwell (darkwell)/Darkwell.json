            "settings": { "foreground": "#A9B7C6" }
        },
        {
            "scope": ["variable.import.parameter.js"],
            "settings": { "foreground": "#A9B7C6" }
        },
        {
            "scope": ["variable.other.class.js"],
            "settings": { "foreground": "#A9B7C6", "fontStyle": "bold" }
        },
        {
            "scope": ["variable.language"],
            "settings": { "foreground": "#CC7832", "fontStyle": "bold" }
        },
        {
            "scope": ["variable.function.constructor"],
            "settings": { "foreground": "#82AAFF" }
        },
        {
            "scope": [
                "punctuation",
                "punctuation.definition.tag",
                "punctuation.separator.inheritance.php",
