            "settings": { "foreground": "#CC7832", "fontStyle": "bold" }
        },
        {
            "scope": ["constant.character", "constant.escape"],
            "settings": { "foreground": "#A9B7C6" }
        },
        {
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#6987BB" }
        },
        {
            "scope": [
                "constant.other.symbol",
                "constant.other.key",
