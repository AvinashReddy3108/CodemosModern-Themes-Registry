{
    "name": "Relieve",
    "colors": {
        "activityBar.activeBorder": "#E5C07B",
        "activityBar.background": "#24292e",
        "activityBar.foreground": "#D1D5DC",
        "debugToolBar.background": "#1286e4",
        "breadcrumb.focusForeground": "#e1e4e8",
        "breadcrumb.foreground": "#959da5",
        "editor.background": "#24292e",
        "editor.foreground": "#eeffff",
        "editor.lineHighlightBackground": "#2b3036",
        "editor.selectionBackground": "#3392ff44",
        "editorBracketHighlight.foreground1": "#E5C07B",
        "editorBracketHighlight.foreground2": "#ffab70",
        "editorBracketHighlight.foreground3": "#b392f0",
        "editorBracketHighlight.foreground4": "#79b8ff",
        "editorBracketHighlight.foreground5": "#ffab70",
        "editorBracketHighlight.foreground6": "#b392f0",
        "editorCursor.foreground": "#c8e1ff",
        "editorGroupHeader.tabsBackground": "#1f2428",
        "editorGroupHeader.tabsBorder": "#1b1f23",
        "editorLineNumber.foreground": "#444d56",
        "editorOverviewRuler.border": "#1b1f23",
        "editorWidget.background": "#1f2428",
        "list.hoverBackground": "#282e34",
        "list.hoverForeground": "#e1e4e8",
        "list.inactiveSelectionBackground": "#282e34",
        "list.inactiveSelectionForeground": "#e1e4e8",
        "menu.background": "#1f2428",
        "minimapGutter.addedBackground": "#109868",
        "minimapGutter.deletedBackground": "#9a353d",
        "minimapGutter.modifiedBackground": "#948b60",
        "scrollbar.shadow": "#00000088",
        "scrollbarSlider.activeBackground": "#6a737d88",
        "scrollbarSlider.background": "#6a737d33",
        "scrollbarSlider.hoverBackground": "#6a737d44",
        "sideBar.background": "#1f2428",
        "sideBarTitle.foreground": "#bbbbbb",
        "sideBarSectionHeader.background": "#1f2428",
        "sideBarStickyScroll.shadow": "#1f2428",
        "statusBar.background": "#24292e",
        "statusBar.foreground": "#9da5b4",
        "titleBar.activeBackground": "#24292e",
        "titleBar.activeForeground": "#9da5b4",
        "tab.activeForeground": "#D1D5DC",
        "tab.activeBorderTop": "#e5c07b",
        "tab.inactiveForeground": "#9da5b4",
        "tab.inactiveBackground": "#1f2428",
        "tab.hoverBackground": "#24292e"
    },
    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#E5C07B" }
        },
        {
            "name": "Meta",
            "scope": ["support.type.property-name"],
            "settings": { "foreground": "#98C379" }
        },
        {
            "name": "String, Regular Expressions and Symbols",
            "scope": ["string", "string.regexp", "constant.other.symbol"],
            "settings": { "foreground": "#98C379" }
        },
        {
            "name": "Escape Characters",
            "scope": "constant.character.escape",
            "settings": { "foreground": "#777777" }
        },
        {
            "name": "Constants",
            "scope": [
                "constant.numeric",
                "constant.character",
                "constant.keyword",
                "constant"
            ],
            "settings": { "foreground": "#E5A4CB" }
        },
        {
            "name": "Keywords",
            "scope": [
                "entity.name",
                "entity.name.function",
                "support.function.any-method",
                "entity.name.function.ts",
                "variable.function",
                "support.function.console",
                "keyword.other.special-method",
                "storage.type.string",
                "storage.type.error"
            ],
            "settings": { "foreground": "#79B8FF" }
        },
        {
            "name": "Import",
            "scope": ["variable.other.readwrite.alias"],
            "settings": { "foreground": "#9fc490" }
        },
        {
            "name": "Variable names",
            "scope": [
                "variable.other.constant",
                "meta.definition.variable",
                "variable.other.readwrite"
            ],
            "settings": { "foreground": "#A2CBFA" }
        },
        {
            "name": "Punctuation",
            "scope": "punctuation",
            "settings": { "foreground": "#8A97A1" }
        },
        { "scope": ["invalid"], "settings": { "foreground": "#CC3333" } },
        {
            "scope": ["meta.diff.range", "meta.diff.index", "meta.separator"],
            "settings": { "foreground": "#BBBBBB" }
        },
        {
            "scope": "meta.diff.header.from-file",
            "settings": { "foreground": "#BBBBBB" }
        },
        {
            "scope": "meta.diff.header.to-file",
            "settings": { "foreground": "#BBBBBB" }
        },
        {
            "scope": "token.info-token",
            "settings": { "foreground": "#6796E6" }
        },
        {
            "scope": "token.warn-token",
            "settings": { "foreground": "#CD9731" }
        },
        {
            "scope": "token.error-token",
            "settings": { "foreground": "#F44747" }
        },
        {
            "scope": "token.debug-token",
            "settings": { "foreground": "#B267E6" }
        },
        {
            "name": "CSS Property",
            "scope": [
                "meta.property-name.css",
                "support.type.property-name.css"
            ],
            "settings": { "foreground": "#A2CBFA" }
        },
        {
            "name": "JSON Key - Level 0",
            "scope": [
                "source.json meta.structure.dictionary.json support.type.property-name.json"
            ],
            "settings": { "foreground": "#79B8FF" }
        },
        {
            "name": "JSON Key - Value",
            "scope": [
                "meta.structure.dictionary.value.json string.quoted.double.json"
            ],
            "settings": { "foreground": "#98C379" }
        },
        {
            "name": "JSON Key - Level 1",
            "scope": [
                "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
            ],
            "settings": { "foreground": "#A2CBFA" }
        },
        {
            "name": "Markup - Italic",
            "scope": ["markup.italic"],
            "settings": { "fontStyle": "italic", "foreground": "#A2CBFA" }
        },
        {
            "name": "Markup - Bold",
            "scope": ["markup.bold", "markup.bold string"],
            "settings": { "fontStyle": "bold", "foreground": "#A2CBFA" }
        },
        {
            "name": "Markup - Quote",
            "scope": ["markup.quote"],
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "CSS Class name",
            "scope": ["entity.other.attribute-name.class.css"],
            "settings": { "foreground": "#98C379" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
