    "tokenColors": [
        {
            "name": "Comments",
            "scope": [
                "comment",
                "comment.line",
                "comment.block",
                "punctuation.definition.comment"
            ],
            "settings": { "foreground": "#6272A4", "fontStyle": "italic" }
        },
        {
            "name": "Documentation Comments (JSDoc, docstrings)",
            "scope": [
                "comment.block.documentation",
                "string.quoted.docstring",
                "string.quoted.docstring.multi",
                "string.quoted.docstring.multi.python"
            ],
            "settings": { "foreground": "#6272A4", "fontStyle": "italic" }
        },
        {
            "name": "Keywords (control flow, declarations)",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.control.conditional",
                "keyword.control.loop",
                "keyword.control.flow",
                "keyword.control.trycatch",
                "keyword.control.import",
                "keyword.control.from",
                "keyword.control.export",
                "keyword.control.return",
                "keyword.control.as",
                "keyword.other",
                "storage.modifier"
            ],
            "settings": { "foreground": "#FF79C6" }
        },
        {
            "name": "Storage Types (var, let, const, function, class)",
            "scope": [
                "storage.type",
                "storage.type.js",
                "storage.type.ts",
                "storage.type.function",
                "storage.type.class",
                "storage.type.function.python",
                "storage.type.class.python",
                "storage.type.function.lambda.python",
                "keyword.control.as",
                "keyword.operator.expression.typeof",
                "keyword.operator.expression.instanceof",
                "keyword.operator.expression.of",
                "keyword.operator.expression.in",
                "keyword.operator.expression.void",
                "keyword.operator.expression.delete",
                "keyword.operator.new"
            ],
            "settings": { "foreground": "#FF79C6" }
        },
        {
            "name": "Python Keywords (def, class, lambda, etc.)",
            "scope": [
                "keyword.control.import.python",
                "keyword.control.flow.python",
                "keyword.operator.logical.python",
                "keyword.operator.unpacking.python"
            ],
            "settings": { "foreground": "#FF79C6" }
        },
        {
            "name": "Functions & Methods (declarations and calls)",
            "scope": [
                "entity.name.function",
                "entity.name.function.member",
                "meta.function-call",
                "meta.method-call",
                "support.function",
                "support.function.builtin",
                "entity.name.function.python",
                "meta.function-call.generic.python",
                "meta.function-call.python",
                "support.function.magic.python"
            ],
            "settings": { "foreground": "#50FA7B" }
        },
        {
            "name": "Function Parameters",
            "scope": [
                "variable.parameter",
                "variable.parameter.function",
                "meta.function.parameters",
                "variable.parameter.function.python"
            ],
            "settings": { "foreground": "#FFB86C", "fontStyle": "italic" }
        },
        {
            "name": "Variables",
            "scope": [
                "variable",
                "variable.other",
                "variable.other.readwrite",
                "variable.other.assignment",
                "meta.object-literal.key"
            ],
            "settings": { "foreground": "#F8F8F2" }
        },
        {
            "name": "Variable Properties (object.property)",
            "scope": [
                "variable.other.property",
                "variable.other.object.property",
                "support.variable.property",
                "meta.object.member"
            ],
            "settings": { "foreground": "#F8F8F2" }
        },
        {
            "name": "Language Variables (this, self, super)",
            "scope": [
                "variable.language",
                "variable.language.this",
                "variable.language.self",
                "variable.language.super",
                "variable.language.special.self.python"
            ],
            "settings": { "foreground": "#BD93F9", "fontStyle": "italic" }
        },
        {
            "name": "Strings",
            "scope": [
                "string",
                "string.quoted",
                "string.quoted.single",
                "string.quoted.double",
                "string.quoted.triple",
                "string.template",
                "string.quoted.single.python",
                "string.quoted.double.python",
                "string.quoted.single.js",
                "string.quoted.double.js"
            ],
            "settings": { "foreground": "#F1FA8C" }
        },
        {
            "name": "Template String Expressions",
            "scope": [
                "string.template.expression",
                "punctuation.definition.template-expression.begin",
                "punctuation.definition.template-expression.end",
                "meta.template.expression"
            ],
            "settings": { "foreground": "#FF79C6" }
        },
        {
            "name": "Escape Characters in Strings",
            "scope": [
                "constant.character.escape",
                "constant.character.escape.python"
            ],
            "settings": { "foreground": "#FF79C6" }
        },
        {
            "name": "Regular Expressions",
            "scope": [
                "string.regexp",
                "keyword.operator.quantifier.regexp",
                "keyword.control.anchor.regexp",
                "keyword.operator.or.regexp"
            ],
            "settings": { "foreground": "#FF5555" }
        },
        {
            "name": "Numbers (integer, float, hex, etc.)",
            "scope": [
                "constant.numeric",
                "constant.numeric.integer",
                "constant.numeric.float",
                "constant.numeric.hex",
                "constant.numeric.octal",
                "constant.numeric.binary",
                "constant.numeric.integer.python",
                "constant.numeric.float.python"
            ],
            "settings": { "foreground": "#BD93F9" }
        },
        {
            "name": "Constants & Enums",
            "scope": [
                "constant",
                "constant.language",
                "constant.language.boolean",
                "constant.language.null",
                "constant.language.undefined",
                "constant.other",
                "variable.other.constant",
                "variable.other.enummember",
                "constant.language.python",
                "support.type.enum",
                "entity.name.type.enum"
            ],
            "settings": { "foreground": "#BD93F9" }
        },
        {
            "name": "Booleans (true, false, None, null)",
            "scope": [
                "constant.language.boolean.true",
                "constant.language.boolean.false",
                "constant.language.null",
                "constant.language.undefined",
                "constant.language.none.python"
            ],
            "settings": { "foreground": "#BD93F9" }
        },
        {
            "name": "Types, Classes, Interfaces",
            "scope": [
                "entity.name.type",
                "entity.name.type.class",
                "entity.name.type.interface",
                "entity.name.type.alias",
                "entity.name.type.module",
                "entity.name.class",
                "entity.other.inherited-class",
                "support.type",
                "support.type.builtin",
                "support.class",
                "support.class.builtin",
                "entity.name.type.class.python",
                "support.type.python"
            ],
            "settings": { "foreground": "#8BE9FD", "fontStyle": "italic" }
        },
        {
            "name": "Decorators (@decorator)",
            "scope": [
                "meta.decorator",
                "entity.name.function.decorator",
                "entity.name.function.decorator.python",
                "punctuation.definition.decorator.python",
                "meta.decorator.python"
            ],
            "settings": { "foreground": "#50FA7B", "fontStyle": "italic" }
        },
        {
            "name": "Operators (=, +, -, *, &&, ||, etc.)",
            "scope": [
                "keyword.operator",
                "keyword.operator.assignment",
                "keyword.operator.arithmetic",
                "keyword.operator.comparison",
                "keyword.operator.logical",
                "keyword.operator.ternary",
                "keyword.operator.spread",
                "keyword.operator.rest",
                "keyword.operator.type",
                "keyword.operator.type.annotation"
            ],
            "settings": { "foreground": "#FF79C6" }
        },
        {
            "name": "Punctuation (brackets, commas, semicolons)",
            "scope": [
                "punctuation",
                "punctuation.definition.block",
                "punctuation.definition.parameters",
                "punctuation.separator",
                "punctuation.terminator",
                "punctuation.accessor",
                "punctuation.section",
                "meta.brace.round",
                "meta.brace.square",
                "meta.brace.curly"
            ],
            "settings": { "foreground": "#F8F8F2" }
        },
        {
            "name": "HTML / JSX Tags",
            "scope": [
                "entity.name.tag",
                "entity.name.tag.html",
                "entity.name.tag.js",
                "entity.name.tag.tsx",
                "support.class.component"
            ],
            "settings": { "foreground": "#FF79C6" }
        },
        {
            "name": "HTML / JSX Attributes",
            "scope": [
                "entity.other.attribute-name",
                "entity.other.attribute-name.html",
                "entity.other.attribute-name.js",
                "entity.other.attribute-name.tsx"
            ],
            "settings": { "foreground": "#50FA7B", "fontStyle": "italic" }
        },
        {
            "name": "CSS Properties",
            "scope": [
                "support.type.property-name.css",
                "support.type.vendored.property-name.css",
                "meta.property-name.css"
            ],
            "settings": { "foreground": "#8BE9FD" }
        },
        {
            "name": "CSS Values & Units",
            "scope": [
                "support.constant.property-value.css",
                "constant.numeric.css",
                "keyword.other.unit.css",
                "support.constant.color.css"
            ],
            "settings": { "foreground": "#BD93F9" }
        },
        {
            "name": "CSS Selectors (class, id, pseudo)",
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css",
                "entity.other.attribute-name.pseudo-class.css",
                "entity.other.attribute-name.pseudo-element.css"
            ],
            "settings": { "foreground": "#50FA7B" }
        },
        {
            "name": "JSON Keys",
            "scope": [
                "support.type.property-name.json",
                "string.json support.type.property-name.json"
            ],
            "settings": { "foreground": "#8BE9FD" }
        },
        {
            "name": "Markdown Headings",
            "scope": [
                "heading.1.markdown entity.name",
                "heading.2.markdown entity.name",
                "heading.3.markdown entity.name",
                "heading.4.markdown entity.name",
                "heading.5.markdown entity.name",
                "heading.6.markdown entity.name",
                "markup.heading"
            ],
            "settings": { "foreground": "#BD93F9", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Bold",
            "scope": ["markup.bold"],
            "settings": { "foreground": "#FFB86C", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Italic",
            "scope": ["markup.italic"],
            "settings": { "foreground": "#F1FA8C", "fontStyle": "italic" }
        },
        {
            "name": "Markdown Link",
            "scope": ["markup.underline.link", "string.other.link"],
            "settings": { "foreground": "#8BE9FD" }
        },
        {
            "name": "Markdown Code",
            "scope": ["markup.inline.raw", "markup.fenced_code.block"],
            "settings": { "foreground": "#50FA7B" }
        },
        {
            "name": "Inserted (Diff)",
            "scope": ["markup.inserted"],
            "settings": { "foreground": "#50FA7B" }
        },
        {
            "name": "Deleted (Diff)",
            "scope": ["markup.deleted"],
            "settings": { "foreground": "#FF5555" }
        },
        {
            "name": "Changed (Diff)",
            "scope": ["markup.changed"],
            "settings": { "foreground": "#FFB86C" }
        },
        {
            "name": "Support (built-in modules, globals)",
            "scope": [
                "support.module",
                "support.variable",
                "support.constant",
                "support.other"
            ],
            "settings": { "foreground": "#8BE9FD" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": {
                "foreground": "#FF5555",
                "fontStyle": "strikethrough"
            }
        },
        {
            "name": "Deprecated",
            "scope": ["invalid.deprecated"],
            "settings": {
                "foreground": "#FFB86C",
                "fontStyle": "strikethrough"
            }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "variable": "#F8F8F2",
        "variable.declaration": "#F8F8F2",
        "variable.readonly": "#BD93F9",
        "variable.defaultLibrary": "#BD93F9",
        "parameter": { "foreground": "#FFB86C", "fontStyle": "italic" },
        "property": "#F8F8F2",
        "property.readonly": "#BD93F9",
        "property.declaration": "#F8F8F2",
        "enumMember": "#BD93F9",
        "function": "#50FA7B",
        "function.declaration": "#50FA7B",
        "function.defaultLibrary": "#50FA7B",
        "method": "#50FA7B",
        "method.declaration": "#50FA7B",
        "class": { "foreground": "#8BE9FD", "fontStyle": "italic" },
        "class.declaration": { "foreground": "#8BE9FD", "fontStyle": "italic" },
        "class.defaultLibrary": {
            "foreground": "#8BE9FD",
            "fontStyle": "italic"
        },
        "interface": { "foreground": "#8BE9FD", "fontStyle": "italic" },
        "interface.declaration": {
            "foreground": "#8BE9FD",
            "fontStyle": "italic"
        },
        "type": { "foreground": "#8BE9FD", "fontStyle": "italic" },
        "type.declaration": { "foreground": "#8BE9FD", "fontStyle": "italic" },
        "type.defaultLibrary": {
            "foreground": "#8BE9FD",
            "fontStyle": "italic"
        },
        "typeParameter": { "foreground": "#8BE9FD", "fontStyle": "italic" },
        "namespace": "#8BE9FD",
        "enum": { "foreground": "#8BE9FD", "fontStyle": "italic" },
        "enum.declaration": { "foreground": "#8BE9FD", "fontStyle": "italic" },
        "decorator": { "foreground": "#50FA7B", "fontStyle": "italic" },
        "keyword": "#FF79C6",
        "number": "#BD93F9",
        "string": "#F1FA8C",
        "regexp": "#FF5555",
        "operator": "#FF79C6",
        "comment": { "foreground": "#6272A4", "fontStyle": "italic" },
        "selfKeyword": { "foreground": "#BD93F9", "fontStyle": "italic" }
    }
}
