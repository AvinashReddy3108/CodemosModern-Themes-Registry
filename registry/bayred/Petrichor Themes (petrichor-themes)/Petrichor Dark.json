    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#7D8590", "fontStyle": "italic" }
        },
        {
            "name": "Python Docstrings",
            "scope": [
                "string.quoted.docstring.multi.python",
                "string.quoted.docstring.single.python"
            ],
            "settings": { "foreground": "#8B949E", "fontStyle": "italic" }
        },
        {
            "name": "Keywords",
            "scope": ["keyword", "storage", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#FF7B72", "fontStyle": "bold italic" }
        },
        {
            "name": "Operators and punctuation",
            "scope": [
                "keyword.operator",
                "punctuation.separator",
                "punctuation.terminator"
            ],
            "settings": { "foreground": "#F0887A", "fontStyle": "bold" }
        },
        {
            "name": "Strings",
            "scope": ["string", "string.quoted", "string.interpolated"],
            "settings": { "foreground": "#7EE787" }
        },
        {
            "name": "Numbers",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#F2CC60" }
        },
        {
            "name": "Function definitions",
            "scope": ["entity.name.function"],
            "settings": { "foreground": "#56D4DD" }
        },
        {
            "name": "Function and method calls",
            "scope": [
                "meta.function-call",
                "variable.function",
                "support.function",
                "entity.name.function.member"
            ],
            "settings": { "foreground": "#D2A8FF" }
        },
        {
            "name": "Parameters",
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#79C0FF" }
        },
        {
            "name": "Decorators and annotations",
            "scope": [
                "meta.function.decorator.python",
                "meta.decorator.python",
                "entity.name.function.decorator",
                "storage.type.annotation"
            ],
            "settings": { "foreground": "#F2CC60" }
        },
        {
            "name": "Classes and types",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.class",
                "support.type"
            ],
            "settings": { "foreground": "#E6EDF3" }
        },
        {
            "name": "Properties and object keys",
            "scope": [
                "variable.other.property",
                "meta.object-literal.key",
                "support.type.property-name",
                "entity.name.tag.yaml"
            ],
            "settings": { "foreground": "#B392F0" }
        },
        {
            "name": "Builtins and language constants",
            "scope": [
                "support.type.builtin",
                "support.function.builtin",
                "variable.language",
                "constant.language"
            ],
            "settings": { "foreground": "#F0F6FC" }
        },
        {
            "name": "Invalid / illegal",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#FF7B72", "fontStyle": "underline" }
        }
    ],
    "semanticTokenColors": {
        "comment": { "foreground": "#7D8590", "italic": true },
        "string": "#7EE787",
        "number": "#F2CC60",
        "keyword": { "foreground": "#FF7B72", "bold": true, "italic": true },
        "operator": { "foreground": "#F0887A", "bold": true },
        "class": "#E6EDF3",
        "interface": "#E6EDF3",
        "type": "#E6EDF3",
        "enum": "#E6EDF3",
        "enumMember": "#B392F0",
        "typeParameter": "#C9A8FF",
        "namespace": "#7CC7FF",
        "function": "#56D4DD",
        "method": "#D2A8FF",
        "parameter": "#79C0FF",
        "decorator": "#F2CC60",
        "property": "#B392F0",
        "property.readonly": "#B392F0",
        "variable.defaultLibrary": "#F0F6FC"
    }
}
