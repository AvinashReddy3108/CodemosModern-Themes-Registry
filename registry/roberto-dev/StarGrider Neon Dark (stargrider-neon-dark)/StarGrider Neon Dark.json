        "editor.background": "#0F0A1E",
        "editor.foreground": "#C9D1D9",
        "editorLineNumber.foreground": "#4E5563",
        "editorLineNumber.activeForeground": "#C9D1D9",
        "editorCursor.foreground": "#cdb8ff",
        "editorCursor.background": "#0F0A1E",
