        "editorGutter.addedBackground": "#ccefe9",
        "editorGutter.deletedBackground": "#ff7aa2",
        "diffEditor.insertedTextBackground": "#1f9d8b33",
        "diffEditor.removedTextBackground": "#ff7aa233",
        "editorWarning.foreground": "#FFCC24",
        "editorInfo.foreground": "#74c7ec",
        "editorError.foreground": "#ff7aa2",
        "chat.requestBackground": "#0B0718",
        "chat.responseBackground": "#090513",
        "chat.requestBorder": "#1A1730",
        "chat.responseBorder": "#1A1730"
    },
    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#5B6470", "fontStyle": "italic" }
        },
        {
            "name": "Strings",
            "scope": ["string", "punctuation.definition.string"],
            "settings": { "foreground": "#cdb8ff" }
        },
        {
            "name": "Template strings / reg∏ex",
            "scope": ["string.template", "string.regexp"],
            "settings": { "foreground": "#e6dcff" }
        },
        {
            "name": "Numbers / constants",
            "scope": [
                "constant.numeric",
                "constant.language",
                "constant.character",
                "constant.other"
            ],
            "settings": { "foreground": "#F9E2AF" }
        },
        {
            "name": "Keywords",
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#9b70ff" }
        },
        {
            "name": "Control keywords (if/for/return)",
            "scope": ["keyword.control"],
            "settings": { "foreground": "#b494ff" }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call"
            ],
            "settings": { "foreground": "#e6dcff" }
        },
        {
            "name": "Methods",
            "scope": [
                "entity.name.function.member",
                "support.function.any-method"
            ],
            "settings": { "foreground": "#cdb8ff" }
        },
        {
            "name": "Types / Classes",
            "scope": [
                "entity.name.type",
                "support.type",
                "storage.type.class",
                "meta.class"
            ],
            "settings": { "foreground": "#74c7ec" }
        },
        {
            "name": "Interfaces / type parameters",
            "scope": [
                "entity.name.type.interface",
                "entity.name.type.type-parameter"
            ],
            "settings": { "foreground": "#89dceb" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "meta.definition.variable", "identifier"],
            "settings": { "foreground": "#f5c2e7" }
        },
        {
            "name": "Parameters",
            "scope": ["variable.parameter", "meta.parameter"],
            "settings": { "foreground": "#e6dcff" }
        },
        {
            "name": "Properties",
            "scope": ["variable.other.property", "support.type.property-name"],
            "settings": { "foreground": "#e6dcff" }
        },
        {
            "name": "Object keys (JSON/YAML)",
            "scope": [
                "support.type.property-name.json",
                "support.type.property-name.yaml",
                "entity.name.tag.yaml"
            ],
            "settings": { "foreground": "#e6dcff" }
        },
        {
            "name": "Operators / punctuation",
            "scope": [
                "keyword.operator",
                "punctuation",
                "meta.brace",
                "meta.delimiter"
            ],
            "settings": { "foreground": "#7D8590" }
        },
        {
            "name": "Tags / JSX",
            "scope": ["entity.name.tag", "support.class.component", "meta.tag"],
            "settings": { "foreground": "#cdb8ff" }
        },
        {
            "name": "Attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#74c7ec" }
        },
        {
            "name": "Markdown headings",
            "scope": ["markup.heading", "entity.name.section.markdown"],
            "settings": { "foreground": "#cdb8ff", "fontStyle": "bold" }
        },
        {
            "name": "Links",
            "scope": ["markup.underline.link", "string.other.link"],
            "settings": { "foreground": "#74c7ec", "fontStyle": "underline" }
        },
        {
            "name": "Diff",
            "scope": ["markup.inserted", "punctuation.definition.inserted"],
            "settings": { "foreground": "#cdb8ff" }
        },
        {
            "name": "Diff removed",
            "scope": ["markup.deleted", "punctuation.definition.deleted"],
            "settings": { "foreground": "#ff7aa2" }
        },
        {
            "name": "Invalid / Errors",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#ff7aa2" }
        }
    ],
    "semanticTokenColors": {
        "namespace": "#74c7ec",
        "type": "#74c7ec",
        "class": "#74c7ec",
        "interface": "#89dceb",
        "enum": "#89dceb",
        "typeParameter": "#89dceb",
        "function": "#e6dcff",
        "method": "#cdb8ff",
        "macro": "#b494ff",
        "parameter": "#e6dcff",
        "variable": "#f5c2e7",
        "property": "#e6dcff",
        "enumMember": "#F9E2AF",
        "keyword": "#9b70ff",
        "operator": "#7D8590",
        "string": "#cdb8ff",
        "number": "#F9E2AF",
        "comment": { "foreground": "#5B6470", "italic": true },
        "regexp": "#e6dcff",
        "decorator": "#b494ff",
        "event": "#cdb8ff",
        "*.readonly": { "foreground": "#e6dcff" },
        "*.defaultLibrary": { "foreground": "#7D8590" }
    },
    "$schema": "vscode://schemas/color-theme"
}
