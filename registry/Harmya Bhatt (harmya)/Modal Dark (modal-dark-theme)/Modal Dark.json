    "tokenColors": [
        {
            "scope": [
                "comment",
                "punctuation.definition.comment",
                "string.quoted.docstring"
            ],
            "settings": { "foreground": "#5d5d5d", "fontStyle": "italic" }
        },
        {
            "scope": ["string", "string.quoted"],
            "settings": { "foreground": "#c8f9b6" }
        },
        { "scope": ["string.regexp"], "settings": { "foreground": "#ff8de6" } },
        {
            "scope": ["constant.character.escape"],
            "settings": { "foreground": "#ffab5e" }
        },
        {
            "scope": ["constant.numeric", "constant.language"],
            "settings": { "foreground": "#ffab5e" }
        },
        {
            "scope": ["constant.other", "constant.other.color"],
            "settings": { "foreground": "#ffab5e" }
        },
        {
            "scope": [
                "keyword",
                "keyword.control",
                "storage.type",
                "storage.modifier"
            ],
            "settings": { "foreground": "#ff8de6" }
        },
        {
            "scope": ["keyword.operator", "keyword.operator.expression"],
            "settings": { "foreground": "#91c8ef" }
        },
        {
            "scope": ["keyword.operator.new", "keyword.operator.delete"],
            "settings": { "foreground": "#ff8de6" }
        },
        {
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call.generic"
            ],
            "settings": { "foreground": "#7fee64", "fontStyle": "bold" }
        },
        {
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.type",
                "support.class",
                "entity.other.inherited-class"
            ],
            "settings": { "foreground": "#ffea71" }
        },
        {
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#7fee64" }
        },
        {
            "scope": [
                "entity.name.tag.css",
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css"
            ],
            "settings": { "foreground": "#7fee64" }
        },
        {
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#ff8de6", "fontStyle": "italic" }
        },
        {
            "scope": ["variable", "variable.other", "variable.other.readwrite"],
            "settings": { "foreground": "#d1d1d1" }
        },
        {
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#a3a3a3" }
        },
        {
            "scope": [
                "variable.language",
                "variable.language.self",
                "variable.language.this"
            ],
            "settings": { "foreground": "#8b8b8b", "fontStyle": "italic" }
        },
        {
            "scope": [
                "meta.decorator",
                "entity.name.function.decorator",
                "punctuation.decorator"
            ],
            "settings": { "foreground": "#ffab5e" }
        },
        {
            "scope": ["punctuation", "meta.brace", "meta.delimiter"],
            "settings": { "foreground": "#8b8b8b" }
        },
        {
            "scope": [
                "punctuation.definition.string",
                "punctuation.definition.string.begin",
                "punctuation.definition.string.end"
            ],
            "settings": { "foreground": "#c8f9b6" }
        },
        {
            "scope": [
                "support.module",
                "entity.name.import",
                "entity.name.package",
                "entity.name.namespace"
            ],
            "settings": { "foreground": "#7fee64" }
        },
        {
            "scope": ["support.variable", "support.constant"],
            "settings": { "foreground": "#91c8ef" }
        },
        {
            "scope": ["markup.heading", "entity.name.section"],
            "settings": { "foreground": "#7fee64", "fontStyle": "bold" }
        },
        {
            "scope": ["markup.bold"],
            "settings": { "foreground": "#e8e8e8", "fontStyle": "bold" }
        },
        {
            "scope": ["markup.italic"],
            "settings": { "foreground": "#e8e8e8", "fontStyle": "italic" }
        },
        {
            "scope": ["markup.inline.raw", "markup.fenced_code"],
            "settings": { "foreground": "#ff8de6" }
        },
        { "scope": ["markup.list"], "settings": { "foreground": "#d1d1d1" } },
        {
            "scope": ["markup.quote"],
            "settings": { "foreground": "#8b8b8b", "fontStyle": "italic" }
        },
        {
            "scope": ["markup.link", "markup.underline.link"],
            "settings": { "foreground": "#91c8ef" }
        },
        {
            "scope": ["markup.inserted"],
            "settings": { "foreground": "#7fee64" }
        },
        {
            "scope": ["markup.deleted"],
            "settings": { "foreground": "#f87171" }
        },
        {
            "scope": ["markup.changed"],
            "settings": { "foreground": "#ffab5e" }
        },
        {
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#f87171", "fontStyle": "underline" }
        },
        {
            "scope": ["meta.embedded", "source.groovy.embedded"],
            "settings": { "foreground": "#d1d1d1" }
        },
        {
            "scope": [
                "punctuation.section.embedded",
                "punctuation.definition.template-expression"
            ],
            "settings": { "foreground": "#ff8de6" }
        },
        {
            "scope": ["meta.diff.header"],
            "settings": { "foreground": "#91c8ef" }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "namespace": "#7fee64",
        "class": "#ffea71",
        "interface": "#ffea71",
        "type": "#ffea71",
        "enum": "#ffea71",
        "enumMember": "#ffab5e",
        "function": { "foreground": "#7fee64", "bold": true },
        "method": { "foreground": "#7fee64", "bold": true },
        "macro": "#ff8de6",
        "variable": "#d1d1d1",
        "parameter": "#a3a3a3",
        "property": "#d1d1d1",
        "selfKeyword": { "foreground": "#8b8b8b", "italic": true },
        "decorator": "#ffab5e"
    },
    "$schema": "vscode://schemas/color-theme"
}
