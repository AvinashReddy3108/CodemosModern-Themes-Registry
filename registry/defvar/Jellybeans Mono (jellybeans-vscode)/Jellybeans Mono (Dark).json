{
    "$schema": "vscode://schemas/color-theme",
    "name": "Jellybeans Mono (Dark)",
    "type": "dark",
    "semanticHighlighting": true,
    "colors": {
        "focusBorder": "#404040",
        "foreground": "#e8e8d3",
        "descriptionForeground": "#888888",
        "disabledForeground": "#606060",
        "errorForeground": "#c95c5c",
        "icon.foreground": "#c7c7c7",
        "widget.border": "#404040",
        "widget.shadow": "#000000",
        "selection.background": "#33333380",
        "sash.hoverBorder": "#535d66",
        "scrollbar.shadow": "#000000",
        "scrollbarSlider.background": "#33333380",
        "scrollbarSlider.hoverBackground": "#40404080",
        "scrollbarSlider.activeBackground": "#535d6680",
        "toolbar.hoverBackground": "#33333380",
        "toolbar.activeBackground": "#40404080",
        "editorActionList.background": "#333333",
        "editorActionList.foreground": "#e8e8d3",
        "editorActionList.focusBackground": "#404040",
        "editorActionList.focusForeground": "#e8e8d3",
        "editor.background": "#151515",
        "editor.foreground": "#e8e8d3",
        "editorLineNumber.foreground": "#605958",
        "editorLineNumber.activeForeground": "#ccc5c4",
        "editorCursor.foreground": "#dddddd",
        "editor.selectionBackground": "#404040",
        "editor.inactiveSelectionBackground": "#33333380",
        "editor.selectionHighlightBackground": "#33333380",
        "editor.selectionHighlightBorder": "#403c41",
        "editor.wordHighlightBackground": "#33333380",
        "editor.wordHighlightStrongBackground": "#403c4180",
        "editor.lineHighlightBackground": "#1c1c1c",
        "editor.rangeHighlightBackground": "#33333380",
        "editorWhitespace.foreground": "#333333",
        "editorIndentGuide.background1": "#333333",
        "editorIndentGuide.activeBackground1": "#535d66",
        "editorBracketMatch.background": "#33333380",
        "editorBracketMatch.border": "#c7c7c7",
        "editor.findMatchBackground": "#403c4180",
        "editor.findMatchHighlightBackground": "#33333380",
        "editorRuler.foreground": "#333333",
        "minimap.background": "#101010",
        "minimap.findMatchHighlight": "#403c4180",
        "minimap.selectionHighlight": "#33333380",
        "editorError.foreground": "#c95c5c",
        "editorWarning.foreground": "#ffaf00",
        "editorInfo.foreground": "#7a8aa6",
        "editorHint.foreground": "#a08070",
        "editorGutter.background": "#151515",
        "editorGutter.modifiedBackground": "#7a8aa6",
        "editorGutter.addedBackground": "#afd787",
        "editorGutter.deletedBackground": "#c95c5c",
        "editorWidget.background": "#333333",
        "editorWidget.border": "#404040",
        "editorSuggestWidget.background": "#333333",
        "editorSuggestWidget.border": "#404040",
        "editorSuggestWidget.foreground": "#c7c7c7",
        "editorSuggestWidget.highlightForeground": "#7a8aa6",
        "editorSuggestWidget.selectedBackground": "#404040",
        "editorHoverWidget.background": "#333333",
        "editorHoverWidget.border": "#404040",
        "sideBar.background": "#101010",
        "sideBar.foreground": "#e8e8d3",
        "sideBar.border": "#1c1c1c",
        "sideBarSectionHeader.background": "#1c1c1c",
        "sideBarSectionHeader.foreground": "#c7c7c7",
        "activityBar.background": "#101010",
        "activityBar.foreground": "#e8e8d3",
        "activityBar.inactiveForeground": "#888888",
        "activityBar.border": "#1c1c1c",
        "statusBar.background": "#1c1c1c",
        "statusBar.foreground": "#ffffff",
        "statusBar.border": "#1c1c1c",
        "statusBar.noFolderBackground": "#1c1c1c",
        "statusBar.debuggingBackground": "#556779",
        "titleBar.activeBackground": "#101010",
        "titleBar.activeForeground": "#e8e8d3",
        "titleBar.inactiveBackground": "#101010",
        "titleBar.inactiveForeground": "#888888",
        "titleBar.border": "#1c1c1c",
        "panel.background": "#101010",
        "panel.border": "#1c1c1c",
        "panelTitle.activeForeground": "#e8e8d3",
        "panelTitle.inactiveForeground": "#888888",
        "tab.activeBackground": "#151515",
        "tab.activeForeground": "#e8e8d3",
        "tab.inactiveBackground": "#101010",
        "tab.inactiveForeground": "#888888",
        "tab.border": "#1c1c1c",
        "editorGroup.border": "#1c1c1c",
        "editorGroupHeader.tabsBackground": "#101010",
        "editorGroupHeader.tabsBorder": "#1c1c1c",
        "breadcrumb.foreground": "#888888",
        "breadcrumb.activeSelectionForeground": "#e8e8d3",
        "button.background": "#333333",
        "button.foreground": "#e8e8d3",
        "button.hoverBackground": "#404040",
        "badge.background": "#333333",
        "badge.foreground": "#e8e8d3",
        "dropdown.background": "#1c1c1c",
        "dropdown.foreground": "#e8e8d3",
        "dropdown.border": "#333333",
        "input.background": "#1c1c1c",
        "input.foreground": "#e8e8d3",
        "input.border": "#333333",
        "input.placeholderForeground": "#606060",
        "inputOption.activeBackground": "#333333",
        "inputOption.activeBorder": "#7a8aa6",
        "quickInput.background": "#1c1c1c",
        "quickInput.foreground": "#e8e8d3",
        "quickInputTitle.background": "#1c1c1c",
        "list.activeSelectionBackground": "#333333",
        "list.activeSelectionForeground": "#e8e8d3",
        "list.activeSelectionIconForeground": "#e8e8d3",
        "list.inactiveSelectionBackground": "#1c1c1c",
        "list.inactiveSelectionForeground": "#e8e8d3",
        "list.inactiveSelectionIconForeground": "#c7c7c7",
        "list.hoverBackground": "#1c1c1c",
        "list.hoverForeground": "#e8e8d3",
        "list.focusBackground": "#333333",
        "list.focusForeground": "#e8e8d3",
        "list.highlightForeground": "#7a8aa6",
        "list.dropBackground": "#33333380",
        "notifications.background": "#1c1c1c",
        "notifications.foreground": "#e8e8d3",
        "notifications.border": "#333333",
        "notificationCenterHeader.background": "#1c1c1c",
        "notificationLink.foreground": "#7a8aa6",
        "peekViewEditor.background": "#101010",
        "peekViewResult.background": "#1c1c1c",
        "peekView.border": "#333333",
        "peekViewEditor.matchHighlightBackground": "#333333",
        "diffEditor.insertedTextBackground": "#afd78733",
        "diffEditor.removedTextBackground": "#c95c5c33",
        "terminal.background": "#151515",
        "terminal.foreground": "#e8e8d3",
        "terminalCursor.foreground": "#dddddd",
        "terminal.ansiBlack": "#101010",
        "terminal.ansiRed": "#c95c5c",
        "terminal.ansiGreen": "#afd787",
        "terminal.ansiYellow": "#ffaf00",
        "terminal.ansiBlue": "#7a8aa6",
        "terminal.ansiMagenta": "#b39066",
        "terminal.ansiCyan": "#7a8aa6",
        "terminal.ansiWhite": "#e8e8d3",
        "terminal.ansiBrightBlack": "#333333",
        "terminal.ansiBrightRed": "#c95c5c",
        "terminal.ansiBrightGreen": "#afd787",
        "terminal.ansiBrightYellow": "#ffaf00",
        "terminal.ansiBrightBlue": "#7a8aa6",
        "terminal.ansiBrightMagenta": "#b39066",
        "terminal.ansiBrightCyan": "#7a8aa6",
        "terminal.ansiBrightWhite": "#f0f0f0"
    },
    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#606060", "fontStyle": "italic" }
        },
        {
            "name": "Keyword",
            "scope": ["keyword", "storage", "modifier"],
            "settings": { "foreground": "#888888" }
        },
        {
            "name": "Type",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "entity.name.struct",
                "entity.name.enum",
                "entity.name.trait",
                "support.type",
                "support.class",
                "support.other.namespace"
            ],
            "settings": { "foreground": "#b39066", "fontStyle": "bold" }
        },
        {
            "name": "Function",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call",
                "variable.function",
                "entity.name.method",
                "support.method"
            ],
            "settings": { "foreground": "#7a8aa6", "fontStyle": "bold" }
        },
        {
            "name": "String",
            "scope": ["string", "constant.other.symbol"],
            "settings": { "foreground": "#a08070" }
        },
        {
            "name": "String Escape",
            "scope": ["constant.character.escape", "string.other.link"],
            "settings": { "foreground": "#a0a8b0" }
        },
        {
            "name": "Regular Expression",
            "scope": [
                "string.regexp",
                "constant.other.regex",
                "markup.raw.regexp"
            ],
            "settings": { "foreground": "#7a8aa6" }
        },
        {
            "name": "Documentation",
            "scope": [
                "comment.block.documentation",
                "comment.block.documentation punctuation.definition.comment",
                "comment.line.documentation"
            ],
            "settings": { "foreground": "#606060", "fontStyle": "italic" }
        },
        {
            "name": "Constant",
            "scope": [
                "constant",
                "variable.other.constant",
                "constant.numeric",
                "constant.language",
                "constant.other"
            ],
            "settings": { "foreground": "#b39066" }
        },
        {
            "name": "Variable",
            "scope": ["variable", "variable.other", "meta.definition.variable"],
            "settings": { "foreground": "#e8e8d3" }
        },
        {
            "name": "Parameter",
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#ccc5c4", "fontStyle": "italic" }
        },
        {
            "name": "Property",
            "scope": ["variable.other.property", "variable.other.member"],
            "settings": { "foreground": "#dddddd" }
        },
        {
            "name": "Operator",
            "scope": ["keyword.operator", "meta.brace"],
            "settings": { "foreground": "#777777" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation",
                "punctuation.definition",
                "punctuation.separator",
                "punctuation.terminator"
            ],
            "settings": { "foreground": "#c7c7c7" }
        },
        {
            "name": "Module",
            "scope": [
                "entity.name.namespace",
                "entity.name.module",
                "support.module"
            ],
            "settings": { "foreground": "#777777", "fontStyle": "italic" }
        },
        {
            "name": "Tag",
            "scope": [
                "entity.name.tag",
                "meta.tag",
                "markup.tag",
                "entity.name.tag.html",
                "entity.name.tag.xml",
                "entity.name.tag.jsx",
                "entity.name.tag.tsx"
            ],
            "settings": { "foreground": "#7a8aa6" }
        },
        {
            "name": "Tag Punctuation",
            "scope": [
                "punctuation.definition.tag",
                "punctuation.definition.tag.begin",
                "punctuation.definition.tag.end"
            ],
            "settings": { "foreground": "#c7c7c7" }
        },
        {
            "name": "Attribute",
            "scope": [
                "entity.other.attribute-name",
                "meta.attribute",
                "entity.other.attribute-name.class",
                "entity.other.attribute-name.id",
                "entity.other.attribute-name.jsx",
                "entity.other.attribute-name.tsx"
            ],
            "settings": { "foreground": "#a0a8b0" }
        },
        {
            "name": "Markdown Inline Code",
            "scope": [
                "markup.inline.raw",
                "markup.inline.raw.string",
                "markup.inline.raw.markdown",
                "markup.inline.raw.markdown punctuation.definition.raw"
            ],
            "settings": { "foreground": "#b39066", "fontStyle": "" }
        },
        {
            "name": "Markdown Code Block",
            "scope": [
                "markup.fenced_code.block",
                "markup.fenced_code.block.markdown",
                "markup.raw.block",
                "markup.raw.block.markdown"
            ],
            "settings": { "foreground": "#a08070" }
        },
        {
            "name": "Markdown Quote",
            "scope": ["markup.quote", "markup.quote.markdown"],
            "settings": { "foreground": "#a0a8b0", "fontStyle": "italic" }
        },
        {
            "name": "Markup Heading",
            "scope": [
                "markup.heading",
                "markup.heading punctuation.definition.heading"
            ],
            "settings": { "foreground": "#7a8aa6", "fontStyle": "bold" }
        },
        {
            "name": "Markup Bold",
            "scope": ["markup.bold", "markup.strong"],
            "settings": { "foreground": "#ccc5c4", "fontStyle": "bold" }
        },
        {
            "name": "Markup Italic",
            "scope": ["markup.italic", "markup.emphasis"],
            "settings": { "foreground": "#ccc5c4", "fontStyle": "italic" }
        },
        {
            "name": "Markup Strikethrough",
            "scope": ["markup.strikethrough"],
            "settings": {
                "foreground": "#606060",
                "fontStyle": "strikethrough"
            }
        },
        {
            "name": "Markup Link",
            "scope": [
                "markup.underline.link",
                "markup.link",
                "string.other.link"
            ],
            "settings": { "foreground": "#7a8aa6", "fontStyle": "underline" }
        },
        {
            "name": "Markup List",
            "scope": [
                "markup.list",
                "markup.list punctuation.definition.list",
                "markup.list.markdown"
            ],
            "settings": { "foreground": "#a0a8b0" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#c95c5c" }
        }
    ],
    "semanticTokenColors": {
        "comment": { "foreground": "#606060", "fontStyle": "italic" },
        "string": { "foreground": "#a08070" },
        "keyword": { "foreground": "#888888" },
        "number": { "foreground": "#b39066" },
        "regexp": { "foreground": "#7a8aa6" },
        "operator": { "foreground": "#777777" },
        "type": { "foreground": "#b39066", "fontStyle": "bold" },
        "type.declaration": { "foreground": "#b39066", "fontStyle": "bold" },
        "type.defaultLibrary": {
            "foreground": "#b39066",
            "fontStyle": "italic"
        },
        "class": { "foreground": "#b39066", "fontStyle": "bold" },
        "class.declaration": { "foreground": "#b39066", "fontStyle": "bold" },
        "class.defaultLibrary": {
            "foreground": "#b39066",
            "fontStyle": "italic"
        },
        "interface": { "foreground": "#b39066", "fontStyle": "bold" },
        "interface.defaultLibrary": {
            "foreground": "#b39066",
            "fontStyle": "italic"
        },
        "enum": { "foreground": "#b39066", "fontStyle": "bold" },
        "enum.defaultLibrary": {
            "foreground": "#b39066",
            "fontStyle": "italic"
        },
        "typeParameter": { "foreground": "#b39066" },
        "typeParameter.declaration": { "foreground": "#b39066" },
        "function": { "foreground": "#7a8aa6", "fontStyle": "bold" },
        "function.declaration": {
            "foreground": "#7a8aa6",
            "fontStyle": "bold"
        },
        "function.defaultLibrary": {
            "foreground": "#7a8aa6",
            "fontStyle": "italic"
        },
        "method": { "foreground": "#7a8aa6", "fontStyle": "bold" },
        "method.defaultLibrary": {
            "foreground": "#7a8aa6",
            "fontStyle": "italic"
        },
        "macro": { "foreground": "#777777" },
        "decorator": { "foreground": "#a0a8b0" },
        "namespace": { "foreground": "#777777", "fontStyle": "italic" },
        "namespace.defaultLibrary": {
            "foreground": "#777777",
            "fontStyle": "italic"
        },
        "variable": { "foreground": "#e8e8d3" },
        "variable.defaultLibrary": { "foreground": "#dddddd" },
        "variable.readonly": { "foreground": "#b39066" },
        "variable.static": { "foreground": "#b39066" },
        "parameter": { "foreground": "#ccc5c4", "fontStyle": "italic" },
        "parameter.declaration": {
            "foreground": "#ccc5c4",
            "fontStyle": "italic"
        },
        "property": { "foreground": "#dddddd" },
        "property.readonly": { "foreground": "#b39066" },
        "property.defaultLibrary": {
            "foreground": "#dddddd",
            "fontStyle": "italic"
        },
        "enumMember": { "foreground": "#b39066" },
        "enumMember.defaultLibrary": {
            "foreground": "#b39066",
            "fontStyle": "italic"
        },
        "event": { "foreground": "#a0a8b0" },
        "label": { "foreground": "#7a8aa6" },
        "namespace:go": { "foreground": "#dddddd", "fontStyle": "italic" },
        "namespace:python": { "foreground": "#777777", "fontStyle": "italic" },
        "class.defaultLibrary:python": {
            "foreground": "#b39066",
            "fontStyle": "italic"
        },
        "type.defaultLibrary:rust": {
            "foreground": "#b39066",
            "fontStyle": "bold"
        },
        "struct.defaultLibrary:rust": {
            "foreground": "#b39066",
            "fontStyle": "bold"
        },
        "method.defaultLibrary:rust": {
            "foreground": "#7a8aa6",
            "fontStyle": "bold"
        },
        "interface.defaultLibrary:typescript": {
            "foreground": "#b39066",
            "fontStyle": "italic"
        },
        "type.defaultLibrary:typescript": {
            "foreground": "#b39066",
            "fontStyle": "italic"
        },
        "namespace:typescript": {
            "foreground": "#777777",
            "fontStyle": "italic"
        },
        "*.deprecated": {
            "foreground": "#606060",
            "fontStyle": "strikethrough"
        }
    }
}
