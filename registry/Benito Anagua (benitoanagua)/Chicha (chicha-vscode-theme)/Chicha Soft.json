                "constant.numeric.complex.imaginary",
                "constant.language",
                "constant.character.escape",
                "constant.other.placeholder",
                "constant.other"
            ],
            "settings": { "foreground": "#147db4", "fontStyle": "" }
        },
        {
            "name": "Entities, which refer to larger chunks of documents, such as chapters, classes, functions, or tags.",
            "scope": [
                "entity.name.class",
                "entity.name.struct",
                "entity.name.enum",
                "entity.name.union",
                "entity.name.trait",
