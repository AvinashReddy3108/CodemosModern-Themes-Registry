    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#697C81" }
        },
        {
            "name": "Strings",
            "scope": [
                "string",
                "string.quoted",
                "string.template",
                "string.interpolated"
            ],
            "settings": { "foreground": "#cccccc" }
        },
        {
            "name": "String Escape Characters",
            "scope": ["constant.character.escape", "string.regexp"],
            "settings": { "foreground": "#efba5d" }
        },
        {
            "name": "Numbers",
            "scope": [
                "constant.numeric",
                "constant.numeric.integer",
                "constant.numeric.float",
                "constant.numeric.hex",
                "constant.numeric.octal",
                "constant.numeric.binary"
            ],
            "settings": { "foreground": "#E8DCA0" }
        },
        {
            "name": "Constants",
            "scope": ["constant", "constant.language", "constant.other"],
            "settings": { "foreground": "#ffffff" }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.other",
                "storage",
                "storage.type",
                "storage.modifier"
            ],
            "settings": { "foreground": "#eccdba" }
        },
        {
            "name": "Preprocessor Directives",
            "scope": [
                "keyword.control.directive",
                "keyword.control.preprocessor",
                "meta.preprocessor",
                "punctuation.definition.directive"
            ],
            "settings": { "foreground": "#dbbfef" }
        },
        {
            "name": "Operators",
            "scope": [
                "keyword.operator",
                "keyword.operator.arithmetic",
                "keyword.operator.assignment",
                "keyword.operator.comparison",
                "keyword.operator.logical",
                "keyword.operator.bitwise"
            ],
            "settings": { "foreground": "#dbbfef" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation",
                "punctuation.definition",
                "punctuation.separator",
                "punctuation.terminator",
                "punctuation.accessor",
                "punctuation.section",
                "meta.brace"
            ],
            "settings": { "foreground": "#a4a0e8" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "variable.other", "variable.other.readwrite"],
            "settings": { "foreground": "#a4a0e8" }
        },
        {
            "name": "Variable Parameters",
            "scope": ["variable.parameter", "variable.parameter.function"],
            "settings": { "foreground": "#a4a0e8" }
        },
        {
            "name": "Variable Member/Property",
            "scope": [
                "variable.other.member",
                "variable.other.property",
                "variable.other.object.property",
                "meta.object-literal.key"
            ],
            "settings": { "foreground": "#ffffff" }
        },
        {
            "name": "Built-in Variables",
            "scope": [
                "variable.language",
                "variable.language.this",
                "variable.language.self",
                "variable.language.super"
            ],
            "settings": { "foreground": "#9ff28f" }
        },
        {
            "name": "Types",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "entity.name.struct",
                "entity.name.enum",
                "entity.name.union",
                "entity.name.interface",
                "support.type",
                "support.class"
            ],
            "settings": { "foreground": "#ffffff" }
        },
        {
            "name": "Built-in Types",
            "scope": [
                "support.type.builtin",
                "support.type.primitive",
                "storage.type.builtin",
                "storage.type.primitive",
                "keyword.type"
            ],
            "settings": { "foreground": "#ffffff" }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "meta.function-call",
                "support.function"
            ],
            "settings": { "foreground": "#ffffff" }
        },
        {
            "name": "Function Macros",
            "scope": [
                "entity.name.function.macro",
                "entity.name.function.preprocessor",
                "support.function.macro"
            ],
            "settings": { "foreground": "#dbbfef" }
        },
        {
            "name": "Built-in Functions",
            "scope": ["support.function.builtin"],
            "settings": { "foreground": "#ffffff" }
        },
        {
            "name": "Constructors",
            "scope": [
                "entity.name.function.constructor",
                "meta.method.declaration storage.type"
            ],
            "settings": { "foreground": "#dbbfef" }
        },
        {
            "name": "Namespaces",
            "scope": [
                "entity.name.namespace",
                "entity.name.module",
                "entity.name.package",
                "support.other.namespace",
                "meta.path"
            ],
            "settings": { "foreground": "#dbbfef" }
        },
        {
            "name": "Attributes/Annotations",
            "scope": [
                "entity.other.attribute-name",
                "entity.name.function.decorator",
                "meta.decorator",
                "meta.annotation",
                "storage.type.annotation"
            ],
            "settings": { "foreground": "#dbbfef" }
        },
        {
            "name": "Tags (HTML/XML)",
            "scope": ["entity.name.tag", "punctuation.definition.tag"],
            "settings": { "foreground": "#eccdba" }
        },
        {
            "name": "HTML/XML Attribute Names",
            "scope": [
                "entity.other.attribute-name.html",
                "entity.other.attribute-name.xml"
            ],
            "settings": { "foreground": "#dbbfef" }
        },
        {
            "name": "Labels",
            "scope": [
                "entity.name.label",
                "punctuation.definition.label",
                "storage.modifier.lifetime",
                "entity.name.lifetime",
                "punctuation.definition.lifetime"
            ],
            "settings": { "foreground": "#efba5d" }
        },
        {
            "name": "Special",
            "scope": [
                "keyword.other.special-method",
                "support.constant.property-value"
            ],
            "settings": { "foreground": "#efba5d" }
        },
        {
            "name": "Markup Headings",
            "scope": [
                "markup.heading",
                "markup.heading.setext",
                "entity.name.section"
            ],
            "settings": { "foreground": "#dbbfef", "fontStyle": "bold" }
        },
        {
            "name": "Markup Bold",
            "scope": ["markup.bold"],
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Markup Italic",
            "scope": ["markup.italic"],
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "Markup Bold Italic",
            "scope": ["markup.bold markup.italic", "markup.italic markup.bold"],
            "settings": { "fontStyle": "bold italic" }
        },
        {
            "name": "Markup Strikethrough",
            "scope": ["markup.strikethrough"],
            "settings": { "fontStyle": "strikethrough" }
        },
        {
            "name": "Markup Links URL",
            "scope": ["markup.underline.link", "string.other.link"],
            "settings": { "foreground": "#cccccc", "fontStyle": "underline" }
        },
        {
            "name": "Markup Links Text",
            "scope": [
                "markup.link.text",
                "string.other.link.title",
                "string.other.link.description"
            ],
            "settings": { "foreground": "#eccdba" }
        },
        {
            "name": "Markup Raw/Code",
            "scope": [
                "markup.raw",
                "markup.inline.raw",
                "markup.fenced_code",
                "fenced_code.block.language"
            ],
            "settings": { "foreground": "#eccdba" }
        },
        {
            "name": "Markup Quote",
            "scope": ["markup.quote"],
            "settings": { "foreground": "#697C81", "fontStyle": "italic" }
        },
        {
            "name": "Markup List",
            "scope": ["markup.list", "punctuation.definition.list"],
            "settings": { "foreground": "#a4a0e8" }
        },
        {
            "name": "Diff Added",
            "scope": [
                "markup.inserted",
                "meta.diff.header.to-file",
                "punctuation.definition.inserted"
            ],
            "settings": { "foreground": "#35bf86" }
        },
        {
            "name": "Diff Removed",
            "scope": [
                "markup.deleted",
                "meta.diff.header.from-file",
                "punctuation.definition.deleted"
            ],
            "settings": { "foreground": "#f22c86" }
        },
        {
            "name": "Diff Changed",
            "scope": ["markup.changed", "punctuation.definition.changed"],
            "settings": { "foreground": "#6F44F0" }
        },
        {
            "name": "JSON Property Names",
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#dbbfef" }
        },
        {
            "name": "JSON String Values",
            "scope": ["string.quoted.double.json"],
            "settings": { "foreground": "#cccccc" }
        },
        {
            "name": "CSS Property Names",
            "scope": [
                "support.type.property-name.css",
                "support.type.vendored.property-name"
            ],
            "settings": { "foreground": "#a4a0e8" }
        },
        {
            "name": "CSS Property Values",
            "scope": [
                "support.constant.property-value.css",
                "support.constant.font-name",
                "meta.property-value.css"
            ],
            "settings": { "foreground": "#ffffff" }
        },
        {
            "name": "CSS Selectors",
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css",
                "entity.other.attribute-name.pseudo-class.css",
