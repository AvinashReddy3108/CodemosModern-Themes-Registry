            "settings": { "foreground": "#a4a0e8" }
        },
        {
            "name": "Dockerfile Instructions",
            "scope": ["keyword.other.special-method.dockerfile"],
            "settings": { "foreground": "#eccdba" }
        }
    ],
    "semanticHighlighting": true,
