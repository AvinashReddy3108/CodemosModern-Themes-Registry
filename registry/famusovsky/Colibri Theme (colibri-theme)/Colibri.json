            "settings": { "foreground": "#dbbfef" }
        },
        {
            "name": "CSS Units",
            "scope": ["keyword.other.unit.css", "keyword.other.unit"],
            "settings": { "foreground": "#E8DCA0" }
        },
        {
            "name": "YAML Keys",
            "scope": ["entity.name.tag.yaml"],
            "settings": { "foreground": "#dbbfef" }
        },
        {
            "name": "TOML Keys",
            "scope": ["keyword.key.toml", "support.type.property-name.toml"],
            "settings": { "foreground": "#dbbfef" }
        },
        {
            "name": "TOML Tables",
            "scope": [
                "entity.other.attribute-name.table.toml",
                "support.type.property-name.table.toml"
            ],
            "settings": { "foreground": "#eccdba" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#f47868" }
        },
        {
            "name": "Deprecated",
            "scope": ["invalid.deprecated"],
            "settings": {
                "foreground": "#697C81",
                "fontStyle": "strikethrough"
            }
        },
        {
            "name": "Rust Lifetimes",
            "scope": [
                "storage.modifier.lifetime.rust",
                "entity.name.lifetime.rust",
                "punctuation.definition.lifetime.rust"
            ],
            "settings": { "foreground": "#efba5d" }
        },
        {
            "name": "Rust Macros",
            "scope": [
                "entity.name.function.macro.rust",
                "support.function.macro.rust"
            ],
            "settings": { "foreground": "#dbbfef" }
        },
        {
            "name": "Python Decorators",
            "scope": [
                "entity.name.function.decorator.python",
                "meta.function.decorator.python"
            ],
            "settings": { "foreground": "#dbbfef" }
        },
        {
            "name": "Python Self",
            "scope": [
                "variable.parameter.function.language.special.self.python",
                "variable.language.special.self.python"
            ],
            "settings": { "foreground": "#9ff28f" }
        },
        {
            "name": "TypeScript/JavaScript Import/Export",
            "scope": [
                "keyword.control.import",
                "keyword.control.export",
                "keyword.control.from"
            ],
            "settings": { "foreground": "#eccdba" }
        },
        {
            "name": "Go Package",
            "scope": ["entity.name.package.go"],
            "settings": { "foreground": "#dbbfef" }
        },
        {
            "name": "Shell Variables",
            "scope": [
                "variable.other.normal.shell",
                "variable.other.positional.shell",
                "variable.other.bracket.shell"
            ],
            "settings": { "foreground": "#a4a0e8" }
        },
        {
            "name": "Regular Expressions",
            "scope": [
                "string.regexp",
                "keyword.operator.quantifier.regexp",
                "keyword.control.anchor.regexp"
            ],
            "settings": { "foreground": "#efba5d" }
        },
        {
            "name": "Regex Groups",
            "scope": [
                "punctuation.definition.group.regexp",
                "punctuation.definition.character-class.regexp"
            ],
            "settings": { "foreground": "#dbbfef" }
        },
        {
            "name": "SQL Keywords",
            "scope": ["keyword.other.sql", "keyword.other.DML.sql"],
            "settings": { "foreground": "#eccdba" }
        },
        {
            "name": "Makefile Targets",
            "scope": ["entity.name.function.target.makefile"],
