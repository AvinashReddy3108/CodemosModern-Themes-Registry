{
    "name": "whitney",
    "$schema": "vscode://schemas/color-theme",
    "type": "light",
    "colors": {
        "activityBar.background": "#f7f7f7",
        "activityBar.foreground": "#7e7e7e",
        "editor.background": "#ffffff",
        "editor.foreground": "#01d85e",
        "editor.lineHighlightBackground": "#ffffff",
        "editor.selectionBackground": "#ff4d97",
        "editorCursor.foreground": "#ff4d97",
        "editorWhitespace.foreground": "#3b3a32",
        "sideBar.background": "#f7f7f7",
        "sideBar.foreground": "#7e7e7e",
        "editorIndentGuide.activeBackground": "#888888",
        "editorIndentGuide.background": "#f7f7f7"
    },
    "tokenColors": [
        { "scope": "comment", "settings": { "foreground": "#b897bc" } },
        { "scope": "string", "settings": { "foreground": "#7256da" } },
        {
            "scope": "constant.numeric",
            "settings": { "foreground": "#E46767" }
        },
        { "scope": "variable", "settings": { "foreground": "#ff42bd" } },
        { "scope": "keyword", "settings": { "foreground": "#a4d000" } },
        { "scope": "entity.name", "settings": { "foreground": "#f25fc2" } },
        { "scope": "storage", "settings": { "foreground": "#22c3a8" } },
        {
            "scope": "text.html.derivative, variable.language.this.ts, variable.other.object.ts",
            "settings": { "foreground": "#333333" }
        },
        {
            "scope": "variable.parameter.ts",
            "settings": { "foreground": "#22c33d" }
        },
        { "scope": "storage.type", "settings": { "foreground": "#8866CC" } },
        {
            "scope": "entity.name.function",
            "settings": { "foreground": "#22C3A8" }
        },
        {
            "scope": "variable.parameter",
            "settings": { "foreground": "#22C3A8" }
        },
        { "scope": "entity.name.tag", "settings": { "foreground": "#ff9800" } },
        {
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#22C3A8" }
        },
        {
            "scope": "support.function",
            "settings": { "foreground": "#0099FF" }
        },
        {
            "scope": "support.type, support.class, support.constant",
            "settings": { "foreground": "#8866CC" }
        },
        { "scope": "invalid", "settings": { "foreground": "#2E1536" } },
        {
            "scope": "invalid.deprecated",
            "settings": { "foreground": "#F8F8F0" }
        },
        {
            "scope": "token.info-token",
            "settings": { "foreground": "#316BCD" }
        },
        {
            "scope": "token.warn-token",
            "settings": { "foreground": "#CD9731" }
        },
        {
            "scope": "token.error-token",
            "settings": { "foreground": "#CD3131" }
        },
        {
            "scope": "token.debug-token",
            "settings": { "foreground": "#800080" }
        }
    ]
}
