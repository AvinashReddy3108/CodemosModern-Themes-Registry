{
    "name": "celeste-night",
    "$schema": "vscode://schemas/color-theme",
    "type": "dark",
    "colors": {
        "activityBar.background": "#360035",
        "activityBar.foreground": "#c0c0c0",
        "editor.background": "#360035",
        "editor.foreground": "#87d7ff",
        "editor.lineHighlightBackground": "#333",
        "editor.selectionBackground": "#ff4d97",
        "editorCursor.foreground": "#ff4d97",
        "editorWhitespace.foreground": "#c8c8c8",
        "sideBar.background": "#360035",
        "sideBar.foreground": "#c8c8c8",
        "editorIndentGuide.activeBackground": "#f6f6f6",
        "editorIndentGuide.background": "#888888"
    },
    "tokenColors": [
        { "scope": "comment", "settings": { "foreground": "#888888" } },
        { "scope": "string", "settings": { "foreground": "#87d7ff" } },
        {
            "scope": "constant.numeric",
            "settings": { "foreground": "#E46767" }
        },
        { "scope": "variable", "settings": { "foreground": "#c39dff" } },
        { "scope": "keyword", "settings": { "foreground": "#63f0d8" } },
        { "scope": "entity.name", "settings": { "foreground": "#ffee9b" } },
        { "scope": "storage", "settings": { "foreground": "#63f0d8" } },
        {
            "scope": "text.html.derivative, variable.language.this.ts, variable.other.object.ts",
            "settings": { "foreground": "#ffee9b" }
        },
        {
            "scope": "variable.parameter.ts",
            "settings": { "foreground": "#86ff9a" }
        },
        { "scope": "storage.type", "settings": { "foreground": "#c39dff" } },
        {
            "scope": "entity.name.function",
            "settings": { "foreground": "#63f0d8" }
        },
        {
            "scope": "variable.parameter",
            "settings": { "foreground": "#63f0d8" }
        },
        {
            "scope": "entity.name.tag, punctuation.definition.tag.begin.html, punctuation.definition.tag.end.html",
            "settings": { "foreground": "#ffa8f0", "fontStyle": "" }
        },
        {
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#86ff9a" }
        },
        {
            "scope": "support.function",
            "settings": { "foreground": "#ffa8f0" }
        },
        {
            "scope": "support.type, support.class, support.constant",
            "settings": { "foreground": "#c39dff" }
        },
        { "scope": "invalid", "settings": { "foreground": "#2E1536" } },
        {
            "scope": "invalid.deprecated",
            "settings": { "foreground": "#F8F8F0" }
        },
        {
            "scope": "token.info-token",
            "settings": { "foreground": "#316BCD" }
        },
        {
            "scope": "token.warn-token",
            "settings": { "foreground": "#CD9731" }
        },
        {
            "scope": "token.error-token",
            "settings": { "foreground": "#CD3131" }
        },
        {
            "scope": "token.debug-token",
            "settings": { "foreground": "#800080" }
        }
    ]
}
