{
    "name": "Cream Comfort Light",
    "type": "light",
    "colors": {
        "editor.background": "#fbf8f5",
        "editor.foreground": "#5d4037",
        "editorCursor.foreground": "#8d6e63",
        "editor.lineHighlightBackground": "#f5e9e4",
        "editor.selectionBackground": "#e3d8c660",
        "statusBar.background": "#eee6e1",
        "sideBar.background": "#f5efe9",
        "focusBorder": "#c4b5a8",
        "foreground": "#5d4037",
        "descriptionForeground": "#7a685d",
        "errorForeground": "#b34d4a",
        "warningForeground": "#a8814e",
        "infoForeground": "#6a8c8c",
        "textLink.foreground": "#8d6e63",
        "button.background": "#d7ccc820",
        "editor.selectionHighlightBackground": "#e3d8c640"
    },
    "tokenColors": [
        {
            "scope": "comment",
            "settings": { "foreground": "#9e8e82", "fontStyle": "italic" }
        },
        { "scope": "punctuation", "settings": { "foreground": "#7a685d" } },
        { "scope": "delimiter", "settings": { "foreground": "#8d6e63" } },
        { "scope": "variable", "settings": { "foreground": "#5d4037" } },
        {
            "scope": "variable.parameter",
            "settings": { "foreground": "#6d4c41", "fontStyle": "italic" }
        },
        {
            "scope": "variable.other.property",
            "settings": { "foreground": "#7a5c4b" }
        },
        {
            "scope": "entity.name.function",
            "settings": { "foreground": "#8d6e63", "fontStyle": "bold" }
        },
        {
            "scope": "support.function",
            "settings": { "foreground": "#6a8c8c" }
        },
        {
            "scope": "keyword",
            "settings": { "foreground": "#7a5c4b", "fontStyle": "bold" }
        },
        { "scope": "keyword.control", "settings": { "foreground": "#8d6e63" } },
        { "scope": "storage", "settings": { "foreground": "#9c6e34" } },
        {
            "scope": "entity.name.type",
            "settings": { "foreground": "#6d4c41", "fontStyle": "italic" }
        },
        { "scope": "support.type", "settings": { "foreground": "#8d6e63" } },
        { "scope": "string", "settings": { "foreground": "#6d4c41" } },
        {
            "scope": "string.quoted.single",
            "settings": { "foreground": "#7a5c4b" }
        },
        { "scope": "string.regexp", "settings": { "foreground": "#a8814e" } },
        {
            "scope": "constant.numeric",
            "settings": { "foreground": "#9e8e82" }
        },
        {
            "scope": "constant.language",
            "settings": { "foreground": "#8d6e63" }
        },
        {
            "scope": "constant.character.escape",
            "settings": { "foreground": "#a8814e" }
        },
        {
            "scope": "entity.name.class",
            "settings": { "foreground": "#5d4037", "fontStyle": "bold" }
        },
        {
            "scope": "entity.other.inherited-class",
            "settings": { "foreground": "#6d4c41" }
        },
        {
            "scope": "entity.name.tag",
            "settings": { "foreground": "#7a5c4b", "fontStyle": "bold" }
        },
        {
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#8d6e63" }
        },
        { "scope": "meta.import", "settings": { "foreground": "#6a8c8c" } },
        {
            "scope": "markup.heading",
            "settings": { "foreground": "#5d4037", "fontStyle": "bold" }
        },
        { "scope": "markup.list", "settings": { "foreground": "#8d6e63" } }
    ],
    "$schema": "vscode://schemas/color-theme"
}
