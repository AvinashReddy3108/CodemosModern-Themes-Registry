        "list.inactiveSelectionBackground": "#2A2A2A",
        "list.inactiveSelectionForeground": "#D4D4D4",
        "list.hoverBackground": "#2A2A2A",
        "list.hoverForeground": "#D4D4D4",
        "list.focusBackground": "#3A3A3A",
        "list.highlightForeground": "#F9386A",
        "statusBar.background": "#252525",
        "statusBar.foreground": "#A0A0A0",
        "statusBar.border": "#2E2E2E",
        "statusBar.noFolderBackground": "#252525",
        "statusBar.debuggingBackground": "#252525",
        "statusBarItem.hoverBackground": "#3A3A3A",
        "titleBar.activeBackground": "#252525",
        "titleBar.activeForeground": "#D4D4D4",
        "titleBar.inactiveBackground": "#1F1F1F",
        "titleBar.inactiveForeground": "#858585",
        "titleBar.border": "#2E2E2E",
        "tab.activeBackground": "#1A1A1A",
        "tab.activeForeground": "#ECECEC",
        "tab.activeBorderTop": "#F9386A",
        "tab.activeBorder": "#1A1A1A",
        "tab.inactiveBackground": "#252525",
        "tab.inactiveForeground": "#858585",
        "tab.border": "#2E2E2E",
        "tab.hoverBackground": "#2A2A2A",
        "tab.unfocusedActiveBackground": "#1A1A1A",
        "tab.unfocusedActiveBorderTop": "#2E2E2E",
        "editorGroupHeader.tabsBackground": "#1F1F1F",
        "editorGroupHeader.tabsBorder": "#2E2E2E",
        "editorGroupHeader.noTabsBackground": "#1F1F1F",
        "panelTitle.activeForeground": "#D4D4D4",
        "panelTitle.activeBorder": "#F9386A",
        "panelTitle.inactiveForeground": "#858585",
        "panel.background": "#1F1F1F",
        "panel.border": "#2E2E2E",
        "terminal.background": "#1A1A1A",
        "terminal.foreground": "#D4D4D4",
        "terminal.ansiBrightBlack": "#858585",
        "terminal.ansiBrightWhite": "#ECECEC",
        "terminal.ansiBlack": "#1A1A1A",
        "terminal.ansiWhite": "#D4D4D4",
        "terminal.ansiRed": "#E06C75",
        "terminal.ansiGreen": "#98C379",
        "terminal.ansiYellow": "#E5C07B",
        "terminal.ansiBlue": "#61AFEF",
        "terminal.ansiMagenta": "#F9386A",
        "terminal.ansiCyan": "#00B3B8",
        "terminal.ansiBrightRed": "#E06C75",
        "terminal.ansiBrightGreen": "#98C379",
        "terminal.ansiBrightYellow": "#E5C07B",
        "terminal.ansiBrightBlue": "#61AFEF",
        "terminal.ansiBrightMagenta": "#F9386A",
        "terminal.ansiBrightCyan": "#00B3B8",
        "terminal.selectionBackground": "#3A3A3A",
        "terminalCursor.foreground": "#F9386A",
        "input.background": "#1F1F1F",
        "input.foreground": "#D4D4D4",
        "input.border": "#3A3A3A",
        "input.placeholderForeground": "#858585",
        "inputOption.activeBackground": "#3A3A3A",
        "inputOption.activeBorder": "#F9386A",
        "inputValidation.errorBackground": "#1A1A1A",
        "inputValidation.errorBorder": "#E06C75",
        "inputValidation.warningBackground": "#1A1A1A",
        "inputValidation.warningBorder": "#E5C07B",
        "dropdown.background": "#1F1F1F",
        "dropdown.foreground": "#D4D4D4",
        "dropdown.border": "#3A3A3A",
        "button.background": "#F9386A",
        "button.foreground": "#ECECEC",
        "button.hoverBackground": "#FF4F7E",
        "button.secondaryBackground": "#3A3A3A",
        "button.secondaryForeground": "#D4D4D4",
        "badge.background": "#F9386A",
        "badge.foreground": "#ECECEC",
        "scrollbar.shadow": "#00000040",
        "scrollbarSlider.background": "#3A3A3A80",
        "scrollbarSlider.hoverBackground": "#3A3A3A",
        "scrollbarSlider.activeBackground": "#A0A0A080",
        "progressBar.background": "#F9386A",
        "focusBorder": "#F9386A",
        "selection.background": "#3A3A3A",
        "widget.shadow": "#00000060",
        "notifications.background": "#252525",
        "notifications.foreground": "#D4D4D4",
        "notifications.border": "#2E2E2E",
        "notificationLink.foreground": "#00B3B8",
        "extensionButton.prominentBackground": "#F9386A",
        "extensionButton.prominentForeground": "#ECECEC",
        "extensionButton.prominentHoverBackground": "#FF4F7E",
        "peekView.border": "#3A3A3A",
        "peekViewEditor.background": "#141414",
        "peekViewEditor.matchHighlightBackground": "#F99F1C30",
        "peekViewResult.background": "#1F1F1F",
        "peekViewResult.fileForeground": "#D4D4D4",
        "peekViewResult.lineForeground": "#A0A0A0",
        "peekViewResult.matchHighlightBackground": "#F99F1C30",
        "peekViewResult.selectionBackground": "#3A3A3A",
        "peekViewResult.selectionForeground": "#ECECEC",
        "peekViewTitle.background": "#252525",
        "peekViewTitleDescription.foreground": "#A0A0A0",
        "peekViewTitleLabel.foreground": "#ECECEC",
        "merge.currentHeaderBackground": "#98C37930",
        "merge.currentContentBackground": "#98C37910",
        "merge.incomingHeaderBackground": "#61AFEF30",
        "merge.incomingContentBackground": "#61AFEF10",
        "merge.border": "#3A3A3A",
        "gitDecoration.addedResourceForeground": "#98C379",
        "gitDecoration.modifiedResourceForeground": "#E5C07B",
        "gitDecoration.deletedResourceForeground": "#E06C75",
        "gitDecoration.untrackedResourceForeground": "#98C379",
        "gitDecoration.ignoredResourceForeground": "#858585",
        "gitDecoration.conflictingResourceForeground": "#E5C07B",
        "breadcrumb.foreground": "#858585",
        "breadcrumb.focusForeground": "#D4D4D4",
        "breadcrumb.activeSelectionForeground": "#ECECEC",
        "breadcrumbPicker.background": "#1F1F1F",
        "symbolIcon.classForeground": "#00B3B8",
        "symbolIcon.colorForeground": "#F99F1C",
        "symbolIcon.constantForeground": "#F99F1C",
        "symbolIcon.constructorForeground": "#00B3B8",
        "symbolIcon.enumeratorForeground": "#F99F1C",
        "symbolIcon.enumeratorMemberForeground": "#F99F1C",
        "symbolIcon.eventForeground": "#F9386A",
        "symbolIcon.fieldForeground": "#00B3B8",
        "symbolIcon.fileForeground": "#D4D4D4",
        "symbolIcon.folderForeground": "#D4D4D4",
        "symbolIcon.functionForeground": "#00B3B8",
        "symbolIcon.interfaceForeground": "#00B3B8",
        "symbolIcon.keyForeground": "#F9386A",
        "symbolIcon.keywordForeground": "#F9386A",
        "symbolIcon.methodForeground": "#00B3B8",
        "symbolIcon.moduleForeground": "#00B3B8",
        "symbolIcon.namespaceForeground": "#00B3B8",
        "symbolIcon.nullForeground": "#F99F1C",
        "symbolIcon.numberForeground": "#F99F1C",
        "symbolIcon.objectForeground": "#00B3B8",
        "symbolIcon.operatorForeground": "#A0A0A0",
        "symbolIcon.packageForeground": "#00B3B8",
        "symbolIcon.propertyForeground": "#00B3B8",
        "symbolIcon.referenceForeground": "#00B3B8",
        "symbolIcon.snippetForeground": "#F99F1C",
        "symbolIcon.stringForeground": "#C8E6A0",
        "symbolIcon.structForeground": "#00B3B8",
        "symbolIcon.textForeground": "#D4D4D4",
        "symbolIcon.typeParameterForeground": "#00B3B8",
        "symbolIcon.unitForeground": "#F99F1C",
        "symbolIcon.variableForeground": "#F99F1C"
    },
    "semanticTokenColors": {
        "namespace": "#00B3B8",
        "type": "#00B3B8",
        "class": "#00B3B8",
        "enum": "#F99F1C",
        "interface": "#00B3B8",
        "struct": "#00B3B8",
        "typeParameter": "#00B3B8",
        "parameter": { "foreground": "#FFB347", "fontStyle": "italic" },
        "variable": "#F99F1C",
        "property": "#00B3B8",
        "enumMember": "#F99F1C",
        "decorator": "#F99F1C",
        "event": "#F9386A",
        "function": "#00B3B8",
        "method": "#00B3B8",
        "macro": "#F9386A",
        "label": "#F99F1C",
        "comment": { "foreground": "#858585", "fontStyle": "italic" },
        "string": "#C8E6A0",
        "keyword": "#F9386A",
        "number": "#F99F1C",
        "regexp": "#F99F1C",
        "operator": "#A0A0A0",
        "modifier": "#F9386A",
        "selfKeyword": { "foreground": "#F9386A", "fontStyle": "italic" },
        "builtinType": "#00B3B8",
        "lifetime": "#F99F1C",
        "variable.readonly": "#F99F1C",
        "variable.defaultLibrary": "#00B3B8",
        "function.defaultLibrary": "#00B3B8",
        "method.defaultLibrary": "#00B3B8",
        "property.readonly": "#00B3B8",
        "class.declaration": "#00B3B8",
        "function.declaration": "#00B3B8",
        "method.declaration": "#00B3B8"
    },
    "tokenColors": [
        {
            "name": "Comment",
            "scope": [
                "comment",
                "comment.line",
                "comment.block",
                "punctuation.definition.comment"
            ],
            "settings": { "foreground": "#858585", "fontStyle": "italic" }
        },
        {
            "name": "Doc Comment",
            "scope": [
                "comment.block.documentation",
                "comment.line.double-slash.documentation",
                "source.go comment.block.documentation",
                "source.rust comment.block.documentation",
                "string.quoted.docstring"
            ],
            "settings": { "foreground": "#9AA88A", "fontStyle": "italic" }
        },
        {
            "name": "JSDoc Tags",
            "scope": [
                "storage.type.class.jsdoc",
                "punctuation.definition.block.tag.jsdoc",
                "entity.name.type.instance.jsdoc"
            ],
            "settings": { "foreground": "#9AA88A", "fontStyle": "italic" }
        },
        {
            "name": "String",
            "scope": [
                "string",
                "string.quoted.single",
                "string.quoted.double",
                "string.quoted.triple",
                "string.quoted.backtick",
                "string.template",
                "string.unquoted"
            ],
            "settings": { "foreground": "#C8E6A0" }
        },
        {
            "name": "String Escape / Regex",
            "scope": [
                "constant.character.escape",
                "constant.character.entity",
                "string.regexp",
                "constant.other.character-class.regexp",
                "punctuation.definition.string.regexp",
                "keyword.operator.quantifier.regexp",
                "meta.assertion.regexp",
                "keyword.other.back-reference.regexp"
            ],
            "settings": { "foreground": "#F99F1C" }
        },
        {
            "name": "Template Expression Punctuation",
            "scope": [
                "punctuation.definition.template-expression",
                "punctuation.section.embedded"
            ],
            "settings": { "foreground": "#F9386A" }
        },
        {
            "name": "Number",
            "scope": [
                "constant.numeric",
                "constant.numeric.integer",
                "constant.numeric.float",
                "constant.numeric.hex",
                "constant.numeric.octal",
                "constant.numeric.binary",
                "constant.numeric.decimal"
            ],
            "settings": { "foreground": "#F99F1C" }
        },
        {
            "name": "Boolean / Null / Undefined",
            "scope": [
                "constant.language.boolean",
                "constant.language.null",
                "constant.language.undefined",
                "constant.language.nil",
                "constant.language.none",
                "constant.language.true",
                "constant.language.false"
            ],
            "settings": { "foreground": "#F99F1C" }
        },
        {
            "name": "Built-in Constant",
            "scope": [
                "constant.language",
                "support.constant",
                "variable.language.null",
                "variable.language.undefined",
                "variable.language.nan"
            ],
            "settings": { "foreground": "#F99F1C" }
        },
        {
            "name": "Keyword",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.control.flow",
                "keyword.control.import",
                "keyword.control.from",
                "keyword.control.as",
                "keyword.control.conditional",
                "keyword.control.loop",
                "keyword.control.return",
                "keyword.control.break",
                "keyword.control.continue",
                "keyword.control.exception",
                "keyword.control.try",
                "keyword.control.catch",
                "keyword.control.finally",
                "keyword.control.throw",
                "keyword.control.raise",
                "keyword.control.yield",
                "keyword.control.async",
                "keyword.control.await",
                "keyword.control.match",
                "keyword.control.case",
                "keyword.control.switch",
                "keyword.control.new",
                "keyword.control.delete",
                "keyword.control.typeof",
                "keyword.control.instanceof",
                "keyword.control.in",
                "keyword.control.of",
                "keyword.other",
                "keyword.other.unit",
                "keyword.other.important"
            ],
            "settings": { "foreground": "#F9386A" }
        },
        {
            "name": "Storage / Declaration Keywords",
            "scope": [
                "storage.type",
                "storage.modifier",
                "keyword.declaration",
                "keyword.declaration.function",
                "keyword.declaration.class",
                "keyword.declaration.interface",
                "keyword.declaration.enum",
                "keyword.declaration.struct",
                "keyword.declaration.var",
                "keyword.declaration.let",
                "keyword.declaration.const",
                "keyword.declaration.type",
                "keyword.declaration.import",
                "keyword.declaration.export",
                "keyword.declaration.default",
                "keyword.declaration.extends",
                "keyword.declaration.implements"
            ],
            "settings": { "foreground": "#F9386A" }
        },
        {
            "name": "Operator",
            "scope": [
                "keyword.operator",
                "keyword.operator.arithmetic",
                "keyword.operator.assignment",
                "keyword.operator.comparison",
                "keyword.operator.logical",
                "keyword.operator.bitwise",
                "keyword.operator.ternary",
                "keyword.operator.spread",
                "keyword.operator.rest",
                "keyword.operator.optional",
                "keyword.operator.type",
                "punctuation.separator.key-value"
            ],
            "settings": { "foreground": "#A0A0A0" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation",
                "punctuation.terminator",
                "punctuation.separator",
                "punctuation.accessor",
                "meta.brace.round",
                "meta.brace.square",
                "meta.brace.curly",
                "punctuation.definition.block",
                "punctuation.definition.parameters",
                "punctuation.definition.array",
                "punctuation.definition.binding-pattern"
            ],
            "settings": { "foreground": "#A0A0A0" }
        },
        {
            "name": "Function Name (Definition)",
            "scope": [
                "entity.name.function",
                "meta.function entity.name.function",
                "meta.definition.method entity.name.function"
            ],
            "settings": { "foreground": "#00B3B8" }
        },
        {
            "name": "Function Call",
            "scope": [
                "meta.function-call entity.name.function",
                "meta.function-call.generic entity.name.function",
                "support.function"
            ],
            "settings": { "foreground": "#00B3B8" }
        },
        {
            "name": "Method Name",
            "scope": [
                "entity.name.function.member",
                "meta.method-call entity.name.function",
                "support.function.method"
            ],
            "settings": { "foreground": "#00B3B8" }
        },
        {
            "name": "Class / Type Name",
            "scope": [
                "entity.name.class",
                "entity.name.type",
                "entity.name.type.class",
                "entity.name.type.interface",
                "entity.name.type.struct",
                "entity.name.type.enum",
                "entity.name.type.alias",
                "entity.name.type.primitive",
                "entity.name.type.namespace",
                "support.class",
                "support.type"
            ],
            "settings": { "foreground": "#00B3B8" }
        },
        {
            "name": "Inherited / Implemented Type",
            "scope": [
                "entity.other.inherited-class",
                "meta.class entity.other.inherited-class"
            ],
            "settings": { "foreground": "#00B3B8" }
        },
        {
            "name": "Variable",
            "scope": [
                "variable",
                "variable.other",
                "variable.other.readwrite",
                "variable.other.object",
                "variable.other.assignment"
            ],
            "settings": { "foreground": "#F99F1C" }
        },
        {
            "name": "Parameter",
            "scope": [
                "variable.parameter",
                "meta.function.parameters variable.other",
                "meta.function.parameter variable",
                "meta.parameter variable"
            ],
            "settings": { "foreground": "#FFB347", "fontStyle": "italic" }
        },
        {
            "name": "Property / Field",
            "scope": [
                "variable.other.property",
                "variable.other.object.property",
                "support.variable.property",
                "entity.name.variable.field",
                "meta.object-literal.key"
            ],
            "settings": { "foreground": "#00B3B8" }
        },
        {
            "name": "Self / This / Super",
            "scope": [
                "variable.language.this",
                "variable.language.self",
                "variable.language.super",
                "variable.language.special.self",
                "variable.language.special.cls"
            ],
            "settings": { "foreground": "#F9386A", "fontStyle": "italic" }
        },
        {
            "name": "Constant / Enum Member",
            "scope": [
                "variable.other.constant",
                "entity.name.constant",
                "variable.other.enummember",
                "support.constant.math",
                "support.constant.property-value"
            ],
            "settings": { "foreground": "#F99F1C" }
        },
        {
            "name": "Decorator / Annotation",
            "scope": [
                "entity.name.function.decorator",
                "meta.decorator",
                "punctuation.decorator",
                "entity.name.type.annotation",
                "meta.annotation",
                "storage.type.annotation"
            ],
            "settings": { "foreground": "#F99F1C" }
        },
        {
            "name": "HTML / JSX Tag Name",
            "scope": [
                "entity.name.tag",
                "meta.tag entity.name.tag",
                "support.class.component"
            ],
            "settings": { "foreground": "#F9386A" }
        },
        {
            "name": "HTML / JSX Tag Attribute",
            "scope": [
                "entity.other.attribute-name",
                "meta.tag entity.other.attribute-name"
            ],
            "settings": { "foreground": "#00B3B8" }
        },
        {
            "name": "HTML/XML Punctuation",
            "scope": [
                "punctuation.definition.tag",
                "punctuation.definition.tag.begin",
                "punctuation.definition.tag.end",
                "meta.tag punctuation"
            ],
            "settings": { "foreground": "#A0A0A0" }
        },
        {
            "name": "CSS Property Name",
            "scope": [
                "support.type.property-name.css",
                "support.type.property-name.scss",
                "support.type.property-name.less",
                "entity.name.tag.css",
                "meta.property-name"
            ],
            "settings": { "foreground": "#00B3B8" }
        },
        {
            "name": "CSS Property Value / Unit",
            "scope": [
                "support.constant.property-value.css",
                "constant.numeric.css",
                "keyword.other.unit.css",
                "meta.property-value"
            ],
            "settings": { "foreground": "#F99F1C" }
        },
        {
            "name": "CSS Selector",
            "scope": [
                "entity.other.attribute-name.css",
                "entity.other.attribute-name.id.css",
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.pseudo-class.css",
                "entity.other.attribute-name.pseudo-element.css"
            ],
            "settings": { "foreground": "#F99F1C" }
        },
        {
            "name": "CSS At-Rule",
            "scope": [
                "keyword.control.at-rule.css",
                "keyword.control.at-rule.scss",
                "keyword.control.at-rule.media.css",
                "keyword.control.at-rule.keyframes.css"
            ],
            "settings": { "foreground": "#F9386A" }
        },
        {
            "name": "SCSS Variable",
            "scope": [
                "variable.scss",
                "variable.other.scss",
                "variable.other.less"
            ],
            "settings": { "foreground": "#FFB347", "fontStyle": "italic" }
        },
        {
            "name": "Markdown Heading",
            "scope": [
                "markup.heading",
                "entity.name.section.markdown",
                "punctuation.definition.heading.markdown",
                "markup.heading punctuation.definition.heading"
            ],
            "settings": { "foreground": "#F9386A", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Bold",
            "scope": ["markup.bold", "punctuation.definition.bold"],
