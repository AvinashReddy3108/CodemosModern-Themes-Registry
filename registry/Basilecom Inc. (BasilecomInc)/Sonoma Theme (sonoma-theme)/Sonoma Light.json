{
    "name": "Sonoma Light",
    "type": "light",
    "colors": {
        "editor.background": "#F5F5F5",
        "editor.foreground": "#000000",
        "editorCursor.foreground": "#000000",
        "editorWhitespace.foreground": "#CCCCCC",
        "editor.selectionBackground": "#E1E1E1",
        "editor.lineHighlightBackground": "#F0F0F0",
        "editorSuggestWidget.background": "#FFFFFF",
        "editorSuggestWidget.selectedBackground": "#E1E1E1",
        "list.activeSelectionBackground": "#E1E1E1",
        "list.hoverBackground": "#F0F0F0",
        "titleBar.activeBackground": "#FFFFFF",
        "titleBar.activeForeground": "#000000",
        "statusBar.background": "#FFFFFF",
        "statusBar.foreground": "#000000",
        "tab.activeBackground": "#FFFFFF",
        "tab.inactiveBackground": "#F5F5F5",
        "tab.activeBorder": "#007AFF"
    },
    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#008000" }
        },
        {
            "name": "Strings",
            "scope": ["string", "punctuation.definition.string"],
            "settings": { "foreground": "#C41A16" }
        },
        {
            "name": "Keywords",
            "scope": ["keyword", "storage.type"],
            "settings": { "foreground": "#AA0D91" }
        },
        {
            "name": "Numbers",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#1C00CF" }
        },
        {
            "name": "Types",
            "scope": ["support.type"],
            "settings": { "foreground": "#007AFF" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
