        "settings.headerForeground": "#400000",
        "settings.modifiedItemIndicator": "#400000",
        "settings.numberInputBackground": "#800000",
        "settings.numberInputForeground": "#E00000",
        "settings.textInputBackground": "#800000",
        "settings.textInputForeground": "#E00000",
