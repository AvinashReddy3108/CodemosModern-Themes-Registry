        "panelTitle.activeBorder": "#400000",
        "panelTitle.activeForeground": "#FF0000",
        "panelTitle.inactiveForeground": "#E00000",
        "peekView.border": "#80000030",
        "peekViewEditor.background": "#E0000005",
        "peekViewEditor.matchHighlightBackground": "#40000050",
