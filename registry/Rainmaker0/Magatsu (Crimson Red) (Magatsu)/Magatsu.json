        "statusBar.foreground": "#FF0000",
        "statusBar.noFolderBackground": "#4E0000",
        "statusBarItem.hoverBackground": "#4E000020",
        "statusBarItem.remoteBackground": "#4E0000",
        "statusBarItem.remoteForeground": "#FF0000",
