        "minimapSlider.activeBackground": "#600000b0",
        "minimapSlider.background": "#60000080",
        "minimapSlider.hoverBackground": "#600000a0",
        "notificationLink.foreground": "#400000",
        "notifications.background": "#800000",
        "notifications.foreground": "#E00000",
        "panel.background": "#800000",
