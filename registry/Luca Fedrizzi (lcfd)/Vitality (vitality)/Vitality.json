{
    "name": "Vitality",
    "tokenColors": [
        {
            "name": "Global settings",
            "settings": { "background": "#263238", "foreground": "#B2CCD6" }
        },
        {
            "name": "String",
            "scope": "string",
            "settings": { "foreground": "#C3E88D" }
        },
        {
            "name": "Boolean",
            "scope": "constant.language.boolean",
            "settings": { "foreground": "#f77669" }
        },
        {
            "name": "Number",
            "scope": "constant.numeric",
            "settings": { "foreground": "#f77669" }
        },
        {
            "name": "Identifier",
            "scope": "variable, support.variable, support.class, support.constant, meta.definition.variable entity.name.function",
            "settings": { "foreground": "#FA6981" }
        },
        {
            "name": "Keyword",
            "scope": "keyword, modifier, variable.language.this, support.type.object, constant.language",
            "settings": { "foreground": "#82AAFF" }
        },
        {
            "name": "Constant",
            "scope": "entity.name.type.constant",
            "settings": { "foreground": "#82AAFF", "fontStyle": "italic" }
        },
        {
            "name": "Function call",
            "scope": "entity.name.function, support.function",
            "settings": { "foreground": "#82B1FF" }
        },
        {
            "name": "Storage",
            "scope": "storage.type, storage.modifier",
            "settings": { "foreground": "#FFD54F" }
        },
        {
            "name": "Modules",
            "scope": "support.module, support.node",
            "settings": { "foreground": "#82AAFF" }
        },
        {
            "name": "Type",
            "scope": "support.type",
            "settings": { "foreground": "#7FCAC3" }
        },
        {
            "name": "Type",
            "scope": "entity.name.type, entity.other.inherited-class",
            "settings": { "foreground": "#FFD54F" }
        },
        {
            "name": "Comment",
            "scope": "comment",
            "settings": { "foreground": "#405561" }
        },
        {
            "name": "Class",
            "scope": "entity.name.type.class",
            "settings": { "foreground": "#FFD54F" }
        },
        {
            "name": "Class variable",
            "scope": "variable.object.property",
            "settings": { "foreground": "#C3E88D" }
        },
        {
            "name": "Class method",
            "scope": "meta.definition.method entity.name.function",
            "settings": { "foreground": "#FFD54F" }
        },
        {
            "name": "Function definition",
            "scope": "meta.function entity.name.function",
            "settings": { "foreground": "#BD8BDF" }
        },
        {
            "name": "Template expression",
            "scope": "template.expression.begin, template.expression.end",
            "settings": { "foreground": "#C3E88D" }
        },
        {
            "name": "JSON key",
            "scope": "meta.object-literal.key, meta.object-literal.key string, support.type.property-name.json",
            "settings": { "foreground": "#7FCAC3" }
        },
        {
            "name": "JSON constant",
            "scope": "constant.language.json",
            "settings": { "foreground": "#C3E88D" }
        },
        {
            "name": "CSS class",
            "scope": "entity.other.attribute-name.class.css",
            "settings": { "foreground": "#FFD54F", "fontStyle": "normal" }
        },
        {
            "name": "CSS ID",
            "scope": "entity.other.attribute-name.id",
            "settings": { "foreground": "#FFD54F" }
        },
        {
            "name": "CSS tag",
            "scope": "source.css entity.name.tag",
            "settings": { "foreground": "#FA6981" }
        },
        {
            "name": "HTML tag outer",
            "scope": "meta.tag, punctuation.definition.tag",
            "settings": { "foreground": "#B2CCD6" }
        },
        {
            "name": "HTML tag inner",
            "scope": "entity.name.tag",
            "settings": { "foreground": "#FA6981" }
        },
        {
            "name": "Markdown heading",
            "scope": "markup.heading",
            "settings": { "foreground": "#B2CCD6" }
        },
        {
            "name": "Markdown link text",
            "scope": "text.html.markdown meta.link.inline, meta.link.reference",
            "settings": { "foreground": "#B2CCD6" }
        },
        {
            "name": "Markdown block quote",
            "scope": "text.html.markdown markup.quote",
            "settings": { "foreground": "#FFD54F" }
        },
        {
            "name": "Markdown list item",
            "scope": "text.html.markdown beginning.punctuation.definition.list",
            "settings": { "foreground": "#C3E88D" }
        },
        {
            "name": "Markdown italic",
            "scope": "markup.italic",
            "settings": { "foreground": "#C3E88D", "fontStyle": "italic" }
        },
        {
            "name": "Markdown bold",
            "scope": "markup.bold",
            "settings": { "foreground": "#C3E88D", "fontStyle": "bold" }
        },
        {
            "name": "Markdown bold italic",
            "scope": "markup.bold markup.italic, markup.italic markup.bold",
            "settings": { "foreground": "#C3E88D", "fontStyle": "italic bold" }
        },
        {
            "name": "Import and from keyword",
            "scope": "keyword.control.import.js, keyword.control.from.js",
            "settings": { "fontStyle": "underline" }
        },
        {
            "name": "Strings",
            "scope": "string.quoted.double.js, string.quoted.single.js, string.template.js",
            "settings": { "foreground": "#C6FF00" }
        },
        {
            "name": "Storage",
            "scope": "storage.type.js",
            "settings": { "foreground": "#FFD54F", "fontStyle": "italic" }
        },
        {
            "name": "This",
            "scope": "variable.language.this.js",
            "settings": { "foreground": "#FFD54F", "fontStyle": "italic" }
        },
        {
            "name": "Arrow function ligature",
            "scope": "storage.type.function.arrow.js",
            "settings": { "foreground": "#B388FF", "fontStyle": "italic" }
        },
        {
            "name": "Class keyword",
            "scope": "storage.type.class.js",
            "settings": { "foreground": "#FFD54F", "fontStyle": "italic" }
        },
        {
            "name": "Function names",
            "scope": "entity.name.function.js",
            "settings": { "foreground": "#82B1FF" }
        },
        {
            "name": "Conditional keywords",
            "scope": "keyword.control.conditional.js",
            "settings": { "foreground": "#B388FF" }
        },
        {
            "name": "Class methods",
            "scope": "entity.name.function.js",
            "settings": { "foreground": "#82B1FF" }
        },
        {
            "name": "Comparison ligatures",
            "scope": "keyword.operator.comparison.js",
            "settings": { "foreground": "#B388FF" }
        },
        {
            "name": "Logical operator",
            "scope": "keyword.operator.logical.js, keyword.operator.assignment.js",
            "settings": { "foreground": "#B388FF" }
        },
        {
            "name": "Reserved keywords null, undefined, boolean",
            "scope": "constant.language.null.js, constant.language.undefined.js, constant.language.boolean.false.js,  constant.language.boolean.true.js",
            "settings": { "fontStyle": "italic", "foreground": "#82B1FF" }
        },
        {
            "name": "extends keyword",
            "scope": "storage.modifier.js",
            "settings": { "foreground": "#B388FF", "fontStyle": "italic" }
        },
        {
            "name": "extends keyword",
            "scope": "entity.other.inherited-class.js",
            "settings": { "foreground": "#B388FF" }
        },
        {
            "name": "Component attributes",
            "scope": "entity.other.attribute-name.js",
            "settings": { "foreground": "#FFD54F", "fontStyle": "italic" }
        },
        {
            "name": "Tags attributes",
            "scope": "entity.other.attribute-name.html",
            "settings": { "foreground": "#FFD54F", "fontStyle": "italic" }
        },
        {
            "name": "Tags property values",
            "scope": "string.quoted.double.html",
            "settings": { "foreground": "#C6FF00" }
        },
        {
            "name": "Pseudo classes",
            "scope": "entity.other.attribute-name.pseudo-class.css",
            "settings": { "foreground": "#FFD54F", "fontStyle": "italic" }
        },
        {
            "name": "Separators in css",
            "scope": "punctuation.definition.entity.css, keyword.operator.combinator.css, punctuation.separator.key-value.css",
            "settings": { "foreground": "#B388FF", "fontStyle": "normal" }
        }
    ],
    "colors": {
        "editor.foreground": "#B2CCD6",
        "editor.background": "#263238",
        "input.border": "#212121",
        "input.background": "#212121",
        "scrollbar.shadow": "#263238",
        "scrollbarSlider.background": "#9E9E9E3b",
        "scrollbarSlider.hoverBackground": "#2121217f",
        "scrollbarSlider.activeBackground": "#2121217f",
        "activityBar.background": "#263238",
        "activityBar.foreground": "#607D8B",
        "editorCursor.foreground": "#FFC107",
        "sideBar.background": "#263238",
        "list.hoverBackground": "#263238",
        "list.activeSelectionBackground": "#182328",
        "list.focusBackground": "#182328",
        "list.inactiveSelectionBackground": "#1f292e",
        "editorGroup.background": "#263238",
        "tab.activeBackground": "#455A64",
        "tab.inactiveBackground": "#263238",
        "tab.border": "#263238",
        "editorGroupHeader.tabsBackground": "#263238",
        "editorGroupHeader.noTabsBackground": "#263238",
        "editorLineNumber.foreground": "#455A64",
        "editor.selectionBackground": "#455A64",
        "editor.wordHighlightBackground": "#455A64",
        "editor.wordHighlightStrongBackground": "#455A64",
        "editor.hoverHighlightBackground": "#182328",
        "editorWidget.background": "#182328",
        "editorSuggestWidget.background": "#263238",
        "editorSuggestWidget.border": "#455c67",
        "editorGroup.border": "#182328",
        "panel.border": "#263238",
        "panelTitle.activeBorder": "#263238",
        "panelTitle.inactiveForeground": "#455c67",
        "editor.lineHighlightBackground": "#212121",
        "editor.lineHighlightBorder": "#212121",
        "dropdown.border": "#182328",
        "statusBar.background": "#607D8B",
        "statusBar.foreground": "#E0E0E0",
        "titleBar.activeBackground": "#263238",
        "titleBar.inactiveBackground": "#263238",
        "focusBorder": "#455c67",
        "activityBarBadge.background": "#FFC107",
        "activityBarBadge.foreground": "#263238",
        "button.background": "#455c67",
        "button.hoverBackground": "#263238",
        "terminal.ansiBlack": "#263238",
        "terminal.ansiRed": "#FA6981",
        "terminal.ansiGreen": "#C3E88D",
        "terminal.ansiYellow": "#FFCC00",
        "terminal.ansiBlue": "#82AAFF",
        "terminal.ansiMagenta": "#f77669",
        "terminal.ansiCyan": "#7FCAC3",
        "terminal.ansiWhite": "#B2CCD6",
        "terminal.ansiBrightBlack": "#65737e",
        "terminal.ansiBrightRed": "#bf616a",
        "terminal.ansiBrightGreen": "#a3be8c",
        "terminal.ansiBrightYellow": "#FFCC00",
        "terminal.ansiBrightBlue": "#82AAFF",
        "terminal.ansiBrightMagenta": "#f77669",
        "terminal.ansiBrightCyan": "#7FCAC3",
        "terminal.ansiBrightWhite": "#B2CCD6"
    },
    "$schema": "vscode://schemas/color-theme"
}
