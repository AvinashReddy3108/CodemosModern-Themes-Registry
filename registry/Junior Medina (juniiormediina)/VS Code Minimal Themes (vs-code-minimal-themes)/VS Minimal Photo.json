{
    "$schema": "vscode://schemas/color-theme",
    "name": "VS Minimal Photo",
    "type": "dark",
    "semanticHighlighting": true,
    "colors": {
        "foreground": "#e4e6eb",
        "editor.background": "#121315",
        "editor.foreground": "#e4e6eb",
        "editor.lineHighlightBackground": "#1a1e26",
        "panel.border": "#00000000",
        "sideBar.border": "#00000000",
        "tab.border": "#00000000",
        "statusBar.border": "#00000000",
        "activityBar.border": "#00000000",
        "editorLineNumber.foreground": "#7b7f87",
        "editorLineNumber.activeForeground": "#e4e6eb",
        "editorCursor.foreground": "#34d399",
        "editor.selectionBackground": "#223048E6",
        "editor.inactiveSelectionBackground": "#1c263EE6",
        "editor.selectionHighlightBackground": "#283656E6",
        "editorBracketHighlight.foreground1": "#34d399",
        "editorBracketHighlight.foreground2": "#a78bfa",
        "editorBracketHighlight.foreground3": "#7aa2f7",
        "editorIndentGuide.background1": "#1b2127",
        "editorIndentGuide.activeBackground1": "#242b33",
        "activityBar.background": "#121315",
        "activityBar.foreground": "#e4e6eb",
        "sideBar.background": "#121315",
        "sideBar.foreground": "#e4e6eb",
        "statusBar.background": "#121315",
        "statusBar.foreground": "#e4e6eb",
        "titleBar.activeBackground": "#121315",
        "titleBar.activeForeground": "#e4e6eb",
        "badge.background": "#a78bfa",
        "badge.foreground": "#121315",
        "tab.activeBackground": "#151a21",
        "tab.inactiveBackground": "#0f1318",
        "tab.activeForeground": "#e4e6eb",
        "tab.inactiveForeground": "#7b7f87",
        "editorError.foreground": "#e06c75",
        "editorWarning.foreground": "#f59e0b",
        "editorInfo.foreground": "#7aa2f7",
        "terminal.background": "#121315",
        "terminal.foreground": "#e4e6eb"
    },
    "tokenColors": [
        {
            "name": "Comentarios",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#6b7280", "fontStyle": "italic" }
        },
        {
            "name": "Puntuación y separadores",
            "scope": [
                "punctuation",
                "punctuation.separator",
                "punctuation.terminator",
                "meta.brace"
            ],
            "settings": { "foreground": "#99a1a9" }
        },
        {
            "name": "Strings",
            "scope": [
                "string",
                "string.quoted",
                "string.template",
                "string.interpolated"
            ],
            "settings": { "foreground": "#c9c9d6" }
        },
        {
            "name": "Números y constantes",
            "scope": [
                "constant.numeric",
                "constant.language",
                "constant.character",
                "constant.other"
            ],
            "settings": { "foreground": "#94d9d6" }
        },
        {
            "name": "Keywords",
            "scope": ["keyword", "storage", "storage.type", "keyword.operator"],
            "settings": { "foreground": "#aab0b6" }
        },
        {
            "name": "Funciones",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call",
                "variable.function"
            ],
            "settings": { "foreground": "#34d399" }
        },
        {
            "name": "Tipos y clases",
            "scope": [
                "entity.name.type",
                "support.type",
                "entity.name.class",
                "support.class"
            ],
            "settings": { "foreground": "#7aa2f7" }
        },
        {
            "name": "Interfaces",
            "scope": ["entity.name.type.interface", "support.type.interface"],
            "settings": { "foreground": "#a78bfa" }
        },
        {
            "name": "Decorators y anotaciones",
            "scope": [
                "meta.decorator",
                "meta.annotation",
                "storage.type.annotation"
            ],
            "settings": { "foreground": "#a78bfa" }
        },
        {
            "name": "JSX/TSX etiquetas",
            "scope": [
                "entity.name.tag",
                "meta.tag.js",
                "meta.tag.tsx",
                "meta.jsx",
                "support.class.component"
            ],
            "settings": { "foreground": "#7aa2f7" }
        },
        {
            "name": "Atributos de JSX/HTML",
            "scope": ["entity.other.attribute-name", "meta.tag.attribute"],
            "settings": { "foreground": "#a78bfa" }
        },
        {
            "name": "JSON claves",
            "scope": [
                "support.type.property-name.json",
                "meta.object-literal.key"
            ],
            "settings": { "foreground": "#64ffda" }
        },
        {
            "name": "XML etiquetas y atributos",
            "scope": ["entity.name.tag.xml", "entity.other.attribute-name.xml"],
            "settings": { "foreground": "#7aa2f7" }
        }
    ]
}
