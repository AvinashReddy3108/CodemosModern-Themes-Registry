{
    "$schema": "vscode://schemas/color-theme",
    "type": "dark",
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "axisName": "#87d6d5",
        "function": "#fed6af",
        "attributeName": "#fed6af",
        "attributeNameTest": "#87d6d5",
        "variable": "#87d6d5",
        "nodeNameTest": "#d6d7af",
        "mapNameLookup": "#d6d7af",
        "xmlText": "#f0efd0",
        "elementName": "#cc9393",
        "simpleType": "#ecb3b3",
        "nodeType": "#cc9393",
        "anonymousFunction": "#cc9393"
    },
    "colors": {
        "activityBar.background": "#313633",
        "activityBarBadge.background": "#7f9f7f",
        "activityBarBadge.foreground": "#313633",
        "badge.background": "#7f9f7f",
        "badge.foreground": "#313633",
        "editor.background": "#3f3f3f",
        "editor.foreground": "#dedede",
        "editor.lineHighlightBackground": "#303030",
        "editor.selectionBackground": "#8383839c",
        "editorLineNumber.activeForeground": "#9e8f68",
        "editorCursor.foreground": "#8faf9f",
        "editorGutter.addedBackground": "#87ae86",
        "editorGutter.deletedBackground": "#cc9393",
        "editorGutter.modifiedBackground": "#e7c4a1",
        "editorLineNumber.foreground": "#90907e",
        "editorSuggestWidget.background": "#2c2e2e",
        "editorSuggestWidget.foreground": "#9f9f9f",
        "editorSuggestWidget.highlightForeground": "#dfdfbf",
        "editorSuggestWidget.selectedBackground": "#242424",
        "editorWhitespace.foreground": "#a5a5a552",
        "gitDecoration.addedResourceForeground": "#87ae86",
        "gitDecoration.conflictingResourceForeground": "#cc9393",
        "gitDecoration.deletedResourceForeground": "#cc9393",
        "gitDecoration.ignoredResourceForeground": "#7f9f7f",
        "gitDecoration.modifiedResourceForeground": "#fffb9d",
        "gitDecoration.submoduleResourceForeground": "#fffb9d",
        "gitDecoration.untrackedResourceForeground": "#87ae86",
        "sideBar.background": "#3a3a3a",
        "statusBar.background": "#2e3330",
        "statusBar.foreground": "#87ae86",
        "statusBar.noFolderBackground": "#2e3330",
        "tab.activeForeground": "#dcdccc",
        "tab.inactiveBackground": "#353535",
        "terminal.ansiBlue": "#8cd0d3",
        "terminal.ansiBrightBlue": "#8cd0d3",
        "terminal.ansiBrightCyan": "#8cd0d3",
        "terminal.ansiBrightGreen": "#7f9f7f",
        "terminal.ansiBrightMagenta": "#dca3a3",
        "terminal.ansiBrightRed": "#ecbcbc",
        "terminal.ansiBrightYellow": "#f0dfaf",
        "terminal.ansiCyan": "#8cd0d3",
        "terminal.ansiGreen": "#7f9f7f",
        "terminal.ansiMagenta": "#dca3a3",
        "terminal.ansiRed": "#ecbcbc",
        "terminal.ansiYellow": "#f0dfaf",
        "terminal.foreground": "#dcdccc",
        "terminal.selectionBackground": "#686868aa",
        "editorIndentGuide.activeBackground": "#a5a5a5b2",
        "editorIndentGuide.background": "#a5a5a532"
    },
    "tokenColors": [
        { "scope": "comment", "settings": { "foreground": "#87AE86" } },
        {
            "scope": "meta.preprocessor.c",
            "settings": { "foreground": "#FD8003" }
        },
        {
            "scope": "keyword.other.phpdoc",
            "settings": { "foreground": "#568E4D" }
        },
        {
            "scope": "punctuation.definition.comment, punctuation.whitespace.comment",
            "settings": { "foreground": "#A0CFA1" }
        },
        {
            "scope": "punctuation.section.embedded",
            "settings": { "foreground": "#898989" }
        },
        {
            "scope": "source.ruby.embedded",
            "settings": { "foreground": "#CC9495" }
        },
        {
            "scope": "keyword.other.directive",
            "settings": { "foreground": "#DEDEDE", "fontStyle": "bold" }
        },
        {
            "scope": "keyword.other.directive.line-number",
            "settings": { "fontStyle": "underline" }
        },
        {
            "scope": "constant.character",
            "settings": { "foreground": "#FF8080" }
        },
        {
            "scope": "string, string.unquoted",
            "settings": { "foreground": "#D68686" }
        },
        {
            "scope": "string.unquoted.heredoc",
            "settings": { "foreground": "#D6D6D6" }
        },
        {
            "scope": "constant.numeric",
            "settings": { "foreground": "#87D6D5" }
        },
        {
            "scope": "constant.language, support.constant.core",
            "settings": { "foreground": "#D6D6AE", "fontStyle": "bold" }
        },
        {
            "scope": "constant.character, constant.other, support.constant",
            "settings": { "foreground": "#CC9495" }
        },
        {
            "scope": "keyword, keyword.control , meta.selector.css , entity.other.attribute-name",
            "settings": { "foreground": "#FED6AF" }
        },
        {
            "scope": "entity.name.module,support.other.module",
            "settings": { "foreground": "#FF8000", "fontStyle": "bold" }
        },
        {
            "scope": "keyword.operator",
            "settings": { "foreground": "#ECECEC" }
        },
        {
            "scope": "source.ocaml keyword.operator.symbol.infix.floating-point",
            "settings": { "fontStyle": "underline" }
        },
        {
            "scope": "source.ocaml keyword.operator.symbol.prefix.floating-point",
            "settings": { "fontStyle": "underline" }
        },
        {
            "scope": "storage.type , storage.modifier , support.type",
            "settings": { "foreground": "#FFFB9D" }
        },
        {
            "scope": "entity.name.class.variant",
            "settings": { "foreground": "#4080A0" }
        },
        { "scope": "storage", "settings": {} },
        {
            "scope": "entity.name.type , entity.other",
            "settings": { "foreground": "#D6D6D6" }
        },
        {
            "scope": "entity.other.inherited-class",
            "settings": { "foreground": "#D78D1B" }
        },
        {
            "scope": "storage.type.user-defined , meta.property-list",
            "settings": { "foreground": "#FFE000" }
        },
        {
            "scope": "entity.name.type , entity.name.type.class , entity.other.attribute-name.class.css , support.class",
            "settings": { "foreground": "#F4A020" }
        },
        { "scope": "variable.parameter", "settings": {} },
        {
            "scope": "invalid",
            "settings": {
                "foreground": "#FF5274",
                "fontStyle": "bold italic underline"
            }
        },
        {
            "scope": "entity.other.attribute-name.html",
            "settings": { "foreground": "#D6D7AF", "fontStyle": "bold" }
        },
        { "scope": "entity.name.tag", "settings": { "foreground": "#D6D7AF" } },
        {
            "scope": "punctuation.section.embedded.begin.php,punctuation.section.embedded.end.php",
            "settings": { "foreground": "#898989" }
        },
        {
            "scope": "variable, variable.parameter, variable.other",
            "settings": { "foreground": "#FED6AF" }
        },
        {
            "scope": "support.function.construct",
            "settings": { "foreground": "#FED6AF" }
        },
        {
            "scope": "punctuation.definition.variable",
            "settings": { "foreground": "#FED6AF" }
        },
        {
            "scope": "support.function,meta.function-name,entity.name.function",
            "settings": { "foreground": "#FFFD87" }
        },
        {
            "scope": "support.function",
            "settings": { "foreground": "#C7BA18" }
        },
        { "scope": "meta.brace", "settings": { "foreground": "#78CECC80" } },
        {
            "scope": "punctuation.definition.string.begin,punctuation.definition.string.end",
            "settings": { "foreground": "#D6D6D680" }
        },
        {
            "scope": "punctuation.definition.tag.begin.html,punctuation.definition.tag.end.html,meta.tag.structure.any.html",
            "settings": { "foreground": "#FED5AE94", "fontStyle": "bold" }
        },
        {
            "scope": "entity.name.tag.yaml",
            "settings": { "foreground": "#FED6AF", "fontStyle": "bold" }
        },
        {
            "scope": "punctuation.definition.entry",
            "settings": { "foreground": "#D6D6D6" }
        },
        {
            "scope": "keyword.other.DML.sql, keyword.other.data-integrity.sql",
            "settings": { "foreground": "#B7B7B7", "fontStyle": "bold" }
        },
        {
            "scope": "source.sql, constant.other.database-name.sql, constant.other.table-name.sql, keyword.operator.star",
            "settings": { "foreground": "#95BFF3", "fontStyle": "bold" }
        },
        {
            "scope": "source.diff",
            "settings": { "foreground": "#FFFFFF", "background": "#393939" }
        },
        {
            "scope": "source.diff meta.diff.comment, source.diff meta.toc-list.comment.diff",
            "settings": { "foreground": "#FFFFFF", "background": "#9F9D15" }
        },
        {
            "scope": "meta.diff.header.from-file",
            "settings": {
                "foreground": "#CA7172",
                "background": "#393939",
                "fontStyle": "bold"
            }
        },
        {
            "scope": "meta.diff.header.to-file",
            "settings": {
                "foreground": "#60B38A",
                "background": "#393939",
                "fontStyle": "bold"
            }
        },
        {
            "scope": "meta.diff.range.unified",
            "settings": { "foreground": "#8CD0D3", "background": "#393939" }
        },
        {
            "scope": "markup.inserted.diff",
            "settings": { "foreground": "#60B38A", "background": "#393939" }
        },
        {
            "scope": "markup.deleted.diff",
            "settings": { "foreground": "#CA7172", "background": "#393939" }
        },
        { "scope": "string.regexp", "settings": { "foreground": "#C76F41" } },
        {
            "scope": "string.regexp.arbitrary-repitition",
            "settings": { "foreground": "#9E6A5F" }
        },
        {
            "scope": "punctuation.definition.arbitrary-repitition",
            "settings": { "foreground": "#FFFFFF5E" }
        },
        {
            "scope": "string.regexp.character-class",
            "settings": { "foreground": "#CB8E81" }
        },
        {
            "scope": "punctuation.definition.character-class",
            "settings": { "foreground": "#FFFFFF5E" }
        },
        {
            "scope": "markup.raw.inline.markdown",
            "settings": { "foreground": "#FED6AF" }
        },
        {
            "scope": "markup.heading.markdown,punctuation.definition.heading",
            "settings": { "foreground": "#FFFFFF", "fontStyle": "bold" }
        },
        { "scope": "markup.list", "settings": { "foreground": "#DEDEDE" } },
        {
            "scope": "token.info-token",
            "settings": { "foreground": "#6796E6" }
        },
        {
            "scope": "token.warn-token",
            "settings": { "foreground": "#CD9731" }
        },
        {
            "scope": "token.error-token",
            "settings": { "foreground": "#F44747" }
        },
        {
            "scope": "token.debug-token",
            "settings": { "foreground": "#B267E6" }
        },
        {
            "scope": "keyword.other.DML.sql",
            "settings": { "foreground": "#E3CEAB", "fontStyle": "" }
        },
        {
            "scope": "source.sql",
            "settings": { "foreground": "#DCDCCC", "fontStyle": "" }
        },
        {
            "scope": "constant.other.table-name.sql",
            "settings": { "foreground": "#DCDCCC", "fontStyle": "" }
        },
        {
            "scope": "constant.other.database-name.sql",
            "settings": { "foreground": "#DCDCCC", "fontStyle": "" }
        },
        {
            "scope": "beginning.punctuation.definition.list.markdown",
            "settings": { "foreground": "#E3CEAB" }
        },
        {
            "scope": "punctuation.definition.heading",
            "settings": { "foreground": "#8F8F8F" }
        },
        { "scope": "variable.other", "settings": { "foreground": "#DCDCCC" } },
        { "scope": "storage.type", "settings": { "foreground": "#EFDCBC" } },
        { "scope": "storage.type.type", "settings": { "fontStyle": "bold" } },
        {
            "scope": "keyword.control.export",
            "settings": { "fontStyle": "bold" }
        },
        {
            "scope": "keyword.control.conditional",
            "settings": { "fontStyle": "bold" }
        },
        {
            "scope": "support.function",
            "settings": { "foreground": "#DCDCCC" }
        },
        { "scope": "string", "settings": { "foreground": "#CC9393" } },
        {
            "scope": "storage.type.function",
            "settings": { "foreground": "#EFEF8F" }
        },
        {
            "scope": "entity.name.function",
            "settings": { "foreground": "#DCDCCC" }
        },
        { "scope": "keyword.control", "settings": { "foreground": "#E3CEAB" } },
        {
            "scope": "keyword.operator",
            "settings": { "foreground": "#F0EFD0" }
        },
        {
            "scope": "entity.name.type",
            "settings": { "foreground": "#DCDCCC" }
        },
        { "scope": "support.class", "settings": { "foreground": "#DCDCCC" } },
        {
            "scope": "variable.parameter",
            "settings": { "foreground": "#DCDCCC" }
        },
        {
            "scope": "punctuation.definition.comment",
            "settings": { "foreground": "#7F9F7F", "fontStyle": "italic" }
        },
        {
            "scope": "comment",
            "settings": { "foreground": "#7F9F7F", "fontStyle": "italic" }
        },
        {
            "scope": "entity.name.type.class",
            "settings": { "foreground": "#DCDCCC" }
        },
        {
            "scope": "entity.other.inherited-class",
            "settings": { "foreground": "#DCDCCC" }
        },
        {
            "scope": "storage.modifier",
            "settings": { "foreground": "#F0DFAF", "fontStyle": "bold" }
        },
        {
            "scope": "storage.type",
            "settings": { "foreground": "#F0DFAF", "fontStyle": "bold" }
        },
        {
            "scope": "support.type",
            "settings": { "foreground": "#DFDFBF", "fontStyle": "bold" }
        },
        {
            "scope": "variable.object.property",
            "settings": { "foreground": "#DCDCCC" }
        },
        {
            "scope": "punctuation.definition.string.begin",
            "settings": { "foreground": "#CC9393" }
        },
        {
            "scope": "punctuation.definition.string.end",
            "settings": { "foreground": "#CC9393" }
        },
        {
            "scope": "meta.tag.sgml.doctype.html",
            "settings": { "foreground": "#7F9F7F" }
        },
        {
            "scope": "keyword.other.unit",
            "settings": { "foreground": "#87D6D5" }
        },
        {
            "scope": "entity.name.tag.css",
            "settings": { "foreground": "#E3CEAB" }
        },
        {
            "scope": "entity.name.tag.structure.any.html",
            "settings": { "foreground": "#E3CEAB", "fontStyle": "" }
        },
        {
            "scope": "punctuation.definition.tag.begin.html",
            "settings": { "foreground": "#EFEF8FBB" }
        },
        {
            "scope": "punctuation.definition.tag.end.html",
            "settings": { "foreground": "#EFEF8FBB" }
        },
        {
            "scope": "meta.tag.structure.any.html",
            "settings": { "foreground": "#EFEF8FBB" }
        },
        {
            "scope": "support.type.property-name.css",
            "settings": { "foreground": "#C3BF9F", "fontStyle": "bold" }
        },
        {
            "scope": "meta.property-value.css",
            "settings": { "foreground": "#DCDCCC" }
        },
        {
            "scope": "meta.property-list.css",
            "settings": { "foreground": "#DCDCCC" }
        },
        {
            "scope": "support.constant.property-value.css",
            "settings": { "foreground": "#DCA3A3", "fontStyle": "bold" }
        },
        {
            "scope": "constant.other",
            "settings": { "foreground": "#DCA3A3", "fontStyle": "bold" }
        },
        {
            "scope": "entity.other.attribute-name.class.css",
            "settings": { "foreground": "#EFEF8F" }
        },
        {
            "scope": "punctuation.section.property-list.begin.bracket.curly.css",
            "settings": { "foreground": "#EFEF8F" }
        },
        {
            "scope": "punctuation.section.property-list.end.bracket.curly.css",
            "settings": { "foreground": "#EFEF8F" }
        },
        { "scope": "storage.type.function", "settings": { "fontStyle": "" } },
        {
            "scope": "keyword.control.flow.python",
            "settings": { "foreground": "#C3BF9F", "fontStyle": "bold" }
        },
        {
            "scope": "keyword.control.import.python",
            "settings": { "foreground": "#DFAF8F", "fontStyle": "bold" }
        },
        {
            "scope": "storage.type.function.python",
            "settings": { "foreground": "#E3CEAB", "fontStyle": "bold" }
        },
        {
            "scope": "entity.name.function.python",
            "settings": { "foreground": "#EFEF8F" }
        },
        {
            "scope": "support.function.builtin.python",
            "settings": { "foreground": "#EFEF8F" }
        }
    ]
}
