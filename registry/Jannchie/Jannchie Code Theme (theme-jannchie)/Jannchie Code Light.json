    "semanticHighlighting": true,
    "semanticTokenColors": {
        "namespace": { "foreground": "#246cbf" },
        "class": { "foreground": "#0f7d68" },
        "class.defaultLibrary": { "foreground": "#3d7a2e" },
        "interface": { "foreground": "#0f7d68" },
        "interface.defaultLibrary": { "foreground": "#0f7d68" },
        "struct": { "foreground": "#0f7d68" },
        "typeParameter": "#097575",
        "type": { "foreground": "#097575" },
        "parameter": { "foreground": "#3a5a7a" },
        "variable": "#474747",
        "variable.readonly": { "foreground": "#4f7893" },
        "variable.defaultLibrary": { "foreground": "#797979" },
        "property": "#3184b4",
        "enum.declaration": { "foreground": "#0f7d68" },
        "enum": { "foreground": "#0f7d68" },
        "enumMember": { "foreground": "#0f7d68" },
        "decorator": "#825a91",
        "variable.decorator": { "foreground": "#825a91" },
        "event": "#d67200",
        "function": "#d67200",
        "function.builtin": "#d67200",
        "function.defaultLibrary": "#d67200",
        "method": "#d67200",
        "method.defaultLibrary": "#d67200",
        "method.builtin": "#d67200",
        "macro": "#d67200",
        "label": "#d67200",
        "comment": "#547570",
        "string": "#b84b1c",
        "stringLiteral": "#b84b1c",
        "keyword": "#c04949",
        "number": "#005e6d",
        "numberLiteral": "#005e6d",
        "regexp": "#5e7a1e",
        "operator": "#a1a1a1",
        "newOperator": "#1b1b1b",
        "customLiteral": "#1b1b1b",
        "builtinConstant": "#17477e",
        "component": "#0f7d68",
        "variable.builtin": { "bold": true }
    },
    "tokenColors": [
        {
            "scope": [
                "comment",
                "punctuation.definition.comment",
                "string.comment"
            ],
            "settings": { "foreground": "#547570" }
        },
        {
            "scope": [
                "delimiter.bracket",
                "delimiter",
                "invalid.illegal.character-not-allowed-here.html",
                "keyword.operator.rest",
                "keyword.operator.spread",
                "keyword.operator.type.annotation",
                "keyword.operator.relational",
                "keyword.operator.assignment",
                "meta.brace",
                "meta.tag.block.any.html",
                "meta.tag.inline.any.html",
                "meta.tag.structure.input.void.html",
                "meta.type.annotation",
                "meta.embedded.block.github-actions-expression",
                "storage.type.function.arrow",
                "keyword.operator.type",
                "meta.objectliteral.ts",
                "punctuation"
            ],
            "settings": { "foreground": "#a1a1a1" }
        },
        {
            "scope": [
                "constant",
                "entity.name.constant",
                "variable.language",
                "meta.definition.variable"
            ],
            "settings": { "foreground": "#005e6d" }
        },
        {
            "scope": ["entity", "entity.name"],
            "settings": { "foreground": "#1b1b1b" }
        },
        {
            "scope": "variable.parameter.function",
            "settings": { "foreground": "#1b1b1b" }
        },
        {
            "scope": ["entity.name.tag", "tag.html"],
            "settings": { "foreground": "#3d7a2e" }
        },
        {
            "scope": [
                "entity.other.attribute-name.html.meta.attribute.class.html"
            ],
            "settings": { "foreground": "#097575" }
        },
        {
            "scope": [
                "support.class.component",
                "support.class.component.html",
                "support.class.component.jsx",
                "support.class.component.tsx",
                "meta.tag.other.unrecognized.html.derivative entity.name.tag"
            ],
            "settings": { "foreground": "#0f7d68" }
        },
        {
            "scope": "entity.name.function",
            "settings": { "foreground": "#d67200" }
        },
        {
            "scope": ["keyword", "storage.type.class.jsdoc"],
            "settings": { "foreground": "#c04949" }
        },
        {
            "scope": ["storage", "storage.type"],
            "settings": { "foreground": "#c04949" }
        },
        {
            "scope": [
                "support.type.builtin",
                "constant.language.undefined",
                "constant.language.null"
            ],
            "settings": { "foreground": "#246cbf" }
        },
        {
            "scope": [
                "text.html.derivative",
                "storage.modifier.package",
                "storage.modifier.import",
                "storage.type.java"
            ],
            "settings": { "foreground": "#1b1b1b" }
        },
        {
            "scope": [
                "string",
                "string punctuation.section.embedded source",
                "attribute.value"
            ],
            "settings": { "foreground": "#b84b1c" }
        },
        {
            "scope": ["variable.other.object", "variable.other.readwrite"],
            "settings": { "foreground": "#474747" }
        },
        {
            "scope": [
                "variable.other.object.property",
                "variable.other.property"
            ],
            "settings": { "foreground": "#3184b4" }
        },
        {
            "scope": ["meta.function-call"],
            "settings": { "foreground": "#d67200" }
        },
        {
            "scope": [
                "punctuation.definition.string",
                "punctuation.support.type.property-name"
            ],
            "settings": { "foreground": "#b84b1c99" }
        },
        {
            "scope": ["support", "support.type.property-name.toml"],
            "settings": { "foreground": "#3184b4" }
        },
        {
            "scope": [
                "support.type.property-name.table.toml",
                "support.type.property-name.array.toml"
            ],
            "settings": { "foreground": "#d67200" }
        },
        {
            "scope": [
                "property",
                "meta.property-name",
                "meta.object-literal.key",
                "entity.name.tag.yaml",
                "attribute.name"
            ],
            "settings": { "foreground": "#3184b4" }
        },
        {
            "scope": ["variable", "identifier"],
            "settings": { "foreground": "#474747" }
        },
        {
            "scope": ["variable.other.constant"],
            "settings": { "foreground": "#005e6d" }
        },
        {
            "scope": ["support.type.primitive", "entity.name.type"],
            "settings": { "foreground": "#097575" }
        },
        { "scope": "namespace", "settings": { "foreground": "#246cbf" } },
        {
            "scope": [
                "keyword.operator",
                "keyword.operator.assignment.compound",
                "meta.var.expr.ts"
            ],
            "settings": { "foreground": "#a1a1a1" }
        },
        {
            "scope": [
                "keyword.control",
                "keyword.operator.new",
                "keyword.operator.expression",
                "keyword.operator.cast",
                "keyword.operator.sizeof",
                "keyword.operator.alignof",
                "keyword.operator.typeid",
                "keyword.operator.alignas",
                "keyword.operator.instanceof",
                "keyword.operator.logical.python",
                "keyword.operator.wordlike",
                "keyword.operator.noexcept"
            ],
            "settings": { "foreground": "#c04949" }
        },
        {
            "scope": ["keyword.control.import"],
            "settings": { "foreground": "#9b25d1" }
        },
        {
            "scope": "invalid.broken",
            "settings": { "fontStyle": "italic", "foreground": "#b62626" }
        },
        {
            "scope": "invalid.deprecated",
            "settings": { "fontStyle": "italic", "foreground": "#b62626" }
        },
        {
            "scope": "invalid.illegal",
            "settings": { "fontStyle": "italic", "foreground": "#b62626" }
        },
        {
            "scope": "invalid.unimplemented",
            "settings": { "fontStyle": "italic", "foreground": "#b62626" }
        },
        {
            "scope": "carriage-return",
            "settings": {
                "fontStyle": "italic underline",
                "background": "#b62626",
                "foreground": "#ffffff",
                "content": "^M"
            }
        },
        { "scope": "message.error", "settings": { "foreground": "#b62626" } },
        { "scope": "string variable", "settings": { "foreground": "#b84b1c" } },
        {
            "scope": ["source.regexp", "string.regexp"],
            "settings": { "foreground": "#5e7a1e" }
        },
        { "scope": "constant.regexp", "settings": { "foreground": "#5e7a1e" } },
        {
            "scope": [
                "string.regexp.character-class",
                "string.regexp constant.character.escape",
                "string.regexp source.ruby.embedded",
                "string.regexp string.regexp.arbitrary-repitition"
            ],
            "settings": { "foreground": "#b84b1c" }
        },
        {
            "scope": "string.regexp constant.character.escape",
            "settings": { "foreground": "#fad149" }
        },
        {
            "scope": ["support.constant"],
