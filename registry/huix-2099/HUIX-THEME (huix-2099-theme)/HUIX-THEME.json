        "menu.selectionForeground": "#FFFFFF",
        "menu.separatorBackground": "#2A2826",
        "panel.background": "#141210",
        "panel.border": "#0A0A0A",
        "panelTitle.activeForeground": "#FF9500",
        "panelTitle.inactiveForeground": "#666666",
        "panelTitle.activeBorder": "#FF9500",
        "terminal.background": "#1A1816",
        "terminal.foreground": "#E0E0E0",
        "terminalCursor.foreground": "#FF9500",
        "terminal.ansiBlack": "#1A1816",
        "terminal.ansiBrightBlack": "#555555",
        "terminal.ansiRed": "#FF5555",
        "terminal.ansiBrightRed": "#FF6666",
        "terminal.ansiGreen": "#00FF66",
        "terminal.ansiBrightGreen": "#33FF88",
        "terminal.ansiYellow": "#FF9500",
        "terminal.ansiBrightYellow": "#FFAA33",
        "terminal.ansiBlue": "#88AACC",
        "terminal.ansiBrightBlue": "#99BBDD",
        "terminal.ansiMagenta": "#CC77AA",
        "terminal.ansiBrightMagenta": "#DD88BB",
        "terminal.ansiCyan": "#00FF66",
        "terminal.ansiBrightCyan": "#33FF88",
        "terminal.ansiWhite": "#E0E0E0",
        "terminal.ansiBrightWhite": "#FFFFFF",
        "tab.activeBackground": "#1A1816",
        "tab.inactiveBackground": "#0F0E0C",
        "tab.activeForeground": "#FF9500",
        "tab.inactiveForeground": "#666666",
        "tab.activeBorderTop": "#FF9500",
        "tab.hoverBackground": "#222222",
        "tab.border": "#00000000",
        "editorGroupHeader.tabsBackground": "#0F0E0C",
        "editorGroup.border": "#0A0A0A",
        "dropdown.background": "#141210",
        "dropdown.border": "#2A2826",
        "dropdown.foreground": "#E0E0E0",
        "input.background": "#141210",
        "input.border": "#2A2826",
        "input.foreground": "#E0E0E0",
        "input.placeholderForeground": "#555555",
        "inputOption.activeBackground": "#FF950035",
        "inputOption.activeBorder": "#FF9500",
        "list.activeSelectionBackground": "#FF950030",
        "list.activeSelectionForeground": "#FFFFFF",
        "list.inactiveSelectionBackground": "#FF950018",
        "list.hoverBackground": "#FFFFFF08",
        "list.highlightForeground": "#FF9500",
        "badge.background": "#FF9500",
        "badge.foreground": "#000000",
        "button.background": "#FF9500",
        "button.foreground": "#000000",
        "button.hoverBackground": "#FFAA33",
        "button.secondaryBackground": "#2A2826",
        "button.secondaryForeground": "#E0E0E0",
        "progressBar.background": "#FF9500",
        "editorWidget.background": "#141210",
        "editorWidget.border": "#2A2826",
        "editorSuggestWidget.background": "#141210",
        "editorSuggestWidget.border": "#2A2826",
        "editorSuggestWidget.highlightForeground": "#FF9500",
        "editorSuggestWidget.selectedBackground": "#FF950030",
        "peekView.border": "#FF9500",
        "peekViewEditor.background": "#0F0E0C",
        "peekViewResult.background": "#141210",
        "peekViewTitle.background": "#141210",
        "scrollbarSlider.background": "#FFFFFF10",
        "scrollbarSlider.hoverBackground": "#FFFFFF18",
        "scrollbarSlider.activeBackground": "#FF950050",
        "minimap.background": "#1A1816",
        "breadcrumb.background": "#1A1816",
        "breadcrumb.foreground": "#666666",
        "breadcrumb.activeSelectionForeground": "#FF9500",
        "diffEditor.insertedTextBackground": "#00FF6618",
        "diffEditor.removedTextBackground": "#FF000018",
        "gitDecoration.addedResourceForeground": "#00FF66",
        "gitDecoration.modifiedResourceForeground": "#FF9500",
        "gitDecoration.deletedResourceForeground": "#FF5555",
        "gitDecoration.untrackedResourceForeground": "#00FF66",
        "gitDecoration.ignoredResourceForeground": "#444444",
        "editorInlayHint.background": "#1A1816",
        "editorInlayHint.foreground": "#666666",
        "debugIcon.breakpointForeground": "#FF5555",
        "debugIcon.startForeground": "#00FF66",
        "testing.iconFailed": "#FF5555",
        "testing.iconPassed": "#00FF66",
        "notificationCenterHeader.background": "#141210",
        "notifications.background": "#141210",
        "textLink.foreground": "#FF9500",
        "textLink.activeForeground": "#FFAA33"
    },
    "tokenColors": [
        {
            "name": "Comments - Gray Italic",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#666666", "fontStyle": "italic" }
        },
        {
            "name": "Strings - BRIGHT GREEN",
            "scope": ["string", "punctuation.definition.string"],
            "settings": { "foreground": "#00FF66" }
        },
        {
            "name": "Template Strings - BRIGHT GREEN",
            "scope": [
                "string.template",
                "punctuation.definition.string.template"
            ],
            "settings": { "foreground": "#00FF66" }
        },
        {
            "name": "String Interpolation - BRIGHT ORANGE",
            "scope": [
                "punctuation.definition.template-expression",
                "meta.template.expression"
            ],
            "settings": { "foreground": "#FF9500" }
        },
        {
            "name": "Numbers - BRIGHT ORANGE",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#FF9500" }
        },
        {
            "name": "Boolean / Null - BRIGHT ORANGE",
            "scope": ["constant.language"],
            "settings": { "foreground": "#FF9500" }
        },
        {
            "name": "Keywords - BRIGHT ORANGE",
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#FF9500" }
        },
        {
            "name": "Control Keywords - BRIGHT ORANGE",
            "scope": ["keyword.control"],
            "settings": { "foreground": "#FF9500" }
        },
        {
            "name": "Operators - Gray",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#999999" }
        },
        {
            "name": "Functions - BRIGHT GREEN",
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#00FF66" }
        },
        {
            "name": "Function Calls - BRIGHT GREEN",
            "scope": ["meta.function-call entity.name.function"],
            "settings": { "foreground": "#00FF66" }
        },
        {
            "name": "Classes / Types - BRIGHT ORANGE",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.type",
                "support.class"
            ],
            "settings": { "foreground": "#FF9500" }
        },
        {
            "name": "Interfaces - BRIGHT ORANGE Italic",
            "scope": ["entity.name.type.interface"],
            "settings": { "foreground": "#FF9500", "fontStyle": "italic" }
        },
        {
            "name": "Variables - White",
            "scope": ["variable", "variable.other"],
            "settings": { "foreground": "#E0E0E0" }
        },
        {
            "name": "Constants - BRIGHT ORANGE",
            "scope": ["variable.other.constant"],
            "settings": { "foreground": "#FF9500" }
        },
        {
            "name": "Parameters - Gray Italic",
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#AAAAAA", "fontStyle": "italic" }
        },
        {
            "name": "Properties - Gray",
            "scope": ["variable.other.property", "support.variable.property"],
            "settings": { "foreground": "#AAAAAA" }
        },
        {
            "name": "Object Keys - BRIGHT GREEN",
            "scope": ["meta.object-literal.key", "support.type.property-name"],
            "settings": { "foreground": "#00FF66" }
        },
        {
            "name": "Punctuation - Gray",
            "scope": ["punctuation"],
            "settings": { "foreground": "#888888" }
        },
        {
            "name": "Brackets - Gray",
            "scope": ["punctuation.definition.block", "meta.brace"],
            "settings": { "foreground": "#999999" }
        },
        {
            "name": "Tags (HTML/JSX) - BRIGHT ORANGE",
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#FF9500" }
        },
        {
            "name": "Attributes - BRIGHT GREEN",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#00FF66" }
        },
        {
            "name": "CSS Properties - BRIGHT GREEN",
            "scope": ["support.type.property-name.css"],
            "settings": { "foreground": "#00FF66" }
        },
        {
            "name": "CSS Values - BRIGHT ORANGE",
            "scope": ["support.constant.property-value.css"],
            "settings": { "foreground": "#FF9500" }
        },
        {
            "name": "CSS Selectors - BRIGHT GREEN",
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css"
            ],
            "settings": { "foreground": "#00FF66" }
        },
        {
            "name": "Regex - BRIGHT ORANGE",
            "scope": ["string.regexp"],
            "settings": { "foreground": "#FF9500" }
        },
        {
            "name": "Escape Characters - BRIGHT ORANGE",
            "scope": ["constant.character.escape"],
            "settings": { "foreground": "#FF9500" }
        },
        {
            "name": "Markdown Headings - BRIGHT ORANGE",
            "scope": ["markup.heading", "entity.name.section"],
            "settings": { "foreground": "#FF9500", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Bold - White Bold",
            "scope": ["markup.bold"],
            "settings": { "foreground": "#FFFFFF", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Italic - Gray Italic",
            "scope": ["markup.italic"],
            "settings": { "foreground": "#BBBBBB", "fontStyle": "italic" }
        },
        {
            "name": "Markdown Links - BRIGHT ORANGE",
            "scope": ["markup.underline.link"],
            "settings": { "foreground": "#FF9500" }
        },
        {
            "name": "Markdown Code - BRIGHT GREEN",
            "scope": ["markup.inline.raw", "markup.fenced_code.block"],
            "settings": { "foreground": "#00FF66" }
        },
        {
            "name": "Markdown List - BRIGHT ORANGE",
            "scope": ["punctuation.definition.list.begin.markdown"],
            "settings": { "foreground": "#FF9500" }
        },
        {
            "name": "Diff Inserted - BRIGHT GREEN",
            "scope": ["markup.inserted"],
            "settings": { "foreground": "#00FF66" }
        },
        {
            "name": "Diff Deleted - Red",
            "scope": ["markup.deleted"],
            "settings": { "foreground": "#FF5555" }
        },
        {
            "name": "Invalid - Red",
            "scope": ["invalid"],
            "settings": { "foreground": "#FF5555" }
        },
        {
            "name": "Decorators - BRIGHT ORANGE",
            "scope": ["meta.decorator", "entity.name.function.decorator"],
            "settings": { "foreground": "#FF9500" }
        },
        {
            "name": "Import/Export - BRIGHT ORANGE",
            "scope": [
                "keyword.control.import",
                "keyword.control.export",
                "keyword.control.from"
            ],
            "settings": { "foreground": "#FF9500" }
        },
        {
            "name": "This/Self - BRIGHT ORANGE Italic",
            "scope": ["variable.language.this", "variable.language.self"],
            "settings": { "foreground": "#FF9500", "fontStyle": "italic" }
        },
        {
            "name": "JSON Keys - BRIGHT GREEN",
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#00FF66" }
        },
        {
            "name": "JSON String Values - BRIGHT GREEN",
            "scope": ["meta.structure.dictionary.value.json string.quoted"],
            "settings": { "foreground": "#00FF66" }
        },
        {
            "name": "YAML Keys - BRIGHT GREEN",
            "scope": ["entity.name.tag.yaml"],
            "settings": { "foreground": "#00FF66" }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "type": "#FF9500",
        "class": "#FF9500",
        "interface": { "foreground": "#FF9500", "fontStyle": "italic" },
        "enum": "#FF9500",
        "enumMember": "#FF9500",
        "function": "#00FF66",
        "method": "#00FF66",
        "variable": "#E0E0E0",
        "variable.readonly": "#FF9500",
        "parameter": { "foreground": "#AAAAAA", "fontStyle": "italic" },
        "property": "#AAAAAA",
        "property.readonly": "#FF9500",
        "keyword": "#FF9500",
        "string": "#00FF66",
        "number": "#FF9500",
        "regexp": "#FF9500",
        "operator": "#999999",
        "namespace": "#FF9500",
        "decorator": "#FF9500",
        "comment": { "foreground": "#666666", "fontStyle": "italic" }
    },
    "$schema": "vscode://schemas/color-theme"
}
