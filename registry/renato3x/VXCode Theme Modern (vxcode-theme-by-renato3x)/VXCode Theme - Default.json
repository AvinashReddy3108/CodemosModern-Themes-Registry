{
    "name": "VXCode Theme - Default",
    "semanticHighlighting": true,
    "colors": {
        "activityBar.activeBorder": "#e84f8f",
        "activityBar.activeFocusBorder": "#e84f8f",
        "activityBar.background": "#18191a",
        "activityBar.border": "#333333",
        "activityBar.foreground": "#ffffff",
        "activityBarBadge.background": "#e84f8f",
        "activityBarBadge.foreground": "#ffffff",
        "badge.background": "#e84f8f",
        "badge.foreground": "#ffffff",
        "button.background": "#555555",
        "button.foreground": "#fcfbfc",
        "button.hoverBackground": "#666666",
        "dropdown.background": "#18191a",
        "dropdown.border": "#333333",
        "editor.background": "#1c1d1e",
        "editor.foreground": "#ffffffd8",
        "editor.lineHighlightBackground": "#00000000",
        "editor.selectionBackground": "#4c566a",
        "editorGroup.border": "#404040",
        "editorGroupHeader.tabsBackground": "#18191a",
        "editorGroupHeader.tabsBorder": "#404040",
        "sideBar.background": "#18191a",
        "sideBar.border": "#404040",
        "sideBar.foreground": "#eaf0f6",
        "sideBarSectionHeader.background": "#18191a",
        "sideBarSectionHeader.border": "#404040",
        "statusBar.background": "#18191a",
        "statusBar.border": "#404040",
        "statusBar.foreground": "#ffffffd8",
        "statusBarItem.remoteBackground": "#e84f8f",
        "statusBarItem.remoteForeground": "#ffffff",
        "statusBar.noFolderBackground": "#18191a",
        "statusBar.debuggingBackground": "#18191a",
        "tab.activeBackground": "#1c1d1e",
        "tab.activeBorderTop": "#e84f8f",
        "tab.activeBorder": "#1c1d1e",
        "tab.inactiveBackground": "#18191a",
        "tab.inactiveForeground": "#b7b7b7",
        "titleBar.activeBackground": "#18191a",
        "titleBar.activeForeground": "#b8b7bc",
        "titleBar.border": "#404040",
        "panel.background": "#18191a",
        "panel.border": "#404040"
    },
    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#808080" }
        },
        {
            "name": "Strings",
            "scope": ["string"],
            "settings": { "foreground": "#fe8170" }
        },
        {
            "name": "Keyword and Storage",
            "scope": [
                "storage.type",
                "storage.modifier",
                "keyword",
                "variable.language.this"
            ],
            "settings": { "foreground": "#e84f8f" }
        },
        {
            "name": "Function Name",
            "scope": ["entity.name.function"],
            "settings": { "foreground": "#cbbcf1" }
        },
        {
            "name": "Classes and Types",
            "scope": [
                "entity.name.type.class",
                "entity.other.inherited-class",
                "meta.return.type",
                "entity.name.type",
                "support.type.primitive",
                "storage.type.string.go",
                "storage.type.numeric.go",
                "storage.type.boolean.go",
                "support.class.component"
            ],
            "settings": { "foreground": "#8ecce1" }
        },
        {
            "name": "Variables and Properties",
            "scope": [
                "variable.other.readwrite",
                "variable.object.property",
                "meta.object-literal.key",
                "variable.parameter",
                "variable.other.property",
                "support.type.property-name.json",
                "variable.other.assignment",
                "variable.other.go"
            ],
            "settings": { "foreground": "#9777d9" }
        },
        {
            "name": "Imports",
            "scope": ["variable.other.readwrite.alias"],
            "settings": { "foreground": "#ffffff" }
        },
        {
            "name": "Constants and Booleans",
            "scope": [
                "variable.other.constant",
                "variable.other.enummember",
                "property.readonly",
                "constant.language.boolean",
                "constant.language.json"
            ],
            "settings": { "foreground": "#64adc9" }
        },
        {
            "name": "Key-Value Separator",
            "scope": ["punctuation.separator.key-value"],
            "settings": { "foreground": "#e84f8f" }
        },
        {
            "name": "Numeric Constants",
            "scope": [
                "constant.numeric",
                "constant.numeric.integer",
                "constant.numeric.float",
                "constant.numeric.decimal"
            ],
            "settings": { "foreground": "#ffeb7c" }
        },
        {
            "name": "HTML Tags",
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#64adc9" }
        },
        {
            "name": "HTML attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#9777d9" }
        },
        {
            "name": "CSS Variables",
            "scope": [
                "variable.css",
                "variable.argument.css",
                "support.type.property-name.css",
                "variable.prop.css",
                "support.type.property-name.media.css",
                "variable.parameter.keyframe-list.css"
            ],
            "settings": { "foreground": "#9777d9" }
        },
        {
            "name": "CSS Constants",
            "scope": [
                "support.constant.font-name.css",
                "support.constant.property-value.misc.css",
                "support.constant.property-value.css",
                "support.constant.media.css",
                "support.constant.color.w3c-standard-color-name.css",
                "support.constant.color.w3c-extended-color-name.css",
                "constant.other.color"
            ],
            "settings": { "foreground": "#fe8170" }
        },
        {
            "name": "CSS Functions",
            "scope": ["support.function.misc.css"],
            "settings": { "foreground": "#cbbcf1" }
        },
        {
            "name": "Language Constants",
            "scope": ["constant.language"],
            "settings": { "foreground": "#64adc9" }
        },
        {
            "name": "Markdown Headings",
            "scope": ["markup.heading.markdown"],
            "settings": { "foreground": "#e84f8f", "fontStyle": "bold" }
        },
        {
            "name": "Markdown bold",
            "scope": ["markup.bold.markdown"],
            "settings": { "foreground": "#e84f8f", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Italic",
            "scope": ["markup.italic.markdown"],
            "settings": { "foreground": "#ffffff", "fontStyle": "italic" }
        },
        {
            "name": "Markdown Quote",
            "scope": ["punctuation.definition.quote"],
            "settings": { "foreground": "#e84f8f", "fontStyle": "bold" }
        },
        {
            "name": "Markdown List",
            "scope": ["punctuation.definition.list"],
            "settings": { "foreground": "#9777d9", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Raw",
            "scope": ["markup.inline.raw"],
            "settings": { "foreground": "#fe8170" }
        },
        {
            "name": "Markdown URLs",
            "scope": ["markup.underline.link"],
            "settings": { "foreground": "#9777d9", "fontStyle": "italic" }
        },
        {
            "name": "Markdown Scape character",
            "scope": ["constant.character.escape.markdown"],
            "settings": { "foreground": "#fe8170", "fontStyle": "italic" }
        },
        {
            "name": "Go String placeholder",
            "scope": ["constant.other.placeholder.go"],
            "settings": { "foreground": "#9777d9" }
        },
        {
            "name": "Scape Character",
            "scope": ["constant.character.escape"],
            "settings": { "foreground": "#e84f8f" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
