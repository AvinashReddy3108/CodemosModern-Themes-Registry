        "string": { "foreground": "#5f8700", "fontStyle": "normal" },
        "keyword": { "foreground": "#d70087", "fontStyle": "normal" },
        "keyword.async": { "foreground": "#8700af", "fontStyle": "bold" },
        "keyword.controlFlow": { "foreground": "#8700af", "fontStyle": "bold" },
        "selfKeyword": { "foreground": "#d75f00", "fontStyle": "normal" },
        "selfTypeKeyword": { "foreground": "#d75f00", "fontStyle": "bold" },
        "number": null,
        "regexp": null,
        "operator": { "foreground": "#444444", "fontStyle": "normal" }
