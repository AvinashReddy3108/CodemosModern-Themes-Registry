{
    "name": "Nebula Dark",
    "type": "dark",
    "colors": {
        "editor.background": "#020202",
        "editor.foreground": "#e6e6e6",
        "sideBar.background": "#020202",
        "sideBar.foreground": "#6b4fbb",
        "activityBar.background": "#020202",
        "activityBar.foreground": "#6b4fbb",
        "statusBar.background": "#020202",
        "statusBar.foreground": "#6b4fbb",
        "titleBar.activeBackground": "#020202",
        "titleBar.activeForeground": "#6b4fbb"
    },
    "tokenColors": [
        {
            "name": "Keyword",
            "scope": "keyword",
            "settings": { "foreground": "#6b4fbb" }
        },
        {
            "name": "String",
            "scope": "string",
            "settings": { "foreground": "#00ff00" }
        },
        {
            "name": "Function",
            "scope": "entity.name.function",
            "settings": { "foreground": "#00ffff" }
        },
        {
            "name": "Comment",
            "scope": "comment",
            "settings": { "foreground": "#505050" }
        },
        {
            "name": "Variable",
            "scope": "variable",
            "settings": { "foreground": "#ffff00" }
        },
        {
            "name": "Type",
            "scope": "entity.name.type",
            "settings": { "foreground": "#ff00ff" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
