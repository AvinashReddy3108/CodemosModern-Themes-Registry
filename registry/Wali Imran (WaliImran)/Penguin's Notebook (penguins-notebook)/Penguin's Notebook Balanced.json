{
    "name": "Balanced Dark",
    "type": "dark",
    "colors": {
        "editor.background": "#181818",
        "editor.foreground": "#f4f4f4e2",
        "editorCursor.foreground": "#3c5955",
        "editor.lineHighlightBackground": "#9d9d9d35",
        "editorLineNumber.foreground": "#6a6a7a",
        "editor.selectionBackground": "#ffffff21",
        "editor.inactiveSelectionBackground": "#ffffff21",
        "window.activeTitleBackground": "#1a1a1a",
        "window.inactiveTitleBackground": "#222222",
        "titleBar.activeBackground": "#1a1a1a",
        "titleBar.inactiveBackground": "#222222",
        "titleBar.activeForeground": "#f4f4f4",
        "titleBar.inactiveForeground": "#a0a0a0",
        "activityBar.background": "#1a1a1a",
        "activityBar.foreground": "#f4f4f4",
        "activityBar.border": "#2e2e2e",
        "sideBar.background": "#191919",
        "sideBar.foreground": "#d0d0d0",
        "sideBar.border": "#2e2e2e"
    },
    "tokenColors": [
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#d4d0ab", "fontStyle": "italic" }
        },
        {
            "scope": ["keyword", "storage"],
            "settings": { "foreground": "#bd84c7" }
        },
        {
            "scope": ["string", "constant.other.symbol"],
            "settings": { "foreground": "#8fa85d" }
        },
        {
            "scope": ["variable", "identifier"],
            "settings": { "foreground": "#f5ab35" }
        },
        {
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#00e0e0" }
        },
        {
            "scope": [
                "punctuation.bracket.curly",
                "punctuation.bracket.round",
                "punctuation.bracket.square"
            ],
            "settings": { "foreground": "#ffffff" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
