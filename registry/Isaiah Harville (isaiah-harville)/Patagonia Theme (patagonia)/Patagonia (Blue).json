        "number": "#8dec95",
        "regexp": "#80cbc4",
        "operator": "#6dbdfa",
        "keyword": "#82aaff",
        "modifier": "#82aaff",
        "builtinVariable": "#FFB86C",
        "selfParameter": "#a3b8ef",
        "clsParameter": "#a3b8ef"
    },
