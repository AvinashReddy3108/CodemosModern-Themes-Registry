        "tab.inactiveForeground": "#48CAE4af",
        "tab.unfocusedActiveBorder": "#0077B6",
        "tab.unfocusedActiveBackground": "#0077B640",
        "tab.unfocusedActiveForeground": "#48CAE4",
        "tab.unfocusedInactiveBackground": "#0077B610",
        "tab.unfocusedInactiveForeground": "#48CAE47f",
        "terminal.ansiBlack": "#000000",
        "terminal.ansiBlue": "#48CAE4",
