        "terminal.ansiGreen": "#0077B6",
        "terminal.ansiMagenta": "#48CAE4",
        "terminal.ansiRed": "#ADE8F4",
        "terminal.ansiWhite": "#48CAE4",
        "terminal.ansiYellow": "#48CAE4",
