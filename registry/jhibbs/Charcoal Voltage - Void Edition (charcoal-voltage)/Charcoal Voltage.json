{
    "name": "Charcoal Voltage — Void Edition",
    "type": "dark",
    "colors": {
        "editor.background": "#000000",
        "editor.foreground": "#ffffff",
        "editorCursor.foreground": "#ff00ff",
        "editor.lineHighlightBackground": "#111111",
        "editor.selectionBackground": "#00897b",
        "editorIndentGuide.background": "#1a1a1a",
        "editorWhitespace.foreground": "#1a1a1a",
        "sideBar.background": "#000000",
        "sideBar.foreground": "#ffffff",
        "sideBarSectionHeader.background": "#111111",
        "activityBar.background": "#000000",
        "activityBar.foreground": "#ffffff",
        "activityBarBadge.background": "#333333",
        "activityBarBadge.foreground": "#ffffff",
        "statusBar.background": "#000000",
        "statusBar.foreground": "#ffffff",
        "statusBar.debuggingBackground": "#00897b",
        "statusBar.debuggingForeground": "#ffffff",
        "titleBar.activeBackground": "#000000",
        "titleBar.activeForeground": "#ffffff",
        "titleBar.inactiveBackground": "#111111",
        "titleBar.inactiveForeground": "#888888",
        "tab.activeBackground": "#111111",
        "tab.activeForeground": "#ffffff",
        "tab.inactiveBackground": "#000000",
        "tab.inactiveForeground": "#888888",
        "tab.border": "#1c1c1c",
        "panel.background": "#000000",
        "panel.border": "#00bfa5",
        "panelTitle.activeForeground": "#00bfa5",
        "panelTitle.inactiveForeground": "#888888",
        "button.background": "#00897b",
        "button.foreground": "#ffffff",
        "dropdown.background": "#111111",
        "dropdown.foreground": "#ffffff",
        "input.background": "#111111",
        "input.foreground": "#ffffff",
        "input.border": "#00bfa5",
        "scrollbarSlider.background": "#222222",
        "scrollbarSlider.activeBackground": "#00897b",
        "scrollbarSlider.hoverBackground": "#00bfa5"
    },
    "tokenColors": [
        {
            "scope": ["keyword"],
            "settings": { "foreground": "#00bfa5", "fontStyle": "bold" }
        },
        {
            "scope": ["string"],
            "settings": { "foreground": "#00ff00", "fontStyle": "bold" }
        },
        {
            "scope": ["variable"],
            "settings": { "foreground": "#00ffff", "fontStyle": "bold" }
        },
        {
            "scope": ["function"],
            "settings": { "foreground": "#26a69a", "fontStyle": "bold" }
        },
        {
            "scope": ["type", "class", "interface"],
            "settings": { "foreground": "#4db6ac", "fontStyle": "bold" }
        },
        {
            "scope": ["support.type.property-name", "meta.object-literal.key"],
            "settings": { "foreground": "#ffffff", "fontStyle": "bold" }
        },
        {
            "scope": ["constant", "number", "boolean"],
            "settings": { "foreground": "#80cbc4", "fontStyle": "bold" }
        },
        {
            "scope": ["operator", "punctuation"],
            "settings": { "foreground": "#ffffff" }
        },
        {
            "scope": ["comment"],
            "settings": { "foreground": "#8888aa", "fontStyle": "italic" }
        },
        {
            "scope": ["invalid"],
            "settings": { "foreground": "#00897b", "fontStyle": "underline" }
        },
        { "scope": ["meta"], "settings": { "foreground": "#00ffff" } },
        {
            "scope": ["storage"],
            "settings": { "foreground": "#00bfa5", "fontStyle": "bold" }
        },
        {
            "scope": ["entity.name.tag", "tag"],
            "settings": { "foreground": "#ff8800", "fontStyle": "bold" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
