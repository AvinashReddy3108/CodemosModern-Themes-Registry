    "tokenColors": [
        {
            "settings": { "foreground": "#222222ff", "background": "#fcfcfcff" }
        },
        {
            "name": "Function declarations",
            "scope": ["entity.name.function", "xxx-meta.object-literal.key"],
            "settings": { "foreground": "#0000aa" }
        },
        {
            "name": "Types declaration and references",
            "scope": [
                "meta.return-type",
                "support.class",
                "support.type",
                "support.function",
                "support.constant.math",
                "support.constant.dom",
                "support.constant.json",
