{
    "$schema": "vscode://schemas/color-theme",
    "name": "VS 2019 Total Black Theme",
    "type": "dark",
    "colors": {
        "editor.background": "#000000",
        "editor.foreground": "#CCCCCC",
        "editor.inactiveSelectionBackground": "#3A3D41",
        "editor.selectionBackground": "#264F78",
        "editor.selectionHighlightBackground": "#ADD6FF26",
        "editor.lineHighlightBackground": "#0A0A0A",
        "editorIndentGuide.background": "#2A2A2A",
        "editorIndentGuide.activeBackground": "#555555",
        "editorCursor.foreground": "#AEAFAD",
        "editorLineNumber.foreground": "#4A4A4A",
        "editorLineNumber.activeForeground": "#999999",
        "editorWhitespace.foreground": "#2A2A2A",
        "editorBracketMatch.background": "#0064001A",
        "editorBracketMatch.border": "#888888",
        "activityBar.background": "#000000",
        "activityBar.foreground": "#CCCCCC",
        "activityBar.inactiveForeground": "#666666",
        "activityBar.border": "#111111",
        "activityBarBadge.background": "#007ACC",
        "activityBarBadge.foreground": "#FFFFFF",
        "sideBar.background": "#000000",
        "sideBar.foreground": "#CCCCCC",
        "sideBar.border": "#111111",
        "sideBarTitle.foreground": "#BBBBBB",
        "sideBarSectionHeader.background": "#00000000",
        "sideBarSectionHeader.foreground": "#CCCCCC",
        "sideBarSectionHeader.border": "#cccc3333",
        "statusBar.background": "#000000",
        "statusBar.foreground": "#CCCCCC",
        "statusBar.noFolderBackground": "#000000",
        "statusBar.debuggingBackground": "#0078D4",
        "statusBar.border": "#111111",
        "statusBarItem.hoverBackground": "#0062A3",
        "statusBarItem.remoteForeground": "#FFF",
        "statusBarItem.remoteBackground": "#16825D",
        "titleBar.activeBackground": "#000000",
        "titleBar.activeForeground": "#CCCCCC",
        "titleBar.inactiveBackground": "#000000",
        "titleBar.inactiveForeground": "#888888",
        "titleBar.border": "#111111",
        "editorGroupHeader.tabsBackground": "#000000",
        "editorGroupHeader.tabsBorder": "#111111",
        "tab.activeBackground": "#000000",
        "tab.activeForeground": "#FFFFFF",
        "tab.inactiveBackground": "#000000",
        "tab.inactiveForeground": "#888888",
        "tab.border": "#111111",
        "tab.activeBorder": "#007ACC",
        "tab.activeBorderTop": "#0078D4",
        "button.background": "#0E639C",
        "button.foreground": "#FFFFFF",
        "button.hoverBackground": "#1177BB",
        "input.background": "#0D0D0D",
        "input.foreground": "#CCCCCC",
        "input.border": "#1E1E1E",
        "input.placeholderForeground": "#A6A6A6",
        "settings.textInputBackground": "#0D0D0D",
        "settings.numberInputBackground": "#0D0D0D",
        "dropdown.background": "#0D0D0D",
        "dropdown.foreground": "#CCCCCC",
        "dropdown.border": "#1E1E1E",
        "list.activeSelectionBackground": "#094771",
        "list.activeSelectionForeground": "#FFFFFF",
        "list.inactiveSelectionBackground": "#111111",
        "list.inactiveSelectionForeground": "#CCCCCC",
        "list.hoverBackground": "#0D0D0D",
        "list.hoverForeground": "#CCCCCC",
        "list.dropBackground": "#111111",
        "panel.background": "#000000",
        "panel.border": "#111111",
        "panelTitle.activeBorder": "#0078D4",
        "panelTitle.activeForeground": "#CCCCCC",
        "panelTitle.inactiveForeground": "#888888",
        "terminal.foreground": "#CCCCCC",
        "terminal.background": "#000000",
        "terminalCursor.foreground": "#AEAFAD",
        "editorWidget.background": "#0D0D0D",
        "editorWidget.border": "#2A2A2A",
        "editorSuggestWidget.background": "#0D0D0D",
        "editorSuggestWidget.border": "#2A2A2A",
        "editorSuggestWidget.selectedBackground": "#094771",
        "editorSuggestWidget.selectedForeground": "#FFFFFF",
        "editorError.foreground": "#F48771",
        "editorWarning.foreground": "#CCA700",
        "editorInfo.foreground": "#75BEFF",
        "scrollbarSlider.background": "#79797966",
        "scrollbarSlider.hoverBackground": "#646464B3",
        "scrollbarSlider.activeBackground": "#BFBFBF66",
        "badge.background": "#2A2A2A",
        "badge.foreground": "#CCCCCC",
        "breadcrumb.foreground": "#888888",
        "breadcrumb.background": "#000000",
        "breadcrumb.focusForeground": "#CCCCCC",
        "breadcrumb.activeSelectionForeground": "#FFFFFF",
        "menu.background": "#1A1A1A",
        "menu.foreground": "#CCCCCC",
        "menu.selectionBackground": "#2A2A2A",
        "menu.selectionForeground": "#FFFFFF",
        "menu.border": "#333333",
        "menubar.selectionBackground": "#2A2A2A",
        "menubar.selectionForeground": "#FFFFFF",
        "gitDecoration.modifiedResourceForeground": "#E2C08D",
        "gitDecoration.deletedResourceForeground": "#C74E39",
        "gitDecoration.untrackedResourceForeground": "#73C991",
        "gitDecoration.ignoredResourceForeground": "#606060",
        "gitDecoration.conflictingResourceForeground": "#E4676B",
        "focusBorder": "#007ACC80",
        "selection.background": "#264F78",
        "editorUnnecessaryCode.opacity": "#000000cc",
        "menubar.selectionBorder": "#333333",
        "menu.selectionBorder": "#333333",
        "menu.separatorBackground": "#333333"
    },
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "*.deprecated": { "strikethrough": true },
        "comment": { "foreground": "#628650" },
        "comment:typescript": { "foreground": "#628650" }
    },
    "tokenColors": [
        {
            "name": "TS comment in blocks",
            "scope": [
                "comment.line.double-slash.ts",
                "comment.line.double-slash.tsx",
                "comment.block.ts",
                "comment.block.tsx"
            ],
            "settings": { "foreground": "#628650" }
        },
        {
            "name": "Deprecated / unnecessary code",
            "scope": ["invalid.deprecated", "invalid.unnecessary"],
            "settings": { "foreground": "#AAAAAA" }
        },
        {
            "scope": ["meta.embedded", "source.groovy.embedded"],
            "settings": { "foreground": "#CCCCCC" }
        },
        { "scope": "emphasis", "settings": { "fontStyle": "italic" } },
        { "scope": "strong", "settings": { "fontStyle": "bold" } },
        { "scope": "comment", "settings": { "foreground": "#628650" } },
        {
            "scope": "punctuation.definition.comment",
            "settings": { "foreground": "#628650" }
        },
        {
            "scope": "comment.documentation",
            "settings": { "foreground": "#5C824C" }
        },
        {
            "scope": "comment.documentation.attribute",
            "settings": { "foreground": "#C0C0C0" }
        },
        {
            "scope": "comment.documentation.cdata",
            "settings": { "foreground": "#E0CC78" }
        },
        {
            "scope": "comment.documentation.delimiter",
            "settings": { "foreground": "#747474" }
        },
        {
            "scope": "comment.documentation.name",
            "settings": { "foreground": "#54A0D0" }
        },
        {
            "scope": "constant.language",
            "settings": { "foreground": "#54A0D0" }
        },
        {
            "scope": [
                "constant.numeric",
                "entity.name.operator.custom-literal.number",
                "keyword.operator.plus.exponent",
                "keyword.operator.minus.exponent"
            ],
            "settings": { "foreground": "#AECCA0" }
        },
        { "scope": "constant.regexp", "settings": { "foreground": "#60608E" } },
        {
            "scope": "constant.character",
            "settings": { "foreground": "#54A0D0" }
        },
        {
            "scope": "constant.character.escape",
            "settings": { "foreground": "#D0B474" }
        },
        { "scope": "entity.name.tag", "settings": { "foreground": "#54A0D0" } },
        {
            "scope": "entity.name.tag.css",
            "settings": { "foreground": "#D0B474" }
        },
        {
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#96D4F4" }
        },
        {
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.class.mixin.css",
                "entity.other.attribute-name.id.css",
                "entity.other.attribute-name.pseudo-class.css",
                "entity.other.attribute-name.pseudo-element.css",
                "entity.other.attribute-name.attribute.scss",
                "entity.other.attribute-name.scss"
            ],
            "settings": { "foreground": "#D0B474" }
        },
        { "scope": "invalid", "settings": { "foreground": "#EA4242" } },
        {
            "scope": "markup.underline",
            "settings": { "fontStyle": "underline" }
        },
        {
            "scope": "markup.bold",
            "settings": { "fontStyle": "bold", "foreground": "#54A0D0" }
        },
        {
            "scope": "markup.heading",
            "settings": { "fontStyle": "bold", "foreground": "#54A0D0" }
        },
        { "scope": "markup.italic", "settings": { "fontStyle": "italic" } },
        { "scope": "markup.inserted", "settings": { "foreground": "#AECCA0" } },
        { "scope": "markup.deleted", "settings": { "foreground": "#C68870" } },
        { "scope": "markup.changed", "settings": { "foreground": "#54A0D0" } },
        {
            "scope": "markup.inline.raw",
            "settings": { "foreground": "#C68870" }
        },
        {
            "name": "brackets of XML/HTML tags",
            "scope": "punctuation.definition.tag",
            "settings": { "foreground": "#707070" }
        },
        {
            "scope": ["meta.preprocessor", "entity.name.function.preprocessor"],
            "settings": { "foreground": "#54A0D0" }
        },
        {
            "scope": "meta.preprocessor.string",
            "settings": { "foreground": "#C68870" }
        },
        {
            "scope": "meta.preprocessor.numeric",
            "settings": { "foreground": "#AECCA0" }
        },
        {
            "scope": "meta.structure.dictionary.key.python",
            "settings": { "foreground": "#96D4F4" }
        },
        {
            "scope": "meta.diff.header",
            "settings": { "foreground": "#54A0D0" }
        },
        { "scope": "storage", "settings": { "foreground": "#54A0D0" } },
        { "scope": "storage.type", "settings": { "foreground": "#54A0D0" } },
        {
            "scope": ["storage.modifier", "keyword.operator.noexcept"],
            "settings": { "foreground": "#54A0D0" }
        },
        {
            "scope": [
                "string",
                "entity.name.operator.custom-literal.string",
                "meta.embedded.assembly"
            ],
            "settings": { "foreground": "#C68870" }
        },
        { "scope": "string.tag", "settings": { "foreground": "#C68870" } },
        { "scope": "string.value", "settings": { "foreground": "#C68870" } },
        { "scope": "string.regexp", "settings": { "foreground": "#C86060" } },
        {
            "scope": "punctuation.definition.string",
            "settings": { "foreground": "#C68870" }
        },
        {
            "name": "String interpolation",
            "scope": [
                "punctuation.definition.template-expression.begin",
                "punctuation.definition.template-expression.end",
                "punctuation.section.embedded"
            ],
            "settings": { "foreground": "#54A0D0" }
        },
        {
            "name": "Reset JS string interpolation",
            "scope": ["meta.template.expression"],
            "settings": { "foreground": "#CCCCCC" }
        },
        {
            "scope": [
                "support.type.vendored.property-name",
                "support.type.property-name",
                "variable.css",
                "variable.scss",
                "variable.other.less",
                "source.coffee.embedded"
            ],
            "settings": { "foreground": "#96D4F4" }
        },
        { "scope": "keyword", "settings": { "foreground": "#54A0D0" } },
        {
            "scope": "keyword.operator",
            "settings": { "foreground": "#CCCCCC" }
        },
        {
            "scope": [
                "keyword.operator.new",
                "keyword.operator.expression",
                "keyword.operator.cast",
                "keyword.operator.sizeof",
                "keyword.operator.alignof",
                "keyword.operator.typeid",
                "keyword.operator.alignas",
                "keyword.operator.instanceof",
                "keyword.operator.logical.python",
                "keyword.operator.wordlike"
            ],
            "settings": { "foreground": "#BE80BA" }
        },
        {
            "scope": "keyword.other.unit",
            "settings": { "foreground": "#AECCA0" }
        },
        {
            "scope": [
                "punctuation.section.embedded.begin.php",
                "punctuation.section.embedded.end.php"
            ],
            "settings": { "foreground": "#54A0D0" }
        },
        {
            "scope": "support.function.git-rebase",
            "settings": { "foreground": "#96D4F4" }
        },
        {
            "scope": "constant.sha.git-rebase",
            "settings": { "foreground": "#AECCA0" }
        },
        {
            "name": "Java import/package",
            "scope": [
                "storage.modifier.import.java",
                "variable.language.wildcard.java",
                "storage.modifier.package.java"
            ],
            "settings": { "foreground": "#CCCCCC" }
        },
        {
            "name": "this/self",
            "scope": "variable.language",
            "settings": { "foreground": "#54A0D0" }
        },
        {
            "name": "Function declarations",
            "scope": [
                "entity.name.function",
                "support.function",
                "support.constant.handlebars",
                "source.powershell variable.other.member",
                "entity.name.operator.custom-literal",
                "entity.name.function.extension"
            ],
            "settings": { "foreground": "#CECE96" }
        },
        {
            "name": "Types declaration and references",
            "scope": [
                "meta.return-type",
                "support.class",
                "support.type",
                "entity.name.type",
                "entity.other.attribute",
                "entity.name.scope-resolution",
                "entity.name.class",
                "storage.type.numeric.go",
                "storage.type.byte.go",
                "storage.type.boolean.go",
                "storage.type.string.go",
                "storage.type.uintptr.go",
                "storage.type.error.go",
                "storage.type.rune.go",
                "storage.type.cs",
                "storage.type.generic.cs",
                "storage.type.modifier.cs",
                "storage.type.variable.cs",
                "storage.type.annotation.java",
                "storage.type.generic.java",
                "storage.type.java",
                "storage.type.object.array.java",
                "storage.type.primitive.array.java",
                "storage.type.primitive.java",
                "storage.type.token.java",
                "storage.type.groovy",
                "storage.type.annotation.groovy",
                "storage.type.parameters.groovy",
                "storage.type.generic.groovy",
                "storage.type.object.array.groovy",
                "storage.type.primitive.array.groovy",
                "storage.type.primitive.groovy"
            ],
            "settings": { "foreground": "#46C0A8" }
        },
        {
            "name": "Types TS grammar specific",
            "scope": [
                "meta.type.cast.expr",
                "meta.type.new.expr",
                "support.constant.math",
                "support.constant.dom",
                "support.constant.json",
                "entity.other.inherited-class"
            ],
            "settings": { "foreground": "#46C0A8" }
        },
        {
            "name": "Control flow / Special keywords",
            "scope": [
                "keyword.control",
                "source.cpp keyword.operator.new",
                "keyword.operator.delete",
                "keyword.other.using",
                "keyword.other.operator",
                "entity.name.operator"
            ],
            "settings": { "foreground": "#BE80BA" }
        },
        {
            "name": "Variable and parameter name",
            "scope": [
                "variable",
                "meta.definition.variable.name",
                "support.variable",
                "entity.name.variable"
            ],
            "settings": { "foreground": "#96D4F4" }
        },
        {
            "name": "Constants and enums",
            "scope": ["variable.other.constant", "variable.other.enummember"],
            "settings": { "foreground": "#4CBECE" }
        },
        {
            "name": "Object keys",
            "scope": ["meta.object-literal.key"],
            "settings": { "foreground": "#96D4F4" }
        },
        {
            "name": "CSS property value",
            "scope": [
                "support.constant.property-value",
                "support.constant.font-name",
                "support.constant.media-type",
                "support.constant.media",
                "constant.other.color.rgb-value",
                "constant.other.rgb-value",
                "support.constant.color"
            ],
            "settings": { "foreground": "#C68870" }
        },
        {
            "name": "Punctuation",
            "scope": "punctuation",
            "settings": { "foreground": "#CCCCCC" }
        },
        {
            "name": "Namespace",
            "scope": ["entity.name.namespace", "entity.name.type.namespace"],
            "settings": { "foreground": "#CCCCCC" }
        },
        {
            "name": "Field",
            "scope": "entity.name.variable.field",
            "settings": { "foreground": "#CCCCCC" }
        },
        {
            "name": "Property",
            "scope": "variable.other.property",
            "settings": { "foreground": "#CCCCCC" }
        },
        {
            "name": "Constant",
            "scope": "variable.other.constant",
            "settings": { "foreground": "#CCCCCC" }
        },
        {
            "name": "Enum Member",
            "scope": "variable.other.enummember",
            "settings": { "foreground": "#CCCCCC" }
        },
        {
            "name": "Interface",
            "scope": "entity.name.type.interface",
            "settings": { "foreground": "#B4D49E" }
        },
        {
            "name": "Enum",
            "scope": "entity.name.type.enum",
            "settings": { "foreground": "#B4D49E" }
        },
        {
            "name": "Type Parameter",
            "scope": "entity.name.type.type-parameter",
            "settings": { "foreground": "#B4D49E" }
        },
        {
            "name": "Struct",
            "scope": "entity.name.type.struct",
            "settings": { "foreground": "#80BE8A" }
        },
        {
            "name": "Excluded Code",
            "scope": "support.other.excluded",
            "settings": { "foreground": "#747474" }
        },
        {
            "name": "Preprocessor Keyword",
            "scope": "keyword.preprocessor",
            "settings": { "foreground": "#747474" }
        },
        {
            "scope": "entity.name.label",
            "settings": { "foreground": "#C0C0C0" }
        },
        {
            "scope": [
                "punctuation.definition.group.regexp",
                "punctuation.definition.group.assertion.regexp",
                "punctuation.definition.character-class.regexp",
                "punctuation.character.set.begin.regexp",
                "punctuation.character.set.end.regexp",
                "keyword.operator.negation.regexp",
                "support.other.parenthesis.regexp"
            ],
            "settings": { "foreground": "#C68870" }
        },
        {
            "scope": [
                "constant.character.character-class.regexp",
                "constant.other.character-class.set.regexp",
                "constant.other.character-class.regexp",
                "constant.character.set.regexp"
            ],
            "settings": { "foreground": "#C86060" }
        },
        {
            "scope": [
                "keyword.operator.or.regexp",
                "keyword.control.anchor.regexp"
            ],
            "settings": { "foreground": "#CECE96" }
        },
        {
            "scope": "keyword.operator.quantifier.regexp",
            "settings": { "foreground": "#D0B474" }
        }
    ]
}
