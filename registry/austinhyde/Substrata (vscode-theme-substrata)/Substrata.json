        "terminal.ansiBrightYellow": "#d2b45f",
        "terminal.ansiBlue": "#8296b0",
        "terminal.ansiBrightBlue": "#a0b9d8",
        "terminal.ansiMagenta": "#a18daf",
        "terminal.ansiBrightMagenta": "#c6aed7",
