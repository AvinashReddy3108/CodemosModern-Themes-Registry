    "tokenColors": [
        {
            "scope": ["keyword"],
            "settings": { "foreground": "#dd6caef6", "fontStyle": "bold" }
        },
        {
            "scope": [
                "keyword.operator.expression.delete",
                "keyword.operator.delete"
            ],
            "settings": { "foreground": "#a00758", "fontStyle": "bold" }
        },
        {
            "scope": ["punctuation", "meta.brace", "meta.delimiter.comma"],
            "settings": { "foreground": "#7F90E0", "fontStyle": "italic bold" }
        },
        {
            "scope": "meta.object-literal.key",
            "settings": { "foreground": "#68b3d1a3" }
        },
        {
            "scope": [
                "meta.method-call.with-arguments",
                "meta.function-call.with-arguments",
                "entity.other.attribute-name"
            ],
            "settings": { "foreground": "#7F90E0", "fontStyle": "" }
        },
        {
            "scope": "entity.name.tag",
            "settings": { "foreground": "#7c63cc", "fontStyle": "" }
        },
        {
            "scope": "storage.type",
            "settings": { "foreground": "#8153ff", "fontStyle": "italic" }
        },
        {
            "scope": ["string"],
            "settings": { "foreground": "#e973e9", "fontStyle": "" }
        },
        {
            "scope": ["punctuation.definition.string"],
            "settings": { "foreground": "#7f90e0", "fontStyle": "italic bold" }
        },
        {
            "scope": "variable",
            "settings": { "foreground": "#D14081", "fontStyle": "" }
        },
        { "scope": "comment", "settings": { "foreground": "#757575" } },
        {
            "scope": "variable.other.object",
            "settings": { "foreground": "#a00758", "fontStyle": "bold" }
        },
        {
            "scope": ["entity", "meta.function-call"],
            "settings": { "foreground": "#a00758" }
        },
        {
            "scope": [
                "entity.name.type",
                "entity.other.inherited-class",
                "support.class"
            ],
            "settings": { "foreground": "#66069e", "fontStyle": "bold" }
        },
        {
            "scope": "meta.type.annotation",
            "settings": { "foreground": "#dd6caef6" }
        },
        {
            "scope": "variable.language.this",
            "settings": { "foreground": "#a00758" }
        }
    ]
}
