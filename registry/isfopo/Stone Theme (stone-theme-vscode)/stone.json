    "tokenColors": [
        {
            "scope": "comment",
            "settings": { "foreground": "#e2e2e366", "fontStyle": "italic" }
        },
        { "scope": "constant", "settings": { "foreground": "#FFFFFF" } },
        {
            "scope": "entity",
            "settings": { "foreground": "#9ECEDC", "fontStyle": "bold" }
        },
        {
            "scope": "invalid",
            "settings": {
                "foreground": "#FFFFFF",
                "fontStyle": "italic bold underline"
