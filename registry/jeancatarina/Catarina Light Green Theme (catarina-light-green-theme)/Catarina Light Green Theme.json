        "widget.shadow": "#232635",
        "editor.findMatchBorder": "#ffff",
        "editor.selectionHighlightBorder": "#ffffff23",
        "tab.hoverBorder": "#EEE7DA"
    },
    "tokenColors": [
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#AFC8AD", "fontStyle": "" }
        },
        {
            "scope": [
                "entity.name",
                "entity.name.type",
                "entity.name.type.class",
                "entity.name.class",
                "support.class",
                "entity.other.inherited-class",
                "source.java storage.modifier.import",
                "source.java storage.type"
            ],
            "settings": { "foreground": "#4D6D52" }
        },
        {
            "scope": [
                "keyword",
                "meta.selector",
                "markup.changed",
                "keyword.operator.new",
                "keyword.other.unsafe.rust"
            ],
            "settings": { "foreground": "#54775A" }
        },
        {
            "scope": [
                "source.c keyword.operator",
                "source.cpp keyword.operator",
                "source.cs keyword.operator",
                "source.elixir variable.definition",
                "source.elixir variable.anonymous",
                "source.go storage.type.string",
                "source.java keyword.operator.instanceof",
                "ng.attribute-with-value string",
                "source.python keyword.operator.logical.python",
                "source.java keyword.operator.instanceof"
            ],
            "settings": { "foreground": "#54775A" }
        },
        {
            "scope": [
                "variable",
                "variable.parameter",
                "function.definition",
                "punctuation.definition.variable",
                "punctuation.definition.variable.php",
                "punctuation.definition.variable.shell",
                "variable.interpolation",
                "support.type.object.module",
                "support.type.object.module.js",
                "support.type.object.module.ts",
                "support.type.property-name",
                "support.type.property-name.json",
                "meta.object-literal.key",
                "meta.object-literal.key.js",
                "meta.object-literal.key.ts",
                "meta.definition.variable",
                "meta.function-call.arguments",
                "entity.name.tag"
            ],
            "settings": { "foreground": "#000000" }
        },
        {
            "scope": ["keyword.control"],
            "settings": { "foreground": "#54775A" }
        },
        {
            "scope": [
                "keyword.operator",
                "meta.separator",
                "meta.tag",
                "meta.class.body",
                "meta.method-call",
                "meta.method",
                "punctuation.definition.method-parameters",
                "punctuation.definition.function-parameters",
                "punctuation.definition.parameters",
                "punctuation.definition.separator",
                "punctuation.definition.seperator",
                "punctuation.definition.array",
                "punctuation.definition.class",
                "punctuation.definition.arguments.begin",
                "punctuation.definition.arguments.end",
                "punctuation.separator",
                "punctuation.section.arguments",
                "punctuation.terminator.statement",
                "punctuation.section.block",
                "punctuation.section.class",
                "punctuation.section.parens",
                "meta.object.member",
                "meta.objectliteral"
            ],
            "settings": { "foreground": "#616161" }
        },
        {
            "scope": [
                "entity.name.function",
                "support.function.any-method",
                "entity.name.section",
                "meta.function-call.generic"
            ],
            "settings": { "foreground": "#293F6C" }
        },
        {
            "scope": ["support.function", "keyword.other.special-method"],
            "settings": { "foreground": "#C8A415" }
        },
        { "scope": ["string"], "settings": { "foreground": "#EEE7DA" } },
        {
            "scope": [
                "string.regexp",
                "string.regexp keyword.operator",
                "string.regexp constant.character",
                "string.interpolated",
                "meta.template.expression.js punctuation.definition",
                "meta.template.expression.ts punctuation.definition"
            ],
            "settings": { "foreground": "#8a2121" }
        },
        {
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#75536F" }
        },
        {
            "scope": [
                "constant",
                "constant.character",
                "constant.numeric",
                "constant.language",
                "support.variable",
                "entity.name.function.decorator"
            ],
            "settings": { "foreground": "#8e6700" }
        },
        {
            "scope": [
                "string.quoted punctuation",
                "string.quoted.double punctuation",
                "string.quoted.single punctuation",
                "support.type.property-name.json punctuation"
            ],
            "settings": { "foreground": "#000000" }
        },
        {
            "scope": [
                "storage",
                "storage.type",
                "storage.modifier.package",
                "storage.modifier.import"
            ],
            "settings": { "foreground": "#75536F" }
        },
        {
            "scope": [
                "keyword.other.unit",
                "constant.other.color",
                "constant.other.symbol",
                "entity.other",
                "markup.quote",
                "punctuation.definition.bold",
                "markup.bold",
                "markup.inline.raw.string"
            ],
            "settings": { "foreground": "#8e6700" }
        },
        {
            "scope": [
                "heading.1",
                "heading.2",
                "punctuation.definition.bold",
                "markup.bold"
            ],
            "settings": { "fontStyle": "bold" }
        },
        {
            "scope": "token.info-token",
            "settings": { "foreground": "#316BCD" }
        },
        {
            "scope": "token.warn-token",
            "settings": { "foreground": "#CD9731" }
        },
        {
            "scope": "token.error-token",
            "settings": { "foreground": "#8a2121" }
        },
        {
            "scope": "token.debug-token",
            "settings": { "foreground": "#800080" }
        }
    ]
}
