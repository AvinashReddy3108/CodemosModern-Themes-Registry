{
    "name": "FullSpectrum Spring Boot Light",
    "type": "light",
    "colors": {
        "editor.background": "#F8FBF7",
        "editor.foreground": "#263C2A",
        "editorLineNumber.foreground": "#A1B7A4",
        "editorLineNumber.activeForeground": "#4C8A5B",
        "editor.lineHighlightBackground": "#E3F2E6",
        "editor.selectionBackground": "#B4E4C144",
        "editor.inactiveSelectionBackground": "#B4E4C122",
        "editorCursor.foreground": "#4C8A5B",
        "editorWhitespace.foreground": "#C9DCCB",
        "editorIndentGuide.background1": "#D3E4D7",
        "editorIndentGuide.activeBackground1": "#4C8A5B44",
        "sideBar.background": "#F4F8F4",
        "sideBar.foreground": "#4D5D4F",
        "sideBar.border": "#C0D2C2",
        "activityBar.background": "#E6F2E7",
        "activityBar.foreground": "#4C8A5B",
        "activityBar.border": "#C0D2C2",
        "statusBar.background": "#D2E8D9",
        "statusBar.foreground": "#1F1F1F",
        "statusBar.debuggingBackground": "#9AB89D",
        "statusBar.debuggingForeground": "#000000",
        "statusBarItem.remoteBackground": "#4C8A5B",
        "statusBarItem.remoteForeground": "#FFFFFF",
        "statusBarItem.hoverBackground": "#386E47",
        "statusBarItem.prominentBackground": "#7BBF94",
        "statusBarItem.prominentForeground": "#1F1F1F",
        "titleBar.activeBackground": "#E4EFE8",
        "titleBar.activeForeground": "#304334",
        "titleBar.inactiveBackground": "#E4EFE8AA",
        "titleBar.inactiveForeground": "#7A9D81",
        "tab.activeBackground": "#E4EFE8",
        "tab.inactiveBackground": "#F8FBF7",
        "tab.activeForeground": "#304334",
        "tab.inactiveForeground": "#7A9D81",
        "tab.hoverBackground": "#D7EAD8",
        "tab.hoverForeground": "#2F3F2F",
        "tab.unfocusedActiveBackground": "#E4EFE8AA",
        "tab.unfocusedActiveForeground": "#5F7C64",
        "tab.border": "#C0D2C2",
        "tab.activeBorder": "#4C8A5B",
        "tab.unfocusedActiveBorder": "#9AB89D",
        "tab.activeModifiedBorder": "#C16D37",
        "tab.inactiveModifiedBorder": "#AF5C2B",
        "panel.background": "#FFFFFF",
        "panel.border": "#C0D2C2",
        "dropdown.background": "#F5F9F5",
        "dropdown.foreground": "#263C2A",
        "quickInput.background": "#F2F7F3",
        "quickInput.foreground": "#263C2A",
        "input.background": "#FFFFFF",
        "input.foreground": "#263C2A",
        "list.hoverBackground": "#D7EAD8",
        "list.activeSelectionBackground": "#C7E2C9",
        "list.inactiveSelectionBackground": "#E2F0E4"
    },
    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#8AA18E", "fontStyle": "italic" }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "storage.type",
                "storage.modifier",
                "keyword.control",
                "keyword.other"
            ],
            "settings": { "foreground": "#4C8A5B", "fontStyle": "bold" }
        },
        {
            "name": "Annotations",
            "scope": [
                "storage.type.annotation",
                "meta.annotation",
                "punctuation.definition.annotation"
            ],
            "settings": { "foreground": "#4FAD63", "fontStyle": "bold" }
        },
        {
            "name": "Spring-specific annotations",
            "scope": [
                "entity.name.annotation.springframework",
                "entity.name.annotation.spring",
                "meta.annotation.springframework"
            ],
            "settings": { "foreground": "#719F4D", "fontStyle": "bold" }
        },
        {
            "name": "Imports / Packages",
            "scope": [
                "meta.import",
                "keyword.control.import",
                "support.other.package"
            ],
            "settings": { "foreground": "#507F64" }
        },
        {
            "name": "Strings",
            "scope": ["string", "constant.other.symbol", "markup.quote"],
            "settings": { "foreground": "#C16D37" }
        },
        {
            "name": "Numbers",
            "scope": [
                "constant.numeric",
                "constant.language",
                "constant.character"
            ],
            "settings": { "foreground": "#D98C00" }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "meta.function",
                "meta.function-call",
                "support.function"
            ],
            "settings": { "foreground": "#4C8A5B" }
        },
        {
            "name": "Classes / Interfaces / Enums",
            "scope": [
                "entity.name.type.class",
                "support.class",
                "meta.class",
                "entity.name.type.interface",
                "entity.name.type.enum"
            ],
            "settings": { "foreground": "#416B4B", "fontStyle": "bold" }
        },
        {
            "name": "Object Types / Return Types",
            "scope": [
                "support.type",
                "entity.name.type",
                "storage.type.object"
            ],
            "settings": { "foreground": "#85B05E" }
        },
        {
            "name": "Variables",
            "scope": [
                "variable",
                "meta.definition.variable",
                "support.variable"
            ],
            "settings": { "foreground": "#2D3E2E" }
        },
        {
            "name": "Properties / Fields",
            "scope": ["variable.other.property", "support.variable.property"],
            "settings": { "foreground": "#638C72" }
        },
        {
            "name": "Punctuation / Operators",
            "scope": ["punctuation", "keyword.operator"],
            "settings": { "foreground": "#263C2A" }
        },
        {
            "name": "YAML Keys",
            "scope": [
                "entity.name.tag.yaml",
                "support.type.property-name.yaml"
            ],
            "settings": { "foreground": "#85B05E" }
        },
        {
            "name": "XML Tags",
            "scope": [
                "entity.name.tag.xml",
                "meta.tag.xml",
                "punctuation.definition.tag.xml"
            ],
            "settings": { "foreground": "#C16D37" }
        },
        {
            "name": ".properties keys",
            "scope": ["meta.key.properties", "support.type.property-name"],
            "settings": { "foreground": "#D98C00" }
        },
        {
            "name": "HTML Attributes / Tags",
            "scope": [
                "entity.other.attribute-name.html",
                "entity.name.tag",
                "meta.tag",
                "punctuation.definition.tag"
            ],
            "settings": { "foreground": "#4FAD63" }
        },
        {
            "name": "CSS Property Names",
            "scope": ["support.type.property-name.css"],
            "settings": { "foreground": "#85B05E" }
        },
        {
            "name": "CSS Property Values",
            "scope": ["support.constant.property-value.css"],
            "settings": { "foreground": "#638C72" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
