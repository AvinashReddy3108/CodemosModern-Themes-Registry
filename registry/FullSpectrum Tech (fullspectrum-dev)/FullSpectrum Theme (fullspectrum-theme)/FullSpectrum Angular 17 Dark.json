{
    "name": "FullSpectrum Angular 17 Dark",
    "type": "dark",
    "colors": {
        "editor.background": "#121212",
        "editor.foreground": "#ECECEC",
        "editorLineNumber.foreground": "#3C3C3C",
        "editorLineNumber.activeForeground": "#FF5370",
        "editor.lineHighlightBackground": "#1E1E1E66",
        "editor.selectionBackground": "#FF537044",
        "editor.inactiveSelectionBackground": "#FF537022",
        "editorCursor.foreground": "#FF5370",
        "editorWhitespace.foreground": "#333333",
        "editorIndentGuide.background1": "#2C2C2C",
        "editorIndentGuide.activeBackground1": "#FF537055",
        "sideBar.background": "#1C1C1C",
        "sideBar.foreground": "#CCCCCC",
        "sideBar.border": "#2E2E2E",
        "activityBar.background": "#1A1A1A",
        "activityBar.foreground": "#FF5370",
        "activityBar.border": "#333333",
        "statusBar.background": "#2A2A2A",
        "statusBar.foreground": "#ECECEC",
        "statusBar.debuggingBackground": "#B00020",
        "statusBar.debuggingForeground": "#FFFFFF",
        "statusBarItem.remoteBackground": "#FF5370",
        "statusBarItem.remoteForeground": "#FFFFFF",
        "statusBarItem.hoverBackground": "#E53935",
        "statusBarItem.prominentBackground": "#7E1E2A",
        "statusBarItem.prominentForeground": "#FFFFFF",
        "titleBar.activeBackground": "#1E1E1E",
        "titleBar.activeForeground": "#ECECEC",
        "titleBar.inactiveBackground": "#1E1E1ECC",
        "titleBar.inactiveForeground": "#AAAAAA",
        "tab.activeBackground": "#1E1E1E",
        "tab.inactiveBackground": "#121212",
        "tab.activeForeground": "#FFFFFF",
        "tab.inactiveForeground": "#777777",
        "tab.hoverBackground": "#2C2C2C",
        "tab.hoverForeground": "#FFFFFF",
        "tab.unfocusedActiveBackground": "#1E1E1EAA",
        "tab.unfocusedActiveForeground": "#AAAAAA",
        "tab.border": "#333333",
        "tab.activeBorder": "#FF5370",
        "tab.unfocusedActiveBorder": "#FF537055",
        "tab.activeModifiedBorder": "#E57373",
        "tab.inactiveModifiedBorder": "#A14444",
        "panel.background": "#1A1A1A",
        "panel.border": "#2C2C2C",
        "dropdown.background": "#212121",
        "dropdown.foreground": "#ECECEC",
        "quickInput.background": "#2A2A2A",
        "quickInput.foreground": "#ECECEC",
        "input.background": "#1F1F1F",
        "input.foreground": "#FFFFFF",
        "list.hoverBackground": "#333344",
        "list.activeSelectionBackground": "#3C2F4C",
        "list.inactiveSelectionBackground": "#2A2A3D"
    },
    "tokenColors": [
        {
            "name": "Angular Component Decorators",
            "scope": ["meta.decorator.ts", "meta.decorator.expression.ts"],
            "settings": { "foreground": "#FF5370", "fontStyle": "bold" }
        },
        {
            "name": "TypeScript Keywords",
            "scope": ["source.ts keyword", "source.tsx keyword"],
            "settings": { "foreground": "#FF5370", "fontStyle": "bold" }
        },
        {
            "name": "Interfaces",
            "scope": [
                "entity.name.type.interface.ts",
                "entity.name.type.interface"
            ],
            "settings": { "foreground": "#82AAFF", "fontStyle": "italic" }
        },
        {
            "name": "Angular HTML Templates",
            "scope": ["text.html.ng", "source.html"],
            "settings": { "foreground": "#FF5370" }
        },
        {
            "name": "SCSS Variables",
            "scope": ["variable.scss", "support.variable.scss"],
            "settings": { "foreground": "#C792EA" }
        },
        {
            "name": "SCSS Property",
            "scope": ["support.type.property-name.scss"],
            "settings": { "foreground": "#FFCB6B" }
        },
        {
            "name": "SCSS Value",
            "scope": [
                "constant.other.color.rgb-value.scss",
                "constant.other.color.hex-value.scss"
            ],
            "settings": { "foreground": "#FF8F40" }
        },
        {
            "name": "Angular HTML Attribute Bindings",
            "scope": [
                "entity.other.attribute-name.html.ng",
                "meta.attribute.html.ng"
            ],
            "settings": { "foreground": "#FF5370" }
        },
        {
            "name": "Directive Brackets",
            "scope": [
                "punctuation.definition.tag.begin.html.ng",
                "punctuation.definition.tag.end.html.ng"
            ],
            "settings": { "foreground": "#FF5370" }
        },
        {
            "name": "JSON Keys",
            "scope": [
                "support.type.property-name.json",
                "meta.object-literal.key"
            ],
            "settings": { "foreground": "#82AAFF" }
        },
        {
            "name": "Markdown Headings",
            "scope": ["markup.heading.markdown"],
            "settings": { "foreground": "#FF5370", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Emphasis",
            "scope": ["markup.italic.markdown", "markup.bold.markdown"],
            "settings": { "fontStyle": "italic bold", "foreground": "#FFFFFF" }
        },
        {
            "name": "Markdown Code",
            "scope": ["markup.inline.raw.markdown"],
            "settings": { "foreground": "#FFCB6B" }
        },
        {
            "name": "Environment Variables",
            "scope": ["constant.language.env"],
            "settings": { "foreground": "#C3E88D" }
        },
        {
            "name": "Generic Strings",
            "scope": ["string"],
            "settings": { "foreground": "#C3E88D" }
        },
        {
            "name": "Generic Numbers",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#F78C6C" }
        },
        {
            "name": "Generic Variables",
            "scope": ["variable", "meta.definition.variable"],
            "settings": { "foreground": "#FFCB6B" }
        },
        {
            "name": "Function Names",
            "scope": ["entity.name.function", "meta.function-call"],
            "settings": { "foreground": "#FF5370" }
        },
        {
            "name": "Component Class Names",
            "scope": ["entity.name.type.class"],
            "settings": { "foreground": "#82AAFF", "fontStyle": "bold" }
        },
        {
            "name": "Control Flow Keywords",
            "scope": ["keyword.control"],
            "settings": { "foreground": "#FF5370" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
