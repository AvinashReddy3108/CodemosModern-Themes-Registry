        "minimapSlider.activeBackground": "#00C806b0",
        "minimapSlider.background": "#00C80680",
        "minimapSlider.hoverBackground": "#00C806a0",
        "notificationLink.foreground": "#7928CA",
        "notifications.background": "#111111",
        "notifications.foreground": "#FFFFFF",
        "panel.background": "#111111",
        "panel.border": "#11111160",
        "panelTitle.activeBorder": "#7928CA",
        "panelTitle.activeForeground": "#888888",
        "panelTitle.inactiveForeground": "#FFFFFF",
        "peekView.border": "#11111130",
        "peekViewEditor.background": "#FFFFFF05",
        "peekViewEditor.matchHighlightBackground": "#7928CA50",
        "peekViewEditorGutter.background": "#FFFFFF05",
        "peekViewResult.background": "#FFFFFF05",
        "peekViewResult.matchHighlightBackground": "#7928CA50",
        "peekViewResult.selectionBackground": "#7928CA70",
        "peekViewTitle.background": "#FFFFFF05",
        "peekViewTitleDescription.foreground": "#FFFFFF60",
        "pickerGroup.foreground": "#7928CA",
        "progressBar.background": "#7928CA",
        "scrollbar.shadow": "#11111100",
        "scrollbarSlider.activeBackground": "#7928CAcc",
        "scrollbarSlider.background": "#7928CAbb",
        "scrollbarSlider.hoverBackground": "#7928CAee",
        "selection.background": "#7928CA",
        "settings.checkboxBackground": "#111111",
        "settings.checkboxForeground": "#FFFFFF",
        "settings.dropdownBackground": "#111111",
        "settings.dropdownForeground": "#FFFFFF",
        "settings.headerForeground": "#7928CA",
        "settings.modifiedItemIndicator": "#7928CA",
        "settings.numberInputBackground": "#111111",
        "settings.numberInputForeground": "#FFFFFF",
        "settings.textInputBackground": "#111111",
        "settings.textInputForeground": "#FFFFFF",
        "sideBar.background": "#111111",
        "sideBar.border": "#7928CA50",
        "sideBar.foreground": "#79FFE1",
        "sideBarSectionHeader.background": "#111111",
        "sideBarSectionHeader.border": "#11111160",
        "sideBarSectionHeader.foreground": "#79FFE1",
        "sideBarTitle.foreground": "#FFFFFF",
        "statusBar.background": "#444444",
        "statusBar.border": "#11111160",
        "statusBar.debuggingBackground": "#FFF500",
        "statusBar.debuggingForeground": "#888888",
        "statusBar.foreground": "#FFFFFF",
        "statusBar.noFolderBackground": "#111111",
        "statusBarItem.hoverBackground": "#7928CA20",
        "statusBarItem.remoteBackground": "#7928CA",
        "statusBarItem.remoteForeground": "#111111",
        "tab.activeBackground": "#7928CA50",
        "tab.activeBorder": "#7928CA",
        "tab.activeForeground": "#888888",
        "tab.activeModifiedBorder": "#7928CA",
        "tab.border": "#111111",
        "tab.inactiveBackground": "#7928CA20",
        "tab.inactiveForeground": "#FFFFFFaf",
        "tab.unfocusedActiveBorder": "#7928CA",
        "tab.unfocusedActiveBackground": "#7928CA40",
        "tab.unfocusedActiveForeground": "#FFFFFF",
        "tab.unfocusedInactiveBackground": "#7928CA10",
        "tab.unfocusedInactiveForeground": "#FFFFFF7f",
        "terminal.ansiBlack": "#111111",
        "terminal.ansiBlue": "#79FFE1",
        "terminal.ansiBrightBlack": "#7928CA",
        "terminal.ansiBrightBlue": "#79FFE1",
        "terminal.ansiBrightCyan": "#AAFFEC",
        "terminal.ansiBrightGreen": "#00C806",
        "terminal.ansiBrightMagenta": "#FFF500",
        "terminal.ansiBrightRed": "#FF0080",
        "terminal.ansiBrightWhite": "#888888",
        "terminal.ansiBrightYellow": "#FFF500",
        "terminal.ansiCyan": "#AAFFEC",
        "terminal.ansiGreen": "#00C806",
        "terminal.ansiMagenta": "#FFF500",
        "terminal.ansiRed": "#FF0080",
        "terminal.ansiWhite": "#888888",
        "terminal.ansiYellow": "#FFF500",
        "terminalCursor.background": "#111111",
        "terminalCursor.foreground": "#FFF500",
        "textLink.activeForeground": "#FFFFFF",
        "textLink.foreground": "#7928CA",
        "titleBar.activeBackground": "#111111",
        "titleBar.activeForeground": "#FFFFFF",
        "titleBar.border": "#11111160",
        "titleBar.inactiveBackground": "#111111",
        "titleBar.inactiveForeground": "#7928CA",
        "tree.indentGuidesStroke": "#444444",
        "widget.shadow": "#11111130"
    },
    "tokenColors": [
        {
            "scope": [
                "variable",
                "string constant.other.placeholder",
                "invalid.deprecated",
                "keyword",
                "storage.type",
                "storage.modifier"
            ],
            "settings": { "foreground": "#FFF500" }
        },
        {
            "scope": [
                "variable",
                "string constant.other.placeholder",
                "entity.name.function",
                "punctuation.definition.interpolation.end.bracket.curly.scss",
                "punctuation.definition.interpolation.begin.bracket.curly.scss"
            ],
            "settings": { "fontStyle": "italic" }
        },
        {
            "scope": [
                "punctuation.definition.interpolation.end.bracket.curly.scss",
                "punctuation.definition.interpolation.begin.bracket.curly.scss"
            ],
            "settings": { "foreground": "#00C806" }
        },
        {
            "scope": ["constant.other.php"],
            "settings": { "foreground": "#FFF500" }
        },
        {
            "scope": ["constant.other.color"],
            "settings": { "foreground": "#888888" }
        },
        {
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#FF0080" }
        },
        {
            "scope": ["Keyword", "Storage"],
            "settings": { "fontStyle": "italic" }
        },
        {
            "scope": [
                "keyword.control",
                "constant.other.color",
                "punctuation.definition.tag",
                "punctuation",
                "punctuation.separator.inheritance.php",
                "punctuation.definition.tag.html",
                "punctuation.section.embedded",
                "keyword.other.template",
                "keyword.other.substitution",
                "entity.name.tag.reference.scss"
            ],
            "settings": { "foreground": "#A7A8AF" }
        },
        {
            "scope": [
                "punctuation.definition.tag.begin.html",
                "punctuation.definition.tag.end.html",
                "entity.name.type.module.js"
            ],
            "settings": { "foreground": "#50E3C2" }
        },
        {
            "scope": [
                "keyword.control.at-rule",
                "punctuation.terminator.rule.css",
                "keyword.control.operator",
                "punctuation.definition.entity.css",
                "keyword.operator.assignment.js",
                "punctuation.separator.comma.js",
                "punctuation.definition.string.begin.js",
                "punctuation.definition.string.end.js",
                "punctuation.definition.binding-pattern.object.js"
            ],
            "settings": { "foreground": "#FFFFFF" }
        },
        {
            "scope": ["punctuation.definition", "string.quoted.single.scss"],
            "settings": { "foreground": "#A7A8AF" }
        },
        { "scope": ["keyword.control"], "settings": { "fontStyle": "bold" } },
        {
            "scope": [
                "comment.line.scss",
                "comment.line.double-slash.js",
                "punctuation.definition.comment.scss",
                "punctuation.definition.comment.js",
                "punctuation.definition.comment.html",
                "comment.block.html"
            ],
            "settings": { "foreground": "#6D6F7C" }
        },
        {
            "scope": ["text.html.derivative"],
            "settings": { "foreground": "#A7A8AF" }
        },
        {
            "scope": [
                "entity.name.tag",
                "meta.tag.sgml",
                "markup.deleted.git_gutter"
            ],
            "settings": { "foreground": "#FFFFFF" }
        },
        {
            "scope": ["entity.name.tag.html"],
            "settings": { "fontStyle": "bold" }
        },
        {
            "scope": [
                "variable.parameter.js",
                "variable.parameter.keyframe-list.css"
            ],
            "settings": { "foreground": "#FFF500" }
        },
        {
            "scope": [
                "variable.other.object.js",
                "storage.type.js",
                "string.other.link.title.markdown",
                "variable.other.readwrite.js",
                "variable.other.property.js"
            ],
            "settings": { "foreground": "#50E3C2", "fontStyle": "" }
        },
        {
            "scope": [
                "string",
                "string.quoted.double.html",
                "variable.other.constant.js",
                "variable.other.object.property.js",
                "string.quoted.double.json",
                "markup.fenced_code.block.markdown",
                "markup.inline.raw.string.markdown",
                "variable.function",
                "keyword.other.special-method",
                "entity.name.function",
                "markup.bold",
                "markup.bold.markdown",
                "markup.italic.markdown",
                "meta.class-method.js entity.name.function.js",
                "variable.function.constructor",
                "entity.name.tag.other.html",
                "entity.name.tag.block.any.html",
                "source.sass keyword.control"
            ],
            "settings": { "foreground": "#79FFE1" }
        },
        {
            "scope": [
                "punctuation.definition.string.begin.html",
                "punctuation.definition.string.end.html"
            ],
            "settings": { "foreground": "#AAFFEC" }
        },
        {
            "scope": [
                "support.other.variable",
                "string.other.link",
                "markup.table"
            ],
            "settings": { "foreground": "#FFFFFF" }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.language",
                "constant.character",
                "constant.escape",
                "keyword.other.unit",
                "keyword.other",
                "punctuation.separator.key-value.html"
            ],
            "settings": { "foreground": "#FFF500" }
        },
        {
            "scope": [
                "variable.parameter.function.language.special",
                "variable.parameter"
            ],
            "settings": { "foreground": "#FF0080" }
        },
        {
            "scope": [
                "constant.other.symbol",
                "constant.other.key",
                "entity.other.inherited-class",
                "keyword.other.unit",
                "markup.heading",
                "markup.inserted.git_gutter",
                "meta.group.braces.curly",
                "constant.other.object.key.js",
                "string.unquoted.label.js"
            ],
            "settings": { "foreground": "#00C806", "fontStyle": "" }
        },
        {
            "scope": [
                "entity.name",
                "support.type",
                "support.class",
                "support.orther.namespace.use.php",
                "meta.use.php",
                "support.other.namespace.php",
                "markup.changed.git_gutter",
                "support.type.sys-types",
                "entity.other.attribute-name.html"
            ],
            "settings": { "foreground": "#FFF500" }
        },
        { "scope": ["support.type"], "settings": { "foreground": "#B2CCD6" } },
        {
            "scope": [
                "source.css support.type.property-name",
                "source.sass support.type.property-name",
                "source.scss support.type.property-name",
                "source.less support.type.property-name",
                "source.stylus support.type.property-name",
                "source.postcss support.type.property-name"
            ],
            "settings": { "foreground": "#50E3C2" }
        },
        {
            "scope": [
                "entity.name.module.js",
                "variable.import.parameter.js",
                "variable.other.class.js"
            ],
            "settings": { "foreground": "#FF0080" }
        },
        {
            "scope": [
                "entity.name.method.js",
                "tag.decorator.js entity.name.tag.js",
                "tag.decorator.js punctuation.definition.tag.js"
            ],
            "settings": { "foreground": "#79FFE1", "fontStyle": "italic" }
        },
        {
            "scope": ["entity.other.attribute-name", "support.function"],
            "settings": { "foreground": "#FFF500" }
        },
        {
            "scope": [
                "entity.other.attribute-name.id",
                "entity.other.attribute-name.class",
                "entity.other.attribute-name.pseudo-class",
                "entity.name.tag.css",
                "keyword.control.conditional.js",
                "support.constant",
                "entity.other.attribute-name.html",
                "string.quoted.single.js",
                "storage.type.function.js",
                "meta.object-literal.key"
            ],
            "settings": { "foreground": "#FFFFFF" }
        },
        {
            "scope": ["source.scss keyword.control"],
            "settings": { "foreground": "#FFF500" }
        },
        {
            "scope": ["markup.inserted"],
            "settings": { "foreground": "#00C806" }
        },
        {
            "scope": ["markup.deleted"],
            "settings": { "foreground": "#FF0080" }
        },
        {
            "scope": ["markup.changed"],
            "settings": { "foreground": "#FFF500" }
        },
        { "scope": ["string.regexp"], "settings": { "foreground": "#AAFFEC" } },
        {
            "scope": ["constant.character.escape"],
            "settings": { "foreground": "#AAFFEC" }
        },
        {
            "scope": ["*url*", "*link*", "*uri*"],
            "settings": { "fontStyle": "underline" }
        },
        {
            "scope": [
                "source.js constant.other.object.key.js string.unquoted.label.js"
            ],
            "settings": { "foreground": "#FFFFFF", "fontStyle": "italic" }
        },
        {
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#FFFFFF" }
        },
        {
            "scope": [
                "text.html.markdown",
                "punctuation.definition.list_item.markdown"
            ],
            "settings": { "foreground": "#FFFFFF" }
        },
        {
            "scope": ["text.html.markdown markup.inline.raw.markdown"],
            "settings": { "foreground": "#FFF500" }
        },
        {
            "scope": [
                "text.html.markdown markup.inline.raw.markdown",
                "punctuation.definition.raw.markdown"
            ],
            "settings": { "foreground": "#7928CA50" }
        },
        {
            "scope": ["text.html.markdown meta.dummy.line-break"],
            "settings": {}
        },
        {
            "scope": [
                "markdown.heading",
                "markup.heading | markup.heading entity.name",
                "markup.heading.markdown punctuation.definition.heading.markdown",
                "entity.name.section.markdown"
            ],
            "settings": { "foreground": "#50E3C2", "fontStyle": "bold" }
        },
        {
            "scope": ["markup.underline"],
            "settings": { "foreground": "#79FFE1", "fontStyle": "underline" }
        },
        { "scope": ["markup.strike"], "settings": { "fontStyle": "" } },
        {
            "scope": [
                "markup.quote punctuation.definition.blockquote.markdown"
            ],
            "settings": { "foreground": "#7928CA50" }
        },
        { "scope": ["markup.quote"], "settings": { "fontStyle": "italic" } },
        {
            "scope": ["string.other.link.description.title.markdown"],
            "settings": { "foreground": "#FFF500" }
        },
        {
            "scope": ["constant.other.reference.link.markdown"],
            "settings": { "foreground": "#FFF500" }
        },
        {
            "scope": ["markup.raw.block"],
            "settings": { "foreground": "#FFF500" }
        },
        {
            "scope": [
                "punctuation.definition.raw.markdown",
                "punctuation.definition.markdown"
            ],
            "settings": { "foreground": "#AAFFEC" }
        },
        {
            "scope": ["variable.language.fenced.markdown"],
            "settings": { "foreground": "#7928CA" }
        },
        {
            "scope": ["meta.separator"],
            "settings": { "foreground": "#A7A8AF", "fontStyle": "bold" }
        },
        {
            "scope": "token.info-token",
            "settings": { "foreground": "#7928CA" }
        },
        {
            "scope": "token.warn-token",
            "settings": { "foreground": "#FFF500" }
        },
        {
            "scope": "token.error-token",
            "settings": { "foreground": "#FF293B" }
        },
        {
            "scope": "token.debug-token",
            "settings": { "foreground": "#AAFFEC" }
        }
    ]
}
