        "gitDecoration.ignoredResourceForeground": "#7928CA",
        "gitDecoration.modifiedResourceForeground": "#50E3C2",
        "gitDecoration.untrackedResourceForeground": "#79FFE1",
        "input.background": "#333333",
        "input.border": "#88888810",
