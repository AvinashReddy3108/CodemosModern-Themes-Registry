    "semanticHighlighting": true,
    "semanticTokenColors": {
        "class": { "foreground": "#CAE682", "fontStyle": "" },
        "interface": { "foreground": "#CAE682", "fontStyle": "" },
        "templateType": { "foreground": "#CAE682", "fontStyle": "" },
        "type": { "foreground": "#CAE682", "fontStyle": "" },
        "class.abstract": { "foreground": "#3EABE6", "fontStyle": "italic" },
        "enum": { "foreground": "#E2E2E2", "fontStyle": "" },
        "enumMember": { "foreground": "#53DCCD", "fontStyle": "" },
        "typeParameter": { "foreground": "#FFFFFF", "fontStyle": "" },
        "function": { "foreground": "#DFBE95", "fontStyle": "" },
        "method": { "foreground": "#DFBE95", "fontStyle": "" },
        "function.static": { "foreground": "#C4C4B7", "fontStyle": "" },
        "method.static": { "foreground": "#C4C4B7", "fontStyle": "" },
        "function.declaration": { "foreground": "#DFBE95", "fontStyle": "" },
        "method.declaration": { "foreground": "#DFBE95", "fontStyle": "" },
        "method.declaration.deprecated": {
            "foreground": "#E2E2E2",
            "fontStyle": "italic strikethrough"
        },
        "function.declaration.deprecated": {
            "foreground": "#E2E2E2",
            "fontStyle": "italic strikethrough"
        },
        "*.constructor": { "foreground": "#DFBE95", "fontStyle": "" },
        "parameter": { "foreground": "#D4C4A9", "fontStyle": "" },
        "variable": { "foreground": "#D4C4A9", "fontStyle": "" },
        "variable.declaration": { "foreground": "#D4C4A9", "fontStyle": "" },
        "variable.static": { "foreground": "#93A2CC", "fontStyle": "" },
        "variable.static.readonly": {
            "foreground": "#53DCCD",
            "fontStyle": ""
        },
        "property": { "foreground": "#B3B784", "fontStyle": "" },
        "property.static": { "foreground": "#93A2CC", "fontStyle": "" },
        "property.static.readonly": {
            "foreground": "#53DCCD",
            "fontStyle": ""
        },
        "*.deprecated": {
            "foreground": "#E2E2E2",
            "fontStyle": "italic strikethrough"
        },
        "method.deprecated": {
            "foreground": "#E2E2E2",
            "fontStyle": "italic strikethrough"
        },
        "function.deprecated": {
            "foreground": "#E2E2E2",
            "fontStyle": "italic strikethrough"
        },
        "*.importDeclaration": { "foreground": "#FFFFFF", "fontStyle": "" },
        "*.abstract.importDeclaration": {
            "foreground": "#FFFFFF",
            "fontStyle": "italic"
        },
        "annotation": { "foreground": "#808080", "fontStyle": "italic" },
        "annotationMember": { "foreground": "#EB4B50", "fontStyle": "" },
        "namespace.annotation": {
            "foreground": "#808080",
            "fontStyle": "italic"
        },
        "decorator": { "foreground": "#808080", "fontStyle": "italic" },
        "decorator.python": { "foreground": "#808080", "fontStyle": "italic" },
        "class.decorator": { "foreground": "#808080", "fontStyle": "italic" },
        "*.decorator": { "foreground": "#808080", "fontStyle": "italic" },
        "*.builtin.decorator": {
            "foreground": "#808080",
            "fontStyle": "italic"
        },
        "namespace.documentation": { "foreground": "#E2E2E2", "fontStyle": "" },
        "variable.go": { "foreground": "#D4C4A9", "fontStyle": "" },
        "parameter.go": { "foreground": "#D4C4A9", "fontStyle": "" },
