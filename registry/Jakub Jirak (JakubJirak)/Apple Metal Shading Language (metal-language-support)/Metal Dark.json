{
    "name": "Metal Dark",
    "type": "dark",
    "colors": {
        "editor.background": "#1a1a1a",
        "editor.foreground": "#d4d4d4",
        "editorCursor.foreground": "#a7a7a7",
        "editor.lineHighlightBackground": "#2a2a2a",
        "editor.selectionBackground": "#094771",
        "editor.selectionHighlightBackground": "#add6ff26"
    },
    "tokenColors": [
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "fontStyle": "italic", "foreground": "#6A9955" }
        },
        {
            "scope": ["keyword.metal.function", "keyword.control.metal"],
            "settings": { "foreground": "#C586C0" }
        },
        {
            "scope": ["keyword.metal.address-space", "keyword.metal.access"],
            "settings": { "foreground": "#4FC1FF" }
        },
        {
            "scope": [
                "support.type.metal.scalar",
                "support.type.metal.vector",
                "support.type.metal.matrix",
                "storage.type.metal"
            ],
            "settings": { "foreground": "#4EC9B0" }
        },
        {
            "scope": [
                "support.type.metal.texture",
                "support.type.metal.sampler"
            ],
            "settings": { "foreground": "#FFD700" }
        },
        {
            "scope": [
                "support.function.metal.math",
                "support.function.metal.geometric",
                "support.function.metal.texture",
                "support.function.metal.thread",
                "support.function.metal.atomic"
            ],
            "settings": { "foreground": "#DCDCAA" }
        },
        {
            "scope": ["support.other.attribute.metal"],
            "settings": { "foreground": "#9CDCFE" }
        },
        {
            "scope": [
                "constant.numeric.metal",
                "constant.numeric.metal.float",
                "constant.numeric.metal.hex",
                "constant.numeric.metal.integer"
            ],
            "settings": { "foreground": "#B5CEA8" }
        },
        {
            "scope": ["constant.language.metal"],
            "settings": { "foreground": "#569CD6" }
        },
        {
            "scope": [
                "string.quoted.double.metal",
                "string.quoted.single.metal"
            ],
            "settings": { "foreground": "#CE9178" }
        },
        {
            "scope": [
                "keyword.operator.arithmetic.metal",
                "keyword.operator.comparison.metal",
                "keyword.operator.logical.metal",
                "keyword.operator.assignment.metal"
            ],
            "settings": { "foreground": "#D4D4D4" }
        },
        {
            "scope": [
                "meta.preprocessor.metal",
                "keyword.control.directive.metal"
            ],
            "settings": { "foreground": "#9B9B9B" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
