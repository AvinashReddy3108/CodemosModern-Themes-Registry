{
    "name": "Nothing Dark",
    "type": "dark",
    "colors": {
        "editor.background": "#0a0a0a",
        "editor.foreground": "#e8e8e8",
        "editorCursor.foreground": "#ffffff",
        "editor.selectionBackground": "#333333",
        "editor.inactiveSelectionBackground": "#2a2a2a",
        "editor.lineHighlightBackground": "#1a1a1a",
        "editorLineNumber.foreground": "#666666",
        "editorLineNumber.activeForeground": "#cccccc",
        "editorIndentGuide.background": "#2a2a2a",
        "editorIndentGuide.activeBackground": "#444444",
        "editorWhitespace.foreground": "#333333",
        "activityBar.background": "#000000",
        "activityBar.foreground": "#cccccc",
        "activityBar.inactiveForeground": "#666666",
        "activityBar.border": "#1a1a1a",
        "activityBarBadge.background": "#ffffff",
        "activityBarBadge.foreground": "#000000",
        "sideBar.background": "#0f0f0f",
        "sideBar.foreground": "#cccccc",
        "sideBar.border": "#1a1a1a",
        "sideBarTitle.foreground": "#ffffff",
        "sideBarSectionHeader.background": "#1a1a1a",
        "sideBarSectionHeader.foreground": "#ffffff",
        "statusBar.background": "#000000",
        "statusBar.foreground": "#cccccc",
        "statusBar.border": "#1a1a1a",
        "statusBar.noFolderBackground": "#000000",
        "statusBar.debuggingBackground": "#1a1a1a",
        "titleBar.activeBackground": "#000000",
        "titleBar.activeForeground": "#cccccc",
        "titleBar.inactiveBackground": "#0a0a0a",
        "titleBar.inactiveForeground": "#666666",
        "titleBar.border": "#1a1a1a",
        "tab.activeBackground": "#0a0a0a",
        "tab.activeForeground": "#ffffff",
        "tab.inactiveBackground": "#1a1a1a",
        "tab.inactiveForeground": "#888888",
        "tab.border": "#333333",
        "tab.activeBorder": "#ffffff",
        "tab.activeBorderTop": "#ffffff",
        "editorGroupHeader.tabsBackground": "#1a1a1a",
        "editorGroupHeader.border": "#333333",
        "panel.background": "#0f0f0f",
        "panel.border": "#333333",
        "panelTitle.activeForeground": "#ffffff",
        "panelTitle.inactiveForeground": "#888888",
        "panelTitle.activeBorder": "#ffffff",
        "terminal.background": "#0a0a0a",
        "terminal.foreground": "#e8e8e8",
        "terminal.ansiBlack": "#000000",
        "terminal.ansiRed": "#999999",
        "terminal.ansiGreen": "#cccccc",
        "terminal.ansiYellow": "#dddddd",
        "terminal.ansiBlue": "#bbbbbb",
        "terminal.ansiMagenta": "#aaaaaa",
        "terminal.ansiCyan": "#cccccc",
        "terminal.ansiWhite": "#ffffff",
        "terminal.ansiBrightBlack": "#333333",
        "terminal.ansiBrightRed": "#bbbbbb",
        "terminal.ansiBrightGreen": "#dddddd",
        "terminal.ansiBrightYellow": "#eeeeee",
        "terminal.ansiBrightBlue": "#cccccc",
        "terminal.ansiBrightMagenta": "#cccccc",
        "terminal.ansiBrightCyan": "#dddddd",
        "terminal.ansiBrightWhite": "#ffffff",
        "button.background": "#333333",
        "button.foreground": "#ffffff",
        "button.hoverBackground": "#444444",
        "dropdown.background": "#1a1a1a",
        "dropdown.border": "#333333",
        "dropdown.foreground": "#cccccc",
        "input.background": "#1a1a1a",
        "input.border": "#333333",
        "input.foreground": "#ffffff",
        "input.placeholderForeground": "#666666",
        "list.activeSelectionBackground": "#333333",
        "list.activeSelectionForeground": "#ffffff",
        "list.inactiveSelectionBackground": "#2a2a2a",
        "list.inactiveSelectionForeground": "#cccccc",
        "list.hoverBackground": "#2a2a2a",
        "list.hoverForeground": "#ffffff",
        "scrollbar.shadow": "#000000",
        "scrollbarSlider.background": "#333333",
        "scrollbarSlider.hoverBackground": "#444444",
        "scrollbarSlider.activeBackground": "#555555",
        "editorWidget.background": "#1a1a1a",
        "editorWidget.border": "#333333",
        "editorSuggestWidget.background": "#1a1a1a",
        "editorSuggestWidget.border": "#333333",
        "editorSuggestWidget.foreground": "#cccccc",
        "editorSuggestWidget.selectedBackground": "#333333",
        "notifications.background": "#1a1a1a",
        "notifications.foreground": "#cccccc",
        "notifications.border": "#333333",
        "badge.background": "#ffffff",
        "badge.foreground": "#000000",
        "progressBar.background": "#ffffff",
        "editorError.foreground": "#888888",
        "editorWarning.foreground": "#aaaaaa",
        "editorInfo.foreground": "#cccccc",
        "editorGutter.background": "#0a0a0a",
        "editorGutter.modifiedBackground": "#666666",
        "editorGutter.addedBackground": "#888888",
        "editorGutter.deletedBackground": "#555555",
        "diffEditor.insertedTextBackground": "#2a2a2a",
        "diffEditor.removedTextBackground": "#1a1a1a",
        "merge.currentHeaderBackground": "#333333",
        "merge.incomingHeaderBackground": "#2a2a2a",
        "merge.border": "#444444",
        "editorOverviewRuler.border": "#333333",
        "editorOverviewRuler.errorForeground": "#666666",
        "editorOverviewRuler.warningForeground": "#888888",
        "editorOverviewRuler.infoForeground": "#aaaaaa"
    },
    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "fontStyle": "italic", "foreground": "#666666" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "string constant.other.placeholder"],
            "settings": { "foreground": "#e8e8e8" }
        },
        {
            "name": "Colors",
            "scope": ["constant.other.color"],
            "settings": { "foreground": "#ffffff" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#888888" }
        },
        {
            "name": "Keyword, Storage",
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#cccccc" }
        },
        {
            "name": "Operator, Misc",
            "scope": [
                "keyword.control",
                "constant.other.color",
                "punctuation",
                "meta.tag",
                "punctuation.definition.tag",
                "punctuation.separator.inheritance.php",
                "punctuation.definition.block.tag.jsdoc",
                "punctuation.definition.tag.html",
                "punctuation.definition.tag.begin.html",
                "punctuation.definition.tag.end.html",
                "punctuation.section.embedded",
                "keyword.other.template",
                "keyword.other.substitution"
            ],
            "settings": { "foreground": "#aaaaaa" }
        },
        {
            "name": "Tag",
            "scope": [
                "entity.name.tag",
                "meta.tag.sgml",
                "markup.deleted.git_gutter"
            ],
            "settings": { "foreground": "#dddddd" }
        },
        {
            "name": "Function, Special Method",
            "scope": [
                "entity.name.function",
                "meta.function-call",
                "variable.function",
                "support.function",
                "keyword.other.special-method"
            ],
            "settings": { "foreground": "#ffffff" }
        },
        {
            "name": "Block Level Variables",
            "scope": ["meta.block variable.other"],
            "settings": { "foreground": "#e8e8e8" }
        },
        {
            "name": "Other Variable, String Link",
            "scope": ["support.other.variable", "string.other.link"],
            "settings": { "foreground": "#dddddd" }
        },
        {
            "name": "Number, Constant, Function Argument, Tag Attribute, Embedded",
            "scope": [
                "constant.numeric",
                "constant.language",
                "support.constant",
                "constant.character",
                "constant.escape",
                "variable.parameter",
                "keyword.other.unit",
                "keyword.other"
            ],
            "settings": { "foreground": "#bbbbbb" }
        },
        {
            "name": "String, Symbols, Inherited Class, Markup Heading",
            "scope": [
                "string",
                "constant.other.symbol",
                "constant.other.key",
                "entity.other.inherited-class",
                "markup.heading",
                "markup.inserted.git_gutter",
                "meta.group.braces.curly constant.other.object.key.js string.unquoted.label.js"
            ],
            "settings": { "foreground": "#cccccc" }
        },
        {
            "name": "Class, Support",
            "scope": [
                "entity.name",
                "support.type",
                "support.class",
                "support.other.namespace.use.php",
                "meta.use.php",
                "support.other.namespace.php",
                "markup.changed.git_gutter",
                "support.type.sys-types"
            ],
            "settings": { "foreground": "#ffffff" }
        },
        {
            "name": "Entity Types",
            "scope": ["support.type"],
            "settings": { "foreground": "#dddddd" }
        },
        {
            "name": "CSS Class and Support",
            "scope": [
                "source.css support.type.property-name",
                "source.sass support.type.property-name",
                "source.scss support.type.property-name",
                "source.less support.type.property-name",
                "source.stylus support.type.property-name",
                "source.postcss support.type.property-name"
            ],
            "settings": { "foreground": "#cccccc" }
        },
        {
            "name": "Sub-methods",
            "scope": [
                "entity.name.module.js",
                "variable.import.parameter.js",
                "variable.other.class.js"
            ],
            "settings": { "foreground": "#bbbbbb" }
        },
        {
            "name": "Language methods",
            "scope": ["variable.language"],
            "settings": { "fontStyle": "italic", "foreground": "#aaaaaa" }
        },
        {
            "name": "entity.name.method.js",
            "scope": ["entity.name.method.js"],
            "settings": { "fontStyle": "italic", "foreground": "#ffffff" }
        },
        {
            "name": "meta.method.js",
            "scope": [
                "meta.class-method.js entity.name.function.js",
                "variable.function.constructor"
            ],
            "settings": { "foreground": "#ffffff" }
        },
        {
            "name": "Attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#bbbbbb" }
        },
        {
            "name": "HTML Attributes",
            "scope": [
                "text.html.basic entity.other.attribute-name.html",
                "text.html.basic entity.other.attribute-name"
            ],
            "settings": { "fontStyle": "italic", "foreground": "#bbbbbb" }
        },
        {
            "name": "CSS Classes",
            "scope": ["entity.other.attribute-name.class"],
            "settings": { "foreground": "#cccccc" }
        },
        {
            "name": "CSS ID's",
            "scope": ["source.sass keyword.control"],
            "settings": { "foreground": "#ffffff" }
        },
        {
            "name": "Inserted",
            "scope": ["markup.inserted"],
            "settings": { "foreground": "#aaaaaa" }
        },
        {
            "name": "Deleted",
            "scope": ["markup.deleted"],
            "settings": { "foreground": "#666666" }
        },
        {
            "name": "Changed",
            "scope": ["markup.changed"],
            "settings": { "foreground": "#888888" }
        },
        {
            "name": "Regular Expressions",
            "scope": ["string.regexp"],
            "settings": { "foreground": "#dddddd" }
        },
        {
            "name": "Escape Characters",
            "scope": ["constant.character.escape"],
            "settings": { "foreground": "#bbbbbb" }
        },
        {
            "name": "URL",
            "scope": ["*url*", "*link*", "*uri*"],
            "settings": { "fontStyle": "underline" }
        },
        {
            "name": "Decorators",
            "scope": [
                "tag.decorator.js entity.name.tag.js",
                "tag.decorator.js punctuation.definition.tag.js"
            ],
            "settings": { "fontStyle": "italic", "foreground": "#aaaaaa" }
        },
        {
            "name": "ES7 Bind Operator",
            "scope": [
                "source.js constant.other.object.key.js string.unquoted.label.js"
            ],
            "settings": { "fontStyle": "italic", "foreground": "#bbbbbb" }
        },
        {
            "name": "JSON Key - Level 0",
            "scope": [
                "source.json meta.structure.dictionary.json support.type.property-name.json"
            ],
            "settings": { "foreground": "#dddddd" }
        },
        {
            "name": "JSON Key - Level 1",
            "scope": [
                "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
            ],
            "settings": { "foreground": "#cccccc" }
        },
        {
            "name": "JSON Key - Level 2",
            "scope": [
                "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
            ],
            "settings": { "foreground": "#bbbbbb" }
        },
        {
            "name": "JSON Key - Level 3",
            "scope": [
                "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
            ],
            "settings": { "foreground": "#aaaaaa" }
        },
        {
            "name": "Markdown - Plain",
            "scope": [
                "text.html.markdown",
                "punctuation.definition.list_item.markdown"
            ],
            "settings": { "foreground": "#e8e8e8" }
        },
        {
            "name": "Markdown - Markup Raw Inline",
            "scope": ["text.html.markdown markup.inline.raw.markdown"],
            "settings": { "foreground": "#bbbbbb" }
        },
        {
            "name": "Markdown - Markup Raw Inline Punctuation",
            "scope": [
                "text.html.markdown markup.inline.raw.markdown punctuation.definition.raw.markdown"
            ],
            "settings": { "foreground": "#888888" }
        },
        {
            "name": "Markdown - Heading",
            "scope": [
                "markdown.heading",
                "markup.heading | markup.heading entity.name",
                "markup.heading.markdown punctuation.definition.heading.markdown"
            ],
            "settings": { "foreground": "#ffffff" }
        },
        {
            "name": "Markup - Italic",
            "scope": ["markup.italic"],
            "settings": { "fontStyle": "italic", "foreground": "#cccccc" }
        },
        {
            "name": "Markup - Bold",
            "scope": ["markup.bold", "markup.bold string"],
            "settings": { "fontStyle": "bold", "foreground": "#dddddd" }
        },
        {
            "name": "Markup - Bold-Italic",
            "scope": [
                "markup.bold markup.italic",
                "markup.italic markup.bold",
                "markup.quote markup.bold",
                "markup.bold markup.italic string",
                "markup.italic markup.bold string",
                "markup.quote markup.bold string"
            ],
            "settings": { "fontStyle": "bold", "foreground": "#ffffff" }
        },
        {
            "name": "Markup - Underline",
            "scope": ["markup.underline"],
            "settings": { "fontStyle": "underline", "foreground": "#cccccc" }
        },
        {
            "name": "Markdown - Blockquote",
            "scope": [
                "markup.quote punctuation.definition.blockquote.markdown"
            ],
            "settings": { "foreground": "#888888" }
        },
        {
            "name": "Markup - Quote",
            "scope": ["markup.quote"],
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "Markdown - Link",
            "scope": ["string.other.link.title.markdown"],
            "settings": { "foreground": "#cccccc" }
        },
        {
            "name": "Markdown - Link Description",
            "scope": ["string.other.link.description.title.markdown"],
            "settings": { "foreground": "#bbbbbb" }
        },
        {
            "name": "Markdown - Link Anchor",
            "scope": ["constant.other.reference.link.markdown"],
            "settings": { "foreground": "#aaaaaa" }
        },
        {
            "name": "Markup - Raw Block",
            "scope": ["markup.raw.block"],
            "settings": { "foreground": "#bbbbbb" }
        },
        {
            "name": "Markdown - Raw Block Fenced",
            "scope": ["markup.raw.block.fenced.markdown"],
            "settings": { "foreground": "#888888" }
        },
        {
            "name": "Markdown - Fenced Bode Block",
            "scope": ["punctuation.definition.fenced.markdown"],
            "settings": { "foreground": "#666666" }
        },
        {
            "name": "Markdown - Fenced Bode Block Variable",
            "scope": [
                "markup.raw.block.fenced.markdown",
                "variable.language.fenced.markdown",
                "punctuation.section.class.end"
            ],
            "settings": { "foreground": "#aaaaaa" }
        },
        {
            "name": "Markdown - Fenced Language",
            "scope": ["variable.language.fenced.markdown"],
            "settings": { "foreground": "#888888" }
        },
        {
            "name": "Markdown - Separator",
            "scope": ["meta.separator"],
            "settings": { "fontStyle": "bold", "foreground": "#666666" }
        },
        {
            "name": "Markup - Table",
            "scope": ["markup.table"],
            "settings": { "foreground": "#e8e8e8" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
