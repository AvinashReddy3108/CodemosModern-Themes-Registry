{
    "name": "Spacemacs Dark",
    "colors": {
        "editor.background": "#292b2e",
        "editor.foreground": "#b2b2b2",
        "editorCursor.foreground": "#EEAD0E",
        "editorWhitespace.foreground": "#443e3f",
        "editorIndentGuide.background": "#443e3f",
        "editor.hoverHighlightBackground": "#373040",
        "editorLineNumber.foreground": "#44505c",
        "peekViewEditor.matchHighlightBackground": "#100a14",
        "editor.lineHighlightBackground": "#212026",
        "editor.selectionBackground": "#444155",
        "editor.inactiveSelectionBackground": "#212026",
        "editor.findRangeHighlightBackground": "#3A3D4180",
        "editor.findMatchHighlightBackground": "#100a14",
        "editor.findMatchBackground": "#86dc2f",
        "editor.wordHighlightBackground": "#77577740",
        "editor.wordHighlightStrongBackground": "#97597740",
        "activityBar.background": "#100a14",
        "activityBar.foreground": "#827591",
        "activityBarBadge.background": "#EEAD0E",
        "activityBarBadge.foreground": "#0a0814",
        "titleBar.activeBackground": "#5d4d7a",
        "tab.activeBackground": "#34323e"
    },
    "tokenColors": [
        {
            "name": "Comment",
            "scope": "comment",
            "settings": { "foreground": "#2aa1ae", "background": "#292e34" }
        },
        {
            "name": "String",
            "scope": "string",
            "settings": { "foreground": "#2d9574" }
        },
        {
            "name": "Number",
            "scope": "constant.numeric",
            "settings": { "foreground": "#9966b8" }
        },
        {
            "name": "Built-in constant",
            "scope": "constant.language",
            "settings": { "foreground": "#f280d0" }
        },
        {
            "name": "User-defined constant",
            "scope": ["constant.character", "constant.other"],
            "settings": { "foreground": "#a45bad" }
        },
        {
            "name": "Variable",
            "scope": "variable",
            "settings": { "foreground": "#7590db" }
        },
        {
            "name": "Keyword",
            "scope": "keyword",
            "settings": { "foreground": "#4f97d7" }
        },
        {
            "name": "Storage Type",
            "scope": "storage.type",
            "settings": { "foreground": "#ce537a" }
        },
        {
            "name": "Storage Type",
            "scope": "storage.modifier",
            "settings": { "foreground": "#4f97d7" }
        },
        {
            "name": "Class name",
            "scope": "entity.name.class",
            "settings": { "fontStyle": "underline", "foreground": "#ce0000" }
        },
        {
            "name": "Inherited class",
            "scope": "entity.other.inherited-class",
            "settings": {
                "fontStyle": "italic underline",
                "foreground": "#ce537a"
            }
        },
        {
            "name": "Function name",
            "scope": "entity.name.function",
            "settings": { "fontStyle": "", "foreground": "#bc6ec5" }
        },
        {
            "name": "java modifier.import",
            "scope": "storage.modifier.import.java",
            "settings": { "foreground": "#9966b8" }
        },
        {
            "name": "java variable.name",
            "scope": "meta.definition.variable.name.java",
            "settings": { "foreground": "#7590db" }
        },
        {
            "name": "Function argument",
            "scope": "variable.parameter",
            "settings": { "fontStyle": "italic", "foreground": "#7590db" }
        },
        {
            "name": "Tag name",
            "scope": "entity.name.tag",
            "settings": { "fontStyle": "", "foreground": "#7590db" }
        },
        {
            "name": "Tag attribute",
            "scope": "entity.other.attribute-name",
            "settings": { "fontStyle": "", "foreground": "#7590db" }
        },
        {
            "name": "Library function",
            "scope": "support.function",
            "settings": { "fontStyle": "", "foreground": "#bc6ec5" }
        },
        {
            "name": "Library constant",
            "scope": "support.constant",
            "settings": { "fontStyle": "", "foreground": "#bc3ec3" }
        },
        {
            "name": "Library class/type",
            "scope": ["support.type", "support.class"],
            "settings": { "fontStyle": "italic", "foreground": "#ce537a" }
        },
        {
            "name": "Library variable",
            "scope": "support.other.variable",
            "settings": { "fontStyle": "", "foreground": "#9966b8" }
        },
        {
            "name": "Invalid",
            "scope": "invalid",
            "settings": {
                "background": "#e0211d",
                "fontStyle": "",
                "foreground": "#F8F8F0"
            }
        },
        {
            "name": "Invalid deprecated",
            "scope": "invalid.deprecated",
            "settings": { "background": "#212026", "foreground": "#dc752f" }
        },
        {
            "name": "Markup Quote",
            "scope": "markup.quote",
            "settings": { "foreground": "#22aa44" }
        },
        {
            "name": "Markup Styling",
            "scope": ["markup.bold", "markup.italic"],
            "settings": { "foreground": "#9f8766" }
        },
        {
            "name": "Markup Inline",
            "scope": "markup.inline.raw",
            "settings": { "fontStyle": "", "foreground": "#827591" }
        },
        {
            "name": "Markup Setext Header",
            "scope": "markup.heading.setext",
            "settings": { "fontStyle": "", "foreground": "#4f97d7" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
