        { "scope": "markup.quote", "settings": { "foreground": "#7EC699" } },
        { "scope": "markup.italic", "settings": { "foreground": "#C678DD" } },
        { "scope": "markup.bold", "settings": { "foreground": "#E5C07B" } },
        {
            "scope": ["markup.underline"],
            "settings": { "foreground": "#61AFEF" }
        },
        {
            "scope": ["markup.strikethrough"],
            "settings": { "foreground": "#707085" }
        },
        {
            "scope": "markup.inline.raw",
            "settings": { "foreground": "#D19A66" }
        },
        {
            "scope": [
                "markup.deleted",
                "meta.diff.header.from-file",
