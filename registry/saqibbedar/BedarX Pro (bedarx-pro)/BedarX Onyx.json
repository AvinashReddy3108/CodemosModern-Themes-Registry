        },
        { "scope": "meta.separator", "settings": { "foreground": "#56B6C2" } },
        { "scope": "meta.output", "settings": { "foreground": "#61AFEF" } },
        {
            "scope": [
                "brackethighlighter.tag",
                "brackethighlighter.curly",
                "brackethighlighter.round",
