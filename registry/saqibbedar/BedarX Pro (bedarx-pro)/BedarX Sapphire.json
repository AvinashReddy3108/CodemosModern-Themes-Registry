        {
            "scope": "support.constant",
            "settings": { "foreground": "#D19A66" }
        },
        {
            "scope": "support.variable",
            "settings": { "foreground": "#E06B74" }
        },
        {
            "scope": "support.type.property-name.json",
            "settings": { "foreground": "#61AFEF" }
        },
        {
            "scope": "meta.module-reference",
            "settings": { "foreground": "#56B6C2" }
        },
        {
            "scope": "punctuation.definition.list.begin.markdown",
            "settings": { "foreground": "#E06B74" }
        },
        {
            "scope": ["markup.heading", "markup.heading entity.name"],
            "settings": { "foreground": "#61AFEF" }
        },
        { "scope": "markup.quote", "settings": { "foreground": "#7EC699" } },
        { "scope": "markup.italic", "settings": { "foreground": "#C678DD" } },
        { "scope": "markup.bold", "settings": { "foreground": "#E5C07B" } },
        {
            "scope": ["markup.underline"],
            "settings": { "foreground": "#61AFEF" }
        },
        {
            "scope": ["markup.strikethrough"],
            "settings": { "foreground": "#707085" }
        },
        {
            "scope": "markup.inline.raw",
            "settings": { "foreground": "#D19A66" }
        },
        {
            "scope": [
                "markup.deleted",
                "meta.diff.header.from-file",
                "punctuation.definition.deleted"
            ],
            "settings": { "background": "#F6586620", "foreground": "#F65866" }
        },
        {
            "scope": ["punctuation.section.embedded"],
            "settings": { "foreground": "#E06B74" }
        },
        {
            "scope": [
                "markup.inserted",
                "meta.diff.header.to-file",
                "punctuation.definition.inserted"
            ],
            "settings": { "background": "#7EC69920", "foreground": "#7EC699" }
        },
        {
            "scope": ["markup.changed", "punctuation.definition.changed"],
            "settings": { "background": "#E5C07B20", "foreground": "#E5C07B" }
        },
        {
            "scope": ["markup.ignored", "markup.untracked"],
            "settings": { "foreground": "#707085", "background": "#14141A" }
        },
        { "scope": "meta.diff.range", "settings": { "foreground": "#C678DD" } },
        {
            "scope": "meta.diff.header",
            "settings": { "foreground": "#61AFEF" }
        },
        { "scope": "meta.separator", "settings": { "foreground": "#56B6C2" } },
        { "scope": "meta.output", "settings": { "foreground": "#61AFEF" } },
        {
            "scope": [
                "brackethighlighter.tag",
                "brackethighlighter.curly",
                "brackethighlighter.round",
                "brackethighlighter.square",
                "brackethighlighter.angle",
                "brackethighlighter.quote"
            ],
            "settings": { "foreground": "#707085" }
        },
        {
            "scope": "brackethighlighter.unmatched",
