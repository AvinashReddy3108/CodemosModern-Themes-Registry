{
    "name": "Webfuse Dark",
    "type": "dark",
    "colors": {
        "activityBar.background": "#1a1a1a",
        "activityBar.foreground": "#ffffff",
        "activityBar.activeBorder": "#00bcd4",
        "activityBar.activeBackground": "#1a1a1a",
        "activityBar.activeForeground": "#00bcd4",
        "activityBar.inactiveForeground": "#9ca3af",
        "activityBarBadge.background": "#00bcd4",
        "activityBarBadge.foreground": "#1a1a1a",
        "sideBar.background": "#1f1f1f",
        "sideBar.foreground": "#ffffff",
        "sideBar.border": "#3a3a3a",
        "sideBarTitle.foreground": "#ffffff",
        "sideBarSectionHeader.background": "#2a2a2a",
        "sideBarSectionHeader.foreground": "#00bcd4",
        "editor.background": "#1a1a1a",
        "editor.foreground": "#ffffff",
        "editor.selectionBackground": "#00bcd440",
        "editor.selectionHighlightBackground": "#00bcd420",
        "editor.lineHighlightBackground": "#2a2a2a30",
        "editor.findMatchBackground": "#00bcd460",
        "editor.findMatchHighlightBackground": "#00bcd430",
        "editorCursor.foreground": "#00bcd4",
        "editorLineNumber.foreground": "#6a6a6a",
        "editorLineNumber.activeForeground": "#00bcd4",
        "editorWidget.background": "#2a2a2a",
        "editorWidget.border": "#3a3a3a",
        "editorWidget.foreground": "#ffffff",
        "editorSuggestWidget.background": "#2a2a2a",
        "editorSuggestWidget.border": "#3a3a3a",
        "editorSuggestWidget.selectedBackground": "#00bcd440",
        "statusBar.background": "#1a1a1a",
        "statusBar.foreground": "#ffffff",
        "statusBar.border": "#3a3a3a",
        "statusBarItem.activeBackground": "#00bcd4",
        "statusBarItem.hoverBackground": "#00bcd440",
        "titleBar.activeBackground": "#1a1a1a",
        "titleBar.activeForeground": "#ffffff",
        "titleBar.border": "#3a3a3a",
        "tab.activeBackground": "#1a1a1a",
        "tab.activeForeground": "#ffffff",
        "tab.activeBorder": "#00bcd4",
        "tab.inactiveBackground": "#2a2a2a",
        "tab.inactiveForeground": "#9ca3af",
        "tab.border": "#3a3a3a",
        "panel.background": "#1f1f1f",
        "panel.border": "#3a3a3a",
        "panelTitle.activeBorder": "#00bcd4",
        "panelTitle.activeForeground": "#ffffff",
        "panelTitle.inactiveForeground": "#9ca3af",
        "terminal.background": "#1a1a1a",
        "terminal.foreground": "#ffffff",
        "terminal.ansiCyan": "#00bcd4",
        "terminal.ansiBrightCyan": "#4dd0e1",
        "button.background": "#00bcd4",
        "button.foreground": "#1a1a1a",
        "button.hoverBackground": "#4dd0e1",
        "input.background": "#2a2a2a",
        "input.border": "#3a3a3a",
        "input.foreground": "#ffffff",
        "inputOption.activeBorder": "#00bcd4",
        "dropdown.background": "#2a2a2a",
        "dropdown.border": "#3a3a3a",
        "dropdown.foreground": "#ffffff",
        "list.activeSelectionBackground": "#00bcd440",
        "list.activeSelectionForeground": "#ffffff",
        "list.hoverBackground": "#00bcd420",
        "list.inactiveSelectionBackground": "#2a2a2a",
        "menu.background": "#2a2a2a",
        "menu.foreground": "#ffffff",
        "menu.selectionBackground": "#00bcd440",
        "scrollbar.shadow": "#1a1a1a",
        "scrollbarSlider.background": "#3a3a3a60",
        "scrollbarSlider.hoverBackground": "#3a3a3a80",
        "scrollbarSlider.activeBackground": "#3a3a3aaa"
    },
    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "fontStyle": "italic", "foreground": "#6a6a6a" }
        },
        {
            "name": "Keywords",
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#00bcd4" }
        },
        {
            "name": "Strings",
            "scope": ["string", "punctuation.definition.string"],
            "settings": { "foreground": "#4dd0e1" }
        },
        {
            "name": "Numbers",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#80deea" }
        },
        {
            "name": "Built-in constants",
            "scope": [
                "constant.language",
                "support.constant",
                "variable.language"
            ],
            "settings": { "foreground": "#00acc1" }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "support.function",
                "keyword.other.special-method"
            ],
            "settings": { "foreground": "#ffffff", "fontStyle": "bold" }
        },
        {
            "name": "Classes",
            "scope": [
                "entity.name.class",
                "entity.name.type.class",
                "support.type",
                "support.class"
            ],
            "settings": { "foreground": "#26c6da" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "string constant.other.placeholder"],
            "settings": { "foreground": "#e0e0e0" }
        },
        {
            "name": "Types",
            "scope": ["entity.name.type", "support.type.primitive"],
            "settings": { "foreground": "#4dd0e1" }
        },
        {
            "name": "HTML Tags",
            "scope": ["entity.name.tag", "punctuation.definition.tag"],
            "settings": { "foreground": "#00bcd4" }
        },
        {
            "name": "HTML Attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#4dd0e1" }
        },
        {
            "name": "CSS Properties",
            "scope": ["support.type.property-name"],
            "settings": { "foreground": "#00bcd4" }
        },
        {
            "name": "CSS Values",
            "scope": ["support.constant.property-value"],
            "settings": { "foreground": "#4dd0e1" }
        },
        {
            "name": "Operators",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#00acc1" }
        },
        {
            "name": "Punctuation",
            "scope": ["punctuation"],
            "settings": { "foreground": "#9ca3af" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#ff5252", "fontStyle": "underline" }
        },
        {
            "name": "JSON Property Names",
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#4dd0e1" }
        },
        {
            "name": "Markdown Headers",
            "scope": ["entity.name.section.markdown"],
            "settings": { "foreground": "#00bcd4", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Bold",
            "scope": ["markup.bold"],
            "settings": { "foreground": "#ffffff", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Italic",
            "scope": ["markup.italic"],
            "settings": { "foreground": "#e0e0e0", "fontStyle": "italic" }
        },
        {
            "name": "Markdown Code",
            "scope": ["markup.inline.raw"],
            "settings": { "foreground": "#4dd0e1" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
