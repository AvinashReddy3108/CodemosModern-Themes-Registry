    "tokenColors": [
        {
            "scope": "support.type.primitive",
            "settings": { "foreground": "#e0e0e0" }
        },
        { "scope": "constant", "settings": { "foreground": "#e0e0e0" } },
        {
            "scope": "constant.numeric",
            "settings": { "foreground": "#e0e0e0" }
        },
        {
            "scope": "string",
            "settings": { "foreground": "#e0e0e0", "fontStyle": "underline" }
        },
        {
            "scope": "meta.embedded.line",
            "settings": { "foreground": "#e0e0e0" }
        },
        { "scope": "entity.name", "settings": { "foreground": "#e0e0e0" } },
        { "scope": "entity.name.tag", "settings": { "foreground": "#e0e0e0" } },
        {
            "scope": "entity.name.type",
            "settings": { "foreground": "#e0e0e0" }
        },
        {
            "scope": "entity.name.function",
            "settings": { "foreground": "#e0e0e0", "fontStyle": "italic bold" }
        },
        {
            "scope": "support.function",
            "settings": { "foreground": "#e0e0e0", "fontStyle": "italic bold" }
        },
        {
            "scope": "meta.embedded.line entity.name.function",
            "settings": {
                "foreground": "#e0e0e0",
                "fontStyle": "bold underline"
            }
        },
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": {
                "foreground": "#828282",
                "fontStyle": "underline italic"
            }
        },
        {
            "scope": "token.info-token",
            "settings": { "foreground": "#e0e0e0" }
        },
        {
            "scope": "token.warn-token",
            "settings": { "foreground": "#e0e0e0" }
        },
        {
            "scope": "token.error-token",
            "settings": { "foreground": "#e0e0e0" }
        },
        {
            "scope": "token.debug-token",
            "settings": { "foreground": "#e0e0e0" }
        },
        {
            "scope": [
                "comment",
                "punctuation.definition.comment",
                "string.quoted.docstring.multi",
                "string.quoted.docstring.multi.python",
                "string.quoted.multi.python",
                "punctuation.definition.string.begin.python",
                "punctuation.definition.string.end.python"
            ],
            "settings": { "foreground": "#6a6a6a", "fontStyle": "italic" }
        },
        {
            "scope": "string",
            "settings": { "foreground": "#ddd", "fontStyle": "italic" }
        },
        {
            "scope": [
                "entity.name.function",
                "entity.name.type",
                "entity.name.class"
            ],
            "settings": {
                "foreground": "#eee",
                "fontStyle": "italic bold underline"
            }
        },
        {
            "scope": ["support.function"],
            "settings": { "foreground": "#aaa", "fontStyle": "italic bold" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
