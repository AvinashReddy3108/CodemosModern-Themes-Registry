        "symbolIcon.constantForeground": "#daaec1",
        "symbolIcon.constructorForeground": "#daaec1",
        "symbolIcon.enumeratorForeground": "#daaec1",
        "symbolIcon.enumeratorMemberForeground": "#daaec1",
        "symbolIcon.eventForeground": "#daaec1",
