{
    "name": "New Moon",
    "type": "dark",
    "colors": {
        "activityBar.background": "#333842",
        "activityBar.foreground": "#D7DAE0",
        "activityBarBadge.background": "#6B85D3",
        "activityBarBadge.foreground": "#D7DAE0",
        "button.background": "#4D78CC",
        "button.foreground": "#FFFFFF",
        "button.hoverBackground": "#6087CF",
        "diffEditor.insertedTextBackground": "#6B85D3",
        "dropdown.background": "#353b45",
        "dropdown.border": "#181A1F",
        "editor.background": "#282C34",
        "editor.lineHighlightBackground": "#2C313A",
        "editor.selectionBackground": "#3E4451",
        "editorCursor.foreground": "#6B85D3",
        "editorGroup.background": "#21252B",
        "editorGroup.border": "#181A1F",
        "editorGroupHeader.tabsBackground": "#21252B",
        "editorIndentGuide.background": "#3C4049",
        "editorLineNumber.foreground": "#636D83",
        "editorWhitespace.foreground": "#3C4049",
        "editorHoverWidget.background": "#21252B",
        "editorHoverWidget.border": "#181A1F",
        "editorSuggestWidget.background": "#21252B",
        "editorSuggestWidget.border": "#181A1F",
        "editorSuggestWidget.selectedBackground": "#2C313A",
        "editorWidget.background": "#21252B",
        "input.background": "#1B1D23",
        "input.border": "#181A1F",
        "focusBorder": "#6B85D3",
        "list.activeSelectionBackground": "#2C313A",
        "list.activeSelectionForeground": "#D7DAE0",
        "list.focusBackground": "#2C313A",
        "list.hoverBackground": "#2C313A66",
        "list.highlightForeground": "#D7DAE0",
        "list.inactiveSelectionBackground": "#2C313A",
        "list.inactiveSelectionForeground": "#D7DAE0",
        "notification.background": "#21252B",
        "pickerGroup.border": "#6B85D3",
        "scrollbarSlider.background": "#4E566680",
        "scrollbarSlider.activeBackground": "#747D9180",
        "scrollbarSlider.hoverBackground": "#5A637580",
        "sideBar.background": "#21252B",
        "sideBarSectionHeader.background": "#333842",
        "statusBar.background": "#21252B",
        "statusBar.foreground": "#9DA5B4",
        "statusBarItem.hoverBackground": "#2C313A",
        "statusBar.noFolderBackground": "#21252B",
        "tab.activeBackground": "#282C34",
        "tab.border": "#181A1F",
        "tab.inactiveBackground": "#21252B",
        "titleBar.activeBackground": "#21252B",
        "titleBar.activeForeground": "#9DA5B4",
        "titleBar.inactiveBackground": "#21252B",
        "titleBar.inactiveForeground": "#9DA5B4",
        "statusBar.debuggingForeground": "#FFFFFF",
        "extensionButton.prominentBackground": "#2BA143",
        "extensionButton.prominentHoverBackground": "#37AF4E",
        "badge.background": "#6B85D3",
        "badge.foreground": "#D7DAE0",
        "peekView.border": "#6B85D3",
        "peekViewResult.background": "#21252B",
        "peekViewResult.selectionBackground": "#2C313A",
        "peekViewTitle.background": "#1B1D23",
        "peekViewEditor.background": "#1B1D23"
    },
    "tokenColors": [
        { "settings": { "background": "#282a36", "foreground": "#D7DAE0" } },
        {
            "settings": { "foreground": "#E06C75" },
            "name": "Text",
            "scope": "variable.parameter.function,punctuation.definition.template-expression.begin.js,punctuation.definition.template-expression.end.js"
        },
        {
            "settings": { "foreground": "#5C6370" },
            "name": "Comments",
            "scope": "comment, punctuation.definition.comment"
        },
        {
            "settings": { "foreground": "#D7DAE0" },
            "name": "Punctuation",
            "scope": "punctuation.definition.parameters, punctuation.definition.array,punctuation.separator.key-value"
        },
        {
            "settings": { "foreground": "#D19A66" },
            "name": "Punctuation Operators",
            "scope": "keyword.operator, constant.character.escape, constant.character.escape.json,entity.other.attribute-name.pseudo-element.css, entity.other.attribute-name.pseudo-class.css"
        },
        {
            "settings": { "foreground": "#E06C75" },
            "name": "Punctuation Variable",
            "scope": "punctuation.definition.variable"
        },
        {
            "settings": { "foreground": "#ffffff" },
            "name": "Object Prop",
            "scope": "variable.other.property.php, variable.other.member.php, entity.name.function.php"
        },
        {
            "settings": { "foreground": "#d3d0c8" },
            "name": "Delimiters",
            "scope": "none"
        },
        {
            "settings": { "foreground": "#d3d0c8" },
            "name": "Brackets",
            "scope": "punctuation.definition.block,meta.brace.square,meta.parameters,punctuation.definition.parameters,meta.brace.round,punctuation.definition.dictionary,punctuation.definition.array,punctuation.separator,constant.character.escape.backslash.regexp,punctuation.section,punctuation.terminator.statement,variable.other.property.js,support.variable.property.dom.js"
        },
        {
            "settings": { "foreground": "#D19A66" },
            "name": "Operators",
            "scope": "keyword.operator,punctuation.accessor.js"
        },
        {
            "settings": { "foreground": "#99bdd5" },
            "name": "CSS Val",
            "scope": "support.constant.property-value"
        },
        {
            "settings": { "foreground": "#FFDC93" },
            "name": "Keywords",
            "scope": "keyword,keyword.operator.expression.typeof,variable.language.this"
        },
        {
            "settings": { "foreground": "#E06C75" },
            "name": "Variables",
            "scope": "variable"
        },
        {
            "settings": { "foreground": "#ffffff" },
            "name": "Function Call",
            "scope": "meta.function-call"
        },
        {
            "settings": { "foreground": "#ffffff" },
            "name": "Functions",
            "scope": "entity.name.function, meta.require, support.function.any-method,meta.tag.sgml.html"
        },
        {
            "settings": { "foreground": "#6B85D3" },
            "name": "Classes",
            "scope": "support.class, entity.name.type.class"
        },
        {
            "settings": { "foreground": "#6B85D3" },
            "name": "Classes",
            "scope": "meta.entity.new.name.expr,entity.name.tag.structure.any.html,meta.tag.structure.any.html,meta.tag.sgml.doctype.html"
        },
        {
            "settings": { "foreground": "#ffffff" },
            "name": "Value",
            "scope": "meta.property-value"
        },
        {
            "settings": { "foreground": "#8be9fd" },
            "name": "Methods",
            "scope": "keyword.other.special-method,entity.name.type"
        },
        {
            "settings": { "foreground": "#E0C285" },
            "name": "Storage",
            "scope": "storage,support.function.construct.output.php,keyword.operator.new"
        },
        {
            "settings": { "foreground": "#B780C6" },
            "name": "Support",
            "scope": "support.function"
        },
        {
            "settings": { "foreground": "#98C379" },
            "name": "Strings, Inherited Class",
            "scope": "string, constant.other.symbol, entity.other.inherited-class,punctuation.definition.string"
        },
        {
            "settings": { "foreground": "#ffb86c" },
            "name": "Integers",
            "scope": "constant.numeric"
        },
        {
            "settings": { "foreground": "#ffb86c" },
            "name": "Floats",
            "scope": "none"
        },
        {
            "settings": { "foreground": "#ffb86c" },
            "name": "Regex",
            "scope": "string.regexp,string.regexp.js"
        },
        {
            "settings": { "foreground": "#B780C6" },
            "name": "Constants",
            "scope": "constant"
        },
        {
            "settings": { "foreground": "#6B85D3" },
            "name": "Tags",
            "scope": "entity.name.tag,support.variable.dom.js,meta.tag.structure.any.html,punctuation.definition.tag.begin.html,punctuation.definition.tag.end.html, punctuation.definition.tag.html"
        },
        {
            "settings": { "foreground": "#D19A66" },
            "name": "Attributes",
            "scope": "entity.other.attribute-name,entity.other.attribute-name.class.css,"
        },
        {
            "settings": { "foreground": "#B780C6" },
            "name": "Attribute IDs",
            "scope": "entity.other.attribute-name.id"
        },
        {
            "settings": { "foreground": "#ffffff" },
            "name": "Selector",
            "scope": "meta.selector"
        },
        {
            "settings": { "foreground": "#D7DAE0" },
            "name": "Values",
            "scope": "entity.name.tag.reference,meta.embedded.block.php,meta.embedded.line.php"
        },
        {
            "settings": { "fontStyle": "", "foreground": "#8be9fd" },
            "name": "Headings",
            "scope": "markup.heading punctuation.definition.heading, entity.name.section"
        },
        {
            "settings": { "foreground": "#ffb86c" },
            "name": "Units",
            "scope": "keyword.other.unit"
        },
        {
            "settings": { "foreground": "#bbbbbb" },
            "name": "Units",
            "scope": "keyword.other.phpdoc.php"
        },
        {
            "settings": { "fontStyle": "bold", "foreground": "#D19A66" },
            "name": "Bold",
            "scope": "markup.bold, punctuation.definition.bold"
        },
        {
            "settings": { "fontStyle": "italic", "foreground": "#B780C6" },
            "name": "Italic",
            "scope": "markup.italic, punctuation.definition.italic"
        },
        {
            "settings": { "foreground": "#98C379" },
            "name": "Code",
            "scope": "markup.raw.inline"
        },
        {
            "settings": { "foreground": "#98C379" },
            "name": "Link Text",
            "scope": "string.other.link"
        },
        {
            "settings": { "background": "#000000", "foreground": "#ffffff" },
            "name": "Link Url",
            "scope": "meta.link"
        },
        {
            "settings": { "foreground": "#E06C75" },
            "name": "Lists",
            "scope": "markup.list"
        },
        {
            "settings": { "foreground": "#ffb86c" },
            "name": "Quotes",
            "scope": "markup.quote"
        },
        {
            "settings": { "background": "#515151", "foreground": "#d3d0c8" },
            "name": "Separator",
            "scope": "meta.separator"
        },
        {
            "settings": { "foreground": "#98C379" },
            "name": "Inserted",
            "scope": "markup.inserted, markup.inserted.git_gutter"
        },
        {
            "settings": { "foreground": "#E06C75" },
            "name": "Deleted",
            "scope": "markup.deleted, markup.deleted.git_gutter"
        },
        {
            "settings": { "foreground": "#B780C6" },
            "name": "Changed",
            "scope": "markup.changed, markup.changed.git_gutter"
        },
        {
            "settings": { "foreground": "#515151" },
            "name": "Ignored",
            "scope": "markup.ignored, markup.ignored.git_gutter"
        },
        {
            "settings": { "foreground": "#515151" },
            "name": "Untracked",
            "scope": "markup.untracked, markup.untracked.git_gutter"
        },
        {
            "settings": { "foreground": "#56B6C2" },
            "name": "Colors",
            "scope": "constant.other.color,entity.other.attribute-name.pseudo-class.css, constant.other.php"
        },
        {
            "settings": { "foreground": "#56B6C2" },
            "name": "Regular Expressions",
            "scope": "string.regexp"
        },
        {
            "settings": { "foreground": "#56B6C2" },
            "name": "Escape Characters",
            "scope": "entity.other.attribute-name.pseudo-element.css,meta.definition.variable.js,meta.var-single-variable.expr.js,variable.other.readwrite.js"
        },
        {
            "settings": { "foreground": "#D7DAE0" },
            "name": "Embedded",
            "scope": "punctuation.section.embedded, variable.interpolation"
        },
        {
            "settings": { "foreground": "#E06C75" },
            "name": "Invalid",
            "scope": "invalid.illegal"
        },
        {
            "settings": { "foreground": "#E06C75" },
            "name": "GitGutter deleted",
            "scope": "markup.deleted.git_gutter"
        },
        {
            "settings": { "foreground": "#98C379" },
            "name": "GitGutter inserted",
            "scope": "markup.inserted.git_gutter"
        },
        {
            "settings": { "foreground": "#B780C6" },
            "name": "GitGutter changed",
            "scope": "markup.changed.git_gutter"
        },
        {
            "settings": { "foreground": "#696b7a" },
            "name": "GitGutter ignored",
            "scope": "markup.ignored.git_gutter"
        },
        {
            "settings": { "foreground": "#696b7a" },
            "name": "GitGutter untracked",
            "scope": "markup.untracked.git_gutter"
        }
    ],
    "colorSpaceName": "sRGB",
    "$schema": "vscode://schemas/color-theme"
}
