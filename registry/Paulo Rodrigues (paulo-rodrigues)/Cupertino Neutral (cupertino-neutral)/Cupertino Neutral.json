{
    "name": "Cupertino Dark — Vue/Python",
    "type": "dark",
    "semanticHighlighting": true,
    "colors": {
        "editor.background": "#1C1C1E",
        "editor.foreground": "#F2F2F7",
        "editorLineNumber.foreground": "#636366",
        "editorLineNumber.activeForeground": "#FFFFFF",
        "editorCursor.foreground": "#0A84FF",
        "editor.selectionBackground": "#0A84FF40",
        "editor.inactiveSelectionBackground": "#0A84FF15",
        "editor.wordHighlightBackground": "#0A84FF20",
        "editorIndentGuide.background1": "#2C2C2E",
        "editorIndentGuide.activeBackground1": "#48484A",
        "editorWhitespace.foreground": "#3A3A3C",
        "sideBar.background": "#151517",
        "sideBar.foreground": "#D1D1D6",
        "sideBarSectionHeader.background": "#00000000",
        "sideBarSectionHeader.foreground": "#FFFFFF",
        "sideBar.border": "#00000000",
        "list.activeSelectionBackground": "#2C2C2E",
        "list.activeSelectionForeground": "#FFFFFF",
        "list.inactiveSelectionBackground": "#1C1C1E",
        "list.inactiveSelectionForeground": "#D1D1D6",
        "list.hoverBackground": "#2C2C2E80",
        "activityBar.background": "#151517",
        "activityBar.foreground": "#FFFFFF",
        "activityBar.inactiveForeground": "#636366",
        "activityBarBadge.background": "#0A84FF",
        "activityBarBadge.foreground": "#FFFFFF",
        "statusBar.background": "#151517",
        "statusBar.foreground": "#D1D1D6",
        "statusBar.border": "#2C2C2E",
        "tab.activeBackground": "#1C1C1E",
        "tab.activeForeground": "#FFFFFF",
        "tab.inactiveBackground": "#151517",
        "tab.inactiveForeground": "#8E8E93",
        "tab.border": "#00000000",
        "panel.background": "#151517",
        "panel.border": "#2C2C2E",
        "panelTitle.activeForeground": "#FFFFFF",
        "panelTitle.inactiveForeground": "#8E8E93",
        "titleBar.activeBackground": "#151517",
        "titleBar.activeForeground": "#FFFFFF",
        "focusBorder": "#0A84FF50",
        "widget.shadow": "#00000066",
        "gitDecoration.modifiedResourceForeground": "#FFD60A",
        "gitDecoration.addedResourceForeground": "#32D74B",
        "gitDecoration.deletedResourceForeground": "#FF453A",
        "gitDecoration.untrackedResourceForeground": "#32D74B"
    },
    "tokenColors": [
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#8E8E93", "fontStyle": "italic" }
        },
        {
            "scope": [
                "keyword",
                "storage.type",
                "storage.modifier",
                "keyword.control"
            ],
            "settings": { "foreground": "#FF375F", "fontStyle": "bold" }
        },
        {
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#32D74B" }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.language",
                "constant.other"
            ],
            "settings": { "foreground": "#BF5AF2" }
        },
        {
            "scope": ["variable", "meta.definition.variable"],
            "settings": { "foreground": "#D1D1D6" }
        },
        {
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call"
            ],
            "settings": { "foreground": "#0A84FF" }
        },
        {
            "scope": ["entity.name.type", "entity.name.class", "support.class"],
            "settings": { "foreground": "#64D2FF", "fontStyle": "bold" }
        },
        {
            "scope": [
                "meta.function.decorator",
                "entity.name.function.decorator"
            ],
            "settings": { "foreground": "#FF9F0A", "fontStyle": "italic" }
        },
        {
            "scope": [
                "variable.language.special.self",
                "variable.parameter.function.language.special.self",
                "variable.language.special.cls"
            ],
            "settings": { "foreground": "#FF453A", "fontStyle": "italic" }
        },
        {
            "scope": ["support.function.builtin.python", "support.type.python"],
            "settings": { "foreground": "#AC8E68" }
        },
        {
            "scope": "variable.parameter",
            "settings": { "foreground": "#EBEBF5" }
        },
        {
            "scope": "keyword.operator.logical.python",
            "settings": { "foreground": "#FF375F", "fontStyle": "bold" }
        },
        {
            "scope": ["entity.name.tag", "entity.name.tag.html"],
            "settings": { "foreground": "#FF375F" }
        },
        {
            "scope": [
                "entity.name.tag.script.html.vue",
                "support.class.component",
                "support.class.component.vue"
            ],
            "settings": { "foreground": "#64D2FF", "fontStyle": "bold" }
        },
        {
            "scope": [
                "entity.other.attribute-name.vue.directive",
                "meta.directive.vue"
            ],
            "settings": { "foreground": "#BF5AF2", "fontStyle": "italic" }
        },
        {
            "scope": [
                "punctuation.definition.template-expression.begin",
                "punctuation.definition.template-expression.end",
                "expression.embedded.vue"
            ],
            "settings": { "foreground": "#FF9F0A" }
        },
        {
            "scope": [
                "entity.other.attribute-name",
                "entity.other.attribute-name.html"
            ],
            "settings": { "foreground": "#FF9F0A" }
        },
        {
            "scope": ["punctuation", "keyword.operator"],
            "settings": { "foreground": "#8E8E93" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
