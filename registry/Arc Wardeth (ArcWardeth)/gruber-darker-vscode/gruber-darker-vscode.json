    "tokenColors": [
        {
            "name": "Default foreground",
            "scope": ["source", "text"],
            "settings": { "foreground": "#e4e4ef" }
        },
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#cc8c3c", "fontStyle": "italic" }
        },
        {
            "name": "Strings and documentation",
            "scope": [
                "string",
                "string.quoted",
                "string.template",
                "comment.block.documentation",
                "constant.other.symbol"
            ],
            "settings": { "foreground": "#73c936" }
        },
        {
            "name": "Keywords and storage",
            "scope": [
                "keyword",
                "storage",
                "storage.type",
                "storage.modifier",
                "variable.language",
                "support.type.property-name.css"
            ],
            "settings": { "foreground": "#ffdd33", "fontStyle": "bold" }
        },
        {
            "name": "Operators and punctuation",
            "scope": [
                "keyword.operator",
                "punctuation.separator",
                "punctuation.terminator",
                "punctuation.accessor",
                "punctuation.definition.tag"
            ],
            "settings": { "foreground": "#e4e4ef", "fontStyle": "" }
        },
        {
            "name": "Functions and methods",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call",
                "variable.function",
                "entity.name.tag"
            ],
            "settings": { "foreground": "#96a6c8" }
        },
        {
            "name": "Types, classes, constants",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "entity.name.struct",
                "entity.name.enum",
                "support.type",
                "support.class",
                "constant.language",
                "constant.numeric",
                "constant.character",
                "constant.other"
            ],
            "settings": { "foreground": "#95a99f" }
        },
        {
            "name": "Variables and parameters",
            "scope": [
                "variable",
                "variable.parameter",
                "meta.object-literal.key",
                "support.variable.property"
            ],
            "settings": { "foreground": "#f4f4ff" }
        },
        {
            "name": "Properties and fields",
            "scope": [
                "variable.other.property",
                "variable.other.object.property",
                "entity.other.attribute-name",
                "support.type.property-name"
            ],
            "settings": { "foreground": "#e4e4ef" }
        },
        {
            "name": "Preprocessor and decorators",
            "scope": [
                "meta.preprocessor",
                "keyword.control.directive",
                "punctuation.definition.directive",
                "meta.decorator",
                "entity.name.function.decorator"
            ],
            "settings": { "foreground": "#95a99f" }
        },
        {
            "name": "Invalid and diagnostics",
            "scope": ["invalid", "invalid.illegal", "invalid.deprecated"],
            "settings": { "foreground": "#ff4f58" }
        },
        {
            "name": "Markdown headings",
            "scope": ["markup.heading", "markup.heading entity.name"],
            "settings": { "foreground": "#96a6c8", "fontStyle": "bold" }
        },
        {
            "name": "Markdown links",
            "scope": ["markup.underline.link", "string.other.link"],
            "settings": { "foreground": "#96a6c8", "fontStyle": "underline" }
        },
        {
            "name": "Markup emphasis",
            "scope": ["markup.italic"],
            "settings": { "foreground": "#95a99f", "fontStyle": "italic" }
        },
        {
            "name": "Markup strong",
            "scope": ["markup.bold"],
            "settings": { "foreground": "#95a99f", "fontStyle": "bold" }
        },
        {
            "name": "Diff inserted",
            "scope": ["markup.inserted"],
            "settings": { "foreground": "#73c936" }
        },
        {
            "name": "Diff deleted",
            "scope": ["markup.deleted"],
            "settings": { "foreground": "#ff4f58" }
        },
        {
            "name": "Diff changed",
            "scope": ["markup.changed"],
            "settings": { "foreground": "#ffdd33" }
        }
    ],
    "semanticTokenColors": {
        "namespace": "#95a99f",
        "type": "#95a99f",
        "type.defaultLibrary": "#95a99f",
        "class": "#95a99f",
        "enum": "#95a99f",
        "interface": "#95a99f",
        "struct": "#95a99f",
        "typeParameter": "#95a99f",
        "parameter": "#f4f4ff",
        "variable": "#f4f4ff",
        "property": "#e4e4ef",
        "enumMember": "#95a99f",
        "event": "#95a99f",
        "function": "#96a6c8",
        "method": "#96a6c8",
        "macro": "#95a99f",
        "keyword": { "foreground": "#ffdd33", "fontStyle": "bold" },
        "comment": { "foreground": "#cc8c3c", "fontStyle": "italic" },
        "string": "#73c936",
        "number": "#95a99f",
        "regexp": "#73c936",
        "operator": "#e4e4ef",
        "decorator": "#95a99f",
        "variable.readonly": "#95a99f",
        "property.readonly": "#95a99f",
        "function.defaultLibrary": "#ffdd33",
        "method.defaultLibrary": "#ffdd33"
    },
    "$schema": "vscode://schemas/color-theme"
}
