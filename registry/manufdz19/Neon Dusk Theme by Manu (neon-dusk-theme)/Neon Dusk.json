    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#5E5E6A", "fontStyle": "italic" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#FF5370" }
        },
        {
            "name": "Keywords and Storage",
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#D2529F" }
        },
        {
            "name": "Control Keywords",
            "scope": ["keyword.control"],
            "settings": { "foreground": "#D2529F", "fontStyle": "" }
        },
        {
            "name": "Variables",
            "scope": [
                "variable",
                "support.other.variable",
                "string constant.other.placeholder"
            ],
            "settings": { "foreground": "#E89F6A" }
        },
        {
            "name": "Parameters",
            "scope": [
                "variable.parameter",
                "variable.parameter.keyframe-list.css"
            ],
            "settings": { "foreground": "#4CC0D1" }
        },
        {
            "name": "Strings",
            "scope": [
                "string",
                "string.quoted.double.html",
                "string.quoted.double.json"
            ],
            "settings": { "foreground": "#70D0B3" }
        },
        {
            "name": "Numbers and Constants",
            "scope": [
                "constant.numeric",
                "constant.language",
                "constant.character",
                "constant.escape",
                "support.constant",
                "keyword.other.unit"
            ],
            "settings": { "foreground": "#E8D06A" }
        },
        {
            "name": "Functions and Methods",
            "scope": [
                "entity.name.function",
                "meta.function-call",
                "variable.function",
                "support.function",
                "entity.name.method",
                "variable.function.constructor"
            ],
            "settings": { "foreground": "#4CC0D1" }
        },
        {
            "name": "Classes and Types",
            "scope": [
                "entity.name.type",
                "entity.other.inherited-class",
                "support.class",
                "support.type"
            ],
            "settings": { "foreground": "#C084FC" }
        },
        {
            "name": "Decorators",
            "scope": [
                "meta.decorator",
                "tag.decorator.js entity.name.tag.js",
                "tag.decorator.js punctuation.definition.tag.js"
            ],
            "settings": { "foreground": "#3A9AA8", "fontStyle": "italic" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation.definition",
                "punctuation.separator",
                "punctuation.terminator"
            ],
            "settings": { "foreground": "#9999A3" }
        },
        {
            "name": "HTML and JSX Tags",
            "scope": [
                "entity.name.tag",
                "entity.name.tag.html",
                "entity.name.tag.jsx",
                "entity.name.tag.tsx"
            ],
            "settings": { "foreground": "#4CC9F0" }
        },
        {
            "name": "Tag Delimiters",
            "scope": [
                "punctuation.definition.tag",
                "punctuation.definition.tag.begin",
                "punctuation.definition.tag.end"
            ],
            "settings": { "foreground": "#FF6B9A" }
        },
        {
            "name": "HTML and JSX Attributes",
            "scope": [
                "entity.other.attribute-name",
                "entity.other.attribute-name.html",
                "entity.other.attribute-name.jsx",
                "entity.other.attribute-name.tsx"
            ],
            "settings": { "foreground": "#b8a8f8" }
        },
        {
            "name": "CSS Selectors",
            "scope": [
                "entity.other.attribute-name.class",
                "entity.other.attribute-name.id",
                "entity.other.attribute-name.pseudo-class",
                "entity.name.tag.css"
            ],
            "settings": { "foreground": "#E0E0E0" }
        },
        {
            "name": "CSS Property Names",
            "scope": [
                "source.css support.type.property-name",
                "source.scss support.type.property-name",
                "source.sass support.type.property-name",
                "source.less support.type.property-name",
                "source.stylus support.type.property-name"
            ],
            "settings": { "foreground": "#D2529F" }
        },
        {
            "name": "Regular Expressions",
            "scope": ["string.regexp"],
            "settings": { "foreground": "#3A9AA8" }
        },
        {
            "name": "URLs and Links",
            "scope": [
                "string.other.link",
                "constant.other.reference.link",
                "markup.underline.link",
                "markup.underline.link.image"
            ],
            "settings": { "foreground": "#3A9AA8", "fontStyle": "underline" }
        },
        {
            "name": "JSON Keys",
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#E0E0E0" }
        },
        {
            "name": "Git Inserted",
            "scope": ["markup.inserted", "markup.inserted.git_gutter"],
            "settings": { "foreground": "#70D0B3" }
        },
        {
            "name": "Git Deleted",
            "scope": ["markup.deleted", "markup.deleted.git_gutter"],
            "settings": { "foreground": "#FF5370" }
        },
        {
            "name": "Git Changed",
            "scope": ["markup.changed", "markup.changed.git_gutter"],
            "settings": { "foreground": "#3A9AA8" }
        },
        {
            "name": "Markdown Plain",
            "scope": [
                "text.html.markdown",
                "punctuation.definition.list_item.markdown"
            ],
            "settings": { "foreground": "#E0E0E0" }
        },
        {
            "name": "Markdown Headings",
            "scope": [
                "markdown.heading",
                "markup.heading",
                "markup.heading entity.name",
                "markup.heading.markdown punctuation.definition.heading.markdown"
            ],
            "settings": { "foreground": "#D2529F", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Inline Code",
            "scope": ["text.html.markdown markup.inline.raw.markdown"],
            "settings": { "foreground": "#3A9AA8" }
        },
        {
            "name": "Markdown Code Punctuation",
            "scope": [
                "punctuation.definition.raw.markdown",
                "punctuation.definition.markdown"
            ],
            "settings": { "foreground": "#D2529F80" }
        },
        {
            "name": "Markdown Quote",
            "scope": [
                "markup.quote",
                "markup.quote punctuation.definition.blockquote.markdown"
            ],
            "settings": { "foreground": "#D2529F80", "fontStyle": "italic" }
        },
        {
            "name": "Markdown Link Text",
            "scope": ["string.other.link.description.title.markdown"],
            "settings": { "foreground": "#3A9AA8" }
        },
        {
            "name": "Markdown Link Reference",
            "scope": ["constant.other.reference.link.markdown"],
            "settings": { "foreground": "#3A9AA8" }
        },
        {
            "name": "Markdown Raw Block",
            "scope": ["markup.raw.block", "markup.raw.block.fenced.markdown"],
            "settings": { "foreground": "#3A9AA8" }
        },
        {
            "name": "Markdown Separator",
            "scope": ["meta.separator"],
            "settings": { "foreground": "#9999A3", "fontStyle": "bold" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
