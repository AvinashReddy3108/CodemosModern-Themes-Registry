    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#8A88C2", "fontStyle": "italic" }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "storage.type",
                "storage.modifier",
                "keyword.control",
                "keyword.operator.new",
                "keyword.other.import",
                "keyword.other.package"
            ],
            "settings": { "foreground": "#FF33A6", "fontStyle": "bold" }
        },
        {
            "name": "Functions & Methods",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call.generic",
                "meta.method-call"
            ],
            "settings": { "foreground": "#00E6C3" }
        },
        {
            "name": "Function Parameters",
            "scope": ["variable.parameter", "meta.function.parameters"],
            "settings": { "foreground": "#857ABF", "fontStyle": "italic" }
        },
        {
            "name": "Variables & Properties",
            "scope": [
                "variable",
                "variable.other.readwrite",
                "variable.other.property",
                "support.variable"
            ],
            "settings": { "foreground": "#FFFFFF" }
        },
        {
            "name": "Strings",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#E6DB74" }
        },
        {
            "name": "String Interpolation",
            "scope": ["string.interpolated", "meta.template.expression"],
            "settings": { "foreground": "#00FFF7" }
        },
        {
            "name": "Numbers & Constants",
            "scope": [
                "constant.numeric",
                "constant.language",
                "constant.character"
            ],
            "settings": { "foreground": "#D4AF37", "fontStyle": "bold" }
        },
        {
            "name": "Classes & Types",
            "scope": [
                "support.class",
                "entity.name.type.class",
                "entity.name.type",
                "support.type"
            ],
            "settings": { "foreground": "#A78BFA", "fontStyle": "bold" }
        },
        {
            "name": "Interfaces & Enums",
            "scope": ["entity.name.type.interface", "entity.name.type.enum"],
            "settings": { "foreground": "#FFA7C4", "fontStyle": "bold italic" }
        },
        {
            "name": "HTML/XML Tags",
            "scope": ["entity.name.tag", "punctuation.definition.tag"],
            "settings": { "foreground": "#00FFF7" }
        },
        {
            "name": "HTML/XML Attributes",
            "scope": ["entity.other.attribute-name", "meta.attribute"],
            "settings": { "foreground": "#FF33A6", "fontStyle": "italic" }
        },
        {
            "name": "CSS Selectors",
            "scope": [
                "entity.name.tag.css",
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css"
            ],
            "settings": { "foreground": "#00FFF7" }
        },
        {
            "name": "CSS Properties",
            "scope": ["support.type.property-name.css"],
            "settings": { "foreground": "#FFA7C4" }
        },
        {
            "name": "CSS Values",
            "scope": [
                "support.constant.property-value.css",
                "constant.other.color.rgb-value.css"
            ],
            "settings": { "foreground": "#E6DB74" }
        },
        {
            "name": "Operators",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#FF7EDB" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation",
                "punctuation.definition.block",
                "punctuation.definition.array",
                "punctuation.definition.parameters",
                "punctuation.section"
            ],
            "settings": { "foreground": "#6C9BCF" }
        },
        {
            "name": "Property Keys & Object Keys",
            "scope": [
                "support.type.property-name",
                "meta.object-literal.key",
                "support.type.property-name.json"
            ],
            "settings": { "foreground": "#FFA7C4" }
        },
        {
            "name": "Markdown Headers",
            "scope": [
                "markup.heading",
                "punctuation.definition.heading.markdown"
            ],
            "settings": { "foreground": "#FF33A6", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Bold",
            "scope": ["markup.bold"],
            "settings": { "foreground": "#E6DB74", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Italic",
            "scope": ["markup.italic"],
            "settings": { "foreground": "#00FFF7", "fontStyle": "italic" }
        },
        {
            "name": "Markdown Code",
            "scope": ["markup.inline.raw", "markup.fenced_code"],
            "settings": { "foreground": "#D4AF37" }
        },
        {
            "name": "Markdown Links",
            "scope": ["markup.underline.link"],
            "settings": { "foreground": "#00FFF7", "fontStyle": "underline" }
        },
        {
            "name": "Invalid & Deprecated",
            "scope": ["invalid", "invalid.illegal"],
            "settings": {
                "foreground": "#FF5C5C",
                "fontStyle": "underline bold"
            }
        },
        {
            "name": "Regex",
            "scope": ["string.regexp"],
            "settings": { "foreground": "#A78BFA" }
        },
        {
            "name": "Escape Characters",
            "scope": ["constant.character.escape"],
            "settings": { "foreground": "#FF7EDB" }
        },
        {
            "name": "Decorators & Annotations",
            "scope": [
                "entity.name.function.decorator",
                "punctuation.decorator"
            ],
            "settings": { "foreground": "#FFA7C4", "fontStyle": "italic" }
        },
        {
            "name": "Import/Export Keywords",
            "scope": [
                "keyword.control.import",
                "keyword.control.export",
                "keyword.control.from"
            ],
            "settings": { "foreground": "#FF33A6", "fontStyle": "italic" }
        },
        {
            "name": "This/Self Keywords",
            "scope": ["variable.language.this", "variable.language.self"],
            "settings": { "foreground": "#FF7EDB", "fontStyle": "bold italic" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
