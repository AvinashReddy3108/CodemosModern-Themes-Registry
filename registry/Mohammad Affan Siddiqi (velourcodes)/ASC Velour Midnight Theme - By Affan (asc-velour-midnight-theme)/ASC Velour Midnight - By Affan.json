{
    "name": "ASC Velour Midnight - By Affan",
    "$schema": "vscode://schemas/color-theme",
    "type": "dark",
    "colors": {
        "editor.background": "#0D0D0D",
        "editor.foreground": "#E5E9F0",
        "editorCursor.foreground": "#7DCFFF",
        "editor.lineHighlightBackground": "#1A1A2E",
        "editor.selectionBackground": "#1E1E2E",
        "editor.selectionHighlightBackground": "#2A2A3D",
        "editorBracketMatch.background": "#0D0D0D",
        "editorBracketMatch.border": "#7AA2F7",
        "editorWhitespace.foreground": "#4E5173",
        "editorError.foreground": "#FF5C57",
        "editorWarning.foreground": "#E0AF68",
        "editorInfo.foreground": "#7AA2F7",
        "activityBar.background": "#0D0D0D",
        "activityBar.foreground": "#A9B1D6",
        "activityBarBadge.background": "#7AA2F7",
        "activityBarBadge.foreground": "#0D0D0D",
        "sideBar.background": "#10101B",
        "sideBar.foreground": "#A9B1D6",
        "sideBarTitle.foreground": "#E5E9F0",
        "sideBarSectionHeader.background": "#10101B",
        "sideBarSectionHeader.foreground": "#7AA2F7",
        "statusBar.background": "#0D0D0D",
        "statusBar.foreground": "#A9B1D6",
        "statusBar.debuggingBackground": "#7AA2F7",
        "statusBar.debuggingForeground": "#0D0D0D",
        "tab.activeBackground": "#1A1A2E",
        "tab.activeForeground": "#E5E9F0",
        "tab.inactiveBackground": "#10101B",
        "tab.inactiveForeground": "#565F89",
        "panel.background": "#10101B",
        "panel.border": "#2A2A3D",
        "input.background": "#10101B",
        "input.foreground": "#E5E9F0",
        "input.placeholderForeground": "#565F89",
        "inputOption.activeBackground": "#2A2A3D",
        "inputValidation.errorBorder": "#FF5C57",
        "inputValidation.warningBorder": "#E0AF68",
        "inputValidation.infoBorder": "#7AA2F7",
        "dropdown.background": "#10101B",
        "dropdown.foreground": "#E5E9F0",
        "dropdown.border": "#2A2A3D",
        "checkbox.background": "#10101B",
        "checkbox.foreground": "#E5E9F0",
        "notification.background": "#10101B",
        "notification.foreground": "#E5E9F0",
        "notificationLink.foreground": "#7DCFFF",
        "minimap.background": "#0D0D0D",
        "minimapGutter.addedBackground": "#9ECE6A",
        "minimapGutter.deletedBackground": "#FF5C57",
        "minimapGutter.modifiedBackground": "#E0AF68",
        "scrollbar.shadow": "#00000000",
        "scrollbarSlider.background": "#2A2A3D",
        "scrollbarSlider.hoverBackground": "#3A3A4D",
        "scrollbarSlider.activeBackground": "#565F89",
        "terminal.background": "#0D0D0D",
        "terminal.foreground": "#E5E9F0",
        "terminalCursor.foreground": "#7DCFFF",
        "terminal.ansiBlack": "#1E1E2E",
        "terminal.ansiRed": "#FF5C57",
        "terminal.ansiGreen": "#9ECE6A",
        "terminal.ansiYellow": "#E0AF68",
        "terminal.ansiBlue": "#7AA2F7",
        "terminal.ansiMagenta": "#BB9AF7",
        "terminal.ansiCyan": "#7DCFFF",
        "terminal.ansiWhite": "#A9B1D6",
        "terminal.ansiBrightBlack": "#4E5173",
        "terminal.ansiBrightRed": "#FF5C57",
        "terminal.ansiBrightGreen": "#9ECE6A",
        "terminal.ansiBrightYellow": "#E0AF68",
        "terminal.ansiBrightBlue": "#7AA2F7",
        "terminal.ansiBrightMagenta": "#BB9AF7",
        "terminal.ansiBrightCyan": "#7DCFFF",
        "terminal.ansiBrightWhite": "#FFFFFF",
        "terminal.selectionBackground": "#2A2A3D",
        "terminal.linkForeground": "#7DCFFF"
    },
    "tokenColors": [
        {
            "scope": ["comment"],
            "settings": { "foreground": "#565F89", "fontStyle": "italic" }
        },
        {
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#7AA2F7", "fontStyle": "italic" }
        },
        {
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#9ECE6A" }
        },
        {
            "scope": ["constant.numeric", "constant.language"],
            "settings": { "foreground": "#E0AF68" }
        },
        {
            "scope": ["variable", "variable.parameter", "entity.name.variable"],
            "settings": { "foreground": "#A9B1D6" }
        },
        {
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#BB9AF7", "fontStyle": "bold" }
        },
        {
            "scope": ["entity.name.tag", "punctuation.definition.tag"],
            "settings": { "foreground": "#F7768E" }
        },
        {
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#7DCFFF" }
        },
        {
            "scope": ["markup.heading", "markup.heading.markdown"],
            "settings": { "foreground": "#BB9AF7", "fontStyle": "bold" }
        },
        {
            "scope": ["token.error-token"],
            "settings": { "foreground": "#FF5C57" }
        },
        {
            "scope": ["token.warn-token"],
            "settings": { "foreground": "#E0AF68" }
        },
        {
            "scope": ["token.info-token"],
            "settings": { "foreground": "#7AA2F7" }
        },
        {
            "scope": [
                "string.other.link",
                "support.constant.property-name.link"
            ],
            "settings": { "foreground": "#7DCFFF", "fontStyle": "underline" }
        }
    ]
}
