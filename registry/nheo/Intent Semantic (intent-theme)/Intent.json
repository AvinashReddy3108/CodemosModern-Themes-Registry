    "tokenColors": [
        {
            "name": "Comments",
            "scope": [
                "comment",
                "punctuation.definition.comment",
                "comment.block.documentation"
            ],
            "settings": { "foreground": "#505868", "fontStyle": "italic" }
        },
        {
            "name": "Doc comment tags (@param, @returns, etc.)",
            "scope": [
                "storage.type.class.jsdoc",
                "punctuation.definition.block.tag.jsdoc",
                "entity.name.type.instance.jsdoc"
            ],
            "settings": { "foreground": "#606878", "fontStyle": "italic" }
        },
        {
            "name": "Control flow keywords (if, for, while, return, switch, break, continue, try, catch)",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.control.flow",
                "keyword.operator.new",
                "keyword.operator.delete",
                "keyword.other.important.css"
            ],
            "settings": { "foreground": "#5c9cf5" }
        },
        {
            "name": "Import / Export / Module keywords (module plumbing)",
            "scope": [
                "keyword.control.import",
                "keyword.control.export",
                "keyword.control.from",
                "keyword.control.as",
                "keyword.control.require"
            ],
            "settings": { "foreground": "#4ec9b0", "fontStyle": "italic" }
        },
        {
            "name": "this / self / super (data flow - self reference)",
            "scope": [
                "variable.language.this",
                "variable.language.self",
                "variable.language.super",
                "variable.language.special.self"
            ],
            "settings": { "foreground": "#f09860", "fontStyle": "italic" }
        },
        {
            "name": "Operators (pure logic)",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#8890a0" }
        },
        {
            "name": "Assignment operators (data flow)",
            "scope": [
                "keyword.operator.assignment",
                "keyword.operator.arrow",
                "keyword.operator.pipe",
                "storage.type.function.arrow"
            ],
            "settings": { "foreground": "#e8a855" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation.definition",
                "punctuation.terminator",
                "punctuation.accessor",
                "meta.brace",
                "punctuation.separator",
                "punctuation.section"
            ],
            "settings": { "foreground": "#404858" }
        },
        {
            "name": "Strings (earth tones - literal data)",
            "scope": [
                "string",
                "string.quoted",
                "string.quoted.single",
                "string.quoted.double",
                "string.quoted.triple",
                "string.template",
                "string.unquoted",
                "punctuation.definition.string"
            ],
            "settings": { "foreground": "#8cb870" }
        },
        {
            "name": "Template / Interpolation braces (side effect - dynamic injection)",
            "scope": [
                "punctuation.definition.template-expression",
                "punctuation.section.embedded",
                "punctuation.definition.interpolation",
                "punctuation.section.interpolation"
            ],
            "settings": { "foreground": "#e06c88" }
        },
        {
            "name": "Escape characters (literal data)",
            "scope": [
                "constant.character.escape",
                "constant.other.placeholder"
            ],
            "settings": { "foreground": "#c8a86c" }
        },
        {
            "name": "Numbers (earth tones - literal data)",
            "scope": [
                "constant.numeric",
                "constant.numeric.integer",
                "constant.numeric.float",
                "constant.numeric.hex",
                "constant.numeric.binary"
            ],
            "settings": { "foreground": "#c8a86c" }
        },
        {
            "name": "Language constants true/false/null (earth tones)",
            "scope": ["constant.language"],
            "settings": { "foreground": "#b88860", "fontStyle": "italic" }
        },
        {
            "name": "Other constants (earth tones)",
            "scope": ["constant.character", "constant.other"],
            "settings": { "foreground": "#c8a86c" }
        },
        {
            "name": "Function names (side-effect capable)",
            "scope": [
                "entity.name.function",
                "meta.function-call entity.name.function",
                "support.function",
                "entity.name.function.member"
            ],
            "settings": { "foreground": "#e06c88" }
        },
        {
            "name": "Built-in functions (side-effect - hot)",
            "scope": ["support.function.builtin"],
            "settings": { "foreground": "#e87070" }
        },
        {
            "name": "Function parameters (data flow)",
            "scope": ["variable.parameter", "meta.parameters variable.other"],
            "settings": { "foreground": "#d4a856", "fontStyle": "italic" }
        },
        {
            "name": "Types, Classes & Interfaces (neutral - pure logic/structure)",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "entity.other.inherited-class",
                "support.type",
                "support.class",
                "entity.name.type.alias",
                "entity.name.type.enum",
                "entity.name.enum"
            ],
            "settings": { "foreground": "#b0b8c8" }
        },
        {
            "name": "Interfaces (pure abstraction - neutral gray-blue)",
            "scope": ["entity.name.type.interface"],
            "settings": { "foreground": "#8890a0", "fontStyle": "italic" }
        },
        {
            "name": "Type annotations & generics (neutral)",
            "scope": [
                "meta.type.annotation",
                "meta.type.parameters",
                "meta.return.type"
            ],
            "settings": { "foreground": "#b0b8c8" }
        },
        {
            "name": "Generic type parameters (neutral)",
            "scope": ["meta.type.parameters entity.name.type"],
            "settings": { "foreground": "#a0a8b8" }
        },
        {
            "name": "Namespace / Module names (module plumbing - teal)",
            "scope": ["entity.name.namespace", "entity.name.module"],
            "settings": { "foreground": "#4ec9b0" }
        },
        {
            "name": "Variables (data flow - warm)",
            "scope": ["variable", "variable.other", "variable.other.readwrite"],
            "settings": { "foreground": "#d4a856" }
        },
        {
            "name": "Object / member properties (data flow - warm gold)",
            "scope": [
                "variable.other.property",
                "support.variable.property",
                "meta.object-literal.key",
                "variable.other.object.property"
            ],
            "settings": { "foreground": "#c8a040" }
        },
        {
            "name": "Constants (UPPER_CASE) & enum members (earth tones)",
            "scope": ["variable.other.constant", "variable.other.enummember"],
            "settings": { "foreground": "#b88860" }
        },
        {
            "name": "Decorators & Annotations (side effect - hot pink)",
            "scope": [
                "meta.decorator",
                "punctuation.decorator",
                "entity.name.function.decorator",
                "meta.annotation",
                "storage.type.annotation",
                "punctuation.definition.annotation"
            ],
            "settings": { "foreground": "#f06090", "fontStyle": "italic" }
        },
        {
            "name": "JSX / HTML Tag names (side effect - rendering)",
            "scope": [
                "entity.name.tag",
                "meta.tag.sgml",
                "support.class.component"
            ],
            "settings": { "foreground": "#e87070" }
        },
        {
            "name": "JSX / HTML Attributes (data flow)",
            "scope": [
                "entity.other.attribute-name",
                "meta.tag entity.other.attribute-name"
            ],
            "settings": { "foreground": "#d4a856" }
        },
        {
            "name": "JSX expression braces",
            "scope": [
                "punctuation.section.embedded.begin.jsx",
                "punctuation.section.embedded.end.jsx"
            ],
            "settings": { "foreground": "#e06c88" }
        },
        {
            "name": "HTML entities (literal data)",
            "scope": ["constant.character.entity.html"],
            "settings": { "foreground": "#c8a86c" }
        },
        {
            "name": "CSS Property names (data flow - property access)",
            "scope": [
                "support.type.property-name.css",
                "support.type.property-name.scss",
                "support.type.property-name.less"
            ],
            "settings": { "foreground": "#c8a040" }
        },
        {
            "name": "CSS Values (literal data - earth)",
            "scope": [
                "support.constant.property-value.css",
                "support.constant.property-value.scss"
            ],
            "settings": { "foreground": "#8cb870" }
        },
        {
            "name": "CSS Units & important (literal data)",
            "scope": ["keyword.other.unit.css", "keyword.other.unit.scss"],
            "settings": { "foreground": "#c8a86c" }
        },
        {
            "name": "CSS Selectors class/id (neutral - structural)",
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css",
                "entity.other.attribute-name.class.scss",
                "entity.other.attribute-name.id.scss"
            ],
            "settings": { "foreground": "#b0b8c8" }
        },
        {
            "name": "CSS Tag selectors (side effect - rendering)",
            "scope": ["entity.name.tag.css", "entity.name.tag.scss"],
            "settings": { "foreground": "#e87070" }
        },
        {
            "name": "CSS pseudo-classes / pseudo-elements (control flow)",
            "scope": [
                "entity.other.attribute-name.pseudo-class.css",
                "entity.other.attribute-name.pseudo-element.css"
            ],
            "settings": { "foreground": "#56d6d6" }
        },
        {
            "name": "CSS At-rules @media, @keyframes (control flow)",
            "scope": [
                "keyword.control.at-rule.css",
                "keyword.control.at-rule.scss"
            ],
            "settings": { "foreground": "#5c9cf5" }
        },
        {
            "name": "CSS Variables (data flow)",
            "scope": ["variable.css", "variable.scss", "variable.less"],
            "settings": { "foreground": "#d4a856" }
        },
        {
            "name": "CSS Colors (literal data)",
            "scope": [
                "constant.other.color.rgb-value.css",
