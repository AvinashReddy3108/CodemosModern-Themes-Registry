    "tokenColors": [
        {
            "name": "Comments",
            "scope": [
                "comment",
                "punctuation.definition.comment",
                "comment.block.documentation"
            ],
            "settings": { "foreground": "#2a3040", "fontStyle": "italic" }
        },
        {
            "name": "Doc comment tags (@param, @returns, etc.)",
            "scope": [
                "storage.type.class.jsdoc",
                "punctuation.definition.block.tag.jsdoc",
                "entity.name.type.instance.jsdoc"
            ],
            "settings": { "foreground": "#303848", "fontStyle": "italic" }
        },
        {
            "name": "Keywords & Control Flow",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.control.flow",
                "keyword.operator.new",
                "keyword.operator.delete",
                "storage.type",
                "storage.modifier",
                "keyword.other.important.css"
            ],
            "settings": { "foreground": "#4a5570" }
        },
        {
            "name": "Import / Export / Module keywords",
            "scope": [
                "keyword.control.import",
                "keyword.control.export",
                "keyword.control.from",
                "keyword.control.as",
                "keyword.control.require"
            ],
            "settings": { "foreground": "#4a5570", "fontStyle": "italic" }
        },
        {
            "name": "this / self / super",
            "scope": [
                "variable.language.this",
                "variable.language.self",
                "variable.language.super",
                "variable.language.special.self"
            ],
            "settings": { "foreground": "#4a5570", "fontStyle": "italic" }
        },
        {
            "name": "Operators",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#4a4860" }
        },
        {
            "name": "Arrow / Pipe operators",
            "scope": [
                "keyword.operator.arrow",
                "keyword.operator.pipe",
                "storage.type.function.arrow"
            ],
            "settings": { "foreground": "#4a4860" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation.definition",
                "punctuation.terminator",
                "punctuation.accessor",
                "meta.brace",
                "punctuation.separator",
                "punctuation.section"
            ],
            "settings": { "foreground": "#303848" }
        },
        {
            "name": "Strings",
            "scope": [
                "string",
                "string.quoted",
                "string.quoted.single",
                "string.quoted.double",
                "string.quoted.triple",
                "string.template",
                "string.unquoted",
                "punctuation.definition.string"
            ],
            "settings": { "foreground": "#4a5848" }
        },
        {
            "name": "Template / Interpolation braces",
            "scope": [
                "punctuation.definition.template-expression",
                "punctuation.section.embedded",
                "punctuation.definition.interpolation",
                "punctuation.section.interpolation"
            ],
            "settings": { "foreground": "#4a5570" }
        },
        {
            "name": "Escape characters",
            "scope": [
                "constant.character.escape",
                "constant.other.placeholder"
            ],
            "settings": { "foreground": "#6a5040" }
        },
        {
            "name": "Numbers",
            "scope": [
                "constant.numeric",
                "constant.numeric.integer",
                "constant.numeric.float",
                "constant.numeric.hex",
                "constant.numeric.binary"
            ],
            "settings": { "foreground": "#6a5040" }
        },
        {
            "name": "Language constants (true / false / null / nil / undefined / None)",
            "scope": ["constant.language"],
            "settings": { "foreground": "#6a5040", "fontStyle": "italic" }
        },
        {
            "name": "Other constants",
            "scope": ["constant.character", "constant.other"],
            "settings": { "foreground": "#6a5040" }
        },
        {
            "name": "Function names",
            "scope": [
                "entity.name.function",
                "meta.function-call entity.name.function",
                "support.function",
                "support.function.builtin",
                "entity.name.function.member"
            ],
            "settings": { "foreground": "#565080" }
        },
        {
            "name": "Function parameters",
            "scope": ["variable.parameter", "meta.parameters variable.other"],
            "settings": { "foreground": "#586070", "fontStyle": "italic" }
        },
        {
            "name": "Types, Classes & Interfaces",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "entity.other.inherited-class",
                "support.type",
                "support.class",
                "entity.name.type.alias",
                "entity.name.type.interface",
                "entity.name.type.enum",
                "entity.name.enum"
            ],
            "settings": { "foreground": "#3a6858" }
        },
        {
            "name": "Type annotations & generics",
            "scope": [
                "meta.type.annotation",
                "meta.type.parameters",
                "meta.return.type"
            ],
            "settings": { "foreground": "#3a6858" }
        },
        {
            "name": "Generic type parameters",
            "scope": ["meta.type.parameters entity.name.type"],
            "settings": { "foreground": "#3a6060" }
        },
        {
            "name": "Namespace / Module names",
            "scope": ["entity.name.namespace", "entity.name.module"],
            "settings": { "foreground": "#3a6060" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "variable.other", "variable.other.readwrite"],
            "settings": { "foreground": "#606878" }
        },
        {
            "name": "Object / member properties",
            "scope": [
                "variable.other.property",
                "support.variable.property",
                "meta.object-literal.key",
                "variable.other.object.property"
            ],
            "settings": { "foreground": "#505868" }
        },
        {
            "name": "Constants (UPPER_CASE) & enum members",
            "scope": ["variable.other.constant", "variable.other.enummember"],
            "settings": { "foreground": "#6a5040" }
        },
        {
            "name": "Decorators & Annotations",
            "scope": [
                "meta.decorator",
                "punctuation.decorator",
                "entity.name.function.decorator",
                "meta.annotation",
                "storage.type.annotation",
                "punctuation.definition.annotation"
            ],
            "settings": { "foreground": "#6a4050", "fontStyle": "italic" }
        },
        {
            "name": "JSX / HTML Tag names",
            "scope": [
                "entity.name.tag",
                "meta.tag.sgml",
                "support.class.component"
            ],
            "settings": { "foreground": "#6a4050" }
        },
        {
            "name": "JSX / HTML Attributes",
            "scope": [
                "entity.other.attribute-name",
                "meta.tag entity.other.attribute-name"
            ],
            "settings": { "foreground": "#565080" }
        },
        {
            "name": "JSX expression braces",
            "scope": [
                "punctuation.section.embedded.begin.jsx",
                "punctuation.section.embedded.end.jsx"
            ],
            "settings": { "foreground": "#4a5570" }
        },
        {
            "name": "HTML entities",
            "scope": ["constant.character.entity.html"],
            "settings": { "foreground": "#6a5040" }
        },
        {
            "name": "CSS Property names",
            "scope": [
                "support.type.property-name.css",
                "support.type.property-name.scss",
                "support.type.property-name.less"
            ],
            "settings": { "foreground": "#565080" }
        },
        {
            "name": "CSS Values",
            "scope": [
                "support.constant.property-value.css",
                "support.constant.property-value.scss"
            ],
            "settings": { "foreground": "#4a5848" }
        },
        {
            "name": "CSS Units & important",
            "scope": ["keyword.other.unit.css", "keyword.other.unit.scss"],
            "settings": { "foreground": "#6a5040" }
        },
        {
            "name": "CSS Selectors (class / id)",
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css",
                "entity.other.attribute-name.class.scss",
                "entity.other.attribute-name.id.scss"
            ],
            "settings": { "foreground": "#3a6858" }
        },
        {
            "name": "CSS Tag selectors",
            "scope": ["entity.name.tag.css", "entity.name.tag.scss"],
            "settings": { "foreground": "#6a4050" }
        },
        {
            "name": "CSS pseudo-classes / pseudo-elements",
            "scope": [
                "entity.other.attribute-name.pseudo-class.css",
                "entity.other.attribute-name.pseudo-element.css"
            ],
            "settings": { "foreground": "#3a6060" }
        },
        {
            "name": "CSS At-rules (@media, @keyframes, etc.)",
            "scope": [
                "keyword.control.at-rule.css",
                "keyword.control.at-rule.scss"
            ],
            "settings": { "foreground": "#4a5570" }
        },
        {
            "name": "CSS Variables",
            "scope": ["variable.css", "variable.scss", "variable.less"],
            "settings": { "foreground": "#586070" }
        },
        {
            "name": "CSS Colors",
            "scope": [
                "constant.other.color.rgb-value.css",
                "support.constant.color.css"
            ],
            "settings": { "foreground": "#6a5040" }
        },
        {
            "name": "Regex string",
            "scope": ["string.regexp", "constant.regexp"],
            "settings": { "foreground": "#3a6858" }
        },
        {
