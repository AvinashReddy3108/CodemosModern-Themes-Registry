{
    "name": "Starlit Love",
    "type": "dark",
    "colors": {
        "editor.background": "#0E0D1B",
        "editor.foreground": "#FFFFFF",
        "editor.selectionBackground": "#2C2B49",
        "editor.lineHighlightBackground": "#2C2B49",
        "editorCursor.foreground": "#FFFFFF",
        "editorWhitespace.foreground": "#4B486E",
        "editorLineNumber.foreground": "#7875A3",
        "editorLineNumber.activeForeground": "#FFFFFF",
        "editorBracketMatch.background": "#6B65A3",
        "editorBracketMatch.border": "#6B65A3",
        "editor.hoverHighlightBackground": "#2C2B49",
        "editorOverviewRuler.border": "#2C2B49",
        "editorOverviewRuler.findMatchForeground": "#FFFFFF",
        "editorOverviewRuler.rangeHighlightForeground": "#FFFFFF",
        "editorOverviewRuler.selectionHighlightForeground": "#FFFFFF",
        "editorOverviewRuler.wordHighlightForeground": "#FFFFFF",
        "editorOverviewRuler.wordHighlightStrongForeground": "#FFFFFF",
        "editorRuler.foreground": "#FFFFFF",
        "editorError.foreground": "#FF7B7B",
        "editorWarning.foreground": "#FFBF75",
        "editorMarkerNavigationError.background": "#FF7B7B",
        "editorMarkerNavigationWarning.background": "#FFBF75",
        "editorMarkerNavigation.background": "#2C2B49",
        "editorGutter.background": "#0E0D1B",
        "editorGutter.modifiedBackground": "#6B65A3",
        "editorGutter.addedBackground": "#4B486E",
        "editorGutter.deletedBackground": "#FF7B7B",
        "editorGroupHeader.tabsBackground": "#2C2B49",
        "editorGroup.border": "#2C2B49",
        "editorGroup.dropBackground": "#6B65A3",
        "editorWidget.background": "#2C2B49",
        "editorWidget.border": "#2C2B49",
        "editorSuggestWidget.background": "#2C2B49",
        "editorSuggestWidget.border": "#2C2B49",
        "editorSuggestWidget.foreground": "#FFFFFF",
        "editorSuggestWidget.highlightForeground": "#A8A8A8",
        "editorSuggestWidget.selectedBackground": "#0E0D1B",
        "editorHoverWidget.background": "#2C2B49",
        "editorHoverWidget.border": "#2C2B49",
        "editorHoverWidget.statusBarBackground": "#2C2B49",
        "activityBar.background": "#2C2B49a8",
        "activityBar.foreground": "#FFFFFF",
        "activityBarBadge.background": "#4B486E",
        "sideBar.background": "#2C2B49",
        "sideBar.foreground": "#FFFFFF",
        "sideBarTitle.foreground": "#FFFFFF",
        "statusBar.background": "#2C2B49",
        "statusBar.foreground": "#FFFFFF",
        "statusBar.border": "#2C2B49",
        "statusBar.debuggingBackground": "#FF7B7B",
        "statusBar.debuggingForeground": "#FFFFFF",
        "statusBarItem.activeBackground": "#6B65A3cf",
        "statusBarItem.hoverBackground": "#4B486E59",
        "statusBarItem.prominentBackground": "#4B486E96",
        "titleBar.activeBackground": "#2C2B49",
        "titleBar.activeForeground": "#FFFFFF",
        "titleBar.inactiveBackground": "#2C2B49",
        "titleBar.inactiveForeground": "#7D78A1",
        "notificationCenterHeader.background": "#2C2B49",
        "extensionBadge.remoteBackground": "#4B486Eca",
        "tab.inactiveBackground": "#0E0D1B",
        "list.hoverBackground": "#4B486E36",
        "list.activeSelectionBackground": "#2C2B4936",
        "list.focusOutline": "#A8A8A814",
        "list.inactiveSelectionForeground": "#FFFFFFE6",
        "list.inactiveSelectionBackground": "#FFFFFF1d",
        "list.activeSelectionForeground": "#A8A8A8",
        "button.background": "#6B65A3",
        "button.foreground": "#FFFFFF",
        "button.secondaryHoverBackground": "#7D78A1"
    },
    "tokenColors": [
        {
            "name": "Comment",
            "scope": "comment",
            "settings": { "foreground": "#9384A3", "fontStyle": "italic" }
        },
        {
            "name": "String",
            "scope": "string",
            "settings": { "foreground": "#FFA2B1" }
        },
        {
            "name": "Keyword",
            "scope": "keyword",
            "settings": { "foreground": "#FFABCA", "fontStyle": "bold" }
        },
        {
            "name": "Function",
            "scope": "entity.name.function",
            "settings": { "foreground": "#FFA2B1" }
        },
        {
            "name": "Variable",
            "scope": "variable",
            "settings": { "foreground": "#D9DBE9" }
        },
        {
            "name": "Number",
            "scope": "constant.numeric",
            "settings": { "foreground": "#D9DBE9" }
        },
        {
            "name": "Boolean",
            "scope": "constant.language.boolean",
            "settings": { "foreground": "#D9DBE9" }
        },
        {
            "name": "Storage",
            "scope": "storage",
            "settings": { "foreground": "#FFA2B1" }
        },
        {
            "name": "Punctuation",
            "scope": "punctuation",
            "settings": { "foreground": "#D9DBE9" }
        },
        {
            "name": "Operator",
            "scope": "keyword.operator",
            "settings": { "foreground": "#D9DBE9" }
        },
        {
            "name": "Brackets",
            "scope": "punctuation.definition.string",
            "settings": { "foreground": "#FFCC66" }
        },
        {
            "name": "Constants",
            "scope": "constant",
            "settings": { "foreground": "#BC88F1E6", "fontStyle": "bold" }
        },
        {
            "name": "Parentheses",
            "scope": "punctuation.definition.arguments.begin",
            "settings": { "foreground": "#FFFFFFCC" }
        },
        {
            "name": "Parentheses End",
            "scope": "punctuation.definition.arguments.end",
            "settings": { "foreground": "#FFFFFFCC" }
        },
        {
            "name": "Support",
            "scope": "support",
            "settings": { "foreground": "#FFA2B1" }
        },
        {
            "name": "Type",
            "scope": "entity.name.type",
            "settings": { "foreground": "#FFA2B1" }
        },
        {
            "name": "Markup",
            "scope": "markup",
            "settings": { "foreground": "#FFA2B1" }
        },
        {
            "name": "Meta",
            "scope": "meta",
            "settings": { "foreground": "#FFA2B1" }
        },
        {
            "name": "Tag",
            "scope": "entity.name.tag",
            "settings": { "foreground": "#FFA2B1" }
        },
        {
            "name": "Attributes",
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#FFA2B1" }
        },
        {
            "name": "Invalid",
            "scope": "invalid",
            "settings": { "foreground": "#FF6B6B" }
        },
        {
            "name": "Diff Added",
            "scope": "diff.added",
            "settings": { "foreground": "#A9F1A7" }
        },
        {
            "name": "Diff Removed",
            "scope": "diff.removed",
            "settings": { "foreground": "#FF6B6B" }
        },
        {
            "name": "Diff Changed",
            "scope": "diff.changed",
            "settings": { "foreground": "#F1A7F2" }
        },
        {
            "name": "Decorators",
            "scope": "entity.name.function.decorator",
            "settings": { "foreground": "#C792EA" }
        },
        {
            "name": "Class Name",
            "scope": "entity.name.type.class",
            "settings": { "foreground": "#B2CCD6" }
        },
        {
            "name": "Function Call",
            "scope": "meta.function-call",
            "settings": { "foreground": "#82AAFF" }
        },
        {
            "name": "String Interpolation",
            "scope": "punctuation.definition.string.template.begin, punctuation.definition.string.template.end, punctuation.section.embedded",
            "settings": { "foreground": "#FFCC66" }
        },
        {
            "name": "Parameters",
            "scope": "variable.parameter",
            "settings": { "foreground": "#89DDFF" }
        },
        {
            "name": "Built-in Constants",
            "scope": "constant.language",
            "settings": { "foreground": "#C792EA" }
        },
        {
            "name": "Regex",
            "scope": "string.regexp",
            "settings": { "foreground": "#F78C6C" }
        },
        {
            "name": "Escape Characters",
            "scope": "constant.character.escape",
            "settings": { "foreground": "#89DDFF" }
        },
        {
            "name": "Module Name",
            "scope": "support.other.module",
            "settings": { "foreground": "#82AAFF" }
        },
        {
            "name": "Arguments",
            "scope": "variable.parameter.function",
            "settings": { "foreground": "#89DDFF" }
        },
        {
            "name": "Decorator Name",
            "scope": "meta.function.decorator",
            "settings": { "foreground": "#82AAFF" }
        },
        {
            "name": "Instance Variables",
            "scope": "variable.other",
            "settings": { "foreground": "#C792EA" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
