    "tokenColors": [
        {
            "scope": [
                "comment",
                "punctuation.definition.comment",
                "comment.block",
                "comment.line"
            ],
            "settings": { "foreground": "#4a5568", "fontStyle": "italic" }
        },
        {
            "scope": [
                "string",
                "string.quoted",
                "string.template",
                "string.interpolated",
                "string.regexp",
                "meta.template.expression"
            ],
            "settings": { "foreground": "#9fef00" }
        },
        {
            "scope": [
                "constant.character.escape",
                "constant.other.placeholder"
            ],
            "settings": { "foreground": "#ff8c42" }
        },
        {
            "scope": [
                "keyword.control",
                "keyword.control.flow",
                "keyword.control.import",
                "keyword.other",
                "keyword.operator.new",
                "keyword.operator.expression",
                "keyword.operator.logical",
                "keyword.operator.wordlike"
            ],
            "settings": { "foreground": "#bd93f9" }
        },
        {
            "scope": [
                "keyword.operator",
                "keyword.operator.assignment",
                "keyword.operator.arithmetic",
                "keyword.operator.comparison",
                "punctuation.separator",
                "punctuation.accessor"
            ],
            "settings": { "foreground": "#e2e8f0" }
        },
        {
            "scope": [
                "storage.type",
                "storage.modifier",
                "keyword.declaration",
                "keyword.declaration.function",
                "keyword.declaration.class"
            ],
            "settings": { "foreground": "#f4c430", "fontStyle": "bold" }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.numeric.integer",
                "constant.numeric.float",
                "constant.numeric.hex"
            ],
            "settings": { "foreground": "#00d4ff" }
        },
        {
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call",
                "meta.method-call entity.name.function"
            ],
            "settings": { "foreground": "#9fef00", "fontStyle": "bold" }
        },
        {
            "scope": [
                "entity.name.class",
                "entity.name.type.class",
                "entity.other.inherited-class",
                "support.class"
            ],
            "settings": { "foreground": "#f4c430" }
        },
        {
            "scope": [
                "variable.parameter",
                "entity.name.variable.parameter",
                "meta.function.parameters variable.other"
            ],
            "settings": { "foreground": "#ff8c42" }
        },
        {
            "scope": [
                "constant.language",
                "constant.character",
                "constant.other",
                "variable.other.constant"
            ],
            "settings": { "foreground": "#e63946", "fontStyle": "bold" }
        },
        {
            "scope": ["support.type", "support.type.primitive", "keyword.type"],
            "settings": { "foreground": "#00d4ff" }
        },
        {
            "scope": [
                "meta.decorator",
                "entity.name.function.decorator",
                "punctuation.definition.decorator"
            ],
            "settings": { "foreground": "#bd93f9", "fontStyle": "italic" }
        },
        {
            "scope": [
                "support.type.exception",
                "invalid",
                "invalid.illegal",
                "meta.embedded invalid"
            ],
            "settings": { "foreground": "#ff4d5e", "fontStyle": "bold" }
        },
        {
            "scope": ["entity.name.tag", "meta.tag.sgml"],
            "settings": { "foreground": "#e63946" }
        },
        {
            "scope": [
                "entity.other.attribute-name",
                "entity.other.attribute-name.html"
            ],
            "settings": { "foreground": "#ff8c42" }
        },
        {
            "scope": ["support.type.property-name", "meta.property-name"],
            "settings": { "foreground": "#00d4ff" }
        },
        {
            "scope": ["support.constant.property-value", "meta.property-value"],
            "settings": { "foreground": "#9fef00" }
        },
        {
            "scope": [
                "punctuation.definition.block",
                "punctuation.section.block",
                "meta.brace.round",
                "meta.brace.square"
            ],
            "settings": { "foreground": "#64748b" }
        },
        {
            "scope": ["variable", "variable.other", "variable.other.readwrite"],
            "settings": { "foreground": "#e2e8f0" }
        },
        {
            "scope": [
                "variable.language.self",
                "variable.language.this",
                "variable.language.super"
            ],
            "settings": { "foreground": "#bd93f9", "fontStyle": "italic" }
        },
        {
            "scope": [
                "support.function.builtin.shell",
                "entity.name.command.shell"
            ],
            "settings": { "foreground": "#9fef00" }
        },
        {
            "scope": [
                "string.regexp",
                "constant.other.character-class.regexp",
                "constant.character.numeric.regexp"
            ],
            "settings": { "foreground": "#ff8c42" }
        },
        {
            "scope": ["markup.heading", "entity.name.section.markdown"],
            "settings": { "foreground": "#e63946", "fontStyle": "bold" }
        },
        {
            "scope": "markup.bold",
            "settings": { "foreground": "#f4c430", "fontStyle": "bold" }
        },
        {
            "scope": "markup.inline.raw",
            "settings": { "foreground": "#9fef00" }
        },
        {
            "scope": ["markup.underline.link", "string.other.link.title"],
            "settings": { "foreground": "#00d4ff" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
