{
    "name": "Ra Autumn Light Theme",
    "$schema": "vscode://schemas/color-theme",
    "type": "light",
    "colors": {
        "activityBarBadge.background": "#cc3333",
        "editor.background": "#ffffff",
        "editor.foreground": "#333333",
        "editor.inactiveSelectionBackground": "#e5ebf1",
        "editor.selectionHighlightBackground": "#add6ff80",
        "editorIndentGuide.activeBackground": "#939393",
        "editorIndentGuide.background": "#d3d3d3",
        "editorSuggestWidget.background": "#f3f3f3",
        "input.placeholderForeground": "#767676",
        "list.hoverBackground": "#e8e8e8",
        "settings.numberInputBorder": "#cecece",
        "settings.textInputBorder": "#cecece",
        "sideBarTitle.foreground": "#6f6f6f",
        "statusBarItem.remoteBackground": "#16825d",
        "statusBarItem.remoteForeground": "#ffffff",
        "activityBar.background": "#ffffff",
        "activityBar.dropBackground": "#00000010",
        "activityBar.foreground": "#333333",
        "activityBar.inactiveForeground": "#777777",
        "activityBar.border": "#00000018",
        "editorGroup.border": "#00000018",
        "editorGroupHeader.tabsBackground": "#ffffff",
        "editorGroupHeader.tabsBorder": "#00000018",
        "editorLineNumber.activeForeground": "#333333",
        "editorLineNumber.foreground": "#aaaaaa",
        "list.activeSelectionBackground": "#00000018",
        "list.activeSelectionForeground": "#000000",
        "list.dropBackground": "#00000010",
        "list.focusBackground": "#ffffff",
        "list.inactiveSelectionBackground": "#00000010",
        "panel.border": "#00000018",
        "sideBar.background": "#ffffff",
        "sideBar.border": "#00000018",
        "sideBarSectionHeader.background": "#ffffff",
        "statusBar.background": "#ffffff",
        "statusBar.foreground": "#333333",
        "statusBar.border": "#00000018",
        "statusBarItem.activeBackground": "#00000018",
        "statusBarItem.hoverBackground": "#00000018",
        "tab.activeForeground": "#000000",
        "tab.border": "#00000018",
        "tab.inactiveBackground": "#ffffff"
    },
    "tokenColors": [
        {
            "scope": ["meta.embedded", "source.groovy.embedded"],
            "settings": { "foreground": "#00cc6600" }
        },
        { "scope": "emphasis", "settings": { "fontStyle": "italic" } },
        { "scope": "strong", "settings": { "fontStyle": "bold" } },
        {
            "scope": "meta.diff.header",
            "settings": { "foreground": "#cc3333" }
        },
        { "scope": "comment", "settings": { "foreground": "#aaaaaa" } },
        {
            "scope": "constant.language",
            "settings": { "foreground": "#cc6600" }
        },
        {
            "scope": [
                "constant.numeric",
                "entity.name.operator.custom-literal.number",
                "variable.other.enummember",
                "keyword.operator.plus.exponent",
                "keyword.operator.minus.exponent"
            ],
            "settings": { "foreground": "#0066cc" }
        },
        { "scope": "constant.regexp", "settings": { "foreground": "#cc3333" } },
        {
            "name": "css tags in selectors, xml tags",
            "scope": "entity.name.tag",
            "settings": { "foreground": "#cc3333" }
        },
        {
            "scope": "entity.name.selector",
            "settings": { "foreground": "#cc3333" }
        },
        {
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#cc6600" }
        },
        {
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.class.mixin.css",
                "entity.other.attribute-name.id.css",
                "entity.other.attribute-name.parent-selector.css",
                "entity.other.attribute-name.pseudo-class.css",
                "entity.other.attribute-name.pseudo-element.css",
                "source.css.less entity.other.attribute-name.id",
                "entity.other.attribute-name.attribute.scss",
                "entity.other.attribute-name.scss"
            ],
            "settings": { "foreground": "#cc3333" }
        },
        { "scope": "invalid", "settings": { "foreground": "#cd3131" } },
        {
            "scope": "markup.underline",
            "settings": { "fontStyle": "underline" }
        },
        {
            "scope": "markup.bold",
            "settings": { "fontStyle": "bold", "foreground": "#cc3333" }
        },
        {
            "scope": "markup.heading",
            "settings": { "fontStyle": "bold", "foreground": "#cc3333" }
        },
        { "scope": "markup.italic", "settings": { "fontStyle": "italic" } },
        { "scope": "markup.inserted", "settings": { "foreground": "#0066cc" } },
        { "scope": "markup.deleted", "settings": { "foreground": "#0066cc" } },
        { "scope": "markup.changed", "settings": { "foreground": "#cc6600" } },
        {
            "scope": [
                "punctuation.definition.quote.begin.markdown",
                "punctuation.definition.list.begin.markdown"
            ],
            "settings": { "foreground": "#cc6600" }
        },
        {
            "scope": "markup.inline.raw",
            "settings": { "foreground": "#cc3333" }
        },
        {
            "name": "brackets of XML/HTML tags",
            "scope": "punctuation.definition.tag",
            "settings": { "foreground": "#cc3333" }
        },
        {
            "scope": ["meta.preprocessor"],
            "settings": { "foreground": "#cc6600" }
        },
        {
            "scope": "meta.preprocessor.string",
            "settings": { "foreground": "#0066cc" }
        },
        {
            "scope": "meta.preprocessor.numeric",
            "settings": { "foreground": "#0066cc" }
        },
        {
            "scope": "meta.structure.dictionary.key.python",
            "settings": { "foreground": "#cc6600" }
        },
        { "scope": "storage", "settings": { "foreground": "#cc6600" } },
        { "scope": "storage.type", "settings": { "foreground": "#cc6600" } },
        {
            "scope": ["storage.modifier", "keyword.operator.noexcept"],
            "settings": { "foreground": "#cc6600" }
        },
        {
            "scope": ["string", "entity.name.operator.custom-literal.string"],
            "settings": { "foreground": "#0066cc" }
        },
        {
            "scope": [
                "string.comment.buffered.block.pug",
                "string.quoted.pug",
                "string.interpolated.pug",
                "string.unquoted.plain.in.yaml",
                "string.unquoted.plain.out.yaml",
                "string.unquoted.block.yaml",
                "string.quoted.single.yaml",
                "string.quoted.double.xml",
                "string.quoted.single.xml",
                "string.unquoted.cdata.xml",
                "string.quoted.double.html",
                "string.quoted.single.html",
                "string.unquoted.html",
                "string.quoted.single.handlebars",
                "string.quoted.double.handlebars"
            ],
            "settings": { "foreground": "#0066cc" }
        },
        { "scope": "string.regexp", "settings": { "foreground": "#cc3333" } },
        {
            "name": "String interpolation",
            "scope": [
                "punctuation.definition.template-expression.begin",
                "punctuation.definition.template-expression.end",
                "punctuation.section.embedded"
            ],
            "settings": { "foreground": "#cc6600" }
        },
        {
            "name": "Reset JavaScript string interpolation expression",
            "scope": ["meta.template.expression"],
            "settings": { "foreground": "#333333" }
        },
        {
            "scope": [
                "support.constant.property-value",
                "support.constant.font-name",
                "support.constant.media-type",
                "support.constant.media",
                "constant.other.color.rgb-value",
                "constant.other.rgb-value",
                "support.constant.color"
            ],
            "settings": { "foreground": "#cc6600" }
        },
        {
            "scope": [
                "support.type.vendored.property-name",
                "support.type.property-name",
                "variable.css",
                "variable.scss",
                "variable.other.less",
                "source.coffee.embedded"
            ],
            "settings": { "foreground": "#cc6600" }
        },
        {
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#cc6600" }
        },
        { "scope": "keyword", "settings": { "foreground": "#cc6600" } },
        { "scope": "keyword.control", "settings": { "foreground": "#cc6600" } },
        {
            "scope": "keyword.operator",
            "settings": { "foreground": "#333333" }
        },
        {
            "scope": [
                "keyword.operator.new",
                "keyword.operator.expression",
                "keyword.operator.cast",
                "keyword.operator.sizeof",
                "keyword.operator.typeid",
                "keyword.operator.alignas",
                "keyword.operator.instanceof",
                "keyword.operator.logical.python",
                "keyword.operator.wordlike"
            ],
            "settings": { "foreground": "#cc6600" }
        },
        {
            "scope": "keyword.other.unit",
            "settings": { "foreground": "#0066cc" }
        },
        {
            "scope": [
                "punctuation.section.embedded.begin.php",
                "punctuation.section.embedded.end.php"
            ],
            "settings": { "foreground": "#cc3333" }
        },
        {
            "scope": "support.function.git-rebase",
            "settings": { "foreground": "#cc6600" }
        },
        {
            "scope": "constant.sha.git-rebase",
            "settings": { "foreground": "#0066cc" }
        },
        {
            "name": "coloring of the Java import and package identifiers",
            "scope": [
                "storage.modifier.import.java",
                "variable.language.wildcard.java",
                "storage.modifier.package.java"
            ],
            "settings": { "foreground": "#333333" }
        },
        {
            "name": "this.self",
            "scope": "variable.language",
            "settings": { "foreground": "#cc6600" }
        },
        {
            "name": "Function declarations",
            "scope": [
                "entity.name.function",
                "support.function",
                "support.constant.handlebars",
                "source.powershell variable.other.member"
            ],
            "settings": { "foreground": "#888800" }
        },
        {
            "name": "Types declaration and references",
            "scope": [
                "meta.return-type",
                "support.class",
                "support.type",
                "entity.name.type",
                "entity.name.namespace",
                "entity.other.attribute",
                "entity.name.scope-resolution",
                "entity.name.class",
                "storage.type.numeric.go",
                "storage.type.byte.go",
                "storage.type.boolean.go",
                "storage.type.string.go",
                "storage.type.uintptr.go",
                "storage.type.error.go",
                "storage.type.rune.go",
                "storage.type.cs",
                "storage.type.generic.cs",
                "storage.type.modifier.cs",
                "storage.type.variable.cs",
                "storage.type.annotation.java",
                "storage.type.generic.java",
                "storage.type.java",
                "storage.type.object.array.java",
                "storage.type.primitive.array.java",
                "storage.type.primitive.java",
                "storage.type.token.java",
                "storage.type.groovy",
                "storage.type.annotation.groovy",
                "storage.type.parameters.groovy",
                "storage.type.generic.groovy",
                "storage.type.object.array.groovy",
                "storage.type.primitive.array.groovy",
                "storage.type.primitive.groovy"
            ],
            "settings": { "foreground": "#cc3333" }
        },
        {
            "name": "Types declaration and references, TS grammar specific",
            "scope": [
                "meta.type.cast.expr",
                "meta.type.new.expr",
                "support.constant.math",
                "support.constant.dom",
                "support.constant.json",
                "entity.other.inherited-class"
            ],
            "settings": { "foreground": "#cc3333" }
        },
        {
            "name": "Control flow / Special keywords",
            "scope": [
                "keyword.control",
                "source.cpp keyword.operator.new",
                "source.cpp keyword.operator.delete",
                "keyword.other.using",
                "keyword.other.operator",
                "entity.name.operator"
            ],
            "settings": { "foreground": "#cc6600" }
        },
        {
            "name": "Variable and parameter name",
            "scope": [
                "variable",
                "meta.definition.variable.name",
                "support.variable",
                "entity.name.variable"
            ],
            "settings": { "foreground": "#333333" }
        },
        {
            "name": "Object keys, TS grammar specific",
            "scope": ["meta.object-literal.key"],
            "settings": { "foreground": "#333333" }
        },
        {
            "name": "CSS property value",
            "scope": [
                "support.constant.property-value",
                "support.constant.font-name",
                "support.constant.media-type",
                "support.constant.media",
                "constant.other.color.rgb-value",
                "constant.other.rgb-value",
                "support.constant.color"
            ],
            "settings": { "foreground": "#cc6600" }
        },
        {
            "name": "Regular expression groups",
            "scope": [
                "punctuation.definition.group.regexp",
                "punctuation.definition.group.assertion.regexp",
                "punctuation.definition.character-class.regexp",
                "punctuation.character.set.begin.regexp",
                "punctuation.character.set.end.regexp",
                "keyword.operator.negation.regexp",
                "support.other.parenthesis.regexp"
            ],
            "settings": { "foreground": "#d16969" }
        },
        {
            "scope": [
                "constant.character.character-class.regexp",
                "constant.other.character-class.set.regexp",
                "constant.other.character-class.regexp",
                "constant.character.set.regexp"
            ],
            "settings": { "foreground": "#cc3333" }
        },
        {
            "scope": "keyword.operator.quantifier.regexp",
            "settings": { "foreground": "#333333" }
        },
        {
            "scope": [
                "keyword.operator.or.regexp",
                "keyword.control.anchor.regexp"
            ],
            "settings": { "foreground": "#cc6600" }
        },
        {
            "scope": "constant.character",
            "settings": { "foreground": "#cc6600" }
        },
        {
            "scope": "constant.character.escape",
            "settings": { "foreground": "#cc6600" }
        },
        {
            "scope": "entity.name.label",
            "settings": { "foreground": "#333333" }
        },
        {
            "scope": "token.info-token",
            "settings": { "foreground": "#316bcd" }
        },
        {
            "scope": "token.warn-token",
            "settings": { "foreground": "#cd9731" }
        },
        {
            "scope": "token.error-token",
            "settings": { "foreground": "#cd3131" }
        },
        {
            "scope": "token.debug-token",
            "settings": { "foreground": "#800080" }
        }
    ]
}
