    "tokenColors": [
        {
            "scope": "comment",
            "settings": { "foreground": "#625871", "fontStyle": "italic" }
        },
        {
            "scope": "support.type.property-name.css",
            "settings": { "foreground": "#b3afce", "fontStyle": "normal" }
        },
        {
            "scope": [
                "keyword",
                "storage.type.js",
                "storage.type.function",
                "storage.modifier"
            ],
            "settings": { "foreground": "#a679fc", "fontStyle": "bold" }
        },
        {
            "scope": [
                "keyword.operator",
                "storage.type.function.arrow",
                "punctuation.separator.key-value.html",
                "support.type.vendored.property-name",
                "entity.other.attribute-name.pseudo-class",
                "entity.other.attribute-name.pseudo-element",
                "keyword.other.unit"
            ],
            "settings": { "foreground": "#55c6ce", "fontStyle": "normal" }
        },
        {
            "scope": [
                "storage.type",
                "entity.name.tag",
                "support.type.property-name",
                "variable.other.property.js",
                "variable.scss"
            ],
            "settings": { "foreground": "#b2437c", "fontStyle": "normal" }
        },
        {
            "scope": [
                "entity.name.function",
                "support.function",
                "constant.character.escape",
                "markup.underline.link.markdown",
                "markup.underline.link.image.markdown"
            ],
            "settings": { "foreground": "#6a8cf6", "fontStyle": "normal" }
        },
        {
            "scope": [
                "string",
                "punctuation.definition.markdown",
                "punctuation.definition.raw.markdown"
            ],
            "settings": { "foreground": "#57ad9c", "fontStyle": "normal" }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.language.boolean",
                "entity.other.attribute-name",
                "support.variable.property",
                "variable.other.property",
                "constant.language.json",
                "support.constant.property-value",
                "support.constant.color",
                "constant.other.color.rgb-value",
                "punctuation.definition.list.begin"
            ],
            "settings": { "foreground": "#bb8c85", "fontStyle": "normal" }
        },
        {
            "scope": "variable.parameter",
            "settings": { "fontStyle": "italic" }
        },
        {
            "scope": [
                "variable.other.constant",
                "punctuation.definition.table.markdown",
                "punctuation.separator.table.markdown",
                "string.other.link.title.markdown",
                "string.other.link.description.markdown",
                "punctuation.definition.quote.begin.markdown"
            ],
            "settings": { "foreground": "#dcaa70", "fontStyle": "normal" }
        },
        {
            "scope": ["variable.other.readwrite.alias"],
            "settings": { "foreground": "#ff0" }
        },
        {
            "scope": "support.type.object.module",
            "settings": { "foreground": "#dcaa70", "fontStyle": "bold" }
        },
        {
            "scope": ["entity.name.section", "punctuation.definition.heading"],
            "settings": { "foreground": "#55c6ce", "fontStyle": "bold" }
        },
        {
            "scope": "markup.bold.markdown",
            "settings": { "fontStyle": "bold" }
        },
        {
            "scope": "markup.italic.markdown",
            "settings": { "fontStyle": "italic" }
        },
        {
            "scope": "markup.strikethrough.markdown",
            "settings": { "fontStyle": "strikethrough" }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "enumMember": { "foreground": "#ff0000" },
        "variable.constant": { "foreground": "#ff0000" },
        "variable.defaultLibrary": {
            "foreground": "#dcaa70",
            "fontStyle": "bold"
        },
        "variable:dart": { "foreground": "#ff0000" },
        "property:dart": { "foreground": "#ff0000" },
        "annotation:dart": { "foreground": "#ff0000" },
        "parameter.label:dart": { "foreground": "#ff0000" },
        "macro": { "foreground": "#ff0000" },
        "tomlArrayKey": { "foreground": "#ff0000" }
    },
    "$schema": "vscode://schemas/color-theme"
}
