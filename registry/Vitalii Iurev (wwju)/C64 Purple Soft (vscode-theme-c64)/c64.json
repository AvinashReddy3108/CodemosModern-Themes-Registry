{
    "name": "C64 Purple Soft",
    "tokenColors": [
        { "settings": { "background": "#30207C", "foreground": "#7869C4" } },
        {
            "name": "Comment",
            "scope": "comment",
            "settings": { "foreground": "#6752C9", "fontStyle": "italic" }
        },
        {
            "name": "String",
            "scope": "string",
            "settings": { "foreground": "#CDABAD" }
        },
        {
            "name": "Built-in constant",
            "scope": "constant.language",
            "settings": { "foreground": "#F7F7F7" }
        },
        {
            "name": "User-defined constant",
            "scope": ["constant.character", "constant.other"],
            "settings": { "foreground": "#F7F7F7" }
        },
        {
            "name": "Variable",
            "scope": "variable",
            "settings": { "foreground": "#AFA3EE" }
        },
        {
            "name": "Keyword",
            "scope": "keyword",
            "settings": { "foreground": "#6A86B3" }
        },
        {
            "name": "Class name",
            "scope": ["entity.name.class", "entity.name.type"],
            "settings": { "fontStyle": "underline", "foreground": "#9469B5" }
        },
        {
            "name": "Function name",
            "scope": "entity.name.function",
            "settings": { "fontStyle": "", "foreground": "#67B6BD" }
        },
        {
            "name": "Tag name",
            "scope": "entity.name.tag",
            "settings": { "fontStyle": "", "foreground": "#67B6BD" }
        },
        {
            "name": "Library class/type",
            "scope": ["support.type", "support.class"],
            "settings": { "foreground": "#67B6BD" }
        },
        {
            "name": "Library variable",
            "scope": "support.other.variable",
            "settings": { "foreground": "#67B6BD" }
        }
    ],
    "colors": {
        "focusBorder": "#D3AF86",
        "input.background": "#652a70",
        "inputOption.activeBorder": "#67B6BD",
        "editor.background": "#40318D",
        "editor.foreground": "#7869C4",
        "editor.lineHighlightBackground": "#30207C",
        "editor.selectionBackground": "#382d83",
        "editorIndentGuide.background": "#463793",
        "editor.hoverHighlightBackground": "#3b2c82",
        "editorHoverWidget.border": "#fff",
        "editorLineNumber.foreground": "#67B6BD",
        "editor.findWidgetBackground": "#40318D",
        "activityBar.background": "#463793",
        "activityBarBadge.background": "#7869c4",
        "sideBar.background": "#40357B",
        "titleBar.activeBackground": "",
        "titleBar.inactiveBackground": "",
        "statusBar.background": "#7869c4"
    },
    "$schema": "vscode://schemas/color-theme"
}
