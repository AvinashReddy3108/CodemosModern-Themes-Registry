{
    "name": "Kurdish Vibrant Theme",
    "type": "dark",
    "colors": {
        "sideBar.background": "#1a1122",
        "sideBar.foreground": "#ffffff",
        "sideBar.border": "#3d0355",
        "tab.activeBackground": "#3d0355",
        "tab.inactiveBackground": "#1a1122",
        "tab.activeForeground": "#ffffff",
        "tab.inactiveForeground": "#ffffff",
        "tab.border": "#cacaca00",
        "activityBar.background": "#1a1122",
        "activityBar.foreground": "#ffffff",
        "activityBar.inactiveForeground": "#8d8d8d",
        "activityBar.activeBorder": "#3d0355",
        "titleBar.activeBackground": "#1a1122",
        "titleBar.inactiveBackground": "#24232d",
        "titleBar.activeForeground": "#FFFFFF",
        "titleBar.inactiveForeground": "#ffffff",
        "window.activeBorder": "#3d0355",
        "window.inactiveBorder": "#23222a",
        "terminal.foreground": "#ffffff",
        "terminal.background": "#1a1122",
        "terminal.ansiBlack": "#1a1122",
        "terminal.ansiRed": "#ff5555",
        "terminal.ansiGreen": "#55ff55",
        "terminal.ansiYellow": "#ffff55",
        "terminal.ansiBlue": "#5555ff",
        "terminal.ansiMagenta": "#ff55ff",
        "terminal.ansiCyan": "#55ffff",
        "terminal.ansiWhite": "#bbbbbb",
        "panel.background": "#1a1122",
        "panel.border": "#3d0355",
        "panelTitle.activeForeground": "#ffffff",
        "panelTitle.inactiveForeground": "#b0b0b0",
        "panelTitle.activeBorder": "#82658f",
        "statusBar.background": "#1a1122",
        "statusBar.foreground": "#ffffff",
        "statusBar.border": "#3d0355",
        "statusBar.noFolderBackground": "#1a1122",
        "statusBar.debuggingBackground": "#3d0355",
        "statusBarItem.activeBackground": "#3d0355",
        "statusBarItem.hoverBackground": "#3d0355",
        "statusBarItem.prominentBackground": "#3d0355",
        "statusBarItem.prominentHoverBackground": "#82658f",
        "editor.background": "#1a1122",
        "editor.foreground": "#ffffff",
        "editorGroupHeader.tabsBackground": "#1a1122",
        "editorGroupHeader.noTabsBackground": "#1a1122",
        "editorGroup.emptyBackground": "#1a1122",
        "editorWidget.background": "#1a1122",
        "editorWidget.foreground": "#ffffff",
        "editorSuggestWidget.background": "#1a1122",
        "editorSuggestWidget.foreground": "#ffffff",
        "editorHoverWidget.background": "#1a1122",
        "editorHoverWidget.foreground": "#ffffff",
        "breadcrumb.background": "#1a1122",
        "breadcrumb.foreground": "#b0b0b0",
        "sideBarSectionHeader.background": "#1a1122",
        "sideBarSectionHeader.foreground": "#ffffff",
        "list.activeSelectionBackground": "#3d0355",
        "list.inactiveSelectionBackground": "#1a1122",
        "list.hoverBackground": "#3d0355",
        "dropdown.background": "#1a1122",
        "dropdown.foreground": "#ffffff",
        "input.background": "#1a1122",
        "input.foreground": "#ffffff",
        "scrollbarSlider.background": "#3d035588",
        "scrollbarSlider.hoverBackground": "#82658f88",
        "scrollbarSlider.activeBackground": "#82658fcc"
    },
    "tokenColors": [
        {
            "name": "Default Source",
            "scope": ["source", "text"],
            "settings": { "foreground": "#b0b0b0" }
        },
        {
            "name": "CSS Property Name",
            "scope": [
                "support.type.property-name.css",
                "support.type.property-name.scss",
                "support.type.property-name.sass",
                "support.type.property-name.less",
                "support.type.property-name.stylus",
                "support.type.property-name.postcss"
            ],
            "settings": { "foreground": "#9CDCFE" }
        },
        {
            "name": "CSS Property Value",
            "scope": [
                "support.constant.property-value.css",
                "support.constant.property-value.scss",
                "support.constant.property-value.sass",
                "support.constant.property-value.less",
                "support.constant.property-value.stylus",
                "support.constant.property-value.postcss"
            ],
            "settings": { "foreground": "#CE9178" }
        },
        {
            "name": "CSS Selector",
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css",
                "entity.other.attribute-name.class.scss",
                "entity.other.attribute-name.id.scss",
                "entity.other.attribute-name.class.sass",
                "entity.other.attribute-name.id.sass"
            ],
            "settings": { "foreground": "#D7BA7D", "fontStyle": "bold" }
        },
        {
            "name": "CSS Hex Color",
            "scope": [
                "constant.other.color.rgb-value.hex.css",
                "constant.other.color.rgb-value.hex.scss",
                "constant.other.color.rgb-value.hex.sass"
            ],
            "settings": { "foreground": "#FF6B6B" }
        },
        {
            "name": "CSS Gradient Function",
            "scope": [
                "support.function.gradient.css",
                "meta.function.gradient.css",
                "support.function.gradient.scss",
                "support.function.gradient.sass"
            ],
            "settings": { "foreground": "#61AFEF", "fontStyle": "italic" }
        },
        {
            "name": "CSS Color Function",
            "scope": [
                "support.function.misc.css",
                "meta.function.color.css",
                "support.function.misc.scss",
                "support.function.misc.sass"
            ],
            "settings": { "foreground": "#7EDDBB", "fontStyle": "italic" }
        },
        {
            "name": "CSS Custom Property and Var",
            "scope": [
                "variable.argument.css",
                "meta.function.variable.css",
                "support.function.var.css",
                "variable.argument.scss",
                "variable.argument.sass"
            ],
            "settings": { "foreground": "#FFDFAE" }
        },
        {
            "name": "CSS Transform Function",
            "scope": [
                "support.function.transform.css",
                "support.function.transform.scss",
                "support.function.transform.sass"
            ],
            "settings": { "foreground": "#61AFEF", "fontStyle": "italic" }
        },
        {
            "name": "CSS Numeric Value",
            "scope": [
                "constant.numeric.css",
                "constant.numeric.scss",
                "constant.numeric.sass"
            ],
            "settings": { "foreground": "#E5C07B" }
        },
        {
            "name": "CSS Property List",
            "scope": [
                "meta.property-list.css",
                "meta.property-list.scss",
                "meta.property-list.sass"
            ],
            "settings": { "foreground": "#98C379" }
        },
        {
            "name": "PHP Variable",
            "scope": ["variable.other.php"],
            "settings": { "foreground": "#D19A66" }
        },
        {
            "name": "PHP Function",
            "scope": ["entity.name.function.php", "meta.function.php"],
            "settings": { "foreground": "#61AFEF", "fontStyle": "italic" }
        },
        {
            "name": "PHP Class",
            "scope": [
                "entity.name.type.class.php",
                "support.class.php",
                "entity.other.inherited-class.php"
            ],
            "settings": { "foreground": "#C678DD", "fontStyle": "bold" }
        },
        {
            "name": "PHP Keyword",
            "scope": [
                "keyword.control.php",
                "keyword.other.use.php",
                "meta.use.php",
                "storage.type.class.php",
                "storage.modifier.extends.php",
                "storage.modifier.php"
            ],
            "settings": { "foreground": "#E06C75", "fontStyle": "bold" }
        },
        {
            "name": "PHP String",
            "scope": ["string.quoted.single.php", "string.quoted.double.php"],
            "settings": { "foreground": "#98C379" }
        },
        {
            "name": "PHP Number",
            "scope": ["constant.numeric.php"],
            "settings": { "foreground": "#E5C07B" }
        },
        {
            "name": "PHP Embedded Tag",
            "scope": [
                "punctuation.section.embedded.begin.php",
                "punctuation.section.embedded.end.php"
            ],
            "settings": { "foreground": "#FF6B6B", "fontStyle": "bold" }
        },
        {
            "name": "PHP Namespace",
            "scope": ["entity.name.type.namespace.php", "meta.namespace.php"],
            "settings": { "foreground": "#C678DD", "fontStyle": "bold" }
        },
        {
            "name": "PHP this Variable",
            "scope": ["variable.language.this.php"],
            "settings": { "foreground": "#ffb86b", "fontStyle": "bold" }
        },
        {
            "name": "PHP Object Property",
            "scope": ["variable.other.property.php"],
            "settings": { "foreground": "#baff7e" }
        },
        {
            "name": "JS Function",
            "scope": [
                "entity.name.function.js",
                "entity.name.function.javascript"
            ],
            "settings": { "foreground": "#6ee7ff", "fontStyle": "italic" }
        },
        {
            "name": "JS Variable",
            "scope": [
                "variable.other.readwrite.js",
                "variable.other.readwrite.javascript"
            ],
            "settings": { "foreground": "#FFDFAE" }
        },
        {
            "name": "JS String",
            "scope": [
                "string.quoted.double.js",
                "string.quoted.single.js",
                "string.quoted.double.javascript",
                "string.quoted.single.javascript"
            ],
            "settings": { "foreground": "#98C379" }
        },
        {
            "name": "JS Number",
            "scope": ["constant.numeric.js", "constant.numeric.javascript"],
            "settings": { "foreground": "#baff7e" }
        },
        {
            "name": "JS Built-in Object",
            "scope": [
                "variable.language.js",
                "variable.language.javascript",
                "support.class.builtin.js",
                "support.class.builtin.javascript"
            ],
            "settings": { "foreground": "#ffb86b", "fontStyle": "bold" }
        },
        {
            "name": "JS Function Parameter",
            "scope": [
                "variable.parameter.js",
                "variable.parameter.function.js",
                "variable Kinguage parameter.javascript"
            ],
            "settings": { "foreground": "#7edfff" }
        },
        {
            "name": "JS Object Variable",
            "scope": [
                "variable.other.object.js",
                "variable.other.object.javascript"
            ],
            "settings": { "foreground": "#ffb86b", "fontStyle": "bold" }
        },
        {
            "name": "JS Object Property",
            "scope": [
                "variable.other.property.js",
                "variable.other.property.javascript"
            ],
            "settings": { "foreground": "#baff7e" }
        },
        {
            "name": "JS Object Literal Key",
            "scope": [
                "meta.object-literal.key.js",
                "meta.object-literal.key.javascript"
            ],
            "settings": { "foreground": "#ff7edb", "fontStyle": "bold" }
        },
        {
            "name": "HTML Tag",
            "scope": ["entity.name.tag.html", "entity.name.tag.blade"],
            "settings": { "foreground": "#61AFEF", "fontStyle": "bold" }
        },
        {
            "name": "HTML Attribute Name",
            "scope": [
                "entity.other.attribute-name.html",
                "entity.other.attribute-name.blade"
            ],
            "settings": { "foreground": "#D19A66", "fontStyle": "italic" }
        },
        {
            "name": "HTML String",
            "scope": [
                "string.quoted.double.html",
                "string.quoted.single.html",
                "string.quoted.double.blade",
                "string.quoted.single.blade"
            ],
            "settings": { "foreground": "#98C379" }
        },
        {
            "name": "Blade Directive",
            "scope": [
                "keyword.control.directive.blade",
                "keyword.blade",
                "meta.directive.blade"
            ],
            "settings": { "foreground": "#C678DD", "fontStyle": "bold" }
        },
        {
            "name": "CSS Variable",
            "scope": [
                "variable.css",
                "variable.other.css",
                "variable.scss",
                "variable.other.scss",
                "variable.sass",
                "variable.other.sass",
                "variable.less",
                "variable.other.less"
            ],
            "settings": { "foreground": "#FFDFAE" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
