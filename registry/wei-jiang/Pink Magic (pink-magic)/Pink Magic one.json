{
    "name": "Pink Magic Cyberpunk",
    "type": "dark",
    "colors": {
        "menu.selectionBackground": "#ff8ae2",
        "editor.background": "#0d0d0d",
        "editor.foreground": "#fdf6ff",
        "editorCursor.foreground": "#39ff14",
        "editor.lineHighlightBackground": "#1a1a1a",
        "editorLineNumber.foreground": "#888888",
        "editor.selectionBackground": "#ff00ff33",
        "editorIndentGuide.background": "#222222",
        "editorWhitespace.foreground": "#444444",
        "sideBar.background": "#121212",
        "statusBar.background": "#1e1e1e",
        "tab.activeBackground": "#202020",
        "tab.inactiveBackground": "#121212",
        "activityBar.background": "#1e1e1e",
        "scrollbarSlider.background": "#fff",
        "scrollbarSlider.hoverBackground": "#fff",
        "scrollbarSlider.activeBackground": "#fff",
        "sash.hoverBorder": "#ff8ae2",
        "editorGroup.border": "#ffccf1",
        "panelTitle.activeBorder": "#fff",
        "panelTitle.activeForeground": "#fff"
    },
    "tokenColors": [
        {
            "scope": "comment",
            "settings": { "foreground": "#6c6c6c", "fontStyle": "italic" }
        },
        { "scope": "string", "settings": { "foreground": "#ff8ae2" } },
        { "scope": "variable", "settings": { "foreground": "#ff46b9" } },
        { "scope": "function", "settings": { "foreground": "#39ff14" } },
        {
            "scope": "keyword",
            "settings": { "foreground": "#00ffff", "fontStyle": "bold" }
        },
        { "scope": "number", "settings": { "foreground": "#00ffaa" } },
        { "scope": "type", "settings": { "foreground": "#ffcc00" } },
        {
            "scope": "constant.language",
            "settings": { "foreground": "#ff66ff" }
        },
        {
            "scope": "entity.name.tag.html",
            "settings": { "foreground": "#ff66ff" }
        },
        {
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.class.scss",
                "entity.other.attribute-name.class.less",
                "entity.other.attribute-name.class.html",
                "entity.other.attribute-name.class.vue"
            ],
            "settings": { "foreground": "#FF66C4", "fontStyle": "bold" }
        },
        {
            "scope": "string.quoted.double.html",
            "settings": { "foreground": "#ff66c4" }
        },
        {
            "scope": "source.css.embedded.html",
            "settings": { "foreground": "#39FF14" }
        },
        {
            "scope": "storage.type.function",
            "settings": { "foreground": "#ff66ff", "fontStyle": "bold" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
