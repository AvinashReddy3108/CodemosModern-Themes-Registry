        "editorGroupHeader.tabsBorder": "#000000",
        "editor.findMatchHighlightBackground": "#75d3ff7e",
        "editor.findMatchBackground": "#75d3ff7e",
        "editorBracketMatch.border": "#ff660078",
        "editorHoverWidget.background": "#1d1f21",
