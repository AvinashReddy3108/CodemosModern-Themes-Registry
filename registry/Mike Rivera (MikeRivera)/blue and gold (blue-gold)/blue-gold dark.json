            "settings": { "foreground": "#F1E8BF" }
        },
        {
            "scope": ["source.scss keyword.control"],
            "settings": { "foreground": "#F1E8BF" }
        },
        {
            "scope": ["markup.inserted"],
            "settings": { "foreground": "#D7CFAA" }
        },
        {
            "scope": ["markup.deleted"],
            "settings": { "foreground": "#B35B5B" }
        },
        {
            "scope": ["markup.changed"],
            "settings": { "foreground": "#F1E8BF" }
        },
        { "scope": ["string.regexp"], "settings": { "foreground": "#849EAA" } },
        {
            "scope": ["constant.character.escape"],
            "settings": { "foreground": "#849EAA" }
        },
        {
            "scope": ["*url*", "*link*", "*uri*"],
            "settings": { "fontStyle": "underline" }
        },
        {
            "scope": [
                "source.js constant.other.object.key.js string.unquoted.label.js"
            ],
            "settings": { "foreground": "#F1E8BF", "fontStyle": "italic" }
        },
        {
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#F1E8BF" }
        },
        {
            "scope": [
                "text.html.markdown",
                "punctuation.definition.list_item.markdown"
