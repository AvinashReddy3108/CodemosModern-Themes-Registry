{
    "$schema": "vscode://schemas/color-theme",
    "name": "UCA Light",
    "type": "light",
    "colors": {
        "editor.background": "#FFFFFF",
        "editor.foreground": "#02305C",
        "editorCursor.foreground": "#FFCE00",
        "editor.selectionBackground": "#02305C33",
        "editor.lineHighlightBackground": "#FFCE0022",
        "editorLineNumber.foreground": "#02305C99",
        "activityBar.background": "#FFFFFF",
        "activityBar.foreground": "#02305C",
        "sideBar.background": "#F4F4F4",
        "statusBar.background": "#02305C",
        "statusBar.foreground": "#FFFFFF",
        "titleBar.activeBackground": "#FFCE00",
        "titleBar.activeForeground": "#02305C"
    },
    "tokenColors": [
        {
            "scope": ["keyword"],
            "settings": { "foreground": "#02305C", "fontStyle": "bold" }
        },
        { "scope": ["string"], "settings": { "foreground": "#CC6600" } },
        { "scope": ["variable"], "settings": { "foreground": "#02305C" } },
        {
            "scope": ["comment"],
            "settings": { "foreground": "#7A7A7A", "fontStyle": "italic" }
        },
        {
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#FFCE00" }
        }
    ]
}
