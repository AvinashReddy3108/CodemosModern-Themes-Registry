{
    "name": "PXPlus Easy on Eyes",
    "type": "dark",
    "colors": {
        "editor.background": "#1e1e1e",
        "editor.foreground": "#d4d4d4",
        "editor.lineNumberColor": "#858585",
        "editor.lineHighlightBackground": "#2d2d30",
        "editor.selectionBackground": "#264f78",
        "editor.selectionHighlightBackground": "#264f7840",
        "editor.inactiveSelectionBackground": "#264f7840",
        "editor.wordHighlightBackground": "#264f7840",
        "editorCursor.foreground": "#aeafad",
        "editorWhitespace.foreground": "#3e3e42",
        "pxplus.decorations.specialHeaderBlockBackground": "#122f34",
        "pxplus.decorations.specialHeaderReturnBackground": "#183f45",
        "editorIndentGuide.background": "#3e3e42",
        "editorIndentGuide.activeBackground": "#707070",
        "editorBracketMatch.background": "#0e639c",
        "editorBracketMatch.border": "#888",
        "editor.foldBackground": "#1e4b5c",
        "editorError.foreground": "#f48771",
        "editorWarning.foreground": "#dcdcaa",
        "editorInfo.foreground": "#4fc1ff",
        "editorHint.foreground": "#eeeaea",
        "editorCodeLens.foreground": "#858585",
        "editorGutter.background": "#1e1e1e",
        "editorGutter.modifiedBackground": "#0098f0",
        "editorGutter.addedBackground": "#81b88b",
        "editorGutter.deletedBackground": "#f14c4c",
        "editorMarkerNavigationError.background": "#f48771",
        "editorMarkerNavigationWarning.background": "#dcdcaa",
        "editorMarkerNavigationInfo.background": "#4fc1ff",
        "editorLightBulb.foreground": "#dcdcaa",
        "editorLightBulbAutoFix.foreground": "#dcdcaa"
    },
    "tokenColors": [
        {
            "name": "Comment",
            "scope": [
                "comment.line.exclamation.pxplus",
                "comment.line.hash.pxplus",
                "comment.line.rem.pxplus",
                "comment.line.number.pxplus"
            ],
            "settings": { "foreground": "#6a9955" }
        },
        {
            "name": "String",
            "scope": "string.quoted.double.pxplus",
            "settings": { "foreground": "#ce9178" }
        },
        {
            "name": "String Escape",
            "scope": "constant.character.escape.pxplus",
            "settings": { "foreground": "#ce9178", "fontStyle": "bold" }
        },
        {
            "name": "Number",
            "scope": "constant.numeric.pxplus",
            "settings": { "foreground": "#b5cea8" }
        },
        {
            "name": "Conditional Keywords",
            "scope": "keyword.control.conditional.pxplus",
            "settings": { "foreground": "#569cd6", "fontStyle": "bold" }
        },
        {
            "name": "Loop Keywords",
            "scope": "keyword.control.loop.pxplus",
            "settings": { "foreground": "#569cd6", "fontStyle": "bold" }
        },
        {
            "name": "Flow Control Keywords",
            "scope": "keyword.control.flow.pxplus",
            "settings": { "foreground": "#c586c0", "fontStyle": "bold" }
        },
        {
            "name": "I/O Keywords",
            "scope": "keyword.control.io.pxplus",
            "settings": { "foreground": "#4ec9b0", "fontStyle": "bold" }
        },
        {
            "name": "Command Keywords",
            "scope": "keyword.control.command.pxplus",
            "settings": { "foreground": "#f0ad4e", "fontStyle": "bold" }
        },
        {
            "name": "Storage/Declaration Keywords",
            "scope": [
                "storage.modifier.pxplus",
                "storage.type.function.pxplus"
            ],
            "settings": { "foreground": "#d19a66", "fontStyle": "bold" }
        },
        {
            "name": "Assignment Keyword (let)",
            "scope": "keyword.control.assignment.pxplus",
            "settings": { "foreground": "#d19a66", "fontStyle": "bold" }
        },
        {
            "name": "Function Calls",
            "scope": "support.function.pxplus",
            "settings": { "foreground": "#dcdcaa" }
        },
        {
            "name": "System Functions",
            "scope": "entity.name.function.pxplus",
            "settings": { "foreground": "#dcdcaa" }
        },
        {
            "name": "Function Header - Special Background",
            "scope": "meta.function.header.pxplus",
            "settings": {
                "foreground": "#83c3b3",
                "fontStyle": "bold",
                "background": "#0e3239"
            }
        },
        {
            "name": "Function Header",
            "scope": "entity.name.function.header.special.pxplus",
            "settings": { "foreground": "#83c3b3", "fontStyle": "bold" }
        },
        {
            "name": "Header Punctuation Background",
            "scope": "punctuation.definition.header.special.pxplus",
            "settings": {
                "foreground": "#9cc9b8",
                "fontStyle": "bold",
                "background": "#0e3239"
            }
        },
        {
            "name": "Function Name (def/fn)",
            "scope": "entity.name.function.label.pxplus",
            "settings": { "foreground": "#9cdcfe" }
        },
        {
            "name": "System Variables",
            "scope": "support.variable.system.pxplus",
            "settings": { "foreground": "#9cdcfe", "fontStyle": "italic" }
        },
        {
            "name": "String Variables",
            "scope": "variable.other.string.pxplus",
            "settings": { "foreground": "#98c379", "fontStyle": "bold italic" }
        },
        {
            "name": "Numeric Variables",
            "scope": "variable.other.readwrite.pxplus",
            "settings": { "foreground": "#d19a66" }
        },
        {
            "name": "Variables",
            "scope": ["variable.other.pxplus", "variable.other.object.pxplus"],
            "settings": { "foreground": "#9cdcfe" }
        },
        {
            "name": "Percent Variables",
            "scope": "variable.other.percent.pxplus",
            "settings": { "foreground": "#9cdcfe", "fontStyle": "italic" }
        },
        {
            "name": "Label",
            "scope": "entity.name.function.label.pxplus",
            "settings": { "foreground": "#569cd6" }
        },
        {
            "name": "Label Reference",
            "scope": [
                "entity.name.label.reference.pxplus",
                "entity.name.function.reference.pxplus"
            ],
            "settings": { "foreground": "#9cdcfe" }
        },
        {
            "name": "Operator",
            "scope": "keyword.operator.pxplus",
            "settings": { "foreground": "#d4d4d4" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation.separator.pxplus",
                "punctuation.terminator.pxplus"
            ],
            "settings": { "foreground": "#d4d4d4" }
        },
        {
            "name": "Separator/Colon",
            "scope": "punctuation.separator.label.pxplus",
            "settings": { "foreground": "#d4d4d4" }
        },
        {
            "name": "SELECT - Ascending Order (BEGIN \"\" END $FF$)",
            "scope": "keyword.select.ascending.pxplus",
            "settings": {
                "foreground": "#4ec9b0",
                "fontStyle": "bold underline",
                "background": "#0d3f391a"
            }
        },
        {
            "name": "SELECT - Descending Order (BEGIN $FF$ END)",
            "scope": "keyword.select.descending.pxplus",
            "settings": {
                "foreground": "#f0ad4e",
                "fontStyle": "bold underline",
                "background": "#6b3d0d1a"
            }
        },
        {
            "name": "Object Creation - NEW()",
            "scope": "entity.name.class.pxplus",
            "settings": { "foreground": "#9f7ece", "fontStyle": "bold" }
        },
        {
            "name": "PERFORM Calls",
            "scope": "entity.name.function.perform.pxplus",
            "settings": { "foreground": "#4ec9b0", "fontStyle": "italic bold" }
        },
        {
            "name": "PERFORM Targets",
            "scope": "entity.name.function.perform.target.pxplus",
            "settings": {
                "foreground": "#dcdcaa",
                "fontStyle": "bold underline"
            }
        },
        {
            "name": "CALL Statements",
            "scope": "entity.name.function.call.pxplus",
            "settings": { "foreground": "#c586c0", "fontStyle": "italic bold" }
        },
        {
            "name": "CALL Targets",
            "scope": "entity.name.function.call.target.pxplus",
            "settings": {
                "foreground": "#dcdcaa",
                "fontStyle": "bold underline"
            }
        },
        {
            "name": "Special Block Names",
            "scope": "entity.name.function.special.pxplus",
            "settings": { "foreground": "#4ec9b0", "fontStyle": "bold" }
        },
        {
            "name": "Common Variables/Flags",
            "scope": "meta.common.variable.pxplus",
            "settings": { "foreground": "#f48771", "fontStyle": "bold" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
