    "tokenColors": [
        { "scope": "comment", "settings": { "foreground": "#a1a4aa" } },
        {
            "scope": [
                "punctuation.definition.string.begin",
                "punctuation.definition.string.end"
            ],
            "settings": { "foreground": "#e6a1a1" }
        },
        {
            "name": "String",
            "scope": ["string.quoted", "punctuation.definition.string"],
            "settings": { "foreground": "#fd9999" }
        },
        {
            "scope": [
                "constant.other.placeholder",
                "constant.character.format.placeholder.other.python"
            ],
            "settings": {
                "foreground": "#fd9999",
                "fontStyle": "bold underline"
            }
        },
        {
            "name": "Numbers",
            "scope": [
                "constant.numeric",
                "storage.type.number",
                "keyword.other.unit"
            ],
            "settings": { "foreground": "#FFA500", "fontStyle": "" }
        },
        {
            "name": "FunctionIdent",
            "scope": [
                "entity.name.function.definition",
                "entity.name.function.python"
            ],
            "settings": { "foreground": "#f2747f", "fontStyle": "bold" }
        },
        {
            "name": "FunctionCall",
            "scope": [
                "meta.function-call.generic",
                "entity.name.function.call",
                "entity.name.function.member",
                "support.function.builtin"
            ],
            "settings": { "foreground": "#f2747f" }
        },
        {
            "name": "Parameter",
            "scope": "variable.parameter",
            "settings": { "foreground": "#72C7D2" }
        },
        {
            "name": "Operators",
            "scope": "keyword.operator",
            "settings": { "foreground": "#2c2c2c" }
        },
        {
            "name": "Enum member",
            "scope": ["variable.other.enummember"],
            "settings": { "foreground": "#61aeee" }
        },
        {
            "name": "Tails",
            "scope": ["meta.tail.enum", "meta.tail.struct"],
            "settings": { "foreground": "#2c2c2c", "fontStyle": "bold" }
        },
        {
            "scope": "keyword.control.directive",
            "settings": { "foreground": "#98c379", "fontStyle": "bold" }
        },
        {
            "scope": [
                "entity.name.type.class",
                "entity.name.type.constructor",
                "entity.name.type.destructor",
                "entity.name.scope-resolution.function.definition"
            ],
            "settings": { "foreground": "#61aeee", "fontStyle": "bold" }
        },
        {
            "scope": [
                "entity.name.function.definition.special.constructor",
                "entity.name.function.definition.special.member.destructor"
            ],
            "settings": { "foreground": "#2c2c2c" }
        },
        {
            "scope": "keyword.operator.assignment",
            "settings": { "foreground": "#2c2c2c" }
        },
        {
            "scope": "entity.name.function.preprocessor",
            "settings": { "foreground": "#FFA500", "fontStyle": "bold" }
        },
        {
            "scope": "keyword.operator.new",
            "settings": { "foreground": "#f2747f", "fontStyle": "bold" }
        },
        {
            "scope": "constant.other.caps",
            "settings": { "foreground": "#ccaa6c" }
        },
        {
            "scope": "meta.member.access",
            "settings": { "foreground": "#2c2c2c" }
        },
        {
            "scope": [
                "punctuation.separator.arguments",
                "punctuation.separator.parameters",
                "punctuation.separator.element",
                "punctuation.separator.comma",
                "punctuation.separator.delimiter.comma"
            ],
            "settings": { "foreground": "#61aeee" }
        },
        {
            "scope": "keyword.operator.comparison",
            "settings": { "foreground": "#EB1165" }
        },
        {
            "scope": ["punctuation.separator.pointer-access"],
            "settings": { "foreground": "#61aeee", "fontStyle": "bold" }
        },
        { "scope": "keyword.control", "settings": { "foreground": "#c678dd" } },
        {
            "scope": [
                "storage.modifier",
                "storage.type",
                "support.type",
                "keyword.other.typedef",
                "keyword.other.using"
            ],
            "settings": { "foreground": "#c678dd", "fontStyle": "bold" }
        },
        {
            "scope": "constant.character.escape",
            "settings": { "foreground": "#FFA500" }
        },
        {
            "scope": "constant.language",
            "settings": { "foreground": "#72C7D2" }
        },
        {
            "scope": "storage.modifier.array.bracket.square",
            "settings": { "foreground": "#2c2c2c", "fontStyle": "" }
        },
        {
            "name": "Library",
            "scope": [
                "keyword.reserved.vhdl",
                "entity.name.tag.vhdl",
                "support.constant.std_standard.vhdl"
            ],
            "settings": { "foreground": "#c678dd" }
        },
        {
            "scope": "keyword.operator.vhdl",
            "settings": { "foreground": "#e6a1a1" }
        },
        {
            "scope": [
                "meta.block.type_statement.vhdl",
                "entity.name.type.vhdl"
            ],
            "settings": { "foreground": "#61aeee" }
        },
        {
            "scope": [
                "entity.name.type.ieee_std_logic_1164.vhdl",
                "meta.block.subtype_indication.vhdl"
            ],
            "settings": { "foreground": "#f2747f", "fontStyle": "bold" }
        },
        {
            "scope": "support.type.exception.python",
            "settings": { "foreground": "#2c2c2c" }
        },
        {
            "scope": "entity.name.function.decorator.python",
            "settings": { "foreground": "#98c379" }
        },
        {
            "scope": [
                "support.variable.magic.python",
                "support.function.magic.python"
            ],
            "settings": { "foreground": "#ccaa6c" }
        },
        {
            "scope": [
                "variable.parameter.function.language.special.self.python",
                "variable.language.special.self.python"
            ],
            "settings": { "foreground": "#fd9999" }
        },
        {
            "scope": "storage.type.function.python",
            "settings": { "foreground": "#c678dd", "fontStyle": "" }
        },
        {
            "scope": "keyword.operator.logical.python",
            "settings": { "foreground": "#c678dd" }
        },
        {
            "scope": "markup.heading.markdown",
            "settings": { "foreground": "#f2747f", "fontStyle": "bold" }
        },
        {
            "scope": "markup.underline.link.markdown",
            "settings": { "foreground": "#ccaa6c", "fontStyle": "underline" }
        },
        {
            "scope": "markup.bold.markdown",
            "settings": { "foreground": "#ccaa6c", "fontStyle": "bold" }
        },
        {
            "scope": "markup.quote.markdown",
            "settings": { "foreground": "#98c379", "fontStyle": "italic" }
        },
        {
            "scope": [
                "markup.list.unnumbered.markdown",
                "markup.list.numbered.markdown",
                "meta.link.inline.markdown"
            ],
            "settings": { "foreground": "#61aeee", "fontStyle": "bold" }
        },
        {
            "scope": [
                "punctuation.definition.list.begin.markdown",
                "meta.separator.markdown"
            ],
            "settings": { "foreground": "#c678dd", "fontStyle": "bold" }
        },
        {
            "scope": [
                "markup.raw.block.markdown",
                "markup.fenced_code.block.markdown"
            ],
            "settings": { "foreground": "#72C7D2", "fontStyle": "" }
        },
        {
            "scope": "markup.inline.raw.string.markdown",
            "settings": { "foreground": "#FFA500", "fontStyle": "" }
        },
        {
            "scope": "markup.inline.raw.string.markdown",
            "settings": { "fontStyle": "bold" }
        },
        {
            "scope": "punctuation.definition.metadata.markdown",
            "settings": { "foreground": "#2c2c2c", "fontStyle": "" }
        },
        {
            "scope": [
                "punctuation.definition.string.begin.markdown",
                "punctuation.definition.string.end.markdown"
            ],
            "settings": { "fontStyle": "" }
        },
        {
            "scope": "entity.name.function.js",
            "settings": { "foreground": "#f2747f", "fontStyle": "bold" }
        },
        {
            "scope": "variable.language.this.js",
            "settings": { "foreground": "#fd9999" }
        },
        {
            "scope": [
                "keyword.other.class.cs",
                "keyword.other.using.cs",
                "keyword.other.namespace.cs"
            ],
            "settings": { "foreground": "#c678dd", "fontStyle": "bold" }
        },
        {
            "scope": "keyword.type.cs",
            "settings": { "foreground": "#c678dd", "fontStyle": "bold" }
        },
        {
            "scope": "keyword.other.new.cs",
            "settings": { "foreground": "#f2747f", "fontStyle": "bold" }
        },
        {
            "scope": "entity.name.function.cs",
            "settings": { "foreground": "#f2747f" }
        },
        {
            "scope": "keyword.other.this.cs",
            "settings": { "foreground": "#fd9999" }
        },
        {
            "scope": "keyword.other.enum.cs",
            "settings": { "foreground": "#C678DD", "fontStyle": "bold" }
        },
        {
            "scope": "keyword.operator.null-conditional.cs",
            "settings": { "foreground": "#F2747F", "fontStyle": "bold" }
        },
        {
            "scope": "meta.preprocessor.cs",
            "settings": { "foreground": "#98c379", "fontStyle": "bold" }
        },
        {
            "scope": [
                "entity.name.variable.preprocessor.symbol.cs",
                "string.unquoted.preprocessor.message.cs"
            ],
            "settings": { "foreground": "#FFA500", "fontStyle": "bold" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
