    "tokenColors": [
        {
            "name": "Comment",
            "scope": "comment",
            "settings": { "foreground": "#D5D8DA66", "fontStyle": "italic" }
        },
        {
            "name": "String",
            "scope": [
                "string.quoted",
                "string.template",
                "punctuation.definition.string"
            ],
            "settings": { "foreground": "#FAB795E6" }
        },
        {
            "name": "Punctuation within templates",
            "scope": "string.template meta.embedded.line",
            "settings": { "foreground": "#BBBBBBFF" }
        },
        {
            "name": "Variable",
            "scope": ["variable", "entity.name.variable"],
            "settings": { "foreground": "#E95678E6" }
        },
        {
            "name": "Language variable",
            "scope": "variable.language",
            "settings": { "foreground": "#FAC29AE6", "fontStyle": "italic" }
        },
        {
            "name": "Parameter",
            "scope": "variable.parameter",
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "Storage (declaration or modifier keyword)",
            "scope": ["storage.type", "storage.modifier"],
            "settings": { "foreground": "#B877DBE6" }
        },
        {
            "name": "Constant",
            "scope": "constant",
            "settings": { "foreground": "#F09483E6" }
        },
        {
            "name": "Regex",
            "scope": "string.regexp",
            "settings": { "foreground": "#F09483E6" }
        },
        {
            "name": "Number",
            "scope": "constant.numeric",
            "settings": { "foreground": "#F09483E6" }
        },
        {
            "name": "Language constant (boolean, null)",
            "scope": "constant.language",
            "settings": { "foreground": "#F09483E6" }
        },
        {
            "name": "Character escape",
            "scope": "constant.character.escape",
            "settings": { "foreground": "#25B0BCE6" }
        },
        {
            "name": "Entity",
            "scope": "entity.name",
            "settings": { "foreground": "#FAC29AE6" }
        },
        {
            "name": "HTML or XML tag",
            "scope": "entity.name.tag",
            "settings": { "foreground": "#E95678E6" }
        },
        {
            "name": "HTML or XML tag brackets",
            "scope": ["punctuation.definition.tag"],
            "settings": { "foreground": "#E95678A6" }
        },
        {
            "name": "Tag atttribute",
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#F09483E6" }
        },
        {
            "name": "Class",
            "scope": "entity.name.type",
            "settings": { "foreground": "#FAC29AE6" }
        },
        {
            "name": "Inherited class",
            "scope": "entity.other.inherited-class",
            "settings": { "foreground": "#FAB795E6" }
        },
        {
            "name": "Function",
            "scope": ["entity.name.function", "variable.function"],
            "settings": { "foreground": "#25B0BCE6" }
        },
        {
            "name": "Keyword",
            "scope": "keyword",
            "settings": { "foreground": "#B877DBE6" }
        },
        {
            "name": "Control keyword (if, try, while, etc.)",
            "scope": "keyword.control",
            "settings": { "foreground": "#B877DBE6" }
        },
        {
            "name": "Operator",
            "scope": "keyword.operator",
            "settings": { "foreground": "#BBBBBB" }
        },
        {
            "name": "Special operator",
            "scope": [
                "keyword.operator.new",
                "keyword.operator.expression",
                "keyword.operator.logical"
            ],
            "settings": { "foreground": "#B877DBE6" }
        },
        {
            "name": "Unit",
            "scope": "keyword.other.unit",
            "settings": { "foreground": "#F09483E6" }
        },
        {
            "name": "Support",
            "scope": "support",
            "settings": { "foreground": "#FAC29AE6" }
        },
        {
            "name": "Support function",
            "scope": "support.function",
            "settings": { "foreground": "#25B0BCE6" }
        },
        {
            "name": "Support variable",
            "scope": "support.variable",
            "settings": { "foreground": "#E95678E6" }
        },
        {
            "name": "Object literal key / property",
            "scope": ["meta.object-literal.key", "support.type.property-name"],
            "settings": { "foreground": "#E95678E6" }
        },
        {
            "name": "Key-value separator",
            "scope": "punctuation.separator.key-value",
            "settings": { "foreground": "#BBBBBB" }
        },
        {
            "name": "Embedded puncuation",
            "scope": "punctuation.section.embedded",
            "settings": { "foreground": "#B877DBE6" }
        },
        {
            "name": "Template expression",
            "scope": [
                "punctuation.definition.template-expression.begin",
                "punctuation.definition.template-expression.end"
            ],
            "settings": { "foreground": "#B877DBE6" }
        },
        {
            "name": "CSS property",
            "scope": "support.type.property-name.css",
            "settings": { "foreground": "#BBBBBB" }
        },
        {
            "name": "Color",
            "scope": "constant.other.color",
            "settings": { "foreground": "#F09483E6" }
        },
        {
            "name": "Font names",
            "scope": "support.constant.font-name",
            "settings": { "foreground": "#F09483E6" }
        },
        {
            "name": "CSS #id",
            "scope": "entity.other.attribute-name.id",
            "settings": { "foreground": "#25B0BCE6" }
        },
        {
            "name": "Pseudo CSS",
            "scope": [
                "entity.other.attribute-name.pseudo-element",
                "entity.other.attribute-name.pseudo-class"
            ],
            "settings": { "foreground": "#FAB795E6" }
        },
        {
            "name": "CSS support functions (rgb)",
            "scope": "support.function.misc.css",
            "settings": { "foreground": "#FAC29AE6" }
        },
        {
            "name": "Markup heading",
            "scope": ["markup.heading", "entity.name.section"],
            "settings": { "foreground": "#E95678E6" }
        },
        {
            "name": "Markup quote",
            "scope": "markup.quote",
            "settings": { "foreground": "#BBBBBBCC", "fontStyle": "italic" }
        },
        {
            "name": "Markup list",
            "scope": "beginning.punctuation.definition.list",
            "settings": { "foreground": "#E95678E6" }
        },
        {
            "name": "Markup link",
            "scope": "markup.underline.link",
            "settings": { "foreground": "#FAB795E6" }
        },
        {
            "name": "Markup link description",
            "scope": "string.other.link.description",
            "settings": { "foreground": "#F09483E6" }
        },
        {
            "name": "Python function call",
            "scope": "meta.function-call.generic.python",
            "settings": { "foreground": "#25B0BCE6" }
        },
        {
            "name": "C++ operators",
            "scope": "source.cpp keyword.operator",
            "settings": { "foreground": "#B877DBE6" }
        },
        {
            "scope": "token.info-token",
            "settings": { "foreground": "#6796e6" }
        },
        {
            "scope": "token.warn-token",
            "settings": { "foreground": "#cd9731" }
        },
        {
            "scope": "token.error-token",
            "settings": { "foreground": "#f44747" }
        },
        {
            "scope": "token.debug-token",
            "settings": { "foreground": "#b267e6" }
        },
        { "scope": "comment", "settings": { "foreground": "#575757" } },
        { "scope": "string", "settings": { "foreground": "#6bb72d" } },
        {
            "scope": "keyword - keyword.operator",
            "settings": { "foreground": "#b73333" }
        },
        { "scope": "keyword.control", "settings": { "foreground": "#b73333" } },
        { "scope": "storage", "settings": { "foreground": "#b73333" } },
        { "scope": "storage.type", "settings": { "foreground": "#b73333" } },
        {
            "scope": "constant.numeric",
            "settings": { "foreground": "#b77a2f" }
        },
        {
            "scope": "entity.name.type",
            "settings": { "foreground": "#b7922d" }
        },
        {
            "scope": "entity.name.class",
            "settings": { "foreground": "#b7922d" }
        },
        { "scope": "support.type", "settings": { "foreground": "#b7922d" } },
        { "scope": "support.class", "settings": { "foreground": "#b7922d" } },
        {
            "scope": "entity.name.function",
            "settings": { "foreground": "#2d9bb7" }
        },
        {
            "scope": "support.function",
            "settings": { "foreground": "#2d9bb7" }
        },
        {
            "scope": "constant.language",
            "settings": { "foreground": "#b73333" }
        },
        {
            "scope": "keyword.operator",
            "settings": { "foreground": "#b73333" }
        },
        {
            "scope": ["storage.type", "storage.modifier"],
            "settings": { "foreground": "#b73333", "fontStyle": "" }
        },
        {
            "scope": [
                "variable.parameter",
                "variable.other",
                "variable.language",
                "variable.name"
            ],
            "settings": { "fontStyle": "", "foreground": "#b6355c" }
        },
        {
            "scope": "support.constant",
            "settings": { "foreground": "#9a4cbe" }
        },
        {
            "scope": "punctuation.separator.namespace.access.cpp",
            "settings": { "foreground": "#8a8a8a" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
