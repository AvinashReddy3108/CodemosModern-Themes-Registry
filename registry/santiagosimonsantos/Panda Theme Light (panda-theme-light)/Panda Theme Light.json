{
    "$schema": "vscode://schemas/color-theme",
    "author": "Siamak Mokhtari, Extended by Dan Hedgecock",
    "name": "Panda Syntax – Beta",
    "colorSpaceName": "sRGB",
    "semanticClass": "theme.dark.sublime_panda_syntax",
    "activityBar.fontWeight": "bold",
    "tokenColors": [
        {
            "scope": "comment",
            "settings": { "foreground": "#676B79", "fontStyle": "italic" }
        },
        { "scope": "keyword", "settings": { "foreground": "#ff0077" } },
        {
            "scope": "keyword.control, keyword.operator.new",
            "settings": { "foreground": "#ff0077" }
        },
        {
            "scope": "keyword.operator",
            "settings": { "foreground": "#222223" }
        },
        {
            "scope": "keyword.operator.logical, keyword.operator.comparison",
            "settings": { "foreground": "#ffa13c" }
        },
        {
            "scope": "keyword.operator.misc, keyword.operator.sigil",
            "settings": { "foreground": "#ff0077" }
        },
        {
            "scope": "keyword.operator.expression",
            "settings": { "foreground": "#ff8400" }
        },
        { "scope": "storage", "settings": { "foreground": "#ff8400" } },
        { "scope": "constant", "settings": { "foreground": "#ff8400" } },
        {
            "scope": "constant.character.escape",
            "settings": { "foreground": "#45A9F9" }
        },
        { "scope": "variable", "settings": { "foreground": "#222223" } },
        {
            "scope": "variable.parameter",
            "settings": { "foreground": "#888888" }
        },
        {
            "scope": "meta.object-binding-pattern-variable.js variable",
            "settings": { "foreground": "#ffa13c" }
        },
        {
            "scope": "variable.other.constant, variable.language.this, variable.interpolation",
            "settings": { "foreground": "#ff629e" }
        },
        {
            "scope": "variable.other.object",
            "settings": { "foreground": "#ff629e" }
        },
        {
            "scope": "variable.other.property",
            "settings": { "foreground": "#222223" }
        },
        { "scope": "invalid.illegal", "settings": { "foreground": "#ff8400" } },
        {
            "scope": "invalid.deprecated",
            "settings": { "foreground": "#ff8400" }
        },
        { "scope": "string", "settings": { "foreground": "#12b69d" } },
        {
            "scope": "punctuation.definition.template-expression",
            "settings": { "foreground": "#ffa13c" }
        },
        { "scope": "support", "settings": { "foreground": "#ffa13c" } },
        { "scope": "support.class", "settings": { "foreground": "#ffa13c" } },
        {
            "scope": "support.type.object.module.js",
            "settings": { "foreground": "#B084EB" }
        },
        {
            "scope": "support.function",
            "settings": { "foreground": "#0091ff" }
        },
        {
            "scope": "entity.name.function",
            "settings": { "foreground": "#0091ff" }
        },
        {
            "scope": "entity.other.inherited-class",
            "settings": { "foreground": "#ff629e" }
        },
        {
            "scope": "entity.name.tag.yaml",
            "settings": { "foreground": "#ffa13c" }
        },
        {
            "scope": "meta.decorator punctuation.decorator",
            "settings": { "foreground": "#ff8400" }
        },
        {
            "scope": "meta.decorator variable",
            "settings": { "foreground": "#0091ff" }
        },
        {
            "scope": "keyword.other.special-method",
            "settings": { "foreground": "#45A9F9" }
        },
        {
            "scope": "keyword.control.at-rule",
            "settings": { "foreground": "#B084EB" }
        },
        {
            "scope": "keyword.other.important",
            "settings": { "foreground": "#FF4B82" }
        },
        {
            "scope": "variable.interpolation",
            "settings": { "foreground": "#ff0077" }
        },
        {
            "scope": "entity.name.type",
            "settings": { "foreground": "#12b69d", "fontStyle": "italic" }
        },
        {
            "scope": "meta.source.handlebars entity.name.tag",
            "settings": { "foreground": "#0091ff" }
        },
        {
            "scope": "punctuation.definition.expression, punctuation.definition.subexpression, punctuation.definition.block.unescaped, punctuation.definition.tag",
            "settings": { "fontStyle": "italic", "foreground": "#ffa13c" }
        },
        {
            "scope": "entity.name.function.expression",
            "settings": { "foreground": "#ff0077" }
        },
        {
            "scope": "entity.unescaped.expression",
            "settings": { "foreground": "#B084EB" }
        },
        {
            "scope": "constant.other.symbol",
            "settings": { "foreground": "#12b69d" }
        },
        {
            "scope": "entity.expression variable.parameter.name",
            "settings": { "foreground": "#ff8400" }
        },
        {
            "scope": "entity.expression variable.parameter.value",
            "settings": { "foreground": "#0091ff" }
        },
        {
            "scope": "entity.expression support.function.builtin",
            "settings": { "foreground": "#ff629e" }
        },
        {
            "scope": "entity.name.tag.html",
            "settings": { "foreground": "#ffa13c" }
        },
        {
            "scope": "entity.other.attribute-name.handlebars",
            "settings": { "foreground": "#ffa13c" }
        },
        {
            "scope": "support.class.component",
            "settings": { "foreground": "#ff0077", "fontStyle": "italic" }
        },
        {
            "scope": "meta.tag.js entity.name.tag",
            "settings": { "foreground": "#ffa13c" }
        },
        {
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#ff8400" }
        },
        {
            "scope": "markup.bold",
            "settings": { "foreground": "#ff8400", "fontStyle": "bold" }
        },
        {
            "scope": "punctuation.definition.bold.markdown",
            "settings": { "foreground": "#ffa13c", "fontStyle": "bold" }
        },
        { "scope": "markup.changed", "settings": { "foreground": "#ff0077" } },
        { "scope": "markup.deleted", "settings": { "foreground": "#ff0062" } },
        {
            "scope": "markup.italic",
            "settings": { "foreground": "#ff629e", "fontStyle": "italic" }
        },
        {
            "scope": "punctuation.definition.italic.markdown",
            "settings": { "foreground": "#ff0077", "fontStyle": "italic" }
        },
        { "scope": "markup.inserted", "settings": { "foreground": "#12b69d" } },
        {
            "scope": "punctuation.definition.heading",
            "settings": { "foreground": "#12b69d" }
        },
        {
            "scope": "entity.name.section.markdown",
            "settings": { "foreground": "#888888" }
        },
        { "scope": "markup.quote", "settings": { "foreground": "#ff8400" } },
        {
            "scope": "markup.inline.raw",
            "settings": { "foreground": "#12b69d", "fontStyle": "italic" }
        },
        {
            "scope": "beginning.punctuation.definition.list",
            "settings": { "foreground": "#ff0077" }
        },
        {
            "scope": "markup.fenced_code.block.markdown punctuation.definition.markdown",
            "settings": { "foreground": "#757575" }
        },
        {
            "scope": "fenced_code.block.language",
            "settings": { "foreground": "#888888", "fontStyle": "italic" }
        },
        {
            "scope": "string.other.link",
            "settings": { "foreground": "#888888" }
        },
        {
            "scope": "meta.link.inline.markdown",
            "settings": { "foreground": "#45A9F9", "fontStyle": "italic" }
        },
        {
            "scope": "text.html.markdown punctuation.definition.string",
            "settings": { "foreground": "#ffa13c" }
        },
        {
            "scope": "entity.name.type.class.js",
            "settings": { "foreground": "#0091ff" }
        },
        {
            "scope": "keyword.control.as.js",
            "settings": { "foreground": "#ff629e" }
        },
        {
            "scope": "keyword.control.from.js",
            "settings": { "foreground": "#ff629e" }
        },
        {
            "scope": "keyword.control.export.js",
            "settings": { "foreground": "#B084EB" }
        },
        {
            "scope": "variable.language.this.js",
            "settings": { "fontStyle": "italic" }
        },
        {
            "scope": "support.class.console.js",
            "settings": { "fontStyle": "italic" }
        },
        {
            "scope": "entity.name.tag.js, support.class.component.js",
            "settings": { "foreground": "#ff0062" }
        },
        {
            "scope": "variable.language.super.js",
            "settings": { "foreground": "#45A9F9" }
        },
        {
            "scope": "meta.tag.structure.any.html, meta.tag.other.html, entity.name.tag.html, meta.tag.metadata.script.html, entity.name.tag.jade",
            "settings": { "foreground": "#ff0062" }
        },
        {
            "scope": "entity.name.tag.inline.any.html, entity.name.tag.other.html, entity.name.tag.block.any.html, entity.name.tag.localname.xml",
            "settings": { "foreground": "#ff0062" }
        },
        {
            "scope": "entity.name.tag.xml, meta.tag.xml",
            "settings": { "foreground": "#ff0062" }
        },
        {
            "scope": "source.vue, entity.name.tag.pug, meta.tag.other",
            "settings": { "foreground": "#ff0062" }
        },
        { "scope": "text.pug", "settings": { "foreground": "#f5f4f4" } },
        {
            "scope": "entity.name.tag.css",
            "settings": { "foreground": "#ff0062" }
        },
        {
            "scope": "support.type.property-name.css",
            "settings": { "foreground": "#222223" }
        },
        { "scope": "variable.scss", "settings": { "foreground": "#ff629e" } },
        {
            "scope": "entity.name.tag.reference.scss",
            "settings": { "foreground": "#ff0062" }
        },
        {
            "scope": "keyword.other.unit.rem.css, keyword.other.unit.vh.css, keyword.other.unit.px.css, keyword.other.unit.em.css, keyword.other.unit.deg.css, keyword.other.unit.percentage.css",
            "settings": { "foreground": "#ff8400" }
        },
        { "scope": "string.regexp", "settings": { "foreground": "#0091ff" } },
        {
            "scope": "string.regexp keyword, string.regexp keyword.control",
            "settings": { "foreground": "#ff0077" }
        },
        {
            "scope": "string.regexp keyword.operator",
            "settings": { "foreground": "#ff629e" }
        },
        {
            "scope": "entity.name.type.instance.jsdoc punctuation.definition",
            "settings": { "foreground": "#ffa13c", "fontStyle": "italic" }
        },
        {
            "scope": "entity.name.type.instance.jsdoc",
            "settings": { "foreground": "#CDCDCD", "fontStyle": "italic" }
        },
        {
            "scope": "comment.block storage",
            "settings": { "foreground": "#ffa13c" }
        },
        {
            "scope": "comment.block storage.custom, variable.other.jsdoc, variable.other.jsdoc punctuation.definition.string",
            "settings": { "foreground": "#ff629e" }
        }
    ],
    "colors": {
        "editor.background": "#ececec",
        "editor.foreground": "#222223",
        "editorGroupHeader.border": "#ececec",
        "editorLineNumber.foreground": "#8d8d8d",
        "editorLineNumber.activeForeground": "#B084EB",
        "editorGroupHeader.tabsBackground": "#e6e6e6",
        "tab.activeBackground": "#ececec",
        "tab.activeForeground": "#12b69d",
        "tab.inactiveBackground": "#e6e6e6",
        "tab.inactiveForeground": "#222223",
        "tab.border": "#e6e6e6",
        "sideBar.background": "#ebebeb",
        "sideBar.foreground": "#222223",
        "sideBar.border": "#ecebeb",
        "foreground": "#222223",
        "errorForeground": "#FF4B82",
        "activityBar.background": "#f2f1f1",
        "activityBar.foreground": "#222223",
        "activityBar.border": "#f1f1f1",
        "activityBarBadge.background": "#12b69d",
        "activityBarBadge.foreground": "#242526",
        "badge.background": "#B084EB",
        "badge.foreground": "#242526",
        "progressBar.background": "#B084EB",
        "button.background": "#B084EB",
        "button.foreground": "#f5f4f4",
        "button.hoverBackground": "#676B79",
        "diffEditor.insertedTextBackground": "#19f9d866",
        "diffEditor.removedTextBackground": "#FF4B8266",
        "merge.currentHeaderBackground": "#B084EB90",
        "merge.currentContentBackground": "#B084EB40",
        "merge.incomingHeaderBackground": "#45A9F990",
        "merge.incomingContentBackground": "#ff840040",
        "editorCursor.foreground": "#FF4B82",
        "editorRuler.foreground": "#B084EB60",
        "editorBracketMatch.border": "#12b69d",
        "editorCodeLens.foreground": "#ff840040",
        "editorWhitespace.foreground": "#3E4250",
        "editorGroupHeader.noTabsBackground": "#E6E6E6",
        "editor.selectionBackground": "#ff840040",
        "editor.inactiveSelectionBackground": "#ff840040",
        "editor.selectionHighlightBackground": "#ff840040",
        "editor.wordHighlightBackground": "#ffa13c60",
        "editor.wordHighlightStrongBackground": "#FF9AC170",
        "editor.findMatchBackground": "#B084EB90",
        "editor.findMatchHighlightBackground": "#ff840040",
        "editor.lineHighlightBackground": "#d8d7d7",
        "editorWidget.background": "#ececec",
        "editorWidget.border": "#373B41",
        "editorSuggestWidget.selectedBackground": "#19f9d899",
        "editorHoverWidget.background": "#f8f8f8",
        "editorHoverWidget.border": "#ececec",
        "editorHoverWidget.foreground": "#222223",
        "editorHoverWidget.statusBarBackground": "#B084EB",
        "editorOverviewRuler.border": "#00000000",
        "editorOverviewRuler.modifiedForeground": "#ffa13c",
        "editorOverviewRuler.addedForeground": "#12b69d",
        "editorOverviewRuler.deletedForeground": "#FF4B82",
        "editorOverviewRuler.errorForeground": "#FF4B82",
        "editorOverviewRuler.warningForeground": "#ffa13c",
        "editorOverviewRuler.infoForeground": "#B084EB",
        "extensionButton.prominentForeground": "#f5f4f4",
        "extensionButton.prominentBackground": "#B084EB",
        "extensionButton.prominentHoverBackground": "#676B79",
        "editorError.foreground": "#FF4B82",
        "editorError.border": "#292A2B",
        "editorWarning.foreground": "#ffa13c",
        "editorWarning.border": "#292A2B",
        "editorGutter.modifiedBackground": "#ffa13c",
        "editorGutter.addedBackground": "#12b69d",
        "editorGutter.deletedBackground": "#FF4B82",
        "gitDecoration.ignoredResourceForeground": "#757575",
        "list.hoverBackground": "#d8d7d7",
        "list.hoverForeground": "#222223",
        "list.focusBackground": "#d8d7d7",
        "list.focusForeground": "#12b69d",
        "list.activeSelectionBackground": "#d8d7d7",
        "list.activeSelectionForeground": "#12b69d",
        "list.inactiveSelectionBackground": "#d8d7d7",
        "list.inactiveSelectionForeground": "#12b69d",
        "list.highlightForeground": "#B084EB",
        "scrollbar.shadow": "#e6e6e6",
        "scrollbarSlider.background": "#bbbbbb99",
        "scrollbarSlider.activeBackground": "#bbbbbb",
        "scrollbarSlider.hoverBackground": "#bbbbbb",
        "statusBar.background": "#B084EB",
        "statusBar.foreground": "#E6E6E6",
        "statusBar.noFolderBackground": "#B084EB",
        "statusBar.noFolderForeground": "#E6E6E6",
        "statusBar.debuggingBackground": "#B084EB",
        "statusBar.debuggingForeground": "#E6E6E6",
        "titleBar.activeBackground": "#e6e6e6",
        "titleBar.activeForeground": "#222223",
        "titleBar.inactiveBackground": "#242526",
        "titleBar.inactiveForeground": "#E6E6E6",
        "tab.activeBorder": "#12b69d",
        "tab.inactiveModifiedBorder": "#cfcfcf",
        "terminalCursor.background": "#E6E6E6",
        "terminalCursor.foreground": "#FF4B82",
        "terminal.ansiBlue": "#45A9F9",
        "terminal.ansiBrightBlack": "#757575",
        "terminal.ansiBrightBlue": "#0091ff",
        "terminal.ansiBrightCyan": "#BCAAFE",
        "terminal.ansiBrightGreen": "#12b69d",
        "terminal.ansiBrightMagenta": "#ff629e",
        "terminal.ansiBrightRed": "#ff0062",
        "terminal.ansiBrightWhite": "#E6E6E6",
        "terminal.ansiBrightYellow": "#ffa13c",
        "terminal.ansiCyan": "#B084EB",
        "terminal.ansiGreen": "#12b69d",
        "terminal.ansiMagenta": "#ff0077",
        "terminal.ansiRed": "#ff0062",
        "terminal.ansiWhite": "#CDCDCD",
        "terminal.ansiYellow": "#ff8400"
    }
}
