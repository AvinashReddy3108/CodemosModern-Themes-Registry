    "tokenColors": [
        {
            "scope": "variable.parameter.function",
            "settings": { "foreground": "#f4f4f5" }
        },
        {
            "scope": "comment, punctuation.definition.comment",
            "settings": { "foreground": "#67676a" }
        },
        {
            "scope": "punctuation.definition.string, punctuation.definition.variable, punctuation.definition.parameters, punctuation.definition.array",
            "settings": { "foreground": "#f4f4f5" }
        },
        { "scope": "none", "settings": { "foreground": "#f4f4f5" } },
        {
            "scope": "keyword.operator",
            "settings": { "foreground": "#f4f4f5" }
        },
        { "scope": "keyword", "settings": { "foreground": "#d1d1d2" } },
        { "scope": "variable", "settings": { "foreground": "#d9d9da" } },
        {
            "scope": "entity.name.function, meta.require, support.function.any-method",
            "settings": { "foreground": "#bebebf" }
        },
        {
            "scope": "support.class, entity.name.class, entity.name.type.class",
            "settings": { "foreground": "#f4f4f5" }
        },
        { "scope": "meta.class", "settings": { "foreground": "#f4f4f5" } },
        {
            "scope": "keyword.other.special-method",
            "settings": { "foreground": "#bebebf" }
        },
        { "scope": "storage", "settings": { "foreground": "#d1d1d2" } },
        {
            "scope": "support.function",
            "settings": { "foreground": "#f4f4f5" }
        },
        {
            "scope": "string, constant.other.symbol, entity.other.inherited-class",
            "settings": { "foreground": "#f4f4f5" }
        },
        {
            "scope": "constant.numeric",
            "settings": { "foreground": "#f4f4f5" }
        },
        { "scope": "none", "settings": { "foreground": "#f4f4f5" } },
        { "scope": "none", "settings": { "foreground": "#f4f4f5" } },
        { "scope": "constant", "settings": { "foreground": "#f4f4f5" } },
        { "scope": "entity.name.tag", "settings": { "foreground": "#d9d9da" } },
        {
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#f4f4f5" }
        },
        {
            "scope": "entity.other.attribute-name.id, punctuation.definition.entity",
            "settings": { "foreground": "#bebebf" }
        },
        { "scope": "meta.selector", "settings": { "foreground": "#d1d1d2" } },
        { "scope": "none", "settings": { "foreground": "#f4f4f5" } },
        {
            "scope": "markup.heading punctuation.definition.heading, entity.name.section",
            "settings": { "foreground": "#bebebf", "fontStyle": "" }
        },
        {
            "scope": "keyword.other.unit",
            "settings": { "foreground": "#f4f4f5" }
        },
        {
            "scope": "markup.bold, punctuation.definition.bold",
            "settings": { "foreground": "#f4f4f5", "fontStyle": "bold" }
        },
        {
            "scope": "markup.italic, punctuation.definition.italic",
            "settings": { "foreground": "#d1d1d2", "fontStyle": "italic" }
        },
        {
            "scope": "markup.raw.inline",
            "settings": { "foreground": "#f4f4f5" }
        },
        {
            "scope": "string.other.link, punctuation.definition.string.end.markdown",
            "settings": { "foreground": "#d9d9da" }
        },
        { "scope": "meta.link", "settings": { "foreground": "#f4f4f5" } },
        { "scope": "markup.list", "settings": { "foreground": "#d9d9da" } },
        { "scope": "markup.quote", "settings": { "foreground": "#f4f4f5" } },
        { "scope": "meta.separator", "settings": { "foreground": "#f4f4f5" } },
        { "scope": "markup.inserted", "settings": { "foreground": "#f4f4f5" } },
        { "scope": "markup.deleted", "settings": { "foreground": "#d9d9da" } },
        { "scope": "markup.changed", "settings": { "foreground": "#d1d1d2" } },
        {
            "scope": "constant.other.color",
            "settings": { "foreground": "#f4f4f5" }
        },
        { "scope": "string.regexp", "settings": { "foreground": "#f4f4f5" } },
        {
            "scope": "constant.character.escape",
            "settings": { "foreground": "#f4f4f5" }
        },
        {
            "scope": "punctuation.section.embedded, variable.interpolation",
            "settings": { "foreground": "#d1d1d2" }
        },
        { "scope": "invalid.illegal", "settings": { "foreground": "#f4f4f5" } },
        { "scope": "invalid.broken", "settings": { "foreground": "#18181b" } },
        {
            "scope": "invalid.deprecated",
            "settings": { "foreground": "#f4f4f5" }
        },
        {
            "scope": "invalid.unimplemented",
            "settings": { "foreground": "#f4f4f5" }
        }
    ],
    "color": {
        "editorCursor.background": "#f0f9ff",
        "editorCursor.foreground": "#0284c7",
        "editorError.foreground": "#dc2626",
        "editorWarning.foreground": "#ca8a04"
    },
    "$schema": "vscode://schemas/color-theme"
}
