    "tokenColors": [
        {
            "scope": "variable.parameter.function",
            "settings": { "foreground": "#1c1917" }
        },
        {
            "scope": "comment, punctuation.definition.comment",
            "settings": { "foreground": "#a7a6a4" }
        },
        {
            "scope": "punctuation.definition.string, punctuation.definition.variable, punctuation.definition.parameters, punctuation.definition.array",
            "settings": { "foreground": "#1c1917" }
        },
        { "scope": "none", "settings": { "foreground": "#1c1917" } },
        {
            "scope": "keyword.operator",
            "settings": { "foreground": "#1c1917" }
        },
        { "scope": "keyword", "settings": { "foreground": "#3f3c3b" } },
        { "scope": "variable", "settings": { "foreground": "#363432" } },
        {
            "scope": "entity.name.function, meta.require, support.function.any-method",
            "settings": { "foreground": "#524f4e" }
        },
        {
            "scope": "support.class, entity.name.class, entity.name.type.class",
            "settings": { "foreground": "#1c1917" }
        },
        { "scope": "meta.class", "settings": { "foreground": "#1c1917" } },
        {
            "scope": "keyword.other.special-method",
            "settings": { "foreground": "#524f4e" }
        },
        { "scope": "storage", "settings": { "foreground": "#3f3c3b" } },
        {
            "scope": "support.function",
            "settings": { "foreground": "#1c1917" }
        },
        {
            "scope": "string, constant.other.symbol, entity.other.inherited-class",
            "settings": { "foreground": "#1c1917" }
        },
        {
            "scope": "constant.numeric",
            "settings": { "foreground": "#1c1917" }
        },
        { "scope": "none", "settings": { "foreground": "#1c1917" } },
        { "scope": "none", "settings": { "foreground": "#1c1917" } },
        { "scope": "constant", "settings": { "foreground": "#1c1917" } },
        { "scope": "entity.name.tag", "settings": { "foreground": "#363432" } },
        {
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#1c1917" }
        },
        {
            "scope": "entity.other.attribute-name.id, punctuation.definition.entity",
            "settings": { "foreground": "#524f4e" }
        },
        { "scope": "meta.selector", "settings": { "foreground": "#3f3c3b" } },
        { "scope": "none", "settings": { "foreground": "#1c1917" } },
        {
            "scope": "markup.heading punctuation.definition.heading, entity.name.section",
            "settings": { "foreground": "#524f4e", "fontStyle": "" }
        },
        {
            "scope": "keyword.other.unit",
            "settings": { "foreground": "#1c1917" }
        },
        {
            "scope": "markup.bold, punctuation.definition.bold",
            "settings": { "foreground": "#1c1917", "fontStyle": "bold" }
        },
        {
            "scope": "markup.italic, punctuation.definition.italic",
            "settings": { "foreground": "#3f3c3b", "fontStyle": "italic" }
        },
        {
            "scope": "markup.raw.inline",
            "settings": { "foreground": "#1c1917" }
        },
        {
            "scope": "string.other.link, punctuation.definition.string.end.markdown",
            "settings": { "foreground": "#363432" }
        },
        { "scope": "meta.link", "settings": { "foreground": "#1c1917" } },
        { "scope": "markup.list", "settings": { "foreground": "#363432" } },
        { "scope": "markup.quote", "settings": { "foreground": "#1c1917" } },
        { "scope": "meta.separator", "settings": { "foreground": "#1c1917" } },
        { "scope": "markup.inserted", "settings": { "foreground": "#1c1917" } },
        { "scope": "markup.deleted", "settings": { "foreground": "#363432" } },
        { "scope": "markup.changed", "settings": { "foreground": "#3f3c3b" } },
        {
            "scope": "constant.other.color",
            "settings": { "foreground": "#1c1917" }
        },
        { "scope": "string.regexp", "settings": { "foreground": "#1c1917" } },
        {
            "scope": "constant.character.escape",
            "settings": { "foreground": "#1c1917" }
        },
        {
            "scope": "punctuation.section.embedded, variable.interpolation",
            "settings": { "foreground": "#3f3c3b" }
        },
        { "scope": "invalid.illegal", "settings": { "foreground": "#1c1917" } },
        { "scope": "invalid.broken", "settings": { "foreground": "#f5f5f4" } },
        {
            "scope": "invalid.deprecated",
            "settings": { "foreground": "#1c1917" }
        },
        {
            "scope": "invalid.unimplemented",
            "settings": { "foreground": "#1c1917" }
        }
    ],
    "color": {
        "editorCursor.background": "#f0f9ff",
        "editorCursor.foreground": "#0284c7",
        "editorError.foreground": "#dc2626",
        "editorWarning.foreground": "#ca8a04"
    },
    "$schema": "vscode://schemas/color-theme"
}
