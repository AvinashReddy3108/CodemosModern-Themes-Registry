{
    "name": "Blizzard Ice",
    "type": "dark",
    "colors": {
        "editor.background": "#0f172a",
        "editor.foreground": "#f8fafc",
        "activityBar.background": "#0f172a",
        "sideBar.background": "#0f172a",
        "statusBar.background": "#06b6d4",
        "editorLineNumber.foreground": "#334155",
        "editorLineNumber.activeForeground": "#06b6d4",
        "editor.selectionBackground": "#06b6d433"
    },
    "tokenColors": [
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#94a3b8", "fontStyle": "italic" }
        },
        {
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#06b6d4", "fontStyle": "bold" }
        },
        {
            "scope": ["keyword.control.frontmatter.blizzard"],
            "settings": { "foreground": "#f472b6", "fontStyle": "bold" }
        },
        {
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#3b82f6" }
        },
        {
            "scope": [
                "variable",
                "string.interpolated",
                "meta.embedded.line.expression"
            ],
            "settings": { "foreground": "#cffafe" }
        },
        {
            "scope": ["string", "string.quoted"],
            "settings": { "foreground": "#06b6d4" }
        },
        {
            "scope": [
                "entity.name.tag",
                "meta.tag.sgml",
                "markup.deleted.git_gutter"
            ],
            "settings": { "foreground": "#3b82f6", "fontStyle": "bold" }
        },
        {
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#94a3b8" }
        },
        {
            "scope": [
                "punctuation.section.embedded.begin.blizzard",
                "punctuation.section.embedded.end.blizzard"
            ],
            "settings": { "foreground": "#f472b6", "fontStyle": "bold" }
        },
        {
            "scope": ["text.html.basic"],
            "settings": { "foreground": "#f8fafc" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
