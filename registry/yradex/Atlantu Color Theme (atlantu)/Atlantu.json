{
    "name": "Atlantu",
    "type": "dark",
    "colors": {
        "activityBar.background": "#1b1c1e",
        "activityBar.foreground": "#d7dae0",
        "activityBarBadge.background": "#cc9d4d",
        "activityBarBadge.foreground": "#f8fafd",
        "badge.background": "#1b1c1e",
        "button.background": "#de9515",
        "debugToolBar.background": "#1e1f21",
        "diffEditor.insertedTextBackground": "#00809b33",
        "dropdown.background": "#1e1f21",
        "dropdown.border": "#1e1f21",
        "editor.background": "#1b1c1e",
        "editor.foreground": "#d1d3d8",
        "editorError.foreground": "#c24038",
        "editorIndentGuide.activeBackground": "#c8c8c859",
        "editorMarkerNavigation.background": "#1e1f21",
        "editorRuler.foreground": "#d1d3d826",
        "editorWarning.foreground": "#d19a66",
        "editor.lineHighlightBackground": "#2c313c",
        "editor.selectionBackground": "#67769660",
        "editor.selectionHighlightBackground": "#ffffff10",
        "editor.selectionHighlightBorder": "#ddd",
        "editorCursor.background": "#ffffffc9",
        "editorCursor.foreground": "#528bff",
        "editorBracketMatch.border": "#515a6b",
        "editorBracketMatch.background": "#515a6b",
        "editor.findMatchBackground": "#42557b",
        "editor.findMatchBorder": "#457dff",
        "editor.findMatchHighlightBackground": "#6199ff2f",
        "editor.wordHighlightBackground": "#d2e0ff2f",
        "editor.wordHighlightBorder": "#7f848e",
        "editor.wordHighlightStrongBackground": "#d1d3d826",
        "editor.wordHighlightStrongBorder": "#7f848e",
        "editorGroup.emptyBackground": "#181a1f",
        "editorGroup.border": "#181a1f",
        "editorGroupHeader.tabsBackground": "#1e1f21",
        "editorIndentGuide.background": "#3b4048",
        "editorLineNumber.foreground": "#495162",
        "editorLineNumber.activeForeground": "#737984",
        "editorWhitespace.foreground": "#3b4048",
        "editorHoverWidget.background": "#1e1f21",
        "editorHoverWidget.border": "#181a1f",
        "editorSuggestWidget.background": "#1e1f21",
        "editorSuggestWidget.border": "#181a1f",
        "editorSuggestWidget.selectedBackground": "#2c313a",
        "editorWidget.background": "#1e1f21",
        "focusBorder": "#464646",
        "input.background": "#1d1f23",
        "input.border": "#6f4906",
        "list.activeSelectionBackground": "#2c313a",
        "list.activeSelectionForeground": "#d7dae0",
        "list.focusBackground": "#383e4a",
        "list.hoverBackground": "#292d35",
        "list.highlightForeground": "#c5c5c5",
        "list.inactiveSelectionBackground": "#2c313a",
        "list.inactiveSelectionForeground": "#d7dae0",
        "list.warningForeground": "#d19a66",
        "menu.foreground": "#c8c8c8",
        "peekViewEditor.background": "#1b1d23",
        "peekViewEditor.matchHighlightBackground": "#29244b",
        "peekViewResult.background": "#22262b",
        "scrollbarSlider.background": "#4e566660",
        "scrollbarSlider.activeBackground": "#747d9180",
        "scrollbarSlider.hoverBackground": "#5a637580",
        "sideBar.background": "#1e1f21",
        "sideBarSectionHeader.background": "#1b1c1e",
        "statusBar.background": "#1e1f21",
        "statusBar.foreground": "#9da5b4",
        "statusBarItem.hoverBackground": "#2c313a",
        "statusBar.noFolderBackground": "#1e1f21",
        "statusBar.debuggingBackground": "#7e0097",
        "statusBar.debuggingBorder": "#66017a",
        "statusBar.debuggingForeground": "#ffffff",
        "statusBarItem.remoteForeground": "#f8fafd",
        "statusBarItem.remoteBackground": "#cc9d4d",
        "tab.activeBackground": "#7b6031",
        "tab.activeForeground": "#dcdcdc",
        "tab.border": "#181a1f",
        "tab.inactiveBackground": "#1e1f21",
        "tab.hoverBackground": "#323842",
        "tab.unfocusedHoverBackground": "#323842",
        "terminal.foreground": "#c8c8c8",
        "terminal.ansiBlack": "#2d3139",
        "terminal.ansiBlue": "#61afef",
        "terminal.ansiGreen": "#98c379",
        "terminal.ansiYellow": "#e5c07b",
        "terminal.ansiCyan": "#56b6c2",
        "terminal.ansiMagenta": "#c678dd",
        "terminal.ansiRed": "#e06c75",
        "terminal.ansiWhite": "#d7dae0",
        "terminal.ansiBrightBlack": "#7f848e",
        "terminal.ansiBrightBlue": "#528bff",
        "terminal.ansiBrightGreen": "#98c379",
        "terminal.ansiBrightYellow": "#e5c07b",
        "terminal.ansiBrightCyan": "#56b6c2",
        "terminal.ansiBrightMagenta": "#7e0097",
        "terminal.ansiBrightRed": "#f44747",
        "terminal.ansiBrightWhite": "#d7dae0",
        "titleBar.activeBackground": "#1b1c1e",
        "titleBar.activeForeground": "#9da5b4",
        "titleBar.inactiveBackground": "#1e1f21",
        "titleBar.inactiveForeground": "#6b717d",
        "textLink.foreground": "#61afef"
    },
    "tokenColors": [
        {
            "name": "common function",
            "scope": "entity.name.function, meta.scope.function-call, support.function",
            "settings": { "foreground": "#ff8000" }
        },
        {
            "name": "common static function",
            "scope": "entity.name.function.member.static",
            "settings": { "foreground": "#ff8000", "fontStyle": "italic" }
        },
        {
            "name": "common keywords",
            "scope": "storage.type.built-in, storage.type.primitive, keyword.control, keyword.operator.cast, keyword.other, constant.language, storage.modifier, variable.language.this, keyword.operator.expression, entity.other.attribute-name, variable.language, keyword.operator.wordlike, new.expr, storage.type, support.type.builtin",
            "settings": { "foreground": "#DD99FF" }
        },
        {
            "name": "common variable global",
            "scope": "variable.other.global",
            "settings": { "foreground": "#ffee00" }
        },
        {
            "name": "common variable local",
            "scope": "variable.other.local",
            "settings": { "foreground": "#91ccfc" }
        },
        {
            "name": "common parameter",
            "scope": "variable.parameter",
            "settings": { "foreground": "#0096ff" }
        },
        {
            "name": "common literal number",
            "scope": "constant.numeric",
            "settings": { "foreground": "#8DCFFF" }
        },
        {
            "name": "common literal string",
            "scope": "string.quoted, string.template",
            "settings": { "foreground": "#ffbba0" }
        },
        {
            "name": "common class",
            "scope": "entity.name.type, support.type.primitive, support.class, storage.type",
            "settings": { "foreground": "#00ffBB" }
        },
        {
            "name": "common class template",
            "scope": "entity.name.type.class.templated",
            "settings": { "foreground": "#91ff94" }
        },
        {
            "name": "common namespace",
            "scope": "entity.name.scope-resolution, entity.name.namespace",
            "settings": { "foreground": "#b3ffb5" }
        },
        {
            "name": "common field",
            "scope": "variable.other.property, variable.object.property, variable.other.object.property, support.variable.property",
            "settings": { "foreground": "#00ff00" }
        },
        {
            "name": "common static field",
            "scope": "variable.other.property.static",
            "settings": { "foreground": "#00ff00", "fontStyle": "italic" }
        },
        {
            "name": "common macro",
            "scope": "entity.name.function.preprocessor",
            "settings": { "foreground": "#DD99FF" }
        },
        {
            "name": "common function template",
            "scope": "entity.name.function.templated",
            "settings": { "foreground": "#ffbb00ee" }
        },
        {
            "name": "common constant",
            "scope": "variable.other.enummember",
            "settings": { "foreground": "#00ff00" }
        },
        {
            "name": "common comment",
            "scope": "comment",
            "settings": { "foreground": "#808080" }
        },
        {
            "name": "common tag component",
            "scope": "support.class.component, entity.name.tag, meta.object-literal.key",
            "settings": { "foreground": "#ffee00ee" }
        },
        {
            "name": "others",
            "scope": "variable.other.event, entity.name.type.class.generic, variable.other.property.cli, entity.name.type.class.reference, entity.name.operator.custom-literal, entity.name.type.class.value, support.function.error",
            "settings": { "foreground": "#ff0000" }
        },
        {
            "name": "json property-name",
            "scope": "support.type.property-name.json",
            "settings": { "foreground": "#DD99FF" }
        },
        {
            "name": "md heading",
            "scope": "markup.heading.markdown",
            "settings": { "foreground": "#5dabeb" }
        },
        {
            "name": "md italic",
            "scope": "markup.italic.markdown",
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "md bold",
            "scope": "markup.bold.markdown",
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "md raw",
            "scope": "markup.inline.raw.string.markdown, markup.fenced_code.block.markdown",
            "settings": { "foreground": "#ffee00" }
        },
        {
            "name": "md image",
            "scope": "meta.image.inline.markdown",
            "settings": { "foreground": "#ff8000dd" }
        },
        {
            "name": "md quote",
            "scope": "markup.quote.markdown",
            "settings": { "foreground": "#00ffBB" }
        },
        {
            "name": "md link",
            "scope": "meta.link.reference.def.markdown, meta.link.reference.markdown, meta.link.inline.markdown",
            "settings": { "foreground": "#ffbb00dd" }
        },
        {
            "name": "md list unnumbered",
            "scope": "markup.list.unnumbered.markdown",
            "settings": { "foreground": "#91ff94dd" }
        },
        {
            "name": "md list numbered",
            "scope": "markup.list.numbered.markdown",
            "settings": { "foreground": "#d370ce" }
        },
        {
            "name": "makefile prerequisites",
            "scope": "meta.scope.prerequisites.makefile",
            "settings": { "foreground": "#ffbb00" }
        },
        {
            "name": "makefile PHONY",
            "scope": "support.function.target.PHONY.makefile",
            "settings": { "foreground": "#ff8000" }
        },
        {
            "name": "makefile recipe",
            "scope": "meta.scope.recipe.makefile",
            "settings": { "foreground": "#91ff94dd" }
        },
        {
            "name": "variable positional",
            "scope": "variable.other.positional",
            "settings": { "foreground": "#00ff00" }
        },
        {
            "name": "ps1 variable",
            "scope": "variable.other.readwrite.powershell",
            "settings": { "foreground": "#ffee00" }
        },
        {
            "name": "ps1 cmdlet",
            "scope": "support.function.powershell",
            "settings": { "foreground": "#ff8000" }
        },
        {
            "name": "ps1 operator",
            "scope": "keyword.operator.comparison.powershell, keyword.operator.logical.powershell, keyword.operator.other.powershell",
            "settings": { "foreground": "#5dabeb" }
        },
        {
            "name": "ps1 keywords & auto variables",
            "scope": "support.variable.automatic.powershell",
            "settings": { "foreground": "#5dabeb" }
        },
        {
            "name": "ts field",
            "scope": "meta.object-literal.key.ts, support.variable.property.process.ts, support.variable.property.ts, variable.other.constant.property.ts",
            "settings": { "foreground": "#00ff00" }
        },
        {
            "name": "ts class",
            "scope": "support.type.primitive.ts",
            "settings": { "foreground": "#00ffBB" }
        },
        {
            "name": "ts variable local",
            "scope": "variable.other.constant.tsx, variable.other.constant.js",
            "settings": { "foreground": "#91ccfc" }
        },
        {
            "name": "xml tag",
            "scope": "meta.tag.xml",
            "settings": { "foreground": "#DD99FF" }
        },
        {
            "name": "xml name",
            "scope": "entity.name.tag.localname.xml",
            "settings": { "foreground": "#d370ce" }
        },
        {
            "name": "xml attribute",
            "scope": "entity.other.attribute-name.localname.xml, entity.other.attribute-name.xml",
            "settings": { "foreground": "#91ff94dd" }
        },
        {
            "name": "css property name",
            "scope": "support.type.property-name.css",
            "settings": { "foreground": "#ffee00ee" }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "variable.local.readonly": {
            "foreground": "#91ccfc",
            "underline": false
        },
        "variable.local": { "foreground": "#91ccfc", "underline": true },
        "variable": "#ffee00"
    },
    "$schema": "vscode://schemas/color-theme"
}
