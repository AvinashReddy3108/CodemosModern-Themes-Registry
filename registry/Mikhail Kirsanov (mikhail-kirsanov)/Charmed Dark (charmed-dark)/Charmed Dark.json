        "editorSuggestWidget.foreground": "#a6accd",
        "editorSuggestWidget.highlightForeground": "#82aaff",
        "editorSuggestWidget.selectedBackground": "#717cb430",
        "focusBorder": "#b175dc80",
        "widget.shadow": "#00000066",
        "selection.background": "#717cb450",
        "descriptionForeground": "#a6accd",
        "icon.foreground": "#a6accd",
        "editorBracketHighlight.foreground1": "#ffcc00",
        "editorBracketHighlight.foreground2": "#b175dc",
