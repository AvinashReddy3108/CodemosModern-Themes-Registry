    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#484d7d" }
        },
        {
            "name": "Doc comments & JSDoc keywords",
            "scope": [
                "comment.block.documentation",
                "storage.type.class.jsdoc",
                "keyword.other.documentation",
                "punctuation.definition.block.tag.jsdoc"
            ],
            "settings": { "foreground": "#585da6" }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.new",
                "keyword.operator.expression",
                "keyword.operator.logical",
                "keyword.operator.delete",
                "keyword.operator.typeof",
                "keyword.operator.instanceof",
                "keyword.operator.void",
                "keyword.operator.in",
                "keyword.operator.of",
                "storage",
                "storage.type",
                "storage.modifier"
            ],
            "settings": { "foreground": "#b175dc", "fontStyle": "bold" }
        },
        {
            "name": "Operators",
            "scope": [
                "keyword.operator",
                "keyword.operator.assignment",
                "keyword.operator.arithmetic",
                "keyword.operator.comparison",
                "keyword.operator.relational",
                "keyword.operator.bitwise",
                "keyword.operator.ternary"
            ],
            "settings": { "foreground": "#a6accd", "fontStyle": "" }
        },
        {
            "name": "Punctuation",
            "scope": ["punctuation", "meta.brace", "meta.delimiter"],
            "settings": { "foreground": "#a6accd" }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "meta.function-call",
                "support.function",
                "meta.function-call entity.name.function"
            ],
            "settings": { "foreground": "#82aaff" }
        },
        {
            "name": "Classes, Types, Interfaces",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.type",
                "support.class",
                "entity.other.inherited-class",
                "meta.type.annotation entity.name.type"
            ],
            "settings": { "foreground": "#fc6b09" }
        },
        {
            "name": "Type declarations (struct, class, enum keywords)",
            "scope": [
                "entity.name.type.class",
                "entity.name.type.struct",
                "entity.name.type.enum",
                "entity.name.type.interface",
                "entity.name.type.protocol",
                "entity.name.type.alias"
            ],
            "settings": { "foreground": "#fc6b09" }
        },
        {
            "name": "Variables",
            "scope": [
                "variable",
                "variable.other",
                "variable.other.readwrite",
                "variable.other.object"
            ],
            "settings": { "foreground": "#ecfc6a" }
        },
        {
            "name": "Variable properties",
            "scope": [
                "variable.other.property",
                "variable.other.object.property",
                "meta.object-literal.key"
            ],
            "settings": { "foreground": "#ecfc6a" }
        },
        {
            "name": "Language variables (this, self, super)",
            "scope": ["variable.language"],
            "settings": { "foreground": "#b175dc", "fontStyle": "italic" }
        },
        {
            "name": "Parameters",
            "scope": ["variable.parameter", "meta.parameter"],
            "settings": { "foreground": "#ecfc6a", "fontStyle": "italic" }
        },
        {
            "name": "Constants",
            "scope": [
                "constant",
                "constant.other",
                "support.constant",
                "variable.other.constant"
            ],
            "settings": { "foreground": "#ff074b" }
        },
        {
            "name": "Numbers",
            "scope": [
                "constant.numeric",
                "constant.numeric.integer",
                "constant.numeric.float",
                "constant.numeric.hex"
            ],
            "settings": { "foreground": "#ff074b" }
        },
        {
            "name": "Booleans & Null",
            "scope": [
                "constant.language",
                "constant.language.boolean",
                "constant.language.null",
                "constant.language.undefined"
            ],
            "settings": { "foreground": "#ff074b" }
        },
        {
            "name": "Strings",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#4ee7ff" }
        },
        {
            "name": "Characters / Escape sequences",
            "scope": [
                "constant.character",
                "constant.character.escape",
                "constant.other.placeholder"
            ],
            "settings": { "foreground": "#4ee7ff" }
        },
        {
            "name": "String interpolation expressions",
            "scope": [
                "meta.template.expression",
                "punctuation.definition.template-expression"
            ],
            "settings": { "foreground": "#b175dc" }
        },
        {
            "name": "Regex",
            "scope": ["string.regexp"],
            "settings": { "foreground": "#4ee7ff" }
        },
        {
            "name": "Attributes / Decorators",
            "scope": [
                "entity.other.attribute-name",
                "meta.decorator",
                "meta.attribute",
                "punctuation.definition.decorator"
            ],
            "settings": { "foreground": "#ff18b1" }
        },
        {
            "name": "Preprocessor / Macros",
            "scope": [
                "meta.preprocessor",
                "entity.name.function.preprocessor",
                "keyword.control.directive",
                "keyword.control.import",
                "keyword.control.export",
                "keyword.control.from",
                "keyword.control.as"
            ],
            "settings": { "foreground": "#45ff69" }
        },
        {
            "name": "Tag names",
            "scope": ["entity.name.tag", "support.class.component"],
            "settings": { "foreground": "#fc6b09" }
        },
        {
            "name": "Tag attributes",
            "scope": [
                "entity.other.attribute-name.html",
                "entity.other.attribute-name.jsx",
                "entity.other.attribute-name.tsx"
            ],
            "settings": { "foreground": "#ff18b1" }
        },
        {
            "name": "Tag brackets",
            "scope": ["punctuation.definition.tag"],
            "settings": { "foreground": "#a6accd80" }
        },
        {
            "name": "Markdown heading",
            "scope": ["markup.heading", "entity.name.section.markdown"],
            "settings": { "foreground": "#fc6b09", "fontStyle": "bold" }
        },
        {
            "name": "Markdown bold",
            "scope": ["markup.bold"],
            "settings": { "foreground": "#f0efb7", "fontStyle": "bold" }
        },
        {
            "name": "Markdown italic",
            "scope": ["markup.italic"],
            "settings": { "foreground": "#f0efb7", "fontStyle": "italic" }
        },
        {
            "name": "Markdown inline code",
            "scope": ["markup.inline.raw"],
            "settings": { "foreground": "#4ee7ff" }
        },
        {
            "name": "Markdown code block",
            "scope": ["markup.fenced_code.block"],
            "settings": { "foreground": "#b175dc" }
        },
        {
            "name": "Markdown link",
            "scope": ["markup.underline.link", "string.other.link"],
            "settings": { "foreground": "#6348cc" }
        },
        {
            "name": "Markdown link text",
            "scope": [
                "string.other.link.title.markdown",
                "string.other.link.description.markdown"
            ],
            "settings": { "foreground": "#82aaff" }
        },
        {
            "name": "Markdown list punctuation",
            "scope": ["punctuation.definition.list.begin.markdown"],
            "settings": { "foreground": "#ffcc00" }
        },
        {
            "name": "CSS Property names",
            "scope": [
                "support.type.property-name.css",
                "support.type.property-name.scss",
                "support.type.property-name.less"
            ],
            "settings": { "foreground": "#82aaff" }
        },
        {
            "name": "CSS Property values",
            "scope": [
                "support.constant.property-value.css",
                "support.constant.property-value.scss"
            ],
            "settings": { "foreground": "#4ee7ff" }
        },
        {
            "name": "CSS Selectors",
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css",
                "entity.other.attribute-name.pseudo-class.css",
                "entity.other.attribute-name.pseudo-element.css"
            ],
            "settings": { "foreground": "#ff18b1" }
        },
        {
            "name": "CSS Units",
            "scope": ["keyword.other.unit.css", "keyword.other.unit.scss"],
            "settings": { "foreground": "#ff074b" }
        },
        {
            "name": "SCSS Variables",
            "scope": ["variable.scss", "variable.css"],
            "settings": { "foreground": "#ecfc6a" }
        },
        {
            "name": "JSON property names",
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#82aaff" }
        },
        {
            "name": "JSON string values",
            "scope": ["string.quoted.double.json"],
            "settings": { "foreground": "#4ee7ff" }
        },
        {
            "name": "YAML keys",
            "scope": ["entity.name.tag.yaml"],
            "settings": { "foreground": "#82aaff" }
        },
        {
            "name": "Plain text / source",
            "scope": ["source", "meta.embedded"],
            "settings": { "foreground": "#f0efb7" }
        },
        {
            "name": "Function/method declarations",
            "scope": [
                "entity.name.function",
                "meta.definition.function entity.name.function",
                "meta.definition.method entity.name.function"
            ],
            "settings": { "foreground": "#82aaff" }
        },
        {
            "name": "Namespace / Module names",
            "scope": [
                "entity.name.namespace",
                "entity.name.module",
                "entity.name.package"
            ],
            "settings": { "foreground": "#fc6b09" }
        },
        {
            "name": "Enum members",
            "scope": ["variable.other.enummember", "constant.other.enum"],
            "settings": { "foreground": "#ff074b" }
        },
        {
            "name": "URLs",
            "scope": ["markup.underline.link", "string.other.link"],
            "settings": { "foreground": "#6348cc" }
        }
    ],
    "semanticTokenColors": {
        "namespace": "#fc6b09",
        "type": "#fc6b09",
        "type.declaration": "#f0efb7",
        "class": "#fc6b09",
        "class.declaration": "#f0efb7",
        "interface": "#fc6b09",
        "interface.declaration": "#f0efb7",
        "struct": "#fc6b09",
        "struct.declaration": "#f0efb7",
        "enum": "#fc6b09",
        "enum.declaration": "#f0efb7",
        "enumMember": "#ff074b",
        "function": "#82aaff",
        "function.declaration": "#f0efb7",
        "method": "#82aaff",
        "method.declaration": "#f0efb7",
        "macro": "#45ff69",
        "variable": "#ecfc6a",
        "variable.readonly": "#ecfc6a",
        "variable.declaration": "#f0efb7",
        "parameter": { "foreground": "#ecfc6a", "fontStyle": "italic" },
        "property": "#ecfc6a",
        "property.declaration": "#f0efb7",
        "property.readonly": "#ecfc6a",
        "keyword": { "foreground": "#b175dc", "fontStyle": "bold" },
        "comment": "#484d7d",
        "string": "#4ee7ff",
        "number": "#ff074b",
        "regexp": "#4ee7ff",
        "operator": "#a6accd",
        "decorator": "#ff18b1",
        "typeParameter": "#fc6b09"
    },
    "$schema": "vscode://schemas/color-theme"
}
