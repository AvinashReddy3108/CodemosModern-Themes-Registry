    "tokenColors": [
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#7D5AA6", "fontStyle": "italic" }
        },
        {
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#6BFF00" }
        },
        { "scope": ["string.regexp"], "settings": { "foreground": "#A2DA5A" } },
        {
            "scope": [
                "constant.numeric",
                "constant.language.boolean",
                "constant.language.null",
                "constant.language.undefined"
            ],
            "settings": { "foreground": "#F08B18" }
        },
        {
            "scope": ["constant.character", "constant.other"],
            "settings": { "foreground": "#6BFF00" }
        },
        {
            "scope": [
                "variable",
                "variable.parameter",
                "variable.other.readwrite",
                "meta.definition.variable"
            ],
            "settings": { "foreground": "#D8C7F2" }
        },
        {
            "scope": ["variable.language"],
            "settings": { "foreground": "#F7BB2A", "fontStyle": "bold" }
        },
        {
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.new",
                "keyword.other"
            ],
            "settings": { "foreground": "#A877C8", "fontStyle": "bold" }
        },
        {
            "scope": [
                "keyword.operator",
                "keyword.operator.logical",
                "keyword.operator.comparison",
                "keyword.operator.assignment"
            ],
            "settings": { "foreground": "#6BFF00" }
        },
        {
            "scope": ["storage", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#765898", "fontStyle": "bold" }
        },
        {
            "scope": [
                "entity.name.function",
                "meta.function-call",
                "support.function"
            ],
            "settings": { "foreground": "#6BFF00", "fontStyle": "bold" }
        },
        {
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.type",
                "support.class"
            ],
            "settings": { "foreground": "#F08B18", "fontStyle": "bold" }
        },
        {
            "scope": ["entity.other.inherited-class"],
            "settings": { "foreground": "#F7BB2A" }
        },
        {
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#A2DA5A", "fontStyle": "bold" }
        },
        {
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#F7BB2A" }
        },
        {
            "scope": ["support.constant", "constant.language"],
            "settings": { "foreground": "#6BFF00" }
        },
        {
            "scope": ["meta.preprocessor", "entity.name.function.preprocessor"],
            "settings": { "foreground": "#6BFF00", "fontStyle": "bold" }
        },
        {
            "scope": ["meta.decorator", "meta.decorator punctuation.decorator"],
            "settings": { "foreground": "#6BFF00" }
        },
        { "scope": ["punctuation"], "settings": { "foreground": "#A877C8" } },
        {
            "scope": [
                "punctuation.definition.string",
                "punctuation.definition.string.begin",
                "punctuation.definition.string.end"
            ],
            "settings": { "foreground": "#6BFF00" }
        },
        {
            "scope": ["punctuation.definition.template-expression"],
            "settings": { "foreground": "#F08B18" }
        },
        {
            "scope": ["invalid"],
            "settings": {
                "foreground": "#FF0000",
                "fontStyle": "bold underline"
            }
        },
        {
            "scope": ["invalid.deprecated"],
            "settings": {
                "foreground": "#6BFF00",
                "fontStyle": "bold underline"
            }
        },
        {
            "scope": ["markup.heading"],
            "settings": { "foreground": "#6BFF00", "fontStyle": "bold" }
        },
        {
            "scope": ["markup.bold"],
            "settings": { "foreground": "#FFFFFF", "fontStyle": "bold" }
        },
        {
            "scope": ["markup.italic"],
            "settings": { "foreground": "#FFDDBB", "fontStyle": "italic" }
        },
        {
            "scope": ["markup.underline"],
            "settings": { "fontStyle": "underline" }
        },
        {
            "scope": ["markup.inline.raw", "markup.fenced_code"],
            "settings": { "foreground": "#6BFF00" }
        },
        {
            "scope": ["markup.quote"],
            "settings": { "foreground": "#A877C8", "fontStyle": "italic" }
        },
        { "scope": ["markup.list"], "settings": { "foreground": "#F08B18" } },
        {
            "scope": ["markup.inserted"],
            "settings": { "foreground": "#6BFF00" }
        },
        {
            "scope": ["markup.deleted"],
            "settings": { "foreground": "#FF0000" }
        },
        {
            "scope": ["markup.changed"],
            "settings": { "foreground": "#6BFF00" }
        },
        {
            "scope": [
                "source.json meta.structure.dictionary.json support.type.property-name.json"
            ],
            "settings": { "foreground": "#A877C8", "fontStyle": "bold" }
        },
        {
            "scope": [
                "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
            ],
            "settings": { "foreground": "#F7BB2A" }
        }
    ],
    "semanticTokenColors": {
        "variable": "#D8C7F2",
        "variable.declaration": { "foreground": "#E6D7FF", "italic": true },
        "variable.readonly": "#A2B2DF",
        "variable.static": "#A877C8",
        "variable.defaultLibrary": "#F7BB2A",
        "parameter": { "foreground": "#F08B18", "italic": true },
        "property": "#A2DA5A",
        "property.readonly": "#D8C7F2",
        "property.static": "#F7BB2A",
        "function": { "foreground": "#6BFF00", "bold": true },
        "method": { "foreground": "#A2DA5A", "bold": true },
        "macro": { "foreground": "#F7BB2A", "bold": true },
        "class": { "foreground": "#F08B18", "bold": true },
        "interface": "#E36DFF",
        "type": "#F7BB2A",
        "typeParameter": "#A877C8",
        "enum": "#F1A8FF",
        "enumMember": "#F7BB2A",
        "namespace": "#A877C8",
        "decorator": "#6BFF00",
        "event": "#A2DA5A",
        "label": "#F08B18",
        "regexp": "#A2DA5A",
        "operator": "#6BFF00",
        "keyword": "#A877C8",
        "string": "#6BFF00",
        "number": "#F08B18",
        "comment": { "foreground": "#7D5AA6", "italic": true }
    },
    "$schema": "vscode://schemas/color-theme"
}
