        "editorWidget.resizeBorder": "#82062F",
        "extensionButton.prominentBackground": "#64072F90",
        "extensionButton.prominentHoverBackground": "#520627",
        "focusBorder": "#DC0C4F00",
        "gitDecoration.conflictingResourceForeground": "#80093D",
        "gitDecoration.deletedResourceForeground": "#520627",
        "gitDecoration.ignoredResourceForeground": "#82062F",
        "gitDecoration.modifiedResourceForeground": "#980737",
        "gitDecoration.untrackedResourceForeground": "#BC0944",
        "input.background": "#000000",
        "input.border": "#DC0C4F10",
        "input.foreground": "#B80A42",
        "input.placeholderForeground": "#B80A4260",
        "inputOption.activeBackground": "#B80A4230",
        "inputOption.activeBorder": "#B80A4230",
        "inputValidation.errorBorder": "#52062750",
        "inputValidation.infoBorder": "#BC094450",
        "inputValidation.warningBorder": "#80093D50",
        "list.activeSelectionBackground": "#000000",
        "list.activeSelectionForeground": "#82062F",
        "list.focusBackground": "#000000",
        "list.focusForeground": "#BC0944",
        "list.highlightForeground": "#82062F",
        "list.hoverBackground": "#000000",
        "list.hoverForeground": "#DC0C4F",
        "list.inactiveSelectionBackground": "#00000030",
        "list.inactiveSelectionForeground": "#82062F",
        "list.warningForeground": "#80093D",
        "listFilterWidget.background": "#00000030",
        "listFilterWidget.noMatchesOutline": "#00000030",
        "listFilterWidget.outline": "#00000030",
        "menu.background": "#000000f8",
        "menu.border": "#82062F50",
        "menu.foreground": "#B80A42",
        "menu.selectionBackground": "#000000",
        "menu.selectionBorder": "#00000030",
        "menu.selectionForeground": "#B80A42",
        "menu.separatorBackground": "#B80A42",
        "menubar.selectionBackground": "#000000",
        "menubar.selectionBorder": "#82062F50",
        "menubar.selectionForeground": "#B80A42",
        "minimap.background": "#000000",
        "minimapGutter.addedBackground": "#520627",
        "minimapGutter.deletedBackground": "#80093D",
        "minimapGutter.modifiedBackground": "#64072F",
        "minimapSlider.activeBackground": "#64072Fb0",
        "minimapSlider.background": "#64072F80",
        "minimapSlider.hoverBackground": "#64072Fa0",
        "notificationLink.foreground": "#82062F",
        "notifications.background": "#000000",
        "notifications.foreground": "#B80A42",
        "panel.background": "#000000",
        "panel.border": "#00000060",
        "panelTitle.activeBorder": "#82062F",
        "panelTitle.activeForeground": "#DC0C4F",
        "panelTitle.inactiveForeground": "#B80A42",
        "peekView.border": "#00000030",
        "peekViewEditor.background": "#B80A4205",
        "peekViewEditor.matchHighlightBackground": "#82062F50",
        "peekViewEditorGutter.background": "#B80A4205",
        "peekViewResult.background": "#B80A4205",
        "peekViewResult.matchHighlightBackground": "#82062F50",
        "peekViewResult.selectionBackground": "#82062F70",
        "peekViewTitle.background": "#B80A4205",
        "peekViewTitleDescription.foreground": "#B80A4260",
        "pickerGroup.foreground": "#82062F",
        "progressBar.background": "#82062F",
        "scrollbar.shadow": "#00000000",
        "scrollbarSlider.activeBackground": "#82062Fcc",
        "scrollbarSlider.background": "#82062Fbb",
        "scrollbarSlider.hoverBackground": "#82062Fee",
        "selection.background": "#82062F",
        "settings.checkboxBackground": "#000000",
        "settings.checkboxForeground": "#B80A42",
        "settings.dropdownBackground": "#000000",
        "settings.dropdownForeground": "#B80A42",
        "settings.headerForeground": "#82062F",
        "settings.modifiedItemIndicator": "#82062F",
        "settings.numberInputBackground": "#000000",
        "settings.numberInputForeground": "#B80A42",
        "settings.textInputBackground": "#000000",
        "settings.textInputForeground": "#B80A42",
        "sideBar.background": "#000000",
        "sideBar.border": "#82062F50",
        "sideBar.foreground": "#BC0944",
        "sideBarSectionHeader.background": "#000000",
        "sideBarSectionHeader.border": "#00000060",
        "sideBarSectionHeader.foreground": "#BC0944",
        "sideBarTitle.foreground": "#B80A42",
        "statusBar.background": "#000000",
        "statusBar.border": "#00000060",
        "statusBar.debuggingBackground": "#80093D",
        "statusBar.debuggingForeground": "#DC0C4F",
        "statusBar.foreground": "#FB7646",
        "statusBar.noFolderBackground": "#000000",
        "statusBarItem.hoverBackground": "#82062F20",
        "statusBarItem.remoteBackground": "#82062F",
        "statusBarItem.remoteForeground": "#000000",
        "tab.activeBackground": "#82062F50",
        "tab.activeBorder": "#82062F",
        "tab.activeForeground": "#DC0C4F",
        "tab.activeModifiedBorder": "#82062F",
        "tab.border": "#000000",
        "tab.inactiveBackground": "#82062F20",
        "tab.inactiveForeground": "#B80A42af",
        "tab.unfocusedActiveBorder": "#82062F",
        "tab.unfocusedActiveBackground": "#82062F40",
        "tab.unfocusedActiveForeground": "#B80A42",
        "tab.unfocusedInactiveBackground": "#82062F10",
        "tab.unfocusedInactiveForeground": "#B80A427f",
        "terminal.ansiBlack": "#000000",
        "terminal.ansiBlue": "#BC0944",
        "terminal.ansiBrightBlack": "#82062F",
        "terminal.ansiBrightBlue": "#BC0944",
        "terminal.ansiBrightCyan": "#F10B57",
        "terminal.ansiBrightGreen": "#64072F",
        "terminal.ansiBrightMagenta": "#80093D",
        "terminal.ansiBrightRed": "#520627",
        "terminal.ansiBrightWhite": "#DC0C4F",
        "terminal.ansiBrightYellow": "#80093D",
        "terminal.ansiCyan": "#F10B57",
        "terminal.ansiGreen": "#64072F",
        "terminal.ansiMagenta": "#80093D",
        "terminal.ansiRed": "#520627",
        "terminal.ansiWhite": "#DC0C4F",
        "terminal.ansiYellow": "#80093D",
        "terminalCursor.background": "#000000",
        "terminalCursor.foreground": "#80093D",
        "textLink.activeForeground": "#B80A42",
        "textLink.foreground": "#82062F",
        "titleBar.activeBackground": "#000000",
        "titleBar.activeForeground": "#B80A42",
        "titleBar.border": "#00000060",
        "titleBar.inactiveBackground": "#000000",
        "titleBar.inactiveForeground": "#82062F",
        "tree.indentGuidesStroke": "#000000",
        "widget.shadow": "#00000030"
    },
    "tokenColors": [
        {
            "scope": [
                "variable",
                "string constant.other.placeholder",
                "invalid.deprecated",
                "keyword",
                "storage.type",
                "storage.modifier"
            ],
            "settings": { "foreground": "#80093D" }
        },
        {
            "scope": [
                "variable",
                "string constant.other.placeholder",
                "entity.name.function",
                "punctuation.definition.interpolation.end.bracket.curly.scss",
                "punctuation.definition.interpolation.begin.bracket.curly.scss"
            ],
            "settings": { "fontStyle": "italic" }
        },
        {
            "scope": [
                "punctuation.definition.interpolation.end.bracket.curly.scss",
                "punctuation.definition.interpolation.begin.bracket.curly.scss"
            ],
            "settings": { "foreground": "#64072F" }
        },
        {
            "scope": ["constant.other.php"],
            "settings": { "foreground": "#80093D" }
        },
        {
            "scope": ["constant.other.color"],
            "settings": { "foreground": "#DC0C4F" }
        },
        {
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#520627" }
        },
        {
            "scope": ["Keyword", "Storage"],
            "settings": { "fontStyle": "italic" }
        },
        {
            "scope": [
                "keyword.control",
                "constant.other.color",
                "punctuation.definition.tag",
                "punctuation",
                "punctuation.separator.inheritance.php",
                "punctuation.definition.tag.html",
                "punctuation.section.embedded",
                "keyword.other.template",
                "keyword.other.substitution",
                "entity.name.tag.reference.scss"
            ],
            "settings": { "foreground": "#A7A8AF" }
        },
        {
            "scope": [
                "punctuation.definition.tag.begin.html",
                "punctuation.definition.tag.end.html",
                "entity.name.type.module.js"
            ],
            "settings": { "foreground": "#980737" }
        },
        {
            "scope": [
                "keyword.control.at-rule",
                "punctuation.terminator.rule.css",
                "keyword.control.operator",
                "punctuation.definition.entity.css",
                "keyword.operator.assignment.js",
                "punctuation.separator.comma.js",
                "punctuation.definition.string.begin.js",
                "punctuation.definition.string.end.js",
                "punctuation.definition.binding-pattern.object.js"
            ],
            "settings": { "foreground": "#B80A42" }
        },
        {
            "scope": ["punctuation.definition", "string.quoted.single.scss"],
            "settings": { "foreground": "#A7A8AF" }
        },
        { "scope": ["keyword.control"], "settings": { "fontStyle": "bold" } },
        {
            "scope": [
                "comment.line.scss",
                "comment.line.double-slash.js",
                "punctuation.definition.comment.scss",
                "punctuation.definition.comment.js",
                "punctuation.definition.comment.html",
                "comment.block.html"
            ],
            "settings": { "foreground": "#6D6F7C" }
        },
        {
            "scope": ["text.html.derivative"],
            "settings": { "foreground": "#A7A8AF" }
        },
        {
            "scope": [
                "entity.name.tag",
                "meta.tag.sgml",
                "markup.deleted.git_gutter"
            ],
            "settings": { "foreground": "#B80A42" }
        },
        {
            "scope": ["entity.name.tag.html"],
            "settings": { "fontStyle": "bold" }
        },
        {
            "scope": [
                "variable.parameter.js",
                "variable.parameter.keyframe-list.css"
            ],
            "settings": { "foreground": "#80093D" }
        },
        {
            "scope": [
                "variable.other.object.js",
                "storage.type.js",
                "string.other.link.title.markdown",
                "variable.other.readwrite.js",
                "variable.other.property.js"
            ],
            "settings": { "foreground": "#980737", "fontStyle": "" }
        },
        {
            "scope": [
                "string",
                "string.quoted.double.html",
                "variable.other.constant.js",
                "variable.other.object.property.js",
                "string.quoted.double.json",
                "markup.fenced_code.block.markdown",
                "markup.inline.raw.string.markdown",
                "variable.function",
                "keyword.other.special-method",
                "entity.name.function",
                "markup.bold",
                "markup.bold.markdown",
                "markup.italic.markdown",
                "meta.class-method.js entity.name.function.js",
                "variable.function.constructor",
                "entity.name.tag.other.html",
                "entity.name.tag.block.any.html",
                "source.sass keyword.control"
            ],
            "settings": { "foreground": "#BC0944" }
        },
        {
            "scope": [
                "punctuation.definition.string.begin.html",
                "punctuation.definition.string.end.html"
            ],
            "settings": { "foreground": "#F10B57" }
        },
        {
            "scope": [
                "support.other.variable",
                "string.other.link",
                "markup.table"
            ],
            "settings": { "foreground": "#B80A42" }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.language",
                "constant.character",
                "constant.escape",
                "keyword.other.unit",
                "keyword.other",
                "punctuation.separator.key-value.html"
            ],
            "settings": { "foreground": "#80093D" }
        },
        {
            "scope": [
                "variable.parameter.function.language.special",
                "variable.parameter"
            ],
            "settings": { "foreground": "#520627" }
        },
        {
            "scope": [
                "constant.other.symbol",
                "constant.other.key",
                "entity.other.inherited-class",
                "keyword.other.unit",
                "markup.heading",
                "markup.inserted.git_gutter",
                "meta.group.braces.curly",
                "constant.other.object.key.js",
                "string.unquoted.label.js"
            ],
            "settings": { "foreground": "#64072F", "fontStyle": "" }
        },
        {
            "scope": [
                "entity.name",
                "support.type",
                "support.class",
                "support.orther.namespace.use.php",
                "meta.use.php",
                "support.other.namespace.php",
                "markup.changed.git_gutter",
                "support.type.sys-types",
                "entity.other.attribute-name.html"
            ],
            "settings": { "foreground": "#80093D" }
        },
        { "scope": ["support.type"], "settings": { "foreground": "#B2CCD6" } },
        {
            "scope": [
                "source.css support.type.property-name",
                "source.sass support.type.property-name",
                "source.scss support.type.property-name",
                "source.less support.type.property-name",
                "source.stylus support.type.property-name",
                "source.postcss support.type.property-name"
            ],
            "settings": { "foreground": "#980737" }
        },
        {
            "scope": [
                "entity.name.module.js",
                "variable.import.parameter.js",
                "variable.other.class.js"
            ],
            "settings": { "foreground": "#520627" }
        },
        {
            "scope": [
                "entity.name.method.js",
                "tag.decorator.js entity.name.tag.js",
                "tag.decorator.js punctuation.definition.tag.js"
            ],
            "settings": { "foreground": "#BC0944", "fontStyle": "italic" }
        },
        {
            "scope": ["entity.other.attribute-name", "support.function"],
            "settings": { "foreground": "#80093D" }
        },
        {
            "scope": [
                "entity.other.attribute-name.id",
                "entity.other.attribute-name.class",
                "entity.other.attribute-name.pseudo-class",
                "entity.name.tag.css",
                "keyword.control.conditional.js",
                "support.constant",
                "entity.other.attribute-name.html",
                "string.quoted.single.js",
                "storage.type.function.js",
                "meta.object-literal.key"
            ],
            "settings": { "foreground": "#B80A42" }
        },
        {
            "scope": ["source.scss keyword.control"],
            "settings": { "foreground": "#80093D" }
        },
        {
            "scope": ["markup.inserted"],
            "settings": { "foreground": "#64072F" }
        },
        {
            "scope": ["markup.deleted"],
            "settings": { "foreground": "#520627" }
        },
        {
            "scope": ["markup.changed"],
            "settings": { "foreground": "#80093D" }
        },
        { "scope": ["string.regexp"], "settings": { "foreground": "#F10B57" } },
        {
            "scope": ["constant.character.escape"],
            "settings": { "foreground": "#F10B57" }
        },
        {
            "scope": ["*url*", "*link*", "*uri*"],
            "settings": { "fontStyle": "underline" }
        },
        {
            "scope": [
                "source.js constant.other.object.key.js string.unquoted.label.js"
            ],
            "settings": { "foreground": "#B80A42", "fontStyle": "italic" }
        },
        {
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#B80A42" }
        },
        {
            "scope": [
                "text.html.markdown",
                "punctuation.definition.list_item.markdown"
            ],
            "settings": { "foreground": "#B80A42" }
        },
        {
            "scope": ["text.html.markdown markup.inline.raw.markdown"],
            "settings": { "foreground": "#80093D" }
        },
        {
            "scope": [
                "text.html.markdown markup.inline.raw.markdown",
                "punctuation.definition.raw.markdown"
            ],
            "settings": { "foreground": "#82062F50" }
        },
        {
            "scope": ["text.html.markdown meta.dummy.line-break"],
            "settings": {}
        },
        {
            "scope": [
                "markdown.heading",
                "markup.heading | markup.heading entity.name",
                "markup.heading.markdown punctuation.definition.heading.markdown",
                "entity.name.section.markdown"
            ],
            "settings": { "foreground": "#980737", "fontStyle": "bold" }
        },
        {
            "scope": ["markup.underline"],
            "settings": { "foreground": "#BC0944", "fontStyle": "underline" }
        },
        { "scope": ["markup.strike"], "settings": { "fontStyle": "" } },
        {
            "scope": [
                "markup.quote punctuation.definition.blockquote.markdown"
            ],
            "settings": { "foreground": "#82062F50" }
        },
        { "scope": ["markup.quote"], "settings": { "fontStyle": "italic" } },
        {
            "scope": ["string.other.link.description.title.markdown"],
            "settings": { "foreground": "#80093D" }
        },
        {
            "scope": ["constant.other.reference.link.markdown"],
            "settings": { "foreground": "#80093D" }
        },
        {
            "scope": ["markup.raw.block"],
            "settings": { "foreground": "#80093D" }
        },
        {
            "scope": [
                "punctuation.definition.raw.markdown",
                "punctuation.definition.markdown"
            ],
            "settings": { "foreground": "#F10B57" }
        },
        {
            "scope": ["variable.language.fenced.markdown"],
            "settings": { "foreground": "#82062F" }
        },
        {
            "scope": ["meta.separator"],
            "settings": { "foreground": "#A7A8AF", "fontStyle": "bold" }
        },
        {
            "scope": "token.info-token",
            "settings": { "foreground": "#82062F" }
        },
        {
            "scope": "token.warn-token",
            "settings": { "foreground": "#80093D" }
        },
        {
            "scope": "token.error-token",
            "settings": { "foreground": "#FF293B" }
        },
        {
            "scope": "token.debug-token",
            "settings": { "foreground": "#F10B57" }
        }
    ]
}
