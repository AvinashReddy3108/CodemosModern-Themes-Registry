    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#a0a0b0", "fontStyle": "italic" }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.new",
                "keyword.operator.delete",
                "storage.modifier"
            ],
            "settings": { "foreground": "#c8102e" }
        },
        {
            "name": "Storage types",
            "scope": [
                "storage.type.function",
                "storage.type.class",
                "storage.type"
            ],
            "settings": { "foreground": "#c8102e", "fontStyle": "italic" }
        },
        {
            "name": "Keyword operators",
            "scope": [
                "keyword.operator",
                "keyword.operator.logical",
                "keyword.operator.comparison"
            ],
            "settings": { "foreground": "#804870" }
        },
        {
            "name": "Strings",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#2e7a50" }
        },
        {
            "name": "String escape / regexp",
            "scope": ["constant.character.escape", "string.regexp"],
            "settings": { "foreground": "#3a9e6a" }
        },
        {
            "name": "Numbers",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#8a6010" }
        },
        {
            "name": "Boolean / null",
            "scope": ["constant.language"],
            "settings": { "foreground": "#8a6010", "fontStyle": "italic" }
        },
        {
            "name": "Other constants",
            "scope": ["constant.other", "variable.other.constant"],
            "settings": { "foreground": "#8a7840" }
        },
        {
            "name": "Function definitions",
            "scope": [
                "entity.name.function",
                "meta.function entity.name.function"
            ],
            "settings": { "foreground": "#2a6070" }
        },
        {
            "name": "Function calls",
            "scope": [
                "meta.function-call.generic",
                "meta.function-call entity.name.function"
            ],
            "settings": { "foreground": "#387780" }
        },
        {
            "name": "Function parameters",
            "scope": ["variable.parameter", "meta.parameter"],
            "settings": { "foreground": "#6a5838", "fontStyle": "italic" }
        },
        {
            "name": "Class names",
            "scope": ["entity.name.class", "entity.name.type.class"],
            "settings": { "foreground": "#8a6010" }
        },
        {
            "name": "Inherited class",
            "scope": ["entity.other.inherited-class"],
            "settings": { "foreground": "#8a6010", "fontStyle": "italic" }
        },
        {
            "name": "Type names",
            "scope": ["entity.name.type", "support.type"],
            "settings": { "foreground": "#b05828" }
        },
        {
            "name": "Interface names",
            "scope": ["entity.name.type.interface"],
            "settings": { "foreground": "#b05828", "fontStyle": "italic" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "variable.other.readwrite"],
            "settings": { "foreground": "#2a2830" }
        },
        {
            "name": "Object properties",
            "scope": ["variable.other.property", "support.variable.property"],
            "settings": { "foreground": "#3a3848" }
        },
        {
            "name": "Language variables (this/self)",
            "scope": ["variable.language"],
            "settings": { "foreground": "#c8102e", "fontStyle": "italic" }
        },
        {
            "name": "Punctuation",
            "scope": ["punctuation", "meta.brace", "meta.delimiter"],
            "settings": { "foreground": "#757780" }
        },
        {
            "name": "HTML tags",
            "scope": ["entity.name.tag", "meta.tag.sgml"],
            "settings": { "foreground": "#c8102e" }
        },
        {
            "name": "HTML attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#2a6070" }
        },
        {
            "name": "HTML attribute values",
            "scope": ["string.quoted.double.html", "string.quoted.single.html"],
            "settings": { "foreground": "#2e7a50" }
        },
        {
            "name": "CSS property names",
            "scope": ["support.type.property-name.css", "entity.name.tag.css"],
            "settings": { "foreground": "#2a6070" }
        },
        {
            "name": "CSS values",
            "scope": ["support.constant.property-value.css"],
            "settings": { "foreground": "#6a5838" }
        },
        {
            "name": "CSS selectors",
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css"
            ],
            "settings": { "foreground": "#b05828" }
        },
        {
            "name": "CSS units",
            "scope": ["constant.numeric.css", "keyword.other.unit.css"],
            "settings": { "foreground": "#8a6010" }
        },
        {
            "name": "JSON keys",
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#2a6070" }
        },
        {
            "name": "Markdown headings",
            "scope": ["entity.name.section.markdown", "markup.heading"],
            "settings": { "foreground": "#c8102e", "fontStyle": "bold" }
        },
        {
            "name": "Markdown bold",
            "scope": ["markup.bold"],
            "settings": { "foreground": "#8a6010", "fontStyle": "bold" }
        },
        {
            "name": "Markdown italic",
            "scope": ["markup.italic"],
            "settings": { "foreground": "#6a5838", "fontStyle": "italic" }
        },
        {
            "name": "Markdown code",
            "scope": ["markup.inline.raw", "markup.fenced_code.block"],
            "settings": { "foreground": "#2e7a50" }
        },
        {
            "name": "Markdown links",
            "scope": ["markup.underline.link"],
            "settings": { "foreground": "#387780" }
        },
        {
            "name": "Decorators",
            "scope": ["meta.decorator", "entity.name.function.decorator"],
            "settings": { "foreground": "#b05828", "fontStyle": "italic" }
        },
        {
            "name": "Support functions",
            "scope": ["support.function", "support.function.builtin"],
            "settings": { "foreground": "#387780" }
        },
        {
            "name": "Support classes",
            "scope": ["support.class"],
            "settings": { "foreground": "#8a6010" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#ffffff", "background": "#e83151" }
        },
        {
            "name": "Deprecated",
            "scope": ["invalid.deprecated"],
            "settings": {
                "foreground": "#b0aeb5",
                "fontStyle": "strikethrough"
            }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
