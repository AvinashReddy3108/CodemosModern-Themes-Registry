        "terminal.ansiBrightRed": "#8d5b4c",
        "terminal.ansiBrightGreen": "#c4bbaf",
        "terminal.ansiBrightYellow": "#d4c8be",
        "terminal.ansiBrightBlue": "#a5978b",
        "terminal.ansiBrightMagenta": "#5a2a27",
