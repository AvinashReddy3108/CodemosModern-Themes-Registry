    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#1e5060", "fontStyle": "italic" }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.new",
                "keyword.operator.delete",
                "storage.modifier"
            ],
            "settings": { "foreground": "#6a80c8" }
        },
        {
            "name": "Storage types",
            "scope": [
                "storage.type.function",
                "storage.type.class",
                "storage.type"
            ],
            "settings": { "foreground": "#6a80c8", "fontStyle": "italic" }
        },
        {
            "name": "Keyword operators",
            "scope": [
                "keyword.operator",
                "keyword.operator.logical",
                "keyword.operator.comparison"
            ],
            "settings": { "foreground": "#007ea7" }
        },
        {
            "name": "Strings",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#2a9e6e" }
        },
        {
            "name": "String escape / regexp",
            "scope": ["constant.character.escape", "string.regexp"],
            "settings": { "foreground": "#3abf85" }
        },
        {
            "name": "Numbers",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#c8a020" }
        },
        {
            "name": "Boolean / null",
            "scope": ["constant.language"],
            "settings": { "foreground": "#c8a020", "fontStyle": "italic" }
        },
        {
            "name": "Other constants",
            "scope": ["constant.other", "variable.other.constant"],
            "settings": { "foreground": "#7ab8cc" }
        },
        {
            "name": "Function definitions",
            "scope": [
                "entity.name.function",
                "meta.function entity.name.function"
            ],
            "settings": { "foreground": "#00a7e1" }
        },
        {
            "name": "Function calls",
            "scope": [
                "meta.function-call.generic",
                "meta.function-call entity.name.function"
            ],
            "settings": { "foreground": "#40c8f0" }
        },
        {
            "name": "Function parameters",
            "scope": ["variable.parameter", "meta.parameter"],
            "settings": { "foreground": "#7ab8cc", "fontStyle": "italic" }
        },
        {
            "name": "Class names",
            "scope": ["entity.name.class", "entity.name.type.class"],
            "settings": { "foreground": "#c8a020" }
        },
        {
            "name": "Inherited class",
            "scope": ["entity.other.inherited-class"],
            "settings": { "foreground": "#c8a020", "fontStyle": "italic" }
        },
        {
            "name": "Type names",
            "scope": ["entity.name.type", "support.type"],
            "settings": { "foreground": "#00a7e1" }
        },
        {
            "name": "Interface names",
            "scope": ["entity.name.type.interface"],
            "settings": { "foreground": "#00a7e1", "fontStyle": "italic" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "variable.other.readwrite"],
            "settings": { "foreground": "#d8eef5" }
        },
        {
            "name": "Object properties",
            "scope": ["variable.other.property", "support.variable.property"],
            "settings": { "foreground": "#b8d8e5" }
        },
        {
            "name": "Language variables (this/self)",
            "scope": ["variable.language"],
            "settings": { "foreground": "#00a7e1", "fontStyle": "italic" }
        },
        {
            "name": "Punctuation",
            "scope": ["punctuation", "meta.brace", "meta.delimiter"],
            "settings": { "foreground": "#2a5a6a" }
        },
        {
            "name": "HTML tags",
            "scope": ["entity.name.tag", "meta.tag.sgml"],
            "settings": { "foreground": "#6a80c8" }
        },
        {
            "name": "HTML attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#00a7e1" }
        },
        {
            "name": "HTML attribute values",
            "scope": ["string.quoted.double.html", "string.quoted.single.html"],
            "settings": { "foreground": "#2a9e6e" }
        },
        {
            "name": "CSS property names",
            "scope": ["support.type.property-name.css", "entity.name.tag.css"],
            "settings": { "foreground": "#00a7e1" }
        },
        {
            "name": "CSS values",
            "scope": ["support.constant.property-value.css"],
            "settings": { "foreground": "#7ab8cc" }
        },
        {
            "name": "CSS selectors",
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css"
            ],
            "settings": { "foreground": "#c8a020" }
        },
        {
            "name": "CSS units",
            "scope": ["constant.numeric.css", "keyword.other.unit.css"],
            "settings": { "foreground": "#c8a020" }
        },
        {
            "name": "JSON keys",
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#00a7e1" }
        },
        {
            "name": "Markdown headings",
            "scope": ["entity.name.section.markdown", "markup.heading"],
            "settings": { "foreground": "#ffffff", "fontStyle": "bold" }
        },
        {
            "name": "Markdown bold",
            "scope": ["markup.bold"],
            "settings": { "foreground": "#c8a020", "fontStyle": "bold" }
        },
        {
            "name": "Markdown italic",
            "scope": ["markup.italic"],
            "settings": { "foreground": "#7ab8cc", "fontStyle": "italic" }
        },
        {
            "name": "Markdown code",
            "scope": ["markup.inline.raw", "markup.fenced_code.block"],
            "settings": { "foreground": "#2a9e6e" }
        },
        {
            "name": "Markdown links",
            "scope": ["markup.underline.link"],
            "settings": { "foreground": "#00a7e1" }
        },
        {
            "name": "Decorators",
            "scope": ["meta.decorator", "entity.name.function.decorator"],
            "settings": { "foreground": "#c8a020", "fontStyle": "italic" }
        },
        {
            "name": "Support functions",
            "scope": ["support.function", "support.function.builtin"],
            "settings": { "foreground": "#40c8f0" }
        },
        {
            "name": "Support classes",
            "scope": ["support.class"],
            "settings": { "foreground": "#c8a020" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#ffffff", "background": "#e05555" }
        },
        {
            "name": "Deprecated",
            "scope": ["invalid.deprecated"],
            "settings": {
                "foreground": "#2a5a6a",
                "fontStyle": "strikethrough"
            }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
