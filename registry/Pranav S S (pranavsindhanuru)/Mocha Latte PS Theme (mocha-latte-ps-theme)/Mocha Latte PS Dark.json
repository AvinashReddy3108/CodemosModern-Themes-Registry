    "tokenColors": [
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#2e4450", "fontStyle": "italic" }
        },
        {
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#c47a5a", "fontStyle": "italic" }
        },
        {
            "scope": [
                "keyword.operator",
                "keyword.operator.arithmetic",
                "keyword.operator.comparison",
                "keyword.operator.logical"
            ],
            "settings": { "foreground": "#5e6e78" }
        },
        {
            "scope": [
                "keyword.control.import",
                "keyword.control.export",
                "keyword.control.from"
            ],
            "settings": { "foreground": "#c47a5a" }
        },
        {
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#90c090" }
        },
        {
            "scope": [
                "punctuation.definition.string.begin",
                "punctuation.definition.string.end"
            ],
            "settings": { "foreground": "#70a070" }
        },
        {
            "scope": [
                "constant.character.escape",
                "constant.other.placeholder"
            ],
            "settings": { "foreground": "#b0d890", "fontStyle": "italic" }
        },
        {
            "scope": [
                "entity.name.function",
                "meta.function-call",
                "variable.function",
                "support.function"
            ],
            "settings": { "foreground": "#70b8d0" }
        },
        {
            "scope": ["entity.name.label"],
            "settings": { "foreground": "#70b8d0" }
        },
        {
            "scope": [
                "entity.name.type.class",
                "entity.name.type",
                "support.class",
                "support.type"
            ],
            "settings": { "foreground": "#d4b88a", "fontStyle": "italic" }
        },
        {
            "scope": ["meta.type.annotation", "meta.type.parameters"],
            "settings": { "foreground": "#d4b88a", "fontStyle": "italic" }
        },
        {
            "scope": ["entity.name.type.module", "meta.import variable.other"],
            "settings": { "foreground": "#d4b88a" }
        },
        {
            "scope": ["variable", "variable.name", "variable.other"],
            "settings": { "foreground": "#f2f4f3" }
        },
        {
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#e8ece8" }
        },
        {
            "scope": ["variable.language"],
            "settings": { "foreground": "#c47a5a", "fontStyle": "italic" }
        },
        {
            "scope": [
                "variable.other.property",
                "variable.other.object.property",
                "support.variable.property"
            ],
            "settings": { "foreground": "#c8a878" }
        },
        {
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#a0c8b8" }
        },
        {
            "scope": ["constant.language"],
            "settings": { "foreground": "#c47a5a" }
        },
        {
            "scope": ["constant", "constant.other", "constant.character"],
            "settings": { "foreground": "#a0c8b8" }
        },
        {
            "scope": ["entity.name.tag", "meta.tag.sgml"],
            "settings": { "foreground": "#70b8d0" }
        },
        {
            "scope": ["entity.name.tag support.class.component"],
            "settings": { "foreground": "#d4b88a" }
        },
        {
            "scope": ["meta.tag.attribute", "entity.other.attribute-name"],
            "settings": { "foreground": "#c8a878", "fontStyle": "italic" }
        },
        {
            "scope": [
                "punctuation",
                "meta.tag",
                "punctuation.definition.tag",
                "punctuation.definition.tag.html",
                "punctuation.definition.tag.begin.html",
                "punctuation.definition.tag.end.html",
                "punctuation.section.embedded",
                "keyword.other.template",
                "keyword.other.substitution"
            ],
            "settings": { "foreground": "#5e6e78" }
        },
        {
            "scope": [
                "punctuation.terminator.statement",
                "punctuation.separator.comma",
                "punctuation.terminator.rule"
            ],
            "settings": { "foreground": "#2e4450" }
        },
        {
            "scope": ["punctuation.accessor"],
            "settings": { "foreground": "#5e6e78" }
        },
        {
            "scope": [
                "source.css entity.other.attribute-name.class",
                "source.scss entity.other.attribute-name.class"
            ],
            "settings": { "foreground": "#d4b88a" }
        },
        {
            "scope": [
                "source.css entity.other.attribute-name.id",
                "source.scss entity.other.attribute-name.id"
            ],
            "settings": { "foreground": "#c8a878" }
        },
        {
            "scope": [
                "support.type.property-name.css",
                "meta.property-list.css",
                "meta.property-list.scss"
            ],
            "settings": { "foreground": "#70b8d0" }
        },
        {
            "scope": [
                "meta.property-value.css",
                "support.constant.property-value.css"
            ],
            "settings": { "foreground": "#90c090" }
        },
        {
            "scope": [
                "entity.other.attribute-name.pseudo-element",
                "entity.other.attribute-name.pseudo-class"
            ],
            "settings": { "foreground": "#a0c8b8", "fontStyle": "italic" }
        },
        {
            "scope": ["meta.object-literal.key"],
            "settings": { "foreground": "#c8a878" }
        },
        {
            "scope": [
                "source.json meta.structure.dictionary.json support.type.property-name.json"
            ],
            "settings": { "foreground": "#70b8d0" }
        },
        {
            "scope": [
                "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
            ],
            "settings": { "foreground": "#c8a878" }
        },
        {
            "scope": [
                "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
            ],
            "settings": { "foreground": "#d4b88a" }
        },
        {
            "scope": ["*url*", "*link*", "*uri*"],
            "settings": { "foreground": "#70b8d0", "fontStyle": "underline" }
        },
        {
            "scope": [
                "tag.decorator.js entity.name.tag.js",
                "tag.decorator.js punctuation.definition.tag.js"
            ],
            "settings": { "foreground": "#c47a5a", "fontStyle": "italic" }
        },
        {
            "scope": ["markup.heading", "entity.name.section"],
            "settings": { "foreground": "#70b8d0", "fontStyle": "bold" }
        },
        {
            "scope": ["markup.italic"],
            "settings": { "foreground": "#e8ece8", "fontStyle": "italic" }
        },
        {
            "scope": ["markup.bold"],
            "settings": { "foreground": "#f2f4f3", "fontStyle": "bold" }
        },
        {
            "scope": ["markup.underline"],
            "settings": { "foreground": "#90c090", "fontStyle": "underline" }
        },
        {
            "scope": ["markup.strike"],
            "settings": {
                "foreground": "#2e4450",
                "fontStyle": "strikethrough"
            }
        },
        {
            "scope": ["markup.quote"],
            "settings": { "foreground": "#5e6e78", "fontStyle": "italic" }
        },
        {
            "scope": [
                "markup.raw.block",
                "markup.fenced_code.block.markdown",
                "markup.inline.raw.string.markdown"
            ],
            "settings": { "foreground": "#a0c8b8" }
        },
        {
            "scope": ["markup.deleted", "punctuation.definition.deleted"],
            "settings": { "foreground": "#5e503f" }
        },
        {
            "scope": ["markup.inserted", "punctuation.definition.inserted"],
            "settings": { "foreground": "#90c090" }
        },
        {
            "scope": ["markup.changed", "punctuation.definition.changed"],
            "settings": { "foreground": "#c8a878" }
        },
        {
            "scope": ["entity.other.inherited-class"],
            "settings": { "foreground": "#d4b88a" }
        },
        {
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#f14c4c" }
        },
        {
            "scope": ["token.info-token"],
            "settings": { "foreground": "#a9927d" }
        },
        {
            "scope": ["token.warn-token"],
            "settings": { "foreground": "#cca700" }
        },
        {
            "scope": ["token.error-token"],
            "settings": { "foreground": "#f14c4c" }
        },
        {
            "scope": ["token.debug-token"],
            "settings": { "foreground": "#2e4450" }
        }
    ]
}
