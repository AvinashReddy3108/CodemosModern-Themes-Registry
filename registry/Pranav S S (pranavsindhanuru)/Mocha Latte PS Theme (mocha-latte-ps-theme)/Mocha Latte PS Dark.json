        "scrollbarSlider.activeBackground": "#a9927d66",
        "sideBar.background": "#0a0908",
        "sideBar.border": "#1a2830",
        "sideBar.foreground": "#a9927d",
        "sideBarSectionHeader.background": "#1a2830",
        "sideBarSectionHeader.foreground": "#22333b",
