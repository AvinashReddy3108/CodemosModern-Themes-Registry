    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#1e5c66", "fontStyle": "italic" }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.new",
                "keyword.operator.delete",
                "storage.modifier"
            ],
            "settings": { "foreground": "#ff6b6b" }
        },
        {
            "name": "Storage types",
            "scope": [
                "storage.type.function",
                "storage.type.class",
                "storage.type"
            ],
            "settings": { "foreground": "#ff6b6b", "fontStyle": "italic" }
        },
        {
            "name": "Keyword operators",
            "scope": [
                "keyword.operator",
                "keyword.operator.logical",
                "keyword.operator.comparison"
            ],
            "settings": { "foreground": "#2a7a84" }
        },
        {
            "name": "Strings",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#4ecdc4" }
        },
        {
            "name": "String escape / regexp",
            "scope": ["constant.character.escape", "string.regexp"],
            "settings": { "foreground": "#7de8e0" }
        },
        {
            "name": "Numbers",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#ffe66d" }
        },
        {
            "name": "Boolean / null",
            "scope": ["constant.language"],
            "settings": { "foreground": "#ffe66d", "fontStyle": "italic" }
        },
        {
            "name": "Other constants",
            "scope": ["constant.other", "variable.other.constant"],
            "settings": { "foreground": "#7dd8d0" }
        },
        {
            "name": "Function definitions",
            "scope": [
                "entity.name.function",
                "meta.function entity.name.function"
            ],
            "settings": { "foreground": "#a8e8e4" }
        },
        {
            "name": "Function calls",
            "scope": [
                "meta.function-call.generic",
                "meta.function-call entity.name.function"
            ],
            "settings": { "foreground": "#c8f0ec" }
        },
        {
            "name": "Function parameters",
            "scope": ["variable.parameter", "meta.parameter"],
            "settings": { "foreground": "#b8e8e4", "fontStyle": "italic" }
        },
        {
            "name": "Class names",
            "scope": ["entity.name.class", "entity.name.type.class"],
            "settings": { "foreground": "#ffe66d" }
        },
        {
            "name": "Inherited class",
            "scope": ["entity.other.inherited-class"],
            "settings": { "foreground": "#ffe66d", "fontStyle": "italic" }
        },
        {
            "name": "Type names",
            "scope": ["entity.name.type", "support.type"],
            "settings": { "foreground": "#7dd8d0" }
        },
        {
            "name": "Interface names",
            "scope": ["entity.name.type.interface"],
            "settings": { "foreground": "#7dd8d0", "fontStyle": "italic" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "variable.other.readwrite"],
            "settings": { "foreground": "#e8fffe" }
        },
        {
            "name": "Object properties",
            "scope": ["variable.other.property", "support.variable.property"],
            "settings": { "foreground": "#c8ecea" }
        },
        {
            "name": "Language variables (this/self)",
            "scope": ["variable.language"],
            "settings": { "foreground": "#ff6b6b", "fontStyle": "italic" }
        },
        {
            "name": "Punctuation",
            "scope": ["punctuation", "meta.brace", "meta.delimiter"],
            "settings": { "foreground": "#1e5c66" }
        },
        {
            "name": "HTML tags",
            "scope": ["entity.name.tag", "meta.tag.sgml"],
            "settings": { "foreground": "#ff6b6b" }
        },
        {
            "name": "HTML attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#a8e8e4" }
        },
        {
            "name": "HTML attribute values",
            "scope": ["string.quoted.double.html", "string.quoted.single.html"],
            "settings": { "foreground": "#4ecdc4" }
        },
        {
            "name": "CSS property names",
            "scope": ["support.type.property-name.css", "entity.name.tag.css"],
            "settings": { "foreground": "#a8e8e4" }
        },
        {
            "name": "CSS values",
            "scope": ["support.constant.property-value.css"],
            "settings": { "foreground": "#b8e8e4" }
        },
        {
            "name": "CSS selectors",
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css"
            ],
            "settings": { "foreground": "#ffe66d" }
        },
        {
            "name": "CSS units",
            "scope": ["constant.numeric.css", "keyword.other.unit.css"],
            "settings": { "foreground": "#ffe66d" }
        },
        {
            "name": "JSON keys",
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#a8e8e4" }
        },
        {
            "name": "Markdown headings",
            "scope": ["entity.name.section.markdown", "markup.heading"],
            "settings": { "foreground": "#e8fffe", "fontStyle": "bold" }
        },
        {
            "name": "Markdown bold",
            "scope": ["markup.bold"],
            "settings": { "foreground": "#ffe66d", "fontStyle": "bold" }
        },
        {
            "name": "Markdown italic",
            "scope": ["markup.italic"],
            "settings": { "foreground": "#4ecdc4", "fontStyle": "italic" }
        },
        {
            "name": "Markdown code",
            "scope": ["markup.inline.raw", "markup.fenced_code.block"],
            "settings": { "foreground": "#4ecdc4" }
        },
        {
            "name": "Markdown links",
            "scope": ["markup.underline.link"],
            "settings": { "foreground": "#7dd8d0" }
        },
        {
            "name": "Decorators",
            "scope": ["meta.decorator", "entity.name.function.decorator"],
            "settings": { "foreground": "#ffe66d", "fontStyle": "italic" }
        },
        {
            "name": "Support functions",
            "scope": ["support.function", "support.function.builtin"],
            "settings": { "foreground": "#c8f0ec" }
        },
        {
            "name": "Support classes",
            "scope": ["support.class"],
            "settings": { "foreground": "#ffe66d" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#091e22", "background": "#ff6b6b" }
        },
        {
            "name": "Deprecated",
            "scope": ["invalid.deprecated"],
            "settings": {
                "foreground": "#1e5c66",
                "fontStyle": "strikethrough"
            }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
