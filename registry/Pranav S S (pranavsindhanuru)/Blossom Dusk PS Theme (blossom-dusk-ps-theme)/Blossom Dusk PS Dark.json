    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#3d1828", "fontStyle": "italic" }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.new",
                "keyword.operator.delete",
                "storage.modifier"
            ],
            "settings": { "foreground": "#b06080" }
        },
        {
            "name": "Storage types",
            "scope": [
                "storage.type.function",
                "storage.type.class",
                "storage.type"
            ],
            "settings": { "foreground": "#b06080", "fontStyle": "italic" }
        },
        {
            "name": "Keyword operators",
            "scope": [
                "keyword.operator",
                "keyword.operator.logical",
                "keyword.operator.comparison"
            ],
            "settings": { "foreground": "#5d2a42" }
        },
        {
            "name": "Strings",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#5a8a6a" }
        },
        {
            "name": "String escape / regexp",
            "scope": ["constant.character.escape", "string.regexp"],
            "settings": { "foreground": "#70aa80" }
        },
        {
            "name": "Numbers",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#d4a060" }
        },
        {
            "name": "Boolean / null",
            "scope": ["constant.language"],
            "settings": { "foreground": "#d4a060", "fontStyle": "italic" }
        },
        {
            "name": "Other constants",
            "scope": ["constant.other", "variable.other.constant"],
            "settings": { "foreground": "#fcb1a6" }
        },
        {
            "name": "Function definitions",
            "scope": [
                "entity.name.function",
                "meta.function entity.name.function"
            ],
            "settings": { "foreground": "#fb6376" }
        },
        {
            "name": "Function calls",
            "scope": [
                "meta.function-call.generic",
                "meta.function-call entity.name.function"
            ],
            "settings": { "foreground": "#ff8090" }
        },
        {
            "name": "Function parameters",
            "scope": ["variable.parameter", "meta.parameter"],
            "settings": { "foreground": "#fcb1a6", "fontStyle": "italic" }
        },
        {
            "name": "Class names",
            "scope": ["entity.name.class", "entity.name.type.class"],
            "settings": { "foreground": "#d4a060" }
        },
        {
            "name": "Inherited class",
            "scope": ["entity.other.inherited-class"],
            "settings": { "foreground": "#d4a060", "fontStyle": "italic" }
        },
        {
            "name": "Type names",
            "scope": ["entity.name.type", "support.type"],
            "settings": { "foreground": "#7878b8" }
        },
        {
            "name": "Interface names",
            "scope": ["entity.name.type.interface"],
            "settings": { "foreground": "#7878b8", "fontStyle": "italic" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "variable.other.readwrite"],
            "settings": { "foreground": "#ffdccc" }
        },
        {
            "name": "Object properties",
            "scope": ["variable.other.property", "support.variable.property"],
            "settings": { "foreground": "#f0c8b8" }
        },
        {
            "name": "Language variables (this/self)",
            "scope": ["variable.language"],
            "settings": { "foreground": "#fb6376", "fontStyle": "italic" }
        },
        {
            "name": "Punctuation",
            "scope": ["punctuation", "meta.brace", "meta.delimiter"],
            "settings": { "foreground": "#4a2030" }
        },
        {
            "name": "HTML tags",
            "scope": ["entity.name.tag", "meta.tag.sgml"],
            "settings": { "foreground": "#fb6376" }
        },
        {
            "name": "HTML attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#fcb1a6" }
        },
        {
            "name": "HTML attribute values",
            "scope": ["string.quoted.double.html", "string.quoted.single.html"],
            "settings": { "foreground": "#5a8a6a" }
        },
        {
            "name": "CSS property names",
            "scope": ["support.type.property-name.css", "entity.name.tag.css"],
            "settings": { "foreground": "#fcb1a6" }
        },
        {
            "name": "CSS values",
            "scope": ["support.constant.property-value.css"],
            "settings": { "foreground": "#ffdccc" }
        },
        {
            "name": "CSS selectors",
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css"
            ],
            "settings": { "foreground": "#d4a060" }
        },
        {
            "name": "CSS units",
            "scope": ["constant.numeric.css", "keyword.other.unit.css"],
            "settings": { "foreground": "#d4a060" }
        },
        {
            "name": "JSON keys",
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#fcb1a6" }
        },
        {
            "name": "Markdown headings",
            "scope": ["entity.name.section.markdown", "markup.heading"],
            "settings": { "foreground": "#fb6376", "fontStyle": "bold" }
        },
        {
            "name": "Markdown bold",
            "scope": ["markup.bold"],
            "settings": { "foreground": "#d4a060", "fontStyle": "bold" }
        },
        {
            "name": "Markdown italic",
            "scope": ["markup.italic"],
            "settings": { "foreground": "#fcb1a6", "fontStyle": "italic" }
        },
        {
            "name": "Markdown code",
            "scope": ["markup.inline.raw", "markup.fenced_code.block"],
            "settings": { "foreground": "#5a8a6a" }
        },
        {
            "name": "Markdown links",
            "scope": ["markup.underline.link"],
            "settings": { "foreground": "#fb6376" }
        },
        {
            "name": "Decorators",
            "scope": ["meta.decorator", "entity.name.function.decorator"],
            "settings": { "foreground": "#7878b8", "fontStyle": "italic" }
        },
        {
            "name": "Support functions",
            "scope": ["support.function", "support.function.builtin"],
            "settings": { "foreground": "#ff8090" }
        },
        {
            "name": "Support classes",
            "scope": ["support.class"],
            "settings": { "foreground": "#d4a060" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#fff9ec", "background": "#fb6376" }
        },
        {
            "name": "Deprecated",
            "scope": ["invalid.deprecated"],
            "settings": {
                "foreground": "#3d1828",
                "fontStyle": "strikethrough"
            }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
