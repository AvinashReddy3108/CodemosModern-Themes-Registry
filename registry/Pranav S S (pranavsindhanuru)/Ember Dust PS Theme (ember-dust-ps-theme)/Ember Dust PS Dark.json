    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#2e1a10", "fontStyle": "italic" }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.new",
                "keyword.operator.delete",
                "storage.modifier"
            ],
            "settings": { "foreground": "#7a4858" }
        },
        {
            "name": "Storage types",
            "scope": [
                "storage.type.function",
                "storage.type.class",
                "storage.type"
            ],
            "settings": { "foreground": "#7a4858", "fontStyle": "italic" }
        },
        {
            "name": "Keyword operators",
            "scope": [
                "keyword.operator",
                "keyword.operator.logical",
                "keyword.operator.comparison"
            ],
            "settings": { "foreground": "#5e503f" }
        },
        {
            "name": "Strings",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#88a898" }
        },
        {
            "name": "String escape / regexp",
            "scope": ["constant.character.escape", "string.regexp"],
            "settings": { "foreground": "#a0c0b0" }
        },
        {
            "name": "Numbers",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#c8b090" }
        },
        {
            "name": "Boolean / null",
            "scope": ["constant.language"],
            "settings": { "foreground": "#c8b090", "fontStyle": "italic" }
        },
        {
            "name": "Other constants",
            "scope": ["constant.other", "variable.other.constant"],
            "settings": { "foreground": "#a9927d" }
        },
        {
            "name": "Function definitions",
            "scope": [
                "entity.name.function",
                "meta.function entity.name.function"
            ],
            "settings": { "foreground": "#a9927d" }
        },
        {
            "name": "Function calls",
            "scope": [
                "meta.function-call.generic",
                "meta.function-call entity.name.function"
            ],
            "settings": { "foreground": "#c8b090" }
        },
        {
            "name": "Function parameters",
            "scope": ["variable.parameter", "meta.parameter"],
            "settings": { "foreground": "#8a7868", "fontStyle": "italic" }
        },
        {
            "name": "Class names",
            "scope": ["entity.name.class", "entity.name.type.class"],
            "settings": { "foreground": "#c8b090" }
        },
        {
            "name": "Inherited class",
            "scope": ["entity.other.inherited-class"],
            "settings": { "foreground": "#c8b090", "fontStyle": "italic" }
        },
        {
            "name": "Type names",
            "scope": ["entity.name.type", "support.type"],
            "settings": { "foreground": "#9a8878" }
        },
        {
            "name": "Interface names",
            "scope": ["entity.name.type.interface"],
            "settings": { "foreground": "#9a8878", "fontStyle": "italic" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "variable.other.readwrite"],
            "settings": { "foreground": "#f2f4f3" }
        },
        {
            "name": "Object properties",
            "scope": ["variable.other.property", "support.variable.property"],
            "settings": { "foreground": "#d8d4d0" }
        },
        {
            "name": "Language variables (this/self)",
            "scope": ["variable.language"],
            "settings": { "foreground": "#7a4858", "fontStyle": "italic" }
        },
        {
            "name": "Punctuation",
            "scope": ["punctuation", "meta.brace", "meta.delimiter"],
            "settings": { "foreground": "#3a2818" }
        },
        {
            "name": "HTML tags",
            "scope": ["entity.name.tag", "meta.tag.sgml"],
            "settings": { "foreground": "#7a4858" }
        },
        {
            "name": "HTML attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#a9927d" }
        },
        {
            "name": "HTML attribute values",
            "scope": ["string.quoted.double.html", "string.quoted.single.html"],
            "settings": { "foreground": "#88a898" }
        },
        {
            "name": "CSS property names",
            "scope": ["support.type.property-name.css", "entity.name.tag.css"],
            "settings": { "foreground": "#a9927d" }
        },
        {
            "name": "CSS values",
            "scope": ["support.constant.property-value.css"],
            "settings": { "foreground": "#c8b090" }
        },
        {
            "name": "CSS selectors",
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css"
            ],
            "settings": { "foreground": "#c8b090" }
        },
        {
            "name": "CSS units",
            "scope": ["constant.numeric.css", "keyword.other.unit.css"],
            "settings": { "foreground": "#c8b090" }
        },
        {
            "name": "JSON keys",
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#a9927d" }
        },
        {
            "name": "Markdown headings",
            "scope": ["entity.name.section.markdown", "markup.heading"],
            "settings": { "foreground": "#f2f4f3", "fontStyle": "bold" }
        },
        {
            "name": "Markdown bold",
            "scope": ["markup.bold"],
            "settings": { "foreground": "#c8b090", "fontStyle": "bold" }
        },
        {
            "name": "Markdown italic",
            "scope": ["markup.italic"],
            "settings": { "foreground": "#a9927d", "fontStyle": "italic" }
        },
        {
            "name": "Markdown code",
            "scope": ["markup.inline.raw", "markup.fenced_code.block"],
            "settings": { "foreground": "#88a898" }
        },
        {
            "name": "Markdown links",
            "scope": ["markup.underline.link"],
            "settings": { "foreground": "#a9927d" }
        },
        {
            "name": "Decorators",
            "scope": ["meta.decorator", "entity.name.function.decorator"],
            "settings": { "foreground": "#9a8878", "fontStyle": "italic" }
        },
        {
            "name": "Support functions",
            "scope": ["support.function", "support.function.builtin"],
            "settings": { "foreground": "#c8b090" }
        },
        {
            "name": "Support classes",
            "scope": ["support.class"],
            "settings": { "foreground": "#c8b090" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#f2f4f3", "background": "#49111c" }
        },
        {
            "name": "Deprecated",
            "scope": ["invalid.deprecated"],
            "settings": {
                "foreground": "#3a2818",
                "fontStyle": "strikethrough"
            }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
