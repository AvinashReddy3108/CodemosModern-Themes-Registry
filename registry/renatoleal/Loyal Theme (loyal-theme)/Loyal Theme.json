{
    "name": "Loyal Theme",
    "colors": {
        "editor.background": "#25253115",
        "editor.foreground": "#ECEFF1",
        "activityBarBadge.background": "#007acc",
        "sideBarTitle.foreground": "#bbbbbb"
    },
    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "fontStyle": "italic", "foreground": "#37474F" }
        },
        {
            "name": "String",
            "scope": [
                "string",
                "constant.other.symbol",
                "constant.other.key",
                "entity.other.inherited-class",
                "markup.heading",
                "markup.inserted.git_gutter",
                "meta.group.braces.curly constant.other.object.key.js string.unquoted.label.js"
            ],
            "settings": { "foreground": "#EFD28D" }
        },
        {
            "name": "Function",
            "scope": [
                "entity.name.function",
                "meta.function-call",
                "variable.function",
                "support.function",
                "keyword.other.special-method",
                "entity.name.method.js",
                "meta.class-method.js entity.name.function.js",
                "variable.function.constructor"
            ],
            "settings": { "foreground": "#80CBC4" }
        },
        {
            "name": "Variable",
            "scope": [
                "variable",
                "string constant.other.placeholder",
                "meta.block variable.other",
                "support.other.variable",
                "string.other.link"
            ],
            "settings": { "foreground": "#ECEFF1" }
        },
        {
            "name": "Keyword",
            "scope": [
                "keyword",
                "storage.type",
                "storage.modifier",
                "keyword.control",
                "keyword.other.template",
                "keyword.other.substitution"
            ],
            "settings": { "foreground": "#ff6600" }
        },
        {
            "name": "Number, Constant",
            "scope": [
                "constant.numeric",
                "constant.language",
                "support.constant",
                "constant.character",
                "constant.escape",
                "variable.parameter"
            ],
            "settings": { "foreground": "#F78C6C" }
        },
        {
            "name": "Class, Support",
            "scope": [
                "entity.name",
                "support.type",
                "support.class",
                "support.other.namespace.use.php",
                "support.other.namespace.php",
                "support.type.sys-types"
            ],
            "settings": { "foreground": "#FFCB6B" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
