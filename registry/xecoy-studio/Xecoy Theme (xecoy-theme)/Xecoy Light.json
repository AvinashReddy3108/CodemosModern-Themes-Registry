    "tokenColors": [
        {
            "name": "注释",
            "scope": "comment",
            "settings": { "foreground": "#8F8F8F", "fontStyle": "" }
        },
        {
            "name": "常量值",
            "scope": "constant",
            "settings": { "foreground": "#077aab", "fontStyle": "" }
        },
        {
            "name": "关键字",
            "scope": "keyword",
            "settings": { "foreground": "#c96520", "fontStyle": "" }
        },
        {
            "name": "无效内容",
            "scope": "invalid",
            "settings": { "foreground": "#a11922", "fontStyle": "" }
        },
        {
            "name": "标记文本",
            "scope": "markup",
            "settings": { "fontStyle": "underline" }
        },
        {
            "name": "常规数据",
            "scope": "meta",
            "settings": { "foreground": "#333333", "fontStyle": "" }
        },
        {
            "name": "结构与对象",
            "scope": "storage",
            "settings": { "foreground": "#c96520", "fontStyle": "" }
        },
        {
            "name": "字符串",
            "scope": "string",
            "settings": { "foreground": "#007d19", "fontStyle": "" }
        },
        {
            "name": "特殊",
            "scope": "support",
            "settings": { "foreground": "#c96520", "fontStyle": "" }
        },
        {
            "scope": [
                "keyword.operator",
                "variable.parameter.keyframe-list",
                "punctuation.definition.entity"
            ],
            "settings": { "foreground": "#333333", "fontStyle": "" }
        },
        {
            "scope": [
                "source support.function",
                "entity.other.keyframe-offset",
                "keyword.operator.logical.css"
            ],
            "settings": { "foreground": "#333333", "fontStyle": "italic" }
        },
        {
            "scope": [
                "meta.function-call entity.name.function",
                "meta.function.definition entity.name.function",
                "meta.definition.function",
                "meta.definition.method",
                "keyword.control.at-rule",
                "support.constant"
            ],
            "settings": { "foreground": "#954595", "fontStyle": "" }
        },
        {
            "scope": [
                "entity.name.tag",
                "meta.import variable.other.readwrite.alias",
                "meta.definition.variable",
                "meta.definition.variable variable.other.constant",
                "variable.other.property",
                "variable.object.property",
                "variable.parameter",
                "meta.selector entity.other.attribute-name",
                "meta.selector entity.name.tag"
            ],
            "settings": { "foreground": "#0033b3", "fontStyle": "" }
        },
        {
            "scope": [
                "variable.other.constant.property",
                "variable.other.enummember",
                "support.variable.property"
            ],
            "settings": { "foreground": "#0033b3", "fontStyle": "italic" }
        },
        {
            "scope": [
                "constant.character.escape",
                "constant.other.character-class.regexp",
                "keyword.control.anchor.regexp",
                "constant.other.color",
                "support.constant.color",
                "meta.template.expression",
                "expression.embedded.vue",
                "constant.character.entity",
                "constant.character.entity punctuation.definition.entity",
                "variable.parameter.url"
            ],
            "settings": { "foreground": "#ac8700", "fontStyle": "" }
        },
        {
            "scope": [
                "keyword.operator.new",
                "variable.language.this",
                "variable.language.super",
                "keyword.operator.expression",
                "entity.other.attribute-name",
                "keyword.operator.quantifier.regexp",
                "entity.other.attribute-name.css"
            ],
            "settings": { "foreground": "#c96520", "fontStyle": "" }
        },
        {
            "scope": ["variable.argument.css", "variable.css"],
            "settings": { "foreground": "#c96520", "fontStyle": "italic" }
        },
        {
            "scope": [
                "punctuation.definition.tag.begin",
                "punctuation.definition.tag.end"
            ],
            "settings": { "foreground": "#5F5F5F", "fontStyle": "" }
        },
        {
            "scope": [
                "keyword.other.unit",
                "punctuation.definition.group.regexp",
                "meta.group.regexp",
                "keyword.operator.or.regexp"
            ],
            "settings": { "foreground": "#077aab", "fontStyle": "" }
        },
        {
            "scope": [
                "entity.name.type.instance.jsdoc",
                "support.constant.property-value",
                "support.constant.font-name.css"
            ],
            "settings": { "foreground": "#007d19", "fontStyle": "" }
        },
        {
            "scope": [
                "constant.language",
                "constant.language.null",
                "constant.language.boolean.true",
                "constant.language.boolean.false",
                "entity.other.attribute-name.pseudo-class",
                "entity.other.attribute-name.pseudo-element",
