    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#8B949E", "fontStyle": "italic" }
        },
        {
            "name": "Keywords",
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#58A6FF" }
        },
        {
            "name": "Control Keywords",
            "scope": [
                "keyword.control",
                "keyword.control.conditional",
                "keyword.control.loop",
                "keyword.control.flow"
            ],
            "settings": { "foreground": "#58A6FF", "fontStyle": "bold" }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call"
            ],
            "settings": { "foreground": "#D2A8FF" }
        },
        {
            "name": "Methods",
            "scope": ["meta.method", "meta.method-call", "entity.name.method"],
            "settings": { "foreground": "#D2A8FF" }
        },
        {
            "name": "Classes",
            "scope": [
                "entity.name.class",
                "entity.name.type.class",
                "support.class"
            ],
            "settings": { "foreground": "#FFA657" }
        },
        {
            "name": "Types",
            "scope": ["entity.name.type", "support.type", "storage.type"],
            "settings": { "foreground": "#FFA657" }
        },
        {
            "name": "Interfaces",
            "scope": ["entity.name.interface", "entity.name.type.interface"],
            "settings": { "foreground": "#FFA657" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "variable.other", "variable.other.readwrite"],
            "settings": { "foreground": "#79C0FF" }
        },
        {
            "name": "Constants",
            "scope": [
                "variable.other.constant",
                "constant",
                "constant.language",
                "constant.numeric"
            ],
            "settings": { "foreground": "#FFD580" }
        },
        {
            "name": "Strings",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#7EE787" }
        },
        {
            "name": "Numbers",
            "scope": [
                "constant.numeric",
                "constant.numeric.integer",
                "constant.numeric.float"
            ],
            "settings": { "foreground": "#FF7B72" }
        },
        {
            "name": "Booleans",
            "scope": [
                "constant.language.boolean",
                "constant.language.true",
                "constant.language.false"
            ],
            "settings": { "foreground": "#FF7B72", "fontStyle": "bold" }
        },
        {
            "name": "Null/Undefined",
            "scope": [
                "constant.language.null",
                "constant.language.undefined",
                "constant.language.nan"
            ],
            "settings": { "foreground": "#FF7B72", "fontStyle": "italic" }
        },
        {
            "name": "Properties",
            "scope": [
                "variable.other.property",
                "meta.property-name",
                "support.variable.property"
            ],
            "settings": { "foreground": "#79C0FF" }
        },
        {
            "name": "Operators",
            "scope": [
                "keyword.operator",
                "punctuation.separator.key-value",
                "punctuation.accessor"
            ],
            "settings": { "foreground": "#58A6FF" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation",
                "punctuation.definition",
                "punctuation.separator",
                "punctuation.terminator"
            ],
            "settings": { "foreground": "#C9D1D9" }
        },
        {
            "name": "Tags",
            "scope": [
                "entity.name.tag",
                "meta.tag",
                "punctuation.definition.tag"
            ],
            "settings": { "foreground": "#58A6FF" }
        },
        {
            "name": "Attributes",
            "scope": ["entity.other.attribute-name", "meta.attribute-name"],
            "settings": { "foreground": "#79C0FF" }
        },
        {
            "name": "Attribute Values",
            "scope": ["string.quoted.double", "string.quoted.single"],
            "settings": { "foreground": "#7EE787" }
        },
        {
            "name": "Decorators",
            "scope": ["meta.decorator", "entity.name.decorator"],
            "settings": { "foreground": "#D2A8FF" }
        },
        {
            "name": "Parameters",
            "scope": ["variable.parameter", "variable.parameter.function"],
            "settings": { "foreground": "#79C0FF" }
        },
        {
            "name": "Labels",
            "scope": ["entity.name.label"],
            "settings": { "foreground": "#FFA657" }
        },
        {
            "name": "Namespaces",
            "scope": ["entity.name.namespace", "support.namespace"],
            "settings": { "foreground": "#FFA657" }
        },
        {
            "name": "Enums",
            "scope": ["entity.name.enum", "entity.name.type.enum"],
            "settings": { "foreground": "#FFA657" }
        },
        {
            "name": "Enum Members",
            "scope": ["variable.other.enummember", "constant.other.enum"],
            "settings": { "foreground": "#79C0FF" }
        },
        {
            "name": "Constructors",
            "scope": [
                "entity.name.function.constructor",
                "support.function.constructor"
            ],
            "settings": { "foreground": "#D2A8FF" }
        },
        {
            "name": "Modules",
            "scope": ["entity.name.module", "support.module"],
            "settings": { "foreground": "#58A6FF" }
        },
        {
            "name": "Regular Expressions",
            "scope": ["string.regexp"],
            "settings": { "foreground": "#D2A8FF" }
        },
        {
            "name": "Escape Sequences",
            "scope": ["constant.character.escape"],
            "settings": { "foreground": "#FFD580" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#FF7B72", "fontStyle": "underline" }
        },
        {
            "name": "Deprecated",
            "scope": ["invalid.deprecated"],
            "settings": {
                "foreground": "#8B949E",
                "fontStyle": "strikethrough"
            }
        },
        {
            "name": "Markdown Headings",
            "scope": [
                "markup.heading",
                "markup.heading entity.name",
                "markup.heading.markdown"
            ],
            "settings": { "foreground": "#58A6FF", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Bold",
            "scope": ["markup.bold", "punctuation.definition.bold"],
            "settings": { "foreground": "#C9D1D9", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Italic",
            "scope": ["markup.italic", "punctuation.definition.italic"],
            "settings": { "foreground": "#C9D1D9", "fontStyle": "italic" }
        },
        {
            "name": "Markdown Links",
            "scope": ["markup.underline.link", "string.other.link"],
            "settings": { "foreground": "#58A6FF", "fontStyle": "underline" }
        },
        {
            "name": "Markdown Code",
            "scope": ["markup.raw", "markup.raw.block"],
            "settings": { "foreground": "#7EE787" }
        },
        {
            "name": "Markdown Lists",
            "scope": ["markup.list", "punctuation.definition.list"],
            "settings": { "foreground": "#FFA657" }
        },
        {
            "name": "Markdown Quotes",
            "scope": ["markup.quote"],
            "settings": { "foreground": "#8B949E", "fontStyle": "italic" }
        },
        {
            "name": "CSS Selectors",
            "scope": [
                "entity.other.attribute-name.class",
                "entity.other.attribute-name.id",
                "entity.other.attribute-name.tag"
            ],
            "settings": { "foreground": "#58A6FF" }
        },
        {
            "name": "CSS Properties",
            "scope": ["support.type.property-name", "support.property-name"],
            "settings": { "foreground": "#79C0FF" }
        },
        {
            "name": "CSS Values",
            "scope": [
                "support.constant.property-value",
                "constant.other.color"
            ],
            "settings": { "foreground": "#7EE787" }
        },
        {
            "name": "JSON Keys",
            "scope": ["support.type.property-name.json", "meta.key.json"],
            "settings": { "foreground": "#79C0FF" }
        },
        {
            "name": "JSON String Values",
            "scope": ["meta.value.json string.quoted.double.json"],
            "settings": { "foreground": "#7EE787" }
        },
        {
            "name": "YAML Keys",
            "scope": ["entity.name.tag.yaml"],
            "settings": { "foreground": "#79C0FF" }
        },
        {
            "name": "YAML Values",
            "scope": ["string.unquoted.yaml"],
            "settings": { "foreground": "#7EE787" }
        },
        {
            "name": "Python Functions",
            "scope": ["support.function.python", "entity.name.function.python"],
            "settings": { "foreground": "#D2A8FF" }
        },
        {
            "name": "Python Decorators",
            "scope": ["meta.decorator.python", "entity.name.decorator.python"],
            "settings": { "foreground": "#D2A8FF" }
        },
        {
            "name": "Python Self",
            "scope": [
                "variable.language.self.python",
                "variable.language.cls.python"
            ],
            "settings": { "foreground": "#FFA657" }
        },
        {
            "name": "JavaScript/TypeScript Keywords",
            "scope": [
                "storage.type.js",
                "storage.type.ts",
                "keyword.control.flow.js",
                "keyword.control.flow.ts"
            ],
            "settings": { "foreground": "#58A6FF" }
        },
        {
            "name": "JavaScript/TypeScript Arrow Functions",
            "scope": [
                "storage.type.function.arrow.js",
                "storage.type.function.arrow.ts"
            ],
            "settings": { "foreground": "#58A6FF" }
        },
        {
            "name": "JavaScript/TypeScript Template Strings",
            "scope": ["string.template.js", "string.template.ts"],
            "settings": { "foreground": "#7EE787" }
        },
        {
            "name": "JavaScript/TypeScript JSX Tags",
            "scope": [
                "entity.name.tag.js",
                "entity.name.tag.tsx",
                "support.class.component.js",
                "support.class.component.tsx"
            ],
            "settings": { "foreground": "#58A6FF" }
        },
        {
            "name": "Java Annotations",
            "scope": ["storage.type.annotation.java", "meta.annotation.java"],
            "settings": { "foreground": "#D2A8FF" }
        },
        {
            "name": "Go Functions",
            "scope": ["entity.name.function.go", "support.function.go"],
            "settings": { "foreground": "#D2A8FF" }
        },
        {
            "name": "Rust Macros",
            "scope": ["entity.name.function.macro.rust", "meta.macro.rust"],
            "settings": { "foreground": "#D2A8FF" }
        },
        {
            "name": "Rust Lifetime",
            "scope": [
                "storage.modifier.lifetime.rust",
                "entity.name.lifetime.rust"
            ],
            "settings": { "foreground": "#FFA657" }
        },
        {
            "name": "Shell Commands",
            "scope": [
                "entity.name.function.shell",
                "support.function.builtin.shell"
            ],
            "settings": { "foreground": "#D2A8FF" }
        },
        {
            "name": "Shell Variables",
            "scope": ["variable.other.shell", "variable.other.readwrite.shell"],
            "settings": { "foreground": "#79C0FF" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
