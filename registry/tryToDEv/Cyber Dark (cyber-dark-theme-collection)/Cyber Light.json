    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#6E7781", "fontStyle": "italic" }
        },
        {
            "name": "Keywords",
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#CF222E" }
        },
        {
            "name": "Control Keywords",
            "scope": [
                "keyword.control",
                "keyword.control.conditional",
                "keyword.control.loop",
                "keyword.control.flow"
            ],
            "settings": { "foreground": "#CF222E", "fontStyle": "bold" }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call"
            ],
            "settings": { "foreground": "#8250DF" }
        },
        {
            "name": "Methods",
            "scope": ["meta.method", "meta.method-call", "entity.name.method"],
            "settings": { "foreground": "#8250DF" }
        },
        {
            "name": "Classes",
            "scope": [
                "entity.name.class",
                "entity.name.type.class",
                "support.class"
            ],
            "settings": { "foreground": "#D29922" }
        },
        {
            "name": "Types",
            "scope": ["entity.name.type", "support.type", "storage.type"],
            "settings": { "foreground": "#D29922" }
        },
        {
            "name": "Interfaces",
            "scope": ["entity.name.interface", "entity.name.type.interface"],
            "settings": { "foreground": "#D29922" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "variable.other", "variable.other.readwrite"],
            "settings": { "foreground": "#1F6FEB" }
        },
        {
            "name": "Constants",
            "scope": [
                "variable.other.constant",
                "constant",
                "constant.language",
                "constant.numeric"
            ],
            "settings": { "foreground": "#D29922" }
        },
        {
            "name": "Strings",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#1A7F37" }
        },
        {
            "name": "Numbers",
            "scope": [
                "constant.numeric",
                "constant.numeric.integer",
                "constant.numeric.float"
            ],
            "settings": { "foreground": "#CF222E" }
        },
        {
            "name": "Booleans",
            "scope": [
                "constant.language.boolean",
                "constant.language.true",
                "constant.language.false"
            ],
            "settings": { "foreground": "#CF222E", "fontStyle": "bold" }
        },
        {
            "name": "Null/Undefined",
            "scope": [
                "constant.language.null",
                "constant.language.undefined",
                "constant.language.nan"
            ],
            "settings": { "foreground": "#CF222E", "fontStyle": "italic" }
        },
        {
            "name": "Properties",
            "scope": [
                "variable.other.property",
                "meta.property-name",
                "support.variable.property"
            ],
            "settings": { "foreground": "#1F6FEB" }
        },
        {
            "name": "Operators",
            "scope": [
                "keyword.operator",
                "punctuation.separator.key-value",
                "punctuation.accessor"
            ],
            "settings": { "foreground": "#0969DA" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation",
                "punctuation.definition",
                "punctuation.separator",
                "punctuation.terminator"
            ],
            "settings": { "foreground": "#24292F" }
        },
        {
            "name": "Tags",
            "scope": [
                "entity.name.tag",
                "meta.tag",
                "punctuation.definition.tag"
            ],
            "settings": { "foreground": "#0969DA" }
        },
        {
            "name": "Attributes",
            "scope": ["entity.other.attribute-name", "meta.attribute-name"],
            "settings": { "foreground": "#1F6FEB" }
        },
        {
            "name": "Attribute Values",
            "scope": ["string.quoted.double", "string.quoted.single"],
            "settings": { "foreground": "#1A7F37" }
        },
        {
            "name": "Decorators",
            "scope": ["meta.decorator", "entity.name.decorator"],
            "settings": { "foreground": "#8250DF" }
        },
        {
            "name": "Parameters",
            "scope": ["variable.parameter", "variable.parameter.function"],
            "settings": { "foreground": "#1F6FEB" }
        },
        {
            "name": "Labels",
            "scope": ["entity.name.label"],
            "settings": { "foreground": "#D29922" }
        },
        {
            "name": "Namespaces",
            "scope": ["entity.name.namespace", "support.namespace"],
            "settings": { "foreground": "#D29922" }
        },
        {
            "name": "Enums",
            "scope": ["entity.name.enum", "entity.name.type.enum"],
            "settings": { "foreground": "#D29922" }
        },
        {
            "name": "Enum Members",
            "scope": ["variable.other.enummember", "constant.other.enum"],
            "settings": { "foreground": "#1F6FEB" }
        },
        {
            "name": "Constructors",
            "scope": [
                "entity.name.function.constructor",
                "support.function.constructor"
            ],
            "settings": { "foreground": "#8250DF" }
        },
        {
            "name": "Modules",
            "scope": ["entity.name.module", "support.module"],
            "settings": { "foreground": "#0969DA" }
        },
        {
            "name": "Regular Expressions",
            "scope": ["string.regexp"],
            "settings": { "foreground": "#8250DF" }
        },
        {
            "name": "Escape Sequences",
            "scope": ["constant.character.escape"],
            "settings": { "foreground": "#D29922" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#CF222E", "fontStyle": "underline" }
        },
        {
            "name": "Deprecated",
            "scope": ["invalid.deprecated"],
            "settings": {
                "foreground": "#6E7781",
                "fontStyle": "strikethrough"
            }
        },
        {
            "name": "Markdown Headings",
            "scope": [
                "markup.heading",
                "markup.heading entity.name",
                "markup.heading.markdown"
            ],
            "settings": { "foreground": "#0969DA", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Bold",
            "scope": ["markup.bold", "punctuation.definition.bold"],
            "settings": { "foreground": "#24292F", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Italic",
            "scope": ["markup.italic", "punctuation.definition.italic"],
            "settings": { "foreground": "#24292F", "fontStyle": "italic" }
        },
        {
            "name": "Markdown Links",
            "scope": ["markup.underline.link", "string.other.link"],
            "settings": { "foreground": "#0969DA", "fontStyle": "underline" }
        },
        {
            "name": "Markdown Code",
            "scope": ["markup.raw", "markup.raw.block"],
            "settings": { "foreground": "#1A7F37" }
        },
        {
            "name": "Markdown Lists",
            "scope": ["markup.list", "punctuation.definition.list"],
            "settings": { "foreground": "#D29922" }
        },
        {
            "name": "Markdown Quotes",
            "scope": ["markup.quote"],
            "settings": { "foreground": "#6E7781", "fontStyle": "italic" }
        },
        {
            "name": "CSS Selectors",
            "scope": [
                "entity.other.attribute-name.class",
                "entity.other.attribute-name.id",
                "entity.other.attribute-name.tag"
            ],
            "settings": { "foreground": "#0969DA" }
        },
        {
            "name": "CSS Properties",
            "scope": ["support.type.property-name", "support.property-name"],
            "settings": { "foreground": "#1F6FEB" }
        },
        {
            "name": "CSS Values",
            "scope": [
                "support.constant.property-value",
                "constant.other.color"
            ],
            "settings": { "foreground": "#1A7F37" }
        },
        {
            "name": "JSON Keys",
            "scope": ["support.type.property-name.json", "meta.key.json"],
            "settings": { "foreground": "#1F6FEB" }
        },
        {
            "name": "JSON String Values",
            "scope": ["meta.value.json string.quoted.double.json"],
            "settings": { "foreground": "#1A7F37" }
        },
        {
            "name": "YAML Keys",
            "scope": ["entity.name.tag.yaml"],
            "settings": { "foreground": "#1F6FEB" }
        },
        {
            "name": "YAML Values",
            "scope": ["string.unquoted.yaml"],
            "settings": { "foreground": "#1A7F37" }
        },
        {
            "name": "Python Functions",
            "scope": ["support.function.python", "entity.name.function.python"],
            "settings": { "foreground": "#8250DF" }
        },
        {
            "name": "Python Decorators",
            "scope": ["meta.decorator.python", "entity.name.decorator.python"],
            "settings": { "foreground": "#8250DF" }
        },
        {
            "name": "Python Self",
            "scope": [
                "variable.language.self.python",
                "variable.language.cls.python"
            ],
            "settings": { "foreground": "#D29922" }
        },
        {
            "name": "JavaScript/TypeScript Keywords",
            "scope": [
                "storage.type.js",
                "storage.type.ts",
                "keyword.control.flow.js",
                "keyword.control.flow.ts"
            ],
            "settings": { "foreground": "#CF222E" }
        },
        {
            "name": "JavaScript/TypeScript Arrow Functions",
            "scope": [
                "storage.type.function.arrow.js",
                "storage.type.function.arrow.ts"
            ],
            "settings": { "foreground": "#0969DA" }
        },
        {
            "name": "JavaScript/TypeScript Template Strings",
            "scope": ["string.template.js", "string.template.ts"],
            "settings": { "foreground": "#1A7F37" }
        },
        {
            "name": "JavaScript/TypeScript JSX Tags",
            "scope": [
                "entity.name.tag.js",
                "entity.name.tag.tsx",
                "support.class.component.js",
                "support.class.component.tsx"
            ],
            "settings": { "foreground": "#0969DA" }
        },
        {
            "name": "Java Annotations",
            "scope": ["storage.type.annotation.java", "meta.annotation.java"],
            "settings": { "foreground": "#8250DF" }
        },
        {
            "name": "Go Functions",
            "scope": ["entity.name.function.go", "support.function.go"],
            "settings": { "foreground": "#8250DF" }
        },
        {
            "name": "Rust Macros",
            "scope": ["entity.name.function.macro.rust", "meta.macro.rust"],
            "settings": { "foreground": "#8250DF" }
        },
        {
            "name": "Rust Lifetime",
            "scope": [
                "storage.modifier.lifetime.rust",
                "entity.name.lifetime.rust"
            ],
            "settings": { "foreground": "#D29922" }
        },
        {
            "name": "Shell Commands",
            "scope": [
                "entity.name.function.shell",
                "support.function.builtin.shell"
            ],
            "settings": { "foreground": "#8250DF" }
        },
        {
            "name": "Shell Variables",
            "scope": ["variable.other.shell", "variable.other.readwrite.shell"],
            "settings": { "foreground": "#1F6FEB" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
