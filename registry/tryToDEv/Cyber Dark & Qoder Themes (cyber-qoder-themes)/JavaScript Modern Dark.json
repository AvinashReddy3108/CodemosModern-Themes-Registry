    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#64748B", "fontStyle": "italic" }
        },
        {
            "name": "Keywords",
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#60A5FA" }
        },
        {
            "name": "Control Keywords",
            "scope": [
                "keyword.control",
                "keyword.control.conditional",
                "keyword.control.loop",
                "keyword.control.flow"
            ],
            "settings": { "foreground": "#60A5FA", "fontStyle": "bold" }
        },
        {
            "name": "JavaScript Control Flow Keywords",
            "scope": [
                "keyword.control.flow.js",
                "keyword.control.flow.ts",
                "keyword.control.conditional.js",
                "keyword.control.conditional.ts",
                "keyword.control.loop.js",
                "keyword.control.loop.ts"
            ],
            "settings": { "foreground": "#60A5FA", "fontStyle": "bold" }
        },
        {
            "name": "JavaScript Async/Await",
            "scope": [
                "keyword.control.async.js",
                "keyword.control.async.ts",
                "storage.modifier.async.js",
                "storage.modifier.async.ts"
            ],
            "settings": { "foreground": "#60A5FA", "fontStyle": "bold" }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call"
            ],
            "settings": { "foreground": "#A78BFA" }
        },
        {
            "name": "Methods",
            "scope": ["meta.method", "meta.method-call", "entity.name.method"],
            "settings": { "foreground": "#A78BFA" }
        },
        {
            "name": "JavaScript Arrow Functions",
            "scope": [
                "storage.type.function.arrow.js",
                "storage.type.function.arrow.ts",
                "keyword.operator.arrow.js",
                "keyword.operator.arrow.ts"
            ],
            "settings": { "foreground": "#A78BFA" }
        },
        {
            "name": "Classes",
            "scope": [
                "entity.name.class",
                "entity.name.type.class",
                "support.class",
                "storage.type.class.js",
                "storage.type.class.ts"
            ],
            "settings": { "foreground": "#F87171" }
        },
        {
            "name": "Types",
            "scope": ["entity.name.type", "support.type", "storage.type"],
            "settings": { "foreground": "#F87171" }
        },
        {
            "name": "Interfaces",
            "scope": ["entity.name.interface", "entity.name.type.interface"],
            "settings": { "foreground": "#F87171" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "variable.other", "variable.other.readwrite"],
            "settings": { "foreground": "#38BDF8" }
        },
        {
            "name": "JavaScript This/Super",
            "scope": [
                "variable.language.this.js",
                "variable.language.this.ts",
                "variable.language.super.js",
                "variable.language.super.ts"
            ],
            "settings": { "foreground": "#FBBF24", "fontStyle": "bold" }
        },
        {
            "name": "Constants",
            "scope": [
                "variable.other.constant",
                "constant",
                "constant.language",
                "constant.numeric"
            ],
            "settings": { "foreground": "#FBBF24" }
        },
        {
            "name": "Strings",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#34D399" }
        },
        {
            "name": "JavaScript Template Strings",
            "scope": ["string.template.js", "string.template.ts"],
            "settings": { "foreground": "#34D399" }
        },
        {
            "name": "Numbers",
            "scope": [
                "constant.numeric",
                "constant.numeric.integer",
                "constant.numeric.float"
