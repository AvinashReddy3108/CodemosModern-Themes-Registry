            "scope": ["entity.name.function.macro.rust", "meta.macro.rust"],
            "settings": { "foreground": "#A78BFA" }
        },
        {
            "name": "Rust Lifetime",
            "scope": [
                "storage.modifier.lifetime.rust",
                "entity.name.lifetime.rust"
            ],
            "settings": { "foreground": "#FBBF24" }
        },
        {
            "name": "Shell Commands",
            "scope": [
                "entity.name.function.shell",
                "support.function.builtin.shell"
            ],
            "settings": { "foreground": "#A78BFA", "fontStyle": "bold" }
        },
        {
            "name": "Shell Variables",
            "scope": ["variable.other.shell", "variable.other.readwrite.shell"],
            "settings": { "foreground": "#38BDF8" }
        },
        {
            "name": "Shell Strings",
            "scope": ["string.quoted.shell", "string.unquoted.shell"],
            "settings": { "foreground": "#34D399" }
        },
        {
            "name": "Shell Parameters",
            "scope": ["variable.parameter.shell"],
            "settings": { "foreground": "#FBBF24" }
        },
        {
            "name": "Terminal Output Success",
            "scope": ["markup.inserted.shell", "string.success.shell"],
            "settings": { "foreground": "#34D399", "fontStyle": "bold" }
        },
        {
            "name": "Terminal Output Warning",
            "scope": ["markup.changed.shell", "string.warning.shell"],
            "settings": { "foreground": "#FBBF24", "fontStyle": "bold" }
        },
        {
            "name": "Terminal Output Error",
            "scope": ["markup.deleted.shell", "string.error.shell"],
            "settings": { "foreground": "#FB923C", "fontStyle": "bold" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
