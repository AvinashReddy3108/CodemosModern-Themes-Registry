    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#7A7A99", "fontStyle": "italic" }
        },
        {
            "name": "Keywords",
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#8A6CFF" }
        },
        {
            "name": "Control Keywords",
            "scope": [
                "keyword.control",
                "keyword.control.conditional",
                "keyword.control.loop",
                "keyword.control.flow"
            ],
            "settings": { "foreground": "#8A6CFF", "fontStyle": "bold" }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call"
            ],
            "settings": { "foreground": "#BD93F9" }
        },
        {
            "name": "Methods",
            "scope": ["meta.method", "meta.method-call", "entity.name.method"],
            "settings": { "foreground": "#BD93F9" }
        },
        {
            "name": "Classes",
            "scope": [
                "entity.name.class",
                "entity.name.type.class",
                "support.class"
            ],
            "settings": { "foreground": "#FFB86C" }
        },
        {
            "name": "Types",
            "scope": ["entity.name.type", "support.type", "storage.type"],
            "settings": { "foreground": "#FFB86C" }
        },
        {
            "name": "Interfaces",
            "scope": ["entity.name.interface", "entity.name.type.interface"],
            "settings": { "foreground": "#FFB86C" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "variable.other", "variable.other.readwrite"],
            "settings": { "foreground": "#8BE9FD" }
        },
        {
            "name": "Constants",
            "scope": [
                "variable.other.constant",
                "constant",
                "constant.language",
                "constant.numeric"
            ],
            "settings": { "foreground": "#FFCB8B" }
        },
        {
            "name": "Strings",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#50FA7B" }
        },
        {
            "name": "Numbers",
            "scope": [
                "constant.numeric",
                "constant.numeric.integer",
                "constant.numeric.float"
            ],
            "settings": { "foreground": "#FF5555" }
        },
        {
            "name": "Booleans",
            "scope": [
                "constant.language.boolean",
                "constant.language.true",
                "constant.language.false"
            ],
            "settings": { "foreground": "#FF5555", "fontStyle": "bold" }
        },
        {
            "name": "Null/Undefined",
            "scope": [
                "constant.language.null",
                "constant.language.undefined",
                "constant.language.nan"
            ],
            "settings": { "foreground": "#FF5555", "fontStyle": "italic" }
        },
        {
            "name": "Properties",
            "scope": [
                "variable.other.property",
                "meta.property-name",
                "support.variable.property"
            ],
            "settings": { "foreground": "#8BE9FD" }
        },
        {
            "name": "Operators",
            "scope": [
                "keyword.operator",
                "punctuation.separator.key-value",
                "punctuation.accessor"
            ],
            "settings": { "foreground": "#8A6CFF" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation",
                "punctuation.definition",
                "punctuation.separator",
                "punctuation.terminator"
            ],
            "settings": { "foreground": "#E6E6F0" }
        },
        {
            "name": "Tags",
            "scope": [
                "entity.name.tag",
                "meta.tag",
                "punctuation.definition.tag"
            ],
            "settings": { "foreground": "#8A6CFF" }
        },
        {
            "name": "Attributes",
            "scope": ["entity.other.attribute-name", "meta.attribute-name"],
            "settings": { "foreground": "#8BE9FD" }
        },
        {
            "name": "Attribute Values",
            "scope": ["string.quoted.double", "string.quoted.single"],
            "settings": { "foreground": "#50FA7B" }
        },
        {
            "name": "Decorators",
            "scope": ["meta.decorator", "entity.name.decorator"],
            "settings": { "foreground": "#BD93F9" }
        },
        {
            "name": "Parameters",
            "scope": ["variable.parameter", "variable.parameter.function"],
            "settings": { "foreground": "#8BE9FD" }
        },
        {
            "name": "Labels",
            "scope": ["entity.name.label"],
            "settings": { "foreground": "#FFB86C" }
        },
        {
            "name": "Namespaces",
            "scope": ["entity.name.namespace", "support.namespace"],
            "settings": { "foreground": "#FFB86C" }
        },
        {
            "name": "Enums",
            "scope": ["entity.name.enum", "entity.name.type.enum"],
            "settings": { "foreground": "#FFB86C" }
        },
        {
            "name": "Enum Members",
            "scope": ["variable.other.enummember", "constant.other.enum"],
            "settings": { "foreground": "#8BE9FD" }
        },
        {
            "name": "Constructors",
            "scope": [
                "entity.name.function.constructor",
                "support.function.constructor"
            ],
            "settings": { "foreground": "#BD93F9" }
        },
        {
            "name": "Modules",
            "scope": ["entity.name.module", "support.module"],
            "settings": { "foreground": "#8A6CFF" }
        },
        {
            "name": "Regular Expressions",
            "scope": ["string.regexp"],
            "settings": { "foreground": "#BD93F9" }
        },
        {
            "name": "Escape Sequences",
            "scope": ["constant.character.escape"],
            "settings": { "foreground": "#FFCB8B" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#FF5555", "fontStyle": "underline" }
        },
        {
            "name": "Deprecated",
            "scope": ["invalid.deprecated"],
            "settings": {
                "foreground": "#7A7A99",
                "fontStyle": "strikethrough"
            }
        },
        {
            "name": "Markdown Headings",
            "scope": [
                "markup.heading",
                "markup.heading entity.name",
                "markup.heading.markdown"
            ],
            "settings": { "foreground": "#8A6CFF", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Bold",
            "scope": ["markup.bold", "punctuation.definition.bold"],
            "settings": { "foreground": "#E6E6F0", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Italic",
            "scope": ["markup.italic", "punctuation.definition.italic"],
            "settings": { "foreground": "#E6E6F0", "fontStyle": "italic" }
        },
        {
            "name": "Markdown Links",
            "scope": ["markup.underline.link", "string.other.link"],
            "settings": { "foreground": "#8A6CFF", "fontStyle": "underline" }
        },
        {
            "name": "Markdown Code",
            "scope": ["markup.raw", "markup.raw.block"],
            "settings": { "foreground": "#50FA7B" }
        },
        {
            "name": "Markdown Lists",
            "scope": ["markup.list", "punctuation.definition.list"],
            "settings": { "foreground": "#FFB86C" }
        },
        {
            "name": "Markdown Quotes",
            "scope": ["markup.quote"],
            "settings": { "foreground": "#7A7A99", "fontStyle": "italic" }
        },
        {
            "name": "CSS Selectors",
            "scope": [
                "entity.other.attribute-name.class",
                "entity.other.attribute-name.id",
                "entity.other.attribute-name.tag"
            ],
            "settings": { "foreground": "#8A6CFF" }
        },
        {
            "name": "CSS Properties",
            "scope": ["support.type.property-name", "support.property-name"],
            "settings": { "foreground": "#8BE9FD" }
        },
        {
            "name": "CSS Values",
            "scope": [
                "support.constant.property-value",
                "constant.other.color"
            ],
            "settings": { "foreground": "#50FA7B" }
        },
        {
            "name": "JSON Keys",
            "scope": ["support.type.property-name.json", "meta.key.json"],
            "settings": { "foreground": "#8BE9FD" }
        },
        {
            "name": "JSON String Values",
            "scope": ["meta.value.json string.quoted.double.json"],
            "settings": { "foreground": "#50FA7B" }
        },
        {
            "name": "YAML Keys",
            "scope": ["entity.name.tag.yaml"],
            "settings": { "foreground": "#8BE9FD" }
        },
        {
            "name": "YAML Values",
            "scope": ["string.unquoted.yaml"],
            "settings": { "foreground": "#50FA7B" }
        },
        {
            "name": "Python Functions",
