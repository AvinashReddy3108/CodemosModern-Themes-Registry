    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#6B7280", "fontStyle": "italic" }
        },
        {
            "name": "Keywords",
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#00F0FF" }
        },
        {
            "name": "Control Keywords",
            "scope": [
                "keyword.control",
                "keyword.control.conditional",
                "keyword.control.loop",
                "keyword.control.flow"
            ],
            "settings": { "foreground": "#00F0FF", "fontStyle": "bold" }
        },
        {
            "name": "JavaScript Control Flow Keywords",
            "scope": [
                "keyword.control.flow.js",
                "keyword.control.flow.ts",
                "keyword.control.conditional.js",
                "keyword.control.conditional.ts",
                "keyword.control.loop.js",
                "keyword.control.loop.ts"
            ],
            "settings": { "foreground": "#00F0FF", "fontStyle": "bold" }
        },
        {
            "name": "JavaScript Async/Await",
            "scope": [
                "keyword.control.async.js",
                "keyword.control.async.ts",
                "storage.modifier.async.js",
                "storage.modifier.async.ts"
            ],
            "settings": { "foreground": "#00F0FF", "fontStyle": "bold" }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call"
            ],
            "settings": { "foreground": "#FF00FF" }
        },
        {
            "name": "Methods",
            "scope": ["meta.method", "meta.method-call", "entity.name.method"],
            "settings": { "foreground": "#FF00FF" }
        },
        {
            "name": "JavaScript Arrow Functions",
            "scope": [
                "storage.type.function.arrow.js",
                "storage.type.function.arrow.ts",
                "keyword.operator.arrow.js",
                "keyword.operator.arrow.ts"
            ],
            "settings": { "foreground": "#FF00FF" }
        },
        {
            "name": "Classes",
            "scope": [
                "entity.name.class",
                "entity.name.type.class",
                "support.class",
                "storage.type.class.js",
                "storage.type.class.ts"
            ],
            "settings": { "foreground": "#A855F7" }
        },
        {
            "name": "Types",
            "scope": ["entity.name.type", "support.type", "storage.type"],
            "settings": { "foreground": "#A855F7" }
        },
        {
            "name": "Interfaces",
            "scope": ["entity.name.interface", "entity.name.type.interface"],
            "settings": { "foreground": "#A855F7" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "variable.other", "variable.other.readwrite"],
            "settings": { "foreground": "#3B82F6" }
        },
        {
            "name": "JavaScript This/Super",
            "scope": [
                "variable.language.this.js",
                "variable.language.this.ts",
                "variable.language.super.js",
                "variable.language.super.ts"
            ],
            "settings": { "foreground": "#FFFF00", "fontStyle": "bold" }
        },
        {
            "name": "Constants",
            "scope": [
                "variable.other.constant",
                "constant",
                "constant.language",
                "constant.numeric"
            ],
            "settings": { "foreground": "#FFFF00" }
        },
        {
            "name": "Strings",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#00FF9D" }
        },
        {
            "name": "JavaScript Template Strings",
            "scope": ["string.template.js", "string.template.ts"],
            "settings": { "foreground": "#00FF9D" }
        },
        {
            "name": "Numbers",
            "scope": [
                "constant.numeric",
                "constant.numeric.integer",
                "constant.numeric.float"
            ],
            "settings": { "foreground": "#FF6B00" }
        },
        {
            "name": "Booleans",
            "scope": [
                "constant.language.boolean",
                "constant.language.true",
                "constant.language.false"
            ],
            "settings": { "foreground": "#FF6B00", "fontStyle": "bold" }
        },
        {
            "name": "Null/Undefined",
            "scope": [
                "constant.language.null",
                "constant.language.undefined",
                "constant.language.nan"
            ],
            "settings": { "foreground": "#FF6B00", "fontStyle": "italic" }
        },
        {
            "name": "Properties",
            "scope": [
                "variable.other.property",
                "meta.property-name",
                "support.variable.property"
            ],
            "settings": { "foreground": "#3B82F6" }
        },
        {
            "name": "Operators",
            "scope": [
