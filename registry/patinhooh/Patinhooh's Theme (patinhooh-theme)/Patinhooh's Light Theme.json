    "tokenColors": [
        { "settings": { "foreground": "#07070f" } },
        {
            "name": "Keyword",
            "scope": "keyword",
            "settings": { "foreground": "#f92672" }
        },
        {
            "name": "Comment",
            "scope": "comment",
            "settings": { "foreground": "#8a8a8e" }
        },
        {
            "name": "String",
            "scope": "string",
            "settings": { "foreground": "#d59946" }
        },
        {
            "name": "Numbers",
            "scope": "constant.numeric",
            "settings": { "foreground": "#6442d4" }
        },
        {
            "name": "Built-in constant",
            "scope": "constant.language, builtinConstant",
            "settings": { "foreground": "#6442d4" }
        },
        {
            "name": "User-defined constant",
            "scope": "constant.character, constant.other",
            "settings": { "foreground": "#6442d4" }
        },
        {
            "name": "Library constant",
            "scope": "support.constant",
            "settings": { "fontStyle": "", "foreground": "#6442d4" }
        },
        {
            "name": "Storage",
            "scope": "storage",
            "settings": { "fontStyle": "", "foreground": "#f92672" }
        },
        {
            "name": "Storage type",
            "scope": "storage.type",
            "settings": { "fontStyle": "italic", "foreground": "#00b4c1" }
        },
        {
            "name": "Namespace name",
            "scope": "entity.name.namespace, entity.name.scope-resolution",
            "settings": { "fontStyle": "", "foreground": "#07070f" }
        },
        {
            "name": "Type/Class name",
            "scope": "entity.name.class, entity.name.type, entity.other.inherited-class",
            "settings": { "fontStyle": "", "foreground": "#27a900" }
        },
        {
            "name": "Library class/type",
            "scope": "support.type, support.class",
            "settings": { "fontStyle": "italic", "foreground": "#27a900" }
        },
        {
            "name": "Function name",
            "scope": "entity.name.function",
            "settings": { "fontStyle": "", "foreground": "#07070f" }
        },
        {
            "name": "Library function",
            "scope": "support.function",
            "settings": { "fontStyle": "", "foreground": "#00b4c1" }
        },
        {
            "name": "Function argument",
            "scope": "variable.parameter",
            "settings": { "foreground": "#07070f" }
        },
        {
            "name": "Template Definition",
            "scope": [
                "punctuation.definition.template-expression",
                "punctuation.section.embedded"
            ],
            "settings": { "foreground": "#f92672" }
        },
        {
            "name": "Tag name",
            "scope": "entity.name.tag",
            "settings": { "fontStyle": "", "foreground": "#f92672" }
        },
        {
            "name": "Tag attribute",
            "scope": "entity.other.attribute-name",
            "settings": { "fontStyle": "", "foreground": "#27a900" }
        },
        {
            "name": "Invalid",
            "scope": "invalid, invalid.deprecated",
            "settings": { "fontStyle": "", "foreground": "#b00b00" }
        },
        {
            "name": "[Python] Self",
            "scope": "variable.parameter.function.language.special.self.python",
            "settings": { "foreground": "#ff6f00" }
        },
        {
            "name": "[Python] Docstring",
            "scope": "string.quoted.docstring.multi.python",
            "settings": { "foreground": "#8a8a8a" }
        },
        {
            "name": "[Python] Decorator Symbol",
            "scope": "punctuation.definition.decorator.python",
            "settings": { "fontStyle": "italic", "foreground": "#27a900" }
        },
        {
            "name": "[JavaScript] Reset js string interpolation expression",
            "scope": ["meta.template.expression"],
            "settings": { "foreground": "#07070f" }
        },
        {
            "name": "[JSON] Porterty",
            "scope": "support.type.property-name.json",
            "settings": { "foreground": "#00b4c1" }
        },
        {
            "name": "[JSON] Value",
            "scope": "meta.structure.dictionary.json string.quoted.double.json",
            "settings": { "foreground": "#07070f" }
        },
        {
            "name": "[Yaml] Value",
            "scope": "string.unquoted.plain.out.yaml",
            "settings": { "foreground": "#07070f" }
        },
        {
            "name": "[TOML] Property",
            "scope": "support.type.property-name.toml",
            "settings": { "foreground": "#00b4c1" }
        },
        {
            "name": "[TOML] Quote",
            "scope": "string.quoted.single.basic.line.toml",
            "settings": { "foreground": "#07070f" }
        },
        {
            "name": "[TOML] Quote Literal",
            "scope": "string.quoted.single.literal.line.toml",
            "settings": { "foreground": "#07070f" }
        },
        {
            "name": "[TOML] Triple Quote",
            "scope": "string.quoted.triple.basic.block.toml",
            "settings": { "foreground": "#07070f" }
        },
        {
            "name": "[TOML] Triple Quote Literal",
            "scope": "string.quoted.triple.literal.block.toml",
            "settings": { "foreground": "#07070f" }
        },
        {
            "name": "[Markup Langs] Inline",
            "scope": "markup.inline.raw",
            "settings": { "fontStyle": "", "foreground": "#07070f" }
        },
        {
            "name": "[Markup Langs] Strike Through",
            "scope": "markup.strikethrough",
            "settings": { "fontStyle": "strikethrough" }
        },
        {
            "name": "[Markup Langs] Punctuation Definition Link",
            "scope": "markup.list.unnumbered, markup.list.numbered",
            "settings": { "foreground": "#07070f" }
        },
        {
            "name": "[Markup Langs] Quote",
            "scope": "markup.quote",
            "settings": { "foreground": "#f92672" }
        },
        {
            "name": "[Markup Langs] Lists",
            "scope": "markup.list",
            "settings": { "foreground": "#d59946" }
        },
        {
            "name": "[Markup Langs] Diff header",
            "scope": "meta.diff, meta.diff.header",
            "settings": { "foreground": "#8a8a8e" }
        },
        {
            "name": "[Markup Langs] Diff deleted",
            "scope": "markup.deleted",
            "settings": { "foreground": "#f92672" }
        },
        {
            "name": "[Markup Langs] Diff inserted",
            "scope": "markup.inserted",
            "settings": { "foreground": "#27a900" }
        },
        {
            "name": "[Markup Langs] Diff Changed",
            "scope": "markup.changed",
            "settings": { "foreground": "#d59946" }
        },
        {
            "name": "[Markdown] Styling",
            "scope": "punctuation.definition.bold.markdown, punctuation.definition.italic.markdown",
            "settings": { "foreground": "#f92672" }
        },
        {
            "name": "[Markdown] Headings Symbol",
            "scope": "punctuation.definition.heading.markdown",
            "settings": { "fontStyle": "bold", "foreground": "#27a900" }
        },
        {
