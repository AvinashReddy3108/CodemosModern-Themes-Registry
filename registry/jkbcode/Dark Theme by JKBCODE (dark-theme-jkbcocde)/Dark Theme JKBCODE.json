{
    "name": "Dark Theme JKBCODE",
    "type": "dark",
    "colors": {
        "editor.background": "#030b1a",
        "editor.foreground": "#ABB2BF",
        "editor.lineHighlightBackground": "#2C2C2C",
        "editor.selectionBackground": "#3E4451",
        "activityBar.background": "#21252B",
        "sideBar.background": "#21252B",
        "statusBar.background": "#000000",
        "titleBar.activeBackground": "#282C34",
        "titleBar.inactiveBackground": "#21252B",
        "titleBar.activeForeground": "#ABB2BF",
        "titleBar.inactiveForeground": "#ABB2BF80"
    },
    "tokenColors": [
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#5C6370", "fontStyle": "italic" }
        },
        { "scope": ["string"], "settings": { "foreground": "#98C379" } },
        {
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator",
                "keyword.other",
                "storage",
                "storage.type",
                "entity.name.tag"
            ],
            "settings": { "foreground": "#C678DD", "fontStyle": "bold italic" }
        },
        {
            "scope": ["entity.name.function"],
            "settings": { "foreground": "#FF7373", "fontStyle": "bold italic" }
        },
        {
            "scope": ["meta.function-call"],
            "settings": { "foreground": "#FF7373", "fontStyle": "bold italic" }
        },
        {
            "scope": ["meta.function-call meta.arguments"],
            "settings": { "foreground": "#FFFF99" }
        },
        {
            "scope": ["support.function.builtin"],
            "settings": { "foreground": "#D2A679", "fontStyle": "bold italic" }
        },
        {
            "scope": ["meta.function.parameters", "variable.parameter"],
            "settings": { "foreground": "#FFFF99" }
        },
        { "scope": ["variable"], "settings": { "foreground": "#FFB6C1" } },
        {
            "scope": ["entity.name.class", "support.class"],
            "settings": { "foreground": "#E5C07B" }
        },
        {
            "scope": ["meta.class.identifier"],
            "settings": { "foreground": "#E5C07B", "fontStyle": "bold" }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.language",
                "variable.other.constant",
                "entity.name.constant",
                "punctuation.section.class.begin.python",
                "meta.class.python",
                "source.python",
                "meta.body.function.definition.cpp",
                "meta.function.definition.cpp",
                "source.cpp"
            ],
            "settings": { "foreground": "#FC4538", "fontStyle": "bold italic" }
        },
        {
            "scope": ["support.type.property-name", "meta.object-literal.key"],
            "settings": { "foreground": "#56B6C2" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
