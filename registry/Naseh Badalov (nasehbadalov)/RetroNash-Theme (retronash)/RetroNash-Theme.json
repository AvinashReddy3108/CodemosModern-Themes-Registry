{
    "name": "RetroNash-Theme",
    "type": "dark",
    "colors": {
        "editor.background": "#2C2C1E",
        "editor.foreground": "#E8DAB2",
        "editorCursor.foreground": "#FFB347",
        "editor.lineHighlightBackground": "#3B3B2C",
        "editor.selectionBackground": "#a87c4da6",
        "editor.inactiveSelectionBackground": "#756e5a45",
        "editorIndentGuide.background1": "#746F4A",
        "editorIndentGuide.activeBackground1": "#B1A877"
    },
    "tokenColors": [
        {
            "scope": ["keyword", "storage", "import"],
            "settings": { "foreground": "#E07B39" }
        },
        {
            "scope": ["string", "constant.language"],
            "settings": { "foreground": "#C8B07A" }
        },
        {
            "scope": ["variable", "parameter", "function"],
            "settings": { "foreground": "#8ABF91" }
        },
        {
            "scope": ["entity.name.function", "support.type.property-name"],
            "settings": { "foreground": "#5B8DB1" }
        },
        {
            "scope": ["storage.type", "support.type", "constant"],
            "settings": { "foreground": "#D9A066" }
        },
        {
            "scope": ["punctuation", "meta.brace", "meta.delimiter"],
            "settings": { "foreground": "#A68E6B" }
        },
        {
            "scope": ["comment"],
            "settings": { "foreground": "#7C6A5C", "fontStyle": "italic" }
        },
        {
            "scope": ["entity.name.tag", "markup.bold"],
            "settings": { "foreground": "#D87B73" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
