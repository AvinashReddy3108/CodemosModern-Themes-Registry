    "tokenColors": [
        {
            "scope": [
                "comment",
                "punctuation.definition.comment",
                "string.comment"
            ],
            "settings": { "foreground": "#a0b4a0" }
        },
        {
            "scope": [
                "delimiter.bracket",
                "delimiter",
                "invalid.illegal.character-not-allowed-here.html",
                "keyword.operator.rest",
                "keyword.operator.spread",
                "keyword.operator.type.annotation",
                "keyword.operator.relational",
                "keyword.operator.assignment",
                "keyword.operator.type",
                "meta.brace",
                "meta.tag.block.any.html",
                "meta.tag.inline.any.html",
                "meta.tag.structure.input.void.html",
                "meta.type.annotation",
                "meta.embedded.block.github-actions-expression",
                "storage.type.function.arrow",
                "meta.objectliteral.ts",
                "punctuation",
                "punctuation.definition.string.begin.html.vue",
                "punctuation.definition.string.end.html.vue"
            ],
            "settings": { "foreground": "#aeaeae" }
        },
        {
            "scope": [
                "constant",
                "entity.name.constant",
                "variable.language",
                "meta.definition.variable"
            ],
            "settings": { "foreground": "#ee9c77" }
        },
        {
            "scope": ["entity", "entity.name"],
            "settings": { "foreground": "#88be62" }
        },
        {
            "scope": "variable.parameter.function",
            "settings": { "foreground": "#e8e3d4" }
        },
        {
            "scope": ["entity.name.tag", "tag.html"],
            "settings": { "foreground": "#51c292" }
        },
        {
            "scope": "entity.name.function",
            "settings": { "foreground": "#88be62" }
        },
        {
            "scope": [
                "keyword",
                "storage.type.class.jsdoc",
                "punctuation.definition.template-expression"
            ],
            "settings": { "foreground": "#51c292" }
        },
        {
            "scope": [
                "storage",
                "storage.type",
                "support.type.builtin",
                "constant.language.undefined",
                "constant.language.null",
                "constant.language.import-export-all.ts"
            ],
            "settings": { "foreground": "#fa9292" }
        },
        {
            "scope": [
                "text.html.derivative",
                "storage.modifier.package",
                "storage.modifier.import",
                "storage.type.java"
            ],
            "settings": { "foreground": "#e8e3d4" }
        },
        {
            "scope": [
                "string",
                "string punctuation.section.embedded source",
                "attribute.value"
            ],
            "settings": { "foreground": "#ef9887" }
        },
        {
            "scope": ["punctuation.definition.string"],
            "settings": { "foreground": "#ef9887" }
        },
        {
            "scope": ["punctuation.support.type.property-name"],
            "settings": { "foreground": "#ccb85c" }
        },
        { "scope": "support", "settings": { "foreground": "#ccb85c" } },
        {
            "scope": [
                "property",
                "meta.property-name",
                "meta.object-literal.key",
                "entity.name.tag.yaml",
                "attribute.name"
            ],
            "settings": { "foreground": "#ccb85c" }
        },
        {
            "scope": [
                "entity.other.attribute-name",
                "invalid.deprecated.entity.other.attribute-name.html"
            ],
            "settings": { "foreground": "#dda35e" }
        },
        {
            "scope": ["variable", "identifier"],
            "settings": { "foreground": "#dda35e" }
        },
        {
            "scope": ["support.type.primitive", "entity.name.type"],
            "settings": { "foreground": "#58c2a4" }
        },
        { "scope": "namespace", "settings": { "foreground": "#ff8dac" } },
        {
            "scope": [
                "keyword.operator",
                "keyword.operator.assignment.compound",
                "meta.var.expr.ts"
            ],
            "settings": { "foreground": "#fa9292" }
        },
        {
            "scope": "invalid.broken",
            "settings": { "fontStyle": "", "foreground": "#ffbfcb" }
        },
        {
            "scope": "invalid.deprecated",
            "settings": { "fontStyle": "", "foreground": "#ffbfcb" }
        },
        {
            "scope": "invalid.illegal",
            "settings": { "fontStyle": "", "foreground": "#ffbfcb" }
        },
        {
            "scope": "invalid.unimplemented",
            "settings": { "fontStyle": "", "foreground": "#ffbfcb" }
        },
        {
            "scope": "carriage-return",
            "settings": {
                "background": "#f97583",
                "content": "^M",
                "fontStyle": "italic underline",
                "foreground": "#a0b2c2"
            }
        },
        { "scope": "message.error", "settings": { "foreground": "#ffbfcb" } },
        { "scope": "string variable", "settings": { "foreground": "#ef9887" } },
        {
            "scope": ["source.regexp", "string.regexp"],
            "settings": { "foreground": "#f7966f" }
        },
        {
            "scope": [
                "string.regexp.character-class",
                "string.regexp constant.character.escape",
                "string.regexp source.ruby.embedded",
                "string.regexp string.regexp.arbitrary-repitition"
            ],
            "settings": { "foreground": "#ef9887" }
        },
        {
            "scope": "string.regexp constant.character.escape",
            "settings": { "foreground": "#f6d877" }
        },
        {
            "scope": ["support.constant"],
            "settings": { "foreground": "#ee9c77" }
        },
        {
            "scope": [
                "keyword.operator.quantifier.regexp",
                "constant.numeric",
                "number"
            ],
            "settings": { "foreground": "#47c1b3" }
        },
        {
            "scope": ["keyword.other.unit"],
            "settings": { "foreground": "#fa9292" }
        },
        {
            "scope": ["constant.language.boolean", "constant.language"],
            "settings": { "foreground": "#51c292" }
        },
        {
            "scope": "meta.module-reference",
            "settings": { "foreground": "#51c292" }
        },
        {
            "scope": "punctuation.definition.list.begin.markdown",
            "settings": { "foreground": "#f5a064" }
        },
        {
            "scope": ["markup.heading", "markup.heading entity.name"],
            "settings": { "fontStyle": "bold", "foreground": "#51c292" }
        },
        { "scope": "markup.quote", "settings": { "foreground": "#6ab9cd" } },
        {
            "scope": "markup.italic",
            "settings": { "fontStyle": "", "foreground": "#e8e3d4" }
        },
        {
            "scope": "markup.bold",
            "settings": { "fontStyle": "bold", "foreground": "#e8e3d4" }
        },
        { "scope": "markup.raw", "settings": { "foreground": "#51c292" } },
        {
            "scope": [
                "markup.deleted",
                "meta.diff.header.from-file",
                "punctuation.definition.deleted"
            ],
            "settings": { "background": "#86181d", "foreground": "#ffbfcb" }
        },
        {
            "scope": [
                "markup.inserted",
                "meta.diff.header.to-file",
                "punctuation.definition.inserted"
            ],
            "settings": { "background": "#144620", "foreground": "#85f7a1" }
        },
        {
            "scope": ["markup.changed", "punctuation.definition.changed"],
            "settings": { "background": "#c24e00", "foreground": "#ffc068" }
        },
        {
            "scope": ["markup.ignored", "markup.untracked"],
            "settings": { "background": "#79b8ff", "foreground": "#a0b2c4" }
        },
        {
            "scope": "meta.diff.range",
            "settings": { "fontStyle": "bold", "foreground": "#cf9dff" }
        },
        {
            "scope": "meta.diff.header",
            "settings": { "foreground": "#76cbff" }
        },
        {
            "scope": "meta.separator",
            "settings": { "fontStyle": "bold", "foreground": "#76cbff" }
        },
        { "scope": "meta.output", "settings": { "foreground": "#76cbff" } },
        {
            "scope": [
                "brackethighlighter.tag",
                "brackethighlighter.curly",
                "brackethighlighter.round",
                "brackethighlighter.square",
                "brackethighlighter.angle",
                "brackethighlighter.quote"
            ],
            "settings": { "foreground": "#dce1e7" }
        },
        {
            "scope": "brackethighlighter.unmatched",
            "settings": { "foreground": "#ffbfcb" }
        },
        {
            "scope": [
                "constant.other.reference.link",
                "string.other.link",
                "punctuation.definition.string.begin.markdown",
                "punctuation.definition.string.end.markdown"
            ],
            "settings": { "foreground": "#ef9887" }
        },
        {
            "scope": [
                "markup.underline.link.markdown",
                "markup.underline.link.image.markdown"
            ],
            "settings": { "fontStyle": "underline", "foreground": "#e7e5dd" }
        },
        {
            "scope": [
                "type.identifier",
                "constant.other.character-class.regexp"
            ],
            "settings": { "foreground": "#a2ace6" }
        },
        {
            "scope": ["entity.other.attribute-name.html.vue"],
            "settings": { "foreground": "#88be62" }
        },
        {
            "scope": ["invalid.illegal.unrecognized-tag.html"],
            "settings": { "fontStyle": "normal" }
        }
    ],
    "semanticTokenColors": {
        "class": "#6872ab",
        "interface": "#5d99a9",
        "namespace": "#db889a",
        "property": "#b8a965",
        "type": "#5d99a9"
    },
    "$schema": "vscode://schemas/color-theme"
}
