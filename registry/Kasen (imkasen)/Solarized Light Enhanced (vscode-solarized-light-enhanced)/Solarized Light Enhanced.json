{
    "name": "Mixed Solarized Light",
    "type": "light",
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "enumMember": { "foreground": "#53676D" },
        "module": { "foreground": "#C25D1E" }
    },
    "tokenColors": [
        {
            "name": "Invalid",
            "scope": ["invalid"],
            "settings": { "foreground": "#DC322F" }
        },
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#93A1A1", "fontStyle": "italic" }
        },
        {
            "name": "Keyword, Storage",
            "scope": ["keyword", "storage"],
            "settings": { "foreground": "#8762C6" }
        },
        {
            "name": "Operator, Punctuation",
            "scope": [
                "keyword.operator",
                "punctuation",
                "entity.name.function.operator",
                "constant.other.color"
            ],
            "settings": { "foreground": "#2AA198", "fontStyle": "" }
        },
        {
            "name": "Escape Characters",
            "scope": ["constant.character.escape"],
            "settings": { "foreground": "#2AA198", "fontStyle": "bold" }
        },
        {
            "name": "Suffix",
            "scope": ["keyword.other.unit", "storage.type.numeric"],
            "settings": { "foreground": "#009C8F", "fontStyle": "italic" }
        },
        {
            "name": "Punctuation #",
            "scope": [
                "punctuation.definition.directive.c",
                "punctuation.definition.directive.cpp",
                "punctuation.definition.annotation.java"
            ],
            "settings": { "foreground": "#8762C6" }
        },
        {
            "name": "Constant",
            "scope": [
                "constant",
                "variable.other.constant",
                "support.constant",
                "meta.property-value.css"
            ],
            "settings": { "foreground": "#CB4B16" }
        },
        {
            "name": "Number",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#C25D1E" }
        },
        {
            "name": "String",
            "scope": ["string"],
            "settings": { "foreground": "#489100" }
        },
        {
            "name": "Regular Expressions",
            "scope": ["string.regexp"],
            "settings": { "foreground": "#2AA198" }
        },
        {
            "name": "String Placeholder",
            "scope": ["constant.character", "constant.other.placeholder"],
            "settings": { "foreground": "#CB4B16" }
        },
        {
            "name": "Variable",
            "scope": ["variable"],
            "settings": { "foreground": "#53676D", "fontStyle": "" }
        },
        {
            "name": "Variable Language",
            "scope": ["variable.language"],
            "settings": { "foreground": "#DC322F" }
        },
        {
            "name": "Other Variable",
            "scope": ["support.other.variable"],
            "settings": { "foreground": "#CF4B56" }
        },
        {
            "name": "Parameter",
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#657B83", "fontStyle": "italic" }
        },
        {
            "name": "Label",
            "scope": ["entity.name.label"],
            "settings": { "foreground": "#53676D" }
        },
        {
            "name": "Type, Namespaces",
            "scope": ["entity.name.type", "entity.name.namespace"],
            "settings": { "foreground": "#B58900" }
        },
        {
            "name": "Function",
            "scope": ["entity.name.function", "variable.function"],
            "settings": { "foreground": "#268BD2", "fontStyle": "bold" }
        },
        {
            "name": "Support Function",
            "scope": ["support.function", "support.function.magic"],
            "settings": { "foreground": "#009C8F", "fontStyle": "bold" }
        },
        {
            "name": "Class",
            "scope": [
                "entity.name.class",
                "entity.name.type.class",
                "support.type",
                "support.class"
            ],
            "settings": { "foreground": "#B58900" }
        },
        {
            "name": "Enum Java",
            "scope": ["constant.other.enum.java"],
            "settings": { "foreground": "#00978A" }
        },
        {
            "name": "Source",
            "scope": ["source.python"],
            "settings": { "foreground": "#B58900", "fontStyle": "italic" }
        },
        {
            "name": "Magic Variable",
            "scope": ["support.variable.magic.python"],
            "settings": { "foreground": "#53676D" }
        },
        {
            "name": "Python Bold String Prefix",
            "scope": ["storage.type.string.python"],
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Python @ Decorator",
            "scope": ["punctuation.definition.decorator.python"],
            "settings": { "foreground": "#268BD2", "fontStyle": "bold" }
        },
        {
            "name": "Python 'Self' in Class",
            "scope": "variable.parameter.function.language.special.self.python",
            "settings": { "foreground": "#C25D1E", "fontStyle": "italic" }
        },
        {
            "name": "JS Support Function",
            "scope": ["support.function.js", "meta.class.js"],
            "settings": { "foreground": "#268BD2" }
        },
        {
            "name": "SQL",
            "scope": ["source.sql"],
            "settings": { "foreground": "#53676D" }
        },
        {
            "name": "HTML Tag",
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#CF4B56" }
        },
        {
            "name": "HTML Attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#6C71C4" }
        },
        {
            "name": "HTML Text",
            "scope": ["text.html.derivative", "meta.jsx", "text.svelte"],
            "settings": { "foreground": "#53676D" }
        },
        {
            "name": "CSS Tag",
            "scope": ["entity.name.tag.css"],
            "settings": { "foreground": "#CF4B56" }
        },
        {
            "name": "CSS Attributes",
            "scope": [
                "entity.other.attribute-name.css",
                "entity.other.attribute-name.id.css",
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.pseudo-class.css",
                "entity.other.attribute-name.pseudo-element.css"
            ],
            "settings": { "foreground": "#6C71C4" }
        },
        {
            "name": "CSS Keyframe",
            "scope": ["entity.other.keyframe-offset.css"],
            "settings": { "foreground": "#CF4B56" }
        },
        {
            "name": "CSS Property Value",
            "scope": ["meta.property-value.css"],
            "settings": { "foreground": "#CB4B16" }
        },
        {
            "name": "Markdown Heading Text",
            "scope": ["markup.heading.markdown"],
            "settings": { "foreground": "#489100" }
        },
        {
            "name": "Markdown Heading Punctuation",
            "scope": ["punctuation.definition.heading.markdown"],
            "settings": { "foreground": "#CF4B56" }
        },
        {
            "name": "Markdown Text",
            "scope": ["text.html.markdown"],
            "settings": { "foreground": "#53676D" }
        },
        {
            "name": "Markdown Bold",
            "scope": ["markup.bold.markdown"],
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Markdown Italics",
            "scope": ["markup.italic.markdown"],
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "Markdown List Punctuation",
            "scope": ["punctuation.definition.list.begin.markdown"],
            "settings": { "foreground": "#268BD2" }
        },
        {
            "name": "Markdown Link Title",
            "scope": ["string.other.link.title.markdown"],
            "settings": { "foreground": "#268BD2", "fontStyle": "" }
        },
        {
            "name": "Markdown Image Link Title",
            "scope": ["string.other.link.description.markdown"],
            "settings": { "foreground": "#CF4B56" }
        },
        {
            "name": "Markdown Link",
            "scope": [
                "markup.underline.link.markdown",
                "markup.underline.link.image.markdown"
            ],
            "settings": { "foreground": "#489100", "fontStyle": "underline" }
        },
        {
            "name": "Markdown Code Block Language Tag",
            "scope": ["fenced_code.block.language"],
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Markdown Inline Code",
            "scope": ["markup.inline.raw.string.markdown"],
            "settings": { "foreground": "#CB4B16" }
        },
        {
            "name": "Markdown Quote",
            "scope": ["markup.quote.markdown"],
            "settings": { "foreground": "#93A1A1", "fontStyle": "italic" }
        },
        {
            "name": "Markdown Horizontal Rule",
            "scope": ["meta.separator.markdown"],
            "settings": { "foreground": "#93A1A1", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Strikethrough",
            "scope": ["markup.strikethrough.markdown"],
            "settings": { "fontStyle": "strikethrough" }
        },
        {
            "name": "YAML Key",
            "scope": ["entity.name.tag.yaml"],
            "settings": { "foreground": "#B58900" }
        },
        {
            "name": "YAML Ancher & Alias",
            "scope": [
                "entity.name.type.anchor.yaml",
                "variable.other.alias.yaml"
            ],
            "settings": { "foreground": "#2AA198" }
        },
        {
            "name": "YAML Block Scalar",
            "scope": [
                "keyword.control.flow.block-scalar.folded.yaml",
                "keyword.control.flow.block-scalar.literal.yaml"
            ],
            "settings": { "foreground": "#2AA198", "fontStyle": "bold" }
        },
        {
            "name": "INI Title",
            "scope": ["entity.name.section.group-title.ini"],
            "settings": { "foreground": "#B58900" }
        },
        {
            "name": "INI Key",
            "scope": ["keyword.other.definition.ini"],
            "settings": { "foreground": "#B58900" }
        },
        {
            "name": "INI Non-string Value",
            "scope": ["source.ini"],
            "settings": { "foreground": "#CB4B16" }
        },
        {
            "name": "XML Tag",
            "scope": ["entity.name.tag.xml", "entity.name.tag.localname.xml"],
            "settings": { "foreground": "#CF4B56" }
        },
        {
            "name": "XML Attributes",
            "scope": [
                "entity.other.attribute-name.xml",
                "entity.other.attribute-name.localname.xml"
            ],
            "settings": { "foreground": "#6C71C4" }
        },
        {
            "name": "XML Text",
            "scope": ["text.xml"],
            "settings": { "foreground": "#53676D" }
        },
        {
            "name": "Dockerfile Value",
            "scope": ["source.dockerfile"],
            "settings": { "foreground": "#CB4B16" }
        },
        {
            "name": "Makefile Value",
            "scope": ["source.makefile"],
            "settings": { "foreground": "#CB4B16" }
        },
        {
            "name": "CMake",
            "scope": ["source.cmake"],
            "settings": { "foreground": "#CB4B16" }
        },
        {
            "name": "Nginx Text",
            "scope": ["meta.context.http.nginx", "source.nginx"],
            "settings": { "foreground": "#53676D" }
        },
        {
            "name": "Nginx Link",
            "scope": [
                "entity.name.context.location.nginx",
                "string.regexp.nginx"
            ],
            "settings": { "foreground": "#268BD2", "fontStyle": "bold" }
        },
        {
            "name": "Nginx Path",
            "scope": ["meta.context.server.nginx"],
            "settings": { "foreground": "#489100" }
        }
    ],
    "colors": {
        "focusBorder": "#D3AF86",
        "selection.background": "#DFCA8866",
        "button.background": "#AC9D57",
        "dropdown.background": "#EEE8D5",
        "dropdown.border": "#D3AF86",
        "input.background": "#EEE8D5",
        "input.border": "#586E754A",
        "input.foreground": "#586E75",
        "input.placeholderForeground": "#586E75AA",
        "inputOption.activeBorder": "#D3AF86",
        "badge.background": "#B58900AA",
        "progressBar.background": "#B58900",
        "list.activeSelectionBackground": "#DFCA88",
        "list.activeSelectionForeground": "#6C6C6C",
        "list.focusBackground": "#DFCA8866",
        "list.highlightForeground": "#B58900",
        "list.hoverBackground": "#DFCA8844",
        "list.inactiveSelectionBackground": "#D1CBB8",
        "activityBar.background": "#DDD6C1",
        "activityBar.foreground": "#584C27",
        "activityBarBadge.background": "#B58900",
        "sideBar.background": "#EEE8D5",
        "sideBarTitle.foreground": "#586E75",
        "minimap.selectionHighlight": "#00212B40",
        "editorGroup.border": "#DDD6C1",
        "editorGroup.dropBackground": "#DDD6C1AA",
        "editorGroupHeader.tabsBackground": "#D9D2C2",
        "tab.activeBackground": "#FDF6E3",
        "tab.border": "#DDD6C1",
        "tab.inactiveBackground": "#D3CBB7",
        "tab.inactiveForeground": "#586E75",
        "tab.activeModifiedBorder": "#CB4B16",
        "editor.background": "#FDF6E3",
        "editorLineNumber.activeForeground": "#586E75",
        "editorCursor.background": "#EEE8D5",
        "editorCursor.foreground": "#657B83",
        "editor.selectionBackground": "#D5CDB6",
        "editor.lineHighlightBackground": "#EEE8D5",
        "editorLink.activeForeground": "#006DCE",
        "editorWhitespace.foreground": "#586E7580",
