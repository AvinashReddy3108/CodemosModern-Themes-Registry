        },
        {
            "name": "Markdown - Separator",
            "scope": ["meta.separator"],
            "settings": { "fontStyle": "bold", "foreground": "#C6E4E4" }
        },
        {
            "name": "Markup - Table",
            "scope": ["markup.table"],
            "settings": { "foreground": "#E9C8D3" }
        },
        {
            "scope": "token.info-token",
            "settings": { "foreground": "#00A7B5" }
        },
        {
            "scope": "token.warn-token",
