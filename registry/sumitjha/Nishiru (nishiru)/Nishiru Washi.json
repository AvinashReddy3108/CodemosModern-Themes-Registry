    "tokenColors": [
        {
            "name": "Text",
            "scope": ["source", "text"],
            "settings": { "foreground": "#1e1840" }
        },
        {
            "name": "Comments",
            "scope": [
                "comment",
                "punctuation.definition.comment",
                "string.comment"
            ],
            "settings": { "foreground": "#8878a8", "fontStyle": "italic" }
        },
        {
            "name": "Consequence keywords — void/throw/delete",
            "scope": [
                "keyword.operator.void",
                "keyword.control.throw",
                "keyword.operator.delete",
                "keyword.other.delete",
                "constant.language.null",
                "constant.language.undefined"
            ],
            "settings": { "foreground": "#b02010" }
        },
        {
            "name": "New — creation",
            "scope": ["keyword.operator.new", "keyword.other.new"],
            "settings": { "foreground": "#0a7848" }
        },
        {
            "name": "Boolean/null literals",
            "scope": [
                "constant.language.boolean",
                "constant.language.null",
                "constant.language.undefined",
                "constant.language.nan",
                "constant.language.infinity"
            ],
            "settings": { "foreground": "#806000" }
        },
        {
            "name": "Keywords — soul",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.control.flow",
                "keyword.operator.new",
                "keyword.operator.delete",
                "storage.type",
                "storage.modifier",
                "keyword.other"
            ],
            "settings": { "foreground": "#5820a0" }
        },
        {
            "name": "Imports/exports — fuji",
            "scope": [
                "keyword.control.import",
                "keyword.control.export",
                "keyword.control.from",
                "keyword.control.require"
            ],
            "settings": { "foreground": "#0a7868" }
        },
        {
            "name": "Readonly/const",
            "scope": ["storage.modifier.readonly", "keyword.other.readonly"],
            "settings": { "foreground": "#806000" }
        },
        {
            "name": "Operators",
            "scope": [
                "keyword.operator",
                "keyword.operator.assignment",
                "keyword.operator.arithmetic",
                "keyword.operator.logical",
                "keyword.operator.comparison",
                "keyword.operator.type"
            ],
            "settings": { "foreground": "#106858" }
        },
        {
            "name": "Accessor dot",
            "scope": ["keyword.operator.accessor", "punctuation.accessor"],
            "settings": { "foreground": "#7070b0" }
        },
        {
            "name": "Types/classes",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "entity.name.namespace",
                "support.type",
                "support.class",
                "storage.type.primitive",
                "storage.type.built-in"
            ],
            "settings": { "foreground": "#806010" }
        },
        {
            "name": "Functions",
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#2040a0" }
        },
        {
            "name": "Function calls",
            "scope": [
                "meta.function-call entity.name.function",
                "meta.function-call support.function"
            ],
            "settings": { "foreground": "#3050b0" }
        },
        {
            "name": "Strings",
            "scope": [
                "string",
                "string.quoted",
                "string.template",
                "string.interpolated"
            ],
            "settings": { "foreground": "#0a7848" }
        },
        {
            "name": "Template expressions",
            "scope": [
                "punctuation.definition.template-expression",
                "punctuation.section.embedded"
            ],
            "settings": { "foreground": "#5020a0" }
        },
        {
            "name": "String escapes",
            "scope": ["constant.character.escape"],
            "settings": { "foreground": "#087848" }
        },
        {
            "name": "Regexp",
            "scope": ["string.regexp"],
            "settings": { "foreground": "#900850" }
        },
        {
            "name": "Numbers",
            "scope": [
                "constant.numeric",
                "constant.numeric.integer",
                "constant.numeric.float"
            ],
            "settings": { "foreground": "#804010" }
        },
        {
            "name": "Constants",
            "scope": [
                "constant.language",
                "constant.other",
                "support.constant",
                "variable.other.constant"
            ],
            "settings": { "foreground": "#806000" }
        },
        {
            "name": "Variables",
            "scope": [
                "variable",
                "variable.other",
                "variable.other.readwrite",
                "variable.other.object"
            ],
            "settings": { "foreground": "#1848a0" }
        },
        {
            "name": "Parameters",
            "scope": [
                "variable.parameter",
                "meta.function.parameters variable"
            ],
            "settings": { "foreground": "#a01040" }
        },
        {
            "name": "This/self",
            "scope": [
                "variable.language.this",
                "variable.language.self",
                "variable.language.super"
            ],
            "settings": { "foreground": "#5820a0", "fontStyle": "italic" }
        },
        {
            "name": "Properties",
            "scope": [
                "variable.other.property",
                "variable.other.object.property",
                "support.variable.property"
            ],
            "settings": { "foreground": "#3a3060" }
        },
        {
            "name": "Tags",
            "scope": ["entity.name.tag", "meta.tag.sgml"],
            "settings": { "foreground": "#5820a0" }
        },
        {
            "name": "Tag attributes",
            "scope": ["entity.other.attribute-name", "meta.attribute"],
            "settings": { "foreground": "#806010" }
        },
        {
            "name": "Decorators",
            "scope": [
                "meta.decorator",
                "entity.name.decorator",
                "punctuation.decorator"
            ],
            "settings": { "foreground": "#900850" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation",
                "punctuation.definition.tag",
                "punctuation.separator",
                "punctuation.terminator",
                "meta.brace"
            ],
            "settings": { "foreground": "#6060a0" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#b02010" }
        },
        {
            "name": "Deprecated",
            "scope": ["invalid.deprecated"],
            "settings": {
                "foreground": "#a01040",
                "fontStyle": "strikethrough"
            }
        },
        {
            "name": "CSS properties",
            "scope": ["support.type.property-name"],
            "settings": { "foreground": "#0a7868" }
        },
        {
            "name": "CSS values",
            "scope": ["support.constant.property-value"],
            "settings": { "foreground": "#804010" }
        },
        {
            "name": "CSS selectors",
            "scope": [
                "entity.name.tag.css",
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css",
                "entity.other.attribute-name.pseudo-class.css"
            ],
            "settings": { "foreground": "#1848a0" }
        },
        {
            "name": "JSON keys",
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#5820a0" }
        },
        {
            "name": "JSON values",
            "scope": [
                "source.json meta.structure.dictionary.json meta.structure.dictionary.value string.quoted"
            ],
            "settings": { "foreground": "#0a7848" }
        },
        {
            "name": "Markdown headings",
            "scope": ["markup.heading", "punctuation.definition.heading"],
            "settings": { "foreground": "#806010", "fontStyle": "bold" }
        },
        {
            "name": "Markdown bold",
            "scope": ["markup.bold"],
            "settings": { "foreground": "#1e1840", "fontStyle": "bold" }
        },
        {
            "name": "Markdown italic",
            "scope": ["markup.italic"],
            "settings": { "foreground": "#3a3060", "fontStyle": "italic" }
        },
        {
            "name": "Markdown code",
            "scope": ["markup.inline.raw", "markup.fenced_code.block"],
            "settings": { "foreground": "#0a7848" }
        },
        {
            "name": "Markdown links",
            "scope": ["markup.underline.link", "string.other.link"],
            "settings": { "foreground": "#2040a0" }
        },
        {
            "name": "Markdown blockquote",
            "scope": ["markup.quote"],
            "settings": { "foreground": "#7070b0", "fontStyle": "italic" }
        },
        {
            "name": "Diff added",
            "scope": ["markup.inserted"],
            "settings": { "foreground": "#3060c0" }
        },
        {
            "name": "Diff deleted",
            "scope": ["markup.deleted"],
            "settings": { "foreground": "#c03020" }
        },
        {
            "name": "Diff changed",
            "scope": ["markup.changed"],
            "settings": { "foreground": "#7030b0" }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "namespace": "#806010",
        "class": "#806010",
        "class.declaration": { "foreground": "#806010" },
        "enum": "#806010",
        "type": "#806010",
        "struct": "#806010",
        "string": "#0a7848",
        "enumMember": "#806000",
        "interface": "#0a7868",
        "typeParameter": "#0a7868",
        "builtinType": "#0a7868",
        "function": "#2040a0",
        "function.declaration": "#2040a0",
        "method": "#2848a8",
        "method.declaration": "#2848a8",
        "macro": "#5820a0",
        "keyword": "#5820a0",
        "modifier": "#5820a0",
        "lifetime": { "foreground": "#5820a0", "italic": true },
        "variable": "#1848a0",
        "variable.declaration": "#3050b0",
        "variable.readonly": "#806000",
        "parameter": "#a01040",
        "property": "#3a3060",
        "property.readonly": "#5050a0",
        "selfKeyword": { "foreground": "#5820a0", "italic": true },
        "comment": { "foreground": "#8878a8", "italic": true },
        "number": "#804010",
        "regexp": "#900850",
        "decorator": "#900850",
        "event": "#900850",
        "label": "#804010",
        "operator": "#106858"
    },
    "$schema": "vscode://schemas/color-theme"
}
