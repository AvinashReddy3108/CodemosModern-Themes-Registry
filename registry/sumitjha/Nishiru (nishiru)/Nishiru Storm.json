    "tokenColors": [
        {
            "name": "Text",
            "scope": ["source", "text"],
            "settings": { "foreground": "#e0e2f0" }
        },
        {
            "name": "Comments",
            "scope": [
                "comment",
                "punctuation.definition.comment",
                "string.comment"
            ],
            "settings": { "foreground": "#6a6480", "fontStyle": "italic" }
        },
        {
            "name": "Consequence keywords — void/throw/delete",
            "scope": [
                "keyword.operator.void",
                "keyword.control.throw",
                "keyword.operator.delete",
                "keyword.other.delete",
                "constant.language.null",
                "constant.language.undefined"
            ],
            "settings": { "foreground": "#ff8874" }
        },
        {
            "name": "New — creation",
            "scope": ["keyword.operator.new", "keyword.other.new"],
            "settings": { "foreground": "#68f4bc" }
        },
        {
            "name": "Boolean/null literals",
            "scope": [
                "constant.language.boolean",
                "constant.language.null",
                "constant.language.undefined",
                "constant.language.nan",
                "constant.language.infinity"
            ],
            "settings": { "foreground": "#ffd878" }
        },
        {
            "name": "Keywords — soul",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.control.flow",
                "keyword.operator.new",
                "keyword.operator.delete",
                "storage.type",
                "storage.modifier",
                "keyword.other"
            ],
            "settings": { "foreground": "#dcc0ff" }
        },
        {
            "name": "Imports/exports — fuji",
            "scope": [
                "keyword.control.import",
                "keyword.control.export",
                "keyword.control.from",
                "keyword.control.require"
            ],
            "settings": { "foreground": "#44f4d4" }
        },
        {
            "name": "Readonly/const",
            "scope": ["storage.modifier.readonly", "keyword.other.readonly"],
            "settings": { "foreground": "#ffd878" }
        },
        {
            "name": "Operators",
            "scope": [
                "keyword.operator",
                "keyword.operator.assignment",
                "keyword.operator.arithmetic",
                "keyword.operator.logical",
                "keyword.operator.comparison",
                "keyword.operator.type"
            ],
            "settings": { "foreground": "#76f8e0" }
        },
        {
            "name": "Accessor dot",
            "scope": ["keyword.operator.accessor", "punctuation.accessor"],
            "settings": { "foreground": "#7f849c" }
        },
        {
            "name": "Types/classes",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "entity.name.namespace",
                "support.type",
                "support.class",
                "storage.type.primitive",
                "storage.type.built-in"
            ],
            "settings": { "foreground": "#f8d860" }
        },
        {
            "name": "Functions",
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#aac4ff" }
        },
        {
            "name": "Function calls",
            "scope": [
                "meta.function-call entity.name.function",
                "meta.function-call support.function"
            ],
            "settings": { "foreground": "#c8dcff" }
        },
        {
            "name": "Strings",
            "scope": [
                "string",
                "string.quoted",
                "string.template",
                "string.interpolated"
            ],
            "settings": { "foreground": "#68f4bc" }
        },
        {
            "name": "Template expressions",
            "scope": [
                "punctuation.definition.template-expression",
                "punctuation.section.embedded"
            ],
            "settings": { "foreground": "#caaeff" }
        },
        {
            "name": "String escapes",
            "scope": ["constant.character.escape"],
            "settings": { "foreground": "#98fcd4" }
        },
        {
            "name": "Regexp",
            "scope": ["string.regexp"],
            "settings": { "foreground": "#faacc8" }
        },
        {
            "name": "Numbers",
            "scope": [
                "constant.numeric",
                "constant.numeric.integer",
                "constant.numeric.float"
            ],
            "settings": { "foreground": "#f0b880" }
        },
        {
            "name": "Constants",
            "scope": [
                "constant.language",
                "constant.other",
                "support.constant",
                "variable.other.constant"
            ],
            "settings": { "foreground": "#ffd878" }
        },
        {
            "name": "Variables",
            "scope": [
                "variable",
                "variable.other",
                "variable.other.readwrite",
                "variable.other.object"
            ],
            "settings": { "foreground": "#96c8ff" }
        },
        {
            "name": "Parameters",
            "scope": [
                "variable.parameter",
                "meta.function.parameters variable"
            ],
            "settings": { "foreground": "#ff96ac" }
        },
        {
            "name": "This/self",
            "scope": [
                "variable.language.this",
                "variable.language.self",
                "variable.language.super"
            ],
            "settings": { "foreground": "#dcc0ff", "fontStyle": "italic" }
        },
        {
            "name": "Properties",
            "scope": [
                "variable.other.property",
                "variable.other.object.property",
                "support.variable.property"
            ],
            "settings": { "foreground": "#bac2de" }
        },
        {
            "name": "Tags",
            "scope": ["entity.name.tag", "meta.tag.sgml"],
            "settings": { "foreground": "#dcc0ff" }
        },
        {
            "name": "Tag attributes",
            "scope": ["entity.other.attribute-name", "meta.attribute"],
            "settings": { "foreground": "#f8d860" }
        },
        {
            "name": "Decorators",
            "scope": [
                "meta.decorator",
                "entity.name.decorator",
                "punctuation.decorator"
            ],
            "settings": { "foreground": "#faacc8" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation",
                "punctuation.definition.tag",
                "punctuation.separator",
                "punctuation.terminator",
                "meta.brace"
            ],
            "settings": { "foreground": "#9ba3c0" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#ff8874" }
        },
        {
            "name": "Deprecated",
            "scope": ["invalid.deprecated"],
            "settings": {
                "foreground": "#ff96ac",
                "fontStyle": "strikethrough"
            }
        },
        {
            "name": "CSS properties",
            "scope": ["support.type.property-name"],
            "settings": { "foreground": "#44f4d4" }
        },
        {
            "name": "CSS values",
            "scope": ["support.constant.property-value"],
            "settings": { "foreground": "#f0b880" }
        },
        {
            "name": "CSS selectors",
            "scope": [
                "entity.name.tag.css",
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css",
                "entity.other.attribute-name.pseudo-class.css"
            ],
            "settings": { "foreground": "#96c8ff" }
        },
        {
            "name": "JSON keys",
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#dcc0ff" }
        },
        {
            "name": "JSON values",
            "scope": [
                "source.json meta.structure.dictionary.json meta.structure.dictionary.value string.quoted"
            ],
            "settings": { "foreground": "#68f4bc" }
        },
        {
            "name": "Markdown headings",
            "scope": ["markup.heading", "punctuation.definition.heading"],
            "settings": { "foreground": "#f8d860", "fontStyle": "bold" }
        },
        {
            "name": "Markdown bold",
            "scope": ["markup.bold"],
            "settings": { "foreground": "#e0e2f0", "fontStyle": "bold" }
        },
        {
            "name": "Markdown italic",
            "scope": ["markup.italic"],
            "settings": { "foreground": "#bac2de", "fontStyle": "italic" }
        },
        {
            "name": "Markdown code",
            "scope": ["markup.inline.raw", "markup.fenced_code.block"],
            "settings": { "foreground": "#68f4bc" }
        },
        {
            "name": "Markdown links",
            "scope": ["markup.underline.link", "string.other.link"],
            "settings": { "foreground": "#aac4ff" }
        },
        {
            "name": "Markdown blockquote",
            "scope": ["markup.quote"],
            "settings": { "foreground": "#7f849c", "fontStyle": "italic" }
        },
        {
            "name": "Diff added",
            "scope": ["markup.inserted"],
            "settings": { "foreground": "#9eb6ff" }
        },
        {
            "name": "Diff deleted",
            "scope": ["markup.deleted"],
            "settings": { "foreground": "#f57a6a" }
        },
        {
            "name": "Diff changed",
            "scope": ["markup.changed"],
            "settings": { "foreground": "#d4b0ff" }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "namespace": "#f8d860",
        "class": "#f8d860",
        "class.declaration": { "foreground": "#f8d860" },
        "enum": "#f8d860",
        "type": "#f8d860",
        "struct": "#f8d860",
        "string": "#68f4bc",
        "enumMember": "#ffd878",
        "interface": "#44f4d4",
        "typeParameter": "#44f4d4",
        "builtinType": "#44f4d4",
        "function": "#aac4ff",
        "function.declaration": "#aac4ff",
        "method": "#96b8f8",
        "method.declaration": "#96b8f8",
        "macro": "#dcc0ff",
        "keyword": "#dcc0ff",
        "modifier": "#dcc0ff",
        "lifetime": { "foreground": "#dcc0ff", "italic": true },
        "variable": "#96c8ff",
        "variable.declaration": "#c8dcff",
        "variable.readonly": "#ffd878",
        "parameter": "#ff96ac",
        "property": "#bac2de",
        "property.readonly": "#a6adc8",
        "selfKeyword": { "foreground": "#dcc0ff", "italic": true },
        "comment": { "foreground": "#6a6480", "italic": true },
        "number": "#f0b880",
        "regexp": "#faacc8",
        "decorator": "#faacc8",
        "event": "#faacc8",
        "label": "#f0b880",
        "operator": "#76f8e0"
    },
    "$schema": "vscode://schemas/color-theme"
}
