{
    "name": "Kurdor Eclipse",
    "type": "dark",
    "colors": {
        "editor.background": "#282c34",
        "editor.foreground": "#abb2bf",
        "editorLineNumber.foreground": "#495162",
        "editorLineNumber.activeForeground": "#abb2bf",
        "editor.lineHighlightBackground": "#2c313a",
        "editor.selectionBackground": "#3e4451",
        "editorCursor.foreground": "#528bff",
        "editorBracketMatch.background": "#3e4451",
        "sideBar.background": "#21252b",
        "sideBar.foreground": "#abb2bf",
        "sideBarSectionHeader.background": "#282c34",
        "button.background": "#e51400",
        "button.hoverBackground": "#FF0000",
        "button.foreground": "#ffffff",
        "input.background": "#282c34",
        "input.foreground": "#abb2bf",
        "input.placeholderForeground": "#5c6370",
        "activityBar.background": "#282c34",
        "activityBar.foreground": "#d7dae0",
        "activityBarBadge.background": "#528bff",
        "statusBar.background": "#21252b",
        "statusBar.foreground": "#9da5b4",
        "titleBar.activeBackground": "#282c34",
        "titleBar.activeForeground": "#9da5b4"
    },
    "tokenColors": [
        {
            "name": "Keywords",
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#c678dd" }
        },
        {
            "name": "Functions",
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#61afef" }
        },
        {
            "name": "Strings",
            "scope": "string",
            "settings": { "foreground": "#98c379" }
        },
        {
            "name": "Classes & Types",
            "scope": ["entity.name.type", "entity.name.class", "support.class"],
            "settings": { "foreground": "#e5c07b" }
        },
        {
            "name": "Constants & Numbers",
            "scope": [
                "constant.numeric",
                "constant.language",
                "support.constant"
            ],
            "settings": { "foreground": "#d19a66" }
        },
        {
            "name": "Variables",
            "scope": "variable",
            "settings": { "foreground": "#e06c75" }
        },
        {
            "name": "Attributes",
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#d19a66" }
        },
        {
            "name": "Comments",
            "scope": "comment",
            "settings": { "foreground": "#5c6370", "fontStyle": "italic" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
