            "settings": { "foreground": "#d70087" }
        },
        {
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#0451A5" }
        },
        { "scope": "keyword", "settings": { "foreground": "#005f87" } },
        { "scope": "keyword.control", "settings": { "foreground": "#005f87" } },
        {
            "scope": "keyword.control.flow",
