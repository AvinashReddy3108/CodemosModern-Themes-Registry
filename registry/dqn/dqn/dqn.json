        "panelTitle.inactiveForeground": "#6F7B9B",
        "progressBar.background": "#6F7AA8",
        "panelInput.border": "#222A3A"
    },
    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#7B8794" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "string constant.other.placeholder"],
            "settings": { "foreground": "#E1F0FF" }
        },
        {
            "name": "Keywords",
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#7FB8E5" }
        },
        {
            "name": "Operators",
            "scope": [
                "keyword.control",
                "constant.other.color",
                "punctuation",
                "meta.tag",
                "punctuation.definition.tag",
                "punctuation.separator.inheritance.php",
                "punctuation.definition.tag.html",
                "punctuation.definition.tag.begin.html",
                "punctuation.definition.tag.end.html",
                "punctuation.section.embedded",
                "keyword.other.template",
                "keyword.other.substitution"
            ],
            "settings": { "foreground": "#85C1E9" }
        },
        {
            "name": "Mathematical Operators",
            "scope": [
                "keyword.operator",
                "keyword.operator.arithmetic",
                "keyword.operator.assignment",
                "keyword.operator.comparison",
                "keyword.operator.logical",
                "punctuation.separator.operator",
                "keyword.operator.increment",
                "keyword.operator.decrement"
            ],
            "settings": { "foreground": "#FFFFFF" }
        },
        {
            "name": "Tags",
            "scope": [
                "entity.name.tag",
                "meta.tag.sgml",
                "markup.deleted.git_gutter"
            ],
            "settings": { "foreground": "#DE938C" }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "meta.function-call",
                "variable.function",
                "support.function",
                "keyword.other.special-method"
            ],
            "settings": { "foreground": "#81D4E6" }
        },
        {
            "name": "Function Parameters",
            "scope": [
                "variable.parameter",
                "meta.function.parameters variable.other"
            ],
            "settings": { "foreground": "#D4E9FF" }
        },
        {
            "name": "Language Variables (this, self, super)",
            "scope": [
                "variable.language",
                "variable.language.this",
                "variable.language.super",
                "variable.language.self"
            ],
            "settings": { "foreground": "#9DC4E0" }
        },
        {
            "name": "Method Calls",
            "scope": ["entity.name.method", "meta.method-call"],
            "settings": { "foreground": "#66E5FF" }
        },
        {
            "name": "Object Properties",
            "scope": [
                "variable.other.property",
                "variable.other.object.property",
                "meta.object-literal.key"
            ],
            "settings": { "foreground": "#98D8C8" }
        },
        {
            "name": "Numbers and Constants",
            "scope": [
                "constant.numeric",
                "constant.language",
                "support.constant",
                "constant.character",
                "constant.escape",
                "keyword.other.unit",
                "keyword.other"
            ],
            "settings": { "foreground": "#17A2B8" }
        },
        {
            "name": "Strings",
            "scope": [
                "string",
                "constant.other.symbol",
                "constant.other.key",
                "entity.other.inherited-class",
                "markup.heading",
                "meta.group.braces.curly constant.other.object.key.js string.unquoted.label.js"
            ],
            "settings": { "foreground": "#FFEDA1" }
        },
        {
            "name": "Classes and Types",
            "scope": [
                "entity.name",
                "support.type",
                "support.class",
                "support.other.namespace.use.php",
                "meta.use.php",
                "support.other.namespace.php",
                "support.type.sys-types"
            ],
            "settings": { "foreground": "#C8A8E9" }
        },
        {
            "name": "Attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#A6E4E7" }
        },
        {
            "name": "HTML Attributes",
            "scope": [
                "text.html.basic entity.other.attribute-name.html",
                "text.html.basic entity.other.attribute-name"
            ],
            "settings": { "foreground": "#FFEDA1" }
        },
        {
            "name": "HTML & JSX Text Content",
            "scope": [
                "text.html.basic",
                "meta.jsx.children",
                "meta.jsx.children.js",
                "meta.jsx.children.tsx"
            ],
            "settings": { "foreground": "#F6FBFF" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#E74C3C" }
        },
        {
            "name": "JSON Keys",
            "scope": [
                "source.json meta.structure.dictionary.json support.type.property-name.json"
            ],
            "settings": { "foreground": "#85C1E9" }
        },
        {
            "name": "Markdown Headings",
            "scope": [
                "markdown.heading",
                "markup.heading | markup.heading entity.name",
                "markup.heading.markdown punctuation.definition.heading.markdown"
            ],
            "settings": { "foreground": "#85C1E9", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Bold",
            "scope": ["markup.bold", "markup.bold string"],
            "settings": { "fontStyle": "bold", "foreground": "#E8F4F8" }
        },
        {
            "name": "Markdown Italic",
            "scope": ["markup.italic"],
            "settings": { "fontStyle": "italic", "foreground": "#D5DBDB" }
        },
        {
            "name": "Markdown Inline Code",
            "scope": [
                "markup.inline.raw.markdown",
                "markup.inline.raw.string.markdown",
                "punctuation.definition.raw.markdown"
            ],
            "settings": { "foreground": "#FFEDA1" }
        },
        {
            "name": "Markdown Links",
            "scope": ["string.other.link.title.markdown"],
            "settings": { "foreground": "#5DADE2", "fontStyle": "underline" }
        },
        {
            "name": "CSS Properties",
            "scope": ["support.type.property-name.css"],
            "settings": { "foreground": "#30D5C8" }
        },
        {
            "name": "CSS Values",
            "scope": ["support.constant.property-value.css"],
            "settings": { "foreground": "#17A2B8" }
        },
        {
            "name": "Regular Expressions",
            "scope": ["string.regexp"],
            "settings": { "foreground": "#A8C8E1" }
        },
        {
            "name": "Escape Characters",
            "scope": ["constant.character.escape"],
            "settings": { "foreground": "#A8C8E1" }
        },
        {
            "name": "Control Flow",
            "scope": [
                "keyword.control.flow",
                "keyword.control.conditional",
                "keyword.control.loop"
            ],
            "settings": { "foreground": "#8FC4C4" }
        },
        {
            "name": "Imports and Exports",
            "scope": [
                "keyword.control.import",
                "keyword.control.export",
                "keyword.control.from"
            ],
            "settings": { "foreground": "#B8A3D1" }
        },
        {
            "name": "Enum Names",
            "scope": ["entity.name.type.enum", "support.type.enum"],
            "settings": { "foreground": "#30D5C8" }
        },
        {
            "name": "Enum Values and Members",
            "scope": [
                "variable.other.enummember",
                "constant.other.enum",
                "variable.other.constant.property"
            ],
            "settings": { "foreground": "#F4D03F" }
        },
        {
            "name": "Object Variables and Access",
            "scope": [
                "variable.other.object",
                "variable.other.readwrite",
                "support.variable"
            ],
            "settings": { "foreground": "#E8F4F9" }
        },
        {
            "name": "Type Annotations",
            "scope": [
                "entity.name.type",
                "support.type",
                "entity.name.type.class"
            ],
            "settings": { "foreground": "#C8A8E8" }
        },
        {
            "name": "Decorators",
            "scope": [
                "meta.annotation variable.function",
                "meta.annotation variable.annotation.function",
                "meta.annotation punctuation.definition.annotation",
                "meta.decorator",
                "punctuation.decorator"
            ],
            "settings": { "foreground": "#FF7F7F" }
        },
        {
            "name": "Python Magic Functions",
            "scope": ["support.function.magic.python"],
            "settings": { "foreground": "#30D5C8" }
        },
        {
            "name": "Python Self Parameter",
            "scope": [
                "variable.parameter.function.language.special.self.python",
                "variable.language.special.self.python"
            ],
            "settings": { "foreground": "#87C5C5" }
        },
        {
            "name": "Python Function Decorators",
            "scope": [
                "entity.name.function.decorator.python",
                "punctuation.definition.decorator.python"
            ],
            "settings": { "foreground": "#FFEDA1" }
        },
        {
            "name": "Rust Attributes",
            "scope": [
                "meta.annotation.rust",
                "meta.annotation.rust punctuation",
                "meta.attribute.rust",
                "punctuation.definition.attribute.rust"
            ],
            "settings": { "foreground": "#85C1E9" }
        },
        {
            "name": "Rust Macros",
            "scope": [
                "support.macro.rust",
                "meta.macro.rust support.function.rust",
                "entity.name.function.macro.rust"
            ],
            "settings": { "foreground": "#30D5C8" }
        },
        {
            "name": "Rust Lifetimes",
            "scope": [
                "storage.modifier.lifetime.rust",
                "entity.name.type.lifetime"
            ],
            "settings": { "foreground": "#A8C8E1" }
        },
        {
            "name": "Julia Macros",
            "scope": "support.function.macro.julia",
            "settings": { "foreground": "#30D5C8" }
        }
    ],
    "semanticTokenColors": {
        "parameter": { "foreground": "#D4E9FF" },
        "property": "#98D8C8",
        "variable.readonly": "#E1F0FF",
        "enumMember": "#F4D03F",
        "type": { "foreground": "#C8A8E9" },
        "function": "#81D4E6",
        "method": { "foreground": "#66E5FF" },
        "namespace": "#85C1E9"
    },
    "$schema": "vscode://schemas/color-theme"
}
