        "breadcrumb.foreground": "#85929E",
        "breadcrumb.focusForeground": "#E8F4F8",
        "breadcrumb.activeSelectionForeground": "#E8F4F8",
        "breadcrumbPicker.background": "#252B3D",
        "editorBracketHighlight.foreground1": "#85C1E9",
