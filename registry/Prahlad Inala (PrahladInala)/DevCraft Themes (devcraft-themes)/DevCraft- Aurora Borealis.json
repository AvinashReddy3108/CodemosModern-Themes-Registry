        "minimap.wordHighlightStrongBackground": "#88c0d050"
    },
    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#4c566a", "fontStyle": "italic" }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "storage.type",
                "storage.modifier",
                "keyword.control"
            ],
            "settings": { "foreground": "#81a1c1", "fontStyle": "bold" }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call.generic"
            ],
            "settings": { "foreground": "#88c0d0" }
        },
        {
            "name": "Strings",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#a3be8c" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "variable.other.readwrite"],
            "settings": { "foreground": "#d8dee9" }
        },
        {
            "name": "Types & Classes",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.type",
                "support.class"
            ],
            "settings": { "foreground": "#8fbcbb" }
        },
        {
            "name": "Numbers",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#b48ead" }
        },
        {
            "name": "Operators",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#81a1c1" }
        },
        {
            "name": "Constants",
            "scope": ["constant", "constant.language"],
            "settings": { "foreground": "#b48ead", "fontStyle": "bold" }
        },
        {
            "name": "JSX Tags",
            "scope": ["entity.name.tag", "support.class.component"],
            "settings": { "foreground": "#81a1c1" }
        },
        {
            "name": "Attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#8fbcbb" }
        },
        {
            "name": "Decorators",
            "scope": ["meta.decorator", "punctuation.decorator"],
            "settings": { "foreground": "#ebcb8b", "fontStyle": "italic" }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "variable": "#d8dee9",
        "variable.readonly": "#81a1c1",
        "function": "#88c0d0",
        "method": "#88c0d0",
        "class": "#8fbcbb",
        "interface": "#8fbcbb",
        "type": "#8fbcbb",
        "parameter": "#d8dee9",
        "property": "#d8dee9",
        "enumMember": "#b48ead"
    },
    "$schema": "vscode://schemas/color-theme"
}
