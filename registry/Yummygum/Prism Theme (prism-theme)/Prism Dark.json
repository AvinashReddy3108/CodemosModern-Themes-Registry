{
    "name": "Prism",
    "type": "dark",
    "colors": { "editor.background": "#17181B" },
    "tokenColors": [
        {
            "scope": "comment",
            "settings": { "foreground": "#4C4F59", "fontStyle": "italic" }
        },
        { "scope": "string", "settings": { "foreground": "#61B2FF" } },
        { "scope": "constant", "settings": { "foreground": "#F1ADE0" } },
        { "scope": "variable", "settings": { "foreground": "#828FFF" } },
        { "scope": "keyword", "settings": { "foreground": "#8D96B4" } },
        { "scope": "storage", "settings": { "foreground": "#C8D7FF" } },
        { "scope": "entity", "settings": { "foreground": "#7DC6C6" } },
        { "scope": "support", "settings": { "foreground": "#FCC581" } },
        { "scope": "markup", "settings": { "foreground": "#6c7c83" } },
        { "scope": "punctuation", "settings": { "foreground": "#6C7183" } },
        {
            "scope": "invalid",
            "settings": { "foreground": "#E86D68", "fontStyle": "underline" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
