    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#59626f", "fontStyle": "italic" }
        },
        {
            "name": "Doc comments",
            "scope": [
                "comment.block.documentation",
                "comment.line.documentation"
            ],
            "settings": { "foreground": "#59626f", "fontStyle": "italic" }
        },
        {
            "name": "Doc comment tags",
            "scope": [
                "keyword.other.documentation",
                "storage.type.annotation",
                "punctuation.definition.annotation"
            ],
            "settings": { "foreground": "#c679dd", "fontStyle": "bold italic" }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.new",
                "keyword.operator.expression",
                "keyword.operator.logical",
                "storage",
                "storage.type",
                "storage.modifier"
            ],
            "settings": { "foreground": "#c679dd", "fontStyle": "italic" }
        },
        {
            "name": "Strings",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#98c379" }
        },
        {
            "name": "Python docstrings",
            "scope": [
                "string.quoted.docstring.multi.python",
                "string.quoted.docstring.raw.multi.python"
            ],
            "settings": { "foreground": "#59626f", "fontStyle": "italic" }
        },
        {
            "name": "String escapes",
            "scope": ["constant.character.escape", "string.regexp"],
            "settings": { "foreground": "#98c379" }
        },
        {
            "name": "Numbers",
            "scope": ["constant.numeric", "constant.other.color"],
            "settings": { "foreground": "#d19a66" }
        },
        {
            "name": "Constants / Boolean",
            "scope": [
                "constant",
                "constant.language",
                "variable.language.this",
                "variable.language.self"
            ],
            "settings": { "foreground": "#d19a66" }
        },
        {
            "name": "Class names",
            "scope": ["entity.name.type", "entity.name.class", "support.class"],
            "settings": { "foreground": "#e5c17c" }
        },
        {
            "name": "Abstract / Interface names",
            "scope": ["entity.other.inherited-class"],
            "settings": { "foreground": "#98c379", "fontStyle": "italic" }
        },
        {
            "name": "Class references / types",
            "scope": [
                "entity.name.type.class",
                "support.type",
                "entity.name.namespace",
                "meta.type-alias entity.name.type"
            ],
            "settings": { "foreground": "#c679dd" }
        },
        {
            "name": "Function names",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call entity.name.function"
            ],
            "settings": { "foreground": "#61aeef" }
        },
        {
            "name": "Static methods",
            "scope": [
                "entity.name.function.static",
                "meta.static entity.name.function"
            ],
            "settings": { "foreground": "#61aeef", "fontStyle": "italic" }
        },
        {
            "name": "Parameters",
            "scope": [
                "variable.parameter",
                "meta.function.parameters variable"
            ],
            "settings": { "foreground": "#abb2bf" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "variable.other.readwrite"],
            "settings": { "foreground": "#d19a66" }
        },
        {
            "name": "Instance fields / properties",
            "scope": [
                "variable.other.property",
                "variable.other.object.property",
                "support.variable.property",
                "variable.other.member"
            ],
            "settings": { "foreground": "#e06c75" }
        },
        {
            "name": "Static fields",
            "scope": ["variable.other.static", "variable.other.constant"],
            "settings": { "foreground": "#e06c75", "fontStyle": "italic" }
        },
        {
            "name": "Global variables",
            "scope": ["variable.other.global"],
            "settings": { "foreground": "#d19a66" }
        },
        {
            "name": "Decorators / Annotations / Metadata",
            "scope": [
                "entity.name.function.decorator",
                "meta.decorator",
                "punctuation.decorator"
            ],
            "settings": { "foreground": "#61aeef" }
        },
        {
            "name": "Operators",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#61afef" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation",
                "meta.brace",
                "punctuation.definition.block",
                "punctuation.definition.parameters",
                "punctuation.separator.delimiter"
            ],
            "settings": { "foreground": "#abb2bf" }
        },
        {
            "name": "HTML/XML Tag names",
            "scope": ["entity.name.tag", "meta.tag"],
            "settings": { "foreground": "#f07178" }
        },
        {
            "name": "HTML/XML Attributes",
            "scope": [
                "entity.other.attribute-name",
                "meta.tag.attributes entity.other.attribute-name"
            ],
            "settings": { "foreground": "#e5c17c", "fontStyle": "italic" }
        },
        {
            "name": "HTML/XML Attribute values",
            "scope": ["meta.attribute string"],
            "settings": { "foreground": "#98c379" }
        },
        {
            "name": "CSS Property names",
            "scope": ["support.type.property-name.css", "meta.property-name"],
            "settings": { "foreground": "#57b6c2" }
        },
        {
            "name": "CSS Property values",
            "scope": [
                "support.constant.property-value.css",
                "meta.property-value"
            ],
            "settings": { "foreground": "#d19a66" }
        },
        {
            "name": "CSS Tag selectors",
            "scope": ["entity.name.tag.css"],
            "settings": { "foreground": "#f07178" }
        },
        {
            "name": "CSS Class selectors",
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css"
            ],
            "settings": { "foreground": "#e5c17c" }
        },
        {
            "name": "CSS Keywords / Important",
            "scope": ["keyword.other.important.css", "keyword.other.unit.css"],
            "settings": { "foreground": "#c679dd", "fontStyle": "italic" }
        },
        {
            "name": "CSS Colors",
            "scope": ["constant.other.color.rgb-value.css"],
            "settings": { "foreground": "#ffea7d" }
        },
        {
            "name": "CSS Functions",
            "scope": [
                "support.function.transform.css",
                "support.function.misc.css"
            ],
            "settings": { "foreground": "#61aeef" }
        },
        {
            "name": "CSS Pseudo selectors",
            "scope": [
                "entity.other.attribute-name.pseudo-class.css",
                "entity.other.attribute-name.pseudo-element.css"
            ],
            "settings": { "foreground": "#eeffff" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#e06c75" }
        },
        {
            "name": "Deprecated",
            "scope": ["invalid.deprecated"],
            "settings": { "foreground": "#59626f" }
        },
        {
            "name": "Imports / Includes",
            "scope": [
                "keyword.control.import",
                "keyword.control.export",
                "keyword.other.import"
            ],
            "settings": { "foreground": "#c679dd", "fontStyle": "italic" }
        },
        {
            "name": "Module names",
            "scope": ["entity.name.module", "support.module"],
            "settings": { "foreground": "#e5c17c" }
        },
        {
            "name": "JSON keys",
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#e06c75" }
        },
        {
            "name": "JSON string values",
            "scope": ["string.quoted.double.json", "string.quoted.single.json"],
            "settings": { "foreground": "#98c379" }
        },
        {
            "name": "Markdown headings",
            "scope": ["markup.heading", "entity.name.section"],
            "settings": { "foreground": "#61aeef", "fontStyle": "bold" }
        },
        {
            "name": "Markdown bold",
            "scope": ["markup.bold"],
            "settings": { "foreground": "#abb2bf", "fontStyle": "bold" }
        },
        {
            "name": "Markdown italic",
            "scope": ["markup.italic"],
            "settings": { "foreground": "#abb2bf", "fontStyle": "italic" }
        },
        {
            "name": "Markdown code",
            "scope": ["markup.inline.raw", "markup.fenced_code.block"],
            "settings": { "foreground": "#98c379" }
        },
        {
            "name": "Markdown links",
            "scope": ["markup.underline.link", "string.other.link"],
            "settings": { "foreground": "#56b6c2" }
        },
        {
            "name": "Markdown blockquote",
            "scope": ["markup.quote"],
            "settings": { "foreground": "#59626f", "fontStyle": "italic" }
        },
        {
            "name": "Diff inserted",
            "scope": ["markup.inserted"],
            "settings": { "foreground": "#98c379" }
        },
        {
            "name": "Diff deleted",
            "scope": ["markup.deleted"],
            "settings": { "foreground": "#e06c75" }
        },
        {
            "name": "Diff changed",
            "scope": ["markup.changed"],
            "settings": { "foreground": "#61aeef" }
        },
        {
            "name": "Python self / cls",
            "scope": [
                "variable.language.special.self.python",
                "variable.language.special.cls.python"
            ],
            "settings": { "foreground": "#e06c75", "fontStyle": "italic" }
        },
        {
            "name": "Python built-in functions",
            "scope": ["support.function.builtin.python"],
            "settings": { "foreground": "#61aeef" }
        },
        {
            "name": "Python magic methods",
            "scope": ["support.function.magic.python"],
            "settings": { "foreground": "#61aeef", "fontStyle": "italic" }
        },
        {
            "name": "JavaScript / TypeScript object keys",
            "scope": ["meta.object-literal.key", "meta.objectliteral string"],
            "settings": { "foreground": "#e06c75" }
        },
        {
            "name": "JavaScript this",
            "scope": ["variable.language.this.js", "variable.language.this.ts"],
            "settings": { "foreground": "#e06c75", "fontStyle": "italic" }
        },
        {
            "name": "TypeScript type annotations",
            "scope": [
                "meta.type.annotation",
                "meta.return.type",
                "meta.type.parameters"
            ],
            "settings": { "foreground": "#c679dd" }
        },
        {
            "name": "Shell built-in / external commands",
            "scope": [
                "support.function.builtin.shell",
                "entity.name.function.shell"
            ],
            "settings": { "foreground": "#4babb8", "fontStyle": "italic" }
        },
        {
            "name": "Regex",
            "scope": ["string.regexp"],
            "settings": { "foreground": "#98c379" }
        },
        {
            "name": "Regex operators / groups",
            "scope": [
                "keyword.control.anchor.regexp",
                "punctuation.definition.group.regexp",
                "keyword.operator.quantifier.regexp"
            ],
            "settings": { "foreground": "#61afef" }
        },
        {
            "name": "Python member attribute access",
            "scope": ["meta.attribute.python"],
            "settings": { "foreground": "#abb2bf" }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "class": "#61aeef",
        "interface": { "foreground": "#98c379", "italic": true },
        "enum": "#e5c17c",
        "enumMember": "#d19a66",
        "function": "#61aeef",
        "method": "#61aeef",
        "method.static": { "foreground": "#61aeef", "italic": true },
        "function.defaultLibrary": { "foreground": "#61aeef", "bold": true },
        "property": "#e06c75",
        "property.static": { "foreground": "#abb2bf", "italic": true },
        "parameter": "#abb2bf",
        "variable": "#abb2bf",
        "variable.constant": { "foreground": "#d19a66", "bold": true },
        "variable.defaultLibrary": { "foreground": "#d19a66", "italic": true },
        "type": "#c679dd",
        "typeParameter": "#c679dd",
        "namespace": "#e5c17c",
        "keyword": { "foreground": "#c679dd", "italic": true },
        "decorator": "#61aeef",
        "annotation": "#61aeef",
        "string": "#98c379",
        "number": "#d19a66",
        "regexp": "#98c379",
        "operator": "#61afef",
        "selfParameter": { "foreground": "#e06c75", "italic": true },
        "clsParameter": { "foreground": "#e06c75", "italic": true },
        "macro": { "foreground": "#61aeef", "bold": true },
        "label": "#c3d3de",
        "variable.readonly": { "foreground": "#d19a66", "bold": true },
        "variable.declaration.readonly": {
            "foreground": "#d19a66",
            "bold": true
        },
        "function.static": { "foreground": "#61aeef", "italic": true },
        "field.static": { "foreground": "#e06c75", "italic": true }
    }
}
