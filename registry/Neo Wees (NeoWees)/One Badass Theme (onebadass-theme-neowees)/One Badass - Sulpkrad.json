        "button.hoverBackground": "#0065D8",
        "diffEditor.insertedTextBackground": "#00809B33",
        "dropdown.background": "#353b45",
        "dropdown.border": "#181A1F",
        "editor.background": "#151920",
        "editor.foreground": "#cbd7ee",
        "editor.lineHighlightBackground": "#99BBFF13",
        "editor.selectionBackground": "#3E4451",
        "editorCursor.foreground": "#0057B9",
        "editor.findMatchHighlightBackground": "#003C963D",
        "editorGroup.border": "#181A1F",
