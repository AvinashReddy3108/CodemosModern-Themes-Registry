    "semanticHighlighting": true,
    "semanticTokenColors": {
        "controlKeyword": "#cc8242",
        "decorator": "#b7410e",
        "event": { "foreground": "#880000", "bold": true },
        "label": "#ffa500",
        "regexp": { "foreground": "#ffa500", "underline": true },
        "operator": "#b7410e"
    },
    "tokenColors": [
        {
            "name": "Namespaces and Variables",
            "scope": [
                "entity.name.namespace",
                "entity.name.module",
                "entity.name.variable",
                "variable.other.readwrite",
                "variable.language",
                "variable.other",
                "entity.name.tag"
            ],
            "settings": { "foreground": "#ff6600" }
        },
        {
            "name": "Types and Numbers",
            "scope": [
                "entity.other.attribute-name",
                "entity.other",
                "entity.name.type.class",
                "entity.name.type.enum",
                "entity.name.type.interface",
                "storage.type.struct",
                "entity.name.type",
                "constant.numeric",
                "meta.use",
                "keyword.type",
                "support.type"
            ],
            "settings": { "foreground": "#ff2400" }
        },
        {
            "name": "Parameters",
            "scope": ["variable.parameter", "variable.argument"],
            "settings": {
                "foreground": "#ff6600",
                "fontStyle": "italic underline"
            }
        },
        {
            "name": "Type Members",
            "scope": [
                "variable.other.property",
                "variable.other.object.property",
                "variable.other.enummember",
                "variable.other.event",
                "support.variable.property",
                "meta.object.member",
                "entity.name.variable.property",
                "entity.name.variable.field",
                "meta.property-value",
                "meta.property-list"
            ],
            "settings": { "foreground": "#880000", "fontStyle": "bold" }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "support.function",
                "entity.name.function.member",
                "entity.name.function.macro",
                "meta.function-call",
                "storage.type.accessor"
            ],
            "settings": { "foreground": "#ffc66d" }
        },
        {
            "name": "Constants",
            "scope": [
                "variable.other.constant",
                "support.constant",
                "constant.character",
                "constant.escape",
                "constant.language",
                "constant.other"
            ],
            "settings": { "foreground": "#ffa500" }
        },
        {
            "name": "Attributes, Operators, Punctuation",
            "scope": [
                "entity.attribute-name",
                "keyword.operator",
                "keyword.symbol",
                "punctuation",
                "meta.attribute",
                "meta.brace"
            ],
            "settings": { "foreground": "#b7410e" }
        },
        {
            "name": "Comments",
            "scope": [
                "comment.line",
                "comment.double-slash",
                "comment.double-dash",
                "comment.number-sign",
                "comment.percentage",
                "comment.character",
                "comment.block",
                "comment.documentation",
                "string.interpolated",
                "comment.line.double-slash",
                "punctuation.definition.comment"
            ],
            "settings": { "foreground": "#ffa500", "fontStyle": "italic" }
        },
        {
            "name": "Regex",
            "scope": "string.regexp",
            "settings": { "foreground": "#ffa500", "fontStyle": "underline" }
        },
        {
            "name": "Strings",
            "scope": [
                "string.quoted",
                "string.single",
                "string.double",
                "string.triple",
                "string.other",
                "string.unquoted",
                "string.template",
                "text",
                "source.tsx",
                "source.js.jsx"
            ],
            "settings": { "foreground": "#6a8759" }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword.other",
                "keyword.control.flow",
                "keyword.control.conditional",
                "keyword.control.context",
                "keyword.control.cshtml",
                "keyword.control.loop",
                "keyword.control.razor",
                "keyword.control.import",
                "keyword.control.export",
                "keyword.control.go",
                "storage.modifier",
                "storage.type.var",
                "storage.type",
                "meta.import",
                "meta.export",
                "keyword.control.at-rule",
                "keyword.fsharp",
                "source.zig",
                "keyword.control.switch",
                "keyword.package",
                "keyword.function",
                "keyword.struct",
                "keyword.map",
                "keyword"
            ],
            "settings": { "foreground": "#cc8242" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
