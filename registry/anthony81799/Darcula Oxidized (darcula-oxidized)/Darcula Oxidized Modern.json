        "welcomePage.progress.foreground": "#0078D4",
        "widget.border": "#313131"
    },
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "namespace": "#ff6600",
        "class": "#ff2400",
        "enum": "#ff2400",
        "interface": "#ff2400",
        "struct": "#ff2400",
        "typeParameter": "#ff6600",
        "type": "#ff2400",
        "parameter": {
            "foreground": "#ff6600",
            "italic": true,
            "underline": true
        },
        "variable": "#ff6600",
        "variable.readonly": "#ffa500",
        "property": { "foreground": "#880000", "bold": true },
        "enumMember": { "foreground": "#880000", "bold": true },
        "decorator": "#b7410e",
        "event": { "foreground": "#880000", "bold": true },
        "function": "#ffc66d",
        "method": "#ffc66d",
        "macro": "#ffc66d",
        "label": "#ffa500",
        "comment": "#ffa500",
        "string": "#6a8759",
        "keyword": "#cc8242",
        "number": "#ff2400",
        "regexp": { "foreground": "#ffa500", "underline": true },
        "operator": "#b7410e"
    },
    "tokenColors": [
        {
            "name": "Namespaces and Variables",
            "scope": [
                "entity.name.namespace",
                "entity.name.module",
                "entity.name.variable",
                "variable.other.readwrite",
                "variable.language",
                "variable.other",
                "entity.name.tag"
            ],
            "settings": { "foreground": "#ff6600" }
        },
        {
            "name": "Types and Numbers",
            "scope": [
                "entity.other.attribute-name",
                "entity.name.type.class",
                "entity.name.type.enum",
                "entity.name.type.interface",
                "storage.type.struct",
                "entity.name.type",
                "constant.numeric",
                "meta.use",
                "keyword.type",
                "support.type"
            ],
            "settings": { "foreground": "#ff2400" }
        },
        {
            "name": "Parameters",
            "scope": "variable.parameter",
            "settings": {
                "foreground": "#ff6600",
                "fontStyle": "italic underline"
            }
        },
        {
            "name": "Type Members",
            "scope": [
                "variable.other.property",
                "variable.other.enummember",
                "variable.other.event",
                "support.variable.property",
                "meta.object.member"
            ],
            "settings": { "foreground": "#880000", "fontStyle": "bold" }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "support.function",
                "entity.name.function.member",
                "entity.name.function.macro"
            ],
            "settings": { "foreground": "#ffc66d" }
        },
        {
            "name": "Constants",
            "scope": [
                "variable.other.constant",
                "support.constant",
                "constant.character",
                "constant.escape",
                "constant.language",
                "constant.other"
            ],
            "settings": { "foreground": "#ffa500" }
        },
        {
            "name": "Attributes, Operators, Punctuation",
            "scope": [
                "entity.attribute-name",
                "keyword.operator",
                "punctuation",
                "meta.attribute",
                "meta.brace"
            ],
            "settings": { "foreground": "#b7410e" }
        },
        {
            "name": "Comments",
            "scope": [
                "comment.line",
                "comment.double-slash",
                "comment.double-dash",
                "comment.number-sign",
                "comment.percentage",
                "comment.character",
                "comment.block",
                "comment.documentation",
                "string.interpolated"
            ],
            "settings": { "foreground": "#ffa500" }
        },
        {
            "name": "Regex",
            "scope": "string.regexp",
            "settings": { "foreground": "#ffa500", "fontStyle": "underline" }
        },
        {
            "name": "Strings",
            "scope": [
                "string.quoted",
                "string.single",
                "string.double",
                "string.triple",
                "string.other",
                "string.unquoted",
                "string.template"
            ],
            "settings": { "foreground": "#6a8759" }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.other",
                "storage.type",
                "storage.modifier"
            ],
            "settings": { "foreground": "#cc8242" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
