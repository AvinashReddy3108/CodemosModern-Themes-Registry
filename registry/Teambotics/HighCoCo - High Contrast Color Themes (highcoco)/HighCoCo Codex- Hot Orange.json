{
    "name": "HighCoCo Codex: Hot Orange",
    "$schema": "vscode://schemas/color-theme",
    "type": "dark",
    "colors": {
        "focusBorder": "#FF6B0088",
        "foreground": "#ECF7FF",
        "disabledForeground": "#6C7A86",
        "widget.shadow": "#00000066",
        "selection.background": "#FF6B0028",
        "descriptionForeground": "#93A6B4",
        "errorForeground": "#FF4466",
        "icon.foreground": "#FFB066",
        "editor.background": "#130B07",
        "editor.foreground": "#ECF7FF",
        "editor.selectionBackground": "#FF6B002E",
        "editor.selectionHighlightBackground": "#FF6B001A",
        "editor.lineHighlightBackground": "#FF6B000C",
        "editor.lineHighlightBorder": "#00000000",
        "editor.findMatchBackground": "#00D8FF3C",
        "editor.findMatchHighlightBackground": "#00D8FF20",
        "editorCursor.foreground": "#FF6B00",
        "editorLineNumber.foreground": "#7B6658",
        "editorLineNumber.activeForeground": "#FF6B00",
        "editorWhitespace.foreground": "#4A2818",
        "editorIndentGuide.background1": "#4A2818",
        "editorIndentGuide.activeBackground1": "#FF6B0055",
        "editorRuler.foreground": "#4A2818",
        "editorBracketMatch.background": "#FF6B0022",
        "editorBracketMatch.border": "#FF6B00",
        "editorGutter.background": "#130B07",
        "editorGutter.addedBackground": "#39FF14",
        "editorGutter.modifiedBackground": "#FF6B00",
        "editorGutter.deletedBackground": "#FF4466",
        "editorError.foreground": "#FF4466",
        "editorWarning.foreground": "#FFD700",
        "editorInfo.foreground": "#FFB066",
        "activityBar.background": "#110906",
        "activityBar.foreground": "#FF6B00",
        "activityBar.inactiveForeground": "#7B6658",
        "activityBar.border": "#4A2818",
        "activityBar.activeBorder": "#FF6B00",
        "activityBarBadge.background": "#FF6B00",
        "activityBarBadge.foreground": "#140800",
        "sideBar.background": "#160D08",
        "sideBar.foreground": "#ECF7FF",
        "sideBar.border": "#4A2818",
        "sideBarTitle.foreground": "#FF6B00",
        "sideBarSectionHeader.background": "#110906",
        "sideBarSectionHeader.foreground": "#FFB066",
        "sideBarSectionHeader.border": "#4A2818",
        "editorGroupHeader.tabsBackground": "#110906",
        "editorGroup.border": "#4A2818",
        "tab.activeBackground": "#160D08",
        "tab.activeForeground": "#FF6B00",
        "tab.activeBorderTop": "#FF6B00",
        "tab.inactiveBackground": "#110906",
        "tab.inactiveForeground": "#7B6658",
        "tab.border": "#4A2818",
        "tab.hoverBackground": "#FF6B0014",
        "panel.background": "#110906",
        "panel.border": "#4A2818",
        "panelTitle.activeForeground": "#FF6B00",
        "panelTitle.inactiveForeground": "#7B6658",
        "panelTitle.activeBorder": "#FF6B00",
        "terminal.background": "#110906",
        "terminal.foreground": "#ECF7FF",
        "terminal.ansiBlack": "#4A2818",
        "terminal.ansiRed": "#FF4466",
        "terminal.ansiGreen": "#39FF14",
        "terminal.ansiYellow": "#FFD700",
        "terminal.ansiBlue": "#FF6B00",
        "terminal.ansiMagenta": "#00D8FF",
        "terminal.ansiCyan": "#00FFE5",
        "terminal.ansiWhite": "#ECF7FF",
        "terminal.ansiBrightBlack": "#7B6658",
        "terminal.ansiBrightRed": "#FF6688",
        "terminal.ansiBrightGreen": "#66FF88",
        "terminal.ansiBrightYellow": "#FFE066",
        "terminal.ansiBrightBlue": "#FFB066",
        "terminal.ansiBrightMagenta": "#7FE9FF",
        "terminal.ansiBrightCyan": "#85FFF6",
        "terminal.ansiBrightWhite": "#ECF7FF",
        "statusBar.background": "#FF6B00",
        "statusBar.foreground": "#140800",
        "statusBar.border": "#FFB066",
        "statusBar.debuggingBackground": "#00D8FF",
        "statusBar.debuggingForeground": "#140800",
        "button.background": "#FF6B00",
        "button.foreground": "#140800",
        "button.hoverBackground": "#FFB066",
        "button.secondaryBackground": "#4A2818",
        "button.secondaryForeground": "#ECF7FF",
        "button.secondaryHoverBackground": "#7B6658",
        "input.background": "#110906",
        "input.border": "#4A2818",
        "input.foreground": "#ECF7FF",
        "input.placeholderForeground": "#7B6658",
        "inputOption.activeBorder": "#FF6B00",
        "inputOption.activeBackground": "#FF6B0022",
        "dropdown.background": "#110906",
        "dropdown.border": "#4A2818",
        "dropdown.foreground": "#ECF7FF",
        "badge.background": "#FF6B00",
        "badge.foreground": "#140800",
        "menu.background": "#110906",
        "menu.foreground": "#ECF7FF",
        "menu.selectionBackground": "#FF6B0022",
        "menu.selectionForeground": "#FF6B00",
        "menu.separatorBackground": "#4A2818",
        "notifications.background": "#110906",
        "notifications.foreground": "#ECF7FF",
        "notifications.border": "#FF6B0044",
        "breadcrumb.background": "#130B07",
        "breadcrumb.foreground": "#7B6658",
        "breadcrumb.activeSelectionForeground": "#FF6B00",
        "minimap.background": "#130B07",
        "minimap.selectionHighlight": "#FF6B0044",
        "minimap.findMatchHighlight": "#00D8FF66",
        "minimap.errorHighlight": "#FF4466",
        "gitDecoration.addedResourceForeground": "#39FF14",
        "gitDecoration.modifiedResourceForeground": "#FF6B00",
        "gitDecoration.deletedResourceForeground": "#FF4466",
        "gitDecoration.untrackedResourceForeground": "#FFB066",
        "gitDecoration.ignoredResourceForeground": "#7B6658",
        "gitDecoration.conflictingResourceForeground": "#00D8FF"
    },
    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#7B6658", "fontStyle": "italic" }
        },
        {
            "name": "String",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#00D8FF" }
        },
        {
            "name": "String escape",
            "scope": ["constant.character.escape", "string.regexp"],
            "settings": { "foreground": "#7FE9FF" }
        },
        {
            "name": "Keyword",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.new",
                "keyword.other.important"
            ],
            "settings": { "foreground": "#FF6B00", "fontStyle": "bold" }
        },
        {
            "name": "Storage",
            "scope": ["storage.type", "storage.modifier"],
            "settings": { "foreground": "#FF6B00", "fontStyle": "bold" }
        },
        {
            "name": "Function name",
            "scope": [
                "entity.name.function",
                "meta.function-call entity.name.function",
                "support.function"
            ],
            "settings": { "foreground": "#FFB066" }
        },
        {
            "name": "Class / Type name",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.class",
                "support.type"
            ],
            "settings": { "foreground": "#ECF7FF" }
        },
        {
            "name": "Inherited class",
            "scope": ["entity.other.inherited-class"],
            "settings": { "foreground": "#FFB066", "fontStyle": "italic" }
        },
        {
            "name": "Variable",
            "scope": ["variable", "variable.other.readwrite"],
            "settings": { "foreground": "#ECF7FF" }
        },
        {
            "name": "Variable parameter",
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#7FE9FF", "fontStyle": "italic" }
        },
        {
            "name": "Constant",
            "scope": ["variable.other.constant", "constant.other"],
            "settings": { "foreground": "#00D8FF", "fontStyle": "bold" }
        },
        {
            "name": "Number",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#00D8FF" }
        },
        {
            "name": "Boolean / Null / Undefined",
            "scope": ["constant.language"],
            "settings": { "foreground": "#FF6B00", "fontStyle": "bold" }
        },
        {
            "name": "Tag",
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#FF6B00" }
        },
        {
            "name": "Attribute name",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#FFB066" }
        },
        {
            "name": "Operator",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#FFB066" }
        },
        {
            "name": "Punctuation",
            "scope": ["punctuation", "meta.brace", "punctuation.accessor"],
            "settings": { "foreground": "#7B6658" }
        },
        {
            "name": "Property / Field",
            "scope": [
                "variable.other.property",
                "support.variable.property",
                "variable.other.object.property"
            ],
            "settings": { "foreground": "#7FE9FF" }
        },
        {
            "name": "Invalid / Deprecated",
            "scope": ["invalid", "invalid.illegal", "invalid.deprecated"],
            "settings": { "foreground": "#FF4466", "fontStyle": "underline" }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "variable": "#ECF7FF",
        "variable.declaration": "#ECF7FF",
        "variable.readonly": "#00D8FF",
        "property": "#7FE9FF",
        "property.declaration": "#FFB066",
        "class": "#ECF7FF",
        "interface": "#ECF7FF",
        "function": "#FFB066",
        "method": "#FFB066",
        "parameter": { "foreground": "#7FE9FF", "italic": true },
        "type": "#ECF7FF",
        "enum": "#00D8FF",
        "enumMember": "#00D8FF",
        "namespace": "#FF6B00",
        "decorator": "#7FE9FF",
        "keyword": { "foreground": "#FF6B00", "bold": true },
        "comment": { "foreground": "#7B6658", "italic": true },
        "number": "#00D8FF",
        "string": "#00D8FF",
        "operator": "#FFB066",
        "typeParameter": "#FFB066",
        "macro": "#7FE9FF",
        "event": "#FFB066",
        "label": "#FF6B00",
        "regexp": "#FF4466"
    }
}
