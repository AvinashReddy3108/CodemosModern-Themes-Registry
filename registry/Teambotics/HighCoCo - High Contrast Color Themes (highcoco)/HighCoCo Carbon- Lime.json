    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#6A6258", "fontStyle": "italic" }
        },
        {
            "name": "String",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#FF00AA" }
        },
        {
            "name": "String escape",
            "scope": ["constant.character.escape", "string.regexp"],
            "settings": { "foreground": "#CC0088" }
        },
        {
            "name": "Keyword",
            "scope": [
                "keyword",
                "keyword.control",
                "storage.type",
                "storage.modifier"
            ],
            "settings": { "foreground": "#AAFF00", "fontStyle": "bold" }
        },
        {
            "name": "Function name",
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#AAFF00BB" }
        },
        {
            "name": "Class / Type",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.class",
                "support.type"
            ],
            "settings": { "foreground": "#AAFF0088" }
        },
        {
            "name": "Variable",
            "scope": ["variable", "variable.other.readwrite"],
            "settings": { "foreground": "#F0EDE8" }
        },
        {
            "name": "Variable parameter",
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#E0FFAA", "fontStyle": "italic" }
        },
        {
            "name": "Constant",
            "scope": ["variable.other.constant", "constant.other"],
            "settings": { "foreground": "#FF00AA", "fontStyle": "bold" }
        },
        {
            "name": "Number",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#FF00AA" }
        },
        {
            "name": "Boolean / Null",
            "scope": ["constant.language"],
            "settings": { "foreground": "#AAFF00", "fontStyle": "bold" }
        },
        {
            "name": "Tag",
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#AAFF00" }
        },
        {
            "name": "Attribute name",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#AAFF00BB" }
        },
        {
            "name": "Operator",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#AAFF0088" }
        },
        {
            "name": "Punctuation",
            "scope": ["punctuation", "meta.brace"],
            "settings": { "foreground": "#504844" }
        },
        {
            "name": "Property",
            "scope": ["variable.other.property", "support.variable.property"],
            "settings": { "foreground": "#D8D4CE" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#FF5577", "fontStyle": "underline" }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "variable": "#F0EDE8",
        "variable.readonly": { "foreground": "#FF00AA" },
        "property": "#D8D4CE",
        "property.declaration": "#AAFF00BB",
        "class": { "foreground": "#AAFF0088" },
        "interface": { "foreground": "#AAFF0088" },
        "function": "#AAFF00BB",
        "method": "#AAFF00BB",
        "parameter": { "foreground": "#E0FFAA", "italic": true },
        "type": "#AAFF0088",
        "enum": "#FF00AA",
        "enumMember": "#FF00AA",
        "namespace": "#AAFF00",
        "keyword": { "foreground": "#AAFF00", "bold": true }
    }
}
