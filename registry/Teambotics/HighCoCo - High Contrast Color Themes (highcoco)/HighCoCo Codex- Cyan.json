{
    "name": "HighCoCo Codex: Cyan",
    "$schema": "vscode://schemas/color-theme",
    "type": "dark",
    "colors": {
        "focusBorder": "#00FFE588",
        "foreground": "#ECF7FF",
        "disabledForeground": "#6C7A86",
        "widget.shadow": "#00000066",
        "selection.background": "#00FFE528",
        "descriptionForeground": "#93A6B4",
        "errorForeground": "#FF4466",
        "icon.foreground": "#85FFF6",
        "editor.background": "#071214",
        "editor.foreground": "#ECF7FF",
        "editor.selectionBackground": "#00FFE52E",
        "editor.selectionHighlightBackground": "#00FFE51A",
        "editor.lineHighlightBackground": "#00FFE50C",
        "editor.lineHighlightBorder": "#00000000",
        "editor.findMatchBackground": "#FF6B003C",
        "editor.findMatchHighlightBackground": "#FF6B0020",
        "editorCursor.foreground": "#00FFE5",
        "editorLineNumber.foreground": "#58747A",
        "editorLineNumber.activeForeground": "#00FFE5",
        "editorWhitespace.foreground": "#1C4A4E",
        "editorIndentGuide.background1": "#1C4A4E",
        "editorIndentGuide.activeBackground1": "#00FFE555",
        "editorRuler.foreground": "#1C4A4E",
        "editorBracketMatch.background": "#00FFE522",
        "editorBracketMatch.border": "#00FFE5",
        "editorGutter.background": "#071214",
        "editorGutter.addedBackground": "#39FF14",
        "editorGutter.modifiedBackground": "#00FFE5",
        "editorGutter.deletedBackground": "#FF4466",
        "editorError.foreground": "#FF4466",
        "editorWarning.foreground": "#FFD700",
        "editorInfo.foreground": "#85FFF6",
        "activityBar.background": "#061014",
        "activityBar.foreground": "#00FFE5",
        "activityBar.inactiveForeground": "#58747A",
        "activityBar.border": "#1C4A4E",
        "activityBar.activeBorder": "#00FFE5",
        "activityBarBadge.background": "#00FFE5",
        "activityBarBadge.foreground": "#041618",
        "sideBar.background": "#08181A",
        "sideBar.foreground": "#ECF7FF",
        "sideBar.border": "#1C4A4E",
        "sideBarTitle.foreground": "#00FFE5",
        "sideBarSectionHeader.background": "#061014",
        "sideBarSectionHeader.foreground": "#85FFF6",
        "sideBarSectionHeader.border": "#1C4A4E",
        "editorGroupHeader.tabsBackground": "#061014",
        "editorGroup.border": "#1C4A4E",
        "tab.activeBackground": "#08181A",
        "tab.activeForeground": "#00FFE5",
        "tab.activeBorderTop": "#00FFE5",
        "tab.inactiveBackground": "#061014",
        "tab.inactiveForeground": "#58747A",
        "tab.border": "#1C4A4E",
        "tab.hoverBackground": "#00FFE514",
        "panel.background": "#061014",
        "panel.border": "#1C4A4E",
        "panelTitle.activeForeground": "#00FFE5",
        "panelTitle.inactiveForeground": "#58747A",
        "panelTitle.activeBorder": "#00FFE5",
        "terminal.background": "#061014",
        "terminal.foreground": "#ECF7FF",
        "terminal.ansiBlack": "#1C4A4E",
        "terminal.ansiRed": "#FF4466",
        "terminal.ansiGreen": "#39FF14",
        "terminal.ansiYellow": "#FFD700",
        "terminal.ansiBlue": "#00FFE5",
        "terminal.ansiMagenta": "#FF6B00",
        "terminal.ansiCyan": "#00FFE5",
        "terminal.ansiWhite": "#ECF7FF",
        "terminal.ansiBrightBlack": "#58747A",
        "terminal.ansiBrightRed": "#FF6688",
        "terminal.ansiBrightGreen": "#66FF88",
        "terminal.ansiBrightYellow": "#FFE066",
        "terminal.ansiBrightBlue": "#85FFF6",
        "terminal.ansiBrightMagenta": "#FFB066",
        "terminal.ansiBrightCyan": "#85FFF6",
        "terminal.ansiBrightWhite": "#ECF7FF",
        "statusBar.background": "#00FFE5",
        "statusBar.foreground": "#041618",
        "statusBar.border": "#85FFF6",
        "statusBar.debuggingBackground": "#FF6B00",
        "statusBar.debuggingForeground": "#041618",
        "button.background": "#00FFE5",
        "button.foreground": "#041618",
        "button.hoverBackground": "#85FFF6",
        "button.secondaryBackground": "#1C4A4E",
        "button.secondaryForeground": "#ECF7FF",
        "button.secondaryHoverBackground": "#58747A",
        "input.background": "#061014",
        "input.border": "#1C4A4E",
        "input.foreground": "#ECF7FF",
        "input.placeholderForeground": "#58747A",
        "inputOption.activeBorder": "#00FFE5",
        "inputOption.activeBackground": "#00FFE522",
        "dropdown.background": "#061014",
        "dropdown.border": "#1C4A4E",
        "dropdown.foreground": "#ECF7FF",
        "badge.background": "#00FFE5",
        "badge.foreground": "#041618",
        "menu.background": "#061014",
        "menu.foreground": "#ECF7FF",
        "menu.selectionBackground": "#00FFE522",
        "menu.selectionForeground": "#00FFE5",
        "menu.separatorBackground": "#1C4A4E",
        "notifications.background": "#061014",
        "notifications.foreground": "#ECF7FF",
        "notifications.border": "#00FFE544",
        "breadcrumb.background": "#071214",
        "breadcrumb.foreground": "#58747A",
        "breadcrumb.activeSelectionForeground": "#00FFE5",
        "minimap.background": "#071214",
        "minimap.selectionHighlight": "#00FFE544",
        "minimap.findMatchHighlight": "#FF6B0066",
        "minimap.errorHighlight": "#FF4466",
        "gitDecoration.addedResourceForeground": "#39FF14",
        "gitDecoration.modifiedResourceForeground": "#00FFE5",
        "gitDecoration.deletedResourceForeground": "#FF4466",
        "gitDecoration.untrackedResourceForeground": "#85FFF6",
        "gitDecoration.ignoredResourceForeground": "#58747A",
        "gitDecoration.conflictingResourceForeground": "#FF6B00"
    },
    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#58747A", "fontStyle": "italic" }
        },
        {
            "name": "String",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#FF6B00" }
        },
        {
            "name": "String escape",
            "scope": ["constant.character.escape", "string.regexp"],
            "settings": { "foreground": "#FFB066" }
        },
        {
            "name": "Keyword",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.new",
                "keyword.other.important"
            ],
            "settings": { "foreground": "#00FFE5", "fontStyle": "bold" }
        },
        {
            "name": "Storage",
            "scope": ["storage.type", "storage.modifier"],
            "settings": { "foreground": "#00FFE5", "fontStyle": "bold" }
        },
        {
            "name": "Function name",
            "scope": [
                "entity.name.function",
                "meta.function-call entity.name.function",
                "support.function"
            ],
            "settings": { "foreground": "#85FFF6" }
        },
        {
            "name": "Class / Type name",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.class",
                "support.type"
            ],
            "settings": { "foreground": "#ECF7FF" }
        },
        {
            "name": "Inherited class",
            "scope": ["entity.other.inherited-class"],
            "settings": { "foreground": "#85FFF6", "fontStyle": "italic" }
        },
        {
            "name": "Variable",
            "scope": ["variable", "variable.other.readwrite"],
            "settings": { "foreground": "#ECF7FF" }
        },
        {
            "name": "Variable parameter",
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#FFB066", "fontStyle": "italic" }
        },
        {
            "name": "Constant",
            "scope": ["variable.other.constant", "constant.other"],
            "settings": { "foreground": "#FF6B00", "fontStyle": "bold" }
        },
        {
            "name": "Number",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#FF6B00" }
        },
        {
            "name": "Boolean / Null / Undefined",
            "scope": ["constant.language"],
            "settings": { "foreground": "#00FFE5", "fontStyle": "bold" }
        },
        {
            "name": "Tag",
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#00FFE5" }
        },
        {
            "name": "Attribute name",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#85FFF6" }
        },
        {
            "name": "Operator",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#85FFF6" }
        },
        {
            "name": "Punctuation",
            "scope": ["punctuation", "meta.brace", "punctuation.accessor"],
            "settings": { "foreground": "#58747A" }
        },
        {
            "name": "Property / Field",
            "scope": [
                "variable.other.property",
                "support.variable.property",
                "variable.other.object.property"
            ],
            "settings": { "foreground": "#FFB066" }
        },
        {
            "name": "Invalid / Deprecated",
            "scope": ["invalid", "invalid.illegal", "invalid.deprecated"],
            "settings": { "foreground": "#FF4466", "fontStyle": "underline" }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "variable": "#ECF7FF",
        "variable.declaration": "#ECF7FF",
        "variable.readonly": "#FF6B00",
        "property": "#FFB066",
        "property.declaration": "#85FFF6",
        "class": "#ECF7FF",
        "interface": "#ECF7FF",
        "function": "#85FFF6",
        "method": "#85FFF6",
        "parameter": { "foreground": "#FFB066", "italic": true },
        "type": "#ECF7FF",
        "enum": "#FF6B00",
        "enumMember": "#FF6B00",
        "namespace": "#00FFE5",
        "decorator": "#FFB066",
        "keyword": { "foreground": "#00FFE5", "bold": true },
        "comment": { "foreground": "#58747A", "italic": true },
        "number": "#FF6B00",
        "string": "#FF6B00",
        "operator": "#85FFF6",
        "typeParameter": "#85FFF6",
        "macro": "#FFB066",
        "event": "#85FFF6",
        "label": "#00FFE5",
        "regexp": "#FF4466"
    }
}
