        "diffEditor.removedLineBackground": "#FF404015",
        "diffEditorGutter.insertedLineBackground": "#39FF1430",
        "diffEditorGutter.removedLineBackground": "#FF404030",
        "notifications.background": "#0D0D0D",
        "notifications.border": "#BF5FFF",
        "notificationLink.foreground": "#BF5FFF",
        "menu.background": "#0D0D0D",
        "menu.foreground": "#E8E8E8",
        "menu.selectionBackground": "#BF5FFF22",
        "menu.selectionForeground": "#E8E8E8",
        "menu.border": "#BF5FFF44",
        "menu.separatorBackground": "#BF5FFF33",
        "menubar.selectionBackground": "#BF5FFF22",
        "menubar.selectionForeground": "#E8E8E8"
    },
    "tokenColors": [
        {
            "scope": "comment",
            "settings": { "foreground": "#BF5FFF66", "fontStyle": "italic" }
        },
        { "scope": "string", "settings": { "foreground": "#FFDF00" } },
        {
            "scope": "constant.numeric",
            "settings": { "foreground": "#BF5FFF" }
        },
        {
            "scope": "constant.language",
            "settings": { "foreground": "#BF5FFFCC", "fontStyle": "bold" }
        },
        {
            "scope": "constant.character.escape",
            "settings": { "foreground": "#FF2DF7" }
        },
        { "scope": "variable", "settings": { "foreground": "#E8E8E8" } },
        {
            "scope": "variable.parameter",
            "settings": { "foreground": "#E8D0FF" }
        },
        {
            "scope": "variable.other.constant",
            "settings": { "foreground": "#BF5FFF", "fontStyle": "bold" }
        },
        {
            "scope": "keyword",
            "settings": { "foreground": "#BF5FFF", "fontStyle": "bold" }
        },
        {
            "scope": "keyword.operator",
            "settings": { "foreground": "#BF5FFFAA" }
        },
        { "scope": "storage.type", "settings": { "foreground": "#BF5FFF" } },
        {
            "scope": "storage.modifier",
            "settings": { "foreground": "#BF5FFFCC" }
        },
        {
            "scope": "entity.name.function",
            "settings": { "foreground": "#FFDF00" }
        },
        {
            "scope": "entity.name.type",
            "settings": { "foreground": "#FFDF00CC" }
        },
        {
            "scope": "entity.name.class",
            "settings": { "foreground": "#FFDF00", "fontStyle": "bold" }
        },
        { "scope": "entity.name.tag", "settings": { "foreground": "#BF5FFF" } },
        {
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#FFDF00" }
        },
        {
            "scope": "support.function",
            "settings": { "foreground": "#FFDF00CC" }
        },
        { "scope": "support.type", "settings": { "foreground": "#BF5FFFCC" } },
        { "scope": "support.class", "settings": { "foreground": "#FFDF00CC" } },
        {
            "scope": "support.constant",
            "settings": { "foreground": "#BF5FFF" }
        },
        {
            "scope": "meta.function-call",
            "settings": { "foreground": "#FFDF00" }
        },
        {
            "scope": "punctuation.separator",
            "settings": { "foreground": "#AAAAAA" }
        },
        {
            "scope": "invalid",
            "settings": { "foreground": "#FF4040", "fontStyle": "underline" }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "function": "#FFDF00",
        "method": "#FFDF00",
        "class": { "foreground": "#FFDF00", "bold": true },
        "interface": { "foreground": "#FFDF00CC" },
        "type": "#FFDF00CC",
        "keyword": { "foreground": "#BF5FFF", "bold": true },
        "variable": "#E8E8E8",
        "parameter": "#E8D0FF",
        "property": "#E8E8E8",
        "string": "#FFDF00",
        "number": "#BF5FFF",
        "comment": { "foreground": "#BF5FFF66", "italic": true },
        "namespace": "#FFDF00CC",
        "enum": "#FFDF00",
        "enumMember": "#BF5FFFCC",
        "decorator": "#FF2DF7",
        "typeParameter": "#FFDF00BB"
    }
}
