{
    "name": "HighCoCo Codex: Violet",
    "$schema": "vscode://schemas/color-theme",
    "type": "dark",
    "colors": {
        "focusBorder": "#BF5FFF88",
        "foreground": "#ECF7FF",
        "disabledForeground": "#6C7A86",
        "widget.shadow": "#00000066",
        "selection.background": "#BF5FFF28",
        "descriptionForeground": "#93A6B4",
        "errorForeground": "#FF4466",
        "icon.foreground": "#D6A6FF",
        "editor.background": "#0E0814",
        "editor.foreground": "#ECF7FF",
        "editor.selectionBackground": "#BF5FFF2E",
        "editor.selectionHighlightBackground": "#BF5FFF1A",
        "editor.lineHighlightBackground": "#BF5FFF0C",
        "editor.lineHighlightBorder": "#00000000",
        "editor.findMatchBackground": "#FFD7003C",
        "editor.findMatchHighlightBackground": "#FFD70020",
        "editorCursor.foreground": "#BF5FFF",
        "editorLineNumber.foreground": "#6D5A81",
        "editorLineNumber.activeForeground": "#BF5FFF",
        "editorWhitespace.foreground": "#37224D",
        "editorIndentGuide.background1": "#37224D",
        "editorIndentGuide.activeBackground1": "#BF5FFF55",
        "editorRuler.foreground": "#37224D",
        "editorBracketMatch.background": "#BF5FFF22",
        "editorBracketMatch.border": "#BF5FFF",
        "editorGutter.background": "#0E0814",
        "editorGutter.addedBackground": "#39FF14",
        "editorGutter.modifiedBackground": "#BF5FFF",
        "editorGutter.deletedBackground": "#FF4466",
        "editorError.foreground": "#FF4466",
        "editorWarning.foreground": "#FFD700",
        "editorInfo.foreground": "#D6A6FF",
        "activityBar.background": "#0C0710",
        "activityBar.foreground": "#BF5FFF",
        "activityBar.inactiveForeground": "#6D5A81",
        "activityBar.border": "#37224D",
        "activityBar.activeBorder": "#BF5FFF",
        "activityBarBadge.background": "#BF5FFF",
        "activityBarBadge.foreground": "#120418",
        "sideBar.background": "#120B18",
        "sideBar.foreground": "#ECF7FF",
        "sideBar.border": "#37224D",
        "sideBarTitle.foreground": "#BF5FFF",
        "sideBarSectionHeader.background": "#0C0710",
        "sideBarSectionHeader.foreground": "#D6A6FF",
        "sideBarSectionHeader.border": "#37224D",
        "editorGroupHeader.tabsBackground": "#0C0710",
        "editorGroup.border": "#37224D",
        "tab.activeBackground": "#120B18",
        "tab.activeForeground": "#BF5FFF",
        "tab.activeBorderTop": "#BF5FFF",
        "tab.inactiveBackground": "#0C0710",
        "tab.inactiveForeground": "#6D5A81",
        "tab.border": "#37224D",
        "tab.hoverBackground": "#BF5FFF14",
        "panel.background": "#0C0710",
        "panel.border": "#37224D",
        "panelTitle.activeForeground": "#BF5FFF",
        "panelTitle.inactiveForeground": "#6D5A81",
        "panelTitle.activeBorder": "#BF5FFF",
        "terminal.background": "#0C0710",
        "terminal.foreground": "#ECF7FF",
        "terminal.ansiBlack": "#37224D",
        "terminal.ansiRed": "#FF4466",
        "terminal.ansiGreen": "#39FF14",
        "terminal.ansiYellow": "#FFD700",
        "terminal.ansiBlue": "#BF5FFF",
        "terminal.ansiMagenta": "#FFD700",
        "terminal.ansiCyan": "#00FFE5",
        "terminal.ansiWhite": "#ECF7FF",
        "terminal.ansiBrightBlack": "#6D5A81",
        "terminal.ansiBrightRed": "#FF6688",
        "terminal.ansiBrightGreen": "#66FF88",
        "terminal.ansiBrightYellow": "#FFE066",
        "terminal.ansiBrightBlue": "#D6A6FF",
        "terminal.ansiBrightMagenta": "#FFE98A",
        "terminal.ansiBrightCyan": "#85FFF6",
        "terminal.ansiBrightWhite": "#ECF7FF",
        "statusBar.background": "#BF5FFF",
        "statusBar.foreground": "#120418",
        "statusBar.border": "#D6A6FF",
        "statusBar.debuggingBackground": "#FFD700",
        "statusBar.debuggingForeground": "#120418",
        "button.background": "#BF5FFF",
        "button.foreground": "#120418",
        "button.hoverBackground": "#D6A6FF",
        "button.secondaryBackground": "#37224D",
        "button.secondaryForeground": "#ECF7FF",
        "button.secondaryHoverBackground": "#6D5A81",
        "input.background": "#0C0710",
        "input.border": "#37224D",
        "input.foreground": "#ECF7FF",
        "input.placeholderForeground": "#6D5A81",
        "inputOption.activeBorder": "#BF5FFF",
        "inputOption.activeBackground": "#BF5FFF22",
        "dropdown.background": "#0C0710",
        "dropdown.border": "#37224D",
        "dropdown.foreground": "#ECF7FF",
        "badge.background": "#BF5FFF",
        "badge.foreground": "#120418",
        "menu.background": "#0C0710",
        "menu.foreground": "#ECF7FF",
        "menu.selectionBackground": "#BF5FFF22",
        "menu.selectionForeground": "#BF5FFF",
        "menu.separatorBackground": "#37224D",
        "notifications.background": "#0C0710",
        "notifications.foreground": "#ECF7FF",
        "notifications.border": "#BF5FFF44",
        "breadcrumb.background": "#0E0814",
        "breadcrumb.foreground": "#6D5A81",
        "breadcrumb.activeSelectionForeground": "#BF5FFF",
        "minimap.background": "#0E0814",
        "minimap.selectionHighlight": "#BF5FFF44",
        "minimap.findMatchHighlight": "#FFD70066",
        "minimap.errorHighlight": "#FF4466",
        "gitDecoration.addedResourceForeground": "#39FF14",
        "gitDecoration.modifiedResourceForeground": "#BF5FFF",
        "gitDecoration.deletedResourceForeground": "#FF4466",
        "gitDecoration.untrackedResourceForeground": "#D6A6FF",
        "gitDecoration.ignoredResourceForeground": "#6D5A81",
        "gitDecoration.conflictingResourceForeground": "#FFD700"
    },
    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#6D5A81", "fontStyle": "italic" }
        },
        {
            "name": "String",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#FFD700" }
        },
        {
            "name": "String escape",
            "scope": ["constant.character.escape", "string.regexp"],
            "settings": { "foreground": "#FFE98A" }
        },
        {
            "name": "Keyword",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.new",
                "keyword.other.important"
            ],
            "settings": { "foreground": "#BF5FFF", "fontStyle": "bold" }
        },
        {
            "name": "Storage",
            "scope": ["storage.type", "storage.modifier"],
            "settings": { "foreground": "#BF5FFF", "fontStyle": "bold" }
        },
        {
            "name": "Function name",
            "scope": [
                "entity.name.function",
                "meta.function-call entity.name.function",
                "support.function"
            ],
            "settings": { "foreground": "#D6A6FF" }
        },
        {
            "name": "Class / Type name",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.class",
                "support.type"
            ],
            "settings": { "foreground": "#ECF7FF" }
        },
        {
            "name": "Inherited class",
            "scope": ["entity.other.inherited-class"],
            "settings": { "foreground": "#D6A6FF", "fontStyle": "italic" }
        },
        {
            "name": "Variable",
            "scope": ["variable", "variable.other.readwrite"],
            "settings": { "foreground": "#ECF7FF" }
        },
        {
            "name": "Variable parameter",
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#FFE98A", "fontStyle": "italic" }
        },
        {
            "name": "Constant",
            "scope": ["variable.other.constant", "constant.other"],
            "settings": { "foreground": "#FFD700", "fontStyle": "bold" }
        },
        {
            "name": "Number",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#FFD700" }
        },
        {
            "name": "Boolean / Null / Undefined",
            "scope": ["constant.language"],
            "settings": { "foreground": "#BF5FFF", "fontStyle": "bold" }
        },
        {
            "name": "Tag",
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#BF5FFF" }
        },
        {
            "name": "Attribute name",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#D6A6FF" }
        },
        {
            "name": "Operator",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#D6A6FF" }
        },
        {
            "name": "Punctuation",
            "scope": ["punctuation", "meta.brace", "punctuation.accessor"],
            "settings": { "foreground": "#6D5A81" }
        },
        {
            "name": "Property / Field",
            "scope": [
                "variable.other.property",
                "support.variable.property",
                "variable.other.object.property"
            ],
            "settings": { "foreground": "#FFE98A" }
        },
        {
            "name": "Invalid / Deprecated",
            "scope": ["invalid", "invalid.illegal", "invalid.deprecated"],
            "settings": { "foreground": "#FF4466", "fontStyle": "underline" }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "variable": "#ECF7FF",
        "variable.declaration": "#ECF7FF",
        "variable.readonly": "#FFD700",
        "property": "#FFE98A",
        "property.declaration": "#D6A6FF",
        "class": "#ECF7FF",
        "interface": "#ECF7FF",
        "function": "#D6A6FF",
        "method": "#D6A6FF",
        "parameter": { "foreground": "#FFE98A", "italic": true },
        "type": "#ECF7FF",
        "enum": "#FFD700",
        "enumMember": "#FFD700",
        "namespace": "#BF5FFF",
        "decorator": "#FFE98A",
        "keyword": { "foreground": "#BF5FFF", "bold": true },
        "comment": { "foreground": "#6D5A81", "italic": true },
        "number": "#FFD700",
        "string": "#FFD700",
        "operator": "#D6A6FF",
        "typeParameter": "#D6A6FF",
        "macro": "#FFE98A",
        "event": "#D6A6FF",
        "label": "#BF5FFF",
        "regexp": "#FF4466"
    }
}
