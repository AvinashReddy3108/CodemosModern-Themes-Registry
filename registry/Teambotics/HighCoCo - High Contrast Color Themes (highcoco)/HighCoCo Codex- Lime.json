{
    "name": "HighCoCo Codex: Lime",
    "$schema": "vscode://schemas/color-theme",
    "type": "dark",
    "colors": {
        "focusBorder": "#39FF1488",
        "foreground": "#ECF7FF",
        "disabledForeground": "#6C7A86",
        "widget.shadow": "#00000066",
        "selection.background": "#39FF1428",
        "descriptionForeground": "#93A6B4",
        "errorForeground": "#FF4466",
        "icon.foreground": "#7CFF66",
        "editor.background": "#081107",
        "editor.foreground": "#ECF7FF",
        "editor.selectionBackground": "#39FF142E",
        "editor.selectionHighlightBackground": "#39FF141A",
        "editor.lineHighlightBackground": "#39FF140C",
        "editor.lineHighlightBorder": "#00000000",
        "editor.findMatchBackground": "#FF2DF73C",
        "editor.findMatchHighlightBackground": "#FF2DF720",
        "editorCursor.foreground": "#39FF14",
        "editorLineNumber.foreground": "#5F7B56",
        "editorLineNumber.activeForeground": "#39FF14",
        "editorWhitespace.foreground": "#21461A",
        "editorIndentGuide.background1": "#21461A",
        "editorIndentGuide.activeBackground1": "#39FF1455",
        "editorRuler.foreground": "#21461A",
        "editorBracketMatch.background": "#39FF1422",
        "editorBracketMatch.border": "#39FF14",
        "editorGutter.background": "#081107",
        "editorGutter.addedBackground": "#39FF14",
        "editorGutter.modifiedBackground": "#39FF14",
        "editorGutter.deletedBackground": "#FF4466",
        "editorError.foreground": "#FF4466",
        "editorWarning.foreground": "#FFD700",
        "editorInfo.foreground": "#7CFF66",
        "activityBar.background": "#071006",
        "activityBar.foreground": "#39FF14",
        "activityBar.inactiveForeground": "#5F7B56",
        "activityBar.border": "#21461A",
        "activityBar.activeBorder": "#39FF14",
        "activityBarBadge.background": "#39FF14",
        "activityBarBadge.foreground": "#041006",
        "sideBar.background": "#0B1508",
        "sideBar.foreground": "#ECF7FF",
        "sideBar.border": "#21461A",
        "sideBarTitle.foreground": "#39FF14",
        "sideBarSectionHeader.background": "#071006",
        "sideBarSectionHeader.foreground": "#7CFF66",
        "sideBarSectionHeader.border": "#21461A",
        "editorGroupHeader.tabsBackground": "#071006",
        "editorGroup.border": "#21461A",
        "tab.activeBackground": "#0B1508",
        "tab.activeForeground": "#39FF14",
        "tab.activeBorderTop": "#39FF14",
        "tab.inactiveBackground": "#071006",
        "tab.inactiveForeground": "#5F7B56",
        "tab.border": "#21461A",
        "tab.hoverBackground": "#39FF1414",
        "panel.background": "#071006",
        "panel.border": "#21461A",
        "panelTitle.activeForeground": "#39FF14",
        "panelTitle.inactiveForeground": "#5F7B56",
        "panelTitle.activeBorder": "#39FF14",
        "terminal.background": "#071006",
        "terminal.foreground": "#ECF7FF",
        "terminal.ansiBlack": "#21461A",
        "terminal.ansiRed": "#FF4466",
        "terminal.ansiGreen": "#39FF14",
        "terminal.ansiYellow": "#FFD700",
        "terminal.ansiBlue": "#39FF14",
        "terminal.ansiMagenta": "#FF2DF7",
        "terminal.ansiCyan": "#00FFE5",
        "terminal.ansiWhite": "#ECF7FF",
        "terminal.ansiBrightBlack": "#5F7B56",
        "terminal.ansiBrightRed": "#FF6688",
        "terminal.ansiBrightGreen": "#66FF88",
        "terminal.ansiBrightYellow": "#FFE066",
        "terminal.ansiBrightBlue": "#7CFF66",
        "terminal.ansiBrightMagenta": "#FF80FC",
        "terminal.ansiBrightCyan": "#85FFF6",
        "terminal.ansiBrightWhite": "#ECF7FF",
        "statusBar.background": "#39FF14",
        "statusBar.foreground": "#041006",
        "statusBar.border": "#7CFF66",
        "statusBar.debuggingBackground": "#FF2DF7",
        "statusBar.debuggingForeground": "#041006",
        "button.background": "#39FF14",
        "button.foreground": "#041006",
        "button.hoverBackground": "#7CFF66",
        "button.secondaryBackground": "#21461A",
        "button.secondaryForeground": "#ECF7FF",
        "button.secondaryHoverBackground": "#5F7B56",
        "input.background": "#071006",
        "input.border": "#21461A",
        "input.foreground": "#ECF7FF",
        "input.placeholderForeground": "#5F7B56",
        "inputOption.activeBorder": "#39FF14",
        "inputOption.activeBackground": "#39FF1422",
        "dropdown.background": "#071006",
        "dropdown.border": "#21461A",
        "dropdown.foreground": "#ECF7FF",
        "badge.background": "#39FF14",
        "badge.foreground": "#041006",
        "menu.background": "#071006",
        "menu.foreground": "#ECF7FF",
        "menu.selectionBackground": "#39FF1422",
        "menu.selectionForeground": "#39FF14",
        "menu.separatorBackground": "#21461A",
        "notifications.background": "#071006",
        "notifications.foreground": "#ECF7FF",
        "notifications.border": "#39FF1444",
        "breadcrumb.background": "#081107",
        "breadcrumb.foreground": "#5F7B56",
        "breadcrumb.activeSelectionForeground": "#39FF14",
        "minimap.background": "#081107",
        "minimap.selectionHighlight": "#39FF1444",
        "minimap.findMatchHighlight": "#FF2DF766",
        "minimap.errorHighlight": "#FF4466",
        "gitDecoration.addedResourceForeground": "#39FF14",
        "gitDecoration.modifiedResourceForeground": "#39FF14",
        "gitDecoration.deletedResourceForeground": "#FF4466",
        "gitDecoration.untrackedResourceForeground": "#7CFF66",
        "gitDecoration.ignoredResourceForeground": "#5F7B56",
        "gitDecoration.conflictingResourceForeground": "#FF2DF7"
    },
    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#5F7B56", "fontStyle": "italic" }
        },
        {
            "name": "String",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#FF2DF7" }
        },
        {
            "name": "String escape",
            "scope": ["constant.character.escape", "string.regexp"],
            "settings": { "foreground": "#FF80FC" }
        },
        {
            "name": "Keyword",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.new",
                "keyword.other.important"
            ],
            "settings": { "foreground": "#39FF14", "fontStyle": "bold" }
        },
        {
            "name": "Storage",
            "scope": ["storage.type", "storage.modifier"],
            "settings": { "foreground": "#39FF14", "fontStyle": "bold" }
        },
        {
            "name": "Function name",
            "scope": [
                "entity.name.function",
                "meta.function-call entity.name.function",
                "support.function"
            ],
            "settings": { "foreground": "#7CFF66" }
        },
        {
            "name": "Class / Type name",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.class",
                "support.type"
            ],
            "settings": { "foreground": "#ECF7FF" }
        },
        {
            "name": "Inherited class",
            "scope": ["entity.other.inherited-class"],
            "settings": { "foreground": "#7CFF66", "fontStyle": "italic" }
        },
        {
            "name": "Variable",
            "scope": ["variable", "variable.other.readwrite"],
            "settings": { "foreground": "#ECF7FF" }
        },
        {
            "name": "Variable parameter",
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#FF80FC", "fontStyle": "italic" }
        },
        {
            "name": "Constant",
            "scope": ["variable.other.constant", "constant.other"],
            "settings": { "foreground": "#FF2DF7", "fontStyle": "bold" }
        },
        {
            "name": "Number",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#FF2DF7" }
        },
        {
            "name": "Boolean / Null / Undefined",
            "scope": ["constant.language"],
            "settings": { "foreground": "#39FF14", "fontStyle": "bold" }
        },
        {
            "name": "Tag",
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#39FF14" }
        },
        {
            "name": "Attribute name",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#7CFF66" }
        },
        {
            "name": "Operator",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#7CFF66" }
        },
        {
            "name": "Punctuation",
            "scope": ["punctuation", "meta.brace", "punctuation.accessor"],
            "settings": { "foreground": "#5F7B56" }
        },
        {
            "name": "Property / Field",
            "scope": [
                "variable.other.property",
                "support.variable.property",
                "variable.other.object.property"
            ],
            "settings": { "foreground": "#FF80FC" }
        },
        {
            "name": "Invalid / Deprecated",
            "scope": ["invalid", "invalid.illegal", "invalid.deprecated"],
            "settings": { "foreground": "#FF4466", "fontStyle": "underline" }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "variable": "#ECF7FF",
        "variable.declaration": "#ECF7FF",
        "variable.readonly": "#FF2DF7",
        "property": "#FF80FC",
        "property.declaration": "#7CFF66",
        "class": "#ECF7FF",
        "interface": "#ECF7FF",
        "function": "#7CFF66",
        "method": "#7CFF66",
        "parameter": { "foreground": "#FF80FC", "italic": true },
        "type": "#ECF7FF",
        "enum": "#FF2DF7",
        "enumMember": "#FF2DF7",
        "namespace": "#39FF14",
        "decorator": "#FF80FC",
        "keyword": { "foreground": "#39FF14", "bold": true },
        "comment": { "foreground": "#5F7B56", "italic": true },
        "number": "#FF2DF7",
        "string": "#FF2DF7",
        "operator": "#7CFF66",
        "typeParameter": "#7CFF66",
        "macro": "#FF80FC",
        "event": "#7CFF66",
        "label": "#39FF14",
        "regexp": "#FF4466"
    }
}
