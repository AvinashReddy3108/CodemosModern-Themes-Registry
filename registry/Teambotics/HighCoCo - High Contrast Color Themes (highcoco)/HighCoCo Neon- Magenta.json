    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#8A204A", "fontStyle": "italic" }
        },
        {
            "name": "String",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#00FFAA" }
        },
        {
            "name": "String escape",
            "scope": ["constant.character.escape", "string.regexp"],
            "settings": { "foreground": "#00DD88" }
        },
        {
            "name": "Keyword",
            "scope": [
                "keyword",
                "keyword.control",
                "storage.type",
                "storage.modifier"
            ],
            "settings": { "foreground": "#FF0090", "fontStyle": "bold" }
        },
        {
            "name": "Function name",
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#FF6ABD" }
        },
        {
            "name": "Class / Type",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.class",
                "support.type"
            ],
            "settings": { "foreground": "#FFAAD5" }
        },
        {
            "name": "Variable",
            "scope": ["variable", "variable.other.readwrite"],
            "settings": { "foreground": "#FFE0F2" }
        },
        {
            "name": "Variable parameter",
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#FFAAD5", "fontStyle": "italic" }
        },
        {
            "name": "Constant",
            "scope": ["variable.other.constant", "constant.other"],
            "settings": { "foreground": "#00FFAA", "fontStyle": "bold" }
        },
        {
            "name": "Number",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#00FFAA" }
        },
        {
            "name": "Boolean / Null",
            "scope": ["constant.language"],
            "settings": { "foreground": "#FF0090", "fontStyle": "bold" }
        },
        {
            "name": "Tag",
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#FF0090" }
        },
        {
            "name": "Attribute name",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#FF6ABD" }
        },
        {
            "name": "Operator",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#FF22A8" }
        },
        {
            "name": "Punctuation",
            "scope": ["punctuation", "meta.brace"],
            "settings": { "foreground": "#8A204A" }
        },
        {
            "name": "Property",
            "scope": ["variable.other.property", "support.variable.property"],
            "settings": { "foreground": "#FFCCEE" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#FF4466", "fontStyle": "underline" }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "variable": "#FFE0F2",
        "variable.readonly": { "foreground": "#00FFAA" },
        "property": "#FFCCEE",
        "property.declaration": "#FF6ABD",
        "class": "#FFAAD5",
        "interface": "#FFAAD5",
        "function": "#FF6ABD",
        "method": "#FF6ABD",
        "parameter": { "foreground": "#FFAAD5", "italic": true },
        "type": "#FFAAD5",
        "enum": "#00FFAA",
        "enumMember": "#00FFAA",
        "namespace": "#FF0090",
        "keyword": { "foreground": "#FF0090", "bold": true }
    },
    "$schema": "vscode://schemas/color-theme"
}
