    "tokenColors": [
        {
            "scope": "comment",
            "settings": { "foreground": "#00FFE566", "fontStyle": "italic" }
        },
        { "scope": "string", "settings": { "foreground": "#FF6B00" } },
        {
            "scope": "constant.numeric",
            "settings": { "foreground": "#00FFE5" }
        },
        {
            "scope": "constant.language",
            "settings": { "foreground": "#00FFE5CC", "fontStyle": "bold" }
        },
        {
            "scope": "constant.character.escape",
            "settings": { "foreground": "#FF2DF7" }
        },
        { "scope": "variable", "settings": { "foreground": "#E8E8E8" } },
        {
            "scope": "variable.parameter",
            "settings": { "foreground": "#C8FFF8" }
        },
        {
            "scope": "variable.other.constant",
            "settings": { "foreground": "#00FFE5", "fontStyle": "bold" }
        },
        {
            "scope": "keyword",
            "settings": { "foreground": "#00FFE5", "fontStyle": "bold" }
        },
        {
            "scope": "keyword.operator",
            "settings": { "foreground": "#00FFE5AA" }
        },
        { "scope": "storage.type", "settings": { "foreground": "#00FFE5" } },
        {
            "scope": "storage.modifier",
            "settings": { "foreground": "#00FFE5CC" }
        },
        {
            "scope": "entity.name.function",
            "settings": { "foreground": "#FF6B00" }
        },
        {
            "scope": "entity.name.type",
            "settings": { "foreground": "#FF6B00CC" }
        },
        {
            "scope": "entity.name.class",
            "settings": { "foreground": "#FF6B00", "fontStyle": "bold" }
        },
        { "scope": "entity.name.tag", "settings": { "foreground": "#00FFE5" } },
        {
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#FF6B00" }
        },
        {
            "scope": "support.function",
            "settings": { "foreground": "#FF6B00CC" }
        },
        { "scope": "support.type", "settings": { "foreground": "#00FFE5CC" } },
        { "scope": "support.class", "settings": { "foreground": "#FF6B00CC" } },
        {
            "scope": "support.constant",
            "settings": { "foreground": "#00FFE5" }
        },
        {
            "scope": "meta.function-call",
            "settings": { "foreground": "#FF6B00" }
        },
        {
            "scope": "punctuation.separator",
            "settings": { "foreground": "#AAAAAA" }
        },
        {
            "scope": "invalid",
            "settings": { "foreground": "#FF4040", "fontStyle": "underline" }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "function": "#FF6B00",
        "method": "#FF6B00",
        "class": { "foreground": "#FF6B00", "bold": true },
        "interface": { "foreground": "#FF6B00CC" },
        "type": "#FF6B00CC",
        "keyword": { "foreground": "#00FFE5", "bold": true },
        "variable": "#E8E8E8",
        "parameter": "#C8FFF8",
        "property": "#E8E8E8",
        "string": "#FF6B00",
        "number": "#00FFE5",
        "comment": { "foreground": "#00FFE566", "italic": true },
        "namespace": "#FF6B00CC",
        "enum": "#FF6B00",
        "enumMember": "#00FFE5CC",
        "decorator": "#FF2DF7",
        "typeParameter": "#FF6B00BB"
    }
}
