    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#5A3080", "fontStyle": "italic" }
        },
        {
            "name": "String",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#FFDF00" }
        },
        {
            "name": "String escape",
            "scope": ["constant.character.escape", "string.regexp"],
            "settings": { "foreground": "#DDBB00" }
        },
        {
            "name": "Keyword",
            "scope": [
                "keyword",
                "keyword.control",
                "storage.type",
                "storage.modifier"
            ],
            "settings": { "foreground": "#BF5FFF", "fontStyle": "bold" }
        },
        {
            "name": "Function name",
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#D999FF" }
        },
        {
            "name": "Class / Type",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.class",
                "support.type"
            ],
            "settings": { "foreground": "#ECCAFF" }
        },
        {
            "name": "Variable",
            "scope": ["variable", "variable.other.readwrite"],
            "settings": { "foreground": "#F0E0FF" }
        },
        {
            "name": "Variable parameter",
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#ECCAFF", "fontStyle": "italic" }
        },
        {
            "name": "Constant",
            "scope": ["variable.other.constant", "constant.other"],
            "settings": { "foreground": "#FFDF00", "fontStyle": "bold" }
        },
        {
            "name": "Number",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#FFDF00" }
        },
        {
            "name": "Boolean / Null",
            "scope": ["constant.language"],
            "settings": { "foreground": "#BF5FFF", "fontStyle": "bold" }
        },
        {
            "name": "Tag",
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#BF5FFF" }
        },
        {
            "name": "Attribute name",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#D999FF" }
        },
        {
            "name": "Operator",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#CC77FF" }
        },
        {
            "name": "Punctuation",
            "scope": ["punctuation", "meta.brace"],
            "settings": { "foreground": "#5A3080" }
        },
        {
            "name": "Property",
            "scope": ["variable.other.property", "support.variable.property"],
            "settings": { "foreground": "#E4CCFF" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#FF4466", "fontStyle": "underline" }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "variable": "#F0E0FF",
        "variable.readonly": { "foreground": "#FFDF00" },
        "property": "#E4CCFF",
        "property.declaration": "#D999FF",
        "class": "#ECCAFF",
        "interface": "#ECCAFF",
        "function": "#D999FF",
        "method": "#D999FF",
        "parameter": { "foreground": "#ECCAFF", "italic": true },
        "type": "#ECCAFF",
        "enum": "#FFDF00",
        "enumMember": "#FFDF00",
        "namespace": "#BF5FFF",
        "keyword": { "foreground": "#BF5FFF", "bold": true }
    },
    "$schema": "vscode://schemas/color-theme"
}
