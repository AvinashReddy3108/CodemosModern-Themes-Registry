    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#8892A4", "fontStyle": "italic" }
        },
        {
            "name": "String",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#0E6D53" }
        },
        {
            "name": "String escape",
            "scope": ["constant.character.escape", "string.regexp"],
            "settings": { "foreground": "#0B5040" }
        },
        {
            "name": "Keyword",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.new",
                "keyword.other.important"
            ],
            "settings": { "foreground": "#C41E5A", "fontStyle": "bold" }
        },
        {
            "name": "Storage",
            "scope": ["storage.type", "storage.modifier"],
            "settings": { "foreground": "#C41E5A", "fontStyle": "bold" }
        },
        {
            "name": "Function name",
            "scope": [
                "entity.name.function",
                "meta.function-call entity.name.function",
                "support.function"
            ],
            "settings": { "foreground": "#E03A76" }
        },
        {
            "name": "Class / Type name",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.class",
                "support.type"
            ],
            "settings": { "foreground": "#1A3A6B" }
        },
        {
            "name": "Inherited class",
            "scope": ["entity.other.inherited-class"],
            "settings": { "foreground": "#E03A76", "fontStyle": "italic" }
        },
        {
            "name": "Variable",
            "scope": ["variable", "variable.other.readwrite"],
            "settings": { "foreground": "#1C2028" }
        },
        {
            "name": "Variable parameter",
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#5C3B8A", "fontStyle": "italic" }
        },
        {
            "name": "Constant",
            "scope": ["variable.other.constant", "constant.other"],
            "settings": { "foreground": "#9B2E00", "fontStyle": "bold" }
        },
        {
            "name": "Number",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#9B2E00" }
        },
        {
            "name": "Boolean / Null / Undefined",
            "scope": ["constant.language"],
            "settings": { "foreground": "#C41E5A", "fontStyle": "bold" }
        },
        {
            "name": "Tag",
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#C41E5A" }
        },
        {
            "name": "Attribute name",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#E03A76" }
        },
        {
            "name": "Operator",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#E03A76" }
        },
        {
            "name": "Punctuation",
            "scope": ["punctuation", "meta.brace", "punctuation.accessor"],
            "settings": { "foreground": "#8892A4" }
        },
        {
            "name": "Property / Field",
            "scope": [
                "variable.other.property",
                "support.variable.property",
                "variable.other.object.property"
            ],
            "settings": { "foreground": "#4A3A7A" }
        },
        {
            "name": "Invalid / Deprecated",
            "scope": ["invalid", "invalid.illegal", "invalid.deprecated"],
            "settings": { "foreground": "#CC1122", "fontStyle": "underline" }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "variable": "#1C2028",
        "variable.declaration": "#1C2028",
        "variable.readonly": { "foreground": "#9B2E00" },
        "property": "#4A3A7A",
        "property.declaration": "#E03A76",
        "class": "#1A3A6B",
        "interface": "#1A3A6B",
        "function": "#E03A76",
        "method": "#E03A76",
        "parameter": { "foreground": "#5C3B8A", "italic": true },
        "type": "#1A3A6B",
        "enum": "#9B2E00",
        "enumMember": "#9B2E00",
        "namespace": "#C41E5A",
        "decorator": "#5C3B8A",
        "keyword": { "foreground": "#C41E5A", "bold": true },
        "comment": { "foreground": "#8892A4", "italic": true },
        "number": "#9B2E00",
        "string": "#0E6D53",
        "operator": "#E03A76",
        "typeParameter": "#E03A76",
        "macro": "#5C3B8A",
        "event": "#E03A76",
        "label": "#C41E5A",
        "regexp": "#CC1122"
    }
}
