    "tokenColors": [
        {
            "scope": "comment",
            "settings": { "foreground": "#39FF1466", "fontStyle": "italic" }
        },
        { "scope": "string", "settings": { "foreground": "#FF00AA" } },
        {
            "scope": "constant.numeric",
            "settings": { "foreground": "#39FF14" }
        },
        {
            "scope": "constant.language",
            "settings": { "foreground": "#39FF14CC", "fontStyle": "bold" }
        },
        {
            "scope": "constant.character.escape",
            "settings": { "foreground": "#FF2DF7" }
        },
        { "scope": "variable", "settings": { "foreground": "#E8E8E8" } },
        {
            "scope": "variable.parameter",
            "settings": { "foreground": "#D0FFD0" }
        },
        {
            "scope": "variable.other.constant",
            "settings": { "foreground": "#39FF14", "fontStyle": "bold" }
        },
        {
            "scope": "keyword",
            "settings": { "foreground": "#39FF14", "fontStyle": "bold" }
        },
        {
            "scope": "keyword.operator",
            "settings": { "foreground": "#39FF14AA" }
        },
        { "scope": "storage.type", "settings": { "foreground": "#39FF14" } },
        {
            "scope": "storage.modifier",
            "settings": { "foreground": "#39FF14CC" }
        },
        {
            "scope": "entity.name.function",
            "settings": { "foreground": "#FF00AA" }
        },
        {
            "scope": "entity.name.type",
            "settings": { "foreground": "#FF00AACC" }
        },
        {
            "scope": "entity.name.class",
            "settings": { "foreground": "#FF00AA", "fontStyle": "bold" }
        },
        { "scope": "entity.name.tag", "settings": { "foreground": "#39FF14" } },
        {
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#FF00AA" }
        },
        {
            "scope": "support.function",
            "settings": { "foreground": "#FF00AACC" }
        },
        { "scope": "support.type", "settings": { "foreground": "#39FF14CC" } },
        { "scope": "support.class", "settings": { "foreground": "#FF00AACC" } },
        {
            "scope": "support.constant",
            "settings": { "foreground": "#39FF14" }
        },
        {
            "scope": "meta.function-call",
            "settings": { "foreground": "#FF00AA" }
        },
        {
            "scope": "punctuation.separator",
            "settings": { "foreground": "#AAAAAA" }
        },
        {
            "scope": "invalid",
            "settings": { "foreground": "#FF4040", "fontStyle": "underline" }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "function": "#FF00AA",
        "method": "#FF00AA",
        "class": { "foreground": "#FF00AA", "bold": true },
        "interface": { "foreground": "#FF00AACC" },
        "type": "#FF00AACC",
        "keyword": { "foreground": "#39FF14", "bold": true },
        "variable": "#E8E8E8",
        "parameter": "#D0FFD0",
        "property": "#E8E8E8",
        "string": "#FF00AA",
        "number": "#39FF14",
        "comment": { "foreground": "#39FF1466", "italic": true },
        "namespace": "#FF00AACC",
        "enum": "#FF00AA",
        "enumMember": "#39FF14CC",
        "decorator": "#FF2DF7",
        "typeParameter": "#FF00AABB"
    }
}
