    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#6E6780", "fontStyle": "italic" }
        },
        {
            "name": "String",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#FFD36E" }
        },
        {
            "name": "String escape",
            "scope": ["constant.character.escape", "string.regexp"],
            "settings": { "foreground": "#FFC24A" }
        },
        {
            "name": "Keyword",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.new",
                "keyword.other.important"
            ],
            "settings": { "foreground": "#BF5FFF", "fontStyle": "bold" }
        },
        {
            "name": "Storage",
            "scope": ["storage.type", "storage.modifier"],
            "settings": { "foreground": "#BF5FFF", "fontStyle": "bold" }
        },
        {
            "name": "Function name",
            "scope": [
                "entity.name.function",
                "meta.function-call entity.name.function",
                "support.function"
            ],
            "settings": { "foreground": "#E0CAFF" }
        },
        {
            "name": "Class / Type name",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.class",
                "support.type"
            ],
            "settings": { "foreground": "#DDD5F0" }
        },
        {
            "name": "Inherited class",
            "scope": ["entity.other.inherited-class"],
            "settings": { "foreground": "#E0CAFF", "fontStyle": "italic" }
        },
        {
            "name": "Variable",
            "scope": ["variable", "variable.other.readwrite"],
            "settings": { "foreground": "#F3ECFF" }
        },
        {
            "name": "Variable parameter",
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#E0CAFF", "fontStyle": "italic" }
        },
        {
            "name": "Constant",
            "scope": ["variable.other.constant", "constant.other"],
            "settings": { "foreground": "#FFD36E", "fontStyle": "bold" }
        },
        {
            "name": "Number",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#FFD36E" }
        },
        {
            "name": "Boolean / Null / Undefined",
            "scope": ["constant.language"],
            "settings": { "foreground": "#BF5FFF", "fontStyle": "bold" }
        },
        {
            "name": "Tag",
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#BF5FFF" }
        },
        {
            "name": "Attribute name",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#E0CAFF" }
        },
        {
            "name": "Operator",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#E0CAFF" }
        },
        {
            "name": "Punctuation",
            "scope": ["punctuation", "meta.brace", "punctuation.accessor"],
            "settings": { "foreground": "#6E6780" }
        },
        {
            "name": "Import / Module name",
            "scope": [
                "entity.name.module",
                "support.module",
                "keyword.control.import",
                "keyword.control.from"
            ],
            "settings": { "foreground": "#BF5FFF" }
        },
        {
            "name": "Property / Field",
            "scope": [
                "variable.other.property",
                "support.variable.property",
                "variable.other.object.property"
            ],
            "settings": { "foreground": "#DDD5F0" }
        },
        {
            "name": "Decorator",
            "scope": ["meta.decorator", "punctuation.decorator"],
            "settings": { "foreground": "#FFD36E99" }
        },
        {
            "name": "Markdown heading",
            "scope": ["markup.heading", "entity.name.section.markdown"],
            "settings": { "foreground": "#BF5FFF", "fontStyle": "bold" }
        },
        {
            "name": "Markdown bold",
            "scope": ["markup.bold"],
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Markdown italic",
            "scope": ["markup.italic"],
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "Markdown code",
            "scope": ["markup.inline.raw", "markup.fenced_code.block"],
            "settings": { "foreground": "#E0CAFF" }
        },
        {
            "name": "Markdown link",
            "scope": ["markup.underline.link"],
            "settings": { "foreground": "#FFD36E" }
        },
        {
            "name": "Invalid / Deprecated",
            "scope": ["invalid", "invalid.illegal", "invalid.deprecated"],
            "settings": { "foreground": "#FF5A70", "fontStyle": "underline" }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "variable": "#F3ECFF",
        "variable.declaration": "#F3ECFF",
        "variable.readonly": { "foreground": "#FFD36E" },
        "property": "#DDD5F0",
        "property.declaration": "#E0CAFF",
        "class": "#DDD5F0",
        "interface": "#DDD5F0",
        "function": "#E0CAFF",
        "method": "#E0CAFF",
        "parameter": { "foreground": "#DDD5F0", "italic": true },
        "type": "#DDD5F0",
        "typeParameter": "#E0CAFF",
        "enum": "#FFD36E",
        "enumMember": "#FFD36E",
        "namespace": "#BF5FFF",
        "decorator": "#FFD36E99",
        "keyword": { "foreground": "#BF5FFF", "bold": true }
    },
    "$schema": "vscode://schemas/color-theme"
}
