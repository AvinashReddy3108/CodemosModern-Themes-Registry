    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#8A7A66", "fontStyle": "italic" }
        },
        {
            "name": "String",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#7A3300" }
        },
        {
            "name": "String escape",
            "scope": ["constant.character.escape", "string.regexp"],
            "settings": { "foreground": "#5A2200" }
        },
        {
            "name": "Keyword",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.new",
                "keyword.other.important"
            ],
            "settings": { "foreground": "#954422", "fontStyle": "bold" }
        },
        {
            "name": "Storage",
            "scope": ["storage.type", "storage.modifier"],
            "settings": { "foreground": "#954422", "fontStyle": "bold" }
        },
        {
            "name": "Function name",
            "scope": [
                "entity.name.function",
                "meta.function-call entity.name.function",
                "support.function"
            ],
            "settings": { "foreground": "#B35522" }
        },
        {
            "name": "Class / Type name",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.class",
                "support.type"
            ],
            "settings": { "foreground": "#1A2A5A" }
        },
        {
            "name": "Inherited class",
            "scope": ["entity.other.inherited-class"],
            "settings": { "foreground": "#B35522", "fontStyle": "italic" }
        },
        {
            "name": "Variable",
            "scope": ["variable", "variable.other.readwrite"],
            "settings": { "foreground": "#221A0F" }
        },
        {
            "name": "Variable parameter",
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#5A3A77", "fontStyle": "italic" }
        },
        {
            "name": "Constant",
            "scope": ["variable.other.constant", "constant.other"],
            "settings": { "foreground": "#7A3300", "fontStyle": "bold" }
        },
        {
            "name": "Number",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#7A3300" }
        },
        {
            "name": "Boolean / Null / Undefined",
            "scope": ["constant.language"],
            "settings": { "foreground": "#954422", "fontStyle": "bold" }
        },
        {
            "name": "Tag",
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#954422" }
        },
        {
            "name": "Attribute name",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#B35522" }
        },
        {
            "name": "Operator",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#B35522" }
        },
        {
            "name": "Punctuation",
            "scope": ["punctuation", "meta.brace", "punctuation.accessor"],
            "settings": { "foreground": "#8A7A66" }
        },
        {
            "name": "Property / Field",
            "scope": [
                "variable.other.property",
                "support.variable.property",
                "variable.other.object.property"
            ],
            "settings": { "foreground": "#3A3066" }
        },
        {
            "name": "Invalid / Deprecated",
            "scope": ["invalid", "invalid.illegal", "invalid.deprecated"],
            "settings": { "foreground": "#BB1122", "fontStyle": "underline" }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "variable": "#221A0F",
        "variable.declaration": "#221A0F",
        "variable.readonly": { "foreground": "#7A3300" },
        "property": "#3A3066",
        "property.declaration": "#B35522",
        "class": "#1A2A5A",
        "interface": "#1A2A5A",
        "function": "#B35522",
        "method": "#B35522",
        "parameter": { "foreground": "#5A3A77", "italic": true },
        "type": "#1A2A5A",
        "enum": "#7A3300",
        "enumMember": "#7A3300",
        "namespace": "#954422",
        "decorator": "#5A3A77",
        "keyword": { "foreground": "#954422", "bold": true },
        "comment": { "foreground": "#8A7A66", "italic": true },
        "number": "#7A3300",
        "string": "#7A3300",
        "operator": "#B35522",
        "typeParameter": "#B35522",
        "macro": "#5A3A77",
        "event": "#B35522",
        "label": "#954422",
        "regexp": "#BB1122"
    }
}
