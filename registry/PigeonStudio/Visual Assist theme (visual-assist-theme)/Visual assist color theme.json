{
    "name": "Visual Assist color theme",
    "colors": {
        "editor.background": "#1E1E1E",
        "editorCursor.foreground": "#DCDCDC",
        "editor.foreground": "#BDB76B",
        "editorWhitespace.foreground": "#8f8a8a7a",
        "editor.selectionBackground": "#264F78",
        "editor.lineHighlightBorder": "#404040",
        "editor.lineHighlightBackground": "#1b1b1b"
    },
    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "fontStyle": "", "foreground": "#53a347" }
        },
        {
            "name": "Variable",
            "scope": "variable",
            "settings": { "fontStyle": "", "foreground": "#beb66c" }
        },
        {
            "name": "Neutral element",
            "scope": ["punctuation", "keyword.operator"],
            "settings": { "fontStyle": "", "foreground": "#abacac" }
        },
        {
            "name": "Directives",
            "scope": [
                "keyword.other.directive.using",
                "keyword.preprocessor",
                "string.unquoted.preprocessor.message"
            ],
            "settings": { "fontStyle": "", "foreground": "#9b9b9b" }
        },
        {
            "name": "Keyword",
            "scope": "keyword.control",
            "settings": { "fontStyle": "", "foreground": "#ce99d9" }
        },
        {
            "name": "Storage",
            "scope": [
                "storage.modifier",
                "keyword.type",
                "keyword.operator.expression.new",
                "variable.language",
                "constant.language",
                "keyword.todo",
                "todo.keyword",
                "storage.type"
            ],
            "settings": { "fontStyle": "", "foreground": "#5392c3" }
        },
        {
            "name": "Namespace",
            "scope": "entity.name.type.namespace",
            "settings": { "fontStyle": "", "foreground": "#d39865" }
        },
        {
            "name": "Entity",
            "scope": ["entity.name.type", "support.type.unity"],
            "settings": { "fontStyle": "", "foreground": "#ddbd08" }
        },
        {
            "name": "Enum members",
            "scope": "entity.name.variable.enum-member",
            "settings": { "fontStyle": "", "foreground": "#b2751d" }
        },
        {
            "name": "Function",
            "scope": "entity.name.function",
            "settings": { "fontStyle": "", "foreground": "#f37108" }
        },
        {
            "name": "Text",
            "scope": "string.quoted",
            "settings": { "fontStyle": "", "foreground": "#c9947e" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
