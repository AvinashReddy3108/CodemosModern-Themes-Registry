ds — tag, func, Const","scope":["keyword.declaration.dorpn"],"settings":{"foreground":"#1d6eef","fontStyle":"bold"}},{"name":"Logical Keywords — and, or, not, fld","scope":["keyword.operator.logical.dorpn"],"settings":{"foreground":"#f5c2e7","fontStyle":"italic bold"}},{"name":"Built-in Types — Int, Float, String, Bool","scope":["support.type.dorpn"],"settings":{"foreground":"#3ddb57"}},{"name":"Function Definitions","scope":["entity.name.function.dorpn"],"settings":{"foreground":"#b444dd","fontStyle":"bold"}},{"name":"Tag (struct) Definitions","scope":["entity.name.type.dorpn"],"settings":{"foreground":"#f9e2af","fontStyle":"bold"}},{"name":"Function Calls","scope":["entity.name.function.call.dorpn"],"settings":{"foreground":"#5fc6d8"}},{"name":"Arithmetic Operators","scope":["keyword.operator.arithmetic.dorpn"],"settings":{"foreground":"#f38ba8"}},{"name":"Comparison Operators","scope":["keyword.operator.comparison.dorpn"],"settings":{"foreground":"#f5c2e7"}},{"name":"Assignment Operator","scope":["keyword.operator.assignment.dorpn"],"settings":{"foreground":"#94e2d5"}},{"name":"Accessor Dot","scope":["keyword.operator.accessor.dorpn"],"settings":{"foreground":"#6c7086"}},{"name":"Variables & Identifiers","scope":["variable.other.dorpn"],"settings":{"foreground":"#cdd6f4"}}],"$schema":"vscode://schemas/color-theme"}