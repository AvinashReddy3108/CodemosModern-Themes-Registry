{
    "name": "Neon Sunset",
    "type": "dark",
    "colors": {
        "editor.background": "#1e1e1e",
        "editor.foreground": "#eaeaea",
        "editorCursor.foreground": "#FF9248",
        "editor.lineHighlightBackground": "#2a2a2a",
        "editor.selectionBackground": "#3a3a3a",
        "editorLineNumber.foreground": "#6a6a6a",
        "editorLineNumber.activeForeground": "#FF9248",
        "editorIndentGuide.background1": "#333333",
        "editorIndentGuide.activeBackground1": "#555555",
        "sideBar.background": "#181818",
        "sideBar.foreground": "#cccccc",
        "sideBarTitle.foreground": "#FF9248",
        "activityBar.background": "#141414",
        "activityBar.foreground": "#87CEEB",
        "activityBarBadge.background": "#FF6B7A",
        "activityBarBadge.foreground": "#ffffff",
        "statusBar.background": "#141414",
        "statusBar.foreground": "#87CEEB",
        "statusBar.debuggingBackground": "#FF6B7A",
        "titleBar.activeBackground": "#141414",
        "titleBar.activeForeground": "#eaeaea",
        "tab.activeBackground": "#1e1e1e",
        "tab.activeForeground": "#FF9248",
        "tab.inactiveBackground": "#181818",
        "tab.inactiveForeground": "#888888",
        "tab.activeBorderTop": "#FF9248",
        "panel.background": "#181818",
        "panel.border": "#333333",
        "terminal.foreground": "#eaeaea",
        "terminal.ansiBlue": "#87CEEB",
        "terminal.ansiRed": "#FF6B7A",
        "terminal.ansiYellow": "#FF9248",
        "terminal.ansiMagenta": "#C792EA",
        "button.background": "#FF9248",
        "button.foreground": "#ffffff",
        "button.hoverBackground": "#ff8555",
        "input.background": "#2a2a2a",
        "input.foreground": "#eaeaea",
        "input.border": "#3a3a3a",
        "focusBorder": "#FF9248",
        "sideBar.border": "#1e1e1e",
        "list.focusOutline": "#00000000",
        "list.activeSelectionBackground": "#3a3a3a",
        "list.activeSelectionForeground": "#FF9248",
        "list.hoverBackground": "#2a2a2a",
        "scrollbarSlider.background": "#3a3a3a80",
        "scrollbarSlider.hoverBackground": "#55555580"
    },
    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#6a6a8a", "fontStyle": "italic" }
        },
        {
            "name": "Keywords",
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#C792EA" }
        },
        {
            "name": "Control Keywords",
            "scope": ["keyword.control", "keyword.operator.new"],
            "settings": { "foreground": "#C792EA" }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "meta.function-call",
                "support.function"
            ],
            "settings": { "foreground": "#87CEEB" }
        },
        {
            "name": "Classes and Types",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.class",
                "entity.other.inherited-class"
            ],
            "settings": { "foreground": "#FF9248" }
        },
        {
            "name": "Strings",
            "scope": ["string", "string.quoted"],
            "settings": { "foreground": "#C792EA" }
        },
        {
            "name": "Numbers",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#FF9248" }
        },
        {
            "name": "Constants",
            "scope": ["constant.language", "constant.other"],
            "settings": { "foreground": "#FF9248" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "variable.other"],
            "settings": { "foreground": "#eaeaea" }
        },
        {
            "name": "Variable Parameters",
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#FF9248" }
        },
        {
            "name": "Object Properties",
            "scope": [
                "variable.other.property",
                "variable.other.object.property"
            ],
            "settings": { "foreground": "#87CEEB" }
        },
        {
            "name": "Operators",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#FF6B7A" }
        },
        {
            "name": "Punctuation",
            "scope": ["punctuation"],
            "settings": { "foreground": "#cccccc" }
        },
        {
            "name": "HTML Tags",
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#FF6B7A" }
        },
        {
            "name": "JSX Component Tags",
            "scope": [
                "support.class.component.jsx",
                "support.class.component.tsx",
                "entity.name.tag support.class.component"
            ],
            "settings": { "foreground": "#FF9248" }
        },
        {
            "name": "HTML Attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#87CEEB" }
        },
        {
            "name": "CSS Properties",
            "scope": ["support.type.property-name.css"],
            "settings": { "foreground": "#87CEEB" }
        },
        {
            "name": "CSS Values",
            "scope": ["support.constant.property-value.css"],
            "settings": { "foreground": "#FF9248" }
        },
        {
            "name": "JSON Keys",
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#FF6B7A" }
        },
        {
            "name": "Markdown Headings",
            "scope": ["markup.heading", "entity.name.section.markdown"],
            "settings": { "foreground": "#FF9248", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Bold",
            "scope": ["markup.bold"],
            "settings": { "foreground": "#FF6B7A", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Italic",
            "scope": ["markup.italic"],
            "settings": { "foreground": "#87CEEB", "fontStyle": "italic" }
        },
        {
            "name": "Markdown Links",
            "scope": ["markup.underline.link"],
            "settings": { "foreground": "#87CEEB" }
        },
        {
            "name": "Regular Expressions",
            "scope": ["string.regexp"],
            "settings": { "foreground": "#FF6B7A" }
        },
        {
            "name": "Decorators/Annotations",
            "scope": ["meta.decorator", "meta.annotation"],
            "settings": { "foreground": "#FF9248" }
        },
        {
            "name": "Import/Export",
            "scope": [
                "keyword.control.import",
                "keyword.control.export",
                "keyword.control.from"
            ],
            "settings": { "foreground": "#FF6B7A" }
        },
        {
            "name": "Module Names",
            "scope": ["entity.name.module", "variable.import.parameter"],
            "settings": { "foreground": "#87CEEB" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
