        "editorGutter.addedBackground": "#ffcc00",
        "editorGutter.deletedBackground": "#79b8ff",
        "editorBracketMatch.background": "#161b22",
        "editorBracketMatch.border": "#21262d",
        "editorGroupHeader.tabsBackground": "#161b22",
        "editorGroup.border": "#21262d",
        "tab.activeBackground": "#161b22",
        "tab.inactiveBackground": "#30363d",
        "tab.inactiveForeground": "#f0f6fc",
        "tab.activeForeground": "#c9d1d9",
        "tab.hoverBackground": "#21262d",
        "tab.unfocusedHoverBackground": "#21262d",
        "tab.border": "#21262d",
        "tab.activeModifiedBorder": "#ff7b72",
        "tab.inactiveModifiedBorder": "#3fb950",
        "tab.unfocusedActiveModifiedBorder": "#ff7b72",
        "tab.unfocusedInactiveModifiedBorder": "#3fb950",
        "editorWidget.background": "#30363d",
        "editorWidget.border": "#21262d",
        "editorSuggestWidget.background": "#161b22",
        "editorSuggestWidget.border": "#21262d",
        "editorSuggestWidget.foreground": "#c9d1d9",
        "editorSuggestWidget.highlightForeground": "#f0f6fc",
        "editorSuggestWidget.selectedBackground": "#21262d",
        "peekView.border": "#21262d",
        "peekViewEditor.background": "#161b22",
        "peekViewEditor.matchHighlightBackground": "#30363d",
        "peekViewResult.background": "#30363d",
        "peekViewResult.fileForeground": "#c9d1d9",
        "peekViewResult.lineForeground": "#f0f6fc",
        "peekViewResult.matchHighlightBackground": "#30363d",
        "peekViewResult.selectionBackground": "#161b22",
        "peekViewResult.selectionForeground": "#f78166",
        "peekViewTitle.background": "#21262d",
        "peekViewTitleDescription.foreground": "#f0f6fc",
        "peekViewTitleLabel.foreground": "#c9d1d9",
        "merge.currentHeaderBackground": "#ffcc0044",
        "merge.currentContentBackground": "#ffcc0044",
        "merge.incomingHeaderBackground": "#ffcc0044",
        "merge.incomingContentBackground": "#ffcc0044",
        "merge.border": "#21262d",
        "merge.commonContentBackground": "#30363d66",
        "merge.commonHeaderBackground": "#21262d66",
        "panel.background": "#161b22",
        "panel.border": "#21262d",
        "panelTitle.activeBorder": "#30363d",
        "panelTitle.activeForeground": "#c9d1d9",
        "panelTitle.inactiveForeground": "#f0f6fc",
        "statusBar.background": "#161b22",
        "statusBar.foreground": "#c9d1d9",
        "statusBar.border": "#21262d",
        "statusBar.debuggingBackground": "#79b8ff",
        "statusBar.debuggingForeground": "#c9d1d9",
        "statusBar.noFolderBackground": "#30363d",
        "statusBar.noFolderForeground": "#f78166",
        "titleBar.activeBackground": "#161b22",
        "titleBar.activeForeground": "#c9d1d9",
        "titleBar.inactiveBackground": "#30363d",
        "titleBar.inactiveForeground": "#f0f6fc",
        "titleBar.border": "#21262d",
        "menu.foreground": "#c9d1d9",
        "menu.background": "#161b22",
        "menu.selectionForeground": "#c9d1d9",
        "menu.selectionBackground": "#21262d",
        "menu.border": "#21262d",
        "editorInlayHint.foreground": "#f0f6fc",
        "editorInlayHint.background": "#21262d",
        "terminal.foreground": "#c9d1d9",
        "terminal.background": "#161b22",
        "terminalCursor.foreground": "#c9d1d9",
        "terminalCursor.background": "#161b22",
        "terminal.ansiRed": "#79b8ff",
        "terminal.ansiGreen": "#ffcc00",
        "terminal.ansiYellow": "#ff7b72",
        "terminal.ansiBlue": "#3fb950",
        "terminal.ansiMagenta": "#ffcc00",
        "terminal.ansiCyan": "#ffcc00",
        "activityBar.background": "#161b22",
        "activityBar.foreground": "#c9d1d9",
        "activityBar.inactiveForeground": "#f0f6fc",
        "activityBar.activeBorder": "#c9d1d9",
        "activityBar.border": "#21262d",
        "sideBar.background": "#161b22",
        "sideBar.foreground": "#c9d1d9",
        "sideBar.border": "#21262d",
        "sideBarTitle.foreground": "#c9d1d9",
        "sideBarSectionHeader.background": "#30363d",
        "sideBarSectionHeader.foreground": "#c9d1d9",
        "sideBarSectionHeader.border": "#21262d",
        "settings.headerForeground": "#c9d1d9",
        "settings.modifiedItemForeground": "#79b8ff",
        "settings.textInputForeground": "#c9d1d9",
        "textLink.foreground": "#ff7b72",
        "sideBar.activeBackground": "#30363d",
        "sideBar.activeForeground": "#c9d1d9",
        "sideBar.hoverBackground": "#21262d",
        "sideBar.hoverForeground": "#f0f6fc",
        "sideBar.folderIcon.foreground": "#ffcc00",
        "sideBar.fileIcon.foreground": "#3fb950",
        "list.foreground": "#c9d1d9",
        "list.inactiveSelectionBackground": "#21262d",
        "list.activeSelectionBackground": "#30363d",
        "list.inactiveSelectionForeground": "#c9d1d9",
        "list.activeSelectionForeground": "#c9d1d9",
        "list.focusOutline": "#ff7b72",
        "list.inactiveFocusOutline": "#21262d",
        "list.hoverForeground": "#c9d1d9",
        "list.hoverBackground": "#21262d",
        "input.background": "#30363d",
        "input.foreground": "#c9d1d9",
        "input.border": "#21262d",
        "input.placeholderForeground": "#f0f6fc",
        "inputOption.activeBorder": "#21262d",
        "inputOption.activeBackground": "#161b22",
        "inputOption.activeForeground": "#c9d1d9",
        "dropdown.background": "#30363d",
        "dropdown.foreground": "#c9d1d9",
        "dropdown.border": "#21262d",
        "dropdown.listBackground": "#161b22",
        "badge.background": "#3fb950",
        "activityBarBadge.background": "#3fb950",
        "button.background": "#3fb950",
        "button.foreground": "#161b22",
        "badge.foreground": "#161b22",
        "activityBarBadge.foreground": "#161b22"
    },
    "tokenColors": [
        {
            "name": "plain",
            "scope": ["source", "support.type.property-name.css"],
            "settings": { "foreground": "#c9d1d9" }
        },
        {
            "name": "classes",
            "scope": ["entity.name.type.class"],
            "settings": { "foreground": "#ff7b72" }
        },
        {
            "name": "interfaces",
            "scope": ["entity.name.type.interface", "entity.name.type"],
            "settings": { "foreground": "#ff7b72" }
        },
        {
            "name": "structs",
            "scope": ["entity.name.type.struct"],
            "settings": { "foreground": "#ff7b72" }
        },
        {
            "name": "enums",
            "scope": ["entity.name.type.enum"],
            "settings": { "foreground": "#ff7b72" }
        },
        {
            "name": "keys",
            "scope": ["meta.object-literal.key"],
            "settings": { "foreground": "#c9d1d9" }
        },
        {
            "name": "methods",
            "scope": ["entity.name.function.method", "meta.function.method"],
            "settings": { "foreground": "#3fb950" }
        },
        {
            "name": "functions",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call.generic"
            ],
            "settings": { "foreground": "#ff7b72" }
        },
        {
            "name": "variables",
            "scope": [
                "variable",
                "meta.variable",
                "variable.other.object.property",
                "variable.other.readwrite.alias"
            ],
            "settings": { "foreground": "#c9d1d9" }
        },
        {
            "name": "variablesOther",
            "scope": ["variable.other.object"],
            "settings": { "foreground": "#3fb950" }
        },
        {
            "name": "globalVariables",
            "scope": ["variable.other.global", "variable.language.this"],
            "settings": { "foreground": "#ffcc00" }
        },
        {
            "name": "localVariables",
            "scope": ["variable.other.local"],
            "settings": { "foreground": "#c9d1d9" }
        },
        {
            "name": "parameters",
            "scope": ["variable.parameter", "meta.parameter"],
            "settings": { "foreground": "#c9d1d9" }
        },
        {
            "name": "properties",
            "scope": ["variable.other.property", "meta.property"],
            "settings": { "foreground": "#c9d1d9" }
        },
        {
            "name": "strings",
            "scope": [
                "string",
                "string.other.link",
                "markup.inline.raw.string.markdown"
            ],
            "settings": { "foreground": "#ffcc00" }
        },
        {
            "name": "stringEscapeSequences",
            "scope": [
                "constant.character.escape",
                "constant.other.placeholder"
            ],
            "settings": { "foreground": "#c9d1d9" }
        },
        {
            "name": "keywords",
            "scope": ["keyword"],
            "settings": { "foreground": "#79b8ff" }
        },
        {
            "name": "keywordsControl",
            "scope": [
                "keyword.control.import",
                "keyword.control.from",
                "keywaord.import"
            ],
            "settings": { "foreground": "#79b8ff" }
        },
        {
            "name": "storageModifiers",
            "scope": ["storage.modifier", "keyword.modifier", "storage.type"],
            "settings": { "foreground": "#79b8ff" }
        },
        {
            "name": "comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#f78166" }
        },
        {
            "name": "docComments",
            "scope": ["comment.documentation", "comment.line.documentation"],
            "settings": { "foreground": "#f78166" }
        },
        {
            "name": "numbers",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#f37272" }
        },
        {
            "name": "booleans",
            "scope": ["constant.language.boolean", "constant.language.json"],
            "settings": { "foreground": "#f37272" }
        },
        {
            "name": "operators",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#79b8ff" }
        },
        {
            "name": "macros",
            "scope": ["entity.name.function.preprocessor", "meta.preprocessor"],
            "settings": { "foreground": "#3fb950" }
        },
        {
            "name": "preprocessor",
            "scope": ["meta.preprocessor"],
            "settings": { "foreground": "#ffcc00" }
        },
        {
            "name": "urls",
            "scope": ["markup.underline.link"],
            "settings": { "foreground": "#3fb950" }
        },
        {
            "name": "tags",
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#79b8ff" }
        },
        {
            "name": "jsxTags",
            "scope": ["support.class.component"],
            "settings": { "foreground": "#3fb950" }
        },
        {
            "name": "attributes",
            "scope": ["entity.other.attribute-name", "meta.attribute"],
            "settings": { "foreground": "#ff7b72" }
        },
        {
            "name": "types",
            "scope": ["support.type"],
            "settings": { "foreground": "#3fb950" }
        },
        {
            "name": "constants",
            "scope": ["variable.other.constant", "variable.readonly"],
            "settings": { "foreground": "#3fb950" }
        },
        {
            "name": "labels",
            "scope": ["entity.name.label", "punctuation.definition.label"],
            "settings": { "foreground": "#ffcc00" }
        },
        {
            "name": "namespaces",
            "scope": [
                "entity.name.namespace",
                "storage.modifier.namespace",
                "markup.bold.markdown"
            ],
            "settings": { "foreground": "#ff7b72" }
        },
        {
            "name": "modules",
            "scope": ["entity.name.module", "storage.modifier.module"],
            "settings": { "foreground": "#79b8ff" }
        },
        {
            "name": "typeParameters",
            "scope": ["variable.type.parameter", "variable.parameter.type"],
            "settings": { "foreground": "#ff7b72" }
        },
        {
            "name": "exceptions",
            "scope": ["keyword.control.exception", "keyword.control.trycatch"],
            "settings": { "foreground": "#79b8ff" }
        },
        {
            "name": "decorators",
            "scope": [
                "meta.decorator",
                "punctuation.decorator",
                "entity.name.function.decorator"
            ],
            "settings": { "foreground": "#ff7b72" }
        },
        {
            "name": "calls",
            "scope": ["variable.function"],
            "settings": { "foreground": "#c9d1d9" }
        },
        {
            "name": "punctuation",
            "scope": [
                "punctuation",
                "punctuation.terminator",
                "punctuation.definition.tag",
                "punctuation.separator",
                "punctuation.definition.string",
                "punctuation.section.block"
            ],
            "settings": { "foreground": "#c9d1d9" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
