        "input.background": "#2a2a2a",
        "input.foreground": "#ffffff",
        "input.border": "#3c3c3c",
        "input.placeholderForeground": "#d9d9d9",
        "inputOption.activeBorder": "#3c3c3c",
        "inputOption.activeBackground": "#4f4f4f",
