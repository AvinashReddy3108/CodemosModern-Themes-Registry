        "terminalCursor.foreground": "#ffffff",
        "terminalCursor.background": "#171717",
        "terminal.ansiRed": "#f5ff00",
        "terminal.ansiGreen": "#816e5b",
        "terminal.ansiYellow": "#5c4d3a",
        "terminal.ansiBlue": "#a0a477",
        "terminal.ansiMagenta": "#816e5b",
        "terminal.ansiCyan": "#816e5b",
