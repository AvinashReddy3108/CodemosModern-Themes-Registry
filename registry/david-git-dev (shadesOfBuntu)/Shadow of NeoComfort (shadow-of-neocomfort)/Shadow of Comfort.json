        "activityBar.inactiveForeground": "#d9d9d9",
        "activityBar.activeBorder": "#ffffff",
        "activityBar.border": "#3c3c3c",
        "sideBar.background": "#171717",
        "sideBar.foreground": "#ffffff",
        "sideBar.border": "#3c3c3c",
        "sideBarTitle.foreground": "#ffffff",
        "sideBarSectionHeader.background": "#2a2a2a",
        "sideBarSectionHeader.foreground": "#ffffff",
        "sideBarSectionHeader.border": "#3c3c3c",
        "settings.headerForeground": "#ffffff",
        "settings.modifiedItemForeground": "#f5ff00",
        "settings.textInputForeground": "#ffffff",
        "textLink.foreground": "#5c4d3a",
        "sideBar.activeBackground": "#282828",
        "sideBar.activeForeground": "#ffffff",
        "sideBar.hoverBackground": "#3c3c3c",
