{
    "name": "Pôr do Sol",
    "type": "light",
    "colors": {
        "editor.background": "#FFFFFF",
        "editor.foreground": "#D2691E",
        "editor.lineHighlightBackground": "#FFE4B5",
        "editorLineNumber.foreground": "#FF4500",
        "activityBar.background": "#FF7F50",
        "sideBar.background": "#FFDAB9",
        "activityBar.foreground": "#FFFFFF",
        "activityBarBadge.background": "#FF6347",
        "statusBar.background": "#FF4500",
        "statusBar.foreground": "#FFFFFF",
        "statusBarItem.hoverBackground": "#CD5C5C",
        "titleBar.activeBackground": "#FF4500",
        "titleBar.activeForeground": "#FFFFFF",
        "titleBar.inactiveBackground": "#FF7F50",
        "titleBar.inactiveForeground": "#FFFFFF",
        "button.background": "#FF6347",
        "dropdown.background": "#FFFFFF",
        "dropdown.foreground": "#D2691E",
        "dropdown.border": "#D2691E",
        "input.background": "#FFFFFF",
        "input.foreground": "#FF7F50",
        "input.border": "#FF7F50",
        "terminal.foreground": "#FF6347",
        "scrollbarSlider.background": "#FF8C00",
        "scrollbarSlider.hoverBackground": "#FFA07A",
        "scrollbarSlider.activeBackground": "#FF7F50",
        "badge.background": "#FF6347",
        "badge.foreground": "#D2691E",
        "peekView.border": "#FF6347",
        "peekViewEditor.background": "#FFE4B5",
        "peekViewResult.background": "#FFE4E1",
        "panel.background": "#FFDAB9",
        "panel.border": "#D2691E",
        "panelTitle.activeForeground": "#D2691E",
        "panelTitle.inactiveForeground": "#FF4500"
    },
    "tokenColors": [
        {
            "name": "Comentários",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#008000", "fontStyle": "italic" }
        },
        {
            "name": "Strings",
            "scope": ["string"],
            "settings": { "foreground": "#f20", "fontStyle": "bold" }
        },
        {
            "name": "Funções",
            "scope": ["entity.name.function"],
            "settings": { "foreground": "#0000ff" }
        },
        {
            "name": "Variáveis",
            "scope": ["variable"],
            "settings": { "foreground": "#800080" }
        },
        {
            "name": "Palavras-chave",
            "scope": ["keyword"],
            "settings": { "foreground": "#ff1493" }
        },
        {
            "name": "Constantes",
            "scope": ["constant"],
            "settings": { "foreground": "#8b0000" }
        },
        {
            "name": "Números",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#483d8b", "fontStyle": "bold" }
        },
        {
            "name": "Nomes de Propriedades JSON",
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#09F" }
        },
        {
            "name": "Valores de Strings JSON",
            "scope": ["string.quoted.double"],
            "settings": { "foreground": "#ff1493", "fontStyle": "bold" }
        },
        {
            "name": "Nomes de Propriedades CSS",
            "scope": ["support.type.property-name.css"],
            "settings": { "foreground": "#09F" }
        },
        {
            "name": "Valores Numéricos CSS",
            "scope": ["constant.numeric.css"],
            "settings": { "foreground": "#09F", "fontStyle": "bold" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
