{
    "name": "Meu Tema Claro Colorido - Deserto Misterioso",
    "type": "light",
    "colors": {
        "editor.background": "#FFFFE0",
        "editor.foreground": "#000",
        "editor.lineHighlightBackground": "#faeccf",
        "editorLineNumber.foreground": "#5a4d39",
        "activityBar.background": "#f4dfb2",
        "sideBar.background": "#f2e2b6",
        "activityBar.foreground": "#654b32",
        "activityBarBadge.background": "#d4af37",
        "statusBar.background": "#f0d9a3",
        "statusBar.foreground": "#4a3b27",
        "statusBarItem.hoverBackground": "#eedb9b",
        "titleBar.activeBackground": "#ebd294",
        "titleBar.activeForeground": "#453821",
        "titleBar.inactiveBackground": "#e8d090",
        "titleBar.inactiveForeground": "#40361b",
        "button.background": "#d4af37",
        "dropdown.background": "#e6d2a2",
        "dropdown.foreground": "#453720",
        "dropdown.border": "#b28f56",
        "input.background": "#f5e5c0",
        "input.foreground": "#4f3e2a",
        "input.border": "#c5b08a",
        "terminal.foreground": "#5a4c39",
        "scrollbarSlider.background": "#e0cfa5",
        "scrollbarSlider.hoverBackground": "#dabf91",
        "scrollbarSlider.activeBackground": "#c9af7c"
    },
    "tokenColors": [
        {
            "name": "Comentários",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#008000", "fontStyle": "italic" }
        },
        {
            "name": "Strings",
            "scope": ["string"],
            "settings": { "foreground": "#f20", "fontStyle": "bold" }
        },
        {
            "name": "Funções",
            "scope": ["entity.name.function"],
            "settings": { "foreground": "#0000ff" }
        },
        {
            "name": "Variáveis",
            "scope": ["variable"],
            "settings": { "foreground": "#800080" }
        },
        {
            "name": "Palavras-chave",
            "scope": ["keyword"],
            "settings": { "foreground": "#ff1493" }
        },
        {
            "name": "Constantes",
            "scope": ["constant"],
            "settings": { "foreground": "#8b0000" }
        },
        {
            "name": "Números",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#483d8b", "fontStyle": "bold" }
        },
        {
            "name": "Nomes de Propriedades JSON",
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#09F" }
        },
        {
            "name": "Valores de Strings JSON",
            "scope": ["string.quoted.double"],
            "settings": { "foreground": "#ff1493", "fontStyle": "bold" }
        },
        {
            "name": "Nomes de Propriedades CSS",
            "scope": ["support.type.property-name.css"],
            "settings": { "foreground": "#09F" }
        },
        {
            "name": "Valores Numéricos CSS",
            "scope": ["constant.numeric.css"],
            "settings": { "foreground": "#09F", "fontStyle": "bold" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
