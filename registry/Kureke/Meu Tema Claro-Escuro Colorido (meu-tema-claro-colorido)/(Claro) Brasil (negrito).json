{
    "name": "Brasil",
    "type": "light",
    "colors": {
        "editor.background": "#FFFFFF",
        "editor.foreground": "#070",
        "editor.lineHighlightBackground": "#FFFF8D",
        "editorLineNumber.foreground": "#256D85",
        "activityBar.background": "#00796B",
        "sideBar.background": "#FFF59D",
        "activityBar.foreground": "#FFFFFF",
        "activityBarBadge.background": "#FDD835",
        "statusBar.background": "#0288D1",
        "statusBar.foreground": "#FFFFFF",
        "statusBarItem.hoverBackground": "#004D40",
        "titleBar.activeBackground": "#0288D1",
        "titleBar.activeForeground": "#FFFFFF",
        "titleBar.inactiveBackground": "#0cf",
        "titleBar.inactiveForeground": "#FFFFFF",
        "button.background": "#FDD835",
        "dropdown.background": "#FFFFFF",
        "dropdown.foreground": "#004D40",
        "dropdown.border": "#004D40",
        "input.background": "#FFFFFF",
        "input.foreground": "#00796B",
        "input.border": "#00796B",
        "terminal.foreground": "#004D40",
        "scrollbarSlider.background": "#00AA00",
        "scrollbarSlider.hoverBackground": "#81C784",
        "scrollbarSlider.activeBackground": "#66BB6A",
        "badge.background": "#FDD835",
        "badge.foreground": "#004D40",
        "peekView.border": "#FDD835",
        "peekViewEditor.background": "#FFF9C4",
        "peekViewResult.background": "#FFFDE7",
        "panel.background": "#FFF59D",
        "panel.border": "#004D40",
        "panelTitle.activeForeground": "#004D40",
        "panelTitle.inactiveForeground": "#80CBC4"
    },
    "tokenColors": [
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#aaa", "fontStyle": "italic" }
        },
        {
            "scope": ["string"],
            "settings": { "foreground": "#f20", "fontStyle": "bold" }
        },
        {
            "scope": ["entity.name.function"],
            "settings": { "foreground": "#0000ff", "fontStyle": "bold" }
        },
        {
            "scope": ["variable"],
            "settings": { "foreground": "#800080", "fontStyle": "bold" }
        },
        {
            "scope": ["keyword"],
            "settings": { "foreground": "#ff1493", "fontStyle": "bold" }
        },
        {
            "scope": ["constant"],
            "settings": { "foreground": "#8b0000", "fontStyle": "bold" }
        },
        {
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#483d8b", "fontStyle": "bold" }
        },
        {
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#09F", "fontStyle": "bold" }
        },
        {
            "scope": ["string.quoted.double"],
            "settings": { "foreground": "#ff1493", "fontStyle": "bold" }
        },
        {
            "scope": ["support.type.property-name.css"],
            "settings": { "foreground": "#09F", "fontStyle": "bold" }
        },
        {
            "scope": ["constant.numeric.css"],
            "settings": { "foreground": "#09F", "fontStyle": "bold" }
        },
        { "scope": "entity.name.tag.html" },
        {
            "scope": "entity.other.attribute-name.html",
            "settings": { "foreground": "#0000ff", "fontStyle": "bold" }
        },
        {
            "scope": "string.quoted.double.html",
            "settings": { "foreground": "#f20", "fontStyle": "bold" }
        },
        {
            "scope": "comment.block.html",
            "settings": { "foreground": "#aaa", "fontStyle": "italic" }
        },
        { "scope": "text.html.basic", "settings": { "foreground": "#800080" } },
        {
            "scope": "markdown.heading",
            "settings": { "foreground": "#ff1493", "fontStyle": "bold" }
        },
        {
            "scope": "markdown.italic",
            "settings": { "foreground": "#800080", "fontStyle": "italic" }
        },
        {
            "scope": "markdown.bold",
            "settings": { "foreground": "#0000ff", "fontStyle": "bold" }
        },
        {
            "scope": "markdown.quote",
            "settings": { "foreground": "#aaa", "fontStyle": "italic" }
        },
        {
            "scope": [
                "markdown.list",
                "markdown.list.numbered",
                "markdown.list.unnumbered"
            ],
            "settings": { "foreground": "#483d8b", "fontStyle": "bold" }
        },
        {
            "scope": "markdown.code",
            "settings": { "foreground": "#09F", "fontStyle": "bold" }
        },
        {
            "scope": "markup.inline.raw",
            "settings": { "foreground": "#f20", "fontStyle": "bold" }
        },
        {
            "scope": "constant.character.entity.html",
            "settings": { "foreground": "#483d8b", "fontStyle": "bold" }
        },
        {
            "scope": "meta.tag.metadata.script.html",
            "settings": { "foreground": "#09F", "fontStyle": "bold" }
        },
        {
            "scope": "entity.name.tag.script.html",
            "settings": { "foreground": "#ff1493", "fontStyle": "bold" }
        },
        { "scope": "source.python", "settings": { "fontStyle": "bold" } },
        {
            "scope": "storage.type.function.python",
            "settings": { "foreground": "#0000ff", "fontStyle": "bold" }
        },
        {
            "scope": "keyword.control.python",
            "settings": { "foreground": "#ff1493", "fontStyle": "bold" }
        },
        {
            "scope": "string.quoted.single.python",
            "settings": { "foreground": "#800080", "fontStyle": "bold" }
        },
        {
            "scope": "storage.type.java",
            "settings": { "foreground": "#ff1493", "fontStyle": "bold" }
        },
        {
            "scope": "storage.modifier.java",
            "settings": { "foreground": "#ff1493", "fontStyle": "bold" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
