{
    "name": "Meu Tema Colorido da Noiva",
    "type": "light",
    "colors": {
        "editor.background": "#ffffff",
        "editor.foreground": "#000000",
        "editor.lineHighlightBackground": "#f2e6d9",
        "editorLineNumber.foreground": "#a3898a",
        "activityBar.background": "#f2d1d1",
        "sideBar.background": "#f5e6e6",
        "activityBar.foreground": "#ff0000",
        "activityBarBadge.background": "#ff4500",
        "statusBar.background": "#ffa500",
        "statusBar.foreground": "#ffffff",
        "statusBarItem.hoverBackground": "#ff69b4",
        "titleBar.activeBackground": "#ffc0cb",
        "titleBar.activeForeground": "#000000",
        "titleBar.inactiveBackground": "#fed4d4",
        "titleBar.inactiveForeground": "#000000",
        "button.background": "#ffb6c1",
        "dropdown.background": "#fee3e3",
        "dropdown.foreground": "#000000",
        "dropdown.border": "#ffc3c9",
        "input.background": "#ffe4e1",
        "input.foreground": "#000000",
        "input.border": "#ffb3b8",
        "terminal.foreground": "#9400d3",
        "scrollbarSlider.background": "#f5b3b9",
        "scrollbarSlider.hoverBackground": "#f498a7",
        "scrollbarSlider.activeBackground": "#f27d8b"
    },
    "tokenColors": [
        {
            "name": "Comentários",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#960", "fontStyle": "italic" }
        },
        {
            "name": "Strings",
            "scope": ["string"],
            "settings": { "foreground": "#f20", "fontStyle": "bold" }
        },
        {
            "name": "Funções",
            "scope": ["entity.name.function"],
            "settings": { "foreground": "#0000ff" }
        },
        {
            "name": "Variáveis",
            "scope": ["variable"],
            "settings": { "foreground": "#800080" }
        },
        {
            "name": "Palavras-chave",
            "scope": ["keyword"],
            "settings": { "foreground": "#ff1493" }
        },
        {
            "name": "Constantes",
            "scope": ["constant"],
            "settings": { "foreground": "#8b0000" }
        },
        {
            "name": "Números",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#483d8b", "fontStyle": "bold" }
        },
        {
            "name": "Nomes de Propriedades JSON",
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#09F" }
        },
        {
            "name": "Valores de Strings JSON",
            "scope": ["string.quoted.double"],
            "settings": { "foreground": "#ff1493", "fontStyle": "bold" }
        },
        {
            "name": "Nomes de Propriedades CSS",
            "scope": ["support.type.property-name.css"],
            "settings": { "foreground": "#09F" }
        },
        {
            "name": "Valores Numéricos CSS",
            "scope": ["constant.numeric.css"],
            "settings": { "foreground": "#09F", "fontStyle": "bold" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
