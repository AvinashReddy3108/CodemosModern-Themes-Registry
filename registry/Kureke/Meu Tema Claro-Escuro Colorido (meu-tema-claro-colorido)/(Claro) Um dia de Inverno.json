{
    "name": "Meu Tema de Inverno",
    "type": "light",
    "colors": {
        "editor.background": "#ffffff",
        "editor.foreground": "#000000",
        "editor.lineHighlightBackground": "#e0e0e0",
        "editorLineNumber.foreground": "#888888",
        "activityBar.background": "#D6EAF8",
        "sideBar.background": "#D5DBDB",
        "activityBar.foreground": "#1A5276",
        "activityBarBadge.background": "#2E86C1",
        "statusBar.background": "#5DADE2",
        "statusBar.foreground": "#ffffff",
        "statusBarItem.hoverBackground": "#5499C7",
        "titleBar.activeBackground": "#2980B9",
        "titleBar.activeForeground": "#ffffff",
        "titleBar.inactiveBackground": "#add8e6",
        "titleBar.inactiveForeground": "#000000",
        "button.background": "#85C1E9",
        "dropdown.background": "#AED6F1",
        "dropdown.foreground": "#000000",
        "dropdown.border": "#5DADE2",
        "input.background": "#EBF5FB",
        "input.foreground": "#000000",
        "input.border": "#7FB3D5",
        "terminal.foreground": "#3498DB",
        "scrollbarSlider.background": "#AED6F1",
        "scrollbarSlider.hoverBackground": "#5499C7",
        "scrollbarSlider.activeBackground": "#2980B9",
        "badge.background": "#5499C7",
        "badge.foreground": "#ffffff",
        "peekView.border": "#3498DB",
        "peekViewEditor.background": "#D6EAF8",
        "peekViewResult.background": "#AED6F1",
        "panel.background": "#D4E6F1",
        "panel.border": "#3498DB",
        "panelTitle.activeForeground": "#1A5276",
        "panelTitle.inactiveForeground": "#5499C7"
    },
    "tokenColors": [
        {
            "name": "Comentários",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#008000", "fontStyle": "italic" }
        },
        {
            "name": "Strings",
            "scope": ["string"],
            "settings": { "foreground": "#f20", "fontStyle": "bold" }
        },
        {
            "name": "Funções",
            "scope": ["entity.name.function"],
            "settings": { "foreground": "#0000ff" }
        },
        {
            "name": "Variáveis",
            "scope": ["variable"],
            "settings": { "foreground": "#800080" }
        },
        {
            "name": "Palavras-chave",
            "scope": ["keyword"],
            "settings": { "foreground": "#ff1493" }
        },
        {
            "name": "Constantes",
            "scope": ["constant"],
            "settings": { "foreground": "#8b0000" }
        },
        {
            "name": "Números",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#483d8b", "fontStyle": "bold" }
        },
        {
            "name": "Nomes de Propriedades JSON",
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#09F" }
        },
        {
            "name": "Valores de Strings JSON",
            "scope": ["string.quoted.double"],
            "settings": { "foreground": "#ff1493", "fontStyle": "bold" }
        },
        {
            "name": "Nomes de Propriedades CSS",
            "scope": ["support.type.property-name.css"],
            "settings": { "foreground": "#09F" }
        },
        {
            "name": "Valores Numéricos CSS",
            "scope": ["constant.numeric.css"],
            "settings": { "foreground": "#09F", "fontStyle": "bold" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
