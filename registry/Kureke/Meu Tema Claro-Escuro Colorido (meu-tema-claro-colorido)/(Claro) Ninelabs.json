{
    "name": "ninelabs",
    "type": "light",
    "colors": {
        "editor.background": "#ffffff",
        "editor.foreground": "#102136",
        "editor.lineHighlightBackground": "#F3F5F7",
        "editorLineNumber.foreground": "#4d5d6d",
        "activityBar.background": "#9b51e0",
        "sideBar.background": "#FBFBFC",
        "activityBar.foreground": "#ffffff",
        "activityBarBadge.background": "#7456f1",
        "statusBar.background": "#5e3fde",
        "statusBar.foreground": "#ffffff",
        "statusBarItem.hoverBackground": "#4d5d6d",
        "titleBar.activeBackground": "#5e3fde",
        "titleBar.activeForeground": "#ffffff",
        "titleBar.inactiveBackground": "#E7EBEE",
        "titleBar.inactiveForeground": "#102136",
        "button.background": "#9b51e0",
        "dropdown.background": "#FBFBFC",
        "dropdown.foreground": "#102136",
        "dropdown.border": "#7456f1",
        "input.background": "#E7EBEE",
        "input.foreground": "#102136",
        "input.border": "#5e3fde",
        "terminal.foreground": "#4d5d6d",
        "scrollbarSlider.background": "#7456f1",
        "scrollbarSlider.hoverBackground": "#9b51e0",
        "scrollbarSlider.activeBackground": "#5e3fde",
        "badge.background": "#7456f1",
        "badge.foreground": "#ffffff",
        "peekView.border": "#9b51e0",
        "peekViewEditor.background": "#F3F5F7",
        "peekViewResult.background": "#E7EBEE",
        "panel.background": "#FBFBFC",
        "panel.border": "#102136",
        "panelTitle.activeForeground": "#102136",
        "panelTitle.inactiveForeground": "#4d5d6d"
    },
    "tokenColors": [
        {
            "name": "Comentários",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#aaa", "fontStyle": "italic" }
        },
        {
            "name": "Strings",
            "scope": ["string"],
            "settings": { "foreground": "#f20", "fontStyle": "bold" }
        },
        {
            "name": "Funções",
            "scope": ["entity.name.function"],
            "settings": { "foreground": "#0000ff" }
        },
        {
            "name": "Variáveis",
            "scope": ["variable"],
            "settings": { "foreground": "#800080" }
        },
        {
            "name": "Palavras-chave",
            "scope": ["keyword"],
            "settings": { "foreground": "#ff1493" }
        },
        {
            "name": "Constantes",
            "scope": ["constant"],
            "settings": { "foreground": "#8b0000" }
        },
        {
            "name": "Números",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#483d8b", "fontStyle": "bold" }
        },
        {
            "name": "Nomes de Propriedades JSON",
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#09F" }
        },
        {
            "name": "Valores de Strings JSON",
            "scope": ["string.quoted.double"],
            "settings": { "foreground": "#ff1493", "fontStyle": "bold" }
        },
        {
            "name": "Nomes de Propriedades CSS",
            "scope": ["support.type.property-name.css"],
            "settings": { "foreground": "#09F" }
        },
        {
            "name": "Valores Numéricos CSS",
            "scope": ["constant.numeric.css"],
            "settings": { "foreground": "#09F", "fontStyle": "bold" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
