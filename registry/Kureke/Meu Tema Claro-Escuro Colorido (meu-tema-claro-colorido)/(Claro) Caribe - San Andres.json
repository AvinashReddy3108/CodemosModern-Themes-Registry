{
    "name": "Caribe",
    "type": "light",
    "colors": {
        "editor.background": "#fff",
        "editor.foreground": "#030",
        "editor.lineHighlightBackground": "#B2EBF2",
        "editorLineNumber.foreground": "#00796B",
        "activityBar.background": "#0288D1",
        "sideBar.background": "#B3E5FC",
        "activityBar.foreground": "#FFFFFF",
        "activityBarBadge.background": "#00ACC1",
        "statusBar.background": "#00BCD4",
        "statusBar.foreground": "#FFFFFF",
        "statusBarItem.hoverBackground": "#0097A7",
        "titleBar.activeBackground": "#00ACC1",
        "titleBar.activeForeground": "#FFFFFF",
        "titleBar.inactiveBackground": "#4DD0E1",
        "titleBar.inactiveForeground": "#FFFFFF",
        "button.background": "#00ACC1",
        "dropdown.background": "#E0F7FA",
        "dropdown.foreground": "#004D40",
        "dropdown.border": "#004D40",
        "input.background": "#E0F7FA",
        "input.foreground": "#00796B",
        "input.border": "#00796B",
        "terminal.foreground": "#004D40",
        "scrollbarSlider.background": "#00ACC1",
        "scrollbarSlider.hoverBackground": "#4DD0E1",
        "scrollbarSlider.activeBackground": "#26C6DA",
        "badge.background": "#00ACC1",
        "badge.foreground": "#004D40",
        "peekView.border": "#00ACC1",
        "peekViewEditor.background": "#B2EBF2",
        "peekViewResult.background": "#E0F7FA",
        "panel.background": "#B3E5FC",
        "panel.border": "#004D40",
        "panelTitle.activeForeground": "#004D40",
        "panelTitle.inactiveForeground": "#80CBC4"
    },
    "tokenColors": [
        {
            "name": "Comentários",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#aaa", "fontStyle": "italic" }
        },
        {
            "name": "Strings",
            "scope": ["string"],
            "settings": { "foreground": "#f20", "fontStyle": "bold" }
        },
        {
            "name": "Funções",
            "scope": ["entity.name.function"],
            "settings": { "foreground": "#0000ff" }
        },
        {
            "name": "Variáveis",
            "scope": ["variable"],
            "settings": { "foreground": "#800080" }
        },
        {
            "name": "Palavras-chave",
            "scope": ["keyword"],
            "settings": { "foreground": "#ff1493" }
        },
        {
            "name": "Constantes",
            "scope": ["constant"],
            "settings": { "foreground": "#8b0000" }
        },
        {
            "name": "Números",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#483d8b", "fontStyle": "bold" }
        },
        {
            "name": "Nomes de Propriedades JSON",
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#09F" }
        },
        {
            "name": "Valores de Strings JSON",
            "scope": ["string.quoted.double"],
            "settings": { "foreground": "#ff1493", "fontStyle": "bold" }
        },
        {
            "name": "Nomes de Propriedades CSS",
            "scope": ["support.type.property-name.css"],
            "settings": { "foreground": "#09F" }
        },
        {
            "name": "Valores Numéricos CSS",
            "scope": ["constant.numeric.css"],
            "settings": { "foreground": "#09F", "fontStyle": "bold" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
