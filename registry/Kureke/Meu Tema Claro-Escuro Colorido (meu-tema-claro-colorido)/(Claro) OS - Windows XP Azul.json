{
    "name": "Windows XP Theme",
    "type": "light",
    "colors": {
        "editor.background": "#ffffff",
        "editor.foreground": "#073642",
        "editor.lineHighlightBackground": "#F0F0F0",
        "editorLineNumber.foreground": "#2B91AF",
        "activityBar.background": "#0054E3",
        "sideBar.background": "#80B4FF",
        "activityBar.foreground": "#ffffff",
        "activityBarBadge.background": "#99CFFF",
        "statusBar.background": "#0054E3",
        "statusBar.foreground": "#ffffff",
        "statusBarItem.hoverBackground": "#3783E6",
        "titleBar.activeBackground": "#0184D0",
        "titleBar.activeForeground": "#ffffff",
        "titleBar.inactiveBackground": "#99CFFF",
        "titleBar.inactiveForeground": "#ffffff",
        "button.background": "#3783E6",
        "dropdown.background": "#80B4FF",
        "dropdown.foreground": "#073642",
        "dropdown.border": "#0184D0",
        "input.background": "#ffffff",
        "input.foreground": "#073642",
        "input.border": "#99CFFF",
        "terminal.foreground": "#2B91AF",
        "scrollbarSlider.background": "#0184D0",
        "scrollbarSlider.hoverBackground": "#3783E6",
        "scrollbarSlider.activeBackground": "#0054E3",
        "badge.background": "#99CFFF",
        "badge.foreground": "#ffffff",
        "peekView.border": "#0184D0",
        "peekViewEditor.background": "#D6EFFF",
        "peekViewResult.background": "#E8F3FF",
        "panel.background": "#E8F3FF",
        "panel.border": "#99CFFF",
        "panelTitle.activeForeground": "#2B91AF",
        "panelTitle.inactiveForeground": "#7F7F7F"
    },
    "tokenColors": [
        {
            "name": "Comentários",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#008000", "fontStyle": "italic" }
        },
        {
            "name": "Strings",
            "scope": ["string"],
            "settings": { "foreground": "#f20", "fontStyle": "bold" }
        },
        {
            "name": "Funções",
            "scope": ["entity.name.function"],
            "settings": { "foreground": "#0000ff" }
        },
        {
            "name": "Variáveis",
            "scope": ["variable"],
            "settings": { "foreground": "#800080" }
        },
        {
            "name": "Palavras-chave",
            "scope": ["keyword"],
            "settings": { "foreground": "#ff1493" }
        },
        {
            "name": "Constantes",
            "scope": ["constant"],
            "settings": { "foreground": "#8b0000" }
        },
        {
            "name": "Números",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#483d8b", "fontStyle": "bold" }
        },
        {
            "name": "Nomes de Propriedades JSON",
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#09F" }
        },
        {
            "name": "Valores de Strings JSON",
            "scope": ["string.quoted.double"],
            "settings": { "foreground": "#ff1493", "fontStyle": "bold" }
        },
        {
            "name": "Nomes de Propriedades CSS",
            "scope": ["support.type.property-name.css"],
            "settings": { "foreground": "#09F" }
        },
        {
            "name": "Valores Numéricos CSS",
            "scope": ["constant.numeric.css"],
            "settings": { "foreground": "#09F", "fontStyle": "bold" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
