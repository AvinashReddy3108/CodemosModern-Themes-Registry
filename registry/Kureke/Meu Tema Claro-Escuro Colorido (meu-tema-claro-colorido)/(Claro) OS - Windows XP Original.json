{
    "name": "Windows XP Accurate",
    "type": "light",
    "colors": {
        "editor.background": "#ffffff",
        "editor.foreground": "#073642",
        "editor.lineHighlightBackground": "#F0F0F0",
        "editorLineNumber.foreground": "#235789",
        "activityBar.background": "#0054E3",
        "sideBar.background": "#80AAFF",
        "activityBar.foreground": "#ffffff",
        "activityBarBadge.background": "#BFDDFF",
        "statusBar.background": "#008000",
        "statusBar.foreground": "#ffffff",
        "statusBarItem.hoverBackground": "#265A88",
        "titleBar.activeBackground": "#0054E3",
        "titleBar.activeForeground": "#ffffff",
        "titleBar.inactiveBackground": "#BFDDFF",
        "titleBar.inactiveForeground": "#ffffff",
        "button.background": "#0054E3",
        "dropdown.background": "#80AAFF",
        "dropdown.foreground": "#073642",
        "dropdown.border": "#0054E3",
        "input.background": "#ffffff",
        "input.foreground": "#073642",
        "input.border": "#BFDDFF",
        "terminal.foreground": "#235789",
        "scrollbarSlider.background": "#0054E3",
        "scrollbarSlider.hoverBackground": "#265A88",
        "scrollbarSlider.activeBackground": "#004E98",
        "badge.background": "#BFDDFF",
        "badge.foreground": "#ffffff",
        "peekView.border": "#0054E3",
        "peekViewEditor.background": "#DAE3F3",
        "peekViewResult.background": "#E8F2FF",
        "panel.background": "#E8F2FF",
        "panel.border": "#BFDDFF",
        "panelTitle.activeForeground": "#235789",
        "panelTitle.inactiveForeground": "#7F7F7F"
    },
    "tokenColors": [
        {
            "name": "Comentários",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#008000", "fontStyle": "italic" }
        },
        {
            "name": "Strings",
            "scope": ["string"],
            "settings": { "foreground": "#f20", "fontStyle": "bold" }
        },
        {
            "name": "Funções",
            "scope": ["entity.name.function"],
            "settings": { "foreground": "#0000ff" }
        },
        {
            "name": "Variáveis",
            "scope": ["variable"],
            "settings": { "foreground": "#800080" }
        },
        {
            "name": "Palavras-chave",
            "scope": ["keyword"],
            "settings": { "foreground": "#ff1493" }
        },
        {
            "name": "Constantes",
            "scope": ["constant"],
            "settings": { "foreground": "#8b0000" }
        },
        {
            "name": "Números",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#483d8b", "fontStyle": "bold" }
        },
        {
            "name": "Nomes de Propriedades JSON",
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#09F" }
        },
        {
            "name": "Valores de Strings JSON",
            "scope": ["string.quoted.double"],
            "settings": { "foreground": "#ff1493", "fontStyle": "bold" }
        },
        {
            "name": "Nomes de Propriedades CSS",
            "scope": ["support.type.property-name.css"],
            "settings": { "foreground": "#09F" }
        },
        {
            "name": "Valores Numéricos CSS",
            "scope": ["constant.numeric.css"],
            "settings": { "foreground": "#09F", "fontStyle": "bold" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
