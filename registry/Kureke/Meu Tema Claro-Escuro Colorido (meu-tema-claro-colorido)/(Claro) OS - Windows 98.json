{
    "name": "Windows 98 Theme",
    "type": "light",
    "colors": {
        "editor.background": "#ffffff",
        "editor.foreground": "#073642",
        "editor.lineHighlightBackground": "#e0e0e0",
        "editorLineNumber.foreground": "#586e75",
        "activityBar.background": "#000080",
        "sideBar.background": "#c0c0c0",
        "activityBar.foreground": "#ffffff",
        "activityBarBadge.background": "#008080",
        "statusBar.background": "#008282",
        "statusBar.foreground": "#ffffff",
        "statusBarItem.hoverBackground": "#2f71ab",
        "titleBar.activeBackground": "#000080",
        "titleBar.activeForeground": "#ffffff",
        "titleBar.inactiveBackground": "#808080",
        "titleBar.inactiveForeground": "#d3d3d3",
        "button.background": "#000080",
        "dropdown.background": "#c0c0c0",
        "dropdown.foreground": "#000000",
        "dropdown.border": "#808080",
        "input.background": "#ffffff",
        "input.foreground": "#000000",
        "input.border": "#808080",
        "terminal.foreground": "#2f71ab",
        "scrollbarSlider.background": "#2f71ab",
        "scrollbarSlider.hoverBackground": "#2f71ab",
        "scrollbarSlider.activeBackground": "#0a246a",
        "badge.background": "#008282",
        "badge.foreground": "#ffffff",
        "peekView.border": "#808080",
        "peekViewEditor.background": "#d3d3d3",
        "peekViewResult.background": "#e0e0e0",
        "panel.background": "#e0e0e0",
        "panel.border": "#808080",
        "panelTitle.activeForeground": "#000000",
        "panelTitle.inactiveForeground": "#696969"
    },
    "tokenColors": [
        {
            "name": "Comentários",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#008000", "fontStyle": "italic" }
        },
        {
            "name": "Strings",
            "scope": ["string"],
            "settings": { "foreground": "#f20", "fontStyle": "bold" }
        },
        {
            "name": "Funções",
            "scope": ["entity.name.function"],
            "settings": { "foreground": "#0000ff" }
        },
        {
            "name": "Variáveis",
            "scope": ["variable"],
            "settings": { "foreground": "#800080" }
        },
        {
            "name": "Palavras-chave",
            "scope": ["keyword"],
            "settings": { "foreground": "#ff1493" }
        },
        {
            "name": "Constantes",
            "scope": ["constant"],
            "settings": { "foreground": "#8b0000" }
        },
        {
            "name": "Números",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#483d8b", "fontStyle": "bold" }
        },
        {
            "name": "Nomes de Propriedades JSON",
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#09F" }
        },
        {
            "name": "Valores de Strings JSON",
            "scope": ["string.quoted.double"],
            "settings": { "foreground": "#ff1493", "fontStyle": "bold" }
        },
        {
            "name": "Nomes de Propriedades CSS",
            "scope": ["support.type.property-name.css"],
            "settings": { "foreground": "#09F" }
        },
        {
            "name": "Valores Numéricos CSS",
            "scope": ["constant.numeric.css"],
            "settings": { "foreground": "#09F", "fontStyle": "bold" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
