{
    "name": "Meu Tema Claro Colorido - Cinza Elegante",
    "type": "light",
    "colors": {
        "editor.background": "#ffffff",
        "editor.foreground": "#000",
        "editor.lineHighlightBackground": "#e6e9ed",
        "editorLineNumber.foreground": "#2b2b3f",
        "activityBar.background": "#f0f3f6",
        "sideBar.background": "#edf0f4",
        "activityBar.foreground": "#111123",
        "activityBarBadge.background": "#333355",
        "statusBar.background": "#d9dce1",
        "statusBar.foreground": "#050517",
        "statusBarItem.hoverBackground": "#ccced2",
        "titleBar.activeBackground": "#bdbdc8",
        "titleBar.activeForeground": "#000010",
        "titleBar.inactiveBackground": "#d3d5da",
        "titleBar.inactiveForeground": "#0a0a1a",
        "button.background": "#b2b4c0",
        "dropdown.background": "#c7c9d3",
        "dropdown.foreground": "#050517",
        "dropdown.border": "#a6a6b8",
        "input.background": "#e0e2e7",
        "input.foreground": "#1c1c2c",
        "input.border": "#9999ab",
        "terminal.foreground": "#0d0d1f",
        "scrollbarSlider.background": "#c2c4cf",
        "scrollbarSlider.hoverBackground": "#a9aac5",
        "scrollbarSlider.activeBackground": "#8f90a5"
    },
    "tokenColors": [
        {
            "name": "Comentários",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#008000", "fontStyle": "italic" }
        },
        {
            "name": "Strings",
            "scope": ["string"],
            "settings": { "foreground": "#f20", "fontStyle": "bold" }
        },
        {
            "name": "Funções",
            "scope": ["entity.name.function"],
            "settings": { "foreground": "#0000ff" }
        },
        {
            "name": "Variáveis",
            "scope": ["variable"],
            "settings": { "foreground": "#800080" }
        },
        {
            "name": "Palavras-chave",
            "scope": ["keyword"],
            "settings": { "foreground": "#ff1493" }
        },
        {
            "name": "Constantes",
            "scope": ["constant"],
            "settings": { "foreground": "#8b0000" }
        },
        {
            "name": "Números",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#483d8b", "fontStyle": "bold" }
        },
        {
            "name": "Nomes de Propriedades JSON",
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#09F" }
        },
        {
            "name": "Valores de Strings JSON",
            "scope": ["string.quoted.double"],
            "settings": { "foreground": "#ff1493", "fontStyle": "bold" }
        },
        {
            "name": "Nomes de Propriedades CSS",
            "scope": ["support.type.property-name.css"],
            "settings": { "foreground": "#09F" }
        },
        {
            "name": "Valores Numéricos CSS",
            "scope": ["constant.numeric.css"],
            "settings": { "foreground": "#09F", "fontStyle": "bold" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
