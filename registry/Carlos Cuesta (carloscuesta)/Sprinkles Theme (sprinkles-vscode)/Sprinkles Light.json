{
    "$schema": "vscode://schemas/color-theme",
    "name": "Sprinkles Light",
    "type": "light",
    "colors": {
        "activityBar.activeBorder": "#42A5F5",
        "activityBar.activeFocusBorder": "#42A5F5",
        "activityBar.background": "#ffffff",
        "activityBar.foreground": "#24292f",
        "activityBar.inactiveForeground": "#9DA5AE",
        "activityBarBadge.background": "#FF5252",
        "activityBarBadge.foreground": "#FFFFFF",
        "badge.background": "#FF5252",
        "badge.foreground": "#FFFFFF",
        "button.background": "#FFFFFF",
        "button.border": "#e8eaec",
        "button.foreground": "#24292f",
        "button.hoverBackground": "#eaeef2",
        "button.secondaryBackground": "#FFFFFF",
        "button.secondaryForeground": "#24292f",
        "button.secondaryHoverBackground": "#eaeef2",
        "debugToolBar.background": "#ffffff",
        "editor.background": "#FFFFFF",
        "editor.findMatchHighlightBackground": "#9DA5AE46",
        "editor.foreground": "#1B1F23",
        "editor.lineHighlightBackground": "#f6f8fa",
        "editor.selectionBackground": "#9DA5AE46",
        "editor.selectionHighlightBackground": "#9DA5AE46",
        "editor.wordHighlightBackground": "#FFFFFF00",
        "editorBracketMatch.background": "#9DA5AE46",
        "editorBracketMatch.border": "#24292f",
        "editorCursor.foreground": "#24292f",
        "editorGroup.border": "#e8eaec",
        "editorGroup.emptyBackground": "#ffffff",
        "editorGroupHeader.tabsBackground": "#ffffff",
        "editorGroupHeader.tabsBorder": "#e8eaec",
        "editorGutter.addedBackground": "#4ac26b",
        "editorGutter.deletedBackground": "#ff8182",
        "editorGutter.foldingControlForeground": "#d4d4d4",
        "editorGutter.modifiedBackground": "#eac54f",
        "editorLineNumber.activeForeground": "#24292f",
        "editorLineNumber.foreground": "#d4d4d4",
        "editorRuler.foreground": "#e8eaec",
        "editorWhitespace.foreground": "#e5e5e5",
        "editorWidget.background": "#ffffff",
        "focusBorder": "#d1d5db",
        "input.background": "#FFFFFF",
        "input.border": "#e8eaec",
        "inputOption.activeBackground": "#42A5F5",
        "inputOption.activeBorder": "#42A5F5",
        "list.activeSelectionBackground": "#f3f4f6",
        "list.activeSelectionForeground": "#1B1F23",
        "list.focusBackground": "#f3f4f6",
        "list.highlightForeground": "#097ADA",
        "list.hoverBackground": "#f3f4f6",
        "list.inactiveSelectionBackground": "#f3f4f6",
        "notificationCenter.border": "#e8eaec",
        "notificationCenterHeader.background": "#ffffff",
        "notifications.background": "#ffffff",
        "notifications.border": "#e8eaec",
        "notificationsErrorIcon.foreground": "#FF443E",
        "notificationsInfoIcon.foreground": "#42A5F5",
        "notificationsWarningIcon.foreground": "#FFC135",
        "notificationToast.border": "#e8eaec",
        "panel.background": "#ffffff",
        "panel.border": "#e8eaec",
        "panelTitle.activeBorder": "#24292f",
        "panelTitle.activeForeground": "#1B1F23",
        "panelTitle.inactiveForeground": "#9DA5AE",
        "scrollbar.shadow": "#FFFFFF00",
        "sideBar.background": "#ffffff",
        "sideBar.border": "#e8eaec",
        "sideBar.foreground": "#24292f",
        "sideBarSectionHeader.background": "#ffffff",
        "statusBar.background": "#ffffff",
        "statusBar.border": "#e8eaec",
        "statusBar.debuggingBackground": "#ffffff",
        "statusBar.focusBorder": "#FFFFFF00",
        "statusBar.foreground": "#24292f",
        "statusBar.noFolderBackground": "#ffffff",
        "statusBarItem.remoteBackground": "#ffffff",
        "statusBarItem.remoteForeground": "#24292f",
        "tab.activeBackground": "#FFFFFF",
        "tab.activeBorder": "#e8eaec",
        "tab.border": "#e8eaec",
        "tab.inactiveBackground": "#ffffff",
        "tab.unfocusedActiveBorder": "#e8eaec",
        "tab.unfocusedActiveBorderTop": "#e8eaec",
        "terminal.ansiBlack": "#252525",
        "terminal.ansiBlue": "#42A5F5",
        "terminal.ansiBrightBlack": "#252525",
        "terminal.ansiBrightBlue": "#42A5F5",
        "terminal.ansiBrightCyan": "#00ACC1",
        "terminal.ansiBrightGreen": "#C3D82C",
        "terminal.ansiBrightMagenta": "#D81B60",
        "terminal.ansiBrightRed": "#FF443E",
        "terminal.ansiBrightWhite": "#F7F7F7",
        "terminal.ansiBrightYellow": "#FFC135",
        "terminal.ansiCyan": "#00ACC1",
        "terminal.ansiGreen": "#C3D82C",
        "terminal.ansiMagenta": "#D81B60",
        "terminal.ansiRed": "#FF443E",
        "terminal.ansiWhite": "#F7F7F7",
        "terminal.ansiYellow": "#FFC135",
        "terminal.background": "#ffffff",
        "terminal.foreground": "#B0BDC4",
        "titleBar.activeBackground": "#ffffff",
        "titleBar.activeForeground": "#24292f",
        "titleBar.border": "#e8eaec",
        "titleBar.inactiveBackground": "#ffffff",
        "titleBar.inactiveForeground": "#9DA5AE46",
        "widget.shadow": "#FFFFFF00"
    },
    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "fontStyle": "italic", "foreground": "#9ea8b4" }
        },
        {
            "name": "Variables",
            "scope": [
                "variable",
                "string constant.other.placeholder",
                "meta.jsx.children",
                "constant.other.color"
            ],
            "settings": { "foreground": "#24292f" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#DC3838" }
        },
        {
            "name": "Keyword, Storage",
            "scope": [
                "storage.type",
                "storage.modifier",
                "variable.other.object.tsx"
            ],
            "settings": { "foreground": "#107CC0" }
        },
        {
            "name": "Keyword, Storage, Type JS",
            "scope": ["storage.type.type.js"],
            "settings": { "foreground": "#DE2972" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation",
                "meta.type.annotation keyword.operator.type",
                "meta.block punctuation.definition.tag",
                "meta.tag punctuation.definition.tag"
            ],
            "settings": { "foreground": "#69788C" }
        },
        {
            "name": "Punctuation definition",
            "scope": [
                "punctuation.definition.tag",
                "punctuation.definition.tag.html",
                "punctuation.definition.tag.begin.html",
                "punctuation.definition.tag.end.html",
                "punctuation.definition.string",
                "punctuation.definition.typeparameters",
                "keyword.operator.optional.js",
                "keyword.operator.type.annotation.js",
                "keyword.operator.assignment.js",
                "keyword.operator.assignment.tsx",
                "keyword.operator.optional.tsx",
                "punctuation.definition.parameters",
                "meta.brace.round",
                "punctuation.accessor",
                "punctuation.section.embedded",
                "punctuation.separator",
                "punctuation.definition.template-expression",
                "meta.brace.square",
                "punctuation.definition.binding-pattern.array.js"
            ],
            "settings": { "foreground": "#009fb1" }
        },
        {
            "name": "Classes",
            "scope": [
                "entity.other.inherited-class",
                "entity.name.type.class",
                "entity.name.type.module",
                "entity.name.function",
                "meta.function-call entity.name.function"
            ],
            "settings": { "foreground": "#a66c00" }
        },
        {
            "name": "Operator, Misc",
            "scope": [
                "keyword.control",
                "constant.other.color",
                "meta.tag",
                "keyword.other.template",
                "keyword.other.substitution",
                "keyword.operator"
            ],
            "settings": { "foreground": "#DE2972" }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword.operator.expression.typeof",
                "keyword.operator.new"
            ],
            "settings": { "foreground": "#009fb1" }
        },
        {
            "name": "Tag",
            "scope": [
                "entity.name.tag",
                "meta.tag.sgml",
                "markup.deleted.git_gutter",
                "source.yaml constant.language"
            ],
            "settings": { "foreground": "#DC3838" }
        },
        {
            "name": "Function, Special Method",
            "scope": [
                "meta.class entity.name.function",
                "meta.type.declaration entity.name.function",
                "meta.function-call",
                "variable.function",
                "support.function",
                "keyword.other.special-method",
                "variable.other.object.js"
            ],
            "settings": { "foreground": "#107CC0" }
        },
        {
            "name": "Number, Constant, Function Argument, Tag Attribute, Embedded",
            "scope": [
                "constant.numeric",
                "constant.language",
                "support.constant",
                "constant.character",
                "constant.escape",
                "keyword.other.unit",
                "keyword.other"
            ],
            "settings": { "foreground": "#DE2972" }
        },
        {
            "name": "Function parameters",
            "scope": [
                "variable.parameter",
                "meta.parameters variable.object.property"
            ],
            "settings": { "foreground": "#DC3838", "fontStyle": "italic" }
        },
        {
            "name": "String, Symbols, Inherited Class, Markup Heading",
            "scope": [
                "string",
                "constant.other.symbol",
                "constant.other.key",
                "markup.heading",
                "markup.inserted.git_gutter",
                "meta.group.braces.curly constant.other.object.key.js string.unquoted.label.js",
                "meta.object-literal.key"
            ],
            "settings": { "foreground": "#8c9c00" }
        },
        {
            "name": "Class, Support",
            "scope": [
                "entity.name",
                "support.type",
                "support.class",
                "support.other.namespace.use.php",
                "meta.use.php",
                "support.other.namespace.php",
                "markup.changed.git_gutter",
                "support.type.sys-types",
                "storage.type.function.arrow"
            ],
            "settings": { "foreground": "#DC3838" }
        },
        {
            "name": "Sub-methods",
            "scope": [
                "entity.name.module.js",
                "variable.import.parameter.js",
                "variable.other.class.js"
            ],
            "settings": { "foreground": "#D73B5B" }
        },
        {
            "name": "Language methods",
            "scope": ["variable.language"],
            "settings": { "fontStyle": "italic", "foreground": "#D73B5B" }
        },
        {
            "name": "Attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#a66c00", "fontStyle": "italic" }
        },
        {
            "name": "HTML Attributes",
            "scope": [
                "text.html.basic entity.other.attribute-name.html",
                "text.html.basic entity.other.attribute-name"
            ],
            "settings": { "fontStyle": "italic", "foreground": "#a66c00" }
        },
        {
            "name": "CSS Class and Support",
            "scope": [
                "source.css support.type.property-name",
                "source.sass support.type.property-name",
                "source.scss support.type.property-name",
                "source.less support.type.property-name",
                "source.stylus support.type.property-name",
                "meta.property-name.css",
                "source.postcss support.type.property-name"
            ],
            "settings": { "foreground": "#a66c00" }
        },
        {
            "name": "CSS Media Punctuation",
            "scope": ["source.css punctuation.definition.keyword"],
            "settings": { "foreground": "#DE2972" }
        },
        {
            "name": "CSS Units",
            "scope": [
                "source.css keyword.other.unit",
                "support.constant.property-value",
                "support.constant.vendored",
                "source.css keyword.operator"
            ],
            "settings": { "foreground": "#009fb1" }
        },
        {
            "name": "CSS Classes",
            "scope": ["source.css entity.other.attribute-name.pseudo-class"],
            "settings": { "foreground": "#637C74", "fontStyle": "" }
        },
        {
            "name": "CSS Classes",
            "scope": ["source.css entity.other.attribute-name.class"],
            "settings": { "foreground": "#107CC0", "fontStyle": "" }
        },
        {
            "name": "CSS Variables",
            "scope": ["source.css variable"],
            "settings": { "foreground": "#107CC0" }
        },
        {
            "name": "CSS Constants",
            "scope": [
                "source.css constant.numeric",
                "source.css support.constant"
            ],
            "settings": { "foreground": "#DC3838" }
        },
        {
            "name": "Inserted",
            "scope": ["markup.inserted"],
            "settings": { "foreground": "#C3E88D" }
        },
        {
            "name": "Deleted",
            "scope": ["markup.deleted"],
            "settings": { "foreground": "#D73B5B" }
        },
        {
            "name": "Changed",
            "scope": ["markup.changed"],
            "settings": { "foreground": "#9B59C9" }
        },
        {
            "name": "Regular Expressions",
            "scope": ["string.regexp"],
            "settings": { "foreground": "#009fb1" }
        },
        {
            "name": "Escape Characters",
            "scope": ["constant.character.escape"],
            "settings": { "foreground": "#009fb1" }
        },
        {
            "name": "URL",
            "scope": ["*url*", "*link*", "*uri*"],
            "settings": { "fontStyle": "underline" }
        },
        {
            "name": "Decorators",
            "scope": [
                "tag.decorator.js entity.name.tag.js",
                "tag.decorator.js punctuation.definition.tag.js"
            ],
            "settings": { "fontStyle": "italic", "foreground": "#107CC0" }
        },
        {
            "name": "ES7 Bind Operator",
            "scope": [
                "source.js constant.other.object.key.js string.unquoted.label.js"
            ],
            "settings": { "fontStyle": "italic", "foreground": "#DC3838" }
        },
        {
            "name": "JSON Key",
            "scope": [
                "source.json meta.structure.dictionary.json support.type.property-name.json"
            ],
            "settings": { "foreground": "#DC3838" }
        },
        {
            "name": "JSON Punctuation",
            "scope": ["source.json punctuation.support.type.property-name"],
            "settings": { "foreground": "#009fb1" }
        },
        {
            "name": "JSON Punctuation",
            "scope": ["source.json punctuation.separator"],
            "settings": { "foreground": "#69788C" }
        },
        {
            "name": "JSON Constant",
            "scope": [
                "source.json constant.language",
                "source.json constant.numeric"
            ],
            "settings": { "foreground": "#a66c00" }
        },
        {
            "name": "Markdown - Plain",
            "scope": [
                "text.html.markdown",
                "punctuation.definition.list_item.markdown"
            ],
            "settings": { "foreground": "#24292f" }
        },
        {
            "name": "Markdown - Heading",
            "scope": [
                "entity.name.section.markdown",
                "markup.inline.raw.string.markdown"
            ],
            "settings": { "foreground": "#8c9c00" }
        },
        {
            "name": "Markdown - Heading Punctuation",
            "scope": ["punctuation.definition.heading.markdown"],
            "settings": { "foreground": "#DC3838" }
        },
        {
            "name": "Markdown - Modifiers Punctuation",
            "scope": [
                "punctuation.definition.italic.markdown",
                "punctuation.definition.bold.markdown",
                "punctuation.definition.raw.markdown",
                "punctuation.definition.metadata.markdown",
                "punctuation.definition.link.title.begin.markdown",
                "punctuation.definition.link.title.end.markdown"
            ],
            "settings": { "foreground": "#009fb1" }
        },
        {
            "name": "Markup - Italic",
            "scope": ["markup.italic"],
            "settings": { "fontStyle": "italic", "foreground": "#DE2972" }
        },
        {
            "name": "Markup - Bold",
            "scope": ["markup.bold", "markup.bold string"],
            "settings": { "fontStyle": "bold", "foreground": "#107CC0" }
        },
        {
            "name": "Markup - Underline",
            "scope": ["markup.underline"],
            "settings": { "fontStyle": "underline", "foreground": "#DC3838" }
        },
        {
            "name": "Markup - Quote",
            "scope": ["markup.quote"],
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "Markdown - Link",
            "scope": ["string.other.link.title.markdown"],
            "settings": { "foreground": "#a66c00" }
        },
        {
            "name": "Markdown - Link Anchor",
            "scope": ["constant.other.reference.link.markdown"],
            "settings": { "foreground": "#a66c00" }
        },
        {
            "name": "GraphQL - Type",
            "scope": ["keyword.type.graphql"],
            "settings": { "foreground": "#a66c00" }
        },
        {
            "name": "GraphQL - Variables",
            "scope": ["variable.graphql"],
            "settings": { "foreground": "#8c9c00" }
        },
        {
            "name": "GraphQL - Punctuation",
            "scope": ["keyword.operator.nulltype.graphql"],
            "settings": { "foreground": "#009fb1" }
        },
        {
            "name": "GraphQL - Keywords",
            "scope": [
                "keyword.enum.graphql",
                "keyword.operation.graphql",
                "keyword.fragment.graphql"
            ],
            "settings": { "foreground": "#DE2972" }
        },
        {
            "name": "GraphQL - Enum value",
            "scope": ["constant.character.enum.graphql"],
            "settings": { "foreground": "#24292f" }
        },
        {
            "name": "GraphQL - Query name",
            "scope": ["entity.name.function.graphql"],
            "settings": { "foreground": "#107CC0" }
        },
        {
            "name": "Shell - Punctuation",
            "scope": [
                "punctuation.definition.variable.shell",
                "punctuation.section.array.shell",
                "punctuation.definition.logical-expression.shell"
            ],
            "settings": { "foreground": "#009fb1" }
        },
        {
            "name": "Shell - Function",
            "scope": ["variable.other.special.shell"],
            "settings": { "foreground": "#DC3838" }
        },
        {
            "name": "Shell - Function",
            "scope": ["string.interpolated.dollar.shell"],
            "settings": { "foreground": "#24292f" }
        },
        {
            "name": "Shell - Loop ",
            "scope": ["meta.scope.for-in-loop.shell"],
            "settings": { "foreground": "#DC3838" }
        }
    ]
}
