    "tokenColors": [
        {
            "name": "Comment",
            "scope": [
                "comment",
                "comment storage.type",
                "comment variable",
                "comment support.variable",
                "comment support.class",
                "comment support.type",
                "comment entity.name.type",
                "comment entity.name.class",
                "comment keyword.operator",
                "comment: comment",
                "comment.line.double-slash",
                "comment entity.name.class",
                "comment entity.name.type",
                "comment keyword.operator",
                "comment support.class",
                "comment support.type",
                "comment support.variable",
                "comment variable",
                "Double-Slashed Comment"
            ],
            "settings": { "foreground": "#888888" }
        },
        {
            "name": "String",
            "scope": "string",
            "settings": { "foreground": "#32D698" }
        },
        {
            "name": "String Quoted",
            "scope": "string.quoted",
            "settings": { "foreground": "#32D698" }
        },
        {
            "name": "Support Constant Math",
            "scope": "support.constant.math",
            "settings": { "foreground": "#F3F359" }
        },
        {
            "name": "Number",
            "scope": ["constant.numeric", "constant.character.numeric"],
            "settings": { "foreground": "#F09030" }
        },
        {
            "name": "Built-in constant",
            "scope": [
                "constant.language",
                "punctuation.definition.constant",
                "variable.other.constant"
            ],
            "settings": { "foreground": "#F887FF" }
        },
        {
            "name": "User-defined constant",
            "scope": ["constant.character", "constant.other"],
            "settings": { "foreground": "#F887FF" }
        },
        {
            "name": "Constant Character Escape",
            "scope": "constant.character.escape",
            "settings": { "foreground": "#F09030" }
        },
        {
            "name": "RegExp String",
            "scope": ["string.regexp", "string.regexp keyword.other"],
            "settings": { "foreground": "#F887FF" }
        },
        {
            "name": "Comma in functions",
            "scope": "meta.function punctuation.separator.comma",
            "settings": { "foreground": "#EEEEEE" }
        },
        {
            "name": "Variable",
            "scope": "variable",
            "settings": { "foreground": "#F3F359" }
        },
        {
            "name": "Keyword",
            "scope": ["punctuation.accessor", "keyword"],
            "settings": { "foreground": "#EB0869" }
        },
        {
            "name": "Storage",
            "scope": "storage",
            "settings": { "foreground": "#EB0869" }
        },
        {
            "name": "Storage type",
            "scope": [
                "storage.type",
                "meta.var.expr storage.type",
                "meta.class meta.method.declaration meta.var.expr storage.type.js"
            ],
            "settings": { "foreground": "#EB0869" }
        },
        {
            "name": "Class name",
            "scope": ["entity.name.class", "meta.class entity.name.type.class"],
            "settings": { "foreground": "#F3F359" }
        },
        {
            "name": "Inherited class",
            "scope": "entity.other.inherited-class",
            "settings": { "fontStyle": "italic", "foreground": "#06FBCF" }
        },
        {
            "name": "Function name",
            "scope": "entity.name.function",
            "settings": { "foreground": "#F887FF" }
        },
        {
            "name": "Function Parameters",
            "scope": "variable.parameter",
            "settings": { "foreground": "#B60DFC" }
        },
        {
            "name": "Meta Tag",
            "scope": ["punctuation.definition.tag", "meta.tag"],
            "settings": { "foreground": "#F887FF" }
        },
        {
            "name": "HTML Tag names",
            "scope": [
                "entity.name.tag support.class.component",
                "meta.tag.other.html",
                "meta.tag.other.js",
                "meta.tag.other.tsx",
                "entity.name.tag.tsx",
                "entity.name.tag.js",
                "entity.name.tag",
                "meta.tag.js",
                "meta.tag.tsx",
                "meta.tag.html"
            ],
            "settings": { "foreground": "#EB0869" }
        },
        {
            "name": "Tag attribute",
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#F3F359" }
        },
        {
            "name": "Entity Name Tag Custom",
            "scope": "entity.name.tag.custom",
            "settings": { "foreground": "#F3F359" }
        },
        {
            "name": "Library (function & constant)",
            "scope": ["support.function", "support.constant"],
            "settings": { "foreground": "#F887FF" }
        },
        {
            "name": "Support Constant Property Value meta",
            "scope": "support.constant.meta.property-value",
            "settings": { "foreground": "#F887FF" }
        },
        {
            "name": "Library class/type",
            "scope": ["support.type", "support.class"],
            "settings": { "foreground": "#F3F359" }
        },
        {
            "name": "Support Variable DOM",
            "scope": "support.variable.dom",
            "settings": { "foreground": "#F3F359" }
        },
        {
            "name": "Invalid",
