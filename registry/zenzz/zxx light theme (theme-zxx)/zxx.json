{"name":"Zxx Light","author":"zenzz","maintainers":["zenzz<zenzzy@outlook.com>"],"semanticClass":"theme.zxx","colors":{"activityBar.background":"#FDF8EA66","activityBar.foreground":"#333333","activityBar.inactiveForeground":"#868585","activityBar.activeBackground":"#efebbd","activityBarBadge.background":"#488dbb","sideBar.background":"#FDF8EA66","statusBar.background":"#FDF8EA","statusBar.foreground":"#333333","statusBar.noFolderBackground":"#79379c","statusBar.noFolderForeground":"#ffffff","statusBar.debuggingBackground":"#f1c462","editor.background":"#FDFAED","editor.foreground":"#101010","editor.lineHighlightBackground":"#d9dbdc88","editor.selectionBackground":"#c4deff","editor.findMatchHighlightBackground":"#AED7FDD4","list.activeSelectionBackground":"#a1c4f088","list.activeSelectionForeground":"#121212","terminal.background":"#FDF8EA","terminal.foreground":"#121212"},"tokenColors":[{"name":"Comment","scope":"comment","settings":{"foreground":"#919191"}},{"name":"Keyword","scope":"keyword, storage","settings":{"foreground":"#C21F83"}},{"name":"Number & String","scope":"constant.numeric, string, string.regexp","settings":{"foreground":"#A60000"}},{"name":"User defined Type: struct/class/enum/interface","scope":"entity.name.class,entity.name.type, entity.name.type.class, entity.name.type.interface, entity.name.type.enum","settings":{"foreground":"#0947ab"}},{"name":"Inherited class","scope":"entity.other.inherited-class","settings":{"foreground":"#4287f7"}},{"name":"User defined constant","scope":"constant.character, constant.other","settings":{"foreground":"#26995c"}},{"name":"Function","scope":"meta.function-call","settings":{"foreground":"#5C2699"}},{"name":"Library class/type","scope":"support.type, support.class","settings":{"foreground":"#ce741b"}},{"name":"Library constant","scope":"constant.language, support.constant, variable.language","settings":{"foreground":"#E6105F","fontStyle":"bold"}},{"name":"Library variable","scope":"support.other","settings":{"foreground":"#ce741b"}},{"name":"Macro","scope":"entity.name.function.macro, meta.preprocessor, meta.section","settings":{"foreground":"#E6105F"}},{"name":"Invalid","scope":"invalid","settings":{"fontStyle":"strikethrough"}},{"name":"Invalid deprecated","scope":"invalid.deprecated","settings":{"fontStyle":"strikethrough"}},{"name":"Tag name","scope":"entity.name.tag","settings":{"foreground":"#0947ab"}},{"name":"Tag attribute","scope":"entity.other.attribute-name","settings":{"foreground":"#C21F83"}},{"name":"[Python] Function Parameter Special","scope":"variable.language.special.self.python","settings":{"foreground":"#C21F83"}},{"name":"[Python] variable","scope":"variable.language.python","settings":{"foreground":"#C21F83"}},{"name":"[Javascript] variable","scope":"source.javascript variable.language","settings":{"foreground":"#ce741b"}},{"name":"[C/CPP] pragma","scope":"source.c keyword.control.import.pragma","settings":{"foreground":"#E6105F"}},{"name":"[JSON] key","scope":"source.json support.other","settings":{"foreground":"#5C2699"}}],"$schema":"vscode://schemas/color-theme"}