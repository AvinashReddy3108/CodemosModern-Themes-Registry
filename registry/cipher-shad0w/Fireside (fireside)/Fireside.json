    "tokenColors": [
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#555c65", "fontStyle": "italic" }
        },
        {
            "scope": [
                "comment.block.documentation",
                "comment.line.documentation"
            ],
            "settings": { "foreground": "#c8c3b8", "fontStyle": "italic" }
        },
        {
            "scope": ["string", "string.quoted"],
            "settings": { "foreground": "#889889" }
        },
        { "scope": ["string.regexp"], "settings": { "foreground": "#9eaca1" } },
        {
            "scope": ["constant.numeric", "constant.character"],
            "settings": { "foreground": "#d0cac7" }
        },
        {
            "scope": ["constant.language"],
            "settings": { "foreground": "#e06b58" }
        },
        {
            "scope": ["constant.other", "variable.other.constant"],
            "settings": { "foreground": "#e48b7a" }
        },
        {
            "scope": ["keyword", "keyword.control", "storage"],
            "settings": { "foreground": "#b8b8b6" }
        },
        {
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#f0f2f5" }
        },
        {
            "scope": ["storage.type", "storage.modifier"],
            "settings": { "foreground": "#e48b7a" }
        },
        {
            "scope": [
                "entity.name.function",
                "meta.function-call",
                "support.function"
            ],
            "settings": { "foreground": "#e06b58" }
        },
        {
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.class",
                "support.type"
            ],
            "settings": { "foreground": "#b8b5a2" }
        },
        {
            "scope": ["variable", "variable.other"],
            "settings": { "foreground": "#f0f2f5" }
        },
        {
            "scope": ["variable.parameter", "meta.parameter"],
            "settings": { "foreground": "#d0cac7" }
        },
        {
            "scope": [
                "variable.other.property",
                "variable.other.object.property"
            ],
            "settings": { "foreground": "#d0cac7" }
        },
        {
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#b8b5a2" }
        },
        {
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#e06b58" }
        },
        {
            "scope": ["meta.tag", "punctuation.definition.tag"],
            "settings": { "foreground": "#f0f2f5" }
        },
        {
            "scope": ["meta.preprocessor", "keyword.other.preprocessor"],
            "settings": { "foreground": "#f0a19a" }
        },
        { "scope": ["punctuation"], "settings": { "foreground": "#d0cac7" } },
        {
            "scope": ["punctuation.separator", "punctuation.terminator"],
            "settings": { "foreground": "#f0f2f5" }
        },
        {
            "scope": ["string.escape", "constant.character.escape"],
            "settings": { "foreground": "#9eaca1" }
        },
        {
            "scope": ["markup.heading"],
            "settings": { "foreground": "#e06b58", "fontStyle": "bold" }
        },
        {
            "scope": ["markup.bold"],
            "settings": { "foreground": "#e48b7a", "fontStyle": "bold" }
        },
        {
            "scope": ["markup.italic"],
            "settings": { "foreground": "#f0a19a", "fontStyle": "italic" }
        },
        {
            "scope": ["markup.inline.raw", "markup.fenced_code"],
            "settings": { "foreground": "#889889" }
        },
        {
            "scope": ["markup.underline.link"],
            "settings": { "foreground": "#b8b8b6" }
        },
        { "scope": ["markup.list"], "settings": { "foreground": "#e06b58" } },
        {
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#e06b58", "fontStyle": "bold" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
