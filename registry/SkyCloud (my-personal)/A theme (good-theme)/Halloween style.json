{
    "name": "Halloween",
    "type": "dark",
    "colors": {
        "editor.background": "#4f0606",
        "editor.foreground": "#949494"
    },
    "tokenColors": [
        { "scope": "comment", "settings": { "foreground": "#d19b60" } },
        { "scope": "variable", "settings": { "foreground": "#deffb0" } },
        { "scope": "constant", "settings": { "foreground": "#471818" } },
        { "scope": "invalid", "settings": { "foreground": "#cb9c98" } },
        { "scope": "emphasis", "settings": { "fontStyle": "bold underline" } },
        {
            "scope": "entity.name.function",
            "settings": { "foreground": "#936a5b" }
        },
        { "scope": "keyword", "settings": { "foreground": "#6f6059" } },
        { "scope": "storage", "settings": { "foreground": "#3d1414" } },
        {
            "scope": "support.constant",
            "settings": { "foreground": "#e77646" }
        },
        {
            "scope": [
                "punctuation.definition.string.begin",
                "punctuation.definition.string.end",
                "punctuation.separator",
                "punctuation.separator.continuation",
                "punctuation.terminator"
            ],
            "settings": { "foreground": "#c74444" }
        },
        {
            "scope": "entity.other.inherited-class",
            "settings": { "foreground": "#ff5e2c" }
        },
        {
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#312020" }
        },
        { "scope": "meta.tag", "settings": { "foreground": "#b3a093" } },
        { "scope": "entity.name", "settings": { "foreground": "#b57e1f" } }
    ],
    "$schema": "vscode://schemas/color-theme"
}
