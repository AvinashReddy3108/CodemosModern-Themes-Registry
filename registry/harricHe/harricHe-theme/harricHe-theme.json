{
    "name": "harricHe-theme",
    "type": "light",
    "colors": {
        "activityBar.background": "#24292e",
        "activityBar.foreground": "#fafbfc",
        "activityBar.activeBorder": "#6d6d6d",
        "sideBar.foreground": "#586069",
        "sideBarTitle.foreground": "#24292e",
        "editor.background": "#CCE8CF",
        "editor.foreground": "#24292e",
        "editor.findMatchBackground": "#e2c750",
        "editor.findMatchHighlightBackground": "#ffe260",
        "editor.lineHighlightBackground": "#E8E8FF",
        "editor.selectionBackground": "#fafeff",
        "editor.selectionHighlightBackground": "#fffc60",
        "editorIndentGuide.background": "#eeeeee",
        "editorLineNumber.foreground": "#808080",
        "editorBracketMatch.background": "#f1f8ff",
        "editorBracketMatch.border": "#7a7a7a",
        "editorPane.background": "#5b5d5f",
        "editorGroup.border": "#cecece",
        "editorGroupHeader.tabsBackground": "#c3ddc5",
        "editorGroupHeader.tabsBorder": "#e1e4e8",
        "editorSuggestWidget.selectedBackground": "#c7c7c7",
        "editorSuggestWidget.background": "#d6d6d6",
        "editorSuggestWidget.border": "#f7f7f7",
        "editorHoverWidget.background": "#d9ecdb",
        "editorHoverWidget.border": "#f7f7f7",
        "tab.activeBackground": "#b4ccb6",
        "tab.activeBorder": "#e36209",
        "tab.inactiveBackground": "#c3ddc5",
        "tab.border": "#e1e4e8",
        "tab.inactiveForeground": "#586069",
        "peekView.border": "#000000",
        "peekViewEditor.background": "#CCE8CF",
        "peekViewEditorGutter.background": "#CCE8CF",
        "peekViewEditor.matchHighlightBackground": "#b4ccb6",
        "peekViewResult.background": "#c3ddc5",
        "peekViewResult.fileForeground": "#0f0f0f",
        "peekViewResult.lineForeground": "#0f0f0f",
        "peekViewResult.matchHighlightBackground": "#b4ccb6",
        "peekViewResult.selectionBackground": "#9aaf9c",
        "peekViewResult.selectionForeground": "#CCE8CF",
        "peekViewTitle.background": "#b4ccb6",
        "peekViewTitleDescription.foreground": "#000000",
        "peekViewTitleLabel.foreground": "#000000",
        "sideBar.background": "#c3ddc5",
        "sideBar.border": "#cecece",
        "sideBarSectionHeader.background": "#b4ccb6",
        "sideBarSectionHeader.foreground": "#616161",
        "list.activeSelectionBackground": "#7c8d7e",
        "list.activeSelectionForeground": "#0f0f0f",
        "list.inactiveSelectionBackground": "#b4ccb6",
        "list.inactiveSelectionForeground": "#313131",
        "list.focusBackground": "#c7c7c7",
        "list.highlightForeground": "#C5C5C5",
        "list.hoverBackground": "#9aaf9c",
        "input.background": "#CCE8CF",
        "dropdown.background": "#CCE8CF",
        "dropdown.listBackground": "#CCE8CF",
        "dropdown.border": "#000000",
        "dropdown.foreground": "#9aaf9c",
        "focusBorder": "#4b4b4b",
        "titleBar.activeBackground": "#24292e",
        "titleBar.activeForeground": "#cccccc",
        "titleBar.border": "#ff000000",
        "titleBar.inactiveBackground": "#24292e",
        "titleBar.inactiveForeground": "#1f1f1f",
        "statusBar.foreground": "#cccccc",
        "statusBar.background": "#24292e",
        "statusBar.border": "#ff000000",
        "statusBar.noFolderForeground": "#cccccc",
        "statusBar.noFolderBackground": "#24292e",
        "statusBar.noFolderBorder": "#ff000000",
        "statusBar.debuggingForeground": "#cccccc",
        "statusBar.debuggingBackground": "#d64926",
        "statusBar.debuggingBorder": "#ff000000",
        "statusBarItem.remoteForeground": "#ffffff",
        "statusBarItem.remoteBackground": "#d64926",
        "scrollbar.shadow": "#cccccc",
        "input.border": "#d1d1d1",
        "panel.background": "#c3ddc5",
        "terminal.background": "#c3ddc5",
        "activityBarBadge.background": "#d64926",
        "menu.background": "#24292e",
        "menu.foreground": "#cccccc",
        "menu.selectionBackground": "#9e9e9e",
        "menubar.selectionBackground": "#494949",
        "button.background": "#5790be"
    },
    "tokenColors": [
        {
            "name": "Types (void/enum/for/int)",
            "scope": "storage.type",
            "settings": { "fontStyle": "bold", "foreground": "#000080" }
        },
        {
            "name": "Enum variable(Enumerator)",
            "scope": ["variable.other.enummember"],
            "settings": { "fontStyle": "bold", "foreground": "#005959" }
        },
        {
            "name": "Keyword(while/if/else/return...)",
            "scope": [
                "keyword",
                "keyword.operator.logical",
                "keyword.operator.constructor"
            ],
            "settings": { "fontStyle": "bold", "foreground": "#000080" }
        },
        {
            "name": "Keyword Operator(</>/=/!)",
            "scope": "keyword.operator",
            "settings": { "foreground": "#000000" }
        },
        {
            "name": "Constant number",
            "scope": "constant.numeric",
            "settings": { "foreground": "#ff0000" }
        },
        {
            "name": "Variable(Global variable)",
            "scope": ["variable.other.global"],
            "settings": { "fontStyle": "bold", "foreground": "#CC6600" }
        },
        {
            "name": "Variable(Enum variable&function local variable)",
            "scope": ["variable.other.local"],
            "settings": { "fontStyle": "italic", "foreground": "#008080" }
        },
        {
            "name": "Variable(Function argument/no italic)",
            "scope": [
                "variable.parameter",
                "entity.name.variable.parameter",
                "parameter.variable"
            ],
            "settings": { "fontStyle": "", "foreground": "#008080" }
        },
        {
            "name": "Class (class name/reference class name)",
            "scope": ["entity.name.type"],
            "settings": { "fontStyle": "bold", "foreground": "#9d004f" }
        },
        {
            "name": "String (include file name/define&format string/json value)",
            "scope": ["string.quoted"],
            "settings": { "foreground": "#0000ff" }
        },
        {
            "name": "String (unknown string)",
            "scope": [
                "string",
                "string.regexp",
                "string.interpolated",
                "string.template",
                "string.detected-link",
                "string.template",
                "string.other"
            ],
            "settings": { "foreground": "#fcf838" }
        },
        {
            "name": "Print format(%d/\n)",
            "scope": ["constant.character", "constant.other"],
            "settings": { "fontStyle": "bold", "foreground": "#0000ff" }
        },
        {
            "name": "Comment",
            "scope": ["comment", "string.comment"],
            "settings": { "fontStyle": "italic", "foreground": "#808080" }
        },
        {
            "name": "Function name",
            "scope": [
                "entity.name.function",
                "entity.name.function.templated",
                "entity.name.function.member",
                "entity.name.function-call"
            ],
            "settings": { "fontStyle": "bold", "foreground": "#008040" }
        },
        {
            "name": "Function name(Static class methods)",
            "scope": ["entity.name.function.member.static"],
            "settings": { "fontStyle": "italic bold", "foreground": "#008040" }
        },
        {
            "name": "Macro define & use",
            "scope": "entity.name.function.preprocessor",
            "settings": { "foreground": "#ff0000" }
        },
        {
            "name": "Namespace name",
            "scope": ["entity.name.namespace"],
            "settings": { "foreground": "#18AADE" }
        },
        {
            "name": "Class static variable",
            "scope": ["variable.other.property.static"],
            "settings": { "fontStyle": "italic bold", "foreground": "#008080" }
        },
        {
            "name": "Class normal variable",
            "scope": ["variable.other.property"],
            "settings": { "fontStyle": "bold", "foreground": "#008080" }
        },
        {
            "name": "New & Delete",
            "scope": ["keyword.operator.new"],
            "settings": { "fontStyle": "italic bold", "foreground": "#000080" }
        },
        {
            "name": "JSON tag",
            "scope": ["support.type", "support.variable"],
            "settings": { "foreground": "#525252" }
        },
        {
            "name": "Punctuation(,/:/::)",
            "scope": ["punctuation.separator", "punctuation.accessor"],
            "settings": { "foreground": "#000000" }
        },
        {
            "name": "Test",
            "scope": [],
            "settings": { "foreground": "#e5ff00" }
        },
        {
            "name": "Tag Name",
            "scope": ["entity.name.tag", "entity.name.tag.class.js"],
            "settings": { "foreground": "#e06c75" }
        },
        {
            "name": "Tag Class and ID",
            "scope": ["entity.name.tag.class", "entity.name.tag.id"],
            "settings": { "foreground": "#56b6c2" }
        },
        {
            "name": "Embedded String Begin/End",
            "scope": [
                "string.embedded.begin",
                "string.embedded.end",
                "punctuation.definition.template-expression",
                "punctuation.section.embedded"
            ],
            "settings": { "foreground": "#c678dd" }
        },
        {
            "name": "Default Embedded Color",
            "scope": [
                "punctuation.section.embedded.begin.js",
                "punctuation.section.embedded.end.js",
                "punctuation.section.embedded.begin.erb",
                "punctuation.section.embedded.end.erb",
                "source.elixir.embedded",
                "meta.brace"
            ],
            "settings": { "foreground": "#abb2bf" }
        },
        {
            "name": "Built-in constant",
            "scope": "constant.language",
            "settings": { "foreground": "#56b6c2" }
        },
        {
            "name": "Package Import",
            "scope": ["storage.modifier.import", "storage.modifier.package"],
            "settings": { "foreground": "#61afef" }
        },
        {
            "name": "Builtin Functions",
            "scope": ["function.support.builtin", "function.support.core"],
            "settings": { "foreground": "#98c379" }
        },
        {
            "name": "Inherited Class",
            "scope": "entity.other.inherited-class",
            "settings": { "foreground": "#98c379" }
        },
        {
            "name": "CSS: Pseudo Attribute Names",
            "scope": [
                "entity.other.attribute-name.pseudo-class.css",
                "entity.other.attribute-name.pseudo-class.scss",
                "entity.other.attribute-name.pseudo-class.less",
                "entity.other.attribute-name.pseudo-class.sass",
                "entity.other.attribute-name.pseudo-element.css",
                "entity.other.attribute-name.pseudo-element.scss",
                "entity.other.attribute-name.pseudo-element.less",
                "entity.other.attribute-name.pseudo-element.sass"
            ],
            "settings": { "foreground": "#56b6c2" }
        },
        {
            "name": "StyleSheet Property value",
            "scope": [
                "support.constant.css",
                "support.constant.scss",
                "support.constant.less",
                "support.constant.sass"
            ],
            "settings": { "foreground": "#98c379" }
        },
        {
            "name": "StyleSheet Variable",
            "scope": [
                "variable.css",
                "variable.scss",
                "variable.less",
                "variable.sass"
            ],
            "settings": { "foreground": "#56b6c2" }
        },
        {
            "name": "StyleSheet Variable String",
            "scope": [
                "variable.css.string",
                "variable.scss.string",
                "variable.less.string",
                "variable.sass.string"
            ],
            "settings": { "foreground": "#e5c07b" }
        },
        {
            "name": "StyleSheet Unit",
            "scope": ["unit.css", "unit.scss", "unit.less", "unit.sass"],
            "settings": { "foreground": "#c678dd" }
        },
        {
            "name": "StyleSheet Function",
            "scope": [
                "function.css",
                "function.scss",
                "function.less",
                "function.sass"
            ],
            "settings": { "foreground": "#56b6c2" }
        },
        {
            "name": "Tag Attribute",
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#98c379" }
        },
        {
            "name": "Language Variable",
            "scope": "variable.language",
            "settings": { "foreground": "#e06c75" }
        },
        {
            "name": "================  Unknown",
            "scope": [
                "variable.other.property.cli",
                "variable.other.event",
                "entity.name.label",
                "entity.name.type.class.value",
                "entity.name.type.class.generic",
                "entity.name.operator.custom-literal",
                "entity.name.operator.custom-literal.number",
                "entity.name.operator.custom-literal.string",
                "entity.name.function.operator.member",
                "entity.name.function.operator"
            ],
            "settings": { "foreground": "#00ff00" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
