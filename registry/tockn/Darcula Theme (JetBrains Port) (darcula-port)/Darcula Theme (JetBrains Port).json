    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#808080", "fontStyle": "italic" }
        },
        {
            "name": "String",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#6A8759" }
        },
        {
            "name": "String Quotes",
            "scope": [
                "punctuation.definition.string",
                "punctuation.definition.string.begin",
                "punctuation.definition.string.end",
                "string punctuation.definition.string.begin.jsx",
                "string punctuation.definition.string.end.jsx",
                "string punctuation.definition.string.begin.tsx",
                "string punctuation.definition.string.end.tsx"
            ],
            "settings": { "foreground": "#6A8759" }
        },
        {
            "name": "String Interpolation",
            "scope": [
                "punctuation.definition.template-expression",
                "meta.template.expression"
            ],
            "settings": { "foreground": "#A9B7C6" }
        },
        {
            "name": "Number",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#6897BB" }
        },
        {
            "name": "Built-in constant (true/false)",
            "scope": [
                "constant.language.boolean",
                "constant.language.true",
                "constant.language.false"
            ],
            "settings": { "foreground": "#CC7832" }
        },
        {
            "name": "Undefined",
            "scope": ["constant.language.undefined"],
            "settings": { "foreground": "#CC7832" }
        },
        {
            "name": "Null",
            "scope": ["constant.language.null"],
            "settings": { "foreground": "#9876AA" }
        },
        {
            "name": "User-defined constant",
            "scope": [
                "constant.character",
                "constant.other",
                "variable.other.enummember"
            ],
            "settings": { "foreground": "#9876AA" }
        },
        {
            "name": "Const Variable",
            "scope": [
                "variable.other.constant",
                "variable.other.constant.js",
                "variable.other.constant.ts",
                "variable.other.constant.jsx",
                "variable.other.constant.tsx"
            ],
            "settings": { "foreground": "#A9B7C6" }
        },
        {
            "name": "Variable",
            "scope": [
                "variable",
                "variable.other.readwrite",
                "variable.other.object",
                "variable.other.property"
            ],
            "settings": { "foreground": "#A9B7C6" }
        },
        {
            "name": "This Keyword",
            "scope": [
                "variable.language.this",
                "variable.language.this.js",
                "variable.language.this.ts",
                "variable.language.this.jsx",
                "variable.language.this.tsx"
            ],
            "settings": { "foreground": "#CC7832" }
        },
        {
            "name": "Variable - Object Property",
            "scope": [
                "variable.other.object.property",
                "variable.other.property",
                "support.variable.property"
            ],
            "settings": { "foreground": "#9876AA" }
        },
        {
            "name": "Keyword",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.new",
                "keyword.operator.expression"
            ],
            "settings": { "foreground": "#CC7832" }
        },
        {
            "name": "Logical Operators",
            "scope": [
                "keyword.operator.logical",
                "keyword.operator.comparison",
                "keyword.operator.relational"
            ],
            "settings": { "foreground": "#A9B7C6" }
        },
        {
            "name": "Storage",
            "scope": ["storage", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#CC7832" }
        },
        {
            "name": "Storage type",
            "scope": ["storage.type.function.arrow", "storage.type.function"],
            "settings": { "foreground": "#CC7832" }
        },
        {
            "name": "Class name",
            "scope": [
                "entity.name.class",
                "entity.name.type.class",
                "support.class",
                "entity.other.inherited-class"
            ],
            "settings": { "foreground": "#A9B7C6" }
        },
        {
            "name": "Type/Interface",
            "scope": [
                "entity.name.type",
                "entity.name.type.interface",
                "support.type.primitive",
                "support.type",
                "entity.name.type.ts",
                "entity.name.type.tsx",
                "entity.name.type.class.ts",
                "entity.name.type.class.tsx",
                "entity.name.type.interface.ts",
                "entity.name.type.interface.tsx",
                "entity.name.type.alias",
                "entity.name.type.enum",
                "meta.type.annotation",
                "support.type.builtin"
            ],
            "settings": { "foreground": "#A9B7C6" }
        },
        {
            "name": "Type Annotations",
            "scope": [
                "meta.type.annotation entity.name.type",
                "meta.type.annotation support.type",
                "meta.return.type entity.name.type",
                "meta.return.type support.type"
            ],
            "settings": { "foreground": "#A9B7C6" }
        },
        {
            "name": "Function",
            "scope": [
                "entity.name.function",
                "support.function",
                "entity.name.method"
            ],
            "settings": { "foreground": "#FFC66D" }
        },
        {
            "name": "Function call",
            "scope": [
                "meta.function-call",
                "variable.function",
                "keyword.other.special-method"
            ],
            "settings": { "foreground": "#A9B7C6" }
        },
        {
            "name": "Function argument",
            "scope": ["variable.parameter", "meta.parameter"],
            "settings": { "foreground": "#A9B7C6" }
        },
        {
            "name": "Tag",
            "scope": ["entity.name.tag", "meta.tag.sgml"],
            "settings": { "foreground": "#CC7832" }
        },
        {
            "name": "Tag attribute",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#FFC66D" }
        },
        {
            "name": "Library function",
            "scope": ["support.function.any-method"],
            "settings": { "foreground": "#FFC66D" }
        },
        {
            "name": "Continuation",
            "scope": ["punctuation.separator.continuation"],
            "settings": { "foreground": "#A9B7C6" }
        },
        {
            "name": "Library constant",
            "scope": ["support.constant"],
            "settings": { "foreground": "#9876AA" }
        },
        {
            "name": "Library variable",
            "scope": ["support.variable"],
            "settings": { "foreground": "#9876AA" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#FF6B68" }
        },
        {
            "name": "Invalid deprecated",
            "scope": ["invalid.deprecated"],
            "settings": { "foreground": "#D7BA7D" }
        },
        {
            "name": "Operator",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#A9B7C6" }
        },
        {
            "name": "Punctuation",
            "scope": ["punctuation"],
            "settings": { "foreground": "#A9B7C6" }
        },
        {
            "name": "Separator",
            "scope": ["punctuation.terminator"],
            "settings": { "foreground": "#A9B7C6" }
        },
        {
            "name": "Comma",
            "scope": [
                "punctuation.separator.comma",
                "punctuation.separator.parameter",
                "punctuation.separator.arguments",
                "punctuation.separator.list",
                "punctuation.separator.delimiter"
            ],
            "settings": { "foreground": "#CC7832" }
        },
        {
            "name": "Accessor",
            "scope": ["punctuation.accessor"],
            "settings": { "foreground": "#A9B7C6" }
        },
        {
            "name": "JavaScript/TypeScript - Console",
            "scope": ["support.class.console", "support.type.object.console"],
            "settings": { "foreground": "#A9B7C6" }
        },
        {
            "name": "JavaScript/TypeScript - Object keys",
            "scope": [
                "meta.object-literal.key",
                "meta.object.member",
                "meta.object-literal.key.js",
                "meta.object-literal.key.ts",
