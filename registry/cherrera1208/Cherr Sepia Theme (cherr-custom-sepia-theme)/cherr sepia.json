        {
            "scope": "storage.type",
            "settings": { "foreground": "#859900", "fontStyle": "" }
        },
        {
            "scope": "keyword.control.import",
            "settings": { "foreground": "#D33682" }
        },
        {
            "scope": "storage.modifier.async",
            "settings": { "foreground": "#859900", "fontStyle": "" }
        },
        { "scope": "meta.import", "settings": { "foreground": "#657B83" } },
        { "scope": "source.ts", "settings": { "foreground": "#657B83" } },
        {
            "scope": "meta.function-call",
            "settings": { "foreground": "#657B83" }
        },
        {
            "scope": "entity.name.type",
            "settings": { "foreground": "#B58900" }
