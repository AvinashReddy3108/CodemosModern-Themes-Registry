{
    "$schema": "vscode://schemas/color-theme",
    "name": "Sakura Mochi",
    "type": "dark",
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "*.declaration": { "bold": true },
        "*.defaultLibrary": { "foreground": "#FF4AAD" },
        "*.deprecated": { "foreground": "#869873", "strikethrough": true },
        "*.readonly": { "foreground": "#C85A79" },
        "namespace": { "foreground": "#F0B7CA" },
        "class": { "foreground": "#E7E9BE" },
        "class:python": { "foreground": "#E7E9BE" },
        "class.builtin:python": { "foreground": "#FF4AAD" },
        "enum": { "foreground": "#E7E9BE" },
        "interface": { "foreground": "#F3F0C8" },
        "struct": { "foreground": "#E7E9BE" },
        "type": { "foreground": "#E7E9BE" },
        "type.defaultLibrary": { "foreground": "#FF4AAD" },
        "type.defaultLibrary:go": { "foreground": "#FF4AAD" },
        "typeParameter": { "foreground": "#F3F0C8" },
        "parameter": { "foreground": "#FCD7E2", "italic": true },
        "variable": { "foreground": "#F0B7CA" },
        "variable.defaultLibrary": { "foreground": "#FF4AAD" },
        "variable.readonly": { "foreground": "#C85A79" },
        "variable.readonly:javascript": { "foreground": "#F0B7CA" },
        "variable.readonly:javascriptreact": { "foreground": "#F0B7CA" },
        "variable.readonly:typescript": { "foreground": "#F0B7CA" },
        "variable.readonly:typescriptreact": { "foreground": "#F0B7CA" },
        "variable.readonly.defaultLibrary:go": { "foreground": "#FF4AAD" },
        "variable.typeHint:python": { "foreground": "#E7E9BE" },
        "property": { "foreground": "#00A896" },
        "property.readonly": { "foreground": "#00A896" },
        "property.readonly:javascript": { "foreground": "#00A896" },
        "property.readonly:javascriptreact": { "foreground": "#00A896" },
        "property.readonly:typescript": { "foreground": "#00A896" },
        "property.readonly:typescriptreact": { "foreground": "#00A896" },
        "enumMember": { "foreground": "#FF4AAD" },
        "decorator": { "foreground": "#FF4AAD" },
        "function": { "foreground": "#50DE89" },
        "function.defaultLibrary": { "foreground": "#7CF0A7" },
        "function.decorator:python": { "foreground": "#FF4AAD" },
        "method": { "foreground": "#50DE89" },
        "method.async": { "foreground": "#7CF0A7", "italic": true },
        "macro": { "foreground": "#FC0594" },
        "label": { "foreground": "#FC0594" },
        "comment": { "foreground": "#869873", "italic": true },
        "string": { "foreground": "#7CF0A7" },
        "keyword": { "foreground": "#FC0594" },
        "number": { "foreground": "#C85A79" },
        "regexp": { "foreground": "#39C7BC" },
        "operator": { "foreground": "#FF4AAD" },
        "builtinAttribute.attribute.library:rust": { "foreground": "#50DE89" },
        "generic.attribute:rust": { "foreground": "#F0B7CA" },
        "tomlArrayKey": { "foreground": "#FC0594" },
        "tomlTableKey": { "foreground": "#FC0594" },
        "heading": { "foreground": "#FC0594", "bold": true },
        "text.emph": { "foreground": "#FCD7E2", "italic": true },
