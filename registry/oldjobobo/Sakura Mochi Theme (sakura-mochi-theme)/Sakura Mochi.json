    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#869873", "fontStyle": "italic" }
        },
        {
            "name": "Documentation comments",
            "scope": [
                "comment.block.documentation",
                "comment.line.documentation"
            ],
            "settings": { "foreground": "#E7E9BE", "fontStyle": "italic" }
        },
        {
            "name": "Strings",
            "scope": [
                "string",
                "string.quoted",
                "string.unquoted",
                "string.interpolated"
            ],
            "settings": { "foreground": "#7CF0A7" }
        },
        {
            "name": "String punctuation",
            "scope": [
                "punctuation.definition.string.begin",
                "punctuation.definition.string.end"
            ],
            "settings": { "foreground": "#50DE89" }
        },
        {
            "name": "Regular expressions",
            "scope": ["string.regexp", "constant.regexp"],
            "settings": { "foreground": "#39C7BC" }
        },
        {
            "name": "Escapes",
            "scope": ["constant.character.escape", "constant.character.entity"],
            "settings": { "foreground": "#FC0594", "fontStyle": "bold" }
        },
        {
            "name": "Numbers and constants",
            "scope": [
                "constant.numeric",
                "constant.language",
                "constant.other",
                "variable.other.constant"
            ],
            "settings": { "foreground": "#C85A79" }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.other",
                "storage.modifier"
            ],
            "settings": { "foreground": "#FC0594" }
        },
        {
            "name": "Operators",
            "scope": [
                "keyword.operator",
                "keyword.operator.assignment",
                "keyword.operator.arithmetic",
                "keyword.operator.logical",
                "punctuation.accessor"
            ],
            "settings": { "foreground": "#FF4AAD" }
        },
        {
            "name": "Storage types",
            "scope": [
                "storage.type",
                "storage.type.function",
                "storage.type.class",
                "storage.type.struct",
                "storage.type.enum"
            ],
            "settings": { "foreground": "#E7E9BE" }
        },
        {
            "name": "Functions and methods",
            "scope": [
                "entity.name.function",
                "entity.name.method",
                "support.function",
                "support.function.builtin",
                "variable.function",
                "meta.function-call entity.name.function"
            ],
            "settings": { "foreground": "#50DE89" }
        },
        {
            "name": "Function definitions",
            "scope": [
                "meta.function entity.name.function",
                "meta.function.definition entity.name.function"
            ],
            "settings": { "foreground": "#7CF0A7" }
        },
        {
            "name": "Classes, types, interfaces",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "entity.name.struct",
                "entity.name.enum",
                "entity.name.interface",
                "support.class",
                "support.type",
                "support.type.builtin"
            ],
            "settings": { "foreground": "#E7E9BE" }
        },
        {
            "name": "Inherited classes and traits",
            "scope": [
                "entity.other.inherited-class",
                "entity.name.trait.rust",
                "entity.name.type.trait.rust"
            ],
            "settings": { "foreground": "#F3F0C8", "fontStyle": "italic" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "variable.other", "variable.other.readwrite"],
            "settings": { "foreground": "#F0B7CA" }
        },
        {
            "name": "Parameters",
            "scope": ["variable.parameter", "entity.name.variable.parameter"],
            "settings": { "foreground": "#FCD7E2", "fontStyle": "italic" }
        },
        {
            "name": "Language variables",
            "scope": [
                "variable.language",
                "variable.language.this",
                "variable.language.self.rust",
                "variable.language.special.self.python"
            ],
            "settings": { "foreground": "#FF4AAD" }
        },
        {
            "name": "Properties and fields",
            "scope": [
                "variable.other.property",
                "variable.other.object.property",
                "entity.name.variable.field",
                "support.type.property-name"
            ],
            "settings": { "foreground": "#00A896" }
        },
        {
            "name": "Object keys",
            "scope": [
                "support.type.property-name.json",
                "support.type.property-name.yaml",
                "support.type.property-name.toml",
                "punctuation.support.type.property-name.json",
                "meta.object-literal.key",
                "constant.other.object.key"
            ],
            "settings": { "foreground": "#FC0594" }
        },
        {
            "name": "Tags",
            "scope": ["entity.name.tag", "meta.tag entity.name.tag"],
            "settings": { "foreground": "#FC0594" }
        },
        {
            "name": "Attributes",
            "scope": [
                "entity.other.attribute-name",
                "entity.other.attribute-name.class",
                "entity.other.attribute-name.id"
            ],
            "settings": { "foreground": "#E7E9BE" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation",
                "punctuation.separator",
                "punctuation.terminator",
                "punctuation.section",
                "meta.brace"
            ],
            "settings": { "foreground": "#F0B7CAcc" }
        },
        {
            "name": "Decorators and annotations",
            "scope": [
                "meta.decorator",
                "entity.name.function.decorator",
                "support.token.decorator.python",
                "punctuation.definition.decorator.python"
            ],
            "settings": { "foreground": "#FF4AAD" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#FFF4F8", "background": "#FF4AAD66" }
        },
        {
            "name": "Deprecated",
            "scope": ["invalid.deprecated"],
            "settings": {
                "foreground": "#869873",
                "fontStyle": "strikethrough"
            }
        },
        {
            "name": "Markdown headings",
            "scope": [
                "markup.heading",
                "markup.heading entity.name",
                "heading.1.markdown",
                "heading.2.markdown",
                "heading.3.markdown"
            ],
            "settings": { "foreground": "#FC0594", "fontStyle": "bold" }
        },
        {
            "name": "Markdown emphasis",
            "scope": ["markup.italic", "emphasis"],
            "settings": { "foreground": "#FCD7E2", "fontStyle": "italic" }
        },
        {
            "name": "Markdown strong",
            "scope": ["markup.bold", "strong"],
            "settings": { "foreground": "#F3F0C8", "fontStyle": "bold" }
        },
        {
            "name": "Markdown links",
            "scope": [
                "markup.underline.link",
                "string.other.link",
                "constant.other.reference.link.markdown"
            ],
            "settings": { "foreground": "#7CF0A7", "fontStyle": "underline" }
        },
        {
            "name": "Markdown raw and code",
            "scope": [
                "markup.raw",
                "markup.inline.raw",
                "markup.raw.block",
                "fenced_code.block.language"
            ],
            "settings": { "foreground": "#E7E9BE" }
        },
        {
            "name": "Markdown quotes",
            "scope": [
                "markup.quote",
                "punctuation.definition.blockquote.markdown"
            ],
            "settings": { "foreground": "#E7E9BE", "fontStyle": "italic" }
        },
        {
            "name": "Diff inserted",
            "scope": [
                "markup.inserted",
                "markup.inserted.diff",
                "markup.inserted.git_gutter"
            ],
            "settings": { "foreground": "#7CF0A7" }
        },
        {
            "name": "Diff deleted",
            "scope": [
                "markup.deleted",
                "markup.deleted.diff",
                "markup.deleted.git_gutter"
            ],
            "settings": { "foreground": "#FF4AAD" }
        },
        {
            "name": "Diff changed",
            "scope": [
                "markup.changed",
                "markup.changed.diff",
                "markup.changed.git_gutter"
            ],
            "settings": { "foreground": "#F3F0C8" }
        }
    ]
}
