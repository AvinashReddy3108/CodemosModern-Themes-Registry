{
    "name": "Dracobit",
    "type": "dark",
    "colors": {
        "editor.background": "#1a1b1d",
        "editor.foreground": "#75C18D",
        "editorCursor.foreground": "#59AC72",
        "editor.lineHighlightBackground": "#5e6d6f63",
        "editor.selectionBackground": "#38df7263",
        "editor.selectionHighlightBackground": "#5e6d6f63",
        "editor.findMatchBackground": "#75C18D",
        "editor.findMatchHighlightBackground": "#a7afa960",
        "editor.hoverHighlightBackground": "#59ac721e",
        "editorGutter.addedBackground": "#081b0e",
        "editorGutter.modifiedBackground": "#75C18D",
        "editorGutter.deletedBackground": "#BB3E38",
        "activityBar.background": "#1B1D20",
        "activityBar.foreground": "#75C18D",
        "sideBar.background": "#1B1D20",
        "sideBar.foreground": "#75C18D",
        "statusBar.background": "#1B1D20",
        "statusBar.foreground": "#75C18D",
        "titleBar.activeBackground": "#1B1D20",
        "titleBar.activeForeground": "#75C18D",
        "titleBar.inactiveBackground": "#1B1D20",
        "titleBar.inactiveForeground": "#75C18D"
    },
    "tokenColors": [
        {
            "scope": "comment, comment.block, comment.line",
            "settings": { "foreground": "#9ea7a3" }
        },
        {
            "scope": "keyword, keyword.control, keyword.other",
            "settings": { "foreground": "#ffd900", "fontStyle": "bold" }
        },
        {
            "scope": "keyword.local.lua, storage.modifier, keyword.other.local",
            "settings": { "foreground": "#72ff47", "fontStyle": "italic bold" }
        },
        {
            "scope": "entity.name.function",
            "settings": {
                "foreground": "#67fc3a",
                "fontStyle": "bold italic underline"
            }
        },
        {
            "scope": "support.function, meta.function",
            "settings": { "foreground": "#f7f450", "fontStyle": "bold italic" }
        },
        {
            "scope": "keyword.operator.lua, keyword.operator, punctuation.operator",
            "settings": { "foreground": "#3fe2ff", "fontStyle": "italic" }
        },
        {
            "scope": "string.quoted.double.lua, string.quoted.single.lua, string.quoted.double, string.quoted.single, string.template",
            "settings": { "foreground": "#fa7c14", "fontStyle": "italic bold" }
        },
        {
            "scope": "constant.numeric, constant.numeric.integer, constant.numeric.float",
            "settings": { "foreground": "#3fe2ff", "fontStyle": "bold" }
        },
        {
            "scope": "keyword.control.lua, keyword.control.flow, keyword.control.conditional",
            "settings": { "foreground": "#BBC9CC", "fontStyle": "bold italic" }
        },
        {
            "scope": "string, string.unquoted, string.raw",
            "settings": { "foreground": "#0ff507" }
        },
        {
            "scope": "variable.parameter, parameter.function",
            "settings": { "foreground": "#ff9100", "fontStyle": "italic" }
        },
        {
            "scope": "storage.type.class, entity.name.type, entity.name.class, support.type",
            "settings": { "foreground": "#8dd85a", "fontStyle": "bold italic" }
        },
        {
            "scope": "variable, variable.other, variable.language",
            "settings": { "foreground": "#75C18D" }
        },
        {
            "scope": "constant.language, constant.other",
            "settings": { "foreground": "#3fe2ff", "fontStyle": "bold" }
        },
        {
            "scope": "meta.function-call, support.function.call",
            "settings": { "foreground": "#38d109", "fontStyle": "italic" }
        },
        {
            "scope": "punctuation.definition, punctuation.section, punctuation.terminator",
            "settings": { "foreground": "#d400ff" }
        },
        {
            "scope": "entity.name.tag, meta.tag",
            "settings": { "foreground": "#8dd85a", "fontStyle": "bold" }
        },
        {
            "scope": "entity.other.attribute-name, meta.property-name",
            "settings": { "foreground": "#ff9100", "fontStyle": "italic" }
        },
        {
            "scope": "entity.name.namespace, support.namespace",
            "settings": { "foreground": "#BBC9CC", "fontStyle": "italic" }
        },
        {
            "scope": "meta.preprocessor, keyword.control.import",
            "settings": { "foreground": "#ffd900", "fontStyle": "bold" }
        },
        {
            "scope": "meta.annotation, storage.type.annotation",
            "settings": { "foreground": "#72ff47", "fontStyle": "italic bold" }
        },
        {
            "scope": "string.regexp",
            "settings": { "foreground": "#fa7c14", "fontStyle": "bold" }
        },
        {
            "scope": "invalid, invalid.illegal",
            "settings": { "foreground": "#BB3E38", "fontStyle": "bold" }
        },
        {
            "scope": "keyword.other.sql",
            "settings": { "foreground": "#ffd900", "fontStyle": "bold" }
        },
        {
            "scope": "keyword.other.constraint.sql",
            "settings": { "foreground": "#BBC9CC", "fontStyle": "bold italic" }
        },
        {
            "scope": "storage.type.sql",
            "settings": { "foreground": "#8dd85a", "fontStyle": "bold italic" }
        },
        {
            "scope": "entity.name.table.sql",
            "settings": {
                "foreground": "#67fc3a",
                "fontStyle": "bold italic underline"
            }
        },
        {
            "scope": "entity.name.column.sql",
            "settings": { "foreground": "#75C18D", "fontStyle": "bold" }
        },
        {
            "scope": "string.quoted.sql",
            "settings": { "foreground": "#fa7c14", "fontStyle": "italic bold" }
        },
        {
            "scope": "constant.numeric.sql",
            "settings": { "foreground": "#3fe2ff", "fontStyle": "bold" }
        },
        {
            "scope": "string.json.sql",
            "settings": { "foreground": "#0ff507", "fontStyle": "italic" }
        },
        {
            "scope": "keyword.other.option.sql",
            "settings": { "foreground": "#ffd900", "fontStyle": "bold" }
        },
        {
            "scope": "constant.language.sql",
            "settings": { "foreground": "#3fe2ff", "fontStyle": "bold" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
