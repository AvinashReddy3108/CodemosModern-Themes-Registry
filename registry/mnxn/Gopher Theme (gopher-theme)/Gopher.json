    "tokenColors": [
        {
            "name": "Strong",
            "scope": "strong",
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Emphasis",
            "scope": "emphasis",
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "Embedded Source",
            "scope": "source.embedded",
            "settings": { "foreground": "#1B1A1A" }
        },
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#5555558A" }
        },
        {
            "name": "Comments: Preprocessor",
            "scope": "comment.block.preprocessor",
            "settings": { "fontStyle": "", "foreground": "#5555558A" }
        },
        {
            "name": "Comments: Documentation",
            "scope": ["comment.documentation", "comment.block.documentation"],
            "settings": { "foreground": "#5555558A" }
        },
        {
            "name": "Invalid - Illegal",
            "scope": "invalid.illegal",
            "settings": { "fontStyle": "underline", "foreground": "#FF0000" }
        },
        {
            "name": "Symbols",
            "scope": ["punctuation", "meta.bracket", "meta.parentheses"],
            "settings": { "foreground": "#8C8C8C" }
        },
        {
            "name": "Keywords",
            "scope": ["keyword.operator", "keyword", "storage"],
            "settings": { "foreground": "#3377EE" }
        },
        {
            "name": "Constants",
            "scope": [
                "constant.language",
                "support.constant",
                "variable.language",
                "constant.numeric",
                "constant.character",
                "constant"
            ],
            "settings": { "foreground": "#8811EE" }
        },
        {
            "name": "Variables",
            "scope": ["support.variable"],
            "settings": { "foreground": "#1B1A1A" }
        },
        {
            "name": "Binding",
            "scope": [
                "entity.name.function",
                "entity.name.variable.local",
                "variable.other.assignment",
                "variable.other.declaration",
                "variable.other.definition",
                "binding",
                "meta.definition.variable"
            ],
            "settings": { "foreground": "#009033" }
        },
        {
            "name": "Function call",
            "scope": "support.function",
            "settings": { "foreground": "#1B1A1A" }
        },
        {
            "name": "Builtin Function Call",
            "scope": "support.function.builtin",
            "settings": { "foreground": "#3377EE" }
        },
        {
            "name": "Types",
            "scope": [
                "support.type",
                "support.class",
                "entity.name.type",
                "entity.name.class",
                "entity.other.inherited-class",
                "entity.name.exception",
                "storage.type.boolean",
                "storage.type.numeric",
                "storage.type.uintptr",
                "storage.type.string",
                "storage.type.rune"
            ],
            "settings": { "foreground": "#CC2299" }
        },
        {
            "name": "Sections",
            "scope": "entity.name.section",
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Strings",
            "scope": ["string", "punctuation.definition.string"],
            "settings": { "foreground": "#CC7700" }
        },
        {
            "name": "Strings: Regular Expressions",
            "scope": "string.regexp",
            "settings": { "foreground": "#3377EE" }
        },
        {
            "name": "Strings: Symbols",
            "scope": "constant.other.symbol",
            "settings": { "foreground": "#8811EE" }
        },
        {
            "name": "HTML: Doctype Declaration",
            "scope": [
                "meta.tag.sgml.doctype",
                "meta.tag.sgml.doctype string",
                "meta.tag.sgml.doctype entity.name.tag",
                "meta.tag.sgml punctuation.definition.tag.html"
            ],
            "settings": { "foreground": "#555757" }
        },
        {
            "name": "HTML: Tags",
            "scope": [
                "punctuation.definition.tag.html",
                "punctuation.definition.tag.begin.html",
                "punctuation.definition.tag.end.html",
                "entity.name.tag"
            ],
            "settings": { "foreground": "#3377EE" }
        },
        {
            "name": "HTML: Entities",
            "scope": [
                "constant.character.entity",
                "punctuation.definition.entity"
            ],
            "settings": { "foreground": "#CC7700" }
        },
        {
            "name": "CSS: Selectors",
            "scope": [
                "meta.selector",
                "meta.selector entity",
                "meta.selector entity punctuation",
                "entity.name.tag.css"
            ],
            "settings": { "foreground": "#8811EE" }
        },
        {
            "name": "CSS: Property Names",
            "scope": ["meta.property-name", "support.type.property-name"],
            "settings": { "foreground": "#CC7700" }
        },
        {
            "name": "CSS: Property Values",
            "scope": [
                "meta.property-value",
                "meta.property-value constant.other",
                "support.constant.property-value"
            ],
            "settings": { "foreground": "#CC7700" }
        },
        {
            "name": "CSS: Important Keyword",
            "scope": "keyword.other.important",
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Markup: Changed",
            "scope": "markup.changed",
            "settings": { "foreground": "#1B1A1A" }
        },
        {
            "name": "Markup: Deletion",
            "scope": "markup.deleted",
            "settings": { "foreground": "#1B1A1A" }
        },
        {
            "name": "Markup: Emphasis",
            "scope": "markup.italic",
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "Markup: Error",
            "scope": "markup.error",
            "settings": { "foreground": "#FF0000" }
        },
        {
            "name": "Markup: Insertion",
            "scope": "markup.inserted",
            "settings": { "foreground": "#1B1A1A" }
        },
        {
            "name": "Markup: Link",
            "scope": "meta.link",
            "settings": { "foreground": "#3377EE" }
        },
        {
            "name": "Markup: Output",
            "scope": ["markup.output", "markup.raw"],
            "settings": { "foreground": "#555757" }
        },
        {
            "name": "Markup: Prompt",
            "scope": "markup.prompt",
            "settings": { "foreground": "#555757" }
        },
        {
            "name": "Markup: Heading",
            "scope": "markup.heading",
            "settings": { "foreground": "#1B1A1A" }
        },
        {
            "name": "Markup: Strong",
            "scope": "markup.bold",
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Markup: Traceback",
            "scope": "markup.traceback",
            "settings": { "foreground": "#FF0000" }
        },
        {
            "name": "Markup: Underline",
            "scope": "markup.underline",
            "settings": { "fontStyle": "underline" }
        },
        {
            "name": "Markup Quote",
            "scope": "markup.quote",
            "settings": { "foreground": "#8811EE" }
        },
        {
            "name": "Markup Lists",
            "scope": "markup.list",
            "settings": { "foreground": "#3377EE" }
        },
        {
            "name": "Markup Styling",
            "scope": ["markup.bold", "markup.italic"],
            "settings": { "foreground": "#8811EE" }
        },
        {
            "name": "Markup Inline",
            "scope": "markup.inline.raw",
            "settings": { "fontStyle": "", "foreground": "#CC7700" }
        },
        {
            "name": "Extra: Diff Range",
            "scope": ["meta.diff.range", "meta.diff.index", "meta.separator"],
            "settings": { "foreground": "#555757" }
        },
        {
            "name": "Extra: Diff From",
            "scope": "meta.diff.header.from-file",
            "settings": { "foreground": "#555757" }
        },
        {
            "name": "Extra: Diff To",
            "scope": "meta.diff.header.to-file",
            "settings": { "foreground": "#555757" }
        },
        {
            "name": "JSON Key",
            "scope": "support.type.property-name",
            "settings": { "foreground": "#3377EE" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
