{
    "name": "Modern Dark Flat",
    "$schema": "vscode://schemas/color-theme",
    "include": "./dark_plus.json",
    "colors": {
        "gitDecoration.modifiedResourceForeground": "#e5c081",
        "gitDecoration.stageModifiedResourceForeground": "#e5c081",
        "gitDecoration.addedResourceForeground": "#97c07d",
        "activityBar.activeBorder": "#0078D4",
        "activityBar.background": "#2B2B2B",
        "activityBar.border": "#2B2B2B",
        "activityBar.foreground": "#D7D7D7",
        "activityBar.inactiveForeground": "#868686",
        "activityBarBadge.background": "#0078D4",
        "activityBarBadge.foreground": "#FFFFFF",
        "badge.background": "#616161",
        "badge.foreground": "#F8F8F8",
        "banner.background": "#2b2b2b",
        "button.background": "#0078D4",
        "button.border": "#FFFFFF12",
        "button.foreground": "#FFFFFF",
        "button.hoverBackground": "#026EC1",
        "button.secondaryBackground": "#313131",
        "button.secondaryForeground": "#CCCCCC",
        "button.secondaryHoverBackground": "#3C3C3C",
        "chat.slashCommandBackground": "#34414B",
        "chat.slashCommandForeground": "#40A6FF",
        "checkbox.background": "#313131",
        "checkbox.border": "#3C3C3C",
        "debugToolBar.background": "#181818",
        "descriptionForeground": "#9D9D9D",
        "dropdown.background": "#313131",
        "dropdown.border": "#3C3C3C",
        "dropdown.foreground": "#CCCCCC",
        "dropdown.listBackground": "#1F1F1F",
        "editor.background": "#2B2B2B",
        "editor.findMatchBackground": "#9E6A03",
        "editor.foreground": "#CCCCCC",
        "editorGroup.border": "#2B2B2B",
        "editorGroupHeader.tabsBackground": "#2B2B2B",
        "editorGroupHeader.tabsBorder": "#2B2B2B",
        "editorGutter.addedBackground": "#2EA043",
        "editorGutter.deletedBackground": "#F85149",
        "editorGutter.modifiedBackground": "#0078D4",
        "editorLineNumber.activeForeground": "#CCCCCC",
        "editorLineNumber.foreground": "#6E7681",
        "editorOverviewRuler.border": "#2B2B2B",
        "editorWidget.background": "#202020",
        "errorForeground": "#F85149",
        "focusBorder": "#0078D4",
        "foreground": "#CCCCCC",
        "icon.foreground": "#CCCCCC",
        "input.background": "#313131",
        "input.border": "#3C3C3C",
        "input.foreground": "#CCCCCC",
        "input.placeholderForeground": "#989898",
        "inputOption.activeBackground": "#2489DB82",
        "inputOption.activeBorder": "#2488DB",
        "keybindingLabel.foreground": "#CCCCCC",
        "menu.background": "#1F1F1F",
        "menu.selectionBackground": "#0078d4",
        "notificationCenterHeader.background": "#1F1F1F",
        "notificationCenterHeader.foreground": "#CCCCCC",
        "notifications.background": "#1F1F1F",
        "notifications.border": "#2B2B2B",
        "notifications.foreground": "#CCCCCC",
        "panel.background": "#2B2B2B",
        "panel.border": "#2B2B2B",
        "panelInput.border": "#2B2B2B",
        "panelTitle.activeBorder": "#0078D4",
        "panelTitle.activeForeground": "#CCCCCC",
        "panelTitle.inactiveForeground": "#9D9D9D",
        "peekViewEditor.background": "#1F1F1F",
        "peekViewEditor.matchHighlightBackground": "#BB800966",
        "peekViewResult.background": "#1F1F1F",
        "peekViewResult.matchHighlightBackground": "#BB800966",
        "pickerGroup.border": "#3C3C3C",
        "progressBar.background": "#0078D4",
        "quickInput.background": "#222222",
        "quickInput.foreground": "#CCCCCC",
        "settings.dropdownBackground": "#313131",
        "settings.dropdownBorder": "#3C3C3C",
        "settings.headerForeground": "#FFFFFF",
        "settings.modifiedItemIndicator": "#BB800966",
        "sideBar.background": "#2B2B2B",
        "sideBar.border": "#2B2B2B",
        "sideBar.foreground": "#CCCCCC",
        "sideBarSectionHeader.background": "#2B2B2B",
        "sideBarSectionHeader.border": "#2B2B2B",
        "sideBarSectionHeader.foreground": "#CCCCCC",
        "sideBarTitle.foreground": "#CCCCCC",
        "statusBar.background": "#181818",
        "statusBar.border": "#181818",
        "statusBar.debuggingBackground": "#0078D4",
        "statusBar.debuggingForeground": "#FFFFFF",
        "statusBar.focusBorder": "#0078D4",
        "statusBar.foreground": "#CCCCCC",
        "statusBar.noFolderBackground": "#1F1F1F",
        "statusBarItem.focusBorder": "#0078D4",
        "statusBarItem.prominentBackground": "#6E768166",
        "statusBarItem.remoteBackground": "#0078D4",
        "statusBarItem.remoteForeground": "#FFFFFF",
        "tab.activeBackground": "#181818",
        "tab.activeBorder": "#1F1F1F",
        "tab.activeBorderTop": "#181818",
        "tab.activeForeground": "#cccccc",
        "tab.selectedBorderTop": "#6caddf",
        "tab.border": "#2B2B2B",
        "tab.hoverBackground": "#1F1F1F",
        "tab.inactiveBackground": "#2B2B2B",
        "tab.inactiveForeground": "#9D9D9D",
        "tab.unfocusedActiveBorder": "#1F1F1F",
        "tab.unfocusedActiveBorderTop": "#2B2B2B",
        "tab.unfocusedHoverBackground": "#1F1F1F",
        "tab.lastPinnedBorder": "#2B2B2B",
        "terminal.foreground": "#CCCCCC",
        "terminal.background": "#2b2b2b",
        "terminal.tab.activeBorder": "#0078D4",
        "textBlockQuote.background": "#2B2B2B",
        "textBlockQuote.border": "#616161",
        "textCodeBlock.background": "#2B2B2B",
        "textLink.activeForeground": "#4daafc",
        "textLink.foreground": "#4daafc",
        "textPreformat.foreground": "#D0D0D0",
        "textPreformat.background": "#3C3C3C",
        "textSeparator.foreground": "#21262D",
        "titleBar.activeBackground": "#181818",
        "titleBar.activeForeground": "#CCCCCC",
        "titleBar.border": "#181818",
        "titleBar.inactiveBackground": "#1F1F1F",
        "titleBar.inactiveForeground": "#9D9D9D",
        "widget.border": "#313131"
    },
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "tomlTableKey": "#87C1E1",
        "tomlArrayKey": "#87C1E1",
        "function.declaration": "#ffc66d",
        "method.declaration": "#ffc66d",
        "function.definition": "#ffc66d",
        "method.definition": "#ffc66d",
        "interface": "#1BBA92",
        "type": "#1BBA92",
        "class": "#1BBA92",
        "enum": "#1BBA92",
        "enumMember": "#9876aa",
        "parameter": "#a9b7c6",
        "variable": "#a9b7c6",
        "property": "#a9b7c6",
        "namespace": "#a9b7c6",
        "class.defaultLibrary": "#1BBA92",
        "typeParameter": "#20999d",
        "variable.defaultLibrary": {
            "foreground": "#20999d",
            "fontStyle": "italic bold"
        },
        "namespace:javascript": "#1BBA92",
        "namespace:typescript": "#1BBA92",
        "namespace:javascriptreact": "#1BBA92",
        "namespace:typescriptreact": "#1BBA92",
        "variable:javascript": "#1BBA92",
        "variable:typescript": "#1BBA92",
        "variable:javascriptreact": "#1BBA92",
        "variable:typescriptreact": "#1BBA92",
        "variable.local:javascript": "#87c1e1",
        "variable.local:typescript": "#87c1e1",
        "variable.local:javascriptreact": "#87c1e1",
        "variable.local:typescriptreact": "#87c1e1",
        "variable:vue": "#87c1e1",
        "property:javascript": "#87c1e1",
        "property:typescript": "#87c1e1",
        "property:javascriptreact": "#87c1e1",
        "property:typescriptreact": "#87c1e1",
        "parameter:javascript": "#87c1e1",
        "parameter:typescript": "#87c1e1",
        "parameter:javascriptreact": "#87c1e1",
        "parameter:typescriptreact": "#87c1e1",
        "keyword:go": "#2F9AE3",
        "operator:go": "#a9b7c6",
        "number:go": "#6897bb",
        "variable.readonly:go": "#9876aa",
        "type.defaultLibrary:go": "#D97496",
        "variable.defaultLibrary:go": {
            "foreground": "#D97496",
            "fontStyle": ""
        },
        "selfKeyword.mutable:rust": {
            "foreground": "#cc7832",
            "underline": false
        },
        "method.mutable.declaration:rust": "#ffc66d",
        "method.mutable:rust": { "foreground": "#DCDCAA", "underline": false },
        "lifetime:rust": { "foreground": "#20999d", "italic": true },
        "punctuation.injected:rust": "#a9b7c6",
        "decorator:rust": "#ffc66d",
        "builtinAttribute.attribute:rust": "#FFC66D",
        "macro.declaration:rust": "#FFC66D",
        "interface:rust": "#7288D7",
        "number:rust": "#6897bb",
        "struct:rust": "#1BBA92",
        "enum:rust": "#c48686",
        "const:rust": "#9876aa",
        "const.defaultLibrary:rust": "#9876aa",
        "static:rust": "#9876aa",
        "constParameter:rust": "#9876aa",
        "property:rust": "#9876aa",
        "escapeSequence:rust": "#cc7832",
        "builtinType:rust": "#cc7832",
        "keyword:rust": "#cc7832",
        "procMacro:rust": "#e85e87",
        "macro:rust": "#e85e87",
        "variable.defaultLibrary:rust": "#a9b7c6",
        "unresolvedReference:rust": "#a9b7c6",
        "operator.mutable:rust": {
            "foreground": "#a9b7c6",
            "underline": false
        },
        "parameter.mutable:rust": {
            "foreground": "#bca5c4",
            "italic": true,
            "underline": false
        },
        "variable.mutable:rust": {
            "foreground": "#bca5c4",
            "italic": true,
            "underline": false
        },
        "attributeBracket:rust": "#bbb529",
        "generic.attribute:rust": "#bbb529",
        "operator.attribute:rust": "#bbb529",
        "builtinAttribute:rust": "#bbb529",
        "class.decorator:python": "#bbb529",
        "module.decorator:python": "#bbb529",
        "function.decorator:python": "#bbb529",
        "method.decorator:python": "#BBB529",
        "variable.decorator:python": "#BBB529",
        "module:python": "#a9b7c6",
        "clsParameter:python": "#D36E8D",
        "selfParameter:python": "#D36E8D"
    },
    "tokenColors": [
        {
            "scope": [
                "variable.object.property.js",
                "variable.object.property.ts",
                "variable.object.property.jsx",
                "variable.object.property.tsx",
                "variable.other.property.js",
                "variable.other.property.ts",
                "variable.other.property.jsx",
                "variable.other.property.tsx",
                "variable.other.object.property.js",
                "variable.other.object.property.ts",
                "variable.other.object.property.jsx",
                "variable.other.object.property.tsx",
                "variable.other.readwrite.js",
                "variable.other.readwrite.ts",
                "variable.other.readwrite.jsx",
                "variable.other.readwrite.tsx",
                "variable.other.object.js",
                "variable.other.object.ts",
                "variable.other.object.jsx",
                "variable.other.object.tsx",
                "entity.other.attribute-name.js",
                "entity.other.attribute-name.ts",
                "entity.other.attribute-name.jsx",
                "entity.other.attribute-name.tsx",
                "support.type.property-name.js",
                "support.type.property-name.ts",
                "support.type.property-name.jsx",
                "support.type.property-name.tsx",
                "support.type.property-name.toml",
                "support.type.property-name.json",
                "support.type.property-name.jsonc",
                "support.variable.property.importmeta.js",
                "support.variable.property.importmeta.ts",
                "support.variable.property.importmeta.jsx",
                "support.variable.property.importmeta.tsx",
                "support.variable.property.js",
                "support.variable.property.ts",
                "support.variable.property.jsx",
                "support.variable.property.tsx",
                "variable.other.link.underline.jsdoc",
                "variable.other.description.jsdoc"
            ],
            "settings": { "foreground": "#87c1e1" }
        },
        {
            "scope": ["entity.name.tag", "storage.type.sql"],
            "settings": { "foreground": "#20999d" }
        },
        {
            "scope": ["meta.tag.block.any.html"],
            "settings": { "foreground": "#808080" }
        },
        {
            "scope": [
                "entity.other.attribute-name.id.css",
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.pseudo-class.css",
                "entity.name.tag.css"
            ],
            "settings": { "foreground": "#e8bf6a" }
        },
        {
            "scope": ["meta.function-call.generic.python"],
            "settings": { "foreground": "#DCDCAA" }
        },
        {
            "scope": [
                "punctuation.definition.decorator.python",
                "entity.name.function.decorator.python",
                "support.type.python",
                "meta.attribute.rust",
                "keyword.operator.macro.dollar.rust",
                "variable.other.metavariable.name.rust",
                "variable.other.metavariable.specifier.rust"
            ],
            "settings": { "foreground": "#bbb529" }
        },
        {
            "scope": "string.quoted.docstring.multi.python",
            "settings": { "foreground": "#6A9955" }
        },
        {
            "scope": [
                "constant.numeric.dec.python",
                "constant.other.database-name.sql",
                "constant.other.table-name.sql",
                "storage.modifier.sql"
            ],
            "settings": { "foreground": "#6897BB" }
        },
        {
            "scope": [
                "constant.other.placeholder",
                "punctuation.section.embedded",
                "punctuation.definition.binding-pattern",
                "punctuation.definition.template-expression",
                "punctuation.separator.comma",
                "punctuation.other.comma.go",
                "punctuation.separator.arguments.python",
                "punctuation.separator.parameters.python",
                "constant.character.format.placeholder.other.python",
                "punctuation.comma.rust",
                "keyword.other.fn.rust"
            ],
            "settings": { "foreground": "#cc7832" }
        },
        {
            "scope": [
                "support.type.builtin",
                "support.type.primitive",
                "support.type.object.module",
                "support.class.component",
                "entity.name.type",
                "entity.name.type.module",
                "entity.name.class.proto",
                "entity.name.class.message.proto",
                "entity.name.type.instance",
                "variable.other.readwrite.alias",
                "storage.type.proto"
            ],
            "settings": { "foreground": "#1BBA92" }
        },
        {
            "scope": [
                "storage.type",
                "storage.modifier",
                "keyword.control.go",
                "storage.type.proto",
                "keyword.other.proto",
                "keyword.control.flow.python",
                "keyword.operator.type.asserts",
                "keyword.operator.expression.is",
                "keyword.operator.logical.python",
                "keyword.operator.expression.keyof",
                "keyword.operator.expression.typeof"
            ],
            "settings": { "foreground": "#2F9AE3" }
        },
        {
            "scope": "variable.parameter.function-call.python",
            "settings": { "foreground": "#aa4926" }
        },
        {
            "scope": [
                "keyword.control",
                "constant.language",
                "keyword.control.flow",
                "storage.type.string.go",
                "storage.type.numeric.go",
                "keyword.control.trycatch"
            ],
            "settings": { "foreground": "#d36e8d" }
        },
        {
            "scope": [
                "source",
                "variable.other",
                "variable.parameter.go",
                "variable.other.proto",
                "variable.other.property",
                "variable.other.assignment.go",
                "keyword.operator",
                "meta.embedded",
                "meta.brace.square",
                "storage.type.function.arrow",
                "punctuation.separator.key-value",
                "variable.parameter.function-call.python",
                "entity.name.namespace.rust"
            ],
            "settings": { "foreground": "#a9b7c6" }
        }
    ]
}
