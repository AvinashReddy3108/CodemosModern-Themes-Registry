{
    "$schema": "vscode://schemas/color-theme",
    "type": "dark",
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "variable.defaultLibrary": {
            "foreground": "#5BFD4C",
            "fontStyle": "italic"
        },
        "variable": { "foreground": "#FF9100" }
    },
    "colors": {
        "editor.background": "#252525",
        "editor.foreground": "#EFEFFF"
    },
    "tokenColors": [
        {
            "scope": ["string", "punctuation.definition.string"],
            "settings": { "foreground": "#00ffcc", "fontStyle": "" }
        },
        {
            "scope": ["constant.numeric.decimal"],
            "settings": { "foreground": "#20B6FF", "fontStyle": "" }
        },
        {
            "scope": ["keyword.other.documentation"],
            "settings": { "foreground": "#909090", "fontStyle": "" }
        },
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#909090", "fontStyle": "" }
        },
        {
            "scope": [
                "punctuation.section.enum.begin.bracket",
                "punctuation.section.enum.end.bracket",
                "punctuation.section.class.begin.bracket",
                "punctuation.section.class.end.bracket",
                "punctuation.section.method.begin.bracket",
                "punctuation.section.method.end.bracket",
                "punctuation.definition.parameters.begin.bracket",
                "punctuation.definition.parameters.end.bracket",
                "punctuation.definition.annotation-arguments.begin.bracket",
                "punctuation.definition.annotation-arguments.end.bracket"
            ],
            "settings": { "foreground": "#EFEFFF", "fontStyle": "" }
        },
        {
            "scope": ["constant.other.enum", "variable.other.enummember"],
            "settings": { "foreground": "#6AD5FF", "fontStyle": "bold italic" }
        },
        {
            "scope": ["variable.other"],
            "settings": { "foreground": "#63d3ff", "fontStyle": "" }
        },
        {
            "scope": ["constant.other.key"],
            "settings": { "foreground": "#FF3131", "fontStyle": "bold" }
        },
        {
            "scope": ["storage.type.generic"],
            "settings": { "foreground": "#D7837F", "fontStyle": "" }
        },
        {
            "scope": [
                "keyword",
                "keyword.other.typedef.cpp",
                "keyword.other.using",
                "keyword.other.namespace",
                "keyword.operator.expression",
                "punctuation.definition.directive",
                "storage.type",
                "storage.modifier",
                "variable.language",
                "constant.language"
            ],
            "settings": { "foreground": "#EE0F5D", "fontStyle": "bold" }
        },
        {
            "scope": [
                "keyword.operator",
                "punctuation.bracket.angle",
                "entity.name.function.operator",
                "punctuation.terminator",
                "punctuation.separator"
            ],
            "settings": { "foreground": "#EFEFFF", "fontStyle": "" }
        },
        {
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#20B6FF", "fontStyle": "" }
        },
        {
            "scope": ["variable.declaration", "variable"],
            "settings": { "foreground": "#FF9100", "fontStyle": "" }
        },
        {
            "scope": ["entity.name.function"],
            "settings": { "foreground": "#5BFD4C", "fontStyle": "" }
        },
        {
            "scope": ["entity.name.type.enum", "enum"],
            "settings": { "foreground": "#CC81BA", "fontStyle": "italic" }
        },
        {
            "scope": [
                "entity.other.inherited-class",
                "entity.name.type.class",
                "entity.name.type",
                "entity.name.class",
                "storage.type.java"
            ],
            "settings": { "foreground": "#20B6FF", "fontStyle": "bold" }
        },
        {
            "scope": ["invalid"],
            "settings": { "foreground": "#FF3131", "fontStyle": "underline" }
        },
        {
            "scope": ["entity.name.tag.html"],
            "settings": { "foreground": "#03A8D8", "fontStyle": "bold" }
        },
        {
            "scope": ["entity.other.attribute-name.html"],
            "settings": { "foreground": "#A7EC21", "fontStyle": "" }
        },
        {
            "scope": ["punctuation.separator.key-value.html"],
            "settings": { "foreground": "#52CA11", "fontStyle": "" }
        },
        {
            "scope": [
                "punctuation.definition.tag.begin.html",
                "punctuation.definition.tag.end.html"
            ],
            "settings": { "foreground": "#0080FF", "fontStyle": "" }
        },
        {
            "scope": [
                "punctuation.definition.entity.html",
                "constant.character.entity.numeric.decimal.html"
            ],
            "settings": { "foreground": "#DD2867", "fontStyle": "" }
        },
        {
            "scope": ["string.quoted.single.html", "string.quoted.double.html"],
            "settings": { "foreground": "#17C6A3", "fontStyle": "italic" }
        },
        {
            "scope": [
                "meta.tag.metadata.doctype.html entity.other.attribute-name.html"
            ],
            "settings": { "foreground": "#FEA88F", "fontStyle": "" }
        },
        {
            "scope": [
                "meta.tag.metadata.doctype.html punctuation.definition.tag.begin.html",
                "meta.tag.metadata.doctype.html punctuation.definition.tag.end.html"
            ],
            "settings": { "foreground": "#A7EC21", "fontStyle": "" }
        },
        {
            "scope": ["entity.name.tag.css"],
            "settings": { "foreground": "#65F228", "fontStyle": "" }
        },
        {
            "scope": ["meta.property-name.css"],
            "settings": { "foreground": "#0699F0", "fontStyle": "" }
        },
        {
            "scope": [
                "support.constant.property-value.css",
                "meta.property-value.css",
                "meta.property-value.css punctuation.definition.constant.css",
                "constant.numeric.css",
                "source.css keyword"
            ],
            "settings": { "foreground": "#00ffcc", "fontStyle": "italic" }
        },
        {
            "scope": [
                "entity.other.attribute-name.pseudo-class.css",
                "entity.other.attribute-name.pseudo-class.css punctuation.definition.entity.css",
                "entity.other.attribute-name.pseudo-element.css",
                "entity.other.attribute-name.pseudo-element.css punctuation.definition.entity.css"
            ],
            "settings": { "foreground": "#FB518C", "fontStyle": "" }
        },
        {
            "scope": [
                "entity.other.attribute-name.id.css",
                "entity.other.attribute-name.id.css punctuation.definition.entity.css"
            ],
            "settings": { "foreground": "#A7EC21", "fontStyle": "" }
        },
        {
            "scope": [
                "source.css keyword.control.at-rule",
                "source.css keyword.control.at-rule punctuation.definition.keyword.css"
            ],
            "settings": { "foreground": "#A7EC21", "fontStyle": "" }
        },
        {
            "scope": ["support.constant.media.css"],
            "settings": { "foreground": "#DD2867", "fontStyle": "" }
        },
        {
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.class.css punctuation.definition.entity.css"
            ],
            "settings": { "foreground": "#12E046", "fontStyle": "" }
        },
        {
            "scope": ["keyword.operator.combinator.css"],
            "settings": { "foreground": "#A7EC21", "fontStyle": "" }
        },
        {
            "scope": [
                "meta.attribute-selector.css",
                "meta.attribute-selector.css keyword.operator"
            ],
            "settings": { "foreground": "#F7C517", "fontStyle": "" }
        },
        {
            "scope": [
                "meta.attribute-selector.css string.quoted",
                "meta.attribute-selector.css punctuation.definition.string"
            ],
            "settings": { "foreground": "#FF8080", "fontStyle": "" }
        },
        {
            "scope": [
                "meta.function.url.css",
                "meta.function.url.css string.quoted",
                "meta.function.url.css punctuation.definition.string"
            ],
            "settings": { "foreground": "#00ffcc", "fontStyle": "italic" }
        },
        {
            "scope": ["entity.name.tag.wildcard.css"],
            "settings": { "foreground": "#A7EC21", "fontStyle": "" }
        },
        { "scope": "ref.matchtext", "settings": { "foreground": "#FFFFFF" } },
        {
            "scope": "token.info-token",
            "settings": { "foreground": "#6796E6" }
        },
        {
            "scope": "token.warn-token",
            "settings": { "foreground": "#CD9731" }
        },
        {
            "scope": "token.error-token",
            "settings": { "foreground": "#FF3131" }
        },
        {
            "scope": "token.debug-token",
            "settings": { "foreground": "#B267E6" }
        }
    ]
}
