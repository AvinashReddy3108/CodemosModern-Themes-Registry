{
    "name": "Sea Cliff Soft",
    "colors": {
        "activityBar.background": "#0f1318",
        "activityBar.border": "#2c3440",
        "activityBar.foreground": "#d9e1ea",
        "activityBar.inactiveForeground": "#98a5b3",
        "badge.background": "#d7b4ff",
        "badge.foreground": "#0d1116",
        "breadcrumb.activeSelectionForeground": "#ffcf99",
        "breadcrumb.background": "#1b2129",
        "breadcrumb.foreground": "#b6c2cf",
        "commandCenter.background": "#11161d",
        "commandCenter.foreground": "#d9e1ea",
        "dropdown.background": "#121720",
        "dropdown.border": "#2c3440",
        "dropdown.foreground": "#d9e1ea",
        "editor.background": "#161a20",
        "editorPane.background": "#161a20",
        "editor.foreground": "#d9e1ea",
        "editor.lineHighlightBackground": "#20262e",
        "editor.selectionBackground": "#2e394680",
        "editor.selectionHighlightBackground": "#27303b80",
        "editorCursor.foreground": "#ffcf99",
        "editorCursor.background": "#161a20",
        "editorGroup.border": "#2c3440",
        "editorGroupHeader.tabsBackground": "#0f1318",
        "editorIndentGuide.background1": "#29313b",
        "editorIndentGuide.activeBackground1": "#66758a",
        "editorLineNumber.foreground": "#657487",
        "editorLineNumber.activeForeground": "#ffcf99",
        "editorWhitespace.foreground": "#313844",
        "editorWidget.background": "#11161d",
        "editorWidget.border": "#2c3440",
        "input.background": "#121720",
        "input.border": "#2c3440",
        "input.foreground": "#d9e1ea",
        "input.placeholderForeground": "#8b98a8",
        "list.activeSelectionBackground": "#27303b",
        "list.activeSelectionForeground": "#e6edf3",
        "list.hoverBackground": "#1e252e",
        "list.inactiveSelectionBackground": "#222933",
        "menu.background": "#0f141b",
        "menu.border": "#2c3440",
        "menu.foreground": "#d9e1ea",
        "menu.selectionBackground": "#27303b",
        "menu.selectionForeground": "#e6edf3",
        "notificationCenterHeader.background": "#11161d",
        "notificationToast.border": "#2c3440",
        "notifications.background": "#11161d",
        "notifications.border": "#2c3440",
        "panel.background": "#11161d",
        "panel.border": "#2c3440",
        "panelTitle.activeBorder": "#d7b4ff",
        "panelTitle.activeForeground": "#e6edf3",
        "peekView.border": "#2c3440",
        "peekViewEditor.background": "#141920",
        "peekViewResult.background": "#11161d",
        "quickInput.background": "#11161d",
        "quickInput.foreground": "#d9e1ea",
        "quickInputList.focusBackground": "#27303b",
        "quickInputList.focusForeground": "#e6edf3",
        "sideBar.background": "#11151a",
        "sideBar.border": "#2c3440",
        "sideBar.foreground": "#c3ccd7",
        "sideBarSectionHeader.background": "#0f1318",
        "sideBarSectionHeader.border": "#2c3440",
        "sideBarTitle.foreground": "#d9e1ea",
        "statusBar.background": "#151a21",
        "statusBar.border": "#2c3440",
        "statusBar.foreground": "#d9e1ea",
        "statusBar.noFolderBackground": "#12171d",
        "tab.activeBackground": "#1d232b",
        "tab.activeBorder": "#d7b4ff",
        "tab.activeForeground": "#e6edf3",
        "tab.border": "#2c3440",
        "tab.inactiveBackground": "#0f1318",
        "tab.inactiveForeground": "#9ba8b5",
        "tab.unfocusedActiveBackground": "#1d232b",
        "tab.unfocusedInactiveBackground": "#0f1318",
        "terminal.background": "#11161c",
        "terminal.border": "#2c3440",
        "terminal.foreground": "#d9e1ea",
        "titleBar.activeBackground": "#0d1116",
        "titleBar.activeForeground": "#d9e1ea",
        "titleBar.border": "#2c3440",
        "titleBar.inactiveBackground": "#0b0f14",
        "titleBar.inactiveForeground": "#98a5b3",
        "widget.shadow": "#00000066"
    },
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "comment": { "foreground": "#a6b3c2" },
        "string": { "foreground": "#a8e6cf" },
        "regexp": { "foreground": "#c6e59d" },
        "number": { "foreground": "#f3e1a6" },
        "keyword": { "foreground": "#ffb3c1" },
        "operator": { "foreground": "#ffb3c1" },
        "decorator": { "foreground": "#e3b8ff" },
        "macro": { "foreground": "#e3b8ff" },
        "method.declaration": { "foreground": "#d7b4ff" },
        "function.declaration": { "foreground": "#d7b4ff" },
        "function.declaration.async": { "foreground": "#d7b4ff" },
        "method": { "foreground": "#e6edf3", "fontStyle": "" },
        "function": { "foreground": "#e6edf3", "fontStyle": "" },
        "variable.defaultLibrary": { "foreground": "#f2a7c6" },
        "namespace": { "foreground": "#b8c0ff", "fontStyle": "" },
        "class": { "foreground": "#b8c0ff", "fontStyle": "" },
        "interface": { "foreground": "#b8c0ff" },
        "typeParameter": { "foreground": "#b8c0ff" },
        "variable": { "foreground": "#8fd3ff", "fontStyle": "" },
        "variable.readonly": { "foreground": "#9edfd6", "fontStyle": "" },
        "type": { "foreground": "#ffc4a6" },
        "parameter": { "foreground": "#ffcf99", "fontStyle": "" },
        "property": { "foreground": "#e6edf3", "fontStyle": "" },
        "property.declaration": { "foreground": "#e6edf3", "fontStyle": "" },
        "property.readonly": { "foreground": "#9edfd6", "fontStyle": "" },
        "enumMember": { "foreground": "#b8c0ff", "fontStyle": "" },
        "enum": { "foreground": "#b8c0ff", "fontStyle": "" },
        "struct": { "foreground": "#b8c0ff" },
        "event": { "foreground": "#9edfd6", "fontStyle": "" },
        "label": { "foreground": "#9edfd6", "fontStyle": "" },
        "selfTypeKeyword": { "foreground": "#f2a7c6" },
        "selfKeyword": { "foreground": "#f2a7c6" }
    },
    "tokenColors": [
        {
            "name": "Punctuation, function and method calls",
            "scope": [
                "punctuation",
                "punctuation.section.embedded",
                "meta.function-call",
                "punctuation.definition.constant.hashkey",
                "keyword.operator.assignment.ruby",
                "entity.name.function.call.cpp",
                "entity.name.function.member.cpp",
                "variable.other.object.property",
                "variable.other.property",
                "meta.brace.round.ts",
                "meta.brace.square.ts",
                "keyword.operator.type.ts",
                "keyword.operator.type.annotation.ts",
                "meta.function-call.ts",
                "keyword.operator.assignment.ts",
                "keyword.operator.relational.ts",
                "keyword.operator.increment.ts",
                "keyword.operator.bitwise.shift.ts",
                "keyword.operator.bitwise.ts",
                "punctuation.separator.key-value.ts",
                "keyword.operator.assignment.js",
                "keyword.operator.relational.js",
                "keyword.operator.increment.js",
                "keyword.operator.bitwise.shift.js",
                "keyword.operator.bitwise.js",
                "variable.other.object.property.js",
                "support.variable.property.js",
                "meta.brace.round.js",
                "meta.brace.square.js",
                "keyword.generator.asterisk.js",
                "keyword.operator.combinator.css",
                "meta.property-name.css",
                "punctuation.definition.constant.css",
                "punctuation.separator.key-value.mapping.yaml",
                "string.unquoted.plain.out.yaml",
                "source.sql",
                "constant.other.table-name.sql",
                "meta.function.call.rust",
                "keyword.operator.key-value.rust",
                "keyword.operator.assignment.c",
                "keyword.operator.comparison.c",
                "keyword.operator.increment.c",
                "meta.embedded.expression",
                "punctuation.definition.tag",
                "punctuation.definition.template-expression.begin",
                "punctuation.definition.template-expression.end",
                "punctuation.quasi.element.begin",
                "punctuation.quasi.element.end",
                "punctuation.terminator.dart",
                "punctuation.dot.dart"
            ],
            "settings": { "foreground": "#d9e1ea" }
        },
        {
            "name": "Comments",
            "scope": [
                "punctuation.definition.comment",
                "comment",
                "comment.line.double-slash",
                "comment.block.documentation",
                "string.quoted.docstring.multi.python"
            ],
            "settings": { "foreground": "#a6b3c2" }
        },
        {
            "name": "YARD documentation",
            "scope": [
                "comment.line.keyword.yard",
                "comment.line.keyword.punctuation.yard",
                "comment.line.punctuation.yard"
            ],
            "settings": { "foreground": "#ffd7a8" }
        },
        {
            "name": "Keywords",
            "scope": [
                "support.function.kernel.ruby",
                "keyword",
                "keyword.other",
                "keyword.operator",
                "keyword.control",
                "keyword.control.flow",
                "keyword.other.special-method",
                "storage",
                "storage.type",
                "punctuation.separator.key-value",
                "variable.language",
                "variable.other.env",
                "storage.type.variable",
                "storage.modifier",
                "storage.type.built-in.primitive.c",
                "storage.type.built-in.primitive.cpp",
                "storage.type.primitive.cpp",
                "punctuation.separator.pointer-access.cpp",
                "punctuation.definition.heading.markdown",
                "punctuation.definition.constant.markdown",
                "punctuation.definition.string.begin.markdown",
                "punctuation.definition.string.end.markdown",
                "punctuation.definition.list.begin.markdown",
                "punctuation.definition.markdown",
                "punctuation.definition.quote.begin.markdown",
                "punctuation.definition.raw.markdown",
                "storage.type.function.arrow.ts",
                "storage.type.function.ts",
                "storage.type.interface.ts",
                "storage.type.enum.ts",
                "entity.other.keyframe-offset",
                "support.constant.media.css",
                "support.constant.font-name",
                "support.constant.property-value.css",
                "support.constant.vendored.property-value",
                "support.constant.font-name.css",
                "entity.name.type.primitive.rust",
                "entity.name.type.numeric.rust"
            ],
            "settings": { "foreground": "#ffb3c1" }
        },
        {
            "name": "Parameters",
            "scope": [
                "variable.parameter",
                "constant.other.symbol.hashkey.parameter.function",
                "variable.other",
                "comment.line.parameter.yard",
                "markup.inline.raw.string.markdown",
                "markup.fenced_code.block.markdown",
                "markup.raw",
                "entity.other.attribute-name.html",
                "constant.other.color.rgb-value.hex.css",
                "support.constant.color.w3c-standard-color-name.css",
                "constant.other.database-name.sql",
                "variable.parameter.keyframe-list.css",
                "parameter.variable.function.elixir"
            ],
            "settings": { "foreground": "#ffcf99" }
        },
        {
            "name": "Strings",
            "scope": [
                "punctuation.definition.string.begin",
                "punctuation.definition.string.end",
                "string",
                "variable.other.quoted.double",
                "meta.jsx.children",
                "JSXNested"
            ],
            "settings": { "foreground": "#a8e6cf" }
        },
        { "scope": "meta.embedded.line", "settings": { "fontStyle": "" } },
        {
            "name": "Regexp",
            "scope": ["string.regexp", "punctuation.section.regexp"],
            "settings": { "foreground": "#c6e59d", "fontStyle": "" }
        },
        {
            "name": "Numbers",
            "scope": [
                "constant.numeric",
                "constant.length.units.css",
                "constant.percentage.units.css",
                "keyword.other.unit.em.css",
                "keyword.other.unit.percentage.css",
                "keyword.other.unit.rem.css",
                "keyword.other.unit.px.css"
            ],
            "settings": { "foreground": "#f3e1a6" }
        },
        {
            "name": "Classes, modules and namespaces",
            "scope": [
                "support.class",
                "meta.class",
                "entity.name.namespace",
                "entity.name.type",
                "entity.name.class",
                "entity.name.type.class",
                "entity.name.type.interface",
                "entity.name.type.enum",
                "entity.name.type.class.ruby",
                "entity.other.inherited-class.ruby",
                "entity.other.inherited-class",
                "entity.name.type.module",
                "meta.module.ruby",
                "variable.other.constant",
                "comment.line.type.yard",
                "entity.name.scope-resolution.cpp",
                "entity.name.scope-resolution.template.call.cpp",
                "entity.name.scope-resolution.parameter.cpp",
                "entity.name.scope-resolution.function.call.cpp",
                "markup.heading",
                "constant.other.reference.link.markdown",
                "string.other.link.title.markdown",
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css",
                "meta.selector.css",
                "entity.name.namespace.rust",
                "entity.name.type.enum.ts",
                "variable.other.readwrite.alias.ts",
                "support.class.dart"
            ],
            "settings": { "foreground": "#b8c0ff", "fontStyle": "" }
        },
        {
            "name": "Symbols",
            "scope": [
                "constant.other.symbol.ruby",
                "constant",
                "constant.language.symbol",
                "constant.other.symbol.hashkey.ruby",
                "markup.underline.link.markdown",
                "markup.underline.link",
                "support",
                "support.constant",
                "support.variable",
                "meta.property-name",
                "meta.link.inline.markdown",
                "support.type.property-name.json",
                "meta.object-literal.key.ts",
                "meta.object-literal.key.js",
                "entity.name.tag",
                "entity.name.tag.html",
                "punctuation.separator.key-value.css",
                "punctuation.terminator.rule.css",
                "entity.name.tag.yaml",
                "constant.other.symbol.hashkey.parameter.function.rbs"
            ],
            "settings": { "foreground": "#9edfd6", "fontStyle": "" }
        },
        {
            "name": "Instance variables",
            "scope": [
                "variable.other.readwrite.class",
                "variable.other.readwrite.instance",
                "punctuation.definition.variable",
                "variable.other.readwrite.global",
                "variable.other.property"
            ],
            "settings": { "foreground": "#f2b6a0", "fontStyle": "" }
        },
        {
            "name": "Language constants and special variables",
            "scope": ["constant.language", "variable.language.this"],
            "settings": { "foreground": "#f2a7c6" }
        },
        {
            "name": "Local variables",
            "scope": [
                "variable",
                "markup.list",
                "variable.object.property.ts",
                "variable.other.constant.object.ts",
                "variable.other.constant.js",
                "variable.other.constant.object.js"
            ],
            "settings": { "foreground": "#8fd3ff", "fontStyle": "" }
        },
        {
            "name": "Markdown italic",
            "scope": [
                "markup.italic",
                "markup.italic.markdown",
                "punctuation.definition.italic.markdown"
            ],
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "Markdown bold",
            "scope": [
                "markup.bold",
                "markup.bold.markdown",
                "punctuation.definition.bold.markdown"
            ],
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Types",
            "scope": [
                "support.type",
                "storage.type.struct",
                "storage.type.ts",
                "support.type.primitive.ts",
                "storage.type.class.ts",
                "storage.type.class.js",
                "storage.type.function.js",
                "storage.type.js",
                "storage.type.function.arrow.js",
                "constant.language.null.js",
                "support.type.builtin.rbs"
            ],
            "settings": { "foreground": "#ffc4a6" }
        },
        {
            "name": "Method and function definitions",
            "scope": [
                "meta.definition.method",
                "meta.method.declaration",
                "meta.function.method.with-arguments.ruby",
                "meta.function.method.without-arguments.ruby",
                "entity.name.function",
                "entity.name.function.member",
                "entity.name.function.preprocessor",
                "support.function"
            ],
            "settings": { "foreground": "#d7b4ff" }
        },
        {
            "name": "Method and function calls",
            "scope": ["meta.function-call"],
            "settings": { "foreground": "#d9e1ea" }
        },
        {
            "scope": "meta.attribute.rust",
            "settings": { "foreground": "#e3b8ff" }
        },
        {
            "name": "Invalid",
            "scope": [
                "invalid",
                "invalid.broken",
                "invalid.deprecated",
                "invalid.illegal",
                "invalid.unimplemented"
            ],
            "settings": { "fontStyle": "", "foreground": "#ff9f9f" }
        },
        {
            "name": "diff: header",
            "scope": [
                "meta.diff",
                "meta.diff.header",
                "punctuation.definition.to-file.diff",
                "punctuation.definition.from-file.diff",
                "punctuation.definition.range.diff"
            ],
            "settings": { "foreground": "#8fd3ff" }
        },
        {
            "name": "diff: deleted",
            "scope": ["markup.deleted", "punctuation.definition.deleted.diff"],
            "settings": { "fontStyle": "", "foreground": "#ff9f9f" }
        },
        {
            "name": "diff: changed",
            "scope": "markup.changed",
            "settings": { "fontStyle": "", "foreground": "#ffcf99" }
        },
        {
            "name": "diff: inserted",
            "scope": [
                "markup.inserted",
                "punctuation.definition.inserted.diff"
            ],
            "settings": { "foreground": "#a8e6cf" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
