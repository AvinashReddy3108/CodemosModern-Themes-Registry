        "notificationLink.foreground": "#A77642",
        "notificationCenterHeader.foreground": "#2B241D",
        "notificationCenterHeader.background": "#F6EFE3",
        "notificationsErrorIcon.foreground": "#C36648",
        "notificationsWarningIcon.foreground": "#B98842",
        "notificationsInfoIcon.foreground": "#B88A52",
        "quickInput.background": "#F6EFE3",
        "quickInput.foreground": "#2B241D",
        "quickInputList.focusBackground": "#B88A521A",
        "quickInputList.focusForeground": "#2B241D",
        "quickInputTitle.background": "#F6EFE3",
        "pickerGroup.border": "#F6EFE3",
        "pickerGroup.foreground": "#A7998A",
        "peekView.border": "#B88A52",
