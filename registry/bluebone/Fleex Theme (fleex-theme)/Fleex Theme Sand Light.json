        "peekViewResult.background": "#F6EFE3",
        "peekViewTitle.background": "#F6EFE3",
        "peekViewResult.selectionBackground": "#B88A521A",
        "peekViewTitleDescription.foreground": "#76695B",
        "peekViewTitleLabel.foreground": "#2B241D",
        "dropdown.background": "#F6EFE3",
        "dropdown.listBackground": "#F6EFE3",
        "dropdown.border": "#F6EFE3",
        "dropdown.foreground": "#2B241D",
        "menu.background": "#F6EFE3",
        "menu.foreground": "#2B241D",
        "menu.selectionBackground": "#B88A521A",
        "menu.separatorBackground": "#E8DECF",
        "menubar.selectionBackground": "#EEE5D8",
        "badge.background": "#B88A52",
        "badge.foreground": "#FFFFFF",
        "terminal.background": "#FDF9F2",
        "terminal.foreground": "#5B5045",
        "terminal.selectionBackground": "#B88A5233",
        "terminal.ansiBlack": "#5B5045",
        "terminal.ansiRed": "#B85D42",
        "terminal.ansiGreen": "#7F8E4F",
        "terminal.ansiYellow": "#B98842",
        "terminal.ansiBlue": "#A77642",
        "terminal.ansiMagenta": "#7B63BA",
        "terminal.ansiCyan": "#347E79",
        "terminal.ansiWhite": "#FBF6EF",
        "editorWidget.background": "#F6EFE3",
        "editorWidget.border": "#F6EFE3"
    },
    "semanticTokenColors": {
        "namespace": "#4A7A2A",
        "module": "#4A7A2A",
        "variable": "#484038",
        "variable.readonly": "#484038",
        "parameter": { "foreground": "#484038", "fontStyle": "italic" },
        "property": "#0A7868",
        "function": "#2A60B0",
        "function.defaultLibrary": {
            "foreground": "#2A60B0",
            "fontStyle": "italic"
        },
        "method": "#2A60B0",
        "method.defaultLibrary": {
            "foreground": "#2A60B0",
            "fontStyle": "italic"
        },
        "class": "#907008",
        "type": "#907008",
        "typeParameter": "#907008",
        "decorator": "#AA6020",
        "selfParameter:python": {
            "foreground": "#C03028",
            "fontStyle": "italic"
        },
        "clsParameter:python": {
            "foreground": "#C03028",
            "fontStyle": "italic"
        }
    },
    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#887A70", "fontStyle": "italic" }
        },
        {
            "name": "Strings",
            "scope": ["string", "punctuation.definition.string"],
            "settings": { "foreground": "#4A7A2A" }
        },
        {
            "name": "Numbers & Constants",
            "scope": [
                "constant.numeric",
                "constant.language",
                "constant.character",
                "constant.other"
            ],
            "settings": { "foreground": "#AA6020" }
        },
        {
            "name": "Keywords & Storage",
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#C03028" }
        },
        {
            "name": "Operators",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#7A7068" }
        },
        {
            "name": "Functions & Methods",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call"
            ],
            "settings": { "foreground": "#2A60B0" }
        },
        {
            "name": "Classes, Types & Inheritance",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.class",
                "support.type",
                "entity.other.inherited-class"
            ],
            "settings": { "foreground": "#907008" }
        },
        {
            "name": "Variables & Parameters",
            "scope": [
                "variable",
                "meta.definition.variable",
                "support.variable",
                "entity.name.variable"
            ],
            "settings": { "foreground": "#484038" }
        },
        {
            "name": "Function Parameters (Italic)",
            "scope": "variable.parameter",
            "settings": { "foreground": "#484038", "fontStyle": "italic" }
        },
        {
            "name": "Object Properties",
            "scope": ["variable.other.property", "support.type.property-name"],
            "settings": { "foreground": "#0A7868" }
        },
        {
            "name": "Punctuation",
            "scope": "punctuation",
            "settings": { "foreground": "#7A7068" }
        },
        {
            "name": "Object Literal Keys",
            "scope": "meta.object-literal.key",
            "settings": { "foreground": "#0A7868" }
        },
        {
            "name": "HTML/XML Tags",
            "scope": ["entity.name.tag", "punctuation.definition.tag"],
            "settings": { "foreground": "#C03028" }
        },
        {
            "name": "HTML/XML Attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#907008" }
        },
        {
            "name": "Regular Expressions",
            "scope": "string.regexp",
            "settings": { "foreground": "#AA6020" }
        },
        {
            "name": "CSS: Selectors",
            "scope": [
                "entity.name.tag.css",
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css",
                "meta.selector.css"
            ],
            "settings": { "foreground": "#C03028" }
        },
        {
            "name": "CSS: Property Names",
            "scope": "support.type.property-name.css",
            "settings": { "foreground": "#0A7868" }
        },
        {
            "name": "CSS: Property Values",
            "scope": [
                "support.constant.property-value.css",
                "keyword.other.unit.css"
            ],
            "settings": { "foreground": "#AA6020" }
        },
        {
            "name": "Vue: Directives",
            "scope": "entity.other.attribute-name.html.vue",
            "settings": { "foreground": "#C03028" }
        },
        {
            "name": "Vue: Component Tags",
            "scope": "support.class.component.html.vue",
            "settings": { "foreground": "#907008" }
        },
        {
            "name": "Decorators (Annotations)",
            "scope": [
                "meta.decorator punctuation.decorator",
                "meta.decorator entity.name.function",
                "meta.decorator entity.name.type",
                "meta.decorator variable.other.object"
            ],
            "settings": { "foreground": "#AA6020" }
        },
        {
            "name": "Markdown: Headings",
            "scope": "markup.heading.markdown",
            "settings": { "foreground": "#2A60B0" }
        },
        {
            "name": "Markdown: Links",
            "scope": [
                "markup.underline.link.markdown",
                "string.other.link.title.markdown"
            ],
            "settings": { "foreground": "#4A7A2A" }
        },
        {
            "name": "Markdown: Bold",
            "scope": "markup.bold.markdown",
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Markdown: Italic",
            "scope": "markup.italic.markdown",
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "Markdown: Code",
            "scope": [
                "markup.inline.raw.string.markdown",
                "markup.fenced_code.block.markdown"
            ],
            "settings": { "foreground": "#7A7068" }
        },
        {
            "name": "Invalid",
            "scope": "invalid",
            "settings": { "foreground": "#C06040" }
        },
        {
            "name": "Python: Import Module Names",
            "scope": [
                "entity.name.namespace.wildcard.python",
                "meta.statement.import.python entity.name.module.python",
                "support.other.module.python"
            ],
            "settings": { "foreground": "#4A7A2A" }
        },
        {
            "name": "Python: Built-in Functions",
            "scope": ["support.function.builtin.python"],
            "settings": { "foreground": "#2A60B0", "fontStyle": "italic" }
        },
        {
            "name": "Python: Magic Methods",
            "scope": ["support.function.magic.python"],
            "settings": { "foreground": "#2A60B0", "fontStyle": "italic" }
        },
        {
            "name": "Python: Built-in Types",
            "scope": "support.type.python",
            "settings": { "foreground": "#907008" }
        },
        {
            "name": "Python: self / cls Parameters",
            "scope": [
                "variable.parameter.function.language.special.self.python",
                "variable.parameter.function.language.special.cls.python"
            ],
            "settings": { "foreground": "#C03028", "fontStyle": "italic" }
        },
        {
            "name": "Python: Decorator Names",
            "scope": [
                "entity.name.function.decorator.python",
                "punctuation.definition.decorator.python"
            ],
            "settings": { "foreground": "#AA6020" }
        },
        {
            "name": "Python: Magic Variables",
            "scope": "support.variable.magic.python",
            "settings": { "foreground": "#0A7868" }
        },
        {
            "name": "Python: Exception Types",
            "scope": "support.class.exception.python",
            "settings": { "foreground": "#907008" }
        },
        {
            "name": "Python: f-string placeholders",
            "scope": [
                "meta.fstring.python variable",
                "constant.character.format.placeholder.other.python"
            ],
            "settings": { "foreground": "#484038" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
