        "notificationLink.foreground": "#E0A34A",
        "notificationCenterHeader.foreground": "#F2E9DD",
        "notificationCenterHeader.background": "#221D19",
        "notificationsErrorIcon.foreground": "#FF8A6B",
        "notificationsWarningIcon.foreground": "#E6B15A",
        "notificationsInfoIcon.foreground": "#E0A34A",
        "quickInput.background": "#2A241F",
        "quickInput.foreground": "#F2E9DD",
        "quickInputList.focusBackground": "#E0A34A22",
        "quickInputList.focusForeground": "#F2E9DD",
        "quickInputTitle.background": "#221D19",
        "pickerGroup.border": "#221D19",
        "pickerGroup.foreground": "#8F8174",
        "peekView.border": "#E0A34A",
        "peekViewEditor.background": "#1B1713",
        "peekViewResult.background": "#221D19",
        "peekViewTitle.background": "#221D19",
        "peekViewResult.selectionBackground": "#E0A34A22",
        "peekViewTitleDescription.foreground": "#B6A89A",
        "peekViewTitleLabel.foreground": "#F2E9DD",
        "dropdown.background": "#2A241F",
        "dropdown.listBackground": "#2A241F",
        "dropdown.border": "#342B24",
        "dropdown.foreground": "#F2E9DD",
        "menu.background": "#2A241F",
        "menu.foreground": "#F2E9DD",
        "menu.selectionBackground": "#E0A34A22",
        "menu.separatorBackground": "#342B24",
        "menubar.selectionBackground": "#342B24",
        "badge.background": "#E0A34A",
        "badge.foreground": "#1B1713",
        "terminal.background": "#1B1713",
        "terminal.foreground": "#F2E9DD",
        "terminal.selectionBackground": "#E0A34A33",
        "terminal.ansiBlack": "#15110D",
        "terminal.ansiRed": "#FF8A6B",
        "terminal.ansiGreen": "#8FA65A",
        "terminal.ansiYellow": "#E6B15A",
        "terminal.ansiBlue": "#D0893E",
        "terminal.ansiMagenta": "#C792EA",
        "terminal.ansiCyan": "#6FC5BE",
        "terminal.ansiWhite": "#F2E9DD",
        "editorWidget.background": "#2A241F",
        "editorWidget.border": "#342B24"
    },
    "semanticTokenColors": {
        "namespace": "#B0D080",
        "module": "#B0D080",
        "variable": "#C8C0B4",
        "variable.readonly": "#C8C0B4",
        "parameter": { "foreground": "#C8C0B4", "fontStyle": "italic" },
        "property": "#58C0B8",
        "function": "#78B0E0",
        "function.defaultLibrary": {
            "foreground": "#78B0E0",
            "fontStyle": "italic"
        },
        "method": "#78B0E0",
        "method.defaultLibrary": {
            "foreground": "#78B0E0",
            "fontStyle": "italic"
        },
        "class": "#E6C474",
        "type": "#E6C474",
        "typeParameter": "#E6C474",
        "decorator": "#D59860",
        "selfParameter:python": {
            "foreground": "#E87870",
            "fontStyle": "italic"
        },
        "clsParameter:python": {
            "foreground": "#E87870",
            "fontStyle": "italic"
        }
    },
    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#6C6058", "fontStyle": "italic" }
        },
        {
            "name": "Strings",
            "scope": ["string", "punctuation.definition.string"],
            "settings": { "foreground": "#B0D080" }
        },
        {
            "name": "Numbers & Constants",
            "scope": [
                "constant.numeric",
                "constant.language",
                "constant.character",
                "constant.other"
            ],
            "settings": { "foreground": "#D59860" }
        },
        {
            "name": "Keywords & Storage",
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#E87870" }
        },
        {
            "name": "Operators",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#8A8078" }
        },
        {
            "name": "Functions & Methods",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call"
            ],
            "settings": { "foreground": "#78B0E0" }
        },
        {
            "name": "Classes, Types & Inheritance",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.class",
                "support.type",
                "entity.other.inherited-class"
            ],
            "settings": { "foreground": "#E6C474" }
        },
        {
            "name": "Variables & Parameters",
            "scope": [
                "variable",
                "meta.definition.variable",
                "support.variable",
                "entity.name.variable"
            ],
            "settings": { "foreground": "#C8C0B4" }
        },
        {
            "name": "Function Parameters (Italic)",
            "scope": "variable.parameter",
            "settings": { "foreground": "#C8C0B4", "fontStyle": "italic" }
        },
        {
            "name": "Object Properties",
            "scope": ["variable.other.property", "support.type.property-name"],
            "settings": { "foreground": "#58C0B8" }
        },
        {
            "name": "Punctuation",
            "scope": "punctuation",
            "settings": { "foreground": "#8A8078" }
        },
        {
            "name": "Object Literal Keys",
            "scope": "meta.object-literal.key",
            "settings": { "foreground": "#58C0B8" }
        },
        {
            "name": "HTML/XML Tags",
            "scope": ["entity.name.tag", "punctuation.definition.tag"],
            "settings": { "foreground": "#E87870" }
        },
        {
            "name": "HTML/XML Attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#E6C474" }
        },
        {
            "name": "Regular Expressions",
            "scope": "string.regexp",
            "settings": { "foreground": "#D59860" }
        },
        {
            "name": "CSS: Selectors",
            "scope": [
                "entity.name.tag.css",
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css",
                "meta.selector.css"
            ],
            "settings": { "foreground": "#E87870" }
        },
        {
            "name": "CSS: Property Names",
            "scope": "support.type.property-name.css",
            "settings": { "foreground": "#58C0B8" }
        },
        {
            "name": "CSS: Property Values",
            "scope": [
                "support.constant.property-value.css",
                "keyword.other.unit.css"
            ],
            "settings": { "foreground": "#D59860" }
        },
        {
            "name": "Vue: Directives",
            "scope": "entity.other.attribute-name.html.vue",
            "settings": { "foreground": "#E87870" }
        },
        {
            "name": "Vue: Component Tags",
            "scope": "support.class.component.html.vue",
            "settings": { "foreground": "#E6C474" }
        },
        {
            "name": "Decorators (Annotations)",
            "scope": [
                "meta.decorator punctuation.decorator",
                "meta.decorator entity.name.function",
                "meta.decorator entity.name.type",
                "meta.decorator variable.other.object"
            ],
            "settings": { "foreground": "#D59860" }
        },
        {
            "name": "Markdown: Headings",
            "scope": "markup.heading.markdown",
            "settings": { "foreground": "#78B0E0" }
        },
        {
            "name": "Markdown: Links",
            "scope": [
                "markup.underline.link.markdown",
                "string.other.link.title.markdown"
            ],
            "settings": { "foreground": "#B0D080" }
        },
        {
            "name": "Markdown: Bold",
            "scope": "markup.bold.markdown",
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Markdown: Italic",
            "scope": "markup.italic.markdown",
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "Markdown: Code",
            "scope": [
                "markup.inline.raw.string.markdown",
                "markup.fenced_code.block.markdown"
            ],
            "settings": { "foreground": "#8A8078" }
        },
        {
            "name": "Invalid",
            "scope": "invalid",
            "settings": { "foreground": "#FF8A6B" }
        },
        {
            "name": "Python: Import Module Names",
            "scope": [
                "entity.name.namespace.wildcard.python",
                "meta.statement.import.python entity.name.module.python",
                "support.other.module.python"
            ],
            "settings": { "foreground": "#B0D080" }
        },
        {
            "name": "Python: Built-in Functions",
            "scope": ["support.function.builtin.python"],
            "settings": { "foreground": "#78B0E0", "fontStyle": "italic" }
        },
        {
            "name": "Python: Magic Methods",
            "scope": ["support.function.magic.python"],
            "settings": { "foreground": "#78B0E0", "fontStyle": "italic" }
        },
        {
            "name": "Python: Built-in Types",
            "scope": "support.type.python",
            "settings": { "foreground": "#E6C474" }
        },
        {
            "name": "Python: self / cls Parameters",
            "scope": [
                "variable.parameter.function.language.special.self.python",
                "variable.parameter.function.language.special.cls.python"
            ],
            "settings": { "foreground": "#E87870", "fontStyle": "italic" }
        },
        {
            "name": "Python: Decorator Names",
            "scope": [
                "entity.name.function.decorator.python",
                "punctuation.definition.decorator.python"
            ],
            "settings": { "foreground": "#D59860" }
        },
        {
            "name": "Python: Magic Variables",
            "scope": "support.variable.magic.python",
            "settings": { "foreground": "#58C0B8" }
        },
        {
            "name": "Python: Exception Types",
            "scope": "support.class.exception.python",
            "settings": { "foreground": "#E6C474" }
        },
        {
            "name": "Python: f-string placeholders",
            "scope": [
                "meta.fstring.python variable",
                "constant.character.format.placeholder.other.python"
            ],
            "settings": { "foreground": "#C8C0B4" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
