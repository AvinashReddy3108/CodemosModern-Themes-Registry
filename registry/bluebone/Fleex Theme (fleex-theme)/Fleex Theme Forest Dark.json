        "notificationLink.foreground": "#7BCB8F",
        "notificationCenterHeader.foreground": "#E7EFE7",
        "notificationCenterHeader.background": "#1C231E",
        "notificationsErrorIcon.foreground": "#FF8A73",
        "notificationsWarningIcon.foreground": "#D8A45B",
        "notificationsInfoIcon.foreground": "#6CB07A",
        "quickInput.background": "#222A24",
        "quickInput.foreground": "#E7EFE7",
        "quickInputList.focusBackground": "#6CB07A22",
        "quickInputList.focusForeground": "#E7EFE7",
        "quickInputTitle.background": "#1C231E",
        "pickerGroup.border": "#1C231E",
        "pickerGroup.foreground": "#7F8D80",
        "peekView.border": "#6CB07A",
        "peekViewEditor.background": "#151A16",
        "peekViewResult.background": "#1C231E",
        "peekViewTitle.background": "#1C231E",
        "peekViewResult.selectionBackground": "#6CB07A22",
        "peekViewTitleDescription.foreground": "#AAB7AC",
        "peekViewTitleLabel.foreground": "#E7EFE7",
        "dropdown.background": "#222A24",
        "dropdown.listBackground": "#222A24",
        "dropdown.border": "#2D3730",
        "dropdown.foreground": "#E7EFE7",
        "menu.background": "#222A24",
        "menu.foreground": "#E7EFE7",
        "menu.selectionBackground": "#6CB07A22",
        "menu.separatorBackground": "#2D3730",
        "menubar.selectionBackground": "#2D3730",
        "badge.background": "#6CB07A",
        "badge.foreground": "#151A16",
        "terminal.background": "#151A16",
        "terminal.foreground": "#E7EFE7",
        "terminal.selectionBackground": "#6CB07A33",
        "terminal.ansiBlack": "#101411",
        "terminal.ansiRed": "#FF8A73",
        "terminal.ansiGreen": "#91B563",
        "terminal.ansiYellow": "#D8A45B",
        "terminal.ansiBlue": "#7BCB8F",
        "terminal.ansiMagenta": "#BEA4FF",
        "terminal.ansiCyan": "#79D7B7",
        "terminal.ansiWhite": "#E7EFE7",
        "editorWidget.background": "#222A24",
        "editorWidget.border": "#2D3730"
    },
    "semanticTokenColors": {
        "namespace": "#A5DA8E",
        "module": "#A5DA8E",
        "variable": "#BCD4C8",
        "variable.readonly": "#BCD4C8",
        "parameter": { "foreground": "#BCD4C8", "fontStyle": "italic" },
        "property": "#5CCEB2",
        "function": "#6CB2F0",
        "function.defaultLibrary": {
            "foreground": "#6CB2F0",
            "fontStyle": "italic"
        },
        "method": "#6CB2F0",
        "method.defaultLibrary": {
            "foreground": "#6CB2F0",
            "fontStyle": "italic"
        },
        "class": "#DCC06A",
        "type": "#DCC06A",
        "typeParameter": "#DCC06A",
        "decorator": "#D7A068",
        "selfParameter:python": {
            "foreground": "#E07888",
            "fontStyle": "italic"
        },
        "clsParameter:python": {
            "foreground": "#E07888",
            "fontStyle": "italic"
        }
    },
    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#647864", "fontStyle": "italic" }
        },
        {
            "name": "Strings",
            "scope": ["string", "punctuation.definition.string"],
            "settings": { "foreground": "#A5DA8E" }
        },
        {
            "name": "Numbers & Constants",
            "scope": [
                "constant.numeric",
                "constant.language",
                "constant.character",
                "constant.other"
            ],
            "settings": { "foreground": "#D7A068" }
        },
        {
            "name": "Keywords & Storage",
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#E07888" }
        },
        {
            "name": "Operators",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#7E928A" }
        },
        {
            "name": "Functions & Methods",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call"
            ],
            "settings": { "foreground": "#6CB2F0" }
        },
        {
            "name": "Classes, Types & Inheritance",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.class",
                "support.type",
                "entity.other.inherited-class"
            ],
            "settings": { "foreground": "#DCC06A" }
        },
        {
            "name": "Variables & Parameters",
            "scope": [
                "variable",
                "meta.definition.variable",
                "support.variable",
                "entity.name.variable"
            ],
            "settings": { "foreground": "#BCD4C8" }
        },
        {
            "name": "Function Parameters (Italic)",
            "scope": "variable.parameter",
            "settings": { "foreground": "#BCD4C8", "fontStyle": "italic" }
        },
        {
            "name": "Object Properties",
            "scope": ["variable.other.property", "support.type.property-name"],
            "settings": { "foreground": "#5CCEB2" }
        },
        {
            "name": "Punctuation",
            "scope": "punctuation",
            "settings": { "foreground": "#7E928A" }
        },
        {
            "name": "Object Literal Keys",
            "scope": "meta.object-literal.key",
            "settings": { "foreground": "#5CCEB2" }
        },
        {
            "name": "HTML/XML Tags",
            "scope": ["entity.name.tag", "punctuation.definition.tag"],
            "settings": { "foreground": "#E07888" }
        },
        {
            "name": "HTML/XML Attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#DCC06A" }
        },
        {
            "name": "Regular Expressions",
            "scope": "string.regexp",
            "settings": { "foreground": "#D7A068" }
        },
        {
            "name": "CSS: Selectors",
            "scope": [
                "entity.name.tag.css",
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css",
                "meta.selector.css"
            ],
            "settings": { "foreground": "#E07888" }
        },
        {
            "name": "CSS: Property Names",
            "scope": "support.type.property-name.css",
            "settings": { "foreground": "#5CCEB2" }
        },
        {
            "name": "CSS: Property Values",
            "scope": [
                "support.constant.property-value.css",
                "keyword.other.unit.css"
            ],
            "settings": { "foreground": "#D7A068" }
        },
        {
            "name": "Vue: Directives",
            "scope": "entity.other.attribute-name.html.vue",
            "settings": { "foreground": "#E07888" }
        },
        {
            "name": "Vue: Component Tags",
            "scope": "support.class.component.html.vue",
            "settings": { "foreground": "#DCC06A" }
        },
        {
            "name": "Decorators (Annotations)",
            "scope": [
                "meta.decorator punctuation.decorator",
                "meta.decorator entity.name.function",
                "meta.decorator entity.name.type",
                "meta.decorator variable.other.object"
            ],
            "settings": { "foreground": "#D7A068" }
        },
        {
            "name": "Markdown: Headings",
            "scope": "markup.heading.markdown",
            "settings": { "foreground": "#6CB2F0" }
        },
        {
            "name": "Markdown: Links",
            "scope": [
                "markup.underline.link.markdown",
                "string.other.link.title.markdown"
            ],
            "settings": { "foreground": "#A5DA8E" }
        },
        {
            "name": "Markdown: Bold",
            "scope": "markup.bold.markdown",
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Markdown: Italic",
            "scope": "markup.italic.markdown",
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "Markdown: Code",
            "scope": [
                "markup.inline.raw.string.markdown",
                "markup.fenced_code.block.markdown"
            ],
            "settings": { "foreground": "#7E928A" }
        },
        {
            "name": "Invalid",
            "scope": "invalid",
            "settings": { "foreground": "#FF8A73" }
        },
        {
            "name": "Python: Import Module Names",
            "scope": [
                "entity.name.namespace.wildcard.python",
                "meta.statement.import.python entity.name.module.python",
                "support.other.module.python"
            ],
            "settings": { "foreground": "#A5DA8E" }
        },
        {
            "name": "Python: Built-in Functions",
            "scope": ["support.function.builtin.python"],
            "settings": { "foreground": "#6CB2F0", "fontStyle": "italic" }
        },
        {
            "name": "Python: Magic Methods",
            "scope": ["support.function.magic.python"],
            "settings": { "foreground": "#6CB2F0", "fontStyle": "italic" }
        },
        {
            "name": "Python: Built-in Types",
            "scope": "support.type.python",
            "settings": { "foreground": "#DCC06A" }
        },
        {
            "name": "Python: self / cls Parameters",
            "scope": [
                "variable.parameter.function.language.special.self.python",
                "variable.parameter.function.language.special.cls.python"
            ],
            "settings": { "foreground": "#E07888", "fontStyle": "italic" }
        },
        {
            "name": "Python: Decorator Names",
            "scope": [
                "entity.name.function.decorator.python",
                "punctuation.definition.decorator.python"
            ],
            "settings": { "foreground": "#D7A068" }
        },
        {
            "name": "Python: Magic Variables",
            "scope": "support.variable.magic.python",
            "settings": { "foreground": "#5CCEB2" }
        },
        {
            "name": "Python: Exception Types",
            "scope": "support.class.exception.python",
            "settings": { "foreground": "#DCC06A" }
        },
        {
            "name": "Python: f-string placeholders",
            "scope": [
                "meta.fstring.python variable",
                "constant.character.format.placeholder.other.python"
            ],
            "settings": { "foreground": "#BCD4C8" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
