        "notificationLink.foreground": "#C05B7A",
        "notificationCenterHeader.foreground": "#2C2227",
        "notificationCenterHeader.background": "#FBEEF2",
        "notificationsErrorIcon.foreground": "#C45864",
        "notificationsWarningIcon.foreground": "#B57B36",
        "notificationsInfoIcon.foreground": "#D0708D",
        "quickInput.background": "#FBEEF2",
        "quickInput.foreground": "#2C2227",
        "quickInputList.focusBackground": "#D0708D1A",
        "quickInputList.focusForeground": "#2C2227",
        "quickInputTitle.background": "#FBEEF2",
        "pickerGroup.border": "#FBEEF2",
        "pickerGroup.foreground": "#A38C97",
        "peekView.border": "#D0708D",
        "peekViewEditor.background": "#FFF8FA",
        "peekViewResult.background": "#FBEEF2",
        "peekViewTitle.background": "#FBEEF2",
        "peekViewResult.selectionBackground": "#D0708D1A",
        "peekViewTitleDescription.foreground": "#7C6671",
        "peekViewTitleLabel.foreground": "#2C2227",
        "dropdown.background": "#FBEEF2",
        "dropdown.listBackground": "#FBEEF2",
        "dropdown.border": "#FBEEF2",
        "dropdown.foreground": "#2C2227",
        "menu.background": "#FBEEF2",
        "menu.foreground": "#2C2227",
        "menu.selectionBackground": "#D0708D1A",
        "menu.separatorBackground": "#EADCE2",
        "menubar.selectionBackground": "#F0E3E8",
        "badge.background": "#D0708D",
        "badge.foreground": "#FFFFFF",
        "terminal.background": "#FFF8FA",
        "terminal.foreground": "#5F4E55",
        "terminal.selectionBackground": "#D0708D33",
        "terminal.ansiBlack": "#5F4E55",
        "terminal.ansiRed": "#C45864",
        "terminal.ansiGreen": "#7EA164",
        "terminal.ansiYellow": "#B57B36",
        "terminal.ansiBlue": "#C05B7A",
        "terminal.ansiMagenta": "#8A63C8",
        "terminal.ansiCyan": "#2F8F8E",
        "terminal.ansiWhite": "#FCF5F8",
        "editorWidget.background": "#FBEEF2",
        "editorWidget.border": "#FBEEF2"
    },
    "semanticTokenColors": {
        "namespace": "#3E7A3E",
        "module": "#3E7A3E",
        "variable": "#4A3E4E",
        "variable.readonly": "#4A3E4E",
        "parameter": { "foreground": "#4A3E4E", "fontStyle": "italic" },
        "property": "#0A7870",
        "function": "#2A5CB8",
        "function.defaultLibrary": {
            "foreground": "#2A5CB8",
            "fontStyle": "italic"
        },
        "method": "#2A5CB8",
        "method.defaultLibrary": {
            "foreground": "#2A5CB8",
            "fontStyle": "italic"
        },
        "class": "#907010",
        "type": "#907010",
        "typeParameter": "#907010",
        "decorator": "#B06030",
        "selfParameter:python": {
            "foreground": "#C22060",
            "fontStyle": "italic"
        },
        "clsParameter:python": {
            "foreground": "#C22060",
            "fontStyle": "italic"
        }
    },
    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#8A7880", "fontStyle": "italic" }
        },
        {
            "name": "Strings",
            "scope": ["string", "punctuation.definition.string"],
            "settings": { "foreground": "#3E7A3E" }
        },
        {
            "name": "Numbers & Constants",
            "scope": [
                "constant.numeric",
                "constant.language",
                "constant.character",
                "constant.other"
            ],
            "settings": { "foreground": "#B06030" }
        },
        {
            "name": "Keywords & Storage",
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#C22060" }
        },
        {
            "name": "Operators",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#806878" }
        },
        {
            "name": "Functions & Methods",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call"
            ],
            "settings": { "foreground": "#2A5CB8" }
        },
        {
            "name": "Classes, Types & Inheritance",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.class",
                "support.type",
                "entity.other.inherited-class"
            ],
            "settings": { "foreground": "#907010" }
        },
        {
            "name": "Variables & Parameters",
            "scope": [
                "variable",
                "meta.definition.variable",
                "support.variable",
                "entity.name.variable"
            ],
            "settings": { "foreground": "#4A3E4E" }
        },
        {
            "name": "Function Parameters (Italic)",
            "scope": "variable.parameter",
            "settings": { "foreground": "#4A3E4E", "fontStyle": "italic" }
        },
        {
            "name": "Object Properties",
            "scope": ["variable.other.property", "support.type.property-name"],
            "settings": { "foreground": "#0A7870" }
        },
        {
            "name": "Punctuation",
            "scope": "punctuation",
            "settings": { "foreground": "#806878" }
        },
        {
            "name": "Object Literal Keys",
            "scope": "meta.object-literal.key",
            "settings": { "foreground": "#0A7870" }
        },
        {
            "name": "HTML/XML Tags",
            "scope": ["entity.name.tag", "punctuation.definition.tag"],
            "settings": { "foreground": "#C22060" }
        },
        {
            "name": "HTML/XML Attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#907010" }
        },
        {
            "name": "Regular Expressions",
            "scope": "string.regexp",
            "settings": { "foreground": "#B06030" }
        },
        {
            "name": "CSS: Selectors",
            "scope": [
                "entity.name.tag.css",
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css",
                "meta.selector.css"
            ],
            "settings": { "foreground": "#C22060" }
        },
        {
            "name": "CSS: Property Names",
            "scope": "support.type.property-name.css",
            "settings": { "foreground": "#0A7870" }
        },
        {
            "name": "CSS: Property Values",
            "scope": [
                "support.constant.property-value.css",
                "keyword.other.unit.css"
            ],
            "settings": { "foreground": "#B06030" }
        },
        {
            "name": "Vue: Directives",
            "scope": "entity.other.attribute-name.html.vue",
            "settings": { "foreground": "#C22060" }
        },
        {
            "name": "Vue: Component Tags",
            "scope": "support.class.component.html.vue",
            "settings": { "foreground": "#907010" }
        },
        {
            "name": "Decorators (Annotations)",
            "scope": [
                "meta.decorator punctuation.decorator",
                "meta.decorator entity.name.function",
                "meta.decorator entity.name.type",
                "meta.decorator variable.other.object"
            ],
            "settings": { "foreground": "#B06030" }
        },
        {
            "name": "Markdown: Headings",
            "scope": "markup.heading.markdown",
            "settings": { "foreground": "#2A5CB8" }
        },
        {
            "name": "Markdown: Links",
            "scope": [
                "markup.underline.link.markdown",
                "string.other.link.title.markdown"
            ],
            "settings": { "foreground": "#3E7A3E" }
        },
        {
            "name": "Markdown: Bold",
            "scope": "markup.bold.markdown",
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Markdown: Italic",
            "scope": "markup.italic.markdown",
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "Markdown: Code",
            "scope": [
                "markup.inline.raw.string.markdown",
                "markup.fenced_code.block.markdown"
            ],
            "settings": { "foreground": "#806878" }
        },
        {
            "name": "Invalid",
            "scope": "invalid",
            "settings": { "foreground": "#C8485A" }
        },
        {
            "name": "Python: Import Module Names",
            "scope": [
                "entity.name.namespace.wildcard.python",
                "meta.statement.import.python entity.name.module.python",
                "support.other.module.python"
            ],
            "settings": { "foreground": "#3E7A3E" }
        },
        {
            "name": "Python: Built-in Functions",
            "scope": ["support.function.builtin.python"],
            "settings": { "foreground": "#2A5CB8", "fontStyle": "italic" }
        },
        {
            "name": "Python: Magic Methods",
            "scope": ["support.function.magic.python"],
            "settings": { "foreground": "#2A5CB8", "fontStyle": "italic" }
        },
        {
            "name": "Python: Built-in Types",
            "scope": "support.type.python",
            "settings": { "foreground": "#907010" }
        },
        {
            "name": "Python: self / cls Parameters",
            "scope": [
                "variable.parameter.function.language.special.self.python",
                "variable.parameter.function.language.special.cls.python"
            ],
            "settings": { "foreground": "#C22060", "fontStyle": "italic" }
        },
        {
            "name": "Python: Decorator Names",
            "scope": [
                "entity.name.function.decorator.python",
                "punctuation.definition.decorator.python"
            ],
            "settings": { "foreground": "#B06030" }
        },
        {
            "name": "Python: Magic Variables",
            "scope": "support.variable.magic.python",
            "settings": { "foreground": "#0A7870" }
        },
        {
            "name": "Python: Exception Types",
            "scope": "support.class.exception.python",
            "settings": { "foreground": "#907010" }
        },
        {
            "name": "Python: f-string placeholders",
            "scope": [
                "meta.fstring.python variable",
                "constant.character.format.placeholder.other.python"
            ],
            "settings": { "foreground": "#4A3E4E" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
