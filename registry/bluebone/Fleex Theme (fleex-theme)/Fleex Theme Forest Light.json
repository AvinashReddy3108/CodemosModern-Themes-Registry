        "notifications": "#467E58",
        "notifications.foreground": "#467E58",
        "notifications.background": "#F1F7EE",
        "notificationLink.foreground": "#467E58",
        "notificationCenterHeader.foreground": "#1F2A21",
        "notificationCenterHeader.background": "#F1F7EE",
        "notificationsErrorIcon.foreground": "#C55C4F",
        "notificationsWarningIcon.foreground": "#B07A36",
        "notificationsInfoIcon.foreground": "#4E8B61",
        "quickInput.background": "#F1F7EE",
        "quickInput.foreground": "#1F2A21",
        "quickInputList.focusBackground": "#4E8B611A",
        "quickInputList.focusForeground": "#1F2A21",
        "quickInputTitle.background": "#F1F7EE",
        "pickerGroup.border": "#F1F7EE",
        "pickerGroup.foreground": "#94A195",
        "peekView.border": "#4E8B61",
        "peekViewEditor.background": "#FBFDF9",
        "peekViewResult.background": "#F1F7EE",
        "peekViewTitle.background": "#F1F7EE",
        "peekViewResult.selectionBackground": "#4E8B611A",
        "peekViewTitleDescription.foreground": "#6E7B70",
        "peekViewTitleLabel.foreground": "#1F2A21",
        "dropdown.background": "#F1F7EE",
        "dropdown.listBackground": "#F1F7EE",
        "dropdown.border": "#F1F7EE",
        "dropdown.foreground": "#1F2A21",
        "menu.background": "#F1F7EE",
        "menu.foreground": "#1F2A21",
        "menu.selectionBackground": "#4E8B611A",
        "menu.separatorBackground": "#DCE7DB",
        "menubar.selectionBackground": "#E4ECE1",
        "badge.background": "#4E8B61",
        "badge.foreground": "#FFFFFF",
        "terminal.background": "#FBFDF9",
        "terminal.foreground": "#4F5D51",
        "terminal.selectionBackground": "#4E8B6133",
        "terminal.ansiBlack": "#4F5D51",
        "terminal.ansiRed": "#B55649",
        "terminal.ansiGreen": "#5C8C45",
        "terminal.ansiYellow": "#A97938",
        "terminal.ansiBlue": "#4E8B61",
        "terminal.ansiMagenta": "#6B5FC0",
        "terminal.ansiCyan": "#2E8B72",
        "terminal.ansiWhite": "#F7FBF5",
        "editorWidget.background": "#F1F7EE",
        "editorWidget.border": "#F1F7EE"
    },
    "semanticTokenColors": {
        "namespace": "#3D7A2E",
        "module": "#3D7A2E",
        "variable": "#3A5048",
        "variable.readonly": "#3A5048",
        "parameter": { "foreground": "#3A5048", "fontStyle": "italic" },
        "property": "#1A7A5C",
        "function": "#2060B8",
        "function.defaultLibrary": {
            "foreground": "#2060B8",
            "fontStyle": "italic"
        },
        "method": "#2060B8",
        "method.defaultLibrary": {
            "foreground": "#2060B8",
            "fontStyle": "italic"
        },
        "class": "#907210",
        "type": "#907210",
        "typeParameter": "#907210",
        "decorator": "#A86830",
        "selfParameter:python": {
            "foreground": "#B52050",
            "fontStyle": "italic"
        },
        "clsParameter:python": {
            "foreground": "#B52050",
            "fontStyle": "italic"
        }
    },
    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#7A8A7C", "fontStyle": "italic" }
        },
        {
            "name": "Strings",
            "scope": ["string", "punctuation.definition.string"],
            "settings": { "foreground": "#3D7A2E" }
        },
        {
            "name": "Numbers & Constants",
            "scope": [
                "constant.numeric",
                "constant.language",
                "constant.character",
                "constant.other"
            ],
            "settings": { "foreground": "#A86830" }
        },
        {
            "name": "Keywords & Storage",
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#B52050" }
        },
        {
            "name": "Operators",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#657060" }
        },
        {
            "name": "Functions & Methods",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call"
            ],
            "settings": { "foreground": "#2060B8" }
        },
        {
            "name": "Classes, Types & Inheritance",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.class",
                "support.type",
                "entity.other.inherited-class"
            ],
            "settings": { "foreground": "#907210" }
        },
        {
            "name": "Variables & Parameters",
            "scope": [
                "variable",
                "meta.definition.variable",
                "support.variable",
                "entity.name.variable"
            ],
            "settings": { "foreground": "#3A5048" }
        },
        {
            "name": "Function Parameters (Italic)",
            "scope": "variable.parameter",
            "settings": { "foreground": "#3A5048", "fontStyle": "italic" }
        },
        {
            "name": "Object Properties",
            "scope": ["variable.other.property", "support.type.property-name"],
            "settings": { "foreground": "#1A7A5C" }
        },
        {
            "name": "Punctuation",
            "scope": "punctuation",
            "settings": { "foreground": "#657060" }
        },
        {
            "name": "Object Literal Keys",
            "scope": "meta.object-literal.key",
            "settings": { "foreground": "#1A7A5C" }
        },
        {
            "name": "HTML/XML Tags",
            "scope": ["entity.name.tag", "punctuation.definition.tag"],
            "settings": { "foreground": "#B52050" }
        },
        {
            "name": "HTML/XML Attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#907210" }
        },
        {
            "name": "Regular Expressions",
            "scope": "string.regexp",
            "settings": { "foreground": "#A86830" }
        },
        {
            "name": "CSS: Selectors",
            "scope": [
                "entity.name.tag.css",
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css",
                "meta.selector.css"
            ],
            "settings": { "foreground": "#B52050" }
        },
        {
            "name": "CSS: Property Names",
            "scope": "support.type.property-name.css",
            "settings": { "foreground": "#1A7A5C" }
        },
        {
            "name": "CSS: Property Values",
            "scope": [
                "support.constant.property-value.css",
                "keyword.other.unit.css"
            ],
            "settings": { "foreground": "#A86830" }
        },
        {
            "name": "Vue: Directives",
            "scope": "entity.other.attribute-name.html.vue",
            "settings": { "foreground": "#B52050" }
        },
        {
            "name": "Vue: Component Tags",
            "scope": "support.class.component.html.vue",
            "settings": { "foreground": "#907210" }
        },
        {
            "name": "Decorators (Annotations)",
            "scope": [
                "meta.decorator punctuation.decorator",
                "meta.decorator entity.name.function",
                "meta.decorator entity.name.type",
                "meta.decorator variable.other.object"
            ],
            "settings": { "foreground": "#A86830" }
        },
        {
            "name": "Markdown: Headings",
            "scope": "markup.heading.markdown",
            "settings": { "foreground": "#2060B8" }
        },
        {
            "name": "Markdown: Links",
            "scope": [
                "markup.underline.link.markdown",
                "string.other.link.title.markdown"
            ],
            "settings": { "foreground": "#3D7A2E" }
        },
        {
            "name": "Markdown: Bold",
            "scope": "markup.bold.markdown",
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Markdown: Italic",
            "scope": "markup.italic.markdown",
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "Markdown: Code",
            "scope": [
                "markup.inline.raw.string.markdown",
                "markup.fenced_code.block.markdown"
            ],
            "settings": { "foreground": "#657060" }
        },
        {
            "name": "Invalid",
            "scope": "invalid",
            "settings": { "foreground": "#C55C4F" }
        },
        {
            "name": "Python: Import Module Names",
            "scope": [
                "entity.name.namespace.wildcard.python",
                "meta.statement.import.python entity.name.module.python",
                "support.other.module.python"
            ],
            "settings": { "foreground": "#3D7A2E" }
        },
        {
            "name": "Python: Built-in Functions",
            "scope": ["support.function.builtin.python"],
            "settings": { "foreground": "#2060B8", "fontStyle": "italic" }
        },
        {
            "name": "Python: Magic Methods",
            "scope": ["support.function.magic.python"],
            "settings": { "foreground": "#2060B8", "fontStyle": "italic" }
        },
        {
            "name": "Python: Built-in Types",
            "scope": "support.type.python",
            "settings": { "foreground": "#907210" }
        },
        {
            "name": "Python: self / cls Parameters",
            "scope": [
                "variable.parameter.function.language.special.self.python",
                "variable.parameter.function.language.special.cls.python"
            ],
            "settings": { "foreground": "#B52050", "fontStyle": "italic" }
        },
        {
            "name": "Python: Decorator Names",
            "scope": [
                "entity.name.function.decorator.python",
                "punctuation.definition.decorator.python"
            ],
            "settings": { "foreground": "#A86830" }
        },
        {
            "name": "Python: Magic Variables",
            "scope": "support.variable.magic.python",
            "settings": { "foreground": "#1A7A5C" }
        },
        {
            "name": "Python: Exception Types",
            "scope": "support.class.exception.python",
            "settings": { "foreground": "#907210" }
        },
        {
            "name": "Python: f-string placeholders",
            "scope": [
                "meta.fstring.python variable",
                "constant.character.format.placeholder.other.python"
            ],
            "settings": { "foreground": "#3A5048" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
