        "textLink.foreground": "#467E58",
        "textCodeBlock.background": "#E7F1E5",
        "textSeparator.foreground": "#E4ECE1",
        "scrollbar.shadow": "#00000000",
        "scrollbarSlider.background": "#B8C8B780",
