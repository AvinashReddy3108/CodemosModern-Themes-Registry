        "notifications": "#2E78A6",
        "notifications.foreground": "#2E78A6",
        "notifications.background": "#ECF6F8",
        "notificationLink.foreground": "#2E78A6",
        "notificationCenterHeader.foreground": "#1E2930",
        "notificationCenterHeader.background": "#ECF6F8",
        "notificationsErrorIcon.foreground": "#C2604C",
        "notificationsWarningIcon.foreground": "#B8802F",
        "notificationsInfoIcon.foreground": "#2F8FAE",
        "quickInput.background": "#ECF6F8",
        "quickInput.foreground": "#1E2930",
        "quickInputList.focusBackground": "#2F8FAE1A",
        "quickInputList.focusForeground": "#1E2930",
        "quickInputTitle.background": "#ECF6F8",
        "pickerGroup.border": "#ECF6F8",
        "pickerGroup.foreground": "#93A7AE",
        "peekView.border": "#2F8FAE",
        "peekViewEditor.background": "#F7FCFD",
        "peekViewResult.background": "#ECF6F8",
        "peekViewTitle.background": "#ECF6F8",
        "peekViewResult.selectionBackground": "#2F8FAE1A",
        "peekViewTitleDescription.foreground": "#60747B",
        "peekViewTitleLabel.foreground": "#1E2930",
        "dropdown.background": "#ECF6F8",
        "dropdown.listBackground": "#ECF6F8",
        "dropdown.border": "#ECF6F8",
        "dropdown.foreground": "#1E2930",
        "menu.background": "#ECF6F8",
        "menu.foreground": "#1E2930",
        "menu.selectionBackground": "#2F8FAE1A",
        "menu.separatorBackground": "#DAE8EC",
        "menubar.selectionBackground": "#E1EDF0",
        "badge.background": "#2F8FAE",
        "badge.foreground": "#FFFFFF",
        "terminal.background": "#F7FCFD",
        "terminal.foreground": "#4C5F66",
        "terminal.selectionBackground": "#2F8FAE33",
        "terminal.ansiBlack": "#4C5F66",
        "terminal.ansiRed": "#B85E4A",
        "terminal.ansiGreen": "#4D9D86",
        "terminal.ansiYellow": "#B8802F",
        "terminal.ansiBlue": "#2E78A6",
        "terminal.ansiMagenta": "#7365C4",
        "terminal.ansiCyan": "#2E8F9A",
        "terminal.ansiWhite": "#F4FBFC",
        "editorWidget.background": "#ECF6F8",
        "editorWidget.border": "#ECF6F8"
    },
    "semanticTokenColors": {
        "namespace": "#2E7A45",
        "module": "#2E7A45",
        "variable": "#3A4C58",
        "variable.readonly": "#3A4C58",
        "parameter": { "foreground": "#3A4C58", "fontStyle": "italic" },
        "property": "#0A7880",
        "function": "#1260B8",
        "function.defaultLibrary": {
            "foreground": "#1260B8",
            "fontStyle": "italic"
        },
        "method": "#1260B8",
        "method.defaultLibrary": {
            "foreground": "#1260B8",
            "fontStyle": "italic"
        },
        "class": "#907008",
        "type": "#907008",
        "typeParameter": "#907008",
        "decorator": "#A87530",
        "selfParameter:python": {
            "foreground": "#B8205A",
            "fontStyle": "italic"
        },
        "clsParameter:python": {
            "foreground": "#B8205A",
            "fontStyle": "italic"
        }
    },
    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#7A8C94", "fontStyle": "italic" }
        },
        {
            "name": "Strings",
            "scope": ["string", "punctuation.definition.string"],
            "settings": { "foreground": "#2E7A45" }
        },
        {
            "name": "Numbers & Constants",
            "scope": [
                "constant.numeric",
                "constant.language",
                "constant.character",
                "constant.other"
            ],
            "settings": { "foreground": "#A87530" }
        },
        {
            "name": "Keywords & Storage",
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#B8205A" }
        },
        {
            "name": "Operators",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#607078" }
        },
        {
            "name": "Functions & Methods",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call"
            ],
            "settings": { "foreground": "#1260B8" }
        },
        {
            "name": "Classes, Types & Inheritance",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.class",
                "support.type",
                "entity.other.inherited-class"
            ],
            "settings": { "foreground": "#907008" }
        },
        {
            "name": "Variables & Parameters",
            "scope": [
                "variable",
                "meta.definition.variable",
                "support.variable",
                "entity.name.variable"
            ],
            "settings": { "foreground": "#3A4C58" }
        },
        {
            "name": "Function Parameters (Italic)",
            "scope": "variable.parameter",
            "settings": { "foreground": "#3A4C58", "fontStyle": "italic" }
        },
        {
            "name": "Object Properties",
            "scope": ["variable.other.property", "support.type.property-name"],
            "settings": { "foreground": "#0A7880" }
        },
        {
            "name": "Punctuation",
            "scope": "punctuation",
            "settings": { "foreground": "#607078" }
        },
        {
            "name": "Object Literal Keys",
            "scope": "meta.object-literal.key",
            "settings": { "foreground": "#0A7880" }
        },
        {
            "name": "HTML/XML Tags",
            "scope": ["entity.name.tag", "punctuation.definition.tag"],
            "settings": { "foreground": "#B8205A" }
        },
        {
            "name": "HTML/XML Attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#907008" }
        },
        {
            "name": "Regular Expressions",
            "scope": "string.regexp",
            "settings": { "foreground": "#A87530" }
        },
        {
            "name": "CSS: Selectors",
            "scope": [
                "entity.name.tag.css",
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css",
                "meta.selector.css"
            ],
            "settings": { "foreground": "#B8205A" }
        },
        {
            "name": "CSS: Property Names",
            "scope": "support.type.property-name.css",
            "settings": { "foreground": "#0A7880" }
        },
        {
            "name": "CSS: Property Values",
            "scope": [
                "support.constant.property-value.css",
                "keyword.other.unit.css"
            ],
            "settings": { "foreground": "#A87530" }
        },
        {
            "name": "Vue: Directives",
            "scope": "entity.other.attribute-name.html.vue",
            "settings": { "foreground": "#B8205A" }
        },
        {
            "name": "Vue: Component Tags",
            "scope": "support.class.component.html.vue",
            "settings": { "foreground": "#907008" }
        },
        {
            "name": "Decorators (Annotations)",
            "scope": [
                "meta.decorator punctuation.decorator",
                "meta.decorator entity.name.function",
                "meta.decorator entity.name.type",
                "meta.decorator variable.other.object"
            ],
            "settings": { "foreground": "#A87530" }
        },
        {
            "name": "Markdown: Headings",
            "scope": "markup.heading.markdown",
            "settings": { "foreground": "#1260B8" }
        },
        {
            "name": "Markdown: Links",
            "scope": [
                "markup.underline.link.markdown",
                "string.other.link.title.markdown"
            ],
            "settings": { "foreground": "#2E7A45" }
        },
        {
            "name": "Markdown: Bold",
            "scope": "markup.bold.markdown",
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Markdown: Italic",
            "scope": "markup.italic.markdown",
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "Markdown: Code",
            "scope": [
                "markup.inline.raw.string.markdown",
                "markup.fenced_code.block.markdown"
            ],
            "settings": { "foreground": "#607078" }
        },
        {
            "name": "Invalid",
            "scope": "invalid",
            "settings": { "foreground": "#C2604C" }
        },
        {
            "name": "Python: Import Module Names",
            "scope": [
                "entity.name.namespace.wildcard.python",
                "meta.statement.import.python entity.name.module.python",
                "support.other.module.python"
            ],
            "settings": { "foreground": "#2E7A45" }
        },
        {
            "name": "Python: Built-in Functions",
            "scope": ["support.function.builtin.python"],
            "settings": { "foreground": "#1260B8", "fontStyle": "italic" }
        },
        {
            "name": "Python: Magic Methods",
            "scope": ["support.function.magic.python"],
            "settings": { "foreground": "#1260B8", "fontStyle": "italic" }
        },
        {
            "name": "Python: Built-in Types",
            "scope": "support.type.python",
            "settings": { "foreground": "#907008" }
        },
        {
            "name": "Python: self / cls Parameters",
            "scope": [
                "variable.parameter.function.language.special.self.python",
                "variable.parameter.function.language.special.cls.python"
            ],
            "settings": { "foreground": "#B8205A", "fontStyle": "italic" }
        },
        {
            "name": "Python: Decorator Names",
            "scope": [
                "entity.name.function.decorator.python",
                "punctuation.definition.decorator.python"
            ],
            "settings": { "foreground": "#A87530" }
        },
        {
            "name": "Python: Magic Variables",
            "scope": "support.variable.magic.python",
            "settings": { "foreground": "#0A7880" }
        },
        {
            "name": "Python: Exception Types",
            "scope": "support.class.exception.python",
            "settings": { "foreground": "#907008" }
        },
        {
            "name": "Python: f-string placeholders",
            "scope": [
                "meta.fstring.python variable",
                "constant.character.format.placeholder.other.python"
            ],
            "settings": { "foreground": "#3A4C58" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
