        "notifications.background": "#FAF4EA",
        "notificationLink.foreground": "#B46A1F",
        "notificationCenterHeader.foreground": "#2A241F",
        "notificationCenterHeader.background": "#FAF4EA",
        "notificationsErrorIcon.foreground": "#C65A3D",
        "notificationsWarningIcon.foreground": "#B6771E",
        "notificationsInfoIcon.foreground": "#C9892F",
        "quickInput.background": "#FAF4EA",
        "quickInput.foreground": "#2A241F",
        "quickInputList.focusBackground": "#C9892F1A",
        "quickInputList.focusForeground": "#2A241F",
        "quickInputTitle.background": "#FAF4EA",
        "pickerGroup.border": "#FAF4EA",
        "pickerGroup.foreground": "#A19588",
        "peekView.border": "#C9892F",
        "peekViewEditor.background": "#FFFCF6",
        "peekViewResult.background": "#FAF4EA",
        "peekViewTitle.background": "#FAF4EA",
        "peekViewResult.selectionBackground": "#C9892F1A",
        "peekViewTitleDescription.foreground": "#7B6F63",
        "peekViewTitleLabel.foreground": "#2A241F",
        "dropdown.background": "#FAF4EA",
        "dropdown.listBackground": "#FAF4EA",
        "dropdown.border": "#FAF4EA",
        "dropdown.foreground": "#2A241F",
        "menu.background": "#FAF4EA",
        "menu.foreground": "#2A241F",
        "menu.selectionBackground": "#C9892F1A",
        "menu.separatorBackground": "#EFE4D8",
        "menubar.selectionBackground": "#E8DED2",
        "badge.background": "#C9892F",
        "badge.foreground": "#FFFDF9",
        "terminal.background": "#FFFCF6",
        "terminal.foreground": "#5A5048",
        "terminal.selectionBackground": "#C9892F33",
        "terminal.ansiBlack": "#5A5048",
        "terminal.ansiRed": "#B8553E",
        "terminal.ansiGreen": "#6D8740",
        "terminal.ansiYellow": "#B6771E",
        "terminal.ansiBlue": "#A65C2F",
        "terminal.ansiMagenta": "#8B5FBF",
        "terminal.ansiCyan": "#2F8A83",
        "terminal.ansiWhite": "#F8F2E8",
        "editorWidget.background": "#FAF4EA",
        "editorWidget.border": "#FAF4EA"
    },
    "semanticTokenColors": {
        "namespace": "#4A7A2A",
        "module": "#4A7A2A",
        "variable": "#484038",
        "variable.readonly": "#484038",
        "parameter": { "foreground": "#484038", "fontStyle": "italic" },
        "property": "#0A7868",
        "function": "#2A60B0",
        "function.defaultLibrary": {
            "foreground": "#2A60B0",
            "fontStyle": "italic"
        },
        "method": "#2A60B0",
        "method.defaultLibrary": {
            "foreground": "#2A60B0",
            "fontStyle": "italic"
        },
        "class": "#907008",
        "type": "#907008",
        "typeParameter": "#907008",
        "decorator": "#AA6020",
        "selfParameter:python": {
            "foreground": "#C03028",
            "fontStyle": "italic"
        },
        "clsParameter:python": {
            "foreground": "#C03028",
            "fontStyle": "italic"
        }
    },
    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#887A70", "fontStyle": "italic" }
        },
        {
            "name": "Strings",
            "scope": ["string", "punctuation.definition.string"],
            "settings": { "foreground": "#4A7A2A" }
        },
        {
            "name": "Numbers & Constants",
            "scope": [
                "constant.numeric",
                "constant.language",
                "constant.character",
                "constant.other"
            ],
            "settings": { "foreground": "#AA6020" }
        },
        {
            "name": "Keywords & Storage",
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#C03028" }
        },
        {
            "name": "Operators",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#7A7068" }
        },
        {
            "name": "Functions & Methods",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call"
            ],
            "settings": { "foreground": "#2A60B0" }
        },
        {
            "name": "Classes, Types & Inheritance",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.class",
                "support.type",
                "entity.other.inherited-class"
            ],
            "settings": { "foreground": "#907008" }
        },
        {
            "name": "Variables & Parameters",
            "scope": [
                "variable",
                "meta.definition.variable",
                "support.variable",
                "entity.name.variable"
            ],
            "settings": { "foreground": "#484038" }
        },
        {
            "name": "Function Parameters (Italic)",
            "scope": "variable.parameter",
            "settings": { "foreground": "#484038", "fontStyle": "italic" }
        },
        {
            "name": "Object Properties",
            "scope": ["variable.other.property", "support.type.property-name"],
            "settings": { "foreground": "#0A7868" }
        },
        {
            "name": "Punctuation",
            "scope": "punctuation",
            "settings": { "foreground": "#7A7068" }
        },
        {
            "name": "Object Literal Keys",
            "scope": "meta.object-literal.key",
            "settings": { "foreground": "#0A7868" }
        },
        {
            "name": "HTML/XML Tags",
            "scope": ["entity.name.tag", "punctuation.definition.tag"],
            "settings": { "foreground": "#C03028" }
        },
        {
            "name": "HTML/XML Attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#907008" }
        },
        {
            "name": "Regular Expressions",
            "scope": "string.regexp",
            "settings": { "foreground": "#AA6020" }
        },
        {
            "name": "CSS: Selectors",
            "scope": [
                "entity.name.tag.css",
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css",
                "meta.selector.css"
            ],
            "settings": { "foreground": "#C03028" }
        },
        {
            "name": "CSS: Property Names",
            "scope": "support.type.property-name.css",
            "settings": { "foreground": "#0A7868" }
        },
        {
            "name": "CSS: Property Values",
            "scope": [
                "support.constant.property-value.css",
                "keyword.other.unit.css"
            ],
            "settings": { "foreground": "#AA6020" }
        },
        {
            "name": "Vue: Directives",
            "scope": "entity.other.attribute-name.html.vue",
            "settings": { "foreground": "#C03028" }
        },
        {
            "name": "Vue: Component Tags",
            "scope": "support.class.component.html.vue",
            "settings": { "foreground": "#907008" }
        },
        {
            "name": "Decorators (Annotations)",
            "scope": [
                "meta.decorator punctuation.decorator",
                "meta.decorator entity.name.function",
                "meta.decorator entity.name.type",
                "meta.decorator variable.other.object"
            ],
            "settings": { "foreground": "#AA6020" }
        },
        {
            "name": "Markdown: Headings",
            "scope": "markup.heading.markdown",
            "settings": { "foreground": "#2A60B0" }
        },
        {
            "name": "Markdown: Links",
            "scope": [
                "markup.underline.link.markdown",
                "string.other.link.title.markdown"
            ],
            "settings": { "foreground": "#4A7A2A" }
        },
        {
            "name": "Markdown: Bold",
            "scope": "markup.bold.markdown",
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Markdown: Italic",
            "scope": "markup.italic.markdown",
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "Markdown: Code",
            "scope": [
                "markup.inline.raw.string.markdown",
                "markup.fenced_code.block.markdown"
            ],
            "settings": { "foreground": "#7A7068" }
        },
        {
            "name": "Invalid",
            "scope": "invalid",
            "settings": { "foreground": "#C05840" }
        },
        {
            "name": "Python: Import Module Names",
            "scope": [
                "entity.name.namespace.wildcard.python",
                "meta.statement.import.python entity.name.module.python",
                "support.other.module.python"
            ],
            "settings": { "foreground": "#4A7A2A" }
        },
        {
            "name": "Python: Built-in Functions",
            "scope": ["support.function.builtin.python"],
            "settings": { "foreground": "#2A60B0", "fontStyle": "italic" }
        },
        {
            "name": "Python: Magic Methods",
            "scope": ["support.function.magic.python"],
            "settings": { "foreground": "#2A60B0", "fontStyle": "italic" }
        },
        {
            "name": "Python: Built-in Types",
            "scope": "support.type.python",
            "settings": { "foreground": "#907008" }
        },
        {
            "name": "Python: self / cls Parameters",
            "scope": [
                "variable.parameter.function.language.special.self.python",
                "variable.parameter.function.language.special.cls.python"
            ],
            "settings": { "foreground": "#C03028", "fontStyle": "italic" }
        },
        {
            "name": "Python: Decorator Names",
            "scope": [
                "entity.name.function.decorator.python",
                "punctuation.definition.decorator.python"
            ],
            "settings": { "foreground": "#AA6020" }
        },
        {
            "name": "Python: Magic Variables",
            "scope": "support.variable.magic.python",
            "settings": { "foreground": "#0A7868" }
        },
        {
            "name": "Python: Exception Types",
            "scope": "support.class.exception.python",
            "settings": { "foreground": "#907008" }
        },
        {
            "name": "Python: f-string placeholders",
            "scope": [
                "meta.fstring.python variable",
                "constant.character.format.placeholder.other.python"
            ],
            "settings": { "foreground": "#484038" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
