        "notifications": "#7B56C2",
        "notifications.foreground": "#7B56C2",
        "notifications.background": "#F2EFFA",
        "notificationLink.foreground": "#7B56C2",
        "notificationCenterHeader.foreground": "#241F2D",
        "notificationCenterHeader.background": "#F2EFFA",
        "notificationsErrorIcon.foreground": "#C55C74",
        "notificationsWarningIcon.foreground": "#B38347",
        "notificationsInfoIcon.foreground": "#8D63C9",
        "quickInput.background": "#F2EFFA",
        "quickInput.foreground": "#241F2D",
        "quickInputList.focusBackground": "#8D63C91A",
        "quickInputList.focusForeground": "#241F2D",
        "quickInputTitle.background": "#F2EFFA",
        "pickerGroup.border": "#F2EFFA",
        "pickerGroup.foreground": "#9E97AC",
        "peekView.border": "#8D63C9",
        "peekViewEditor.background": "#FCFAFF",
        "peekViewResult.background": "#F2EFFA",
        "peekViewTitle.background": "#F2EFFA",
        "peekViewResult.selectionBackground": "#8D63C91A",
        "peekViewTitleDescription.foreground": "#6E667D",
        "peekViewTitleLabel.foreground": "#241F2D",
        "dropdown.background": "#F2EFFA",
        "dropdown.listBackground": "#F2EFFA",
        "dropdown.border": "#F2EFFA",
        "dropdown.foreground": "#241F2D",
        "menu.background": "#F2EFFA",
        "menu.foreground": "#241F2D",
        "menu.selectionBackground": "#8D63C91A",
        "menu.separatorBackground": "#E3DDF0",
        "menubar.selectionBackground": "#E9E3F2",
        "badge.background": "#8D63C9",
        "badge.foreground": "#FFFFFF",
        "terminal.background": "#FCFAFF",
        "terminal.foreground": "#554E63",
        "terminal.selectionBackground": "#8D63C933",
        "terminal.ansiBlack": "#554E63",
        "terminal.ansiRed": "#B85A70",
        "terminal.ansiGreen": "#6E9B5D",
        "terminal.ansiYellow": "#B38347",
        "terminal.ansiBlue": "#7B56C2",
        "terminal.ansiMagenta": "#A76AE1",
        "terminal.ansiCyan": "#2F8A86",
        "terminal.ansiWhite": "#FAF7FD",
        "editorWidget.background": "#F2EFFA",
        "editorWidget.border": "#F2EFFA"
    },
    "semanticTokenColors": {
        "namespace": "#3A7A38",
        "module": "#3A7A38",
        "variable": "#403850",
        "variable.readonly": "#403850",
        "parameter": { "foreground": "#403850", "fontStyle": "italic" },
        "property": "#0A7870",
        "function": "#2A58B8",
        "function.defaultLibrary": {
            "foreground": "#2A58B8",
            "fontStyle": "italic"
        },
        "method": "#2A58B8",
        "method.defaultLibrary": {
            "foreground": "#2A58B8",
            "fontStyle": "italic"
        },
        "class": "#907210",
        "type": "#907210",
        "typeParameter": "#907210",
        "decorator": "#A06840",
        "selfParameter:python": {
            "foreground": "#A83068",
            "fontStyle": "italic"
        },
        "clsParameter:python": {
            "foreground": "#A83068",
            "fontStyle": "italic"
        }
    },
    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#7A6E80", "fontStyle": "italic" }
        },
        {
            "name": "Strings",
            "scope": ["string", "punctuation.definition.string"],
            "settings": { "foreground": "#3A7A38" }
        },
        {
            "name": "Numbers & Constants",
            "scope": [
                "constant.numeric",
                "constant.language",
                "constant.character",
                "constant.other"
            ],
            "settings": { "foreground": "#A06840" }
        },
        {
            "name": "Keywords & Storage",
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#A83068" }
        },
        {
            "name": "Operators",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#786878" }
        },
        {
            "name": "Functions & Methods",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call"
            ],
            "settings": { "foreground": "#2A58B8" }
        },
        {
            "name": "Classes, Types & Inheritance",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.class",
                "support.type",
                "entity.other.inherited-class"
            ],
            "settings": { "foreground": "#907210" }
        },
        {
            "name": "Variables & Parameters",
            "scope": [
                "variable",
                "meta.definition.variable",
                "support.variable",
                "entity.name.variable"
            ],
            "settings": { "foreground": "#403850" }
        },
        {
            "name": "Function Parameters (Italic)",
            "scope": "variable.parameter",
            "settings": { "foreground": "#403850", "fontStyle": "italic" }
        },
        {
            "name": "Object Properties",
            "scope": ["variable.other.property", "support.type.property-name"],
            "settings": { "foreground": "#0A7870" }
        },
        {
            "name": "Punctuation",
            "scope": "punctuation",
            "settings": { "foreground": "#786878" }
        },
        {
            "name": "Object Literal Keys",
            "scope": "meta.object-literal.key",
            "settings": { "foreground": "#0A7870" }
        },
        {
            "name": "HTML/XML Tags",
            "scope": ["entity.name.tag", "punctuation.definition.tag"],
            "settings": { "foreground": "#A83068" }
        },
        {
            "name": "HTML/XML Attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#907210" }
        },
        {
            "name": "Regular Expressions",
            "scope": "string.regexp",
            "settings": { "foreground": "#A06840" }
        },
        {
            "name": "CSS: Selectors",
            "scope": [
                "entity.name.tag.css",
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css",
                "meta.selector.css"
            ],
            "settings": { "foreground": "#A83068" }
        },
        {
            "name": "CSS: Property Names",
            "scope": "support.type.property-name.css",
            "settings": { "foreground": "#0A7870" }
        },
        {
            "name": "CSS: Property Values",
            "scope": [
                "support.constant.property-value.css",
                "keyword.other.unit.css"
            ],
            "settings": { "foreground": "#A06840" }
        },
        {
            "name": "Vue: Directives",
            "scope": "entity.other.attribute-name.html.vue",
            "settings": { "foreground": "#A83068" }
        },
        {
            "name": "Vue: Component Tags",
            "scope": "support.class.component.html.vue",
            "settings": { "foreground": "#907210" }
        },
        {
            "name": "Decorators (Annotations)",
            "scope": [
                "meta.decorator punctuation.decorator",
                "meta.decorator entity.name.function",
                "meta.decorator entity.name.type",
                "meta.decorator variable.other.object"
            ],
            "settings": { "foreground": "#A06840" }
        },
        {
            "name": "Markdown: Headings",
            "scope": "markup.heading.markdown",
            "settings": { "foreground": "#2A58B8" }
        },
        {
            "name": "Markdown: Links",
            "scope": [
                "markup.underline.link.markdown",
                "string.other.link.title.markdown"
            ],
            "settings": { "foreground": "#3A7A38" }
        },
        {
            "name": "Markdown: Bold",
            "scope": "markup.bold.markdown",
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Markdown: Italic",
            "scope": "markup.italic.markdown",
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "Markdown: Code",
            "scope": [
                "markup.inline.raw.string.markdown",
                "markup.fenced_code.block.markdown"
            ],
            "settings": { "foreground": "#786878" }
        },
        {
            "name": "Invalid",
            "scope": "invalid",
            "settings": { "foreground": "#B84858" }
        },
        {
            "name": "Python: Import Module Names",
            "scope": [
                "entity.name.namespace.wildcard.python",
                "meta.statement.import.python entity.name.module.python",
                "support.other.module.python"
            ],
            "settings": { "foreground": "#3A7A38" }
        },
        {
            "name": "Python: Built-in Functions",
            "scope": ["support.function.builtin.python"],
            "settings": { "foreground": "#2A58B8", "fontStyle": "italic" }
        },
        {
            "name": "Python: Magic Methods",
            "scope": ["support.function.magic.python"],
            "settings": { "foreground": "#2A58B8", "fontStyle": "italic" }
        },
        {
            "name": "Python: Built-in Types",
            "scope": "support.type.python",
            "settings": { "foreground": "#907210" }
        },
        {
            "name": "Python: self / cls Parameters",
            "scope": [
                "variable.parameter.function.language.special.self.python",
                "variable.parameter.function.language.special.cls.python"
            ],
            "settings": { "foreground": "#A83068", "fontStyle": "italic" }
        },
        {
            "name": "Python: Decorator Names",
            "scope": [
                "entity.name.function.decorator.python",
                "punctuation.definition.decorator.python"
            ],
            "settings": { "foreground": "#A06840" }
        },
        {
            "name": "Python: Magic Variables",
            "scope": "support.variable.magic.python",
            "settings": { "foreground": "#0A7870" }
        },
        {
            "name": "Python: Exception Types",
            "scope": "support.class.exception.python",
            "settings": { "foreground": "#907210" }
        },
        {
            "name": "Python: f-string placeholders",
            "scope": [
                "meta.fstring.python variable",
                "constant.character.format.placeholder.other.python"
            ],
            "settings": { "foreground": "#403850" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
