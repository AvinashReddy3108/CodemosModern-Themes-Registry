        "textLink.foreground": "#7B56C2",
        "textCodeBlock.background": "#EAE4F7",
        "textSeparator.foreground": "#E9E3F2",
        "scrollbar.shadow": "#00000000",
        "scrollbarSlider.background": "#C1B7D080",
        "scrollbarSlider.hoverBackground": "#B0A5C0B0",
