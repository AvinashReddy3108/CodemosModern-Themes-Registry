        "notificationToast.border": "#20242A",
        "notificationToast.background": "#1A1D22",
        "notifications.foreground": "#E6E8EB",
        "notifications.background": "#1A1D22",
        "notificationLink.foreground": "#4C9FFF",
        "notificationCenterHeader.foreground": "#E6E8EB",
        "notificationCenterHeader.background": "#15181C",
        "notificationsErrorIcon.foreground": "#FF6B6B",
        "notificationsWarningIcon.foreground": "#E6A23C",
        "notificationsInfoIcon.foreground": "#4C9FFF",
        "quickInput.background": "#1A1D22",
        "quickInput.foreground": "#E6E8EB",
        "quickInputList.focusBackground": "#4C9FFF22",
        "quickInputList.focusForeground": "#E6E8EB",
        "quickInputTitle.background": "#15181C",
        "pickerGroup.border": "#15181C",
        "pickerGroup.foreground": "#7E8794",
        "peekView.border": "#4C9FFF",
        "peekViewEditor.background": "#111315",
        "peekViewResult.background": "#15181C",
        "peekViewTitle.background": "#15181C",
        "peekViewResult.selectionBackground": "#4C9FFF22",
        "peekViewTitleDescription.foreground": "#A7B0BC",
        "peekViewTitleLabel.foreground": "#E6E8EB",
        "dropdown.background": "#1A1D22",
        "dropdown.listBackground": "#1A1D22",
        "dropdown.border": "#20242A",
        "dropdown.foreground": "#E6E8EB",
        "menu.background": "#1A1D22",
        "menu.foreground": "#E6E8EB",
        "menu.selectionBackground": "#4C9FFF22",
        "menu.separatorBackground": "#20242A",
        "menubar.selectionBackground": "#20242A",
        "badge.background": "#4C9FFF",
        "badge.foreground": "#111315",
        "terminal.background": "#111315",
        "terminal.foreground": "#E6E8EB",
        "terminal.selectionBackground": "#4C9FFF33",
        "terminal.ansiBlack": "#0E1012",
        "terminal.ansiRed": "#FF6B6B",
        "terminal.ansiGreen": "#4CB782",
        "terminal.ansiYellow": "#E6A23C",
        "terminal.ansiBlue": "#4C9FFF",
        "terminal.ansiMagenta": "#B18AFF",
        "terminal.ansiCyan": "#5EC8C3",
        "terminal.ansiWhite": "#E6E8EB",
        "editorWidget.background": "#1A1D22",
        "editorWidget.border": "#20242A"
    },
    "semanticTokenColors": {
        "namespace": "#98D4A6",
        "module": "#98D4A6",
        "variable": "#C0CDD8",
        "variable.readonly": "#C0CDD8",
        "parameter": { "foreground": "#C0CDD8", "fontStyle": "italic" },
        "property": "#56C8C4",
        "function": "#6CB6FF",
        "function.defaultLibrary": {
            "foreground": "#6CB6FF",
            "fontStyle": "italic"
        },
        "method": "#6CB6FF",
        "method.defaultLibrary": {
            "foreground": "#6CB6FF",
            "fontStyle": "italic"
        },
        "class": "#E5C07B",
        "type": "#E5C07B",
        "typeParameter": "#E5C07B",
        "decorator": "#E89A6C",
        "selfParameter:python": {
            "foreground": "#E06C8C",
            "fontStyle": "italic"
        },
        "clsParameter:python": {
            "foreground": "#E06C8C",
            "fontStyle": "italic"
        }
    },
    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#5C6B7A", "fontStyle": "italic" }
        },
        {
            "name": "Strings",
            "scope": ["string", "punctuation.definition.string"],
            "settings": { "foreground": "#98D4A6" }
        },
        {
            "name": "Numbers & Constants",
            "scope": [
                "constant.numeric",
                "constant.language",
                "constant.character",
                "constant.other"
            ],
            "settings": { "foreground": "#E89A6C" }
        },
        {
            "name": "Keywords & Storage",
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#E06C8C" }
        },
        {
            "name": "Operators",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#7A8494" }
        },
        {
            "name": "Functions & Methods",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call"
            ],
            "settings": { "foreground": "#6CB6FF" }
        },
        {
            "name": "Classes, Types & Inheritance",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.class",
                "support.type",
                "entity.other.inherited-class"
            ],
            "settings": { "foreground": "#E5C07B" }
        },
        {
            "name": "Variables & Parameters",
            "scope": [
                "variable",
                "meta.definition.variable",
                "support.variable",
                "entity.name.variable"
            ],
            "settings": { "foreground": "#C0CDD8" }
        },
        {
            "name": "Function Parameters (Italic)",
            "scope": "variable.parameter",
            "settings": { "foreground": "#C0CDD8", "fontStyle": "italic" }
        },
        {
            "name": "Object Properties",
            "scope": ["variable.other.property", "support.type.property-name"],
            "settings": { "foreground": "#56C8C4" }
        },
        {
            "name": "Punctuation",
            "scope": "punctuation",
            "settings": { "foreground": "#7A8494" }
        },
        {
            "name": "Object Literal Keys",
            "scope": "meta.object-literal.key",
            "settings": { "foreground": "#56C8C4" }
        },
        {
            "name": "HTML/XML Tags",
            "scope": ["entity.name.tag", "punctuation.definition.tag"],
            "settings": { "foreground": "#E06C8C" }
        },
        {
            "name": "HTML/XML Attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#E5C07B" }
        },
        {
            "name": "Regular Expressions",
            "scope": "string.regexp",
            "settings": { "foreground": "#E89A6C" }
        },
        {
            "name": "CSS: Selectors",
            "scope": [
                "entity.name.tag.css",
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css",
                "meta.selector.css"
            ],
            "settings": { "foreground": "#E06C8C" }
        },
        {
            "name": "CSS: Property Names",
            "scope": "support.type.property-name.css",
            "settings": { "foreground": "#56C8C4" }
        },
        {
            "name": "CSS: Property Values",
            "scope": [
                "support.constant.property-value.css",
                "keyword.other.unit.css"
            ],
            "settings": { "foreground": "#E89A6C" }
        },
        {
            "name": "Vue: Directives",
            "scope": "entity.other.attribute-name.html.vue",
            "settings": { "foreground": "#E06C8C" }
        },
        {
            "name": "Vue: Component Tags",
            "scope": "support.class.component.html.vue",
            "settings": { "foreground": "#E5C07B" }
        },
        {
            "name": "Decorators (Annotations)",
            "scope": [
                "meta.decorator punctuation.decorator",
                "meta.decorator entity.name.function",
                "meta.decorator entity.name.type",
                "meta.decorator variable.other.object"
            ],
            "settings": { "foreground": "#E89A6C" }
        },
        {
            "name": "Markdown: Headings",
            "scope": "markup.heading.markdown",
            "settings": { "foreground": "#6CB6FF" }
        },
        {
            "name": "Markdown: Links",
            "scope": [
                "markup.underline.link.markdown",
                "string.other.link.title.markdown"
            ],
            "settings": { "foreground": "#98D4A6" }
        },
        {
            "name": "Markdown: Bold",
            "scope": "markup.bold.markdown",
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Markdown: Italic",
            "scope": "markup.italic.markdown",
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "Markdown: Code",
            "scope": [
                "markup.inline.raw.string.markdown",
                "markup.fenced_code.block.markdown"
            ],
            "settings": { "foreground": "#7A8494" }
        },
        {
            "name": "Invalid",
            "scope": "invalid",
            "settings": { "foreground": "#FF6B6B" }
        },
        {
            "name": "Python: Import Module Names",
            "scope": [
                "entity.name.namespace.wildcard.python",
                "meta.statement.import.python entity.name.module.python",
                "support.other.module.python"
            ],
            "settings": { "foreground": "#98D4A6" }
        },
        {
            "name": "Python: Built-in Functions",
            "scope": ["support.function.builtin.python"],
            "settings": { "foreground": "#6CB6FF", "fontStyle": "italic" }
        },
        {
            "name": "Python: Magic Methods",
            "scope": ["support.function.magic.python"],
            "settings": { "foreground": "#6CB6FF", "fontStyle": "italic" }
        },
        {
            "name": "Python: Built-in Types",
            "scope": "support.type.python",
            "settings": { "foreground": "#E5C07B" }
        },
        {
            "name": "Python: self / cls Parameters",
            "scope": [
                "variable.parameter.function.language.special.self.python",
                "variable.parameter.function.language.special.cls.python"
            ],
            "settings": { "foreground": "#E06C8C", "fontStyle": "italic" }
        },
        {
            "name": "Python: Decorator Names",
            "scope": [
                "entity.name.function.decorator.python",
                "punctuation.definition.decorator.python"
            ],
            "settings": { "foreground": "#E89A6C" }
        },
        {
            "name": "Python: Magic Variables",
            "scope": "support.variable.magic.python",
            "settings": { "foreground": "#56C8C4" }
        },
        {
            "name": "Python: Exception Types",
            "scope": "support.class.exception.python",
            "settings": { "foreground": "#E5C07B" }
        },
        {
            "name": "Python: f-string placeholders",
            "scope": [
                "meta.fstring.python variable",
                "constant.character.format.placeholder.other.python"
            ],
            "settings": { "foreground": "#C0CDD8" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
