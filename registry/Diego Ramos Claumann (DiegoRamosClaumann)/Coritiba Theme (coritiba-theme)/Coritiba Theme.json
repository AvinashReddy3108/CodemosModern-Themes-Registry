{
    "name": "Coritiba Theme",
    "type": "dark",
    "colors": {
        "editor.background": "#0d2818",
        "editor.foreground": "#e8f5e9",
        "editor.lineHighlightBackground": "#1a4028",
        "editor.selectionBackground": "#2e7d4e80",
        "editor.inactiveSelectionBackground": "#00000000",
        "sideBar.background": "#00593f",
        "sideBar.foreground": "#ffffff",
        "sideBar.border": "#00452f",
        "activityBar.background": "#003d2b",
        "activityBar.foreground": "#ffffff",
        "activityBar.border": "#00593f",
        "activityBar.activeBorder": "#4caf50",
        "activityBar.activeBackground": "#00593f",
        "statusBar.background": "#00593f",
        "statusBar.foreground": "#ffffff",
        "statusBar.noFolderBackground": "#003d2b",
        "statusBar.debuggingBackground": "#2e7d4e",
        "titleBar.activeBackground": "#003d2b",
        "titleBar.activeForeground": "#ffffff",
        "titleBar.inactiveBackground": "#002d21",
        "titleBar.inactiveForeground": "#a5d6a7",
        "tab.activeBackground": "#0d2818",
        "tab.inactiveBackground": "#003d2b",
        "tab.activeForeground": "#ffffff",
        "tab.inactiveForeground": "#a5d6a7",
        "tab.border": "#00452f",
        "tab.activeBorder": "#4caf50",
        "terminal.background": "#0d2818",
        "terminal.foreground": "#e8f5e9",
        "panel.background": "#0d2818",
        "panel.border": "#00452f"
    },
    "tokenColors": [
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#6A9955", "fontStyle": "italic" }
        },
        {
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#569CD6" }
        },
        {
            "scope": ["keyword.control"],
            "settings": { "foreground": "#C586C0" }
        },
        {
            "scope": ["string", "string.quoted"],
            "settings": { "foreground": "#CE9178" }
        },
        {
            "scope": ["variable", "variable.other.readwrite"],
            "settings": { "foreground": "#9CDCFE" }
        },
        {
            "scope": ["variable.other.constant", "variable.other.enummember"],
            "settings": { "foreground": "#4FC1FF" }
        },
        {
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#DCDCAA" }
        },
        {
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.type",
                "support.class"
            ],
            "settings": { "foreground": "#4EC9B0" }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.language.boolean",
                "constant.language.null",
                "constant.language.undefined"
            ],
            "settings": { "foreground": "#B5CEA8" }
        },
        {
            "scope": ["constant.character", "constant.other"],
            "settings": { "foreground": "#4FC1FF" }
        },
        { "scope": ["invalid"], "settings": { "foreground": "#F44747" } },
        {
            "scope": ["markup.heading"],
            "settings": { "foreground": "#569CD6", "fontStyle": "bold" }
        },
        {
            "scope": ["markup.bold"],
            "settings": { "foreground": "#569CD6", "fontStyle": "bold" }
        },
        {
            "scope": ["entity.name.tag", "meta.tag"],
            "settings": { "foreground": "#569CD6" }
        },
        {
            "scope": [
                "entity.other.attribute-name",
                "entity.other.attribute-name.html"
            ],
            "settings": { "foreground": "#9CDCFE" }
        },
        {
            "scope": [
                "meta.tag.structure.any.html",
                "meta.tag.metadata.script.html",
                "meta.tag.metadata.style.html"
            ],
            "settings": { "foreground": "#808080" }
        },
        {
            "scope": ["punctuation.definition.tag"],
            "settings": { "foreground": "#808080" }
        },
        {
            "scope": ["string.quoted.double.html", "string.quoted.single.html"],
            "settings": { "foreground": "#CE9178" }
        },
        {
            "scope": ["variable.other.object.js", "variable.other.object.ts"],
            "settings": { "foreground": "#9CDCFE" }
        },
        {
            "scope": [
                "variable.other.property.js",
                "variable.other.property.ts"
            ],
            "settings": { "foreground": "#9CDCFE" }
        },
        {
            "scope": ["support.class.builtin.js", "support.class.builtin.ts"],
            "settings": { "foreground": "#4EC9B0" }
        },
        {
            "scope": [
                "support.type.object.module.js",
                "support.type.object.module.ts"
            ],
            "settings": { "foreground": "#4EC9B0" }
        },
        {
            "scope": ["storage.type.function.js", "storage.type.function.ts"],
            "settings": { "foreground": "#569CD6" }
        },
        {
            "scope": ["keyword.operator.new.js", "keyword.operator.new.ts"],
            "settings": { "foreground": "#569CD6" }
        },
        {
            "scope": ["storage.type.class.js", "storage.type.class.ts"],
            "settings": { "foreground": "#569CD6" }
        },
        {
            "scope": [
                "variable.language.this.js",
                "variable.language.this.ts",
                "variable.language.super.js",
                "variable.language.super.ts"
            ],
            "settings": { "foreground": "#569CD6" }
        },
        {
            "scope": [
                "meta.type.annotation.ts",
                "meta.type.annotation.tsx",
                "meta.return.type.ts",
                "meta.return.type.tsx"
            ],
            "settings": { "foreground": "#4EC9B0" }
        },
        {
            "scope": [
                "support.type.primitive.ts",
                "support.type.primitive.tsx"
            ],
            "settings": { "foreground": "#4EC9B0" }
        },
        {
            "scope": [
                "keyword.operator.type.ts",
                "keyword.operator.type.tsx",
                "keyword.operator.type.annotation.ts",
                "keyword.operator.type.annotation.tsx"
            ],
            "settings": { "foreground": "#569CD6" }
        },
        {
            "scope": [
                "entity.name.type.interface.ts",
                "entity.name.type.interface.tsx",
                "entity.name.type.alias.ts",
                "entity.name.type.alias.tsx"
            ],
            "settings": { "foreground": "#4EC9B0" }
        },
        {
            "scope": ["support.type.builtin.ts", "support.type.builtin.tsx"],
            "settings": { "foreground": "#4EC9B0" }
        },
        {
            "scope": ["variable.parameter.ts", "variable.parameter.tsx"],
            "settings": { "foreground": "#9CDCFE" }
        },
        {
            "scope": [
                "meta.definition.property.ts",
                "meta.definition.property.tsx",
                "variable.object.property.ts",
                "variable.object.property.tsx"
            ],
            "settings": { "foreground": "#9CDCFE" }
        },
        {
            "scope": [
                "storage.type.function.arrow.ts",
                "storage.type.function.arrow.tsx"
            ],
            "settings": { "foreground": "#569CD6" }
        },
        {
            "scope": [
                "keyword.operator.expression.typeof.ts",
                "keyword.operator.expression.typeof.tsx"
            ],
            "settings": { "foreground": "#569CD6" }
        },
        {
            "scope": [
                "support.variable.property.ts",
                "support.variable.property.tsx"
            ],
            "settings": { "foreground": "#9CDCFE" }
        },
        {
            "scope": ["entity.name.type.ts", "entity.name.type.tsx"],
            "settings": { "foreground": "#4EC9B0" }
        },
        {
            "scope": ["support.type.any.ts", "support.type.any.tsx"],
            "settings": {
                "foreground": "#FF1744",
                "fontStyle": "bold underline"
            }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
