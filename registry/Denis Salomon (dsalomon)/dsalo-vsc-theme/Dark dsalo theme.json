{
    "name": "dsalo theme",
    "colors": {
        "activityBarBadge.background": "#007acc",
        "sideBarTitle.foreground": "#bbbbbb",
        "editorCursor.background": "#000000",
        "editorCursor.foreground": "#FF0B00",
        "editor.background": "#100e0e",
        "editor.foreground": "#ccc",
        "toolbar.hoverBackground": "#ff1d1d",
        "editorLineNumber.foreground": "#00ffea79",
        "sideBar.background": "#111010",
        "sideBar.foreground": "#b4c1cef1",
        "list.hoverForeground": "#99ff14",
        "list.hoverBackground": "#55ff0053",
        "statusBar.background": "#292828bd",
        "statusBar.foreground": "#ffffff",
        "activityBar.background": "#001608ec",
        "activityBar.foreground": "#c8ff00",
        "selection.background": "#ee333349",
        "editor.selectionHighlightBackground": "#5b9ca59f",
        "editor.selectionBackground": "#c721218e",
        "editor.lineHighlightBackground": "#88ff0012",
        "editorIndentGuide.activeBackground": "#00ccff7c",
        "editorIndentGuide.activeBackground1": "#00ccff7c",
        "editorIndentGuide.background": "#4b525131",
        "editorIndentGuide.background1": "#4b525131",
        "scrollbarSlider.background": "#00f7ff7e",
        "editorWidget.border": "#ffffff85",
        "editorWidget.background": "#000000",
        "contrastBorder": "#4745459d"
    },
    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "fontStyle": "italic", "foreground": "#546E7A" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "string constant.other.placeholder"],
            "settings": { "foreground": "#EEFFFF" }
        },
        {
            "name": "Colors",
            "scope": ["constant.other.color"],
            "settings": { "foreground": "#ffffff" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#FF5370" }
        },
        {
            "name": "Keyword, Storage",
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#C792EA" }
        },
        {
            "name": "Operator, Misc",
            "scope": [
                "keyword.control",
                "constant.other.color",
                "meta.tag",
                "punctuation.definition.tag",
                "punctuation.separator.inheritance.php",
                "punctuation.definition.tag.html",
                "punctuation.section.embedded",
                "keyword.other.template",
                "keyword.other.substitution"
            ],
            "settings": { "foreground": "#89DDFF" }
        },
        {
            "name": "Tag",
            "scope": [
                "entity.name.tag",
                "meta.tag.sgml",
                "markup.deleted.git_gutter"
            ],
            "settings": { "foreground": "#f07178" }
        },
        {
            "name": "Function, Special Method",
            "scope": [
                "entity.name.function",
                "meta.function-call",
                "variable.function",
                "support.function",
                "keyword.other.special-method"
            ],
            "settings": { "foreground": "#82AAFF" }
        },
        {
            "name": "Block Level Variables",
            "scope": ["meta.block variable.other"],
            "settings": { "foreground": "#f07178" }
        },
        {
            "name": "Other Variable, String Link",
            "scope": ["support.other.variable", "string.other.link"],
            "settings": { "foreground": "#f07178" }
        },
        {
            "name": "Definition, Access.cpp",
            "scope": ["meta.body.function", "variable.other.object"],
            "settings": { "foreground": "#cbd4c3" }
        },
        {
            "name": "Number, Constant, Function Argument, Tag Attribute, Embedded",
