    "tokenColors": [
        { "scope": "comment", "settings": { "foreground": "#838a46" } },
        { "scope": "string", "settings": { "foreground": "#ddf51b" } },
        {
            "scope": "constant.numeric",
            "settings": { "foreground": "#DE4D3A" }
        },
        {
            "scope": "constant.language",
            "settings": { "foreground": "#507DB7" }
        },
        {
            "scope": ["constant.character", "constant.other"],
            "settings": { "foreground": "#507DB7" }
        },
        { "scope": "variable", "settings": { "fontStyle": "" } },
        { "scope": "keyword", "settings": { "foreground": "#b66615" } },
        {
            "scope": "storage",
            "settings": { "foreground": "#507DB7", "fontStyle": "" }
        },
        {
            "scope": "storage.type",
            "settings": { "foreground": "#ddf51b", "fontStyle": "" }
        },
        {
            "scope": "entity.name.class",
            "settings": { "foreground": "#507DB7", "fontStyle": "underline" }
        },
        {
            "scope": "entity.other.inherited-class",
            "settings": { "foreground": "#507DB7", "fontStyle": "" }
        },
        {
            "scope": "entity.name.function",
            "settings": { "foreground": "#16b32b", "fontStyle": "" }
        },
        {
            "scope": "variable.parameter",
            "settings": { "foreground": "#DCE2E8", "fontStyle": "" }
        },
        {
            "scope": "entity.name.tag",
            "settings": { "foreground": "#9daf14", "fontStyle": "" }
        },
        {
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#507DB7", "fontStyle": "" }
        },
        {
            "scope": "support.function",
            "settings": { "foreground": "#DE4D3A", "fontStyle": "" }
        },
        {
            "scope": "support.constant",
            "settings": { "foreground": "#507DB7", "fontStyle": "" }
        },
        {
            "scope": ["support.type", "support.class"],
            "settings": { "foreground": "#507DB7", "fontStyle": "" }
        },
        { "scope": "support.other.variable", "settings": { "fontStyle": "" } },
        {
            "scope": "invalid",
            "settings": {
                "foreground": "#CF433E",
                "background": "#664E4D",
                "fontStyle": ""
            }
        },
        {
            "scope": "invalid.deprecated",
            "settings": { "foreground": "#CF433E", "background": "#664E4D" }
        },
        {
            "scope": "meta.structure.dictionary.json string.quoted.double.json",
            "settings": { "foreground": "#ddf51b" }
        },
        {
            "scope": ["meta.diff", "meta.diff.header"],
            "settings": { "foreground": "#728496" }
        },
        { "scope": "markup.deleted", "settings": { "foreground": "#E61F44" } },
        { "scope": "markup.inserted", "settings": { "foreground": "#A6E22E" } },
        { "scope": "markup.changed", "settings": { "foreground": "#F7B83D" } },
        {
            "scope": "constant.numeric.line-number.find-in-files - match",
            "settings": { "foreground": "#8FBE00A0" }
        },
        {
            "scope": "entity.name.filename.find-in-files",
            "settings": { "foreground": "#E6DB74" }
        },
        { "scope": "keyword.other", "settings": { "foreground": "#9EAAB7" } },
        {
            "scope": [
                "meta.property-value",
                "support.constant.property-value",
                "constant.other.color"
            ],
            "settings": { "foreground": "#ddf51b" }
        },
        {
            "scope": "meta.structure.dictionary.json string.quoted.double.json",
            "settings": { "foreground": "#507DB7" }
        },
        {
            "scope": "meta.structure.dictionary.value.json string.quoted.double.json",
            "settings": { "foreground": "#ddf51b" }
        },
        {
            "scope": "meta.property-name support.type.property-name",
            "settings": { "fontStyle": "normal" }
        },
        {
            "scope": "meta.property-value punctuation.separator.key-value",
            "settings": { "foreground": "#DCE2E8" }
        },
        {
            "scope": [
                "keyword.other.use",
                "keyword.other.function.use",
                "keyword.other.namespace",
                "keyword.other.new",
                "keyword.other.special-method",
                "keyword.other.unit",
                "keyword.other.use-as"
            ],
            "settings": { "foreground": "#ddf51b" }
        },
        {
            "scope": [
                "meta.use support.class.builtin",
                "meta.other.inherited-class support.class.builtin"
            ],
            "settings": { "foreground": "#ddf51b", "fontStyle": "normal" }
        },
        {
            "scope": "variable.other",
            "settings": { "foreground": "#DCE2E8", "fontStyle": "normal" }
        },
        {
            "scope": "variable.parameter.function.coffee",
            "settings": { "foreground": "#DE4D3A", "fontStyle": "" }
        },
        {
            "scope": "entity.name.section.markdown",
            "settings": { "foreground": "#ddf51b" }
        },
        {
            "scope": "punctuation.definition.heading.markdown",
            "settings": { "foreground": "#B3BECC" }
        },
        {
            "scope": "markup.raw.inline.markdown",
            "settings": { "foreground": "#ddf51b" }
        },
        {
            "scope": [
                "punctuation.definition.bold.markdown",
                "punctuation.definition.italic.markdown"
            ],
            "settings": { "foreground": "#B3BECC" }
        },
        {
            "scope": [
                "punctuation.definition.string.begin.markdown",
                "punctuation.definition.string.end.markdown"
            ],
            "settings": { "foreground": "#B3BECC" }
        },
        {
            "scope": "punctuation.definition.metadata.markdown",
            "settings": { "foreground": "#B3BECC" }
        },
        {
            "scope": [
                "markup.underline.link.markdown",
                "markup.underline.link.image.markdown",
                "meta.image.inline.markdown"
            ],
            "settings": { "foreground": "#7b8913", "fontStyle": "" }
        },
        {
            "scope": ["markup.bold.markdown", "markup.italic.markdown"],
            "settings": { "foreground": "#f0cb1a" }
        },
        {
            "scope": "markup.italic.markdown",
            "settings": { "fontStyle": "italic" }
        },
        {
            "scope": "markup.bold.markdown",
            "settings": { "fontStyle": "bold" }
        },
        {
            "scope": "markup.raw.block.markdown",
            "settings": { "foreground": "#664E4D" }
        },
        {
            "scope": "markup.deleted.git_gutter",
            "settings": { "foreground": "#E61F44" }
        },
        {
            "scope": "markup.inserted.git_gutter",
            "settings": { "foreground": "#A7DA1E" }
        },
        {
            "scope": "markup.changed.git_gutter",
            "settings": { "foreground": "#F7B83D" }
        },
        {
            "scope": "meta.template.expression",
            "settings": { "foreground": "#DCE2E8" }
        },
        {
            "scope": "token.info-token",
            "settings": { "foreground": "#6796E6" }
        },
        {
            "scope": "token.warn-token",
            "settings": { "foreground": "#CD9731" }
        },
        {
            "scope": "token.error-token",
            "settings": { "foreground": "#F44747" }
        },
        {
            "scope": "token.debug-token",
            "settings": { "foreground": "#B267E6" }
        }
    ]
}
