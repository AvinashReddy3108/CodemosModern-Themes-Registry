        "titleBar.inactiveForeground": "#939395",
        "tree.indentGuidesStroke": "#444648B3",
        "widget.border": "#444648B3"
    },
    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#808082", "fontStyle": "italic" }
        },
        {
            "name": "Keywords and storage",
            "scope": [
                "keyword",
                "storage.type",
                "storage.modifier",
                "keyword.operator.expression"
            ],
            "settings": { "foreground": "#9C97B7" }
        },
        {
            "name": "Functions and methods",
            "scope": [
                "entity.name.function",
                "meta.function-call",
                "support.function",
                "variable.function"
            ],
            "settings": { "foreground": "#5E8D87" }
        },
        {
            "name": "Strings",
            "scope": ["string", "constant.other.symbol"],
            "settings": { "foreground": "#88BC7D" }
        },
        {
            "name": "Numbers and constants",
            "scope": [
                "constant",
                "constant.numeric",
                "constant.language",
                "entity.name.constant",
                "variable.other.constant"
            ],
            "settings": { "foreground": "#E1D696" }
        },
        {
            "name": "Types and classes",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "entity.name.interface",
                "support.class",
                "support.type"
            ],
            "settings": { "foreground": "#909CB1" }
        },
        {
            "name": "Properties and attributes",
            "scope": [
                "entity.other.attribute-name",
                "variable.other.property",
                "support.variable.property"
            ],
            "settings": { "foreground": "#AE7499" }
        },
        {
            "name": "Regex and escapes",
            "scope": [
                "constant.character.escape",
                "string.regexp",
                "constant.other.character-class.regexp",
                "constant.character.set.regexp"
            ],
            "settings": { "foreground": "#E1B596" }
        },
        {
            "name": "Links",
            "scope": [
                "markup.underline.link",
                "markup.underline.link.image",
                "meta.link",
                "string.other.link",
                "constant.other.reference.link"
            ],
            "settings": { "foreground": "#86A8A4" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal", "invalid.deprecated"],
            "settings": { "foreground": "#D99198" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "meta.definition.variable.name"],
            "settings": { "foreground": "#d8d6d8" }
        },
        {
            "name": "Punctuation",
            "scope": ["punctuation", "meta.brace"],
            "settings": { "foreground": "#a7a6a8" }
        }
    ],
    "semanticTokenColors": {
        "class": "#909CB1",
        "comment": { "foreground": "#808082", "italic": true },
        "decorator": "#AE7499",
        "enum": "#909CB1",
        "enumMember": "#E1D696",
        "event": "#AE7499",
        "function": "#5E8D87",
        "interface": "#909CB1",
        "keyword": "#9C97B7",
        "macro": "#E1B596",
        "method": "#5E8D87",
        "namespace": "#909CB1",
        "number": "#E1D696",
        "operator": "#9C97B7",
        "parameter": "#d8d6d8",
        "property": "#AE7499",
        "regexp": "#E1B596",
        "string": "#88BC7D",
        "struct": "#909CB1",
        "type": "#909CB1",
        "typeParameter": "#909CB1",
        "variable": "#d8d6d8"
    }
}
