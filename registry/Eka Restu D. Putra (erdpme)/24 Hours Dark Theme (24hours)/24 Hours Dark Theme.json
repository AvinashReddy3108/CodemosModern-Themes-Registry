{
    "name": "24 Hours Dark Theme",
    "type": "dark",
    "colors": {
        "editor.background": "#1B1E1E",
        "editor.foreground": "#d4d4d4",
        "editor.selectionBackground": "#0063c754",
        "activityBar.background": "#1B1E1E",
        "activityBarBadge.background": "#0063C7",
        "activityBar.foreground": "#d4d4d4",
        "sideBar.background": "#1B1E1E",
        "sideBar.border": "#232B2B",
        "sideBarTitle.foreground": "#d4d4d4",
        "sideBar.foreground": "#d4d4d4",
        "button.background": "#0063C7",
        "button.hoverBackground": "#004AAE",
        "button.foreground": "#d4d4d4",
        "dropdown.background": "#232B2B",
        "dropdown.border": "#1B1E1E",
        "dropdown.foreground": "#d4d4d4",
        "input.background": "#1B1E1E",
        "input.foreground": "#6D7072",
        "progressBar.background": "#0063C7",
        "editorGroupHeader.tabsBackground": "#1B1E1E",
        "statusBar.background": "#0063C7",
        "statusBar.noFolderBackground": "#0063C7",
        "statusBar.foreground": "#eceff1",
        "statusBar.noFolderBorder": "#eceff1",
        "statusBar.debuggingBackground": "#2e7d32",
        "statusBar.debuggingForeground": "#eceff1"
    },
    "tokenColors": [
        {
            "name": "Red",
            "scope": [
                "punctuation.definition.tag.begin.html",
                "punctuation.definition.tag.end.html",
                "entity.name.tag.html",
                "entity.name.tag.css",
                "entity.other.attribute-name.class.css",
                "keyword.other.unit.percentage.css",
                "keyword.other.unit.vh.css",
                "keyword.other.unit.px.css",
                "keyword.other.unit.em.css",
                "keyword.other.unit.rem.css",
                "keyword.other.unit.deg.css",
                "entity.other.attribute-name.css",
                "meta.selector.css",
                "entity.other.attribute-name.pseudo-element.css",
                "entity.other.attribute-name.pseudo-class.css",
                "entity.name.function.js",
                "support.function.js",
                "variable.other.property.js"
            ],
            "settings": { "foreground": "#ED3B8A" }
        },
        {
            "name": "Red and Italic",
            "scope": [
                "keyword.control.at-rule.include.scss",
                "keyword.control.at-rule.extend.scss",
                "keyword.other.important.css",
                "keyword.other.important.scss",
                "keyword.control.at-rule.media.css",
                "keyword.control.at-rule.media.scss",
                "keyword.control.at-rule.import.css",
                "keyword.control.at-rule.import.scss",
                "variable.language.this.js",
                "variable.other.object.property.js",
                "markup.fenced_code.block.markdown",
                "keyword.control.at-rule.function.scss",
                "keyword.control.return.scss"
            ],
            "settings": { "fontStyle": "italic", "foreground": "#ED3B8A" }
        },
        {
            "name": "Red and Bold",
            "scope": [
                "keyword.control.conditional.js",
                "entity.name.section.markdown",
                "heading.1.markdown",
                "heading.2.markdown",
                "heading.3.markdown"
            ],
            "settings": { "fontStyle": "bold", "foreground": "#ED3B8A" }
        },
        {
            "name": "Yellow",
            "scope": [
                "entity.name.tag.reference.scss",
                "meta.link.reference.def.markdown"
            ],
            "settings": { "foreground": "#DCDE8C" }
        },
        {
            "name": "Yellow and Italic",
            "scope": [
                "support.type.property-name.css",
                "support.type.vendored.property-name.css"
            ],
            "settings": { "fontStyle": "italic", "foreground": "#DCDE8C" }
        },
        {
            "name": "Yellow and bold",
            "scope": [
                "variable.other.object.js",
                "entity.other.attribute-name.html",
                "punctuation.separator.key-value.html",
                "variable.other.readwrite.js",
                "support.type.property-name.json.comments",
                "support.type.property-name.json"
            ],
            "settings": { "fontStyle": "bold", "foreground": "#DCDE8C" }
        },
        {
            "name": "Green",
            "scope": [
                "string.quoted.double.html",
                "support.constant.property-value.css",
                "meta.property-value.css",
                "constant.numeric.css",
                "variable.scss",
                "constant.other.color.rgb-value.hex.css",
                "constant.other.color.rgb-value.hex.scss",
                "string.quoted.single.js",
                "string.quoted.double.js",
                "constant.numeric.decimal.js",
                "string.quoted.double.json.comments",
                "string.quoted.double.json"
            ],
            "settings": { "foreground": "#34CAA6" }
        },
        {
            "name": "Green and Italic",
            "scope": [
                "string.quoted.double.css",
                "string.quoted.single.css",
                "string.quoted.single.scss",
                "string.quoted.double.scss",
                "entity.other.attribute-name.placeholder.css",
                "meta.at-rule.include.scss",
                "markup.list.numbered.markdown",
                "markup.list.unnumbered.markdown",
                "markup.quote.markdown"
            ],
            "settings": { "fontStyle": "italic", "foreground": "#34CAA6" }
        },
        {
            "name": "Blue",
            "scope": [
                "entity.name.function.scss",
                "support.function.misc.scss",
                "punctuation.section.function.scss",
                "punctuation.definition.parameters.begin.bracket.round.scss",
                "punctuation.definition.parameters.end.bracket.round.scss",
                "support.type.property-name.media.css",
                "support.type.property-name.media.css",
                "meta.image.inline.markdown",
                "meta.link.inline.markdown",
                "meta.at-rule.function.scss"
            ],
            "settings": { "foreground": "#0063C7" }
        },
        {
            "name": "Blue and Italic",
            "scope": ["storage.type.function.js", "storage.type.js"],
            "settings": { "fontStyle": "italic", "foreground": "#0063C7" }
        },
        {
            "name": "Gray and Italic",
            "scope": [
                "comment.block.html",
                "comment.line.scss",
                "comment.block.scss",
                "comment.line.double-slash.js",
                "comment.block.js"
            ],
            "settings": { "fontStyle": "italic", "foreground": "#6e6e6e" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
