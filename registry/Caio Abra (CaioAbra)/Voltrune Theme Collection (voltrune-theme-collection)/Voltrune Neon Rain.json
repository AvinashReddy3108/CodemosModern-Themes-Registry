        "diffEditor.removedTextBackground": "#351A1F66",
        "diffEditor.insertedLineBackground": "#11261D55",
        "diffEditor.removedLineBackground": "#26111655"
    },
    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#5F6976", "fontStyle": "italic" }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "storage",
                "storage.type",
                "storage.modifier",
                "keyword.control",
                "keyword.operator.new"
            ],
            "settings": { "foreground": "#C27AA0" }
        },
        {
            "name": "Strings",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#9CC6AF" }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call",
                "variable.function"
            ],
            "settings": { "foreground": "#66B9C7" }
        },
        {
            "name": "Numbers and Constants",
            "scope": [
                "constant.numeric",
                "constant.language.boolean",
                "constant.language",
                "constant.character.escape"
            ],
            "settings": { "foreground": "#D9A35B" }
        },
        {
            "name": "Types and Classes",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.class",
                "support.type"
            ],
            "settings": { "foreground": "#7EAED9" }
        },
        {
            "name": "Variables",
            "scope": [
                "variable",
                "meta.definition.variable",
                "entity.name.variable"
            ],
            "settings": { "foreground": "#E4EBF3" }
        },
        {
            "name": "Parameters",
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#C6D2DE" }
        },
        {
            "name": "Properties and Keys",
            "scope": [
                "variable.other.property",
                "meta.object-literal.key",
                "support.variable.property",
                "entity.other.attribute-name",
                "support.type.property-name.json",
                "meta.object-literal.key.json"
            ],
            "settings": { "foreground": "#CFA46A" }
        },
        {
            "name": "Decorators",
            "scope": ["meta.decorator", "entity.name.function.decorator"],
            "settings": { "foreground": "#D28AB0" }
        },
        {
            "name": "HTML Tags",
            "scope": ["entity.name.tag", "meta.tag"],
            "settings": { "foreground": "#66B9C7" }
        },
        {
            "name": "CSS Selectors",
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css",
                "entity.name.tag.css"
            ],
            "settings": { "foreground": "#7EAED9" }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "variable": "#E4EBF3",
        "variable.readonly": "#E7B875",
        "parameter": "#C6D2DE",
        "property": "#CFA46A",
        "property.readonly": "#DDB06F",
        "function": "#66B9C7",
        "method": "#66B9C7",
        "class": "#7EAED9",
        "interface": "#7AC9D7",
        "type": "#7EAED9",
        "typeParameter": "#A6C0DC",
        "enum": "#7EAED9",
        "enumMember": "#E7B875",
        "namespace": "#AF8ACF",
        "decorator": "#D28AB0",
        "keyword": "#C27AA0",
        "string": "#9CC6AF",
        "number": "#D9A35B"
    }
}
