    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#705848", "fontStyle": "" }
        },
        {
            "name": "Keyword",
            "scope": ["keyword", "keyword.control", "keyword.other"],
            "settings": { "foreground": "#f5862b", "fontStyle": "" }
        },
        {
            "name": "Keyword Operator",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#cd8269", "fontStyle": "" }
        },
        {
            "name": "Storage",
            "scope": ["storage", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#f5862b", "fontStyle": "" }
        },
        {
            "name": "String",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#18bf9f", "fontStyle": "" }
        },
        {
            "name": "String Escape",
            "scope": ["constant.character.escape"],
            "settings": { "foreground": "#b6c158" }
        },
        {
            "name": "Constant",
            "scope": [
                "constant.numeric",
                "constant.language",
                "constant.character"
            ],
            "settings": { "foreground": "#b6c158", "fontStyle": "" }
        },
        {
            "name": "Function Name",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call"
            ],
            "settings": { "foreground": "#fe968f", "fontStyle": "" }
        },
        {
            "name": "Type",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.type",
                "support.class",
                "entity.other.inherited-class"
            ],
            "settings": { "foreground": "#44aade", "fontStyle": "" }
        },
        {
            "name": "Type Parameter",
            "scope": ["entity.name.type.parameter"],
            "settings": { "foreground": "#44aade" }
        },
        {
            "name": "Variable",
            "scope": ["variable", "variable.other", "variable.parameter"],
            "settings": { "foreground": "#e3d4cb", "fontStyle": "" }
        },
        {
            "name": "Variable Language",
            "scope": ["variable.language"],
            "settings": { "foreground": "#f5862b", "fontStyle": "" }
        },
        {
            "name": "Property",
            "scope": [
                "variable.other.property",
                "variable.other.object.property",
                "support.variable.property",
                "meta.object-literal.key"
            ],
            "settings": { "foreground": "#81c081", "fontStyle": "" }
        },
        {
            "name": "Operator",
            "scope": [
                "keyword.operator.assignment",
                "keyword.operator.arithmetic",
                "keyword.operator.logical"
            ],
            "settings": { "foreground": "#cd8269", "fontStyle": "" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation.definition.block",
                "punctuation.definition.parameters",
                "punctuation.separator",
                "punctuation.terminator",
                "meta.brace"
            ],
            "settings": { "foreground": "#cd8269" }
        },
        {
            "name": "Tag",
            "scope": ["entity.name.tag", "support.class.component"],
            "settings": { "foreground": "#16c1cf", "fontStyle": "" }
        },
        {
            "name": "Tag Attribute",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#81c081", "fontStyle": "" }
        },
        {
            "name": "Tag Punctuation",
            "scope": ["punctuation.definition.tag"],
            "settings": { "foreground": "#cd8269" }
        },
        {
            "name": "CSS Property",
            "scope": [
                "support.type.property-name.css",
                "meta.property-name.css"
            ],
            "settings": { "foreground": "#81c081" }
        },
        {
            "name": "CSS Value",
            "scope": [
                "support.constant.property-value.css",
                "meta.property-value.css"
            ],
            "settings": { "foreground": "#b6c158" }
        },
        {
            "name": "CSS Selector",
            "scope": [
                "entity.name.tag.css",
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css"
            ],
            "settings": { "foreground": "#16c1cf" }
        },
        {
            "name": "JSON Key",
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#81c081" }
        },
        {
            "name": "Markdown Heading",
            "scope": ["markup.heading", "entity.name.section.markdown"],
            "settings": { "foreground": "#f5862b", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Bold",
            "scope": ["markup.bold"],
            "settings": { "foreground": "#e3d4cb", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Italic",
            "scope": ["markup.italic"],
            "settings": { "foreground": "#e3d4cb", "fontStyle": "italic" }
        },
        {
            "name": "Markdown Quote",
            "scope": ["markup.quote"],
            "settings": { "foreground": "#705848", "fontStyle": "italic" }
        },
        {
            "name": "Markdown Code",
            "scope": ["markup.inline.raw", "markup.fenced_code.block"],
            "settings": { "foreground": "#18bf9f" }
        },
        {
            "name": "Markdown Link",
            "scope": ["markup.underline.link"],
            "settings": { "foreground": "#18bf9f" }
        },
        {
            "name": "Markdown List",
            "scope": ["markup.list", "punctuation.definition.list"],
            "settings": { "foreground": "#b6c158" }
        },
        {
            "name": "Regex",
            "scope": ["string.regexp"],
            "settings": { "foreground": "#16c1cf" }
        },
        {
            "name": "Decorator",
            "scope": ["meta.decorator", "punctuation.decorator"],
            "settings": { "foreground": "#fe968f", "fontStyle": "" }
        },
        {
            "name": "Support",
            "scope": ["support.constant", "support.variable"],
            "settings": { "foreground": "#b6c158" }
        },
        {
            "name": "Python Self",
            "scope": [
                "variable.parameter.function.language.special.self.python"
            ],
            "settings": { "foreground": "#f5862b", "fontStyle": "" }
        },
        {
            "name": "Python Magic Method",
            "scope": ["support.function.magic.python"],
            "settings": { "foreground": "#fe968f" }
        },
        {
            "name": "Python Decorator",
            "scope": ["entity.name.function.decorator.python"],
            "settings": { "foreground": "#fe968f", "fontStyle": "" }
        },
        {
            "name": "Python F-String Expression",
            "scope": ["meta.fstring.python"],
            "settings": { "foreground": "#18bf9f" }
        },
        {
            "name": "Go Package",
            "scope": ["entity.name.package.go", "entity.name.import.go"],
            "settings": { "foreground": "#44aade" }
        },
        {
            "name": "Go Builtin",
            "scope": ["support.function.builtin.go"],
            "settings": { "foreground": "#fe968f" }
        },
        {
            "name": "Rust Lifetime",
            "scope": [
                "storage.modifier.lifetime.rust",
                "entity.name.type.lifetime.rust"
            ],
            "settings": { "foreground": "#f5862b", "fontStyle": "" }
        },
        {
            "name": "Rust Macro",
            "scope": ["entity.name.function.macro.rust", "support.macro.rust"],
            "settings": { "foreground": "#fe968f" }
        },
        {
            "name": "Rust Attribute",
            "scope": ["meta.attribute.rust"],
            "settings": { "foreground": "#81c081", "fontStyle": "" }
        },
        {
            "name": "Shell Variable",
            "scope": [
                "variable.other.normal.shell",
                "punctuation.definition.variable.shell"
            ],
            "settings": { "foreground": "#e3d4cb" }
        },
        {
            "name": "Shell Command",
            "scope": ["support.function.builtin.shell"],
            "settings": { "foreground": "#fe968f" }
        },
        {
            "name": "YAML Key",
            "scope": ["entity.name.tag.yaml"],
            "settings": { "foreground": "#81c081" }
        },
        {
            "name": "YAML Anchor",
            "scope": [
                "entity.name.type.anchor.yaml",
                "punctuation.definition.anchor.yaml"
            ],
            "settings": { "foreground": "#b6c158" }
        },
        {
            "name": "TOML Table",
            "scope": [
                "support.type.property-name.table.toml",
                "entity.other.attribute-name.table.toml"
            ],
            "settings": { "foreground": "#44aade" }
        },
        {
            "name": "TOML Key",
            "scope": ["support.type.property-name.toml"],
            "settings": { "foreground": "#81c081" }
        },
        {
            "name": "SQL Keyword",
            "scope": [
                "keyword.other.DML.sql",
                "keyword.other.DDL.sql",
                "keyword.other.sql"
            ],
            "settings": { "foreground": "#f5862b", "fontStyle": "" }
        },
        {
            "name": "GraphQL Type",
            "scope": ["support.type.graphql", "entity.name.fragment.graphql"],
            "settings": { "foreground": "#44aade" }
        },
        {
            "name": "GraphQL Field",
            "scope": ["variable.graphql", "variable.other.graphql"],
            "settings": { "foreground": "#81c081" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": {
                "foreground": "#e3d4cb",
                "fontStyle": "strikethrough"
            }
        }
    ],
    "semanticHighlighting": true,
