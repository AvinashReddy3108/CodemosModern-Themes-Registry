    "name": "mc-dlt",
    "publisher": "steve-down",
    "tokenColors": [
        { "settings": { "foreground": "#bdae9d" } },
        {
            "name": "Other",
            "scope": ["meta.scriptblock.powershell"],
            "settings": { "foreground": "#bdae9d" }
        },
        {
            "name": "Comment",
            "scope": "comment",
            "settings": { "fontStyle": "italic", "foreground": "#a8d5f0b0" }
        },
        {
            "name": "Constant",
            "scope": "constant",
            "settings": { "foreground": "#daae76" }
        },
        {
            "name": "Entity",
            "scope": "entity",
            "settings": { "fontStyle": "", "foreground": "#72c3fc" }
        },
        {
            "name": "Function",
            "scope": [
                "function",
                "support.function.powershell",
                "entity.name.function.powershell"
            ],
            "settings": { "fontStyle": "", "foreground": "#43fafa" }
        },
        {
            "name": "Keyword",
            "scope": "keyword",
            "settings": { "fontStyle": "", "foreground": "#a2cfea" }
        },
        {
            "name": "Storage",
            "scope": "storage",
            "settings": { "fontStyle": "", "foreground": "#a2cfea" }
        },
        {
            "name": "String",
            "scope": ["string", "string.quoted.double.powershell"],
            "settings": { "fontStyle": "", "foreground": "#daae76" }
        },
        {
            "name": "Number",
            "scope": ["Number", "constant.numeric.integer.powershell"],
            "settings": { "fontStyle": "", "foreground": "#daae76" }
        },
        {
            "name": "Support",
            "scope": "support",
            "settings": { "fontStyle": "", "foreground": "#ffffc8" }
        },
        {
            "name": "Variable",
            "scope": ["variable", "support.variable.automatic.powershell"],
            "settings": { "foreground": "#ffffc8" }
        },
        {
            "name": "Invalid – Deprecated",
            "scope": "invalid.deprecated",
            "settings": {
                "fontStyle": "italic underline",
                "foreground": "#f03e3e"
            }
        },
        {
            "name": "Invalid – Illegal",
            "scope": "invalid.illegal",
            "settings": { "foreground": "#a0a0a0" }
        },
        {
            "name": "attribute",
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#a8d5f0" }
        },
        {
            "name": "tag",
            "scope": [
                "entity.name.tag",
                "punctuation.definition.tag.begin",
                "punctuation.definition.tag.end"
            ],
            "settings": { "foreground": "#37A8ED" }
        },
        {
            "name": "css property-value",
            "scope": [
                "meta.property-group support.constant.property-value.css",
                "meta.property-value support.constant.property-value.css"
            ],
            "settings": { "foreground": "#daae76" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
