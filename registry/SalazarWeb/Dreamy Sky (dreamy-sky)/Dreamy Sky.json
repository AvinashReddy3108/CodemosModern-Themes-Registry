{
    "name": "Dreamy Sky",
    "type": "dark",
    "colors": {
        "editor.background": "#1e2433",
        "editor.foreground": "#abb2bf",
        "editor.lineHighlightBackground": "#2c3547",
        "editor.selectionBackground": "#3e4a61",
        "editor.wordHighlightBackground": "#3e4a6166",
        "editorCursor.foreground": "#6cb8ff",
        "editorIndentGuide.background1": "#364059",
        "editor.findMatchBackground": "#4267a2",
        "editor.findMatchHighlightBackground": "#3a538580",
        "activityBar.background": "#1a2030",
        "sideBar.background": "#1a2030",
        "statusBar.background": "#12192a",
        "titleBar.activeBackground": "#12192a"
    },
    "tokenColors": [
        {
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#6cb8ff", "fontStyle": "bold" }
        },
        {
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#56c7df" }
        },
        {
            "scope": [
                "entity.name.type",
                "support.class",
                "storage.type.interface.typescript",
                "storage.type.type.typescript"
            ],
            "settings": { "foreground": "#77a6ff", "fontStyle": "bold" }
        },
        {
            "scope": [
                "variable",
                "variable.other.property",
                "variable.other.object.property"
            ],
            "settings": { "foreground": "#d7dce2" }
        },
        {
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#ffffff", "fontStyle": "italic" }
        },
        {
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#e06c75" }
        },
        {
            "scope": ["constant.numeric", "constant.language"],
            "settings": { "foreground": "#d19a66" }
        },
        {
            "scope": ["string", "punctuation.definition.string"],
            "settings": { "foreground": "#98c379" }
        },
        {
            "scope": [
                "support.constant.property-value.css",
                "support.constant.property-value.scss"
            ],
            "settings": { "foreground": "#98c379" }
        },
        {
            "scope": ["entity.name.tag", "punctuation.definition.tag"],
            "settings": { "foreground": "#c678dd" }
        },
        {
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css"
            ],
            "settings": { "foreground": "#6cb8ff" }
        },
        {
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#d19a66", "fontStyle": "italic" }
        },
        {
            "scope": [
                "support.type.property-name.css",
                "support.type.property-name.scss",
                "support.type.property-name.less"
            ],
            "settings": { "foreground": "#d19a66" }
        },
        {
            "scope": [
                "punctuation.section.embedded.begin.jsx",
                "punctuation.section.embedded.end.jsx"
            ],
            "settings": { "foreground": "#d19a66" }
        },
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#5c6370", "fontStyle": "italic" }
        },
        {
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#e06c75", "fontStyle": "underline" }
        },
        {
            "scope": [
                "meta.import",
                "keyword.control.import",
                "keyword.control.export"
            ],
            "settings": { "foreground": "#c678dd" }
        },
        {
            "scope": ["support.type.property-name"],
            "settings": { "foreground": "#abb2bf" }
        },
        {
            "scope": ["keyword.other.unit"],
            "settings": { "foreground": "#d19a66" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
