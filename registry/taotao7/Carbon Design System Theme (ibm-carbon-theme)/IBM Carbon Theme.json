            "scope": ["source.sass keyword.control"],
            "settings": { "foreground": "#4589ff" }
        },
        {
            "name": "Inserted - Carbon support-success",
            "scope": ["markup.inserted"],
            "settings": { "foreground": "#24a148" }
        },
        {
            "name": "Deleted - Carbon support-error",
