    "tokenColors": [
        {
            "scope": [
                "comment",
                "comment.line",
                "comment.block",
                "punctuation.definition.comment"
            ],
            "settings": { "foreground": "#928374", "fontStyle": "italic" }
        },
        {
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.new",
                "keyword.other",
                "storage.type",
                "storage.modifier"
            ],
            "settings": { "foreground": "#d65d0e" }
        },
        {
            "scope": [
                "entity.name.function",
                "entity.name.method",
                "meta.function-call entity.name.function",
                "support.function"
            ],
            "settings": { "foreground": "#d65d0e" }
        },
        {
            "scope": [
                "entity.name.class",
                "entity.name.type",
                "entity.other.inherited-class",
                "support.class",
                "support.type"
            ],
            "settings": { "foreground": "#b16286" }
        },
        {
            "scope": [
                "variable",
                "variable.parameter",
                "variable.other",
                "meta.definition.variable"
            ],
            "settings": { "foreground": "#2d2a27" }
        },
        {
            "scope": [
                "string",
                "string.quoted",
                "string.quoted.single",
                "string.quoted.double",
                "string.quoted.triple",
                "string.template",
                "string.interpolated"
            ],
            "settings": { "foreground": "#79740e" }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.language",
                "constant.character",
                "constant.other"
            ],
            "settings": { "foreground": "#458588" }
        },
        {
            "scope": ["operator", "keyword.operator"],
            "settings": { "foreground": "#cc241d" }
        },
        {
            "scope": [
                "punctuation",
                "punctuation.separator",
                "punctuation.terminator",
                "punctuation.accessor"
            ],
            "settings": { "foreground": "#2d2a27" }
        },
        {
            "scope": ["invalid", "invalid.illegal", "invalid.deprecated"],
            "settings": { "foreground": "#9d0006", "fontStyle": "underline" }
        },
        {
            "scope": [
                "markup.heading",
                "markup.heading.1",
                "markup.heading.2",
                "markup.heading.3",
                "markup.heading.4",
                "markup.heading.5",
                "markup.heading.6"
            ],
            "settings": { "foreground": "#d65d0e", "fontStyle": "bold" }
        },
        {
            "scope": ["markup.bold"],
            "settings": { "foreground": "#d65d0e", "fontStyle": "bold" }
        },
        {
            "scope": ["markup.italic"],
            "settings": { "foreground": "#b16286", "fontStyle": "italic" }
        },
        {
            "scope": ["markup.link", "markup.underline.link"],
            "settings": { "foreground": "#076678", "fontStyle": "underline" }
        },
        {
            "scope": [
                "markup.inline.raw",
                "markup.fenced_code.block.markdown",
                "markup.code"
            ],
            "settings": { "foreground": "#458588" }
        },
        {
            "scope": [
                "entity.name.tag",
                "entity.name.tag.html",
                "entity.name.tag.xml"
            ],
            "settings": { "foreground": "#cc241d" }
        },
        {
            "scope": [
                "entity.other.attribute-name",
                "entity.other.attribute-name.html",
                "entity.other.attribute-name.xml"
            ],
            "settings": { "foreground": "#d65d0e" }
        },
        {
            "scope": [
                "meta.tag.sgml.doctype",
                "meta.tag.sgml.doctype.html",
                "meta.tag.sgml.doctype.xml"
            ],
            "settings": { "foreground": "#928374" }
        },
        {
            "scope": [
                "support.type.property-name",
                "support.type.property-name.css",
                "support.type.property-name.scss"
            ],
            "settings": { "foreground": "#79740e" }
        },
        {
            "scope": ["constant.other.color", "support.constant.color"],
            "settings": { "foreground": "#458588" }
        },
        {
            "scope": ["entity.name.tag.css", "entity.name.tag.scss"],
            "settings": { "foreground": "#cc241d" }
        },
        {
            "scope": [
                "entity.other.attribute-name.class",
                "entity.other.attribute-name.id"
            ],
            "settings": { "foreground": "#b16286" }
        },
        {
            "scope": ["meta.property-name", "support.type.property-name.json"],
            "settings": { "foreground": "#d65d0e" }
        },
        {
            "scope": ["string.quoted.double.json", "string.quoted.single.json"],
            "settings": { "foreground": "#79740e" }
        },
        {
            "scope": ["constant.numeric.json"],
            "settings": { "foreground": "#458588" }
        },
        { "scope": ["keyword.json"], "settings": { "foreground": "#d65d0e" } },
        {
            "scope": ["storage.type.function", "storage.type.class"],
            "settings": { "foreground": "#b16286" }
        },
        {
            "scope": ["entity.name.namespace", "entity.name.scope-resolution"],
            "settings": { "foreground": "#b16286" }
        },
        {
            "scope": ["meta.decorator", "punctuation.decorator"],
            "settings": { "foreground": "#d65d0e" }
        },
        {
            "scope": ["entity.name.label"],
            "settings": { "foreground": "#458588" }
        },
        {
            "scope": ["markup.deleted"],
            "settings": { "foreground": "#9d0006" }
        },
        {
            "scope": ["markup.inserted"],
            "settings": { "foreground": "#458588" }
        },
        { "scope": ["markup.changed"], "settings": { "foreground": "#d65d0e" } }
    ],
    "$schema": "vscode://schemas/color-theme"
}
