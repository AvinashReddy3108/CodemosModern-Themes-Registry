{
    "name": "Moguji Theme",
    "colors": {
        "editor.background": "#ffffff57",
        "editor.foreground": "#493830",
        "list.activeSelectionIconForeground": "#e5eae400",
        "activityBar.background": "#36532c11",
        "activityBar.foreground": "#979696",
        "activityBar.activeBorder": "#8a9a5b",
        "activityBarBadge.background": "#8a9a5b",
        "activityBarBadge.foreground": "#ffffff",
        "statusBar.background": "#636f4193"
    },
    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "fontStyle": "italic", "foreground": "#b8af95" }
        },
        {
            "name": "Comments: Preprocessor",
            "scope": "comment.block.preprocessor",
            "settings": { "fontStyle": "", "foreground": "#b8af95" }
        },
        {
            "name": "Comments: Documentation",
            "scope": ["comment.documentation", "comment.block.documentation"],
            "settings": { "foreground": "#6e8747" }
        },
        {
            "name": "Docstring",
            "scope": ["string.quoted.docstring", "comment.block.documentation"],
            "settings": { "foreground": "#b8af95", "fontStyle": "italic" }
        },
        {
            "name": "Invalid - Illegal",
            "scope": "invalid.illegal",
            "settings": { "foreground": "#c04000" }
        },
        {
            "name": "Operators",
            "scope": "keyword.operator",
            "settings": { "foreground": "#988558" }
        },
        {
            "name": "Keywords",
            "scope": ["keyword", "storage"],
            "settings": { "foreground": "#5e8fb8" }
        },
        {
            "name": "Types",
            "scope": ["storage.type", "support.type"],
            "settings": { "foreground": "#7a3e9d81" }
        },
        {
            "name": "Language Constants",
            "scope": [
                "constant.language",
                "support.constant",
                "variable.language"
            ],
            "settings": { "foreground": "#AB6526" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "support.variable"],
            "settings": { "foreground": "#9f2b68" }
        },
        {
            "name": "Functions",
            "scope": ["entity.name.function", "support.function"],
            "settings": { "fontStyle": "bold", "foreground": "#001c80df" }
        },
        {
            "name": "Classes",
            "scope": [
                "entity.name.type",
                "entity.other.inherited-class",
                "support.class"
            ],
            "settings": { "fontStyle": "bold", "foreground": "#7A3E9D" }
        },
        {
            "name": "Exceptions",
            "scope": "entity.name.exception",
            "settings": { "foreground": "#660000" }
        },
        {
            "name": "Sections",
            "scope": "entity.name.section",
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Numbers, Characters",
            "scope": ["constant.numeric", "constant.character", "constant"],
            "settings": { "foreground": "#c686a5" }
        },
        {
            "name": "Strings",
            "scope": "string",
            "settings": { "foreground": "#4f8747d3" }
        },
        {
            "name": "Strings: Escape Sequences",
            "scope": "constant.character.escape",
            "settings": { "foreground": "#988558" }
        },
        {
            "name": "Strings: Regular Expressions",
            "scope": "string.regexp",
            "settings": { "foreground": "#008089" }
        },
        {
            "name": "Strings: Symbols",
            "scope": "constant.other.symbol",
            "settings": { "foreground": "#c9a9a6" }
        },
        {
            "name": "Punctuation",
            "scope": "punctuation",
            "settings": { "foreground": "#c2b280" }
        },
        {
            "name": "HTML: Doctype Declaration",
            "scope": [
                "meta.tag.sgml.doctype",
                "meta.tag.sgml.doctype string",
                "meta.tag.sgml.doctype entity.name.tag",
                "meta.tag.sgml punctuation.definition.tag.html"
            ],
            "settings": { "foreground": "#b8af95" }
        },
        {
            "name": "HTML: Tags",
            "scope": [
                "meta.tag",
                "punctuation.definition.tag.html",
                "punctuation.definition.tag.begin.html",
                "punctuation.definition.tag.end.html"
            ],
            "settings": { "foreground": "#91B3E0" }
        },
        {
            "name": "HTML: Tag Names",
            "scope": "entity.name.tag",
            "settings": { "foreground": "#008089" }
        },
        {
            "name": "HTML: Attribute Names",
            "scope": [
                "meta.tag entity.other.attribute-name",
                "entity.other.attribute-name.html"
            ],
            "settings": { "fontStyle": "italic", "foreground": "#9fe2bf" }
        },
        {
            "name": "HTML: Entities",
            "scope": [
                "constant.character.entity",
                "punctuation.definition.entity"
            ],
            "settings": { "foreground": "#c9a9a6" }
        },
        {
            "name": "CSS: Selectors",
            "scope": [
                "meta.selector",
                "meta.selector entity",
                "meta.selector entity punctuation",
                "entity.name.tag.css"
            ],
            "settings": { "foreground": "#aeaefa" }
        },
        {
            "name": "CSS: Property Names",
            "scope": ["meta.property-name", "support.type.property-name"],
            "settings": { "foreground": "#c9a9a6" }
        },
        {
            "name": "CSS: Property Values",
            "scope": [
                "meta.property-value",
                "meta.property-value constant.other",
                "support.constant.property-value"
            ],
            "settings": { "foreground": "#47876d" }
        },
        {
            "name": "CSS: Important Keyword",
            "scope": "keyword.other.important",
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Markup: Changed",
            "scope": "markup.changed",
            "settings": { "foreground": "#000000" }
        },
        {
            "name": "Markup: Deletion",
            "scope": "markup.deleted",
            "settings": { "foreground": "#000000" }
        },
        {
            "name": "Markup: Emphasis",
            "scope": "markup.italic",
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "Markup: Error",
            "scope": "markup.error",
            "settings": { "foreground": "#660000" }
        },
        {
            "name": "Markup: Insertion",
            "scope": "markup.inserted",
            "settings": { "foreground": "#000000" }
        },
        {
            "name": "Markup: Link",
            "scope": "meta.link",
            "settings": { "foreground": "#47876d" }
        },
        {
            "name": "Markup: Output",
            "scope": ["markup.output", "markup.raw"],
            "settings": { "foreground": "#988558" }
        },
        {
            "name": "Markup: Prompt",
            "scope": "markup.prompt",
            "settings": { "foreground": "#988558" }
        },
        {
            "name": "Markup: Heading",
            "scope": "markup.heading",
            "settings": { "foreground": "#c9a9a6" }
        },
        {
            "name": "Markup: Strong",
            "scope": "markup.bold",
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Markup: Traceback",
            "scope": "markup.traceback",
            "settings": { "foreground": "#660000" }
        },
        {
            "name": "Markup: Underline",
            "scope": "markup.underline",
            "settings": { "fontStyle": "underline" }
        },
        {
            "name": "Markup Quote",
            "scope": "markup.quote",
            "settings": { "foreground": "#aeaefa" }
        },
        {
            "name": "Markup Lists",
            "scope": "markup.list",
            "settings": { "foreground": "#47876d" }
        },
        {
            "name": "Markup Styling",
            "scope": ["markup.bold", "markup.italic"],
            "settings": { "foreground": "#47876d" }
        },
        {
            "name": "Markup Inline",
            "scope": "markup.inline.raw",
            "settings": { "fontStyle": "", "foreground": "#c9a9a6" }
        },
        {
            "name": "Extra: Diff Range",
            "scope": ["meta.diff.range", "meta.diff.index", "meta.separator"],
            "settings": { "foreground": "#5c4033" }
        },
        {
            "name": "Extra: Diff From",
            "scope": "meta.diff.header.from-file",
            "settings": { "foreground": "#5c4033" }
        },
        {
            "name": "Extra: Diff To",
            "scope": "meta.diff.header.to-file",
            "settings": { "foreground": "#5c4033" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
