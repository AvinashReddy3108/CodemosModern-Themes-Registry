{
    "tokenColors": [
        {
            "settings": {
                "foreground": "#83898c",
                "findHighlight": "#d7e7fe",
                "findHighlightForeground": "#e7ebed",
                "selectionBorder": "#517b4e"
            }
        },
        {
            "name": "Comment",
            "scope": [
                "punctuation.definition.comment.python",
                "punctuation.definition.comment.js",
                "comment"
            ],
            "settings": { "foreground": "#a0a0a0" }
        },
        {
            "name": "String",
            "scope": [
                "punctuation.definition.string.begin.python",
                "punctuation.definition.string.end.python",
                "string",
                "markup.heading.markdown"
            ],
            "settings": { "foreground": "#728373" }
        },
        {
            "name": "Number",
            "scope": "constant.numeric",
            "settings": { "foreground": "#555555" }
        },
        {
            "name": "User-defined constant",
            "scope": [
                "constant.character",
                "constant.other",
                "meta.paragraph.markdown",
                "other"
            ],
            "settings": { "foreground": "#1f1f1f" }
        },
        {
            "name": "Variable",
            "scope": ["variable", "entity.name.type.js"],
            "settings": { "foreground": "#242824" }
        },
        {
            "name": "Keyword",
            "scope": ["keyword", "storage.modifier.js"],
            "settings": { "foreground": "#688681" }
        },
        {
            "name": "Storage",
            "scope": "storage",
            "settings": { "fontStyle": "", "foreground": "#574c54" }
        },
        {
            "name": "Storage type",
            "scope": ["storage.type"],
            "settings": { "fontStyle": "italic", "foreground": "#326fa1" }
        },
        {
            "name": "Class name",
            "scope": "entity.name.class",
            "settings": { "fontStyle": "underline", "foreground": "#405811" }
        },
        {
            "name": "Inherited class",
            "scope": "entity.other.inherited-class",
            "settings": { "fontStyle": "italic", "foreground": "#858585" }
        },
        {
            "name": "Function name",
            "scope": "entity.name.function",
            "settings": { "fontStyle": "", "foreground": "#5f695f" }
        },
        {
            "name": "Function argument",
            "scope": [
                "variable.parameter",
                "meta.function-call.arguments.python"
            ],
            "settings": { "fontStyle": "italic", "foreground": "#8b4735" }
        },
        {
            "name": "Tag name",
            "scope": ["entity.name.tag", "meta.class.js"],
            "settings": { "fontStyle": "", "foreground": "#3c2c2c" }
        },
        {
            "name": "Tag attribute",
            "scope": "entity.other.attribute-name",
            "settings": { "fontStyle": "", "foreground": "#555555" }
        },
        {
            "name": "Library function",
            "scope": "support.function",
            "settings": { "fontStyle": "", "foreground": "#494949" }
        },
        {
            "name": "Library constant",
            "scope": "support.constant",
            "settings": { "fontStyle": "", "foreground": "#666666" }
        },
        {
            "name": "Library class/type",
            "scope": ["support.type", "support.class"],
            "settings": { "fontStyle": "italic", "foreground": "#352c48" }
        },
        {
            "name": "Library variable",
            "scope": "support.other.variable",
            "settings": { "foreground": "" }
        },
        {
            "name": "Invalid",
            "scope": "invalid",
            "settings": { "fontStyle": "", "foreground": "#942323" }
        },
        {
            "name": "Invalid deprecated",
            "scope": "invalid.deprecated",
            "settings": { "foreground": "#c7c716" }
        },
        {
            "name": "JSON String",
            "scope": "meta.structure.dictionary.json string.quoted.double.json",
            "settings": { "foreground": "#666666" }
        },
        {
            "name": "diff.header",
            "scope": ["meta.diff", "meta.diff.header"],
            "settings": { "foreground": "#75715E" }
        },
        {
            "name": "diff.deleted",
            "scope": "markup.deleted",
            "settings": { "foreground": "#F92672" }
        },
        {
            "name": "diff.inserted",
            "scope": "markup.inserted",
            "settings": { "foreground": "#A6E22E" }
        },
        {
            "name": "diff.changed",
            "scope": "markup.changed",
            "settings": { "foreground": "#E6DB74" }
        },
        {
            "name": "Punctuation",
            "scope": ["punctuation", "meta.brace.round.js"],
            "settings": { "foreground": "#352C48" }
        },
        {
            "name": "punctuation.variable.php",
            "scope": "punctuation.definition.variable.php",
            "settings": { "foreground": "#50794c" }
        },
        {
            "name": "storage.type.function.python",
            "scope": "variable.parameter.function.python",
            "settings": { "foreground": "#7fc27b" }
        },
        {
            "name": "support.class.php",
            "scope": "support.class.php",
            "settings": { "foreground": "#a17865" }
        },
        {
            "name": "constant.language.php",
            "scope": "constant.language.php",
            "settings": { "foreground": "#856186" }
        },
        {
            "name": "support.language.php",
            "scope": "support.function.url.php",
            "settings": { "foreground": "#597692" }
        },
        {
            "name": "support.construct.php",
            "scope": "support.function.construct.php",
            "settings": { "foreground": "#7b353e" }
        },
        {
            "name": "constants,bools,null,none",
            "scope": [
                "constant.language",
                "constant.language.python",
                "constant.language.null.js",
                "constant.language.boolean.true.js",
                "constant.language.undefined.js"
            ],
            "settings": { "foreground": "#8d3c8f" }
        },
        {
            "name": "source.python",
            "scope": ["source.python", "meta.function-call.generic.python"],
            "settings": { "foreground": "#4d4553" }
        },
        {
            "name": "python.constant",
            "scope": "constant.language.python",
            "settings": { "foreground": "#8d3c8f" }
        },
        {
            "name": "support.construct.php",
            "scope": "variable.other.property.php",
            "settings": { "foreground": "#426f7b" }
        },
        {
            "name": "support.construct.php",
            "scope": "storage.modifier.php",
            "settings": { "foreground": "#607b5a" }
        },
        {
            "name": "meta.function-call.python",
            "scope": "meta.function-call.python",
            "settings": { "foreground": "#285525" }
        },
        {
            "name": "storage.type.function.python",
            "scope": "storage.type.function.python",
            "settings": { "foreground": "#244255" }
        }
    ],
    "colors": {
        "window.activeBorder": "#ff0000",
        "editor.background": "#f7f8f8",
        "editorCursor.foreground": "#325030",
        "editorWhitespace.foreground": "#181715",
        "editor.lineHighlightBorder": "#cfdce4",
        "editor.selectionBackground": "#bbfad0"
    },
    "name": "prggmr - Light",
    "$schema": "vscode://schemas/color-theme"
}
