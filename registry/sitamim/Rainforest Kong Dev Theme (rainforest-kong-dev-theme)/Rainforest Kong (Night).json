{
    "name": "Kong-Rainforest-Night",
    "type": "dark",
    "colors": {
        "editor.background": "#1a1b26",
        "editor.foreground": "#a9b1d6",
        "editorCursor.foreground": "#ffffff",
        "editor.lineHighlightBackground": "#24283b",
        "editor.selectionBackground": "#3e4451",
        "editor.selectionForeground": "#a9b1d6",
        "terminal.background": "#414868",
        "terminal.foreground": "#c0caf5",
        "activityBar.background": "#24283b",
        "activityBar.foreground": "#a9b1d6",
        "activityBarBadge.background": "#bb9af7",
        "activityBarBadge.foreground": "#ffffff",
        "sideBar.background": "#24283b",
        "sideBar.foreground": "#a9b1d6",
        "list.hoverBackground": "#3e4451",
        "list.activeSelectionBackground": "#56b6c2",
        "list.activeSelectionForeground": "#ffffff",
        "statusBar.background": "#24283b",
        "statusBar.foreground": "#a9b1d6",
        "statusBarItem.hoverBackground": "#3e4451",
        "titleBar.activeBackground": "#1a1b26",
        "titleBar.activeForeground": "#a9b1d6",
        "titleBar.inactiveBackground": "#1a1b26",
        "titleBar.inactiveForeground": "#6b8290"
    },
    "tokenColors": [
        {
            "name": "Comment",
            "scope": "comment, punctuation.definition.comment",
            "settings": { "foreground": "#565f89" }
        },
        {
            "name": "String, CSS class names",
            "scope": "string, entity.other.attribute-name.class",
            "settings": { "foreground": "#9ece6a" }
        },
        {
            "name": "Number, Boolean constants, Language support constants",
            "scope": "constant.numeric, constant.language",
            "settings": { "foreground": "#ff9e64" }
        },
        {
            "name": "Keyword, HTML elements, Regex group symbol, CSS units, Terminal Red",
            "scope": "keyword, entity.name.tag, constant.other.regexp, keyword.unit",
            "settings": { "foreground": "#f7768e" }
        },
        {
            "name": "Function parameters, Regex character sets, Terminal Yellow",
            "scope": "variable.parameter, constant.other.character.regexp",
            "settings": { "foreground": "#e0af68" }
        },
        {
            "name": "Parameters inside functions (semantic highlighting only)",
            "scope": "variable.parameter.function",
            "settings": { "foreground": "#cfc9c2" }
        },
        {
            "name": "Object literal keys, Markdown links, Terminal Green",
            "scope": "support.type.property-name, markup.underline.link",
            "settings": { "foreground": "#73daca" }
        },
        {
            "name": "Regex literal strings",
            "scope": "string.regexp",
            "settings": { "foreground": "#b4f9f8" }
        },
        {
            "name": "Language support functions, CSS HTML elements",
            "scope": "support.function, entity.name.tag.css",
            "settings": { "foreground": "#2ac3de" }
        },
        {
            "name": "Object properties, Regex quantifiers and flags, Markdown headings, Terminal Cyan, Markdown code, Import/export keywords",
            "scope": "entity.name.property, constant.regexp.quantifier, constant.regexp.flag, markup.heading, markup.fenced_code.block, keyword.import, keyword.export",
            "settings": { "foreground": "#7dcfff" }
        },
        {
            "name": "Function names, CSS property names, Terminal Blue",
            "scope": "entity.name.function",
            "settings": { "foreground": "#7aa2f7" }
        },
        {
            "name": "Control Keywords, Storage Types, Regex symbols and operators, HTML Attributes, Terminal Magenta",
            "scope": "keyword.control, storage, constant.regexp.symbol, keyword.operator.regexp, entity.other.attribute-name",
            "settings": { "foreground": "#bb9af7" }
        },
        {
            "name": "Variables, Class names, Terminal White",
            "scope": "variable, entity.name.class",
            "settings": { "foreground": "#c0caf5" }
        },
        {
            "name": "Markdown Text, HTML Text",
            "scope": "markup.raw, markup.inline",
            "settings": { "foreground": "#9aa5ce" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
