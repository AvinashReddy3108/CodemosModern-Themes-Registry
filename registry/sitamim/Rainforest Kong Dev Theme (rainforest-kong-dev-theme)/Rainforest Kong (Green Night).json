{
    "name": "kong-Rainforest-Green-Night",
    "type": "dark",
    "colors": {
        "editor.background": "#1E2924",
        "editor.foreground": "#C8E6C9",
        "editorCursor.foreground": "#FFFFFF",
        "editor.lineHighlightBackground": "#2E4036",
        "editor.selectionBackground": "#43A047",
        "editor.selectionForeground": "#FFFFFF",
        "terminal.background": "#1E2924",
        "terminal.foreground": "#C8E6C9",
        "activityBar.background": "#2E4036",
        "activityBar.foreground": "#FFFFFF",
        "activityBarBadge.background": "#64DD17",
        "activityBarBadge.foreground": "#000000",
        "sideBar.background": "#273730",
        "sideBar.foreground": "#C8E6C9",
        "list.hoverBackground": "#388E3C",
        "list.activeSelectionBackground": "#64DD17",
        "list.activeSelectionForeground": "#000000",
        "statusBar.background": "#2E4036",
        "statusBar.foreground": "#FFFFFF",
        "statusBarItem.hoverBackground": "#388E3C",
        "titleBar.activeBackground": "#1E2924",
        "titleBar.activeForeground": "#FFFFFF",
        "titleBar.inactiveBackground": "#1E2924",
        "titleBar.inactiveForeground": "#81C784"
    },
    "tokenColors": [
        {
            "name": "Comment",
            "scope": "comment, punctuation.definition.comment",
            "settings": { "foreground": "#81C784" }
        },
        {
            "name": "String",
            "scope": "string",
            "settings": { "foreground": "#FDD835" }
        },
        {
            "name": "Number",
            "scope": "constant.numeric",
            "settings": { "foreground": "#FFAB40" }
        },
        {
            "name": "Keyword",
            "scope": "keyword",
            "settings": { "foreground": "#E040FB" }
        },
        {
            "name": "Function",
            "scope": "entity.name.function",
            "settings": { "foreground": "#00BCD4" }
        },
        {
            "name": "Class",
            "scope": "entity.name.class",
            "settings": { "foreground": "#AED581" }
        },
        {
            "name": "Variable",
            "scope": "variable",
            "settings": { "foreground": "#C8E6C9" }
        },
        {
            "name": "Operator",
            "scope": "keyword.operator",
            "settings": { "foreground": "#E040FB" }
        },
        {
            "name": "Punctuation",
            "scope": "punctuation.separator, punctuation.definition",
            "settings": { "foreground": "#C8E6C9" }
        },
        {
            "name": "Storage",
            "scope": "storage",
            "settings": { "foreground": "#E040FB" }
        },
        {
            "name": "Type",
            "scope": "entity.name.type",
            "settings": { "foreground": "#4DB6AC" }
        },
        {
            "name": "Constant",
            "scope": "constant",
            "settings": { "foreground": "#FFAB40" }
        },
        {
            "name": "Invalid",
            "scope": "invalid",
            "settings": { "foreground": "#F44336" }
        },
        {
            "name": "Parameter",
            "scope": "variable.parameter",
            "settings": { "foreground": "#C8E6C9" }
        },
        {
            "name": "Property",
            "scope": "entity.name.property",
            "settings": { "foreground": "#FDD835" }
        },
        {
            "name": "Support",
            "scope": "support",
            "settings": { "foreground": "#4DB6AC" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
