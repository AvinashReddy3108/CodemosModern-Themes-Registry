        "editorBracketMatch.background": "#2d1b69",
        "editorBracketMatch.border": "#a855f7",
        "editorGutter.background": "#0d0d0d",
        "editorError.foreground": "#f87171",
        "editorWarning.foreground": "#fbbf24",
