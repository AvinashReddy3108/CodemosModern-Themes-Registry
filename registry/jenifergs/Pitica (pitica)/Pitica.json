{
    "name": "Pitica",
    "type": "dark",
    "colors": {
        "editor.background": "#0f001a",
        "editor.foreground": "#c084d1",
        "editorCursor.foreground": "#ff007f",
        "editor.lineHighlightBackground": "#1a0028",
        "editor.selectionBackground": "#6a007f",
        "sideBar.background": "#12001e",
        "sideBar.foreground": "#b886d4",
        "activityBar.background": "#150021",
        "activityBar.foreground": "#c084d1",
        "tab.activeBackground": "#3a003d",
        "tab.inactiveBackground": "#250027",
        "tab.activeForeground": "#ffffff",
        "tab.inactiveForeground": "#8a7b99",
        "statusBar.background": "#0f001a",
        "statusBar.foreground": "#c084d1",
        "statusBar.border": "#6a007f"
    },
    "tokenColors": [
        {
            "scope": "comment",
            "settings": { "foreground": "#7a2f85", "fontStyle": "italic" }
        },
        {
            "scope": "keyword",
            "settings": { "foreground": "#df006f", "fontStyle": "bold italic" }
        },
        {
            "scope": "string",
            "settings": { "foreground": "#55aa30", "fontStyle": "italic" }
        },
        { "scope": "variable", "settings": { "foreground": "#a1ddd0" } },
        {
            "scope": "entity.name.function",
            "settings": { "foreground": "#f1ec40" }
        },
        {
            "scope": "function",
            "settings": { "foreground": "#ffffff", "fontStyle": "bold" }
        },
        { "scope": "storage.type", "settings": { "foreground": "#FF99CC" } },
        {
            "scope": "constant",
            "settings": { "foreground": "#FF4500", "fontStyle": "italic bold" }
        },
        {
            "scope": "number",
            "settings": { "foreground": "#00BFFF", "fontStyle": "bold" }
        },
        {
            "scope": "punctuation.definition.tag",
            "settings": { "foreground": "#ffffff", "fontStyle": "bold" }
        },
        {
            "scope": "meta.jsx.children",
            "settings": { "foreground": "#c084d1", "fontStyle": "italic" }
        },
        {
            "scope": "meta.jsx.attribute",
            "settings": { "foreground": "#5ec532", "fontStyle": "bold italic" }
        },
        {
            "scope": "meta.jsx.attribute.value",
            "settings": { "foreground": "#035846", "fontStyle": "bold" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
