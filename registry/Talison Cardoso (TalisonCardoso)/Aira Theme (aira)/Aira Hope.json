    "semanticHighlighting": true,
    "tokenColors": [
        { "scope": "invalid", "settings": { "foreground": "#EF4E5B" } },
        {
            "scope": "invalid.deprecated",
            "settings": { "foreground": "#EF4E5B" }
        },
        {
            "name": "Foreground",
            "scope": "source",
            "settings": { "foreground": "#E5E5E5" }
        },
        { "scope": "variable", "settings": { "foreground": "#E5E5E5" } },
        { "scope": "constant", "settings": { "foreground": "#B69EFF" } },
        { "scope": "comment", "settings": { "foreground": "#787A88" } },
        { "scope": "string", "settings": { "foreground": "#D8C451" } },
        { "scope": "keyword", "settings": { "foreground": "#50E191" } },
        {
            "scope": ["keyword.operator.new", "keyword.control.new"],
            "settings": { "foreground": "#50E191" }
        },
        {
            "name": "Class name",
            "scope": "entity.name.type.class",
            "settings": { "foreground": "#FF916E", "fontStyle": "" }
        },
        {
            "name": "Inherited class name",
            "scope": "entity.other.inherited-class",
            "settings": { "foreground": "#FF916E", "fontStyle": "italic" }
        },
        {
            "name": "Variables like this, self, super",
            "scope": "variable.language",
            "settings": { "foreground": "#B69EFF", "fontStyle": "italic" }
        },
        {
            "name": "function name",
            "scope": "entity.name.function",
            "settings": { "foreground": "#63ACFF" }
        },
        { "scope": "variable.parameter", "settings": {} },
        {
            "name": "decorators",
            "scope": "storage.type.annotation",
            "settings": { "foreground": "#63ACFF", "fontStyle": "italic" }
        },
        { "scope": "support", "settings": { "foreground": "#FF916E" } },
        {
            "scope": "support.variable",
            "settings": { "foreground": "#B69EFF" }
        },
        {
            "scope": "support.function",
            "settings": { "foreground": "#FF916E" }
        },
        { "scope": "support.type", "settings": { "foreground": "#FF916E" } },
        {
            "scope": "support.constant",
            "settings": { "foreground": "#B69EFF" }
        },
        {
            "scope": "punctuation.separator.key-value",
            "settings": { "foreground": "#909CC3" }
        },
        {
            "name": "template string",
            "scope": [
                "punctuation.definition.template-expression.begin",
                "punctuation.definition.template-expression.end"
            ],
            "settings": { "foreground": "#50E191" }
        },
        {
            "name": "Separator ex.1: \\",
            "scope": "punctuation.separator.inheritance",
            "settings": { "foreground": "#50E191" }
        },
        { "scope": "storage", "settings": { "foreground": "#50E191" } },
        {
            "scope": "entity.name.type",
            "settings": { "foreground": "#FF916E", "fontStyle": "italic" }
        },
        {
            "name": "Foreground comment",
            "scope": "comment.block.documentation",
            "settings": { "foreground": "#787A88" }
        },
        {
            "name": "Paramenter to be described",
            "scope": "comment.block.documentation variable",
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "Paramenter type",
            "scope": "entity.name.type.instance",
            "settings": { "foreground": "#FF916E", "fontStyle": "italic" }
        },
        {
            "scope": "comment.block.documentation storage.type.class",
            "settings": { "foreground": "#50E191", "fontStyle": "italic" }
        },
        {
            "name": "character of escape",
            "scope": "constant.character.escape",
            "settings": { "foreground": "#50E191" }
        },
        {
            "scope": "constant.numeric",
            "settings": { "foreground": "#B69EFF" }
        },
        { "scope": "meta.embedded.line", "settings": {} },
        {
            "scope": "variable.other.constant",
            "settings": { "foreground": "#B69EFF" }
        },
        {
            "scope": "variable.other.readwrite.alias",
            "settings": { "foreground": "#E5E5E5" }
        },
        { "scope": "text.html", "settings": { "foreground": "#E5E5E5" } },
        {
            "name": "HTML - tag name",
            "scope": "entity.name.tag",
            "settings": { "foreground": "#50E191" }
        },
        {
            "name": "HTML - attribute name",
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#63ACFF" }
        },
        {
            "name": "CSS - class name",
            "scope": "entity.other.attribute-name.class",
            "settings": { "foreground": "#63ACFF" }
        },
        {
            "name": "CSS - other attr name [type=text]",
            "scope": "entity.other.attribute-name.css",
            "settings": { "foreground": "#63ACFF", "fontStyle": "italic" }
        },
        {
            "name": "CSS - property name",
            "scope": "support.type.property-name.css",
            "settings": { "foreground": "#E5E5E5", "fontStyle": "" }
        },
        {
            "name": "CSS - property value [flex]",
            "scope": "support.constant.property-value",
            "settings": { "foreground": "#B69EFF" }
        },
        {
            "name": "CSS - support function ",
            "scope": ["support.function.calc.css", "support.function.misc.css"],
            "settings": { "foreground": "#63ACFF", "fontStyle": "" }
        },
        {
            "scope": "keyword.operator.pattern.css",
            "settings": { "foreground": "#909CC3" }
        },
        {
            "scope": "support.type.property-name.json",
            "settings": { "foreground": "#50E191", "fontStyle": "" }
        },
        {
            "name": "MARKDOWN - titles",
            "scope": ["entity.name.section.markdown"],
            "settings": { "foreground": "#50E191" }
        },
        {
            "name": "MARKDOWN - title ponctuation",
            "scope": ["punctuation.definition.heading.markdown"],
            "settings": { "foreground": "#909CC3" }
        },
        {
            "name": "MARKDOWN - ponctuations",
            "scope": [
                "punctuation.definition.list.begin.markdown",
                "punctuation.definition.bold.markdown",
                "punctuation.definition.italic.markdown",
                "punctuation.definition.table.markdown",
                "punctuation.separator.table.markdown",
                "punctuation.definition.strikethrough.markdown",
                "punctuation.definition.math.begin.markdown",
                "punctuation.definition.math.end.markdown",
                "punctuation.definition.quote.begin.markdown"
            ],
            "settings": { "foreground": "#FF916E" }
        },
        {
            "name": "MARKDOWN - base text",
            "scope": ["text.html.markdown"],
            "settings": { "foreground": "#E5E5E5" }
        },
        {
            "name": "MARKDOWN -  bold text",
            "scope": ["markup.bold.markdown"],
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "MARKDOWN -  italic text",
            "scope": ["markup.italic.markdown"],
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "MARKDOWN - link",
            "scope": ["markup.underline.link"],
            "settings": { "foreground": "#63ACFF", "fontStyle": "italic" }
        },
        {
            "name": "MARKDOWN - link text",
            "scope": ["string.other.link"],
            "settings": { "foreground": "#50E191", "fontStyle": "italic" }
        },
        {
            "name": "MARKDOWN - strikethrough text",
            "scope": ["markup.strikethrough.markdown"],
            "settings": { "fontStyle": "strikethrough" }
        },
        {
            "name": "MARKDOWN - math",
            "scope": ["meta.embedded.math.markdown"],
            "settings": { "foreground": "#909CC3", "fontStyle": "italic" }
        },
        {
            "name": "MARKDOWN - other links",
            "scope": [
                "string.other.link.description.title.markdown",
                "string.other.link.description.markdown",
                "string.other.link.title.markdown"
            ],
            "settings": { "foreground": "#909CC3", "fontStyle": "italic" }
        },
        {
            "scope": "meta.interpolation.rust",
            "settings": { "foreground": "#50E191" }
        },
        {
            "scope": [
                "entity.name.type.rust",
                "entity.name.type.enum.rust",
                "entity.name.type.struct.rust"
            ],
            "settings": { "foreground": "#FF916E" }
        },
        {
            "scope": "variable.parameter.function.language.special.self.python",
            "settings": { "foreground": "#FF916E" }
        },
        {
            "name": "PHP - support",
            "scope": ["support.class.1", "support.other.namespace.php"],
            "settings": { "foreground": "#FF916E", "fontStyle": "italic" }
        },
        {
            "name": "PHP - variable other",
            "scope": "variable.other.property.php",
            "settings": { "foreground": "#E5E5E5" }
        },
        {
            "name": "PHP - punctuation section <?php ?>",
            "scope": [
                "punctuation.section.embedded.begin.php",
                "punctuation.section.embedded.end.php",
                "punctuation.section.embedded.end.php source.php"
            ],
            "settings": { "foreground": "#50E191" }
        },
        {
            "name": "PHP - types name",
            "scope": [
                "entity.name.type.interface.php",
                "entity.name.type.trait.php"
            ],
            "settings": { "foreground": "#FF916E" }
        }
    ]
}
