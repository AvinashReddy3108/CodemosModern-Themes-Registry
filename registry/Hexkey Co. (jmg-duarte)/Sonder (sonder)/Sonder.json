    "semanticHighlighting": true,
    "semanticTokenColors": {
        "class": { "foreground": "#DB9EFF", "fontStyle": "" },
        "struct": { "foreground": "#DB9EFF", "fontStyle": "" },
        "enum": { "foreground": "#DB9EFF", "fontStyle": "" },
        "enumMember": { "foreground": "#DB9EFF", "fontStyle": "" },
        "type": { "foreground": "#DB9EFF" },
        "typeAlias": { "foreground": "#DB9EFF" },
        "*.typeHint": { "foreground": "#DB9EFF" },
        "interface": { "foreground": "#DB9EFF" },
        "macro": { "foreground": "#F89F68" },
        "builtinAttribute": { "foreground": "#F89F68" },
        "decorator": { "foreground": "#F89F68" },
        "deriveHelper": { "foreground": "#F89F68" },
        "attribute": "#F89F68",
        "attributeBracket": "#F89F68",
        "method": {},
        "function": {},
        "magicFunction": { "fontStyle": "italic" },
        "parameter": { "fontStyle": "" },
        "escapeSequence": { "foreground": "#F89F68", "fontStyle": "bold" },
        "keyword": { "fontStyle": "", "foreground": "#99B1FF" },
        "namespace": { "fontStyle": "" },
        "operator": { "fontStyle": "" },
        "*.controlFlow": { "fontStyle": "bold" },
        "*.unsafe": { "fontStyle": "bold", "foreground": "#fe6f6f" },
        "*.consuming": { "fontStyle": "italic" },
        "*.mutable": { "fontStyle": "underline" },
        "*.constant": { "fontStyle": "" },
        "builtinConstant": { "fontStyle": "" },
        "*.builtin": { "fontStyle": "" },
        "*.deprecated": { "fontStyle": "strikethrough" },
        "comment": "#9a9a9a",
        "label": { "fontStyle": "bold" }
    },
    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#9a9a9a" }
        },
        {
            "name": "Strings",
            "scope": [
                "string",
                "punctuation.definition.string",
                "string.quoted.single.python"
            ],
            "settings": { "foreground": "#82C76B", "fontStyle": "" }
        },
        {
            "name": "Strings: Escape Sequences",
            "scope": [
                "constant.character.escape",
                "support.other.escape.special"
            ],
            "settings": { "foreground": "#F89F68", "fontStyle": "bold" }
        },
        {
            "name": "Constant Literals",
            "scope": ["constant.numeric", "constant.language.json.comments"],
            "settings": { "foreground": "#82C76B" }
        },
        {
            "name": "YAML: True, False, Null",
            "scope": [
                "constant.language.boolean.yaml",
                "constant.language.null.yaml"
            ],
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Fallback: Enum & Enum Member",
            "scope": ["entity.name.type.enum", "variable.other.enummember"],
            "settings": { "foreground": "#DB9EFF", "fontStyle": "" }
        },
        {
            "name": "Fallback: Namespaces",
            "scope": "entity.name.namespace",
            "settings": { "fontStyle": "" }
        },
        {
            "name": "Fallback: Types",
            "scope": ["entity.name.type", "support.type", "storage.type"],
            "settings": { "foreground": "#DB9EFF", "fontStyle": "" }
        },
        {
            "name": "Fallback: Control Flow",
            "scope": ["keyword.control"],
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Fallback: Struct",
            "scope": ["storage.type.struct"],
            "settings": { "foreground": "#DB9EFF", "fontStyle": "" }
        },
        {
            "name": "Fallback: Class",
            "scope": ["entity.name.type.class", "support.class"],
            "settings": { "foreground": "#DB9EFF", "fontStyle": "" }
        },
        {
            "name": "Fallback: Interface",
            "scope": ["entity.name.type.interface"],
            "settings": { "foreground": "#DB9EFF", "fontStyle": "" }
        },
        {
            "name": "Fallback: Function",
            "scope": [
                "entity.name.function",
                "support.function",
                "entity.name.function.member"
            ],
            "settings": { "fontStyle": "" }
        },
        {
            "name": "Fallback: Macro",
            "scope": ["entity.name.function.macro"],
            "settings": { "foreground": "#F89F68" }
        },
        {
            "name": "Fallback: Variable",
            "scope": [
                "variable.other.readwrite",
                "entity.name.variable",
                "variable.other.constant",
                "support.constant"
            ],
            "settings": {}
        },
        {
            "name": "Fallback: Parameter",
            "scope": ["variable.parameter"],
            "settings": {}
        },
        {
            "name": "Fallback: Property",
            "scope": ["variable.parameter", "variable.other.parameter"],
            "settings": {}
        },
        {
            "name": "Fallback: Event",
            "scope": ["variable.other.event"],
            "settings": {}
        },
        {
            "name": "Fallback: Keywords",
            "scope": [
                "keyword.function",
                "keyword.control",
                "keyword.var",
                "keyword.type",
                "keyword.package",
                "keyword.interface"
            ],
            "settings": { "foreground": "#99B1FF" }
        },
        {
            "name": "Python: Decorators",
            "scope": [
                "punctuation.definition.decorator.python",
                "entity.name.function.decorator.python",
                "meta.function.decorator.python",
                "entity.name.function.decorator.python"
            ],
            "settings": { "foreground": "#F89F68" }
        },
        {
            "name": "Python Keyword: Declarations",
            "scope": [
                "constant.language.python",
                "keyword.control.flow.python",
                "keyword.control.import.python",
                "keyword.operator.logical.python",
                "storage.type.class.python",
                "storage.type.function.async.python",
                "storage.type.function.lambda.python",
                "storage.type.function.python"
            ],
            "settings": { "foreground": "#99B1FF" }
        },
        {
            "name": "Python: Function Call Parameter",
            "scope": ["variable.parameter.function-call.python"],
            "settings": { "foreground": "#e3e3e3", "fontStyle": "" }
        },
        {
            "name": "HTML: Tags",
            "scope": ["entity.name.tag.html"],
            "settings": { "foreground": "#99B1FF" }
        },
        {
            "name": "JSX & TSX: Tags",
