            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Rust: Other",
            "scope": [
                "keyword.other.rust",
                "keyword.other.fn.rust",
                "keyword.other.crate.rust"
            ],
            "settings": { "foreground": "#99B1FF" }
        },
        {
            "name": "Rust: Storage",
            "scope": ["storage.type.rust", "storage.modifier.mut.rust"],
            "settings": { "foreground": "#99B1FF" }
        },
        {
            "name": "Rust: Constants",
            "scope": ["constant.language.bool.rust"],
            "settings": { "foreground": "#99B1FF" }
        },
        {
            "name": "Rust: Macros",
            "scope": ["meta.attribute.rust"],
            "settings": { "foreground": "#F89F68" }
        },
        {
            "name": "Diff: Header",
            "scope": ["meta.diff.header", "meta.diff.index"],
            "settings": { "foreground": "#DB9EFF" }
        },
        {
            "name": "Diff: Range",
            "scope": ["meta.diff.range.unified"],
            "settings": { "foreground": "#F89F68" }
        },
        {
            "name": "Diff: Delete",
            "scope": [
                "punctuation.definition.deleted.diff",
                "markup.deleted.diff",
                "meta.diff.header.from-file"
            ],
            "settings": { "foreground": "#FF4A1C" }
        },
        {
            "name": "Diff: Inserted",
            "scope": [
                "punctuation.definition.inserted.diff",
                "markup.inserted.diff",
                "meta.diff.header.to-file"
            ],
            "settings": { "foreground": "#82FF74" }
        },
        {
            "name": "Search: Line Number",
            "scope": [
                "meta.resultLinePrefix.lineNumber.search",
                "meta.resultLinePrefix.matchLinePrefix.search"
            ],
            "settings": { "foreground": "#e3e3e3a0", "fontStyle": "" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
