{
    "name": "CodeNebula Light",
    "type": "light",
    "_eye_comfort_notes": {
        "science": "Warm cream BG (#F5EFE4) avoids glare of pure white. Foreground at ~8.5:1 (not 13:1) — less accommodation strain. All syntax colors desaturated 35-50%, warm-shifted to reduce blue. Based on Solarized Light / Alabaster principles.",
        "bg": "#F5EFE4  warm parchment cream, not harsh white",
        "fg": "#302820  deep warm brown, ~8.5:1 moderate contrast",
        "amber": "#965018  muted terracotta-amber keywords, S=45% L=35%",
        "sage": "#296A42  deep muted forest green strings, S=43% L=29%",
        "teal": "#126080  deep muted teal functions, S=50% L=28%",
        "sienna": "#7A4220  muted sienna types, S=45% L=30%",
        "gold": "#7A5510  muted amber-gold numbers, S=48% L=27%",
        "mauve": "#6A3868  muted mauve special, S=32% L=31%",
        "comment": "#988070  warm gray, L=53%, desaturated — subdued"
    },
