    "tokenColors": [
        {
            "name": "Base text — deep warm brown ~8.5:1 (easier than 13:1)",
            "scope": ["source", "text.html", "text"],
            "settings": { "foreground": "#302820" }
        },
        {
            "name": "Comment — warm gray, L=53%, italic ~4.5:1",
            "scope": [
                "comment",
                "punctuation.definition.comment",
                "string.quoted.docstring"
            ],
            "settings": { "foreground": "#988070", "fontStyle": "italic" }
        },
        {
            "name": "TODO / FIXME / NOTE",
            "scope": [
                "keyword.codetag.notation",
                "comment.todo",
                "comment.fixme"
            ],
            "settings": { "foreground": "#8A5510", "fontStyle": "bold italic" }
        },
        {
            "name": "Keyword — muted terracotta-amber ~5.8:1",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.control.flow",
                "keyword.control.import",
                "keyword.control.from",
                "keyword.other"
            ],
            "settings": { "foreground": "#965018", "fontStyle": "italic" }
        },
        {
            "name": "Storage — def / class / const / let",
            "scope": [
                "storage.type",
                "storage.modifier",
                "keyword.declaration"
            ],
            "settings": { "foreground": "#965018", "fontStyle": "italic" }
        },
        {
            "name": "Keyword operator expressions",
            "scope": [
                "keyword.operator.new",
                "keyword.operator.expression",
                "keyword.operator.logical",
                "keyword.operator.in",
                "keyword.operator.of"
            ],
            "settings": { "foreground": "#7A3C10", "fontStyle": "italic" }
        },
        {
            "name": "Operator — muted warm brown",
            "scope": [
                "keyword.operator",
                "keyword.operator.arithmetic",
                "keyword.operator.assignment",
                "keyword.operator.comparison",
                "keyword.operator.bitwise"
            ],
            "settings": { "foreground": "#7A4418" }
        },
        {
            "name": "Boolean / null / none / undefined",
            "scope": [
                "constant.language",
                "constant.language.boolean",
                "constant.language.null",
                "constant.language.undefined",
                "constant.language.none"
            ],
            "settings": { "foreground": "#965018", "fontStyle": "italic" }
        },
        {
            "name": "Number — muted amber-gold ~5.5:1",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#7A5510" }
        },
        {
            "name": "Escape sequences / placeholders",
            "scope": [
                "constant.character",
                "constant.character.escape",
                "constant.other.placeholder"
            ],
            "settings": { "foreground": "#6A3868" }
        },
        {
            "name": "Other constants",
            "scope": ["constant.other", "support.constant"],
            "settings": { "foreground": "#7A5510" }
        },
        {
            "name": "String — muted forest green ~5.8:1",
            "scope": ["string", "string.quoted"],
            "settings": { "foreground": "#296A42" }
        },
        {
            "name": "String — template / interpolated",
            "scope": [
                "string.template",
                "string.interpolated",
                "string.quoted.template"
            ],
            "settings": { "foreground": "#1E5C38" }
        },
        {
            "name": "Template expression ${ }",
            "scope": [
                "punctuation.definition.template-expression",
                "punctuation.section.embedded",
                "meta.template.expression"
            ],
            "settings": { "foreground": "#7A5510" }
        },
        {
            "name": "String punctuation",
            "scope": [
                "punctuation.definition.string.begin",
                "punctuation.definition.string.end"
            ],
            "settings": { "foreground": "#3A7A52" }
        },
        {
            "name": "Regular expression — muted mauve",
            "scope": ["string.regexp", "constant.regexp"],
            "settings": { "foreground": "#6A3868" }
        },
        {
            "name": "Function name — deep muted teal ~6.8:1",
            "scope": [
                "entity.name.function",
                "meta.definition.method entity.name.function"
            ],
            "settings": { "foreground": "#126080" }
        },
        {
            "name": "Function call",
            "scope": [
                "meta.function-call.generic",
                "meta.method-call entity.name.function"
            ],
            "settings": { "foreground": "#126080" }
        },
        {
            "name": "Builtin / support functions",
            "scope": ["support.function", "support.function.builtin"],
            "settings": { "foreground": "#126080", "fontStyle": "italic" }
        },
        {
            "name": "Class / type name — muted sienna ~5.2:1",
            "scope": [
                "entity.name.class",
                "entity.name.type",
                "entity.name.type.class"
            ],
            "settings": { "foreground": "#7A4220" }
        },
        {
            "name": "Inherited class",
            "scope": ["entity.other.inherited-class"],
            "settings": { "foreground": "#7A4220", "fontStyle": "italic" }
        },
        {
            "name": "Interface / enum name",
            "scope": ["entity.name.interface", "entity.name.enum"],
            "settings": { "foreground": "#8A5230", "fontStyle": "italic" }
        },
        {
            "name": "Type annotation / primitives",
            "scope": [
                "support.type",
                "support.type.primitive",
                "meta.type.annotation",
                "meta.type.parameters"
            ],
            "settings": { "foreground": "#8A5A30" }
        },
        {
            "name": "Enum member",
            "scope": ["variable.other.enummember"],
            "settings": { "foreground": "#7A5510" }
        },
        {
            "name": "Variable — dark warm (main text level, not distracting)",
            "scope": [
                "variable",
                "variable.other.readwrite",
                "variable.other.local"
            ],
            "settings": { "foreground": "#2E2418" }
        },
        {
            "name": "Variable — parameter (italic, warm brown)",
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#604028", "fontStyle": "italic" }
        },
        {
            "name": "Variable — object property",
            "scope": [
                "variable.other.property",
                "variable.other.object.property",
                "support.variable.property"
            ],
            "settings": { "foreground": "#7A4220" }
        },
        {
            "name": "this / self / cls — amber italic",
            "scope": [
                "variable.language.this",
                "variable.language.self",
                "variable.language.super",
                "variable.language.special.self.python",
                "variable.language.special.cls.python"
            ],
            "settings": { "foreground": "#965018", "fontStyle": "italic" }
        },
        {
            "name": "Punctuation — structural, muted",
            "scope": [
                "punctuation.separator",
                "punctuation.terminator",
                "punctuation.accessor"
            ],
            "settings": { "foreground": "#988070" }
        },
        {
            "name": "Punctuation — brackets",
            "scope": [
                "punctuation.definition.block",
                "punctuation.definition.parameters",
                "punctuation.definition.array",
                "meta.brace"
            ],
            "settings": { "foreground": "#786050" }
        },
        {
            "name": "Decorator / annotation",
            "scope": [
                "meta.decorator",
                "entity.name.function.decorator",
                "support.type.decorator",
                "punctuation.decorator"
            ],
            "settings": { "foreground": "#965018", "fontStyle": "italic" }
        },
        {
            "name": "Python — decorator",
            "scope": [
                "entity.name.function.decorator.python",
                "meta.function.decorator.python"
            ],
            "settings": { "foreground": "#965018", "fontStyle": "italic" }
        },
        {
            "name": "Python — magic methods",
            "scope": ["support.function.magic.python"],
            "settings": { "foreground": "#126080", "fontStyle": "italic" }
        },
        {
            "name": "Python — builtin types",
            "scope": ["support.type.python"],
            "settings": { "foreground": "#7A4220" }
        },
        {
            "name": "HTML / JSX — tag name",
            "scope": [
                "entity.name.tag",
                "entity.name.tag.html",
                "entity.name.tag.jsx"
            ],
            "settings": { "foreground": "#965018" }
        },
        {
            "name": "HTML / JSX — attribute name",
            "scope": [
                "entity.other.attribute-name",
                "entity.other.attribute-name.html",
                "entity.other.attribute-name.jsx"
            ],
            "settings": { "foreground": "#7A4220" }
        },
        {
            "name": "CSS — property name",
            "scope": [
                "support.type.property-name.css",
                "support.type.property-name.scss",
                "meta.property-name"
            ],
            "settings": { "foreground": "#126080" }
        },
        {
            "name": "CSS — property value",
            "scope": ["meta.property-value", "support.constant.property-value"],
            "settings": { "foreground": "#296A42" }
        },
        {
            "name": "CSS — selector class / pseudo",
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.pseudo-class.css",
                "entity.other.attribute-name.pseudo-element.css"
            ],
            "settings": { "foreground": "#7A5510" }
        },
        {
            "name": "CSS — units / color",
            "scope": ["constant.other.color.rgb-value", "keyword.other.unit"],
            "settings": { "foreground": "#7A5510" }
        },
        {
            "name": "JSON — key",
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#126080" }
        },
        {
            "name": "JSON — string value",
            "scope": ["string.quoted.double.json"],
            "settings": { "foreground": "#296A42" }
        },
        {
            "name": "JSON — boolean / null",
            "scope": ["constant.language.json"],
            "settings": { "foreground": "#965018" }
        },
        {
            "name": "YAML — key",
            "scope": ["entity.name.tag.yaml"],
            "settings": { "foreground": "#126080" }
        },
        {
            "name": "YAML — string value",
            "scope": [
                "string.unquoted.yaml",
                "string.quoted.single.yaml",
                "string.quoted.double.yaml"
            ],
            "settings": { "foreground": "#296A42" }
        },
        {
            "name": "Markdown — heading",
            "scope": ["markup.heading", "entity.name.section.markdown"],
            "settings": { "foreground": "#965018", "fontStyle": "bold" }
        },
        {
            "name": "Markdown — bold",
            "scope": ["markup.bold"],
            "settings": { "foreground": "#302820", "fontStyle": "bold" }
        },
        {
            "name": "Markdown — italic",
            "scope": ["markup.italic"],
            "settings": { "foreground": "#7A4220", "fontStyle": "italic" }
        },
        {
            "name": "Markdown — inline code",
            "scope": ["markup.inline.raw", "markup.raw.inline"],
            "settings": { "foreground": "#296A42" }
        },
        {
            "name": "Markdown — link",
            "scope": ["markup.underline.link", "string.other.link"],
            "settings": { "foreground": "#126080" }
        },
        {
            "name": "Markdown — blockquote",
            "scope": ["markup.quote"],
            "settings": { "foreground": "#988070", "fontStyle": "italic" }
        },
        {
            "name": "Markdown — list bullet",
            "scope": ["punctuation.definition.list_item.markdown"],
            "settings": { "foreground": "#965018" }
        },
        {
            "name": "Diff — inserted",
            "scope": ["markup.inserted"],
            "settings": { "foreground": "#2A8055" }
        },
        {
            "name": "Diff — deleted",
            "scope": ["markup.deleted"],
            "settings": { "foreground": "#A83820" }
        },
        {
            "name": "Diff — changed",
            "scope": ["markup.changed"],
            "settings": { "foreground": "#8A5510" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#A83820", "fontStyle": "underline" }
        },
        {
            "name": "Deprecated",
            "scope": ["invalid.deprecated"],
            "settings": {
                "foreground": "#988070",
                "fontStyle": "strikethrough"
            }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "class": "#7A4220",
        "interface": { "foreground": "#8A5230", "italic": true },
        "enum": "#7A4220",
        "enumMember": "#7A5510",
        "struct": "#7A4220",
        "typeAlias": "#7A4220",
        "typeParameter": { "foreground": "#8A5A30", "italic": true },
        "type": "#7A4220",
