        "editorBracketHighlight.foreground2": "#a6e3a1",
        "editorBracketHighlight.foreground3": "#fab387",
        "editorBracketHighlight.foreground4": "#cba6f7",
        "editorBracketHighlight.foreground5": "#f9e2af",
        "editorBracketHighlight.foreground6": "#89b4fa",
        "debugToolBar.background": "#0f172b",
        "editor.stackFrameHighlightBackground": "#a707",
        "editor.focusedStackFrameHighlightBackground": "#b808",
        "peekViewEditor.background": "#0f172b",
        "peekViewResult.background": "#0f172b",
        "settings.headerForeground": "#ffffff",
        "settings.modifiedItemIndicator": "#89b4fa",
        "problemsErrorIcon.foreground": "#f38ba8",
        "problemsWarningIcon.foreground": "#fab387",
        "problemsInfoIcon.foreground": "#89b4fa",
        "editorError.foreground": "#f38ba8",
        "editorWarning.foreground": "#fab387",
        "editorInfo.foreground": "#89b4fa",
        "editorHint.foreground": "#74c7ec",
        "editorGutter.commentRangeForeground": "#ffffff50",
        "editorGutter.foldingControlForeground": "#ffffff90",
        "editorInlayHint.foreground": "#666666",
        "editorInlayHint.background": "#151f33",
        "editorStickyScroll.background": "#151f33",
        "editorStickyScrollHover.background": "#151f33",
        "menu.separatorBackground": "#1d293d"
    },
    "semanticTokenColors": {
        "class": "#f9e2af",
        "interface": "#f9e2af",
        "struct": "#f9e2af",
        "type": "#f9e2af",
        "function": "#89b4fa",
        "method": "#89b4fa",
        "comment": "#62748e",
        "string": "#a6e3a1",
        "keyword": "#cba6f7",
        "number": "#fab387",
        "operator": "#74c7ec",
        "regexp": "#74c7ec",
        "magicFunction": "#cba6f7",
        "variable": "#e2e8f0",
        "property": "#e2e8f0",
        "namespace": "#e2e8f0",
        "variable.defaultLibrary": "#f38ba8",
        "selfParameter": { "foreground": "#f38ba8", "italic": true }
    },
    "semanticHighlighting": true,
    "tokenColors": [
        { "name": "Global", "settings": { "foreground": "#e2e8f0" } },
        {
            "name": "Variables",
            "scope": ["variable"],
            "settings": { "foreground": "#e2e8f0" }
        },
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "fontStyle": "italic", "foreground": "#62748e" }
        },
        {
            "name": "Syntax Noises",
            "scope": [
                "punctuation.definition",
                "punctuation.separator.comma",
                "punctuation.terminator",
                "constant.character.format.placeholder"
            ],
            "settings": { "foreground": "#62748e" }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "punctuation.definition.keyword",
                "storage.type",
                "storage.modifier"
            ],
            "settings": { "foreground": "#cba6f7" }
        },
        {
            "name": "Operators",
            "scope": ["punctuation", "keyword.operator", "meta.brace"],
            "settings": { "foreground": "#74c7ec" }
        },
        {
            "name": "Tags",
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#eba0ac" }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call.generic",
                "entity.name.command"
            ],
            "settings": { "foreground": "#89b4fa" }
        },
        {
            "name": "Literals",
            "scope": [
                "constant.numeric",
                "constant.language",
                "support.constant",
                "keyword.other.unit",
                "support.type.builtin"
            ],
            "settings": { "foreground": "#fab387" }
        },
        {
            "name": "Strings",
            "scope": [
                "string",
                "punctuation.definition.string",
                "fenced_code.block.language"
            ],
            "settings": { "foreground": "#a6e3a1" }
        },
        {
            "name": "Classes and Types",
            "scope": [
                "entity.name.type",
                "support.class",
                "entity.other.inherited-class"
            ],
            "settings": { "foreground": "#f9e2af" }
        },
        {
            "name": "Keys",
            "scope": ["support.type"],
            "settings": { "foreground": "#f9e2af" }
        },
        {
            "name": "Special Keys",
            "scope": ["support.type.vendored"],
            "settings": { "fontStyle": "italic", "foreground": "#f9e2af" }
        },
        {
            "name": "Attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#cba6f7" }
        },
        {
            "name": "Deprecated Attributes",
            "scope": ["invalid.deprecated.entity.other.attribute-name"],
            "settings": {
                "fontStyle": "strikethrough",
                "foreground": "#cba6f7"
            }
        },
        {
            "name": "Special Variables",
            "scope": ["variable.language", "support.constant.vendored"],
            "settings": { "fontStyle": "italic", "foreground": "#f38ba8" }
        },
        {
            "name": "Special Syntax",
            "scope": [
                "string.regexp",
                "constant.character.escape",
                "constant.other.color"
            ],
            "settings": { "foreground": "#74c7ec" }
        },
        {
            "name": "URL",
            "scope": ["*url*", "*link*", "*uri*"],
            "settings": { "fontStyle": "underline" }
        },
        {
            "name": "Link",
            "scope": ["string.other.link"],
            "settings": { "foreground": "#89b4fa" }
        },
        {
            "name": "Code",
            "scope": ["markup.inline.raw"],
            "settings": { "foreground": "#90a1b9" }
        },
        {
            "name": "Bold",
            "scope": ["heading", "markup.bold"],
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Italic",
            "scope": ["markup.italic"],
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "Strikethrough",
            "scope": ["markup.strikethrough"],
            "settings": { "fontStyle": "strikethrough" }
        },
        {
            "name": "Bold & Italic",
            "scope": [
                "markup.italic markup.bold",
                "markup.bold markup.italic",
                "heading markup.italic"
            ],
            "settings": { "fontStyle": "bold italic" }
        },
        {
            "name": "Bold & Strikethrough",
            "scope": [
                "markup.strikethrough markup.bold",
                "markup.bold markup.strikethrough"
            ],
            "settings": { "fontStyle": "bold strikethrough" }
        },
        {
            "name": "Italic & Strikethrough",
            "scope": [
                "markup.strikethrough markup.italic",
                "markup.italic markup.strikethrough"
            ],
            "settings": { "fontStyle": "italic strikethrough" }
        },
        {
            "name": "Bold, Italic & Strikethrough",
            "scope": [
                "markup.italic markup.bold markup.strikethrough",
                "markup.italic markup.strikethrough markup.bold",
                "markup.strikethrough markup.bold markup.italic",
                "markup.strikethrough markup.italic markup.bold",
                "markup.bold markup.italic markup.strikethrough",
                "markup.bold markup.strikethrough markup.italic",
                "heading markup.italic markup.strikethrough",
                "heading markup.strikethrough markup.italic"
            ],
            "settings": { "fontStyle": "bold italic strikethrough" }
        }
    ]
}
