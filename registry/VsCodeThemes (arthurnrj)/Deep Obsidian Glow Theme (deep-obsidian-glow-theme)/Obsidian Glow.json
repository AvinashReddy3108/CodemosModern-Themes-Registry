{
    "name": "Obsidian Glow",
    "type": "dark",
    "colors": {
        "editor.background": "#111318",
        "editor.foreground": "#d4d4d4",
        "activityBar.background": "#0c0e12",
        "sideBar.background": "#111318",
        "sideBarTitle.foreground": "#888c99",
        "titleBar.activeBackground": "#0c0e12",
        "titleBar.activeForeground": "#d4d4d4",
        "statusBar.background": "#1e2a3a",
        "statusBar.foreground": "#98a0b0",
        "tab.activeBackground": "#111318",
        "tab.inactiveBackground": "#0c0e12",
        "editor.lineHighlightBackground": "#1a1d2599",
        "editorLineNumber.foreground": "#4a4e5a",
        "editorLineNumber.activeForeground": "#d4d4d4",
        "editor.selectionBackground": "#1e4a7a44",
        "editorCursor.foreground": "#4fc1ff",
        "terminal.background": "#111318",
        "terminal.foreground": "#d4d4d4"
    },
    "tokenColors": [
        {
            "scope": "comment",
            "settings": { "foreground": "#6a7080", "fontStyle": "italic" }
        },
        { "scope": "string", "settings": { "foreground": "#89ddff" } },
        { "scope": "keyword", "settings": { "foreground": "#c792ea" } },
        { "scope": "variable", "settings": { "foreground": "#f78c6c" } },
        {
            "scope": "entity.name.function",
            "settings": { "foreground": "#82aaff" }
        },
        {
            "scope": "entity.name.type",
            "settings": { "foreground": "#ffcb6b" }
        },
        {
            "scope": "constant.numeric",
            "settings": { "foreground": "#f78c6c" }
        },
        { "scope": "storage.type", "settings": { "foreground": "#c792ea" } },
        {
            "scope": "support.function",
            "settings": { "foreground": "#82aaff" }
        },
        { "scope": "punctuation", "settings": { "foreground": "#d4d4d4" } },
        {
            "scope": "meta.preprocessor",
            "settings": { "foreground": "#c792ea" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
