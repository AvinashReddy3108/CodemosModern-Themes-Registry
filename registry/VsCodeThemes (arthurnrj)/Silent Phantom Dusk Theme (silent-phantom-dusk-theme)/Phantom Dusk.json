{
    "name": "Phantom Dusk",
    "type": "dark",
    "colors": {
        "editor.background": "#181025",
        "editor.foreground": "#e0d0f0",
        "activityBar.background": "#12081e",
        "sideBar.background": "#181025",
        "sideBarTitle.foreground": "#9080a8",
        "titleBar.activeBackground": "#12081e",
        "titleBar.activeForeground": "#e0d0f0",
        "statusBar.background": "#2a1848",
        "statusBar.foreground": "#b0a0c8",
        "tab.activeBackground": "#181025",
        "tab.inactiveBackground": "#12081e",
        "editor.lineHighlightBackground": "#22163599",
        "editorLineNumber.foreground": "#504068",
        "editorLineNumber.activeForeground": "#e0d0f0",
        "editor.selectionBackground": "#3a286044",
        "editorCursor.foreground": "#bf93ff",
        "terminal.background": "#181025",
        "terminal.foreground": "#e0d0f0"
    },
    "tokenColors": [
        {
            "scope": "comment",
            "settings": { "foreground": "#706088", "fontStyle": "italic" }
        },
        { "scope": "string", "settings": { "foreground": "#a0e8b0" } },
        { "scope": "keyword", "settings": { "foreground": "#ff79c6" } },
        { "scope": "variable", "settings": { "foreground": "#ffb86c" } },
        {
            "scope": "entity.name.function",
            "settings": { "foreground": "#bf93ff" }
        },
        {
            "scope": "entity.name.type",
            "settings": { "foreground": "#8be9fd" }
        },
        {
            "scope": "constant.numeric",
            "settings": { "foreground": "#bd93f9" }
        },
        { "scope": "storage.type", "settings": { "foreground": "#ff79c6" } },
        {
            "scope": "support.function",
            "settings": { "foreground": "#bf93ff" }
        },
        { "scope": "punctuation", "settings": { "foreground": "#e0d0f0" } },
        {
            "scope": "meta.preprocessor",
            "settings": { "foreground": "#ff79c6" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
