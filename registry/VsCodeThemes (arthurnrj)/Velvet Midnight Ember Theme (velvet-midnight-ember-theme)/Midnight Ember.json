{
    "name": "Midnight Ember",
    "type": "dark",
    "colors": {
        "editor.background": "#0d1117",
        "editor.foreground": "#c9d1d9",
        "activityBar.background": "#010409",
        "sideBar.background": "#0d1117",
        "sideBarTitle.foreground": "#8b949e",
        "titleBar.activeBackground": "#010409",
        "titleBar.activeForeground": "#c9d1d9",
        "statusBar.background": "#161b22",
        "statusBar.foreground": "#8b949e",
        "tab.activeBackground": "#0d1117",
        "tab.inactiveBackground": "#010409",
        "editor.lineHighlightBackground": "#161b2299",
        "editorLineNumber.foreground": "#484f58",
        "editorLineNumber.activeForeground": "#c9d1d9",
        "editor.selectionBackground": "#264f7844",
        "editorCursor.foreground": "#f0883e",
        "terminal.background": "#0d1117",
        "terminal.foreground": "#c9d1d9"
    },
    "tokenColors": [
        {
            "scope": "comment",
            "settings": { "foreground": "#8b949e", "fontStyle": "italic" }
        },
        { "scope": "string", "settings": { "foreground": "#a5d6ff" } },
        { "scope": "keyword", "settings": { "foreground": "#ff7b72" } },
        { "scope": "variable", "settings": { "foreground": "#ffa657" } },
        {
            "scope": "entity.name.function",
            "settings": { "foreground": "#d2a8ff" }
        },
        {
            "scope": "entity.name.type",
            "settings": { "foreground": "#79c0ff" }
        },
        {
            "scope": "constant.numeric",
            "settings": { "foreground": "#79c0ff" }
        },
        { "scope": "storage.type", "settings": { "foreground": "#ff7b72" } },
        {
            "scope": "support.function",
            "settings": { "foreground": "#d2a8ff" }
        },
        { "scope": "punctuation", "settings": { "foreground": "#c9d1d9" } },
        {
            "scope": "meta.preprocessor",
            "settings": { "foreground": "#ff7b72" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
