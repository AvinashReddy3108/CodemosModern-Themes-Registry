{
    "$schema": "vscode://schemas/color-theme",
    "type": "dark",
    "colors": {
        "editor.background": "#1b2b34",
        "editor.foreground": "#cdd3de",
        "editor.lineHighlightBackground": "#00000030",
        "editor.selectionBackground": "#4f5b66",
        "editorCursor.foreground": "#ffcc00",
        "editorGroupHeader.tabsBorder": "#e74c3c",
        "editorWhitespace.foreground": "#2d4858",
        "scrollbarSlider.activeBackground": "#e74c3c",
        "scrollbarSlider.background": "#4d1e0f",
        "scrollbarSlider.hoverBackground": "#e74c3c"
    },
    "tokenColors": [
        {
            "name": "Text",
            "scope": "variable.parameter.function",
            "settings": { "foreground": "#5FB3B3" }
        },
        {
            "name": "Comments",
            "scope": "comment, punctuation.definition.comment",
            "settings": { "foreground": "#65737e", "fontStyle": "bold" }
        },
        {
            "name": "Comments",
            "scope": "comment",
            "settings": { "foreground": "#65737e", "fontStyle": "bold" }
        },
        {
            "name": "Delimiters",
            "scope": "none",
            "settings": { "foreground": "#A6B2C0" }
        },
        {
            "name": "Operators",
            "scope": "keyword.operator",
            "settings": { "foreground": "#c792ea" }
        },
        {
            "name": "Keywords",
            "scope": "keyword",
            "settings": { "foreground": "#c792ea" }
        },
        {
            "name": "Variables",
            "scope": "variable",
            "settings": { "foreground": "#5FB3B3" }
        },
        {
            "name": "Java Variables",
            "scope": "token.variable.parameter.java",
            "settings": { "foreground": "#5FB3B3" }
        },
        {
            "name": "Java Imports",
            "scope": "import.storage.java",
            "settings": { "foreground": "#e5c07b" }
        },
        {
            "name": "Packages",
            "scope": "token.package.keyword",
            "settings": { "foreground": "#c792ea" }
        },
        {
            "name": "Packages",
            "scope": "token.package",
            "settings": { "foreground": "#c792ea" }
        },
        {
            "name": "Functions",
            "scope": "entity.name.function, meta.require, support.function.any-method",
            "settings": { "foreground": "#82AAFF" }
        },
        {
            "name": "Classes",
            "scope": "entity.name.type.namespace, js.function.block.support.class.console",
            "settings": { "foreground": "#ffcb6b" }
        },
        {
            "name": "Classes",
            "scope": "support.class, entity.name.type.class, ",
            "settings": { "foreground": "#ffcb6b" }
        },
        {
            "name": "Class name",
            "scope": "entity.name.class.identifier.namespace.type",
            "settings": { "foreground": "#B2CCD6" }
        },
        {
            "name": "Class name",
            "scope": "entity.name.class",
            "settings": { "foreground": "#82AAFF" }
        },
        {
            "name": "Type Name",
            "scope": "entity.name.type",
            "settings": { "foreground": "#89DDFF" }
        },
        {
            "name": "Keyword Control",
            "scope": "keyword.control",
            "settings": { "foreground": "#c7F7766992ea" }
        },
        {
            "name": "Control Elements",
            "scope": "control.elements, keyword.operator.less",
            "settings": { "foreground": "#FFEB95" }
        },
        {
            "name": "Methods",
            "scope": "keyword.other.special-method",
            "settings": { "foreground": "#82B1FF" }
        },
        {
            "name": "Storage",
            "scope": "storage",
            "settings": { "foreground": "#c792eaff" }
        },
        {
            "name": "Storage JS TS",
            "scope": "token.storage.js,token.storage.ts",
            "settings": { "foreground": "#c792eaff" }
        },
        {
            "name": "Java Storage",
            "scope": "token.storage.type.java",
            "settings": { "foreground": "#c792eaff" }
        },
        {
            "name": "Support type",
            "scope": "support.type.property-name",
            "settings": { "foreground": "#eeffff" }
        },
        {
            "name": "Support type",
            "scope": "support.constant.property-value",
            "settings": { "foreground": "#FFEB95" }
        },
        {
            "name": "Support type",
            "scope": "support.constant.font-name",
            "settings": { "foreground": "#d19a66" }
        },
        {
            "name": "Strings, Inherited Class",
            "scope": "string, entity.other.inherited-class",
            "settings": { "foreground": "#98c379" }
        },
        {
            "name": "Strings, variaveis",
            "scope": "other.variable.definition.string.quoted.string-contents.double, other.variable.string.quoted.string-contents.double",
            "settings": { "foreground": "#5FB3B3" }
        },
        {
            "name": "Constant other symbol",
            "scope": "constant.other.symbol",
            "settings": { "foreground": "#56b6c2" }
        },
        {
            "name": "Integers",
            "scope": "constant.numeric",
            "settings": { "foreground": "#d19a66" }
        },
        {
            "name": "Floats",
            "scope": "none",
            "settings": { "foreground": "#d19a66" }
        },
        {
            "name": "Boolean",
            "scope": "none",
            "settings": { "foreground": "#d19a66" }
        },
        {
            "name": "Constants",
            "scope": "constant",
            "settings": { "foreground": "#d19a66" }
        },
        {
            "name": "Constants",
            "scope": "punctuation.definition.constant",
            "settings": { "foreground": "#d19a66" }
        },
        {
            "name": "Tags",
            "scope": "entity.name.tag",
            "settings": { "foreground": "#e06c75" }
        },
        {
            "name": "Attributes",
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#BB80B3" }
        },
        {
            "name": "Attribute IDs",
            "scope": "entity.other.attribute-name.id",
            "settings": { "foreground": "#61afef" }
        },
        {
            "name": "Attribute IDs",
            "scope": "punctuation.definition.entity",
            "settings": { "foreground": "#d19a66" }
        },
        {
            "name": "Selector",
            "scope": "meta.selector",
            "settings": { "foreground": "#c678dd" }
        },
        {
            "name": "Values",
            "scope": "none",
            "settings": { "foreground": "#D2945D" }
        },
        {
            "name": "Headings",
            "scope": "markup.heading",
            "settings": { "fontStyle": "", "foreground": "#e06c75" }
        },
        {
            "name": "Headings",
            "scope": "markup.heading punctuation.definition.heading, entity.name.section",
            "settings": { "foreground": "#61afef" }
        },
        {
            "name": "Units",
            "scope": "keyword.other.unit",
            "settings": { "foreground": "#d19a66" }
        },
        {
            "name": "Bold",
            "scope": "markup.bold",
            "settings": { "foreground": "#d19a66" }
        },
        {
            "name": "Bold",
            "scope": "punctuation.definition.bold",
            "settings": { "foreground": "#e5c07b" }
        },
        {
            "name": "Italic",
            "scope": "markup.italic, punctuation.definition.italic",
            "settings": { "foreground": "#c678dd" }
        },
        {
            "name": "Italic",
            "scope": "emphasis md",
            "settings": { "foreground": "#c678dd" }
        },
        {
            "name": "Bold Markdown",
            "scope": "strong md",
            "settings": { "foreground": "#d19a66" }
        },
        {
            "name": "Monospace Markdown",
            "scope": "variable md",
            "settings": { "foreground": "#98c379" }
        },
        {
            "name": "Keyword Markdown",
            "scope": "keyword md",
            "settings": { "fontStyle": "bold", "foreground": "#ffcb6b" }
        },
        {
            "name": "Code",
            "scope": "markup.raw.inline",
            "settings": { "foreground": "#f1e655" }
        },
        {
            "name": "Link Text",
            "scope": "string.other.link, punctuation.definition.string.end.markdown",
            "settings": { "foreground": "#99C794" }
        },
        {
            "name": "Link Url",
            "scope": "meta.link",
            "settings": { "foreground": "#F77669" }
        },
        {
            "name": "Lists",
            "scope": "markup.list",
            "settings": { "foreground": "#ff5370ff" }
        },
        {
            "name": "Quotes",
            "scope": "markup.quote",
            "settings": { "foreground": "#F77669" }
        },
        {
            "name": "Separator",
            "scope": "meta.separator",
            "settings": { "background": "#1e3445ff", "foreground": "#d9f5ddff" }
        },
        {
            "name": "Inserted",
            "scope": "markup.inserted",
            "settings": { "foreground": "#F1E655" }
        },
        {
            "name": "Deleted",
            "scope": "markup.deleted",
            "settings": { "foreground": "#ff5370ff" }
        },
        {
            "name": "Changed",
            "scope": "markup.changed",
            "settings": { "foreground": "#c792eaff" }
        },
        {
            "name": "Colors",
            "scope": "constant.other.color",
            "settings": { "foreground": "#FFEB95" }
        },
        {
            "name": "Regular Expressions",
            "scope": "string.regexp",
            "settings": { "foreground": "#57B6C2" }
        },
        {
            "name": "Escape Characters",
            "scope": "constant.character.escape",
            "settings": { "foreground": "#57B6C2" }
        },
        {
            "name": "Embedded",
            "scope": "punctuation.section.embedded, variable.interpolation",
            "settings": { "foreground": "#BE4F44" }
        },
        {
            "name": "Illegal",
            "scope": "invalid.illegal",
            "settings": { "background": "#EC5F67", "foreground": "#ffffffff" }
        },
        {
            "name": "Broken",
            "scope": "invalid.broken",
            "settings": { "background": "#F77669", "foreground": "#020e14ff" }
        },
        {
            "name": "Deprecated",
            "scope": "invalid.deprecated",
            "settings": { "background": "#d3423eff", "foreground": "#ffffffff" }
        },
        {
            "name": "Unimplemented",
            "scope": "invalid.unimplemented",
            "settings": {
                "background": "#8BD649747369",
                "foreground": "#ffffffff"
            }
        },
        {
            "name": "Json key",
            "scope": "source.json                           meta.structure.dictionary.json                              string.quoted.double.json",
            "settings": { "foreground": "#DF6A73" }
        },
        {
            "name": "Json value",
            "scope": "source.json                       meta.structure.dictionary.json                           meta.structure.dictionary.value.json                       string.quoted.double.json",
            "settings": { "foreground": "#90C378" }
        },
        {
            "name": "json sub key",
            "scope": "source.json                           meta.structure.dictionary.json                          meta.structure.dictionary.value.json                        meta.structure.dictionary.json                      string.quoted.double.json",
            "settings": { "foreground": "#DF6A73" }
        },
        {
            "name": "Json sub value",
            "scope": "source.json                       meta.structure.dictionary.json                        meta.structure.dictionary.value.json                       meta.structure.dictionary.json                          meta.structure.dictionary.value.json                            string.quoted.double.json",
            "settings": { "foreground": "#90C378" }
        },
        {
            "name": "laravel blade tag",
            "scope": "text.html.laravel-blade                        source.php.embedded.line.html                     entity.name.tag.laravel-blade",
            "settings": { "foreground": "#C679DD" }
        },
        {
            "name": "laravel blade @",
            "scope": "text.html.laravel-blade                         source.php.embedded.line.html                    support.constant.laravel-blade",
            "settings": { "foreground": "#C679DD" }
        },
        {
            "name": "python function decorator @",
            "scope": "meta.function.decorator.python",
            "settings": { "foreground": "#61afef" }
        },
        {
            "name": "python function support",
            "scope": "support.token.decorator.python",
            "settings": { "foreground": "#56B6C2" }
        },
        {
            "name": "parameter function",
            "scope": "function.parameter",
            "settings": { "foreground": "#d19a66" }
        },
        {
            "name": "parameter function js",
            "scope": "function.parameter.js,function.parameter.ts",
            "settings": { "foreground": "#abb2bf" }
        },
        {
            "name": "Control js",
            "scope": "control.js",
            "settings": { "foreground": "#c792ea" }
        },
        {
            "name": "Func Decl js",
            "scope": "js.meta.brace.paren",
            "settings": { "foreground": "#82AAFF" }
        },
        {
            "name": "Token js meta new expr type name",
            "scope": "js.meta.new.expr.type.name",
            "settings": { "foreground": "#C594C5" }
        },
        {
            "name": "Paren, Func Decl Block, Keyword Others",
            "scope": "js.meta.brace.paren,keyword.js.others",
            "settings": { "foreground": "#5FB3B3" }
        },
        {
            "name": "brace function",
            "scope": "function.brace",
            "settings": { "foreground": "#abb2bf" }
        },
        {
            "name": "parameter function ruby cs",
            "scope": "function.parameter.ruby, function.parameter.cs",
            "settings": { "foreground": "#abb2bf" }
        },
        {
            "name": "rgb-value",
            "scope": "rgb-value",
            "settings": { "foreground": "#56B6C2" }
        },
        {
            "name": "rgb value #",
            "scope": "inline-color-decoration rgb-value",
            "settings": { "foreground": "#d19a66" }
        },
        {
            "name": "rgb value less",
            "scope": "less rgb-value",
            "settings": { "foreground": "#d19a66" }
        },
        {
            "name": "sass selector",
            "scope": "selector.sass",
            "settings": { "foreground": "#e06c75" }
        },
        {
            "name": "js ts this",
            "scope": "var.this.js,var.this.ts",
            "settings": { "foreground": "#DF6A73" }
        },
        {
            "name": "js ts this",
            "scope": "token.detected-link",
            "settings": { "foreground": "#99C794", "fontStyle": "bold italic" }
        },
        {
            "name": "XML string",
            "scope": "meta.tag.xml.string.quoted.double.detected-link,meta.tag.preprocessor.xml.string.quoted.double,meta.tag.xml.string.quoted.double",
            "settings": { "foreground": "#99C794" }
        },
        {
            "name": "bracket tag js-html",
            "scope": "token.meta.js.punctuation.definition.begin.block.class.method.declaration.tag.without-attributes",
            "settings": { "foreground": "#5FB3B3" }
        },
        {
            "name": "text tag js-html",
            "scope": "token.meta.js.block.class.method.declaration.tag.without-attributes.jsx.children.tsx",
            "settings": { "foreground": "#CDD3DE" }
        },
        {
            "name": "function from var js",
            "scope": "token.meta.js.function.var.expr.support.dom",
            "settings": { "foreground": "#CDD3DE", "fontStyle": "italic" }
        },
        {
            "name": "function from var js",
            "scope": "token.meta.js.variable.var.expr.support.dom.property",
            "settings": { "foreground": "#CDD3DE" }
        },
        {
            "scope": "token.info-token",
            "settings": { "foreground": "#6796e6" }
        },
        {
            "scope": "token.warn-token",
            "settings": { "foreground": "#cd9731" }
        },
        {
            "scope": "token.error-token",
            "settings": { "foreground": "#f44747" }
        },
        {
            "scope": "token.debug-token",
            "settings": { "foreground": "#b267e6" }
        }
    ]
}
