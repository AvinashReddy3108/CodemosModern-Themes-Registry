    "semanticHighlighting": true,
    "semanticTokenColors": {
        "comment": { "foreground": "#555555" },
        "string": { "foreground": "#707070" },
        "keyword": { "foreground": "#9d9d9d" },
        "operator": { "foreground": "#9d9d9d" },
        "number": { "foreground": "#878787" },
        "regexp": "#707070",
        "namespace": { "foreground": "#eaeaea", "fontStyle": "underline" },
        "interface": { "foreground": "#eaeaea" },
        "type": { "foreground": "#eaeaea" },
        "class": { "foreground": "#878787" },
        "variable": { "foreground": "#878787" },
        "property": { "foreground": "#8e8b85", "fontStyle": "italic" },
        "event": { "foreground": "#8e8b85", "fontStyle": "underline" },
        "parameter": { "foreground": "#878787", "fontStyle": "bold underline" },
        "function": { "foreground": "#c0c0c0" },
        "function.async": {
            "foreground": "#c0c0c0",
            "fontStyle": "bold underline"
        },
        "method": { "foreground": "#c0c0c0", "fontStyle": "italic" }
    },
    "tokenColors": [
        {
            "name": "Keyword",
            "scope": [
                "keyword",
                "keyword.operator",
                "keyword.operator.logical",
                "keyword.operator.constructor",
                "storage"
            ],
            "settings": { "foreground": "#9d9d9d" }
        },
        {
            "name": "Package Import",
            "scope": ["storage.modifier.import", "storage.modifier.package"],
            "settings": { "foreground": "#878787" }
        },
        {
            "name": "Types",
            "scope": ["storage.type", "support.type", "support.variable"],
            "settings": { "foreground": "#eaeaea" }
        },
        {
            "name": "Class",
            "scope": [
                "entity.name.class",
                "entity.name.module",
                "entity.name.type",
                "storage.identifier",
                "support.class"
            ],
            "settings": { "foreground": "#878787" }
        },
        {
            "name": "Inherited Class",
            "scope": "entity.other.inherited-class",
            "settings": { "foreground": "#c0c0c0" }
        },
        {
            "name": "Function name",
            "scope": [
                "entity.name.function",
                "support.function",
                "function.support.builtin",
                "function.support.core"
            ],
            "settings": { "foreground": "#c0c0c0" }
        },
        {
            "name": "Parameter",
            "scope": [
                "variable.parameter",
                "entity.name.variable.parameter",
                "parameter.variable"
            ],
            "settings": { "fontStyle": "italic", "foreground": "#878787" }
        },
        {
            "name": "Function call",
            "scope": "entity.name.function-call",
            "settings": { "foreground": "#8e8b85" }
        },
        {
            "name": "Constant",
            "scope": [
                "constant.language",
                "constant.character",
                "support.constant"
            ],
