{
    "name": "cesar05-dark",
    "colors": {
        "editor.background": "#1e1e2e",
        "editor.foreground": "#dcdfe4",
        "activityBar.background": "#28293d",
        "activityBar.foreground": "#ffffff",
        "sideBar.background": "#212133",
        "sideBar.foreground": "#c5c8d6",
        "statusBar.background": "#28293d",
        "statusBar.foreground": "#ffffff",
        "tab.activeBackground": "#2e2e42",
        "tab.inactiveBackground": "#1e1e2e",
        "tab.activeForeground": "#ffffff",
        "tab.inactiveForeground": "#888cb8"
    },
    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#7f8c8d", "fontStyle": "italic" }
        },
        {
            "name": "String",
            "scope": ["string"],
            "settings": { "foreground": "#78e08f" }
        },
        {
            "name": "Number, Constant",
            "scope": ["constant.numeric", "constant.language"],
            "settings": { "foreground": "#f6e58d" }
        },
        {
            "name": "Keyword",
            "scope": ["keyword", "storage.type"],
            "settings": { "foreground": "#f8a5c2" }
        },
        {
            "name": "Function",
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#82ccdd" }
        },
        {
            "name": "Variable",
            "scope": ["variable", "identifier"],
            "settings": { "foreground": "#dcdfe4" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
