{
    "name": "EnOceanic",
    "colors": {
        "editor.background": "#1E262C",
        "editor.foreground": "#D4D4D4",
        "editor.selectionBackground": "#264F78",
        "editor.lineHighlightBackground": "#2B2B2B",
        "editorCursor.foreground": "#FFFFFF",
        "editorWhitespace.foreground": "#3A3A3A",
        "editorLineNumber.foreground": "#646464",
        "editorLineNumber.activeForeground": "#C8C8C8",
        "editorGutter.background": "#1E262C",
        "editorGroupHeader.tabsBackground": "#1E262C",
        "editorGroup.border": "#454545"
    },
    "tokenColors": [
        {
            "scope": "comment",
            "settings": { "foreground": "#6A9955", "fontStyle": "" }
        },
        {
            "scope": "keyword",
            "settings": { "foreground": "#C586C0", "fontStyle": "bold" }
        },
        {
            "scope": "string",
            "settings": { "foreground": "#CE9178", "fontStyle": "" }
        },
        {
            "scope": "constant",
            "settings": { "foreground": "#D19A66", "fontStyle": "" }
        },
        {
            "scope": "variable",
            "settings": { "foreground": "#9CDCFE", "fontStyle": "" }
        },
        {
            "scope": "support.function",
            "settings": { "foreground": "#DCDCAA", "fontStyle": "" }
        },
        {
            "scope": "entity.name.function",
            "settings": { "foreground": "#DCDCAA", "fontStyle": "" }
        },
        {
            "scope": "entity.name.class",
            "settings": { "foreground": "#4EC9B0", "fontStyle": "" }
        },
        {
            "scope": "entity.name.tag",
            "settings": { "foreground": "#569CD6", "fontStyle": "" }
        },
        {
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#9CDCFE", "fontStyle": "" }
        },
        {
            "scope": "meta.property-name",
            "settings": { "foreground": "#9CDCFE", "fontStyle": "" }
        },
        {
            "scope": "punctuation",
            "settings": { "foreground": "#D4D4D4", "fontStyle": "" }
        },
        {
            "scope": "storage.type",
            "settings": { "foreground": "#C586C0", "fontStyle": "" }
        },
        {
            "scope": "support.type",
            "settings": { "foreground": "#4EC9B0", "fontStyle": "" }
        },
        {
            "scope": "meta.diff.header",
            "settings": { "foreground": "#569CD6", "fontStyle": "" }
        },
        {
            "scope": "markup.deleted",
            "settings": { "foreground": "#9A050F", "fontStyle": "" }
        },
        {
            "scope": "markup.inserted",
            "settings": { "foreground": "#55A532", "fontStyle": "" }
        },
        {
            "scope": "markup.changed",
            "settings": { "foreground": "#B10DC9", "fontStyle": "" }
        },
        {
            "scope": "invalid",
            "settings": {
                "foreground": "#FFFFFF",
                "background": "#FF5370",
                "fontStyle": ""
            }
        },
        {
            "scope": "invalid.deprecated",
            "settings": {
                "foreground": "#FFFFFF",
                "background": "#FF5370",
                "fontStyle": ""
            }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
