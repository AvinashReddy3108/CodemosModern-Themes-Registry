{
    "name": "EnDracula",
    "colors": {
        "editor.background": "#282a36",
        "editor.foreground": "#f8f8f2",
        "editor.selectionBackground": "#44475a",
        "editor.lineHighlightBackground": "#44475a",
        "editorCursor.foreground": "#f8f8f0",
        "editorWhitespace.foreground": "#3E3D32",
        "editorLineNumber.foreground": "#6272a4",
        "editorLineNumber.activeForeground": "#8be9fd",
        "editorGutter.background": "#282a36",
        "editorGroupHeader.tabsBackground": "#282a36",
        "editorGroup.border": "#44475a"
    },
    "tokenColors": [
        {
            "scope": "comment",
            "settings": { "foreground": "#6272a4", "fontStyle": "" }
        },
        {
            "scope": "keyword",
            "settings": { "foreground": "#ff79c6", "fontStyle": "bold" }
        },
        {
            "scope": "string",
            "settings": { "foreground": "#f1fa8c", "fontStyle": "" }
        },
        {
            "scope": "constant",
            "settings": { "foreground": "#bd93f9", "fontStyle": "" }
        },
        {
            "scope": "variable",
            "settings": { "foreground": "#50fa7b", "fontStyle": "" }
        },
        {
            "scope": "support.function",
            "settings": { "foreground": "#8be9fd", "fontStyle": "" }
        },
        {
            "scope": "entity.name.function",
            "settings": { "foreground": "#8be9fd", "fontStyle": "" }
        },
        {
            "scope": "entity.name.class",
            "settings": { "foreground": "#50fa7b", "fontStyle": "" }
        },
        {
            "scope": "entity.name.tag",
            "settings": { "foreground": "#ff79c6", "fontStyle": "" }
        },
        {
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#bd93f9", "fontStyle": "" }
        },
        {
            "scope": "meta.property-name",
            "settings": { "foreground": "#bd93f9", "fontStyle": "" }
        },
        {
            "scope": "punctuation",
            "settings": { "foreground": "#f8f8f2", "fontStyle": "" }
        },
        {
            "scope": "storage.type",
            "settings": { "foreground": "#ff79c6", "fontStyle": "" }
        },
        {
            "scope": "support.type",
            "settings": { "foreground": "#8be9fd", "fontStyle": "" }
        },
        {
            "scope": "meta.diff.header",
            "settings": { "foreground": "#6272a4", "fontStyle": "" }
        },
        {
            "scope": "markup.deleted",
            "settings": { "foreground": "#ff5555", "fontStyle": "" }
        },
        {
            "scope": "markup.inserted",
            "settings": { "foreground": "#50fa7b", "fontStyle": "" }
        },
        {
            "scope": "markup.changed",
            "settings": { "foreground": "#f1fa8c", "fontStyle": "" }
        },
        {
            "scope": "invalid",
            "settings": {
                "foreground": "#ff5555",
                "background": "#282a36",
                "fontStyle": ""
            }
        },
        {
            "scope": "invalid.deprecated",
            "settings": {
                "foreground": "#ff5555",
                "background": "#282a36",
                "fontStyle": ""
            }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
