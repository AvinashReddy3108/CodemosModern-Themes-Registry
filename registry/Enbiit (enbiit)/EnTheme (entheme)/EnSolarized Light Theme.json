{
    "name": "EnSolarized Light",
    "colors": {
        "editor.background": "#fdf6e3",
        "editor.foreground": "#657b83",
        "editor.selectionBackground": "#eee8d5",
        "editor.lineHighlightBackground": "#eee8d5",
        "editorCursor.foreground": "#657b83",
        "editorWhitespace.foreground": "#fdf6e3",
        "editorLineNumber.foreground": "#93a1a1",
        "editorLineNumber.activeForeground": "#586e75",
        "editorGutter.background": "#fdf6e3",
        "editorGroupHeader.tabsBackground": "#fdf6e3",
        "editorGroup.border": "#eee8d5"
    },
    "tokenColors": [
        {
            "scope": "comment",
            "settings": { "foreground": "#93a1a1", "fontStyle": "" }
        },
        {
            "scope": "keyword",
            "settings": { "foreground": "#859900", "fontStyle": "bold" }
        },
        {
            "scope": "string",
            "settings": { "foreground": "#2aa198", "fontStyle": "" }
        },
        {
            "scope": "constant",
            "settings": { "foreground": "#b58900", "fontStyle": "" }
        },
        {
            "scope": "variable",
            "settings": { "foreground": "#268bd2", "fontStyle": "" }
        },
        {
            "scope": "support.function",
            "settings": { "foreground": "#268bd2", "fontStyle": "" }
        },
        {
            "scope": "entity.name.function",
            "settings": { "foreground": "#268bd2", "fontStyle": "" }
        },
        {
            "scope": "entity.name.class",
            "settings": { "foreground": "#268bd2", "fontStyle": "bold" }
        },
        {
            "scope": "entity.name.tag",
            "settings": { "foreground": "#268bd2", "fontStyle": "" }
        },
        {
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#268bd2", "fontStyle": "" }
        },
        {
            "scope": "meta.property-name",
            "settings": { "foreground": "#268bd2", "fontStyle": "" }
        },
        {
            "scope": "punctuation",
            "settings": { "foreground": "#657b83", "fontStyle": "" }
        },
        {
            "scope": "storage.type",
            "settings": { "foreground": "#268bd2", "fontStyle": "bold" }
        },
        {
            "scope": "support.type",
            "settings": { "foreground": "#268bd2", "fontStyle": "" }
        },
        {
            "scope": "meta.diff.header",
            "settings": { "foreground": "#b58900", "fontStyle": "" }
        },
        {
            "scope": "markup.deleted",
            "settings": { "foreground": "#dc322f", "fontStyle": "" }
        },
        {
            "scope": "markup.inserted",
            "settings": { "foreground": "#859900", "fontStyle": "" }
        },
        {
            "scope": "markup.changed",
            "settings": { "foreground": "#268bd2", "fontStyle": "" }
        },
        {
            "scope": "invalid",
            "settings": {
                "foreground": "#657b83",
                "background": "#dc322f",
                "fontStyle": ""
            }
        },
        {
            "scope": "invalid.deprecated",
            "settings": {
                "foreground": "#657b83",
                "background": "#dc322f",
                "fontStyle": ""
            }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
