{
    "name": "Krishna Dark Elegant",
    "colors": {
        "editor.background": "#1D2938",
        "editor.foreground": "#E8DCCB",
        "terminal.background": "#1B242F",
        "terminal.foreground": "#E8DCCB",
        "terminalCursor.foreground": "#FFD700",
        "terminal.ansiBlack": "#1D2938",
        "terminal.ansiRed": "#EF5350",
        "terminal.ansiGreen": "#A5D6A7",
        "terminal.ansiYellow": "#FBC02D",
        "terminal.ansiBlue": "#64B5F6",
        "terminal.ansiMagenta": "#BA68C8",
        "terminal.ansiCyan": "#4DD0E1",
        "terminal.ansiWhite": "#E8DCCB",
        "panel.background": "#212F3C",
        "panel.border": "#3A4A5C",
        "panelTitle.activeBorder": "#FFD700",
        "panelTitle.activeForeground": "#FFEB3B",
        "panelTitle.inactiveForeground": "#9E9E9E",
        "sideBar.background": "#202E3B",
        "sideBar.foreground": "#D0E6DD",
        "sideBarSectionHeader.foreground": "#A5D6A7",
        "activityBar.background": "#1C2A38",
        "activityBar.foreground": "#FFE082",
        "activityBarBadge.background": "#C9A200",
        "activityBarBadge.foreground": "#1D2938",
        "tab.activeBackground": "#263545",
        "tab.activeForeground": "#FFEB95",
        "tab.inactiveBackground": "#1D2938",
        "tab.inactiveForeground": "#888C91",
        "tab.border": "#1D2938",
        "statusBar.background": "#15222E",
        "statusBar.foreground": "#E8DCCB",
        "statusBar.debuggingBackground": "#EF5350",
        "titleBar.activeBackground": "#1D2938",
        "titleBar.activeForeground": "#F5EEDC",
        "titleBar.inactiveBackground": "#1A232D",
        "titleBar.inactiveForeground": "#A0A0A0"
    },
    "tokenColors": [
        {
            "name": "Object Base Names",
            "match": "\\b\\w+(?=\\.)",
            "settings": { "foreground": "#5CC6D0" }
        },
        {
            "name": "Property Names",
            "match": "(?<=\\.)\\w+",
            "settings": { "foreground": "#FBC02D" }
        },
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "fontStyle": "italic", "foreground": "#7A8B99" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "variable.other.readwrite"],
            "settings": { "foreground": "#F0EAD6" }
        },
        {
            "name": "Constants & Numbers",
            "scope": ["constant", "constant.numeric", "constant.language"],
            "settings": { "foreground": "#D4A017" }
        },
        {
            "name": "Strings",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#6FA6C8" }
        },
        {
            "name": "Keywords",
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#A48FB2", "fontStyle": "bold" }
        },
        {
            "name": "Operators & Punctuation",
            "scope": [
                "keyword.control",
                "punctuation",
                "meta.brace",
                "meta.delimiter"
            ],
            "settings": { "foreground": "#B2677B" }
        },
        {
            "name": "Tags",
            "scope": ["entity.name.tag", "meta.tag.sgml"],
            "settings": { "foreground": "#81D4FA" }
        },
        {
            "name": "Functions",
            "scope": ["entity.name.function"],
            "settings": { "foreground": "#FFCC00" }
        },
        {
            "name": "Function Calls",
            "scope": ["meta.function-call"],
            "settings": { "foreground": "#FFCC00", "fontStyle": "italic" }
        },
        {
            "name": "Methods",
            "scope": ["entity.name.method", "support.function.builtin"],
            "settings": { "foreground": "#8E8CD8" }
        },
        {
            "name": "Classes & Types",
            "scope": ["entity.name.type", "support.class", "support.type"],
            "settings": { "foreground": "#82D8D5" }
        },
        {
            "name": "Decorators",
            "scope": ["decorator", "tag.decorator.js"],
            "settings": { "fontStyle": "italic", "foreground": "#A678C6" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#EF5350" }
        },
        {
            "name": "JSON Keys",
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#9CCC65" }
        },
        {
            "name": "Markup - Headings",
            "scope": ["markup.heading", "entity.name.section"],
            "settings": { "fontStyle": "bold", "foreground": "#F57F17" }
        },
        {
            "name": "Markup - Bold",
            "scope": ["markup.bold"],
            "settings": { "fontStyle": "bold", "foreground": "#D96C79" }
        },
        {
            "name": "Markup - Italic",
            "scope": ["markup.italic"],
            "settings": { "fontStyle": "italic", "foreground": "#B39DDB" }
        },
        {
            "name": "Markup - Underline",
            "scope": ["markup.underline"],
            "settings": { "fontStyle": "underline", "foreground": "#FFF59D" }
        },
        {
            "name": "Markup - Link",
            "scope": ["markup.underline.link", "string.other.link"],
            "settings": { "foreground": "#7986CB" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
