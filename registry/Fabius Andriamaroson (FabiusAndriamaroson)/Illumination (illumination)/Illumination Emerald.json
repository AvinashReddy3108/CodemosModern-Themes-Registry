    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "fontStyle": "italic", "foreground": "#218c7470" }
        },
        {
            "name": "Italics - Comments, Storage, Keyword Flow, Vue attributes, Decorators",
            "scope": [
                "meta.var.expr storage.type",
                "keyword.control.flow",
                "keyword.control.return",
                "meta.directive.vue punctuation.separator.key-value.html",
                "meta.directive.vue entity.other.attribute-name.html",
                "tag.decorator.js entity.name.tag.js",
                "tag.decorator.js punctuation.definition.tag.js",
                "storage.modifier"
            ],
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "Constant",
            "scope": "constant",
            "settings": { "foreground": "#ff4d4d" }
        },
        {
            "name": "Entity",
            "scope": "entity",
            "settings": { "foreground": "#fff200" }
        },
        {
            "name": "Function arguments",
            "scope": ["variable.parameter", "meta.parameter"],
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "Invalid",
            "scope": "invalid",
            "settings": { "foreground": "#ff3838" }
        },
        {
            "name": "Storage Type Function",
            "scope": "storage.type.function",
            "settings": { "foreground": "#ffb8b8" }
        },
        {
            "name": "Keyword",
            "scope": "keyword, storage.type.class, keyword.control.default.ts",
            "settings": { "foreground": "#ffb8b8" }
        },
        {
            "name": "Meta",
            "scope": "meta",
            "settings": { "foreground": "#ffffff" }
        },
        {
            "name": "Meta JSX",
            "scope": [
                "meta.jsx.children",
                "meta.jsx.children.js",
                "meta.jsx.children.tsx"
            ],
            "settings": { "fontStyle": "italic", "foreground": "#fff" }
        },
        {
            "name": "Meta Brace",
            "scope": "meta.brace",
            "settings": { "foreground": "#ffffff" }
        },
        {
            "name": "Punctuation",
            "scope": "punctuation",
            "settings": { "foreground": "#ffffff" }
        },
        {
            "name": "Punctuation Parameters",
            "scope": "punctuation.definition.parameters",
            "settings": { "fontStyle": "italic", "foreground": "#c7ecee" }
        },
        {
            "name": "Punctuation Template Expression",
            "scope": "punctuation.definition.template-expression",
            "settings": { "foreground": "#c7ecee" }
        },
        {
            "name": "Storage",
            "scope": "storage",
            "settings": { "foreground": "#fff200" }
        },
        {
            "name": "Storage Type Arrow Function",
            "scope": "storage.type.function.arrow",
            "settings": { "foreground": "#fff200" }
        },
        {
            "name": "String",
            "scope": ["string", "punctuation.definition.string"],
            "settings": { "foreground": "#32ff7e" }
        },
        {
            "name": "String Template",
            "scope": [
                "string.template",
