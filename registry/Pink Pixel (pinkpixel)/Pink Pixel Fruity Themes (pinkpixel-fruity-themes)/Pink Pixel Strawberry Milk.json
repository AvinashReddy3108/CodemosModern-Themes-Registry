    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#F8EEF2aa", "fontStyle": "italic" }
        },
        {
            "name": "Strings",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#fdccdb" }
        },
        {
            "name": "Numbers",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#F7B3C8" }
        },
        {
            "name": "Keywords",
            "scope": ["keyword", "storage", "storage.type"],
            "settings": { "foreground": "#f289ae", "fontStyle": "bold" }
        },
        {
            "name": "Operators",
            "scope": [
                "keyword.operator",
                "punctuation.separator",
                "punctuation.terminator"
            ],
            "settings": { "foreground": "#fe417d" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation",
                "punctuation.definition",
                "punctuation.section"
            ],
            "settings": { "foreground": "#fe417d" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "variable.parameter"],
            "settings": { "foreground": "#F8EEF2" }
        },
        {
            "name": "Constants",
            "scope": ["constant", "constant.language"],
            "settings": { "foreground": "#F7B3C8" }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "support.function",
                "variable.function"
            ],
            "settings": { "foreground": "#fdccdb" }
        },
        {
            "name": "Methods",
            "scope": ["entity.name.function.member", "meta.method-call"],
            "settings": { "foreground": "#F7B3C8" }
        },
        {
            "name": "Types / Classes",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.class",
                "support.type"
            ],
            "settings": { "foreground": "#f9a2be", "fontStyle": "bold" }
        },
        {
            "name": "Properties",
            "scope": ["variable.other.property", "meta.object-literal.key"],
            "settings": { "foreground": "#F8EEF2" }
        },
        {
            "name": "Tags",
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#f289ae" }
        },
        {
            "name": "Attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#F7B3C8" }
        },
        {
            "name": "Markdown headings",
            "scope": ["markup.heading", "entity.name.section.markdown"],
            "settings": { "foreground": "#F7B3C8", "fontStyle": "bold" }
        },
        {
            "name": "Markdown bold",
            "scope": ["markup.bold"],
            "settings": { "foreground": "#fdccdb", "fontStyle": "bold" }
        },
        {
            "name": "Markdown italic",
            "scope": ["markup.italic"],
            "settings": { "foreground": "#F7B3C8", "fontStyle": "italic" }
        },
        {
            "name": "Markdown inline code",
            "scope": ["markup.inline.raw", "markup.fenced_code.block"],
            "settings": { "foreground": "#f9a2be" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#C06C84", "fontStyle": "underline" }
        }
    ],
    "semanticTokenColors": {
        "namespace": "#fdccdb",
        "class": { "foreground": "#fdccdb", "bold": true },
        "enum": "#f9a2be",
        "interface": "#fdccdb",
        "struct": "#fdccdb",
        "type": "#F7B3C8",
        "typeParameter": "#F7B3C8",
        "parameter": "#F8EEF2",
        "variable": "#F8EEF2",
        "property": "#F8EEF2",
        "enumMember": "#F7B3C8",
        "event": "#F7B3C8",
        "function": "#F7B3C8",
        "method": "#F7B3C8",
        "macro": "#f289ae",
        "decorator": "#f9a2be",
        "keyword": { "foreground": "#f289ae", "bold": true },
        "comment": { "foreground": "#F8EEF2aa", "italic": true },
        "string": "#f9a2be",
        "number": "#f289ae",
        "regexp": "#F7B3C8",
        "operator": "#ff6394"
    },
    "$schema": "vscode://schemas/color-theme"
}
