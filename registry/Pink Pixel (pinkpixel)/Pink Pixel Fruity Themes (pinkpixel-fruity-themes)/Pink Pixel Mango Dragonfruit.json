    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#fbf1eeaa", "fontStyle": "italic" }
        },
        {
            "name": "Strings",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#ffea5f" }
        },
        {
            "name": "Numbers",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#ee7eff" }
        },
        {
            "name": "Keywords",
            "scope": ["keyword", "storage", "storage.type"],
            "settings": { "foreground": "#ff728c", "fontStyle": "bold" }
        },
        {
            "name": "Operators",
            "scope": [
                "keyword.operator",
                "punctuation.separator",
                "punctuation.terminator"
            ],
            "settings": { "foreground": "#94ff8d" }
        },
        {
            "name": "Punctuation",
            "scope": ["punctuation"],
            "settings": { "foreground": "#94ff8d" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "variable.parameter"],
            "settings": { "foreground": "#fbf1ee" }
        },
        {
            "name": "Constants",
            "scope": ["constant", "constant.language"],
            "settings": { "foreground": "#53ffda" }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "support.function",
                "variable.function"
            ],
            "settings": { "foreground": "#ffbb6e" }
        },
        {
            "name": "Methods",
            "scope": ["entity.name.function.member", "meta.method-call"],
            "settings": { "foreground": "#53ffda" }
        },
        {
            "name": "Types / Classes",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.class",
                "support.type"
            ],
            "settings": { "foreground": "#ffbb6e", "fontStyle": "bold" }
        },
        {
            "name": "Properties",
            "scope": ["variable.other.property", "meta.object-literal.key"],
            "settings": { "foreground": "#ee7eff" }
        },
        {
            "name": "Tags",
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#ff728c" }
        },
        {
            "name": "Attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#53ffda" }
        },
        {
            "name": "Markdown headings",
            "scope": ["markup.heading", "entity.name.section.markdown"],
            "settings": { "foreground": "#ffea5f", "fontStyle": "bold" }
        },
        {
            "name": "Markdown bold",
            "scope": ["markup.bold"],
            "settings": { "foreground": "#ffbb6e", "fontStyle": "bold" }
        },
        {
            "name": "Markdown italic",
            "scope": ["markup.italic"],
            "settings": { "foreground": "#ffea5f", "fontStyle": "italic" }
        },
        {
            "name": "Markdown inline code",
            "scope": ["markup.inline.raw", "markup.fenced_code.block"],
            "settings": { "foreground": "#ffbb6e" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#FF8C82", "fontStyle": "underline" }
        }
    ],
    "semanticTokenColors": {
        "namespace": "#ffbb6e",
        "class": { "foreground": "#ffbb6e", "bold": true },
        "enum": "#ffbb6e",
        "interface": "#53ffda",
        "struct": "#ffbb6e",
        "type": "#ffbb6e",
        "typeParameter": "#53ffda",
        "parameter": "#fbf1ee",
        "variable": "#fbf1ee",
        "property": "#ee7eff",
        "enumMember": "#53ffda",
        "event": "#53ffda",
        "function": "#ffbb6e",
        "method": "#ffea5f",
        "macro": "#ff728c",
        "decorator": "#ffbb6e",
        "keyword": { "foreground": "#ff728c", "bold": true },
        "comment": { "foreground": "#fbf1eeaa", "italic": true },
        "string": "#ffbb6e",
        "number": "#ee7eff",
        "regexp": "#94ff8d",
        "operator": "#94ff8d"
    },
    "$schema": "vscode://schemas/color-theme"
}
