        "tab.border": "#333333",
        "tab.inactiveBackground": "#4939FF20",
        "tab.inactiveForeground": "#FFE6DDaf",
        "tab.unfocusedActiveBorder": "#4939FF",
        "tab.unfocusedActiveBackground": "#4939FF40",
        "tab.unfocusedActiveForeground": "#FFE6DD",
        "tab.unfocusedInactiveBackground": "#4939FF10",
        "tab.unfocusedInactiveForeground": "#FFE6DD7f",
        "terminal.ansiBlack": "#333333",
        "terminal.ansiBlue": "#5272FF",
        "terminal.ansiBrightBlack": "#4939FF",
        "terminal.ansiBrightBlue": "#5272FF",
        "terminal.ansiBrightCyan": "#78B9FF",
        "terminal.ansiBrightGreen": "#008D07",
        "terminal.ansiBrightMagenta": "#00A444",
        "terminal.ansiBrightRed": "#0300B0",
        "terminal.ansiBrightWhite": "#FFF8CE",
        "terminal.ansiBrightYellow": "#00A444",
        "terminal.ansiCyan": "#78B9FF",
        "terminal.ansiGreen": "#008D07",
        "terminal.ansiMagenta": "#00A444",
        "terminal.ansiRed": "#0300B0",
        "terminal.ansiWhite": "#FFF8CE",
        "terminal.ansiYellow": "#00A444",
        "terminalCursor.background": "#333333",
        "terminalCursor.foreground": "#00A444",
        "textLink.activeForeground": "#FFE6DD",
        "textLink.foreground": "#4939FF",
