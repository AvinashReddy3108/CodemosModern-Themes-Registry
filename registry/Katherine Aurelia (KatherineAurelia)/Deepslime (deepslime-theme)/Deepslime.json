    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#9370DB", "fontStyle": "italic" }
        },
        {
            "name": "String",
            "scope": [
                "string",
                "string.quoted",
                "string.template",
                "string.regexp"
            ],
            "settings": { "foreground": "#C0A0E0" }
        },
        {
            "name": "String escape sequences",
            "scope": [
                "constant.character.escape",
                "constant.other.placeholder"
            ],
            "settings": { "foreground": "#CC99BB" }
        },
        {
            "name": "Number",
            "scope": ["constant.numeric", "constant.language.numeric"],
            "settings": { "foreground": "#CC99BB" }
        },
        {
            "name": "Built-in constant",
            "scope": [
                "constant.language",
                "constant.language.boolean",
                "constant.language.null",
                "constant.language.undefined"
            ],
            "settings": { "foreground": "#CC99BB" }
        },
        {
            "name": "User-defined constant",
            "scope": ["constant.character", "constant.other"],
            "settings": { "foreground": "#7DCDCD" }
        },
        {
            "name": "Variable",
            "scope": ["variable", "variable.other"],
            "settings": { "foreground": "#F0A060" }
        },
        {
            "name": "Variable property",
            "scope": [
                "variable.other.property",
                "variable.other.object.property"
            ],
            "settings": { "foreground": "#F0A060" }
        },
        {
            "name": "Variable language",
            "scope": ["variable.language"],
            "settings": { "foreground": "#B060FF", "fontStyle": "italic" }
        },
        {
            "name": "Keyword",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.new",
                "keyword.operator.expression",
                "keyword.operator.logical"
            ],
            "settings": { "foreground": "#B060FF", "fontStyle": "bold" }
        },
        {
            "name": "Keyword operator",
            "scope": [
                "keyword.operator",
                "keyword.operator.comparison",
                "keyword.operator.assignment",
                "keyword.operator.arithmetic"
            ],
            "settings": { "foreground": "#7DCDCD" }
        },
        {
            "name": "Storage",
            "scope": ["storage", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#B060FF", "fontStyle": "bold" }
        },
        {
            "name": "Class name",
            "scope": [
                "entity.name.class",
                "entity.name.type.class",
                "support.class"
            ],
            "settings": { "foreground": "#D850C0", "fontStyle": "bold" }
        },
        {
            "name": "Inherited class",
            "scope": ["entity.other.inherited-class"],
            "settings": { "foreground": "#C98FC9", "fontStyle": "italic" }
        },
        {
            "name": "Function name",
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#80E0C0" }
        },
        {
            "name": "Function argument",
            "scope": ["variable.parameter", "meta.function.parameters"],
            "settings": { "foreground": "#A0B0E0" }
        },
        {
