{
    "name": "Pure Sheet",
    "type": "light",
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "keyword.documentation": {
            "foreground": "#4C770F",
            "fontStyle": "bold"
        },
        "interface": { "foreground": "#000000" },
        "class": { "foreground": "#000000", "fontStyle": "" },
        "class.declaration.constructor": {
            "foreground": "#474747",
            "fontStyle": "bold"
        },
        "namespace": { "foreground": "#3a3a3a", "bold": false },
        "parameter": { "foreground": "#6A3E3E" },
        "method": { "foreground": "#000000", "fontStyle": "" },
        "method.declaration": { "foreground": "#474747", "fontStyle": "bold" },
        "method.static": { "foreground": "#000000", "fontStyle": "italic" },
        "method.static.declaration": {
            "foreground": "#474747",
            "fontStyle": "bold"
        },
        "function.declaration": {
            "foreground": "#474747",
            "fontStyle": "bold"
        },
        "property": { "foreground": "#063FDC" },
        "property.static": { "italic": true, "bold": true },
        "variable": { "foreground": "#6A3E3E" }
    },
    "colors": {
        "editor.background": "#F9F9F9",
        "editor.foreground": "#000000",
        "terminal.ansiBlue": "#3465a4",
        "terminal.ansiBrightBlue": "#729fcf",
        "terminal.ansiBrightGreen": "#8ae234",
        "terminal.ansiBrightYellow": "#fce94f",
        "terminal.ansiGreen": "#4e9a06",
        "terminal.ansiYellow": "#c4a000",
        "foreground": "#303030",
        "tab.activeBorder": "#4C770F"
    },
    "tokenColors": [
        {
            "scope": ["string"],
            "settings": { "foreground": "#2A00FF", "fontStyle": "" }
        },
        {
            "scope": [
                "constant.character.escape",
                "constant.other.placeholder"
            ],
            "settings": { "foreground": "#7090FF", "fontStyle": "" }
        },
        {
            "scope": ["constant.numeric", "keyword.other.unit"],
            "settings": { "foreground": "#FF00AA", "fontStyle": "" }
        },
        {
            "scope": [
                "keyword",
                "storage.type.primitive",
                "storage.type.class",
                "storage.type.struct",
                "storage.type.enum",
                "storage.type.modifier",
                "storage.type.namespace",
                "storage.type.template",
                "storage.type.function",
                "storage.type.union",
                "storage.type.js",
                "storage.type.ts",
                "storage.type.type.ts",
                "storage.type.interface",
                "storage.type.impl",
                "storage.type.trait",
                "storage.modifier",
                "keyword.operator.expression",
                "keyword.operator.new",
                "keyword.operator.delete",
                "keyword.operator.word",
                "keyword.operator.sizeof",
                "keyword.operator.alignof",
                "keyword.operator.logical.python",
                "constant.language",
                "variable.language",
                "keyword.declaration.function",
                "keyword.declaration.class",
                "keyword.declaration.struct",
                "keyword.declaration.enum",
                "keyword.declaration.union",
                "keyword.declaration.trait",
                "keyword.declaration.interface",
                "keyword.declaration.impl",
                "keyword.declaration.type"
            ],
            "settings": { "foreground": "#C43A1A", "fontStyle": "bold" }
        },
        {
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#3a3a3a", "fontStyle": "" }
        },
        {
            "scope": ["entity.name.type", "storage.type"],
            "settings": { "foreground": "#000000" }
        },
        {
            "scope": ["entity.name.type.template"],
            "settings": { "foreground": "#336633", "fontStyle": "bold" }
        },
        {
            "scope": ["meta.kernel-call punctuation.section.kernel"],
            "settings": { "foreground": "#336633", "fontStyle": "bold" }
        },
        {
            "scope": ["meta.kernel-call entity.name.function"],
            "settings": { "foreground": "#336633", "fontStyle": "" }
        },
        {
            "scope": ["variable.other.member", "variable.other.property"],
            "settings": { "foreground": "#333333", "fontStyle": "" }
        },
        {
            "scope": ["meta.preprocessor"],
            "settings": { "foreground": "#808080", "fontStyle": "" }
        },
        {
            "scope": ["meta.preprocessor keyword.control.directive"],
            "settings": { "foreground": "#7F3F6A", "fontStyle": "bold" }
        },
        {
            "scope": ["meta.preprocessor string.quoted"],
            "settings": { "foreground": "#9580FF", "fontStyle": "" }
        },
        {
            "scope": [
                "variable.parameter.function.language.special.self",
                "variable.language.special.self",
                "variable.parameter.function.language.special.cls",
                "variable.language.special.cls"
            ],
            "settings": { "foreground": "#000000", "fontStyle": "italic" }
        },
        {
            "scope": ["entity.name.function.decorator"],
            "settings": { "foreground": "#7D7D7D", "fontStyle": "italic" }
        },
        {
            "scope": ["string.quoted.docstring"],
            "settings": { "foreground": "#406080", "fontStyle": "" }
        },
        {
            "scope": [
                "entity.name.tag",
                "punctuation.definition.tag",
                "support.type.property-name",
                "keyword.other.definition.ini",
                "support.identifier.java-properties"
            ],
            "settings": { "foreground": "#C43A1A", "fontStyle": "bold" }
        },
        {
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#6A3E3E", "fontStyle": "" }
        },
        {
            "scope": [
                "meta.tag.preprocessor entity.name.tag",
                "meta.tag.preprocessor entity.other.attribute-name",
                "meta.tag.preprocessor string",
                "meta.tag.preprocessor text",
                "meta.tag.metadata.doctype entity.name.tag",
                "meta.tag.metadata.doctype entity.other.attribute-name",
                "meta.tag.metadata.doctype string",
                "meta.tag.metadata.doctype text"
            ],
            "settings": { "foreground": "#5F8FBF", "fontStyle": "italic" }
        },
        {
            "scope": [
                "entity.name.section",
                "markup.heading",
                "punctuation.definition.heading"
            ],
            "settings": { "foreground": "#C43A1A", "fontStyle": "bold" }
        },
        {
            "scope": ["markup.inline.raw", "punctuation.definition.raw"],
            "settings": { "foreground": "#FF00AA", "fontStyle": "" }
        },
        {
            "scope": ["punctuation.definition.list"],
            "settings": { "foreground": "#000000", "fontStyle": "bold" }
        },
        {
            "scope": ["markup.bold"],
            "settings": { "foreground": "#000000", "fontStyle": "bold" }
        },
        {
            "scope": ["markup.underline"],
            "settings": { "foreground": "#000000", "fontStyle": "underline" }
        },
        { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
        {
            "scope": ["keyword.codetag"],
            "settings": { "foreground": "#86A3BF", "fontStyle": "bold" }
        },
        {
            "scope": "markup.raw.block",
            "settings": { "foreground": "#696969", "fontStyle": "italic" }
        },
        {
            "scope": "markup.inline.raw.string",
            "settings": { "foreground": "#696969", "fontStyle": "italic" }
        },
        {
            "scope": ["entity.name.section"],
            "settings": { "foreground": "#C43A1A", "fontStyle": "bold" }
        },
        {
            "scope": ["comment", "comment.block.xml"],
            "settings": { "foreground": "#878787" }
        },
        { "scope": "comment.block", "settings": { "foreground": "#4C770F" } },
        { "scope": "string", "settings": { "foreground": "#0749BC" } },
        {
            "scope": "source",
            "settings": { "foreground": "#000000", "fontStyle": "" }
        },
        { "scope": "storage.type", "settings": { "foreground": "#000000" } },
        {
            "scope": "storage.type.annotation",
            "settings": { "foreground": "#707070" }
        },
        {
            "scope": "storage.type.primitive",
            "settings": { "foreground": "#C43A1A" }
        },
        {
            "scope": "storage.modifier",
            "settings": { "foreground": "#C43A1A" }
        },
        {
            "scope": "storage.modifier.package.java",
            "settings": { "fontStyle": "" }
        },
        {
            "scope": "storage.modifier.import",
            "settings": { "foreground": "#000000", "fontStyle": "" }
        },
        {
            "scope": "punctuation.definition.annotation",
            "settings": { "foreground": "#707070" }
        },
        {
            "scope": "constant.language",
            "settings": { "foreground": "#C43A1A" }
        },
        {
            "scope": "constant.numeric",
            "settings": { "foreground": "#333333" }
        },
        {
            "scope": "variable.language.this",
            "settings": { "foreground": "#C43A1A" }
        },
        { "scope": "keyword", "settings": { "foreground": "#C43A1A" } },
        { "scope": "text", "settings": { "foreground": "#000000" } },
        {
            "scope": ["text.xml", "source.ini"],
            "settings": { "foreground": "#0749BC" }
        },
        {
            "scope": "token.info-token",
            "settings": { "foreground": "#316BCD" }
        },
        {
            "scope": "token.warn-token",
            "settings": { "foreground": "#CD9731" }
        },
        {
            "scope": "token.error-token",
            "settings": { "foreground": "#CD3131" }
        },
        {
            "scope": "token.debug-token",
            "settings": { "foreground": "#800080" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
