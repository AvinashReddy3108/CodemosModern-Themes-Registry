        "editorWidget.background": "#000000",
        "editorWidget.border": "#ffff00",
        "editorWidget.foreground": "#d6deeb"
    },
    "tokenColors": [
        {
            "scope": "comment",
            "settings": { "foreground": "#00ff00", "fontStyle": "italic" }
        },
        { "scope": "string", "settings": { "foreground": "#ffff00" } },
        {
            "scope": "constant.numeric",
            "settings": { "foreground": "#ff6b6b" }
        },
        {
            "scope": "constant.language",
            "settings": { "foreground": "#ff1493" }
        },
        {
            "scope": ["constant.character", "constant.other"],
            "settings": { "foreground": "#ff1493" }
        },
        { "scope": "variable", "settings": { "fontStyle": "" } },
        { "scope": "keyword", "settings": { "foreground": "#00ffff" } },
        { "scope": "storage", "settings": { "foreground": "#00ffff" } },
        { "scope": "storage.type", "settings": { "foreground": "#00ffff" } },
        {
            "scope": "entity.name.class",
            "settings": {
                "fontStyle": "underline bold",
                "foreground": "#ffff00"
            }
        },
        {
            "scope": "entity.other.inherited-class",
            "settings": {
                "fontStyle": "italic underline bold",
                "foreground": "#00ff7f"
            }
        },
        {
            "scope": "entity.name.function",
            "settings": { "fontStyle": "bold", "foreground": "#00bfff" }
        },
        {
            "scope": "variable.parameter",
            "settings": { "fontStyle": "italic bold", "foreground": "#ff6b6b" }
        },
        {
            "scope": "entity.name.tag",
            "settings": { "fontStyle": "bold", "foreground": "#ff1493" }
        },
        {
            "scope": [
                "entity.name.tag.html.h1",
                "entity.name.tag.html.h2",
                "entity.name.tag.html.h3",
                "entity.name.tag.html.h4",
                "entity.name.tag.html.h5",
                "entity.name.tag.html.h6"
            ],
            "settings": { "foreground": "#ffffff", "fontStyle": "bold" }
        },
        {
            "scope": "entity.other.attribute-name",
            "settings": { "fontStyle": "bold", "foreground": "#ffff00" }
        },
        {
            "scope": [
                "entity.other.attribute-name.html.className",
                "entity.other.attribute-name.jsx",
                "support.other.attribute-name.jsx",
                "meta.attribute.jsx"
            ],
            "settings": { "fontStyle": "bold", "foreground": "#ffff00" }
        },
        {
            "scope": "support.function",
            "settings": { "fontStyle": "bold", "foreground": "#00ff7f" }
        },
        {
            "scope": "support.constant",
            "settings": { "fontStyle": "bold", "foreground": "#00ff7f" }
        },
        {
            "scope": ["support.type", "support.class"],
            "settings": { "fontStyle": "italic bold", "foreground": "#00ffff" }
        },
        { "scope": "support.other.variable", "settings": { "fontStyle": "" } },
        {
            "scope": "invalid",
            "settings": { "foreground": "#ff0000", "fontStyle": "bold" }
        },
        {
            "scope": "invalid.deprecated",
            "settings": { "foreground": "#ff00ff", "fontStyle": "bold" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
