        "terminal.ansiBrightBlue": "#82aaff",
        "terminal.ansiBrightCyan": "#7fdbca",
        "terminal.ansiBrightGreen": "#22da6f",
        "terminal.ansiBrightMagenta": "#c792ea",
        "terminal.ansiBrightRed": "#ff5874",
