{
    "name": "Canonical AA - Catppuccin Mocha",
    "colors": {
        "activityBar.background": "#151515",
        "button.background": "#CBA6F7",
        "button.foreground": "#1C1C1C",
        "button.hoverBackground": "#CBA6F7E6",
        "list.highlightForeground": "#CBA6F7",
        "textLink.foreground": "#CBA6F7",
        "textLink.activeForeground": "#CBA6F7",
        "focusBorder": "#CBA6F780",
        "settings.focusedRowBorder": "#CBA6F7",
        "settings.modifiedItemIndicator": "#CBA6F7",
        "textPreformat.foreground": "#FAB387",
        "editor.background": "#1C1C1C",
        "editor.foreground": "#CDD6F4",
        "editorIndentGuide.background1": "#33333380",
        "editorLineNumber.activeForeground": "#CDD6F4",
        "editorLineNumber.foreground": "#444444",
        "editorGroupHeader.border": "#333333",
        "editorGroupHeader.tabsBorder": "#333333",
        "editorGroupHeader.tabsBackground": "#151515",
        "list.activeSelectionBackground": "#333333",
        "list.activeSelectionForeground": "#CDD6F4",
        "list.activeSelectionIconForeground": "#fff",
        "panel.border": "#333333",
        "sideBar.background": "#151515",
        "sideBar.border": "#333333",
        "sideBarSectionHeader.background": "#151515",
        "sideBarSectionHeader.foreground": "#CDD6F4",
        "statusBar.background": "#151515",
        "statusBar.border": "#333333",
        "statusBar.foreground": "#CDD6F4",
        "tab.activeBackground": "#1C1C1C",
        "tab.activeBorder": "#1C1C1C",
        "tab.activeBorderTop": "#CBA6F7",
        "tab.border": "#333333",
        "tab.inactiveBackground": "#151515",
        "tab.inactiveForeground": "#666666",
        "titleBar.border": "#333333",
        "titleBar.activeBackground": "#151515",
        "titleBar.activeForeground": "#CDD6F4",
        "titleBar.inactiveBackground": "#151515",
        "titleBar.inactiveForeground": "#666666",
        "terminal.ansiBlack": "#1C1C1C",
        "terminal.ansiRed": "#F38BA8",
        "terminal.ansiGreen": "#A6E3A1",
        "terminal.ansiYellow": "#F9E2AF",
        "terminal.ansiBlue": "#89B4FA",
        "terminal.ansiMagenta": "#CBA6F7",
        "terminal.ansiCyan": "#94E2D5",
        "terminal.ansiWhite": "#CDD6F4",
        "terminal.ansiBrightBlack": "#444444",
        "terminal.ansiBrightRed": "#F38BA8",
        "terminal.ansiBrightGreen": "#A6E3A1",
        "terminal.ansiBrightYellow": "#F9E2AF",
        "terminal.ansiBrightBlue": "#89B4FA",
        "terminal.ansiBrightMagenta": "#F5C2E7",
        "terminal.ansiBrightCyan": "#89DCEB",
        "terminal.ansiBrightWhite": "#F5E0DC",
        "terminal.foreground": "#CDD6F4"
    },
    "tokenColors": [
        {
            "name": "Basic text & variable names",
            "scope": [
                "text",
                "source",
                "variable.other.readwrite",
                "punctuation.definition.variable"
            ],
            "settings": { "foreground": "#CDD6F4" }
        },
        {
            "name": "Punctuation",
            "scope": "punctuation",
            "settings": { "foreground": "#9399B2" }
        },
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#848484" }
        },
        {
            "name": "Strings",
            "scope": ["string", "punctuation.definition.string"],
            "settings": { "foreground": "#A6E3A1" }
        },
        {
            "name": "Escape sequences",
            "scope": "constant.character.escape",
            "settings": { "foreground": "#F5C2E7" }
        },
        {
            "name": "Booleans, constants, numbers",
            "scope": [
                "constant.numeric",
                "variable.other.constant",
                "entity.name.constant",
                "constant.language.boolean",
                "constant.language.false",
                "constant.language.true",
                "keyword.other.unit.user-defined",
                "keyword.other.unit.suffix.floating-point"
            ],
            "settings": { "foreground": "#FAB387" }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "keyword.operator.word",
                "keyword.operator.new",
                "variable.language.super",
                "support.type.primitive",
                "storage.type",
                "storage.modifier",
                "punctuation.definition.keyword"
            ],
            "settings": { "foreground": "#CBA6F7" }
        },
        {
            "name": "Operators",
            "scope": [
                "keyword.operator",
                "punctuation.accessor",
                "punctuation.definition.generic",
                "punctuation.definition.tag",
                "punctuation.separator.key-value"
            ],
            "settings": { "foreground": "#94E2D5" }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "meta.function-call.method",
                "support.function",
                "support.function.misc",
                "variable.function"
            ],
            "settings": { "foreground": "#89B4FA" }
        },
        {
            "name": "Classes",
            "scope": [
                "entity.name.class",
                "entity.other.inherited-class",
                "support.class",
                "meta.function-call.constructor",
                "entity.name.struct"
            ],
            "settings": { "foreground": "#F9E2AF" }
        },
        {
            "name": "Types",
            "scope": [
                "meta.type",
                "meta.type-alias",
                "support.type",
                "entity.name.type"
            ],
            "settings": { "foreground": "#F9E2AF" }
        },
        {
            "name": "Enum members",
            "scope": [
                "meta.enum variable.other.readwrite",
                "variable.other.enummember"
            ],
            "settings": { "foreground": "#94E2D5" }
        },
        {
            "name": "Parameters",
            "scope": ["variable.parameter", "meta.function.parameters"],
            "settings": { "foreground": "#EBA0AC" }
        },
        {
            "name": "Built-ins",
            "scope": ["constant.language", "support.function.builtin"],
            "settings": { "foreground": "#F38BA8" }
        },
        {
            "name": "This/Self",
            "scope": [
                "variable.language.this",
                "variable.language.this punctuation.definition.variable"
            ],
            "settings": { "foreground": "#F38BA8" }
        },
        {
            "name": "Decorators",
            "scope": [
                "meta.annotation variable.function",
                "meta.annotation variable.annotation.function",
                "meta.annotation punctuation.definition.annotation",
                "meta.decorator",
                "punctuation.decorator"
            ],
            "settings": { "foreground": "#FAB387" }
        },
        {
            "name": "Object properties",
            "scope": ["variable.object.property", "meta.property.object"],
            "settings": { "foreground": "#CDD6F4" }
        },
        {
            "name": "String interpolation",
            "scope": ["string.template variable", "string variable"],
            "settings": { "foreground": "#CDD6F4" }
        },
        {
            "name": "CSS: Property Names",
            "scope": [
                "support.type.property-name.css",
                "support.type.property-name.less"
            ],
            "settings": { "foreground": "#89B4FA" }
        },
        {
            "name": "Markup: Heading",
            "scope": "markup.heading",
            "settings": { "foreground": "#F38BA8" }
        },
        {
            "name": "Markup: Strong",
            "scope": "markup.bold",
            "settings": { "foreground": "#FAB387", "fontStyle": "bold" }
        },
        {
            "name": "Markup: Underline",
            "scope": "markup.underline",
            "settings": { "fontStyle": "underline" }
        },
        {
            "name": "Markup Inline",
            "scope": "markup.inline.raw",
            "settings": { "foreground": "#F5E0DC", "fontStyle": "" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
