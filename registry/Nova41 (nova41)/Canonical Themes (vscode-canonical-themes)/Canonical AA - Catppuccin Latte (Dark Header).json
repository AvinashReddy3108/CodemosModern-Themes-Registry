{
    "name": "Canonical AA - Catppuccin Latte (Dark Header)",
    "colors": {
        "activityBar.background": "#151515",
        "button.background": "#8839EF",
        "list.highlightForeground": "#8839EF",
        "textLink.foreground": "#8839EF",
        "textLink.activeForeground": "#8839EF",
        "focusBorder": "#8839EF80",
        "settings.focusedRowBorder": "#8839EF",
        "settings.modifiedItemIndicator": "#8839EF",
        "textPreformat.foreground": "#FE640B",
        "editor.background": "#FAFAFA",
        "editor.foreground": "#4C4F69",
        "editorIndentGuide.background1": "#4C4F691F",
        "editorLineNumber.activeForeground": "#4C4F69",
        "editorLineNumber.foreground": "#A3A3A3",
        "editorGroupHeader.border": "#D4D4D4",
        "editorGroupHeader.tabsBorder": "#D4D4D4",
        "editorGroupHeader.tabsBackground": "#EBEBEB",
        "list.activeSelectionBackground": "#D4D4D4",
        "list.activeSelectionForeground": "#4C4F69",
        "list.activeSelectionIconForeground": "#4C4F69",
        "sideBar.background": "#FAFAFA",
        "sideBar.border": "#D4D4D4",
        "sideBarSectionHeader.background": "#F5F5F5",
        "sideBarSectionHeader.foreground": "#4C4F69",
        "panel.border": "#D4D4D4",
        "statusBar.background": "#FAFAFA",
        "statusBar.border": "#D4D4D4",
        "statusBar.foreground": "#4C4F69",
        "tab.activeBackground": "#FAFAFA",
        "tab.activeBorder": "#FAFAFA",
        "tab.activeBorderTop": "#8839EF",
        "tab.border": "#D4D4D4",
        "tab.inactiveBackground": "#EBEBEB",
        "tab.inactiveForeground": "#737373",
        "titleBar.border": "#151515",
        "titleBar.activeBackground": "#151515",
        "titleBar.activeForeground": "#D4D4D4",
        "titleBar.inactiveBackground": "#151515",
        "titleBar.inactiveForeground": "#A3A3A3",
        "terminal.ansiBlack": "#4C4F69",
        "terminal.ansiRed": "#D20F39",
        "terminal.ansiGreen": "#40A02B",
        "terminal.ansiYellow": "#DF8E1D",
        "terminal.ansiBlue": "#1E66F5",
        "terminal.ansiMagenta": "#8839EF",
        "terminal.ansiCyan": "#179299",
        "terminal.ansiWhite": "#F5F5F5",
        "terminal.ansiBrightBlack": "#737373",
        "terminal.ansiBrightRed": "#E64553",
        "terminal.ansiBrightGreen": "#40A02B",
        "terminal.ansiBrightYellow": "#FE640B",
        "terminal.ansiBrightBlue": "#209FB5",
        "terminal.ansiBrightMagenta": "#EA76CB",
        "terminal.ansiBrightCyan": "#04A5E5",
        "terminal.ansiBrightWhite": "#FAFAFA",
        "terminal.foreground": "#4C4F69"
    },
    "tokenColors": [
        {
            "name": "Basic text & variable names",
            "scope": [
                "text",
                "source",
                "variable.other.readwrite",
                "punctuation.definition.variable"
            ],
            "settings": { "foreground": "#4C4F69" }
        },
        {
            "name": "Punctuation",
            "scope": "punctuation",
            "settings": { "foreground": "#6F7287" }
        },
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#737373" }
        },
        {
            "name": "Strings",
            "scope": ["string", "punctuation.definition.string"],
            "settings": { "foreground": "#358323" }
        },
        {
            "name": "Escape sequences",
            "scope": "constant.character.escape",
            "settings": { "foreground": "#D220A2" }
        },
        {
            "name": "Booleans, constants, numbers",
            "scope": [
                "constant.numeric",
                "variable.other.constant",
                "entity.name.constant",
                "constant.language.boolean",
                "constant.language.false",
                "constant.language.true",
                "keyword.other.unit.user-defined",
                "keyword.other.unit.suffix.floating-point"
            ],
            "settings": { "foreground": "#C94A01" }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "keyword.operator.word",
                "keyword.operator.new",
                "variable.language.super",
                "support.type.primitive",
                "storage.type",
                "storage.modifier",
                "punctuation.definition.keyword"
            ],
            "settings": { "foreground": "#8839EF" }
        },
        {
            "name": "Operators",
            "scope": [
                "keyword.operator",
                "punctuation.accessor",
                "punctuation.definition.generic",
                "punctuation.definition.tag",
                "punctuation.separator.key-value"
            ],
            "settings": { "foreground": "#148086" }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "meta.function-call.method",
                "support.function",
                "support.function.misc",
                "variable.function"
            ],
            "settings": { "foreground": "#1E66F5" }
        },
        {
            "name": "Classes",
            "scope": [
                "entity.name.class",
                "entity.other.inherited-class",
                "support.class",
                "meta.function-call.constructor",
                "entity.name.struct"
            ],
            "settings": { "foreground": "#A16715" }
        },
        {
            "name": "Types",
            "scope": [
                "meta.type",
                "meta.type-alias",
                "support.type",
                "entity.name.type"
            ],
            "settings": { "foreground": "#A16715" }
        },
        {
            "name": "Enum members",
            "scope": [
                "meta.enum variable.other.readwrite",
                "variable.other.enummember"
            ],
            "settings": { "foreground": "#148086" }
        },
        {
            "name": "Parameters",
            "scope": ["variable.parameter", "meta.function.parameters"],
            "settings": { "foreground": "#E12132" }
        },
        {
            "name": "Built-ins",
            "scope": ["constant.language", "support.function.builtin"],
            "settings": { "foreground": "#D20F39" }
        },
        {
            "name": "This/Self",
            "scope": [
                "variable.language.this",
                "variable.language.this punctuation.definition.variable"
            ],
            "settings": { "foreground": "#D20F39" }
        },
        {
            "name": "Decorators",
            "scope": [
                "meta.annotation variable.function",
                "meta.annotation variable.annotation.function",
                "meta.annotation punctuation.definition.annotation",
                "meta.decorator",
                "punctuation.decorator"
            ],
            "settings": { "foreground": "#C94A01" }
        },
        {
            "name": "Object properties",
            "scope": ["variable.object.property", "meta.property.object"],
            "settings": { "foreground": "#4C4F69" }
        },
        {
            "name": "String interpolation",
            "scope": ["string.template variable", "string variable"],
            "settings": { "foreground": "#4C4F69" }
        },
        {
            "name": "CSS: Property Names",
            "scope": [
                "support.type.property-name.css",
                "support.type.property-name.less"
            ],
            "settings": { "foreground": "#1E66F5" }
        },
        {
            "name": "Markup: Heading",
            "scope": "markup.heading",
            "settings": { "foreground": "#D20F39" }
        },
        {
            "name": "Markup: Strong",
            "scope": "markup.bold",
            "settings": { "foreground": "#C94A01", "fontStyle": "bold" }
        },
        {
            "name": "Markup: Underline",
            "scope": "markup.underline",
            "settings": { "fontStyle": "underline" }
        },
        {
            "name": "Markup Inline",
            "scope": "markup.inline.raw",
            "settings": { "foreground": "#C44D33", "fontStyle": "" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
