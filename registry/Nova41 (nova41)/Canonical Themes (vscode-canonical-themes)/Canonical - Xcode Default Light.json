{
    "name": "Canonical - Xcode Default Light",
    "colors": {
        "activityBar.background": "#FFFFFF",
        "button.background": "#007AFF",
        "list.highlightForeground": "#007AFF",
        "textLink.foreground": "#007AFF",
        "textLink.activeForeground": "#007AFF",
        "focusBorder": "#007AFF80",
        "settings.focusedRowBorder": "#007AFF",
        "settings.modifiedItemIndicator": "#007AFF",
        "textPreformat.foreground": "#78492A",
        "editor.background": "#FFFFFF",
        "editor.foreground": "#262626",
        "editor.selectionBackground": "#B2D7FF",
        "editor.lineHighlightBackground": "#ECF5FF",
        "editorCursor.foreground": "#007AFF",
        "editorWhitespace.foreground": "#D6D6D6",
        "editorIndentGuide.background1": "#D6D6D6",
        "editorLineNumber.activeForeground": "#272727",
        "editorLineNumber.foreground": "#808080",
        "editorGroupHeader.border": "#E5E5E5",
        "editorGroupHeader.tabsBorder": "#E5E5E5",
        "editorGroupHeader.tabsBackground": "#FFFFFF",
        "list.activeSelectionBackground": "#B2D7FF",
        "list.activeSelectionForeground": "#272727",
        "list.activeSelectionIconForeground": "#272727",
        "minimap.selectionHighlight": "#E3E3E3",
        "panel.border": "#E5E5E5",
        "sideBar.background": "#FFFFFF",
        "sideBar.border": "#E5E5E5",
        "sideBarSectionHeader.background": "#FFFFFF",
        "sideBarSectionHeader.foreground": "#272727",
        "statusBar.background": "#FFFFFF",
        "statusBar.border": "#E5E5E5",
        "statusBar.foreground": "#808080",
        "tab.activeBackground": "#FFFFFF",
        "tab.activeBorder": "#FFFFFF",
        "tab.activeBorderTop": "#007AFF",
        "tab.border": "#E5E5E5",
        "tab.inactiveBackground": "#F1F1F1",
        "tab.inactiveForeground": "#808080",
        "titleBar.border": "#E5E5E5",
        "titleBar.activeBackground": "#FFFFFF",
        "titleBar.activeForeground": "#272727",
        "titleBar.inactiveBackground": "#FFFFFF",
        "titleBar.inactiveForeground": "#808080",
        "input.background": "#F1F1F1",
        "input.foreground": "#797979",
        "input.border": "#D4D4D4",
        "terminal.ansiBlack": "#262626",
        "terminal.ansiRed": "#D12F1B",
        "terminal.ansiGreen": "#2E8D28",
        "terminal.ansiYellow": "#78492A",
        "terminal.ansiBlue": "#1337FF",
        "terminal.ansiMagenta": "#AD3DA4",
        "terminal.ansiCyan": "#3E8087",
        "terminal.ansiWhite": "#FFFFFF",
        "terminal.ansiBrightBlack": "#808080",
        "terminal.ansiBrightRed": "#D12F1B",
        "terminal.ansiBrightGreen": "#2E8D28",
        "terminal.ansiBrightYellow": "#947100",
        "terminal.ansiBrightBlue": "#1337FF",
        "terminal.ansiBrightMagenta": "#BA2DA2",
        "terminal.ansiBrightCyan": "#02638C",
        "terminal.ansiBrightWhite": "#FFFFFF",
        "terminal.foreground": "#262626"
    },
    "tokenColors": [
        {
            "name": "Plain text",
            "scope": [
                "text",
                "source",
                "variable.other.readwrite",
                "punctuation.definition.variable"
            ],
            "settings": { "foreground": "#262626" }
        },
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#707F87" }
        },
        {
            "name": "Documentation",
            "scope": ["comment.documentation", "comment.block.documentation"],
            "settings": { "foreground": "#707F87" }
        },
        {
            "name": "Documentation keywords",
            "scope": [
                "comment.documentation keyword",
                "comment.block.documentation storage.type"
            ],
            "settings": { "foreground": "#5C6873" }
        },
        {
            "name": "Strings",
            "scope": ["string", "punctuation.definition.string"],
            "settings": { "foreground": "#D12F1B" }
        },
        {
            "name": "Characters and numbers",
            "scope": ["constant.numeric", "constant.character"],
            "settings": { "foreground": "#2729D8" }
        },
        {
            "name": "Regex literals",
            "scope": ["string.regexp"],
            "settings": { "foreground": "#D12F1B" }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "keyword.operator.word",
                "keyword.operator.new",
                "storage.type",
                "storage.modifier",
                "punctuation.definition.keyword",
                "variable.language.super",
                "support.type.primitive"
            ],
            "settings": { "foreground": "#AD3DA4" }
        },
        {
            "name": "Preprocessor statements",
            "scope": [
                "meta.preprocessor",
                "keyword.control.directive",
                "punctuation.definition.directive",
                "entity.name.function.preprocessor"
            ],
            "settings": { "foreground": "#78492A" }
        },
        {
            "name": "URLs",
            "scope": ["markup.underline.link", "string.other.link"],
            "settings": { "foreground": "#1337FF" }
        },
        {
            "name": "Attributes",
            "scope": [
                "entity.other.attribute-name",
                "meta.decorator",
                "punctuation.decorator"
            ],
            "settings": { "foreground": "#947100" }
        },
        {
            "name": "Type declarations",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "entity.other.inherited-class",
                "support.class",
                "entity.name.struct"
            ],
            "settings": { "foreground": "#02638C" }
        },
        {
            "name": "Function and method declarations",
            "scope": [
                "entity.name.function",
                "meta.function-call.method",
                "support.function",
                "variable.function"
            ],
            "settings": { "foreground": "#057CB0" }
        },
        {
            "name": "Project class names",
            "scope": ["support.type"],
            "settings": { "foreground": "#23575C" }
        },
        {
            "name": "Project properties and globals",
            "scope": [
                "variable.other.property",
                "variable.other.object.property",
                "meta.property.object"
            ],
            "settings": { "foreground": "#3E8087" }
        },
        {
            "name": "Constants",
            "scope": [
                "variable.other.constant",
                "entity.name.constant",
                "constant.language.boolean",
                "constant.language"
            ],
            "settings": { "foreground": "#3E8087" }
        },
        {
            "name": "Other class names",
            "scope": ["meta.function-call.constructor"],
            "settings": { "foreground": "#4B21B0" }
        },
        {
            "name": "Other functions and methods",
            "scope": ["support.function.builtin"],
            "settings": { "foreground": "#804FB8" }
        },
        {
            "name": "Operators",
            "scope": [
                "keyword.operator",
                "punctuation.accessor",
                "punctuation.definition.generic",
                "punctuation.definition.tag",
                "punctuation.separator.key-value"
            ],
            "settings": { "foreground": "#262626" }
        },
        {
            "name": "Parameters",
            "scope": ["variable.parameter", "meta.function.parameters"],
            "settings": { "foreground": "#3E8087" }
        },
        {
            "name": "Markup: Heading",
            "scope": "markup.heading",
            "settings": { "foreground": "#BA2DA2" }
        },
        {
            "name": "Markup: Strong",
            "scope": "markup.bold",
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Markup: Underline",
            "scope": "markup.underline",
            "settings": { "fontStyle": "underline" }
        },
        {
            "name": "Markup Inline",
            "scope": "markup.inline.raw",
            "settings": { "foreground": "#78492A", "fontStyle": "" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
