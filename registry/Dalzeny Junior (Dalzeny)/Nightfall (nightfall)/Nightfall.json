{
    "name": "Nightfall",
    "type": "Dark",
    "colors": {
        "editor.background": "#303030",
        "editor.foreground": "#bebebe",
        "editor.selectionBackground": "#5858582c",
        "editor.selectionHighlightBorder": "#e76f52",
        "editor.selectionHighlightBackground": "#5858582c",
        "editor.inactiveSelectionBackground": "#363636a2",
        "editor.lineHighlightBackground": "#5858582c",
        "editorCursor.foreground": "#e76f52",
        "terminalCursor.foreground": "#e76f52",
        "editorWhitespace.foreground": "#ffffff25",
        "editorIndentGuide.background": "#ffffff25",
        "editorGroupHeader.tabsBackground": "#303030",
        "editorLineNumber.foreground": "#505050",
        "editorLineNumber.activeForeground": "#e76f52",
        "editorWidget.border": "#454545",
        "editorWidget.background": "#2B2B2B",
        "statusBar.background": "#262626",
        "statusBar.foreground": "#bebebe",
        "sideBar.foreground": "#ffffff",
        "sideBar.background": "#2B2B2B",
        "sideBarTitle.foreground": "#ffffff",
        "sideBarSectionHeader.background": "#262626",
        "sideBarSectionHeader.foreground": "#ffffff",
        "scrollbarSlider.background": "#7070707a",
        "scrollbarSlider.hoverBackground": "#6161617a",
        "activityBarBadge.background": "#e76f52",
        "activityBarBadge.foreground": "#ffffff",
        "activityBar.background": "#262626",
        "activityBar.foreground": "#ffffff",
        "button.background": "#4a4d5285",
        "button.foreground": "#ffffff",
        "tab.activeBackground": "#303030",
        "tab.activeForeground": "#e76f52",
        "tab.inactiveBackground": "#262626",
        "tab.inactiveForeground": "#ffffff",
        "tab.border": "#30303000",
        "list.focusBackground": "#42434685",
        "list.hoverBackground": "#42434685",
        "list.activeSelectionBackground": "#3d3d3d7a",
        "list.activeSelectionForeground": "#e76f52",
        "list.inactiveSelectionForeground": "#e76f52",
        "list.inactiveSelectionBackground": "#3d3d3d7a",
        "input.background": "#262626",
        "inputOption.activeBorder": "#ffffff",
        "input.foreground": "#bebebeff",
        "input.placeholderForeground": "#bababa",
        "dropdown.listBackground": "#262626",
        "dropdown.background": "#262626",
        "dropdown.foreground": "#bebebeff",
        "extensionButton.prominentForeground": "#fff",
        "extensionButton.prominentBackground": "#e76f52",
        "extensionButton.prominentHoverBackground": "#ff552b",
        "terminal.background": "#2B2B2B"
    },
    "tokenColors": [
        { "scope": "settings", "settings": { "foreground": "#bebebeff" } },
        {
            "scope": ["meta.embedded", "source.groovy.embedded"],
            "settings": { "foreground": "#bebebeff" }
        },
        { "scope": "emphasis", "settings": { "fontStyle": "italic" } },
        { "scope": "strong", "settings": { "fontStyle": "bold" } },
        { "scope": "header", "settings": { "foreground": "#000080" } },
        {
            "name": "COMMENT",
            "scope": "comment",
            "settings": { "foreground": "#666666", "fontStyle": "italic" }
        },
        {
            "name": "Undefined, Null, NaN",
            "scope": "constant.language",
            "settings": { "foreground": "#738290" }
        },
        {
            "name": "NUMBERS",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#738290" }
        },
        { "scope": "constant.regexp", "settings": { "foreground": "#646695" } },
        { "scope": "entity.name.tag", "settings": { "foreground": "#867f93" } },
        {
            "scope": "entity.name.tag.css",
            "settings": { "foreground": "#876868ff" }
        },
        {
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#738290" }
        },
        {
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.class.mixin.css",
                "entity.other.attribute-name.id.css",
                "entity.other.attribute-name.parent-selector.css",
                "entity.other.attribute-name.pseudo-class.css",
                "entity.other.attribute-name.pseudo-element.css",
                "source.css.less entity.other.attribute-name.id",
                "entity.other.attribute-name.attribute.scss",
                "entity.other.attribute-name.scss"
            ],
            "settings": { "foreground": "#876868ff" }
        },
        { "scope": "invalid", "settings": { "foreground": "#f44747" } },
        {
            "scope": "markup.underline",
            "settings": { "fontStyle": "underline" }
        },
        {
            "scope": "markup.bold",
            "settings": { "fontStyle": "bold", "foreground": "#867f93" }
        },
        {
            "scope": "markup.heading",
            "settings": { "fontStyle": "bold", "foreground": "#867f93" }
        },
        { "scope": "markup.italic", "settings": { "fontStyle": "italic" } },
        { "scope": "markup.inserted", "settings": { "foreground": "#657675" } },
        { "scope": "markup.deleted", "settings": { "foreground": "#ce9178" } },
        { "scope": "markup.changed", "settings": { "foreground": "#867f93" } },
        {
            "scope": "beginning.punctuation.definition.quote.markdown",
            "settings": { "foreground": "#608b4e" }
        },
        {
            "scope": "beginning.punctuation.definition.list.markdown",
            "settings": { "foreground": "#657675" }
        },
        {
            "scope": "markup.inline.raw",
            "settings": { "foreground": "#ce9178" }
        },
        { "scope": "meta.selector", "settings": { "foreground": "#876868ff" } },
        {
            "scope": "meta.preprocessor",
            "settings": { "foreground": "#867f93" }
        },
        {
            "scope": "meta.preprocessor.string",
            "settings": { "foreground": "#ce9178" }
        },
        {
            "scope": "meta.preprocessor.numeric",
            "settings": { "foreground": "#738290" }
        },
        {
            "scope": "meta.structure.dictionary.key.python",
            "settings": { "foreground": "#738290" }
        },
        {
            "scope": "meta.diff.header",
            "settings": { "foreground": "#867f93" }
        },
        {
            "name": "STORAEGE TYPES",
            "scope": ["storage", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#867f93" }
        },
        { "scope": "string", "settings": { "foreground": "#876868" } },
        { "scope": "string.tag", "settings": { "foreground": "#876868" } },
        { "scope": "string.value", "settings": { "foreground": "#876868" } },
        { "scope": "string.regexp", "settings": { "foreground": "#d16969" } },
        {
            "name": "STRING INTERPOLATION",
            "scope": [
                "punctuation.definition.template-expression.begin",
                "punctuation.definition.template-expression.end",
                "punctuation.section.embedded"
            ],
            "settings": { "foreground": "#738290" }
        },
        {
            "name": "Reset JavaScript string interpolation expression",
            "scope": ["meta.template.expression"],
            "settings": { "foreground": "#bebebeff" }
        },
        {
            "scope": [
                "support.type.vendored.property-name",
                "support.type.property-name",
                "variable.css",
                "variable.scss",
                "variable.other.less",
                "source.coffee.embedded"
            ],
            "settings": { "foreground": "#738290" }
        },
        {
            "name": "KEYWORDS",
            "scope": ["keyword", "keyword.control", "keyword.operator"],
            "settings": { "foreground": "#867f93ff" }
        },
        {
            "scope": [
                "keyword.operator.new",
                "keyword.operator.expression",
                "keyword.operator.cast",
                "keyword.operator.sizeof",
                "keyword.operator.instanceof",
                "keyword.operator.logical.python"
            ],
            "settings": { "foreground": "#968ea3" }
        },
        {
            "scope": "keyword.other.unit",
            "settings": { "foreground": "#738290" }
        },
        {
            "scope": [
                "punctuation.section.embedded.begin.php",
                "punctuation.section.embedded.end.php"
            ],
            "settings": { "foreground": "#867f93" }
        },
        {
            "scope": "support.function.git-rebase",
            "settings": { "foreground": "#738290" }
        },
        {
            "scope": "constant.sha.git-rebase",
            "settings": { "foreground": "#f44747" }
        },
        {
            "name": "coloring of the Java import and package identifiers",
            "scope": [
                "storage.modifier.import.java",
                "variable.language.wildcard.java",
                "storage.modifier.package.java"
            ],
            "settings": { "foreground": "#d4d4d4" }
        },
        {
            "name": "THIS SELF",
            "scope": "variable.language",
            "settings": { "foreground": "#738290" }
        },
        {
            "name": "HTML",
            "scope": [
                "punctuation.definition.tag",
                "entity.name.tag.block.any.html",
                "entity.name.tag.other.html",
                "entity.name.tag.inline.any.html",
                "entity.name.tag.structure.any.html",
                "entity.name.tag.html",
                "meta.tag.metadata.style.html",
                "meta.tag.structure.any.html"
            ],
            "settings": { "foreground": "#867f93ff" }
        },
        {
            "name": "EQUAL SIGN IN HTML (=)",
            "scope": [
                "meta.tag.structure.any.html",
                "meta.tag.inline.any.html"
            ],
            "settings": { "foreground": "#bebebe" }
        },
        {
            "name": "BASIC TEXT HTML",
            "scope": "text.html.basic",
            "settings": { "foreground": "#bebebe" }
        },
        {
            "name": "LANGUAGE BOOLEANS",
            "scope": "constant.language.boolean.false, constant.language.boolean.true",
            "settings": { "foreground": "#738290" }
        },
        {
            "name": "BRACKET/BRACE",
            "scope": "meta.brace.round, punctuation.definition.block",
            "settings": { "foreground": "#bebebe" }
        },
        {
            "name": "LOG (JS)",
            "scope": "support.function.console.js",
            "settings": { "foreground": "#867f93" }
        },
        {
            "name": "LOGICAL OPERATOR",
            "scope": "keyword.operator.logical",
            "settings": { "foreground": "#d4d4d4ff" }
        },
        {
            "name": "COMMENT UNUSED (ELIXIR)",
            "scope": "comment.unused.elixir",
            "settings": { "foreground": "#738290" }
        },
        {
            "name": "VARIABLE CONSTANT (ELIXIR)",
            "scope": "variable.other.constant.elixir",
            "settings": { "foreground": "#867f93ff" }
        },
        {
            "name": "PIPE OPERATOR, CASE STATEMENT (|>) (ELIXIR)",
            "scope": "keyword.operator.other.elixir",
            "settings": { "foreground": "#d4d4d4ff" }
        },
        {
            "name": ":ATOM (ELIXIR)",
            "scope": "constant.other.symbol.elixir",
            "settings": { "foreground": "#867f93ff" }
        },
        {
            "name": "PUNCTUATION DEFINITION (:) (ELIXIR)",
            "scope": "punctuation.definition.constant.elixir",
            "settings": { "foreground": "#867f93ff" }
        },
        {
            "scope": "token.info-token",
            "settings": { "foreground": "#6796e6" }
        },
        {
            "scope": "token.warn-token",
            "settings": { "foreground": "#cd9731" }
        },
        {
            "scope": "token.error-token",
            "settings": { "foreground": "#f44747" }
        },
        {
            "scope": "token.debug-token",
            "settings": { "foreground": "#b267e6" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
