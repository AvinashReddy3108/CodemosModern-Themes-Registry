{
    "name": "PetCareScript Dark",
    "type": "dark",
    "colors": {
        "editor.background": "#1a1a2e",
        "editor.foreground": "#eee",
        "activityBar.background": "#16213e",
        "activityBar.foreground": "#ffa500",
        "sideBar.background": "#0f3460",
        "statusBar.background": "#e94560",
        "statusBar.foreground": "#ffffff",
        "titleBar.activeBackground": "#16213e",
        "titleBar.activeForeground": "#ffa500",
        "panel.background": "#0f3460",
        "terminal.background": "#1a1a2e"
    },
    "tokenColors": [
        {
            "name": "PetCareScript Comments",
            "scope": [
                "comment.line.double-slash.petcarescript",
                "comment.block.petcarescript"
            ],
            "settings": { "foreground": "#666666", "fontStyle": "italic" }
        },
        {
            "name": "PetCareScript Variable Declaration",
            "scope": "storage.type.variable.petcarescript",
            "settings": { "foreground": "#32cd32", "fontStyle": "bold" }
        },
        {
            "name": "PetCareScript Function Declaration",
            "scope": "storage.type.function.petcarescript",
            "settings": { "foreground": "#40e0d0", "fontStyle": "bold" }
        },
        {
            "name": "PetCareScript Class Declaration",
            "scope": "storage.type.class.petcarescript",
            "settings": { "foreground": "#ff6347", "fontStyle": "bold" }
        },
        {
            "name": "PetCareScript Control Flow",
            "scope": [
                "keyword.control.conditional.petcarescript",
                "keyword.control.loop.petcarescript",
                "keyword.control.flow.petcarescript"
            ],
            "settings": { "foreground": "#ffa500", "fontStyle": "bold" }
        },
        {
            "name": "PetCareScript Async Keywords",
            "scope": "keyword.control.async.petcarescript",
            "settings": { "foreground": "#da70d6", "fontStyle": "bold" }
        },
        {
            "name": "PetCareScript HTTP Keywords",
            "scope": "keyword.control.http.petcarescript",
            "settings": { "foreground": "#20b2aa", "fontStyle": "bold" }
        },
        {
            "name": "PetCareScript Testing Keywords",
            "scope": "keyword.control.testing.petcarescript",
            "settings": { "foreground": "#ff69b4", "fontStyle": "bold" }
        },
        {
            "name": "PetCareScript Module Keywords",
            "scope": "keyword.control.module.petcarescript",
            "settings": { "foreground": "#adff2f", "fontStyle": "bold" }
        },
        {
            "name": "PetCareScript Database Keywords",
            "scope": "keyword.control.database.petcarescript",
            "settings": { "foreground": "#87ceeb", "fontStyle": "bold" }
        },
        {
            "name": "PetCareScript Switch Keywords",
            "scope": "keyword.control.switch.petcarescript",
            "settings": { "foreground": "#dda0dd", "fontStyle": "bold" }
        },
        {
            "name": "PetCareScript Error Handling",
            "scope": "keyword.control.trycatch.petcarescript",
            "settings": { "foreground": "#ff4500", "fontStyle": "bold" }
        },
        {
            "name": "PetCareScript Logical Operators",
            "scope": "keyword.operator.logical.petcarescript",
            "settings": { "foreground": "#ffd700", "fontStyle": "bold" }
        },
        {
            "name": "PetCareScript Comparison Operators",
            "scope": "keyword.operator.comparison.petcarescript",
            "settings": { "foreground": "#f0e68c", "fontStyle": "bold" }
        },
        {
            "name": "PetCareScript Arithmetic Operators",
            "scope": "keyword.operator.arithmetic.petcarescript",
            "settings": { "foreground": "#98fb98" }
        },
        {
            "name": "PetCareScript Assignment Operators",
            "scope": [
                "keyword.operator.assignment.petcarescript",
                "keyword.operator.assignment.compound.petcarescript"
            ],
            "settings": { "foreground": "#ffa500" }
        },
        {
            "name": "PetCareScript Boolean True",
            "scope": "constant.language.boolean.true.petcarescript",
            "settings": { "foreground": "#90ee90", "fontStyle": "bold" }
        },
        {
            "name": "PetCareScript Boolean False",
            "scope": "constant.language.boolean.false.petcarescript",
            "settings": { "foreground": "#ff6b6b", "fontStyle": "bold" }
        },
        {
            "name": "PetCareScript Null",
            "scope": "constant.language.null.petcarescript",
            "settings": { "foreground": "#708090", "fontStyle": "italic" }
        },
        {
            "name": "PetCareScript Self/Parent",
            "scope": [
                "variable.language.self.petcarescript",
                "variable.language.parent.petcarescript"
            ],
            "settings": { "foreground": "#dda0dd", "fontStyle": "italic" }
        },
        {
            "name": "PetCareScript Strings",
            "scope": [
                "string.quoted.double.petcarescript",
                "string.quoted.single.petcarescript"
            ],
            "settings": { "foreground": "#98fb98" }
        },
        {
            "name": "PetCareScript Numbers",
            "scope": [
                "constant.numeric.integer.petcarescript",
                "constant.numeric.float.petcarescript",
                "constant.numeric.hex.petcarescript",
                "constant.numeric.binary.petcarescript",
                "constant.numeric.octal.petcarescript"
            ],
            "settings": { "foreground": "#87ceeb" }
        },
        {
            "name": "PetCareScript Functions",
            "scope": [
                "entity.name.function.petcarescript",
                "support.function.builtin.petcarescript"
            ],
            "settings": { "foreground": "#dda0dd" }
        },
        {
            "name": "PetCareScript Classes",
            "scope": [
                "entity.name.type.class.petcarescript",
                "entity.name.type.petcarescript",
                "support.class.builtin.petcarescript"
            ],
            "settings": { "foreground": "#f0e68c", "fontStyle": "bold" }
        },
        {
            "name": "PetCareScript Variables",
            "scope": [
                "variable.other.readwrite.petcarescript",
                "variable.parameter.petcarescript"
            ],
            "settings": { "foreground": "#e0e0e0" }
        },
        {
            "name": "PetCareScript Object Properties",
            "scope": [
                "variable.other.property.petcarescript",
                "variable.other.object.key.petcarescript"
            ],
            "settings": { "foreground": "#add8e6" }
        },
        {
            "name": "PetCareScript Support Types",
            "scope": "support.type.petcarescript",
            "settings": { "foreground": "#ffd700", "fontStyle": "bold" }
        },
        {
            "name": "PetCareScript Advanced Keywords",
            "scope": "keyword.other.petcarescript",
            "settings": { "foreground": "#ff1493", "fontStyle": "bold" }
        },
        {
            "name": "PetCareScript Punctuation",
            "scope": [
                "punctuation.definition.class.begin.petcarescript",
                "punctuation.definition.class.end.petcarescript",
                "punctuation.definition.function.begin.petcarescript",
                "punctuation.definition.function.end.petcarescript"
            ],
            "settings": { "foreground": "#ffa500" }
        },
        {
            "name": "PetCareScript String Escapes",
            "scope": "constant.character.escape.petcarescript",
            "settings": { "foreground": "#ff6b6b", "fontStyle": "bold" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
