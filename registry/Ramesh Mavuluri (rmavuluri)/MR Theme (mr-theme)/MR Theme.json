{
    "name": "MR Theme",
    "type": "dark",
    "colors": {
        "editor.background": "#1a1a1a",
        "editor.foreground": "#e6e6e6",
        "editorLineNumber.foreground": "#666666",
        "editorLineNumber.activeForeground": "#cccccc",
        "editor.selectionBackground": "#404040",
        "editor.selectionHighlightBackground": "#2d2d2d",
        "editorCursor.foreground": "#ffffff",
        "editorWhitespace.foreground": "#404040",
        "editorIndentGuide.background": "#333333",
        "editorIndentGuide.activeBackground": "#555555",
        "sideBar.background": "#252526",
        "sideBar.foreground": "#cccccc",
        "sideBarTitle.foreground": "#ffffff",
        "activityBar.background": "#333333",
        "activityBar.foreground": "#cccccc",
        "statusBar.background": "#007acc",
        "statusBar.foreground": "#ffffff",
        "titleBar.activeBackground": "#333333",
        "titleBar.activeForeground": "#ffffff",
        "terminal.background": "#1a1a1a",
        "terminal.foreground": "#e6e6e6",
        "panel.background": "#1e1e1e",
        "panel.border": "#404040",
        "tab.activeBackground": "#1a1a1a",
        "tab.inactiveBackground": "#2d2d2d",
        "tab.activeForeground": "#ffffff",
        "tab.inactiveForeground": "#999999"
    },
    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#6a9955", "fontStyle": "italic" }
        },
        {
            "name": "Keyword",
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#569cd6", "fontStyle": "bold" }
        },
        {
            "name": "String",
            "scope": ["string", "constant.other.placeholder"],
            "settings": { "foreground": "#ce9178" }
        },
        {
            "name": "Number",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#b5cea8" }
        },
        {
            "name": "Function",
            "scope": ["entity.name.function", "meta.function-call"],
            "settings": { "foreground": "#dcdcaa" }
        },
        {
            "name": "Variable",
            "scope": ["variable", "entity.name.variable"],
            "settings": { "foreground": "#9cdcfe" }
        },
        {
            "name": "Type",
            "scope": ["entity.name.type", "entity.name.class"],
            "settings": { "foreground": "#4ec9b0" }
        },
        {
            "name": "Constant",
            "scope": ["constant", "entity.name.constant"],
            "settings": { "foreground": "#4fc1ff" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
