{
    "name": "Neon Programming theme-color-theme-light-silver",
    "type": "light",
    "colors": {
        "activityBar.activeBackground": "#838996",
        "activityBar.activeBorder": "#babbba",
        "activityBar.background": "#eaf0f3",
        "activityBar.border": "#838996",
        "activityBar.foreground": "#000000",
        "activityBar.inactiveForeground": "#838996",
        "activityBarBadge.background": "#566D7E",
        "activityBarBadge.foreground": "#FFFFFF",
        "editor.background": "#E5E4E2",
        "editor.foreground": "#483C32",
        "editor.inactiveSelectionBackground": "#ec050556",
        "editor.lineHighlightBackground": "#0eb0f04b",
        "editor.lineHighlightBorder": "#0eb0f062",
        "editor.selectionBackground": "#03b2c9",
        "editorCursor.foreground": "#fa0d08f5",
        "editorGroupHeader.tabsBackground": "#eaf0f3",
        "editorGroupHeader.tabsBorder": "#CECECE",
        "editorGutter.background": "#DADBDD",
        "editorHoverWidget.background": "#838996",
        "editorHoverWidget.border": "#E5E4E2",
        "editorHoverWidget.foreground": "#E5E4E2",
        "editorIndentGuide.background1": "#513B1C",
        "editorLineNumber.activeForeground": "#ffffff",
        "editorLineNumber.foreground": "#483C32",
        "errorForeground": "#fa0d08f5",
        "foreground": "#000000",
        "icon.foreground": "#838996",
        "input.background": "#ffffff",
        "list.activeSelectionBackground": "#513B1C",
        "list.activeSelectionForeground": "#DADBDD",
        "list.focusOutline": "#DADBDD",
        "list.hoverBackground": "#BCC6CC",
        "list.hoverForeground": "#ffffff",
        "list.inactiveSelectionBackground": "#888888",
        "list.inactiveSelectionForeground": "#0c0c0c",
        "panel.background": "#CECECE",
        "panel.border": "#eaf0f3",
        "panelTitle.activeBorder": "#0c0c0c",
        "panelTitle.activeForeground": "#000000f5",
        "panelTitle.inactiveForeground": "#838996",
        "scrollbarSlider.activeBackground": "#566D7E",
        "scrollbarSlider.background": "#566D7E",
        "scrollbarSlider.hoverBackground": "#566D7E",
        "sideBar.background": "#eaf0f3",
        "sideBar.border": "#566D7E",
        "sideBar.dropBackground": "#af9b9b",
        "sideBar.foreground": "#000000",
        "sideBarSectionHeader.background": "#eaf0f3",
        "sideBarSectionHeader.border": "#838996",
        "sideBarSectionHeader.foreground": "#000000",
        "sideBarTitle.foreground": "#000000",
        "statusBar.background": "#566D7E",
        "statusBar.foreground": "#ffffff",
        "tab.activeBackground": "#838996",
        "tab.activeBorder": "#566D7E",
        "tab.activeBorderTop": "#566D7E",
        "tab.activeForeground": "#ffffff",
        "tab.inactiveBackground": "#eaf0f3",
        "tab.inactiveForeground": "#000000",
        "tab.inactiveModifiedBorder": "#eeecec",
        "tab.unfocusedActiveBorder": "#9F8C76",
        "tab.unfocusedActiveBorderTop": "#9F8C76",
        "tab.unfocusedActiveForeground": "#e6d600",
        "terminal.background": "#B6B6B4",
        "terminal.foreground": "#566D7E",
        "terminalCursor.foreground": "#ffffff",
        "titleBar.activeBackground": "#BCC6CC",
        "titleBar.activeForeground": "#000000",
        "titleBar.inactiveBackground": "#625D5D",
        "titleBar.inactiveForeground": "#fffffff5"
    },
    "tokenColors": [
        {
            "name": "[COMMENTS] — The main comments color",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#2f3030" }
        },
        {
            "name": "[Entity] — The main Entity color",
            "scope": "entity",
            "settings": { "foreground": "#065e12" }
        },
        {
            "name": "[Constant] — The main constants color",
            "scope": "constant",
            "settings": { "foreground": "#5f0101" }
        },
        {
            "name": "[Keyword] — The main color for Keyword",
            "scope": ["keyword, storage.type.class.js"],
            "settings": { "foreground": "#73ff00" }
        },
        {
            "name": "[Meta] — The main color for Meta",
            "scope": "meta",
            "settings": { "foreground": "#ff9e9e" }
        },
        {
            "name": "Px and S coloring",
            "scope": ["keyword.other.unit.px.css", "keyword.other.unit.s.css"],
            "settings": { "foreground": "#d40c88" }
        },
        {
            "name": "[invalid] — The main color for invalid",
            "scope": "invalid",
            "settings": { "foreground": "#fa0d08f5" }
        },
        {
            "name": "[Meta Brace] — The main color for Meta Brace",
            "scope": [
                "meta.brace",
                "punctuation.definition.parameters.begin.js",
                "punctuation.definition.parameters.end.js"
            ],
            "settings": { "foreground": "#04faee" }
        },
        {
            "name": "[Punctuation] — The main color for Punctuation",
            "scope": "punctuation",
            "settings": { "foreground": "#fa0d08f5" }
        },
        {
            "name": "[Punctuation] — Color for Punctuation Parameters",
            "scope": "punctuation.definition.parameters",
            "settings": { "foreground": "#fddb00" }
        },
        {
            "name": "[Punctuation] — Color for Punctuation Template Expression",
            "scope": "punctuation.definition.template-expression",
            "settings": { "foreground": "#FFEE80" }
        },
        {
            "name": "[Storage] — The main color for Storage",
            "scope": "storage",
            "settings": { "foreground": "#FAD000" }
        },
        {
            "name": "[Storage] — The color for Storage Type Arrow Function",
            "scope": "storage.type.function.arrow",
            "settings": { "foreground": "#FAD000" }
        },
        {
            "name": "[String]",
            "scope": ["string", "punctuation.definition.string"],
            "settings": { "foreground": "#0483b6" }
        },
        {
            "name": "[String] Template Color",
            "scope": [
                "string.template",
                "punctuation.definition.string.template"
            ],
            "settings": { "foreground": "#fca453" }
        },
        {
            "name": "[Support]",
            "scope": "support",
            "settings": { "foreground": "#ff8080" }
        },
        {
            "name": "[Support] Function Colors",
            "scope": "support.function",
            "settings": { "foreground": "#FF9D00" }
        },
        {
            "name": "[Support] Variable Property DOM Colors",
            "scope": "support.variable.property.dom",
            "settings": { "foreground": "#ff9e9e" }
        },
        {
            "name": "[Variable]",
            "scope": "variable",
            "settings": { "foreground": "#4703e6" }
        },
        {
            "name": "[CSS] - Color for Entity",
            "scope": ["source.css entity", "source.stylus entity"],
            "settings": { "foreground": "#3AD900" }
        },
        {
            "name": "[CSS] - Color for Class Selector",
            "scope": "entity.other.attribute-name.class.css",
            "settings": { "foreground": "#db2c92" }
        },
        {
            "name": "[CSS] - Color for ID Selector",
            "scope": [
                "entity.other.attribute-name.id.css",
                "entity.other.attribute-name.pseudo-class.css"
            ],
            "settings": { "foreground": "#db2c92" }
        },
        {
            "name": "[CSS] - Color for Element Selector",
            "scope": "entity.name.tag",
            "settings": { "foreground": "#805050" }
        },
        {
            "name": "[CSS] - Color for Support",
            "scope": [
                "source.css support",
                "entity.name.tag.css",
                "source.stylus support"
            ],
            "settings": { "foreground": "#1773b1" }
        },
        {
            "name": "[CSS] - Color for Constant",
            "scope": [
                "source.css constant",
                "source.css support.constant",
                "source.stylus constant",
                "source.stylus support.constant"
            ],
            "settings": { "foreground": "#029967" }
        },
        {
            "name": "[CSS] - Color for String",
            "scope": [
                "source.css string",
                "source.css punctuation.definition.string",
                "source.stylus string",
                "source.stylus punctuation.definition.string"
            ],
            "settings": { "foreground": "#415683" }
        },
        {
            "name": "[CSS] - Color for Variable",
            "scope": ["source.css variable", "source.stylus variable"],
            "settings": { "foreground": "#ff9e9e" }
        },
        {
            "name": "[HTML] - Color for Entity Name",
            "scope": [
                "text.html.basic entity.name",
                "punctuation.definition.tag.html",
                "entity.name.tag.inline.any.html",
                "meta.tag.other.html",
                "meta.tag.inline.any.html",
                "punctuation.definition.tag.begin.html",
                "punctuation.definition.tag.end.html",
                "entity.name.tag",
                "meta.tag.other.html",
                "meta.tag.other.js",
                "meta.tag.other.tsx",
                "entity.name.tag.tsx",
                "entity.name.tag.js",
                "entity.name.tag",
                "meta.tag.js",
                "meta.tag.tsx",
                "meta.tag.html"
            ],
            "settings": { "foreground": "#0509ce" }
        },
        {
            "name": "[HTML] - Color for ID value",
            "scope": "meta.toc-list.id.html",
            "settings": { "foreground": "#d61455" }
        },
        {
            "name": "[HTML] - Color for Entity Other",
            "scope": "text.html.basic entity.other",
            "settings": { "foreground": "#FAD000" }
        },
        {
            "name": "[HTML] - Color for Script Tag",
            "scope": "meta.tag.metadata.script.html entity.name.tag.html",
            "settings": { "foreground": "#ad9105" }
        },
        {
            "name": "[HTML] - Quotes. Different color to handle expanded selection",
            "scope": "punctuation.definition.string.begin, punctuation.definition.string.end",
            "settings": { "foreground": "#f109de" }
        },
        {
            "name": "[HTML/PUG] Equals Sign",
            "scope": ["meta.tag.inline.any.html", "meta.tag.other"],
            "settings": { "foreground": "#37b605" }
        },
        {
            "name": "[JSON] - Color for Support",
            "scope": "source.json support",
            "settings": { "foreground": "#FAD000" }
        },
        {
            "name": "[JSON] - Color for String",
            "scope": [
                "source.json string",
                "source.json punctuation.definition.string"
            ],
            "settings": { "foreground": "#569947" }
        },
        {
            "name": "[JAVASCRIPT] - Color for Storage Type Function",
            "scope": "source.js storage.type.function",
            "settings": { "foreground": "#1293cf" }
        },
        {
            "name": "[JAVASCRIPT] - Color for Variable Language",
            "scope": "variable.language, entity.name.type.class.js",
            "settings": { "foreground": "#bc6ebe" }
        },
        {
            "name": "[JAVASCRIPT] - Color for Inherited Component",
            "scope": ["entity.other.inherited-class"],
            "settings": { "foreground": "#FFEE80" }
        },
        {
            "name": "[JAVASCRIPT] - Color for React Extends keyword",
            "scope": ["storage.type.extends.js", "storage.type.class.jsdoc"],
            "settings": { "foreground": "#fa0d08f5" }
        },
        {
            "name": "[JAVASCRIPT] — Docs Keywords",
            "scope": "punctuation.definition.block.tag.jsdoc",
            "settings": { "foreground": "#b87203" }
        },
        {
            "name": "[JAVASCRIPT] — Doc Var Types",
            "scope": [
                "variable.other.jsdoc",
                "entity.name.type.instance.jsdoc"
            ],
            "settings": { "foreground": "#ac0505" }
        },
        {
            "name": "[JAVASCRIPT] — Var Types",
            "scope": ["variable.other.constant"],
            "settings": { "foreground": "#0588af" }
        },
        {
            "name": "[JAVASCRIPT REACT] — JSX HTML",
            "scope": [
                "punctuation.definition.tag.begin.js",
                "punctuation.definition.tag.end.js"
            ],
            "settings": { "foreground": "#69adad" }
        },
        {
            "name": "[JAVASCRIPT REACT] — JSX HTML Children Text",
            "scope": "meta.jsx.children.js",
            "settings": { "foreground": "#aaa9a9" }
        },
        {
            "name": "[JAVASCRIPT] — Storage types",
            "scope": [
                "storage.type",
                "storage.type.class",
                "storage.modifier",
                "keyword.control",
                "keyword.operator"
            ],
            "settings": { "foreground": "#886eb1" }
        },
        {
            "name": "[JAVASCRIPT] — Docs Useless stuff",
            "scope": "punctuation.definition.bracket.curly",
            "settings": { "foreground": "#494685" }
        },
        {
            "name": "Typescript React Assignment Operator",
            "scope": [
                "keyword.operator.assignment.tsx",
                "keyword.operator.assignment.jsx"
            ],
            "settings": { "foreground": "#b37107" }
        },
        {
            "name": "[JAVASCRIPT] Keyword Operator Assignment",
            "scope": "keyword.operator.assignment",
            "settings": { "foreground": "#ff81ee" }
        },
        {
            "name": "[JAVASCRIPT] Typescript/React Children",
            "scope": "meta.jsx.children.tsx",
            "settings": { "foreground": "#53da05" }
        },
        {
            "name": "[JAVASCRIPT] - Object keys",
            "scope": "meta.object-literal.key.js",
            "settings": { "foreground": "#80FFBB" }
        },
        {
            "name": "[JAVASCRIPT] - .something",
            "scope": [
                "variable.other.property",
                "variable.other.object.property"
            ],
            "settings": { "foreground": "#6dbe48" }
        },
        {
            "name": "[JAVASCRIPT] - Color for Text inside JSX",
            "scope": "JSXNested",
            "settings": { "foreground": "#FFFFFF" }
        },
        {
            "name": "[JAVASCRIPT] - Parameters",
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#9dff00" }
        },
        {
            "name": "[MARKDOWN] - Color for Heading Name Section",
            "scope": [
                "entity.name.section.markdown",
                "markup.heading.setext.1.markdown",
                "markup.heading.setext.2.markdown"
            ],
            "settings": { "foreground": "#622F22", "fontStyle": "bold" }
        },
        {
            "name": "[MARKDOWN] - Color for Paragraph",
            "scope": "meta.paragraph.markdown",
            "settings": { "foreground": "#835C3B" }
        },
        {
            "name": "[MARKDOWN] - Color for Text inside inline code block `code`",
            "scope": "markup.inline.raw.string.markdown",
            "settings": { "foreground": "#566D7E" }
        },
        {
            "name": "[MARKDOWN] - Color for Quote Paragraph",
            "scope": [
                "markup.quote.markdown meta.paragraph.markdown",
                "punctuation.definition.quote.begin.markdown"
            ],
            "settings": { "foreground": "#52595D" }
        },
        {
            "name": "[MARKDOWN] - Color for Separator",
            "scope": "meta.separator.markdown",
            "settings": { "foreground": "#0874b3" }
        },
        {
            "name": "[MARKDOWN] - Color for Emphasis Bold",
            "scope": "markup.bold.markdown",
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "[MARKDOWN] - Color for Emphasis Italic",
            "scope": "markup.italic.markdown",
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "[MARKDOWN] - Color for Lists",
            "scope": [
                "beginning.punctuation.definition.list.markdown",
                "punctuation.definition.list.begin.markdown",
                "markup.list.unnumbered.markdown"
            ],
            "settings": { "foreground": "#622F22" }
        },
        {
            "name": "[MARKDOWN] - Link/Image title string",
            "scope": [
                "string.other.link.description.title.markdown punctuation.definition.string.markdown",
                "meta.link.inline.markdown string.other.link.description.title.markdown",
                "string.other.link.description.title.markdown punctuation.definition.string.begin.markdown",
                "string.other.link.description.title.markdown punctuation.definition.string.end.markdown",
                "meta.image.inline.markdown string.other.link.description.title.markdown"
            ],
            "settings": { "foreground": "#566D7E", "fontStyle": "" }
        },
        {
            "name": "[MARKDOWN] - Color for Link Title",
            "scope": [
                "meta.link.inline.markdown string.other.link.title.markdown",
                "meta.link.reference.markdown string.other.link.title.markdown",
                "meta.link.reference.def.markdown markup.underline.link.markdown"
            ],
            "settings": { "foreground": "#560319", "fontStyle": "underline" }
        },
        {
            "name": "[MARKDOWN] - Color for Link/Image Title",
            "scope": [
                "markup.underline.link.markdown",
                "string.other.link.description.title.markdown"
            ],
            "settings": { "foreground": "#7D0552" }
        },
        {
            "name": "[MARKDOWN] - Color for Punctuation — Heading, `Code` and fenced ```code blocks```, **Bold**",
            "scope": [
                "punctuation.definition.markdown",
                "punctuation.definition.raw.markdown",
                "punctuation.definition.heading.markdown",
                "punctuation.definition.bold.markdown",
                "punctuation.definition.italic.markdown"
            ],
            "settings": { "foreground": "#2F539B" }
        },
        {
            "name": "[MARKDOWN] - IMG LINK Brackets",
            "scope": [
                "meta.image.inline.markdown punctuation.definition.string.begin.markdown",
                "meta.image.inline.markdown punctuation.definition.string.end.markdown",
                "string.other.link.description.markdown"
            ],
            "settings": { "foreground": "#C25A7C" }
        },
        {
            "name": "[MARKDOWN] - LINK ALT URI",
            "scope": [
                "markup.underline.link.markdown",
                "punctuation.definition.metadata.markdown",
                "markup.underline.link.image.markdown",
                "constant.other.reference.link.markdown",
                "punctuation.definition.constant.markdown",
                "punctuation.definition.constant.begin.markdown",
                "punctuation.definition.constant.end.markdown"
            ],
            "settings": { "foreground": "#07657c" }
        },
        {
            "name": "[JS] — Double Destructure of Object",
            "scope": ["variable.object.property"],
            "settings": { "foreground": "#9EFFFF" }
        },
        {
            "name": "[JS] — Regex",
            "scope": ["string.regexp.js"],
            "settings": { "foreground": "#FB94FF" }
        },
        {
            "name": "Deleted",
            "scope": ["markup.deleted"],
            "settings": { "foreground": "#F16E6B" }
        },
        {
            "name": "Inserted",
            "scope": ["markup.inserted"],
            "settings": { "foreground": "#8efa00" }
        },
        {
            "name": "Underline",
            "scope": ["markup.underline"],
            "settings": { "fontStyle": "underline" }
        },
        {
            "name": "[ITALICS] All the awesome italics live here.",
            "scope": [
                "modifier",
                "this",
                "comment",
                "storage.modifier",
                "entity.other.attribute-name",
                "entity.other.attribute-name.html",
                "punctuation.definition.comment",
                "text.html.basic entity.other",
                "entity.other.attribute-name",
                "markup.quote.markdown meta.paragraph.markdown",
                "markup.italic.markdown",
                "text.jade entity.other.attribute-name.tag",
                "keyword.control.from",
                "entity.other.attribute-name.tag.pug"
            ],
            "settings": { "fontStyle": "italic" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
