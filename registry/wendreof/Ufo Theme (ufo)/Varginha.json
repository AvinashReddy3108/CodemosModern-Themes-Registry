{
    "$schema": "vscode://schemas/color-theme",
    "name": "Varginha",
    "type": "dark",
    "colors": {
        "editor.background": "#1C1C1C",
        "editor.foreground": "#E6E6E6",
        "editorCursor.foreground": "#FF0000",
        "editor.lineHighlightBackground": "#2A2A2A",
        "editor.selectionBackground": "#4A4A4A",
        "editor.inactiveSelectionBackground": "#3A3A3A",
        "editorLineNumber.foreground": "#8A8A8A",
        "editorLineNumber.activeForeground": "#FF0000",
        "activityBar.background": "#1A1A1A",
        "sideBar.background": "#252525",
        "statusBar.background": "#1A1A1A",
        "tab.activeBackground": "#2A2A2A",
        "tab.inactiveBackground": "#1C1C1C",
        "tab.border": "#1A1A1A"
    },
    "tokenColors": [
        {
            "scope": [
                "comment",
                "punctuation.definition.comment",
                "string.comment"
            ],
            "settings": { "foreground": "#8A8A8A" }
        },
        {
            "scope": ["variable", "variable.other", "variable.language"],
            "settings": { "foreground": "#FF0000" }
        },
        { "scope": "keyword", "settings": { "foreground": "#FF4500" } },
        { "scope": "string", "settings": { "foreground": "#00FF00" } },
        {
            "scope": "constant.numeric",
            "settings": { "foreground": "#FFD700" }
        },
        {
            "scope": "entity.name.function",
            "settings": { "foreground": "#00BFFF" }
        },
        {
            "scope": "variable.parameter",
            "settings": { "foreground": "#FF69B4" }
        },
        { "scope": "storage.type", "settings": { "foreground": "#FF6347" } },
        { "scope": "entity.name.type", "settings": { "foreground": "#7B68EE" } }
    ]
}
