{
    "name": "Dark (UFO)",
    "type": "dark",
    "colors": {
        "editor.background": "#121212",
        "editor.foreground": "#E0E0E0",
        "editorCursor.foreground": "#FF4500",
        "editor.lineHighlightBackground": "#1E1E1E",
        "editor.selectionBackground": "#333333",
        "editor.inactiveSelectionBackground": "#2A2A2A",
        "editorLineNumber.foreground": "#8A8A8A",
        "editorLineNumber.activeForeground": "#FF4500",
        "activityBar.background": "#1E1E1E",
        "sideBar.background": "#1A1A1A",
        "statusBar.background": "#1E1E1E",
        "tab.activeBackground": "#333333",
        "tab.inactiveBackground": "#121212",
        "tab.border": "#1E1E1E"
    },
    "tokenColors": [
        {
            "scope": [
                "comment",
                "punctuation.definition.comment",
                "string.comment"
            ],
            "settings": { "foreground": "#8A8A8A" }
        },
        {
            "scope": ["variable", "variable.other", "variable.language"],
            "settings": { "foreground": "#FF4500" }
        },
        { "scope": "keyword", "settings": { "foreground": "#FF6347" } },
        { "scope": "string", "settings": { "foreground": "#32CD32" } },
        {
            "scope": "constant.numeric",
            "settings": { "foreground": "#FFD700" }
        },
        {
            "scope": "entity.name.function",
            "settings": { "foreground": "#1E90FF" }
        },
        {
            "scope": "variable.parameter",
            "settings": { "foreground": "#FF69B4" }
        },
        { "scope": "storage.type", "settings": { "foreground": "#FF4500" } },
        { "scope": "entity.name.type", "settings": { "foreground": "#7B68EE" } }
    ],
    "$schema": "vscode://schemas/color-theme"
}
