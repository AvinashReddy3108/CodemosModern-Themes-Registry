{
    "name": "Dark Blue (UFO)",
    "type": "dark",
    "colors": {
        "editor.background": "#0A0E1A",
        "editor.foreground": "#A8DADC",
        "editorCursor.foreground": "#E63946",
        "editor.lineHighlightBackground": "#1D3557",
        "editor.selectionBackground": "#457B9D",
        "editor.inactiveSelectionBackground": "#1D3557",
        "editorLineNumber.foreground": "#A8DADC",
        "editorLineNumber.activeForeground": "#E63946",
        "activityBar.background": "#1D3557",
        "sideBar.background": "#0A0E1A",
        "statusBar.background": "#1D3557",
        "tab.activeBackground": "#457B9D",
        "tab.inactiveBackground": "#0A0E1A",
        "tab.border": "#1D3557"
    },
    "tokenColors": [
        {
            "scope": [
                "comment",
                "punctuation.definition.comment",
                "string.comment"
            ],
            "settings": { "foreground": "#6C757D" }
        },
        {
            "scope": ["variable", "variable.other", "variable.language"],
            "settings": { "foreground": "#E63946" }
        },
        { "scope": "keyword", "settings": { "foreground": "#F4A261" } },
        { "scope": "string", "settings": { "foreground": "#2A9D8F" } },
        {
            "scope": "constant.numeric",
            "settings": { "foreground": "#E9C46A" }
        },
        {
            "scope": "entity.name.function",
            "settings": { "foreground": "#1D3557" }
        },
        {
            "scope": "variable.parameter",
            "settings": { "foreground": "#F4A261" }
        },
        { "scope": "storage.type", "settings": { "foreground": "#E63946" } },
        { "scope": "entity.name.type", "settings": { "foreground": "#A8DADC" } }
    ],
    "$schema": "vscode://schemas/color-theme"
}
