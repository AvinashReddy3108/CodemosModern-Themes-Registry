{
    "name": "Jewelry",
    "$schema": "vscode://schemas/color-theme",
    "type": "dark",
    "colors": {
        "terminal.background": "#1e1e2e",
        "terminal.foreground": "#cdd6f4",
        "terminalCursor.foreground": "#f5c2e7",
        "terminalCursor.background": "#1e1e2e",
        "terminal.selectionBackground": "#585b7054",
        "terminal.inactiveSelectionBackground": "#45475a44",
        "terminal.ansiBlack": "#45475a",
        "terminal.ansiRed": "#f38ba8",
        "terminal.ansiGreen": "#a6e3a1",
        "terminal.ansiYellow": "#f9e2af",
        "terminal.ansiBlue": "#89b4fa",
        "terminal.ansiMagenta": "#cba6f7",
        "terminal.ansiCyan": "#94e2d5",
        "terminal.ansiWhite": "#bac2de",
        "terminal.ansiBrightBlack": "#585b70",
        "terminal.ansiBrightRed": "#f38ba8",
        "terminal.ansiBrightGreen": "#a6e3a1",
        "terminal.ansiBrightYellow": "#f9e2af",
        "terminal.ansiBrightBlue": "#89b4fa",
        "terminal.ansiBrightMagenta": "#cba6f7",
        "terminal.ansiBrightCyan": "#94e2d5",
        "terminal.ansiBrightWhite": "#cdd6f4"
    },
    "tokenColors": [
        {
            "name": "Comment",
            "scope": [
                "comment",
                "comment.line",
                "comment.block",
                "comment.block.documentation",
                "punctuation.definition.comment"
            ],
            "settings": { "foreground": "#6c7086", "fontStyle": "italic" }
        },
        {
            "name": "String",
            "scope": [
                "string",
                "string.quoted.single",
                "string.quoted.double",
                "string.quoted.triple",
                "string.template",
                "string.unquoted"
            ],
            "settings": { "foreground": "#a6e3a1" }
        },
        {
            "name": "String escape / special chars",
            "scope": [
                "constant.character.escape",
                "constant.character.format.placeholder",
                "string.regexp"
            ],
            "settings": { "foreground": "#94e2d5" }
        },
        {
            "name": "Template expression punctuation  (JS/TS  ${ })",
            "scope": [
                "punctuation.definition.template-expression.begin",
                "punctuation.definition.template-expression.end"
            ],
            "settings": { "foreground": "#cba6f7" }
        },
        {
            "name": "Number",
            "scope": [
                "constant.numeric",
                "constant.numeric.integer",
                "constant.numeric.float",
                "constant.numeric.hex",
                "constant.numeric.octal",
                "constant.numeric.binary"
            ],
            "settings": { "foreground": "#fab387" }
        },
        {
            "name": "Boolean / null / undefined",
            "scope": [
                "constant.language.boolean",
                "constant.language.null",
                "constant.language.undefined",
                "constant.language.none.python",
                "constant.language.true",
                "constant.language.false"
            ],
            "settings": { "foreground": "#fab387" }
        },
        {
            "name": "Built-in constant (None/True/False Python, nullptr C++)",
            "scope": [
                "constant.language",
                "variable.language.special.self.python",
                "variable.language.special.cls.python"
            ],
            "settings": { "foreground": "#fab387" }
        },
        {
            "name": "Keyword — control flow",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.control.flow",
                "keyword.control.import",
                "keyword.control.from",
                "keyword.control.conditional",
                "keyword.control.loop"
            ],
            "settings": { "foreground": "#cba6f7" }
        },
        {
            "name": "Storage modifier (async, static, public, const, let, var…)",
            "scope": [
                "storage",
                "storage.type",
                "storage.modifier",
                "keyword.declaration",
                "keyword.other.rust"
            ],
            "settings": { "foreground": "#cba6f7" }
        },
        {
            "name": "Keyword operator (arithmetic, comparison, logical)",
            "scope": [
                "keyword.operator",
                "keyword.operator.arithmetic",
                "keyword.operator.comparison",
                "keyword.operator.logical",
                "keyword.operator.bitwise",
                "keyword.operator.assignment"
            ],
            "settings": { "foreground": "#89dceb" }
        },
        {
            "name": "new / delete / typeof / instanceof / sizeof",
            "scope": [
                "keyword.operator.new",
                "keyword.operator.delete",
                "keyword.operator.typeof",
                "keyword.operator.instanceof",
                "keyword.operator.sizeof",
                "keyword.operator.cast"
            ],
            "settings": { "foreground": "#cba6f7" }
        },
        {
            "name": "Python — import / from / as / in / not / and / or / is",
            "scope": [
                "keyword.control.import.python",
                "keyword.control.flow.python",
                "keyword.operator.logical.python",
                "keyword.operator.wordlike.python"
            ],
            "settings": { "foreground": "#cba6f7" }
        },
        {
            "name": "Rust — lifetime",
            "scope": [
                "entity.name.lifetime.rust",
                "storage.modifier.lifetime.rust",
                "punctuation.definition.lifetime.rust"
            ],
            "settings": { "foreground": "#f5c2e7" }
        },
        {
            "name": "Rust — macro invocation",
            "scope": [
                "support.macro.rust",
                "entity.name.function.macro.rust",
                "meta.macro.rust"
            ],
            "settings": { "foreground": "#f5c2e7" }
        },
        {
            "name": "Function / method name — definition",
            "scope": [
                "entity.name.function",
                "entity.name.function.member",
                "meta.definition.method entity.name.function",
                "meta.function-call entity.name.function"
            ],
            "settings": { "foreground": "#89b4fa" }
        },
        {
            "name": "Built-in / support functions",
            "scope": [
                "support.function",
                "support.function.builtin",
                "support.function.builtin.python"
            ],
            "settings": { "foreground": "#89b4fa" }
        },
        {
            "name": "Class / struct / enum name",
            "scope": [
                "entity.name.class",
                "entity.name.type.class",
                "entity.name.struct",
                "entity.name.enum",
                "support.class"
            ],
            "settings": { "foreground": "#f9e2af" }
        },
        {
            "name": "Interface name (TS / Java)",
            "scope": ["entity.name.type.interface"],
            "settings": { "foreground": "#74c7ec" }
        },
        {
            "name": "Type annotation / primitive type",
            "scope": [
                "entity.name.type",
                "support.type",
                "support.type.primitive",
                "support.type.builtin",
                "keyword.type",
                "meta.type.annotation",
                "storage.type.primitive",
                "storage.type.built-in.primitive",
                "storage.type.c",
                "storage.type.cpp"
            ],
            "settings": { "foreground": "#94e2d5" }
        },
        {
            "name": "Generic / type parameter",
            "scope": ["entity.name.type.parameter", "variable.type.var"],
            "settings": { "foreground": "#cba6f7" }
        },
        {
            "name": "Enum member / constant",
            "scope": ["variable.other.enummember", "constant.other.enum"],
            "settings": { "foreground": "#fab387" }
        },
        {
            "name": "Variable",
            "scope": ["variable", "variable.other", "variable.other.readwrite"],
            "settings": { "foreground": "#cdd6f4" }
        },
        {
            "name": "Function parameter",
            "scope": [
                "variable.parameter",
                "meta.function.parameter variable.other"
            ],
            "settings": { "foreground": "#f2cdcd" }
        },
        {
            "name": "Object property / member access",
            "scope": [
                "variable.other.property",
                "variable.other.object.property",
                "support.variable.property",
                "meta.object-literal.key"
            ],
            "settings": { "foreground": "#89dceb" }
        },
        {
            "name": "this / self / super",
            "scope": [
                "variable.language.this",
                "variable.language.self",
                "variable.language.super"
            ],
            "settings": { "foreground": "#f38ba8" }
        },
        {
            "name": "Decorator / annotation",
            "scope": [
                "meta.decorator",
                "punctuation.decorator",
                "entity.name.function.decorator",
                "storage.type.annotation.java",
                "punctuation.definition.annotation.java"
            ],
            "settings": { "foreground": "#f5c2e7" }
        },
        {
            "name": "Punctuation — braces, brackets, parens",
            "scope": [
                "punctuation",
                "punctuation.definition.block",
                "punctuation.section",
                "meta.brace.round",
                "meta.brace.square",
                "meta.brace.curly"
            ],
            "settings": { "foreground": "#9399b2" }
        },
        {
            "name": "Punctuation — separator / terminator",
            "scope": ["punctuation.separator", "punctuation.terminator"],
            "settings": { "foreground": "#9399b2" }
        },
        {
            "name": "HTML — tag name",
            "scope": ["entity.name.tag", "entity.name.tag.html"],
            "settings": { "foreground": "#f38ba8" }
        },
        {
            "name": "HTML — attribute name",
            "scope": [
                "entity.other.attribute-name",
                "entity.other.attribute-name.html"
            ],
            "settings": { "foreground": "#89b4fa" }
        },
        {
            "name": "HTML — attribute value / string",
            "scope": ["string.quoted.double.html", "string.quoted.single.html"],
            "settings": { "foreground": "#a6e3a1" }
        },
        {
            "name": "HTML — doctype",
            "scope": ["meta.tag.sgml.doctype", "entity.name.tag.doctype"],
            "settings": { "foreground": "#6c7086", "fontStyle": "italic" }
        },
        {
            "name": "JSX / TSX component (capitalised tag)",
            "scope": [
                "support.class.component",
                "entity.name.tag.tsx",
                "entity.name.tag.jsx"
            ],
            "settings": { "foreground": "#f9e2af" }
        },
        {
            "name": "JSX expression braces",
            "scope": [
                "punctuation.section.embedded",
                "punctuation.section.embedded.begin.jsx",
                "punctuation.section.embedded.end.jsx"
            ],
            "settings": { "foreground": "#cba6f7" }
        },
        {
            "name": "CSS — element / tag selector",
            "scope": ["entity.name.tag.css", "source.css entity.name.tag"],
            "settings": { "foreground": "#f38ba8" }
        },
        {
            "name": "CSS — class selector",
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.class"
            ],
            "settings": { "foreground": "#f9e2af" }
        },
        {
            "name": "CSS — id selector",
            "scope": [
                "entity.other.attribute-name.id.css",
                "entity.other.attribute-name.id"
            ],
            "settings": { "foreground": "#fab387" }
        },
        {
            "name": "CSS — pseudo-class / pseudo-element",
            "scope": [
                "entity.other.attribute-name.pseudo-class.css",
                "entity.other.attribute-name.pseudo-element.css"
            ],
            "settings": { "foreground": "#cba6f7" }
        },
        {
            "name": "CSS — property name",
            "scope": [
                "support.type.property-name.css",
                "support.type.property-name"
            ],
            "settings": { "foreground": "#89dceb" }
        },
        {
            "name": "CSS — property value",
            "scope": [
                "support.constant.property-value.css",
                "support.constant.property-value"
            ],
            "settings": { "foreground": "#a6e3a1" }
        },
        {
            "name": "CSS — unit",
            "scope": ["keyword.other.unit.css", "keyword.other.unit"],
            "settings": { "foreground": "#fab387" }
        },
        {
            "name": "CSS — at-rule (@media, @keyframes…)",
            "scope": ["keyword.control.at-rule", "keyword.control.at-rule.css"],
            "settings": { "foreground": "#cba6f7" }
        },
        {
            "name": "CSS — variable (--custom-prop)",
            "scope": [
                "variable.css",
                "variable.argument.css",
                "support.variable.css"
            ],
            "settings": { "foreground": "#89b4fa" }
        },
        {
            "name": "C/C++ — preprocessor directive (#include, #define…)",
            "scope": [
                "keyword.control.directive",
                "keyword.control.directive.include",
                "keyword.control.directive.define",
                "keyword.control.directive.conditional",
                "meta.preprocessor"
            ],
            "settings": { "foreground": "#f5c2e7" }
        },
        {
            "name": "C/C++ — include path / angle-bracket string",
            "scope": [
                "string.quoted.other.lt-gt.include",
                "string.quoted.include"
            ],
            "settings": { "foreground": "#a6e3a1" }
        },
        {
            "name": "C/C++ — macro / define constant",
            "scope": [
                "entity.name.function.preprocessor",
                "entity.name.other.preprocessor.macro"
            ],
            "settings": { "foreground": "#f5c2e7" }
        },
        {
            "name": "C/C++ — pointer / reference operator",
            "scope": [
                "storage.modifier.pointer.cpp",
                "storage.modifier.reference.cpp"
            ],
            "settings": { "foreground": "#89dceb" }
        },
        {
            "name": "C/C++ — namespace",
            "scope": ["entity.name.namespace", "entity.name.scope-resolution"],
            "settings": { "foreground": "#f9e2af" }
        },
        {
            "name": "Java — package / import declaration",
            "scope": [
                "storage.modifier.import.java",
                "storage.modifier.package.java",
                "variable.language.wildcard.java"
            ],
            "settings": { "foreground": "#cdd6f4" }
        },
        {
            "name": "Python — magic / dunder method",
            "scope": [
                "support.function.magic.python",
                "support.variable.magic.python"
            ],
            "settings": { "foreground": "#f5c2e7" }
        },
        {
            "name": "Python — f-string brace",
            "scope": [
                "punctuation.definition.f-string.begin.python",
                "punctuation.definition.f-string.end.python",
                "meta.fstring.python"
            ],
            "settings": { "foreground": "#cba6f7" }
        },
        {
            "name": "Python — decorator @",
            "scope": [
                "entity.name.function.decorator.python",
                "punctuation.definition.decorator.python"
            ],
            "settings": { "foreground": "#f5c2e7" }
        },
        {
            "name": "YAML — key",
            "scope": ["entity.name.tag.yaml", "entity.name.tag"],
            "settings": { "foreground": "#89b4fa" }
        },
        {
            "name": "YAML — string value",
            "scope": [
                "string.unquoted.plain.out.yaml",
                "string.unquoted.plain.in.yaml",
                "string.quoted.single.yaml",
                "string.quoted.double.yaml"
            ],
            "settings": { "foreground": "#a6e3a1" }
        },
        {
            "name": "YAML — block scalar (| and >)",
            "scope": ["string.unquoted.block.yaml"],
            "settings": { "foreground": "#a6e3a1" }
        },
        {
            "name": "YAML — anchor (&) and alias (*)",
            "scope": [
                "entity.name.type.anchor.yaml",
                "variable.other.alias.yaml",
                "punctuation.definition.anchor.yaml",
                "punctuation.definition.alias.yaml"
            ],
            "settings": { "foreground": "#f5c2e7" }
        },
        {
            "name": "YAML — directive / document marker (--- / ...)",
            "scope": [
                "meta.document.yaml",
                "punctuation.definition.document.yaml",
                "keyword.control.flow.yaml"
            ],
            "settings": { "foreground": "#cba6f7" }
        },
        {
            "name": "YAML — boolean / null / number",
            "scope": [
                "constant.language.boolean.yaml",
                "constant.language.null.yaml",
                "constant.numeric.yaml",
                "constant.numeric.integer.yaml",
                "constant.numeric.float.yaml"
            ],
            "settings": { "foreground": "#fab387" }
        },
        {
            "name": "YAML — punctuation (colon, dash, brackets)",
            "scope": [
                "punctuation.separator.key-value.yaml",
                "punctuation.definition.block.sequence.item.yaml",
                "punctuation.definition.sequence.begin.yaml",
                "punctuation.definition.sequence.end.yaml",
                "punctuation.definition.mapping.begin.yaml",
                "punctuation.definition.mapping.end.yaml"
            ],
            "settings": { "foreground": "#9399b2" }
        },
        {
            "name": "TOML — table / array-of-tables header",
            "scope": [
                "entity.name.section.toml",
                "entity.name.table.toml",
                "support.type.property-name.table.toml",
                "punctuation.definition.table.toml",
                "punctuation.definition.table.array.toml",
                "keyword.other.table.toml",
                "keyword.other.table.array.toml"
            ],
            "settings": { "foreground": "#f9e2af", "fontStyle": "bold" }
        },
        {
            "name": "TOML — key name",
            "scope": [
                "support.type.property-name.toml",
                "variable.key.toml",
                "keyword.key.toml",
                "entity.other.attribute-name.toml"
            ],
            "settings": { "foreground": "#89b4fa" }
        },
        {
            "name": "TOML — string value (all forms)",
            "scope": [
                "string.quoted.single.toml",
                "string.quoted.double.toml",
                "string.quoted.triple.single.toml",
                "string.quoted.triple.double.toml",
                "string.quoted.triple.toml",
                "string.literal.toml",
                "string.basic.toml",
                "string.multiline.basic.toml",
                "string.multiline.literal.toml"
            ],
            "settings": { "foreground": "#a6e3a1" }
        },
        {
            "name": "TOML — integer",
            "scope": [
                "constant.numeric.integer.toml",
                "constant.numeric.integer.binary.toml",
                "constant.numeric.integer.octal.toml",
                "constant.numeric.integer.hexadecimal.toml",
                "constant.numeric.toml"
            ],
            "settings": { "foreground": "#fab387" }
        },
        {
            "name": "TOML — float",
            "scope": [
                "constant.numeric.float.toml",
                "constant.numeric.float.infinity.toml",
                "constant.numeric.float.nan.toml"
            ],
            "settings": { "foreground": "#fab387" }
        },
        {
            "name": "TOML — date / time / datetime",
            "scope": [
                "constant.other.time.datetime.offset.toml",
                "constant.other.time.datetime.local.toml",
                "constant.other.time.date.toml",
                "constant.other.time.time.toml",
                "constant.other.datetime.toml",
                "constant.other.date.toml",
                "constant.other.time.toml"
            ],
            "settings": { "foreground": "#f5c2e7" }
        },
        {
            "name": "TOML — boolean",
            "scope": [
                "constant.language.boolean.toml",
                "constant.language.true.toml",
                "constant.language.false.toml"
            ],
            "settings": { "foreground": "#fab387" }
        },
        {
            "name": "TOML — comment",
            "scope": [
                "comment.line.number-sign.toml",
                "punctuation.definition.comment.toml"
            ],
            "settings": { "foreground": "#6c7086", "fontStyle": "italic" }
        },
        {
            "name": "TOML — punctuation",
            "scope": [
                "punctuation.eq.toml",
                "punctuation.definition.array.toml",
                "punctuation.definition.array.begin.toml",
                "punctuation.definition.array.end.toml",
                "punctuation.definition.inline-table.toml",
                "punctuation.definition.inline-table.begin.toml",
                "punctuation.definition.inline-table.end.toml",
                "punctuation.definition.table.inline.toml",
                "punctuation.separator.toml",
                "punctuation.separator.dot.toml",
                "punctuation.separator.comma.toml"
            ],
            "settings": { "foreground": "#9399b2" }
        },
        {
            "name": "Bash — shebang line",
            "scope": [
                "comment.line.shebang",
                "punctuation.definition.comment.shebang"
            ],
            "settings": { "foreground": "#f5c2e7", "fontStyle": "bold" }
        },
        {
            "name": "Bash — built-in command (echo, cd, export…)",
            "scope": [
                "support.function.builtin.shell",
                "support.function.builtin.bash"
            ],
            "settings": { "foreground": "#89b4fa" }
        },
        {
            "name": "Bash — function name",
            "scope": ["entity.name.function.shell"],
            "settings": { "foreground": "#89b4fa" }
        },
        {
            "name": "Bash — control keyword (if, then, fi, for, while, do…)",
            "scope": ["keyword.control.shell", "keyword.control.bash"],
            "settings": { "foreground": "#cba6f7" }
        },
        {
            "name": "Bash — variable / parameter expansion",
            "scope": [
                "variable.other.normal.shell",
                "variable.other.bracket.shell",
                "variable.other.special.shell",
                "variable.other.positional.shell",
                "variable.other.loop.shell",
                "variable.language.special.shell"
            ],
            "settings": { "foreground": "#89dceb" }
        },
        {
            "name": "Bash — variable expansion punctuation (${ })",
            "scope": [
                "punctuation.definition.variable.shell",
                "punctuation.section.parameter.shell"
            ],
            "settings": { "foreground": "#cba6f7" }
        },
        {
            "name": "Bash — string (double-quoted)",
            "scope": ["string.quoted.double.shell"],
            "settings": { "foreground": "#a6e3a1" }
        },
        {
            "name": "Bash — string (single-quoted / raw)",
            "scope": [
                "string.quoted.single.shell",
                "string.quoted.single.bash"
            ],
            "settings": { "foreground": "#a6e3a1" }
        },
        {
            "name": "Bash — heredoc tag",
            "scope": [
                "keyword.operator.heredoc.shell",
                "keyword.control.heredoc-token.shell"
            ],
            "settings": { "foreground": "#f9e2af" }
        },
        {
            "name": "Bash — operator (pipe, redirect, &&, ||)",
            "scope": [
                "keyword.operator.pipe.shell",
                "keyword.operator.redirect.shell",
                "keyword.operator.logical.shell",
                "keyword.operator.assignment.shell"
            ],
            "settings": { "foreground": "#89dceb" }
        },
        {
            "name": "Bash — flag / option (-v, --verbose)",
            "scope": [
                "string.other.option.shell",
                "support.other.option.shell"
            ],
            "settings": { "foreground": "#fab387" }
        },
        {
            "name": "Dockerfile — instruction keyword (FROM, RUN, CMD…)",
            "scope": [
                "keyword.other.special-method.dockerfile",
                "entity.name.function.dockerfile",
                "support.function.dockerfile",
                "keyword.operator.dockerfile"
            ],
            "settings": { "foreground": "#cba6f7", "fontStyle": "bold" }
        },
        {
            "name": "Dockerfile — image / base name",
            "scope": [
                "variable.other.readwrite.dockerfile",
                "string.other.dockerfile",
                "entity.name.image.dockerfile"
            ],
            "settings": { "foreground": "#f9e2af" }
        },
        {
            "name": "Dockerfile — tag / version (after colon)",
            "scope": [
                "entity.name.tag.dockerfile",
                "constant.other.tag.dockerfile"
            ],
            "settings": { "foreground": "#fab387" }
        },
        {
            "name": "Dockerfile — ARG / ENV variable name",
