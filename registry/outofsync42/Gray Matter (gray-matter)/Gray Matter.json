    "tokenColors": [
        {
            "name": "Variables",
            "scope": [
                "variable",
                "support.class",
                "entity.name.type",
                "entity.other.attribute-name",
                "meta.property-value.css",
                "meta.property-list.css"
            ],
            "settings": { "fontStyle": "", "foreground": "#000" }
        },
        {
            "name": "Comments",
            "scope": [
                "comment",
                "punctuation.definition.comment",
                "comment.documentation",
                "comment.block.documentation"
            ],
            "settings": { "fontStyle": "", "foreground": "#63f182" }
        },
        {
            "name": "Invalid - Illegal",
            "scope": "invalid.illegal",
            "settings": { "foreground": "#d33a3a" }
        },
        {
            "name": "Operators",
            "scope": "keyword.operator",
            "settings": { "foreground": "#fff" }
        },
        {
            "name": "Types",
            "scope": [
                "constant.language",
                "variable.language",
                "storage",
                "storage.type",
                "support.type"
            ],
            "settings": { "foreground": "#0000ff" }
        },
        {
            "name": "Red",
            "scope": "entity.name.exception",
            "settings": { "foreground": "#ff0000" }
        },
        {
            "name": "Constant",
            "scope": [
                "constant.numeric",
                "constant.other.symbol",
                "punctuation.definition.constant",
                "constant.character.entity"
            ],
            "settings": { "foreground": "#ee8484" }
        },
        {
            "name": "String",
            "scope": [
                "string",
                "string.quoted.double.json.comments punctuation",
                "source.sql.embedded.php constant.numeric",
                "source.sql.embedded.php keyword.operator",
                "punctuation.definition.string"
            ],
            "settings": { "foreground": "#63ecf1" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation",
                "punctuation.definition",
                "punctuation.definition.dictionary",
                "punctuation.terminator.statement",
                "punctuation.definition.parameters",
                "punctuation.separator.parameter",
                "punctuation.definition.block",
                "punctuation.definition.array",
                "punctuation.accessor",
                "punctuation.definition.entity"
            ],
            "settings": { "foreground": "#ffffffeb" }
        },
        {
            "name": "C#: Blue",
