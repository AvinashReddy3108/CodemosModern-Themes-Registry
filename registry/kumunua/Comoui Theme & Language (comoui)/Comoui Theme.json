{
    "name": "Comoui Theme",
    "tokenColors": [
        {
            "scope": "keyword.control.comoui",
            "settings": { "foreground": "#FF6B6B" }
        },
        {
            "scope": "keyword.operator.comoui",
            "settings": { "foreground": "#d3d3d3" }
        },
        {
            "scope": "punctuation.separator.comoui",
            "settings": { "foreground": "#A0A0A0" }
        },
        {
            "scope": "meta.preprocessor.comoui",
            "settings": { "foreground": "#4e4e4e", "fontStyle": "bold" }
        },
        {
            "scope": "constant.numeric.comoui",
            "settings": { "foreground": "#ffa946" }
        },
        {
            "scope": "string.quoted.double.comoui",
            "settings": { "foreground": "#c1ff45" }
        },
        {
            "scope": "variable.other.comoui",
            "settings": { "foreground": "#d080ff" }
        },
        {
            "scope": "comment.line.number-sign.comoui",
            "settings": { "foreground": "#4e4e4e", "fontStyle": "italic" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
