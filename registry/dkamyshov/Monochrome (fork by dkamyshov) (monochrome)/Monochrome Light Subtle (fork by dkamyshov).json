    "tokenColors": [
        {
            "scope": "variable.parameter.function",
            "settings": { "foreground": "#0a1219" }
        },
        {
            "scope": "comment, punctuation.definition.comment",
            "settings": { "foreground": "#a8adb2" }
        },
        {
            "scope": "punctuation.definition.string, punctuation.definition.variable, punctuation.definition.parameters, punctuation.definition.array",
            "settings": { "foreground": "#0a1219" }
        },
        { "scope": "none", "settings": { "foreground": "#0a1219" } },
        {
            "scope": "keyword.operator",
            "settings": { "foreground": "#0a1219" }
        },
        { "scope": "keyword", "settings": { "foreground": "#474e55" } },
        { "scope": "variable", "settings": { "foreground": "#3f474d" } },
        {
            "scope": "entity.name.function, meta.require, support.function.any-method",
            "settings": { "foreground": "#595f65" }
        },
        {
            "scope": "support.class, entity.name.class, entity.name.type.class",
            "settings": { "foreground": "#0a1219" }
        },
        { "scope": "meta.class", "settings": { "foreground": "#0a1219" } },
        {
            "scope": "keyword.other.special-method",
            "settings": { "foreground": "#595f65" }
        },
        { "scope": "storage", "settings": { "foreground": "#474e55" } },
        {
            "scope": "support.function",
            "settings": { "foreground": "#262e34" }
        },
        {
            "scope": "string, constant.other.symbol, entity.other.inherited-class",
            "settings": { "foreground": "#161e25" }
        },
        {
            "scope": "constant.numeric",
            "settings": { "foreground": "#0b131a" }
        },
        { "scope": "none", "settings": { "foreground": "#0b131a" } },
        { "scope": "none", "settings": { "foreground": "#0b131a" } },
        { "scope": "constant", "settings": { "foreground": "#0b131a" } },
        { "scope": "entity.name.tag", "settings": { "foreground": "#3f474d" } },
        {
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#0b131a" }
        },
        {
            "scope": "entity.other.attribute-name.id, punctuation.definition.entity",
            "settings": { "foreground": "#595f65" }
        },
        { "scope": "meta.selector", "settings": { "foreground": "#474e55" } },
        { "scope": "none", "settings": { "foreground": "#0b131a" } },
        {
            "scope": "markup.heading punctuation.definition.heading, entity.name.section",
            "settings": { "foreground": "#595f65", "fontStyle": "" }
        },
        {
            "scope": "keyword.other.unit",
            "settings": { "foreground": "#0b131a" }
        },
        {
            "scope": "markup.bold, punctuation.definition.bold",
            "settings": { "foreground": "#0a1219", "fontStyle": "bold" }
        },
        {
            "scope": "markup.italic, punctuation.definition.italic",
            "settings": { "foreground": "#474e55", "fontStyle": "italic" }
        },
        {
            "scope": "markup.raw.inline",
            "settings": { "foreground": "#161e25" }
        },
        {
            "scope": "string.other.link, punctuation.definition.string.end.markdown",
            "settings": { "foreground": "#3f474d" }
        },
        { "scope": "meta.link", "settings": { "foreground": "#0b131a" } },
        { "scope": "markup.list", "settings": { "foreground": "#3f474d" } },
        { "scope": "markup.quote", "settings": { "foreground": "#0b131a" } },
        { "scope": "meta.separator", "settings": { "foreground": "#0a1219" } },
        { "scope": "markup.inserted", "settings": { "foreground": "#161e25" } },
        { "scope": "markup.deleted", "settings": { "foreground": "#3f474d" } },
        { "scope": "markup.changed", "settings": { "foreground": "#474e55" } },
        {
            "scope": "constant.other.color",
            "settings": { "foreground": "#262e34" }
        },
        { "scope": "string.regexp", "settings": { "foreground": "#262e34" } },
        {
            "scope": "constant.character.escape",
            "settings": { "foreground": "#262e34" }
        },
        {
            "scope": "punctuation.section.embedded, variable.interpolation",
            "settings": { "foreground": "#474e55" }
        },
        { "scope": "invalid.illegal", "settings": { "foreground": "#0a1219" } },
        { "scope": "invalid.broken", "settings": { "foreground": "#f1f5f9" } },
        {
            "scope": "invalid.deprecated",
            "settings": { "foreground": "#0a1219" }
        },
        {
            "scope": "invalid.unimplemented",
            "settings": { "foreground": "#0a1219" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
