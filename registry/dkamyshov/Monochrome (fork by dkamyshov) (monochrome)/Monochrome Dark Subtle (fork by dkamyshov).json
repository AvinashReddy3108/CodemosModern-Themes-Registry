    "tokenColors": [
        {
            "scope": "variable.parameter.function",
            "settings": { "foreground": "#f1f5f9" }
        },
        {
            "scope": "comment, punctuation.definition.comment",
            "settings": { "foreground": "#535a60" }
        },
        {
            "scope": "punctuation.definition.string, punctuation.definition.variable, punctuation.definition.parameters, punctuation.definition.array",
            "settings": { "foreground": "#f1f5f9" }
        },
        { "scope": "none", "settings": { "foreground": "#f1f5f9" } },
        {
            "scope": "keyword.operator",
            "settings": { "foreground": "#f1f5f9" }
        },
        { "scope": "keyword", "settings": { "foreground": "#b4b9bd" } },
        { "scope": "variable", "settings": { "foreground": "#bcc0c5" } },
        {
            "scope": "entity.name.function, meta.require, support.function.any-method",
            "settings": { "foreground": "#a2a8ad" }
        },
        {
            "scope": "support.class, entity.name.class, entity.name.type.class",
            "settings": { "foreground": "#f1f5f9" }
        },
        { "scope": "meta.class", "settings": { "foreground": "#f1f5f9" } },
        {
            "scope": "keyword.other.special-method",
            "settings": { "foreground": "#a2a8ad" }
        },
        { "scope": "storage", "settings": { "foreground": "#b4b9bd" } },
        {
            "scope": "support.function",
            "settings": { "foreground": "#d5d9de" }
        },
        {
            "scope": "string, constant.other.symbol, entity.other.inherited-class",
            "settings": { "foreground": "#e5e9ed" }
        },
        {
            "scope": "constant.numeric",
            "settings": { "foreground": "#f0f4f8" }
        },
        { "scope": "none", "settings": { "foreground": "#f0f4f8" } },
        { "scope": "none", "settings": { "foreground": "#f0f4f8" } },
        { "scope": "constant", "settings": { "foreground": "#f0f4f8" } },
        { "scope": "entity.name.tag", "settings": { "foreground": "#bcc0c5" } },
        {
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#f0f4f8" }
        },
        {
            "scope": "entity.other.attribute-name.id, punctuation.definition.entity",
            "settings": { "foreground": "#a2a8ad" }
        },
        { "scope": "meta.selector", "settings": { "foreground": "#b4b9bd" } },
        { "scope": "none", "settings": { "foreground": "#f0f4f8" } },
        {
            "scope": "markup.heading punctuation.definition.heading, entity.name.section",
            "settings": { "foreground": "#a2a8ad", "fontStyle": "" }
        },
        {
            "scope": "keyword.other.unit",
            "settings": { "foreground": "#f0f4f8" }
        },
        {
            "scope": "markup.bold, punctuation.definition.bold",
            "settings": { "foreground": "#f1f5f9", "fontStyle": "bold" }
        },
        {
            "scope": "markup.italic, punctuation.definition.italic",
            "settings": { "foreground": "#b4b9bd", "fontStyle": "italic" }
        },
        {
            "scope": "markup.raw.inline",
            "settings": { "foreground": "#e5e9ed" }
        },
        {
            "scope": "string.other.link, punctuation.definition.string.end.markdown",
            "settings": { "foreground": "#bcc0c5" }
        },
        { "scope": "meta.link", "settings": { "foreground": "#f0f4f8" } },
        { "scope": "markup.list", "settings": { "foreground": "#bcc0c5" } },
        { "scope": "markup.quote", "settings": { "foreground": "#f0f4f8" } },
        { "scope": "meta.separator", "settings": { "foreground": "#f1f5f9" } },
        { "scope": "markup.inserted", "settings": { "foreground": "#e5e9ed" } },
        { "scope": "markup.deleted", "settings": { "foreground": "#bcc0c5" } },
        { "scope": "markup.changed", "settings": { "foreground": "#b4b9bd" } },
        {
            "scope": "constant.other.color",
            "settings": { "foreground": "#d5d9de" }
        },
        { "scope": "string.regexp", "settings": { "foreground": "#d5d9de" } },
        {
            "scope": "constant.character.escape",
            "settings": { "foreground": "#d5d9de" }
        },
        {
            "scope": "punctuation.section.embedded, variable.interpolation",
            "settings": { "foreground": "#b4b9bd" }
        },
        { "scope": "invalid.illegal", "settings": { "foreground": "#f1f5f9" } },
        { "scope": "invalid.broken", "settings": { "foreground": "#0a1219" } },
        {
            "scope": "invalid.deprecated",
            "settings": { "foreground": "#f1f5f9" }
        },
        {
            "scope": "invalid.unimplemented",
            "settings": { "foreground": "#f1f5f9" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
