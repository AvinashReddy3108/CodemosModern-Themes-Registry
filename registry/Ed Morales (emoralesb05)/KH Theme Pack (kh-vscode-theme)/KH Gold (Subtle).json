    "tokenColors": [
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#786F86", "fontStyle": "italic" }
        },
        {
            "scope": ["comment.block.documentation", "comment.documentation"],
            "settings": { "foreground": "#8C7DA1", "fontStyle": "italic" }
        },
        {
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.control.flow",
                "keyword.operator.word",
                "storage",
                "storage.modifier",
                "storage.type"
            ],
            "settings": { "foreground": "#E8C15F", "fontStyle": "bold" }
        },
        {
            "scope": [
                "keyword.operator",
                "punctuation.separator",
                "punctuation.terminator"
            ],
            "settings": { "foreground": "#C9954D" }
        },
        {
            "scope": [
                "entity.name.function",
                "entity.name.function.member",
                "support.function",
                "support.function.builtin",
                "meta.function-call",
                "variable.function"
            ],
            "settings": { "foreground": "#93BCFF" }
        },
        {
            "scope": [
                "string",
                "string.template",
                "punctuation.definition.string"
            ],
            "settings": { "foreground": "#9AE7C2" }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.language.boolean",
                "constant.language.null",
                "constant.character.escape",
                "constant.other.symbol"
            ],
            "settings": { "foreground": "#63DFFF", "fontStyle": "bold" }
        },
        {
            "scope": [
                "entity.name.type",
                "entity.name.type.class",
                "entity.name.type.interface",
                "entity.name.type.enum",
                "entity.name.namespace",
                "support.type",
                "support.class",
                "support.constant"
            ],
            "settings": { "foreground": "#E4D19B" }
        },
        {
            "scope": [
                "entity.name.tag",
                "entity.other.attribute-name",
                "support.type.property-name",
                "meta.object-literal.key"
            ],
            "settings": { "foreground": "#EABB6F" }
        },
        {
            "scope": ["variable", "meta.definition.variable"],
            "settings": { "foreground": "#EFE6D3" }
        },
        {
            "scope": [
                "variable.other.property",
                "variable.object.property",
                "variable.other.constant"
            ],
            "settings": { "foreground": "#B69B66" }
        },
        {
            "scope": ["variable.parameter", "meta.parameter.object-pattern"],
            "settings": { "foreground": "#F2C873" }
        },
        {
            "scope": [
                "constant.language",
                "constant.other",
                "variable.language"
            ],
            "settings": { "foreground": "#EEB455" }
        },
        {
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#FF6B7A", "fontStyle": "bold" }
        },
        {
            "scope": ["markup.bold", "markup.heading"],
            "settings": { "foreground": "#E8C15F", "fontStyle": "bold" }
        },
        {
            "scope": ["markup.italic"],
            "settings": { "foreground": "#CDB98C", "fontStyle": "italic" }
        },
        {
            "scope": ["markup.inline.raw", "markup.fenced_code.block"],
            "settings": { "foreground": "#8CF0C8" }
        },
        {
            "scope": [
                "punctuation.section.embedded",
                "punctuation.definition.template-expression"
            ],
            "settings": { "foreground": "#C9954D" }
        },
        {
            "scope": ["punctuation.bracket", "punctuation.definition.tag"],
            "settings": { "foreground": "#B6A88B" }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "variable": "#EFE6D3",
        "variable.readonly": "#EEB455",
        "parameter": "#F2C873",
        "property": "#B69B66",
        "property.readonly": "#EABB6F",
        "function": "#93BCFF",
        "method": "#93BCFF",
        "namespace": "#E4D19B",
        "class": "#E4D19B",
        "interface": "#E4D19B",
        "enum": "#E4D19B",
        "typeParameter": "#EABB6F",
        "keyword": "#E8C15F",
        "string": "#9AE7C2",
        "number": "#63DFFF",
        "regexp": "#9AE7C2",
        "operator": "#C9954D",
        "enumMember": "#EEB455",
        "type": "#E4D19B",
        "comment": { "foreground": "#786F86", "fontStyle": "italic" }
    },
    "$schema": "vscode://schemas/color-theme"
}
