{
    "$schema": "vscode://schemas/color-theme",
    "colors": {
        "activityBar.background": "#353535",
        "activityBar.border": "#353535",
        "activityBar.foreground": "#D0D0D0",
        "activityBarBadge.background": "#6C95EB",
        "activityBarBadge.foreground": "#ffffff",
        "badge.background": "#6C95EB",
        "badge.foreground": "#ffffff",
        "button.background": "#6C95EB",
        "button.foreground": "#ffffff",
        "debugToolBar.background": "#353535",
        "dropdown.background": "#3c3c3c",
        "editor.background": "#262626",
        "editor.foreground": "#D0D0D0",
        "editor.lineHighlightBorder": "#FFFFFF1a",
        "editor.rangeHighlightBackground": "#FFFFFF0d",
        "editorError.foreground": "#FF5647",
        "editorGroup.dropBackground": "#6C95EB80",
        "editorGroup.focusedEmptyBorder": "#6C95EB",
        "editorGroupHeader.tabsBackground": "#2d2d2d",
        "editorGroupHeader.tabsBorder": "#2d2d2d",
        "editorHoverWidget.background": "#2d2d2d",
        "editorInlayHint.background": "#2e2e2e",
        "editorInlayHint.foreground": "#787878",
        "editorInlayHint.parameterBackground": "#2e2e2e",
        "editorInlayHint.parameterForeground": "#787878",
        "editorInlayHint.typeBackground": "#2e2e2e",
        "editorInlayHint.typeForeground": "#787878",
        "editorLineNumber.activeForeground": "#6C95EB",
        "editorLineNumber.foreground": "#D0D0D0",
        "editorMarkerNavigation.background": "#2d2d2d",
        "editorWarning.foreground": "#F5D86A",
        "editorWidget.background": "#2d2d2d",
        "focusBorder": "#6C95EB",
        "foreground": "#D0D0D0",
        "input.background": "#3c3c3c",
        "inputOption.activeBorder": "#6C95EB",
        "list.activeSelectionBackground": "#6C95EB80",
        "list.activeSelectionForeground": "#FFFFFF",
        "list.dropBackground": "#6C95EB80",
        "list.focusBackground": "#6C95EB80",
        "list.focusForeground": "#FFFFFF",
        "list.highlightForeground": "#6C95EB",
        "list.hoverBackground": "#FFFFFF1a",
        "list.inactiveSelectionBackground": "#FFFFFF33",
        "panel.background": "#2d2d2d",
        "panel.border": "#FFFFFF1a",
        "panelTitle.activeBorder": "#D0D0D080",
        "panelTitle.inactiveForeground": "#D0D0D080",
        "peekView.border": "#6C95EB",
        "peekViewEditor.background": "#1e1e1e",
        "peekViewResult.background": "#2d2d2d",
        "peekViewTitle.background": "#262626",
        "pickerGroup.border": "#FFFFFF1a",
        "selection.background": "#6C95EB",
        "sideBar.background": "#2d2d2d",
        "sideBar.border": "#2d2d2d",
        "sideBarSectionHeader.background": "#353535",
        "statusBar.background": "#1e1e1e",
        "statusBar.debuggingBackground": "#6C95EB",
        "statusBar.debuggingForeground": "#ffffff",
        "statusBar.foreground": "#D0D0D0",
        "statusBar.noFolderBackground": "#1e1e1e",
        "statusBarItem.activeBackground": "#6C95EB80",
        "statusBarItem.hoverBackground": "#FFFFFF1a",
        "statusBarItem.remoteBackground": "#6C95EB",
        "statusBarItem.remoteForeground": "#ffffff",
        "tab.activeBorder": "#6C95EB",
        "tab.activeModifiedBorder": "#6C95EB",
        "tab.border": "#00000033",
        "tab.inactiveBackground": "#353535",
        "tab.inactiveModifiedBorder": "#40598d",
        "tab.unfocusedActiveModifiedBorder": "#5677bc",
        "tab.unfocusedInactiveModifiedBorder": "#40598d",
        "titleBar.activeBackground": "#1e1e1e"
    },
    "name": "rider-dark",
    "semanticHighlighting": true,
    "tokenColors": [
        { "name": "Global settings", "settings": { "foreground": "#D0D0D0" } },
        {
            "name": "String",
            "scope": "string",
            "settings": { "foreground": "#C9A26D" }
        },
        {
            "name": "Punctuation",
            "scope": "punctuation, constant.other.symbol",
            "settings": { "foreground": "#D0D0D0" }
        },
        {
            "name": "String Escape",
            "scope": "constant.character.escape, text.html constant.character.entity.named",
            "settings": { "foreground": "#FF5647" }
        },
        {
            "name": "Boolean",
            "scope": "constant.language.boolean",
            "settings": { "foreground": "#ED94C0" }
        },
        {
            "name": "Number",
            "scope": "constant.numeric",
            "settings": { "foreground": "#ED94C0" }
        },
        {
            "name": "Variable",
            "scope": "variable, variable.parameter, support.variable, variable.language, support.constant, meta.definition.variable entity.name.function, meta.function-call.arguments",
            "settings": { "foreground": "#D0D0D0" }
        },
        {
            "name": "Other Keyword",
            "scope": "keyword.other",
            "settings": { "foreground": "#6C95EB" }
        },
        {
            "name": "Keyword",
            "scope": "keyword, modifier, variable.language.this, support.type.object, constant.language",
            "settings": { "foreground": "#6C95EB" }
        },
        {
            "scope": [
                "keyword.operator.new",
                "keyword.operator.expression",
                "keyword.operator.cast",
                "keyword.operator.sizeof",
                "keyword.operator.typeid",
                "keyword.operator.alignas",
                "keyword.operator.instanceof",
                "keyword.operator.logical.python",
                "keyword.operator.wordlike"
            ],
            "settings": { "foreground": "#6C95EB" }
        },
        {
            "name": "Function call",
            "scope": "entity.name.function, support.function",
            "settings": { "foreground": "#39CC8F" }
        },
        {
            "name": "Storage",
            "scope": "storage.type, storage.modifier, storage.control",
            "settings": { "foreground": "#6C95EB" }
        },
        {
            "name": "Modules",
            "scope": "support.module, support.node",
            "settings": { "fontStyle": "italic", "foreground": "#D0D0D0" }
        },
        {
            "name": "Type",
            "scope": "support.type, constant.other.key",
            "settings": { "foreground": "#39CC8F" }
        },
        {
            "name": "Type",
            "scope": "entity.name.type, entity.other.inherited-class, entity.other",
            "settings": { "foreground": "#39CC8F" }
        },
        {
            "name": "Comment",
            "scope": "comment",
            "settings": { "fontStyle": "italic", "foreground": "#85C46C" }
        },
        {
            "name": "Comment",
            "scope": "comment punctuation.definition.comment, string.quoted.docstring",
            "settings": { "fontStyle": "italic", "foreground": "#85C46C" }
        },
        {
            "name": "Punctuation",
            "scope": "punctuation",
            "settings": { "foreground": "#D0D0D0" }
        },
        {
            "name": "Class",
            "scope": "entity.name, entity.name.type.class, support.type, support.class, meta.use",
            "settings": { "foreground": "#C191FF" }
        },
        {
            "name": "Class variable",
            "scope": "variable.object.property, meta.field.declaration entity.name.function",
            "settings": { "foreground": "#39CC8F" }
        },
        {
            "name": "Class method",
            "scope": "meta.definition.method entity.name.function",
            "settings": { "foreground": "#39CC8F" }
        },
        {
            "name": "Function definition",
            "scope": "meta.function entity.name.function",
            "settings": { "foreground": "#39CC8F" }
        },
        {
            "name": "Template expression",
            "scope": "template.expression.begin, template.expression.end, punctuation.definition.template-expression.begin, punctuation.definition.template-expression.end",
            "settings": { "foreground": "#6C95EB" }
        },
        {
            "name": "Reset embedded/template expression colors",
            "scope": "meta.embedded, source.groovy.embedded, meta.template.expression",
            "settings": { "foreground": "#D0D0D0" }
        },
        {
            "name": "YAML key",
            "scope": "entity.name.tag.yaml",
            "settings": { "foreground": "#D0D0D0" }
        },
        {
            "name": "JSON key",
            "scope": "meta.object-literal.key, meta.object-literal.key string, support.type.property-name.json",
            "settings": { "foreground": "#D0D0D0" }
        },
        {
            "name": "JSON constant",
            "scope": "constant.language.json",
            "settings": { "foreground": "#6C95EB" }
        },
        {
            "name": "CSS class",
            "scope": "entity.other.attribute-name.class",
            "settings": { "foreground": "#6C95EB" }
        },
        {
            "name": "CSS ID",
            "scope": "entity.other.attribute-name.id",
            "settings": { "foreground": "#C9A26D" }
        },
        {
            "name": "CSS tag",
            "scope": "source.css entity.name.tag",
            "settings": { "foreground": "#39CC8F" }
        },
        {
            "name": "CSS properties",
            "scope": "support.type.property-name.css",
            "settings": { "foreground": "#39CC8F" }
        },
        {
            "name": "HTML tag outer",
            "scope": "meta.tag, punctuation.definition.tag",
            "settings": { "foreground": "#6C95EB" }
        },
        {
            "name": "HTML tag inner",
            "scope": "entity.name.tag",
            "settings": { "foreground": "#D0D0D0" }
        },
        {
            "name": "HTML tag attribute",
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#6C95EB" }
        },
        {
            "name": "HTML entities",
            "scope": "punctuation.definition.entity.html",
            "settings": { "foreground": "#FF5647" }
        },
        {
            "name": "Markdown heading",
            "scope": "markup.heading",
            "settings": { "foreground": "#6C95EB" }
        },
        {
            "name": "Markdown link text",
            "scope": "text.html.markdown meta.link.inline, meta.link.reference",
            "settings": { "foreground": "#D0D0D0" }
        },
        {
            "name": "Markdown list item",
            "scope": "text.html.markdown beginning.punctuation.definition.list",
            "settings": { "foreground": "#6C95EB" }
        },
        {
            "name": "Markdown italic",
            "scope": "markup.italic",
            "settings": { "fontStyle": "italic", "foreground": "#D0D0D0" }
        },
        {
            "name": "Markdown bold",
            "scope": "markup.bold",
            "settings": { "fontStyle": "bold", "foreground": "#D0D0D0" }
        },
        {
            "name": "Markdown bold italic",
            "scope": "markup.bold markup.italic, markup.italic markup.bold",
            "settings": { "fontStyle": "italic bold", "foreground": "#D0D0D0" }
        },
        {
            "name": "Markdown code block",
            "scope": "markup.fenced_code.block.markdown punctuation.definition.markdown",
            "settings": { "foreground": "#C9A26D" }
        },
        {
            "name": "Markdown inline code",
            "scope": "markup.inline.raw.string.markdown",
            "settings": { "foreground": "#C9A26D" }
        },
        {
            "name": "INI property name",
            "scope": "keyword.other.definition.ini",
            "settings": { "foreground": "#D0D0D0" }
        },
        {
            "name": "INI section title",
            "scope": "entity.name.section.group-title.ini",
            "settings": { "foreground": "#6C95EB" }
        },
        {
            "name": "C# class",
            "scope": "source.cs meta.class.identifier storage.type",
            "settings": { "foreground": "#C191FF" }
        },
        {
            "name": "C# class method",
            "scope": "source.cs meta.method.identifier entity.name.function",
            "settings": { "foreground": "#39CC8F" }
        },
        {
            "name": "C# function call",
            "scope": "source.cs meta.method-call meta.method, source.cs entity.name.function",
            "settings": { "foreground": "#39CC8F" }
        },
        {
            "name": "C# type",
            "scope": "source.cs storage.type",
            "settings": { "foreground": "#39CC8F" }
        },
        {
            "name": "C# return type",
            "scope": "source.cs meta.method.return-type",
            "settings": { "foreground": "#39CC8F" }
        },
        {
            "name": "C# preprocessor",
            "scope": "source.cs meta.preprocessor",
            "settings": { "foreground": "#85C46C" }
        },
        {
            "name": "C# namespace",
            "scope": "source.cs entity.name.type.namespace",
            "settings": { "foreground": "#D0D0D0" }
        },
        {
            "name": "JSX Text",
            "scope": "meta.jsx.children, SXNested",
            "settings": { "foreground": "#D0D0D0" }
        },
        {
            "name": "JSX Components name",
            "scope": "support.class.component",
            "settings": { "foreground": "#39CC8F" }
        },
        {
            "name": "C-related Block Level Variables",
            "scope": "source.cpp meta.block variable.other",
            "settings": { "foreground": "#D0D0D0" }
        },
        {
            "name": "Member Access Meta",
            "scope": "source.python meta.member.access.python",
            "settings": { "foreground": "#D0D0D0" }
        },
        {
            "name": "Function Call",
            "scope": "source.python meta.function-call.python, meta.function-call.arguments",
            "settings": { "foreground": "#39CC8F" }
        },
        {
            "name": "Blocks",
            "scope": "meta.block",
            "settings": { "foreground": "#D0D0D0" }
        },
        {
            "name": "Function Call",
            "scope": "entity.name.function.call",
            "settings": { "foreground": "#39CC8F" }
        },
        {
            "name": "Namespaces",
            "scope": "source.php support.other.namespace, source.php meta.use support.class",
            "settings": { "foreground": "#D0D0D0" }
        },
        {
            "name": "Constant keywords",
            "scope": "constant.keyword",
            "settings": { "fontStyle": "italic", "foreground": "#6C95EB" }
        },
        {
            "name": "Entity name",
            "scope": "entity.name.function",
            "settings": { "foreground": "#39CC8F" }
        },
        { "name": "Global settings", "settings": { "foreground": "#D0D0D0" } },
        {
            "name": "string quotes",
            "scope": "punctuation.definition.string",
            "settings": { "foreground": "#C9A26D" }
        },
        {
            "name": "JSX, HTML Tags",
            "scope": [
                "meta.tag",
                "entity.name.tag",
                "support.class.component",
                "punctuation.definition.tag.begin",
                "punctuation.definition.tag.end",
                "entity.name.type"
            ],
            "settings": { "foreground": "#C191FF" }
        },
        {
            "name": "JSX, HTML attribute names",
            "scope": [
                "entity.other.attribute-name.tsx",
                "meta.tag.attributes.tsx"
            ],
            "settings": { "foreground": "#85C46C" }
        },
        {
            "name": "C# namespaces",
            "scope": [
                "entity.name.type.namespace.cs",
                "entity.name.type.interface"
            ],
            "settings": { "foreground": "#C191FF" }
        },
        {
            "name": "Properties and fields",
            "scope": [
                "variable.other.property",
                "entity.name.variable.field",
                "meta.object-literal.key"
            ],
            "settings": { "foreground": "#66C3CC" }
        },
        {
            "name": "Constants",
            "scope": ["variable.other.constant"],
            "settings": { "fontStyle": "bold", "foreground": "#66C3CC" }
        },
        {
            "name": "Variables",
            "scope": [
                "entity.name.variable",
                "entity.other.attribute-name",
                "keyword.operator"
            ],
            "settings": { "foreground": "#D0D0D0" }
        },
        {
            "name": "C# doc comment tags and attribute names",
            "scope": [
                "comment.documentation.name",
                "comment.documentation.attribute.name"
            ],
            "settings": { "foreground": "#487D34" }
        },
        {
            "name": "C# doc comment tags and attribute names",
            "scope": ["comment.documentation.attribute.value"],
            "settings": { "foreground": "#C9A26D" }
        }
    ]
}
