    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#6e7681", "fontStyle": "italic" }
        },
        {
            "name": "Strings",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#4ade80" }
        },
        {
            "name": "String Escape Characters",
            "scope": [
                "constant.character.escape",
                "constant.other.placeholder"
            ],
            "settings": { "foreground": "#86efac" }
        },
        {
            "name": "Numbers",
            "scope": ["constant.numeric", "constant.language.numeric"],
            "settings": { "foreground": "#60a5fa" }
        },
        {
            "name": "Constants",
            "scope": [
                "constant.language",
                "constant.other",
                "variable.language.this",
                "variable.language.super",
                "variable.other.constant"
            ],
            "settings": { "foreground": "#4ade80" }
        },
        {
            "name": "Keywords",
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#c9d1d9", "fontStyle": "" }
        },
        {
            "name": "Keywords Control",
            "scope": [
                "keyword.control",
                "keyword.operator.new",
                "keyword.operator.expression",
                "keyword.operator.logical"
            ],
            "settings": { "foreground": "#b4bac5", "fontStyle": "" }
        },
        {
            "name": "Operators",
            "scope": [
                "keyword.operator",
                "keyword.operator.arithmetic",
                "keyword.operator.assignment",
                "keyword.operator.comparison"
            ],
            "settings": { "foreground": "#9ca3af" }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call"
            ],
            "settings": { "foreground": "#e6edf3", "fontStyle": "" }
        },
        {
            "name": "Classes",
            "scope": [
                "entity.name.class",
                "entity.name.type.class",
                "support.class",
                "entity.other.inherited-class"
            ],
            "settings": { "foreground": "#f0f6fc", "fontStyle": "" }
        },
        {
            "name": "Types",
            "scope": [
                "entity.name.type",
                "support.type",
                "entity.name.type.interface"
            ],
            "settings": { "foreground": "#e6edf3" }
        },
        {
            "name": "Variables",
            "scope": [
                "variable",
                "meta.definition.variable",
                "entity.name.variable"
            ],
            "settings": { "foreground": "#c9d1d9" }
        },
        {
            "name": "Parameters",
            "scope": ["variable.parameter", "meta.parameters"],
            "settings": { "foreground": "#b4bac5" }
        },
        {
            "name": "Properties",
            "scope": [
                "variable.other.property",
                "variable.other.object.property",
                "support.variable.property"
            ],
            "settings": { "foreground": "#c9d1d9" }
        },
        {
            "name": "Tags (HTML/XML)",
            "scope": ["entity.name.tag", "meta.tag"],
            "settings": { "foreground": "#e6edf3" }
        },
        {
            "name": "Tag Attributes",
            "scope": ["entity.other.attribute-name", "meta.attribute"],
            "settings": { "foreground": "#9ca3af" }
        },
        {
            "name": "Decorators",
            "scope": ["meta.decorator", "punctuation.decorator"],
            "settings": { "foreground": "#fbbf24" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation",
                "meta.brace",
                "punctuation.definition.block",
                "punctuation.section"
            ],
            "settings": { "foreground": "#7d8590" }
        },
        {
            "name": "Separators",
            "scope": ["punctuation.separator", "punctuation.terminator"],
            "settings": { "foreground": "#6e7681" }
        },
        {
            "name": "JSON Keys",
            "scope": [
                "support.type.property-name.json",
                "meta.object-literal.key"
            ],
            "settings": { "foreground": "#c9d1d9" }
        },
        {
            "name": "CSS Selectors",
            "scope": [
                "entity.name.tag.css",
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css"
            ],
            "settings": { "foreground": "#e6edf3" }
        },
        {
            "name": "CSS Properties",
            "scope": ["support.type.property-name.css"],
            "settings": { "foreground": "#c9d1d9" }
        },
        {
            "name": "Python Self",
            "scope": ["variable.language.special.self.python"],
            "settings": { "foreground": "#4ade80", "fontStyle": "italic" }
        },
        {
            "name": "Python Function Decorators",
            "scope": ["entity.name.function.decorator.python"],
            "settings": { "foreground": "#fbbf24" }
        },
        {
            "name": "Python Magic Functions",
            "scope": ["support.function.magic.python"],
            "settings": { "foreground": "#c084fc", "fontStyle": "italic" }
        },
        {
            "name": "TypeScript/JavaScript Import/Export",
            "scope": [
                "keyword.control.import",
                "keyword.control.export",
                "keyword.control.from"
            ],
            "settings": { "foreground": "#b4bac5" }
        },
        {
            "name": "TypeScript Types",
            "scope": ["entity.name.type.ts", "entity.name.type.tsx"],
            "settings": { "foreground": "#e6edf3" }
        },
        {
            "name": "React JSX Component",
            "scope": [
                "support.class.component.tsx",
                "support.class.component.jsx"
            ],
            "settings": { "foreground": "#f0f6fc" }
        },
        {
            "name": "Invalid/Deprecated",
            "scope": ["invalid", "invalid.illegal", "invalid.deprecated"],
            "settings": { "foreground": "#f87171", "fontStyle": "underline" }
        },
        {
            "name": "Markdown Headings",
            "scope": ["markup.heading", "entity.name.section.markdown"],
            "settings": { "foreground": "#e6edf3", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Bold",
            "scope": ["markup.bold"],
            "settings": { "foreground": "#e6edf3", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Italic",
            "scope": ["markup.italic"],
            "settings": { "foreground": "#e6edf3", "fontStyle": "italic" }
        },
        {
            "name": "Markdown Links",
            "scope": [
                "markup.underline.link",
                "string.other.link.title.markdown"
            ],
            "settings": { "foreground": "#4ade80" }
        },
        {
            "name": "Markdown Code",
            "scope": ["markup.inline.raw", "markup.fenced_code.block.markdown"],
            "settings": { "foreground": "#60a5fa" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
