    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#6e7681", "fontStyle": "italic" }
        },
        {
            "name": "Strings",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#00ff88" }
        },
        {
            "name": "String Escape Characters",
            "scope": [
                "constant.character.escape",
                "constant.other.placeholder"
            ],
            "settings": { "foreground": "#ffaa00" }
        },
        {
            "name": "Numbers",
            "scope": ["constant.numeric", "constant.language.numeric"],
            "settings": { "foreground": "#00a8ff" }
        },
        {
            "name": "Constants",
            "scope": [
                "constant.language",
                "constant.other",
                "variable.language.this",
                "variable.language.super",
                "variable.other.constant"
            ],
            "settings": { "foreground": "#00d4ff" }
        },
        {
            "name": "Keywords",
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#ffdd00", "fontStyle": "" }
        },
        {
            "name": "Keywords Control",
            "scope": [
                "keyword.control",
                "keyword.operator.new",
                "keyword.operator.expression",
                "keyword.operator.logical"
            ],
            "settings": { "foreground": "#ff9900", "fontStyle": "" }
        },
        {
            "name": "Operators",
            "scope": [
                "keyword.operator",
                "keyword.operator.arithmetic",
                "keyword.operator.assignment",
                "keyword.operator.comparison"
            ],
            "settings": { "foreground": "#9ca3af" }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call"
            ],
            "settings": { "foreground": "#00d4ff", "fontStyle": "" }
        },
        {
            "name": "Classes",
            "scope": [
                "entity.name.class",
                "entity.name.type.class",
                "support.class",
                "entity.other.inherited-class"
            ],
            "settings": { "foreground": "#ffffff", "fontStyle": "bold" }
        },
        {
            "name": "Types",
            "scope": [
                "entity.name.type",
                "support.type",
                "entity.name.type.interface"
            ],
            "settings": { "foreground": "#e6edf3" }
        },
        {
            "name": "Variables",
            "scope": [
                "variable",
                "meta.definition.variable",
                "entity.name.variable"
            ],
            "settings": { "foreground": "#e0e0e0" }
        },
        {
            "name": "Parameters",
            "scope": ["variable.parameter", "meta.parameters"],
            "settings": { "foreground": "#b4bac5" }
        },
        {
            "name": "Properties",
            "scope": [
                "variable.other.property",
                "variable.other.object.property",
                "support.variable.property"
            ],
            "settings": { "foreground": "#d0d0d0" }
        },
        {
            "name": "Tags (HTML/XML)",
            "scope": ["entity.name.tag", "meta.tag"],
            "settings": { "foreground": "#ffffff" }
        },
        {
            "name": "Tag Attributes",
            "scope": ["entity.other.attribute-name", "meta.attribute"],
            "settings": { "foreground": "#cc66ff" }
        },
        {
            "name": "Decorators",
            "scope": ["meta.decorator", "punctuation.decorator"],
            "settings": { "foreground": "#ffaa00" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation",
                "meta.brace",
                "punctuation.definition.block",
                "punctuation.section"
            ],
            "settings": { "foreground": "#909090" }
        },
        {
            "name": "Separators",
            "scope": ["punctuation.separator", "punctuation.terminator"],
            "settings": { "foreground": "#6e7681" }
        },
        {
            "name": "JSON Keys",
            "scope": [
                "support.type.property-name.json",
                "meta.object-literal.key"
            ],
            "settings": { "foreground": "#66ccff" }
        },
        {
            "name": "CSS Selectors",
            "scope": [
                "entity.name.tag.css",
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css"
            ],
            "settings": { "foreground": "#ffffff" }
        },
        {
            "name": "CSS Properties",
            "scope": ["support.type.property-name.css"],
            "settings": { "foreground": "#66ccff" }
        },
        {
            "name": "Python Self",
            "scope": ["variable.language.special.self.python"],
            "settings": { "foreground": "#00d4ff", "fontStyle": "italic" }
        },
        {
            "name": "Python Function Decorators",
            "scope": ["entity.name.function.decorator.python"],
            "settings": { "foreground": "#fbbf24" }
        },
        {
            "name": "Python Magic Functions",
            "scope": ["support.function.magic.python"],
            "settings": { "foreground": "#cc66ff", "fontStyle": "italic" }
        },
        {
            "name": "TypeScript/JavaScript Import/Export",
            "scope": [
                "keyword.control.import",
                "keyword.control.export",
                "keyword.control.from"
            ],
            "settings": { "foreground": "#b4bac5" }
        },
        {
            "name": "TypeScript Types",
            "scope": ["entity.name.type.ts", "entity.name.type.tsx"],
            "settings": { "foreground": "#e6edf3" }
        },
        {
            "name": "React JSX Component",
            "scope": [
                "support.class.component.tsx",
                "support.class.component.jsx"
            ],
            "settings": { "foreground": "#ffffff", "fontStyle": "bold" }
        },
        {
            "name": "Invalid/Deprecated",
            "scope": ["invalid", "invalid.illegal", "invalid.deprecated"],
            "settings": { "foreground": "#ff4444", "fontStyle": "underline" }
        },
        {
            "name": "Markdown Headings",
            "scope": ["markup.heading", "entity.name.section.markdown"],
            "settings": { "foreground": "#ffffff", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Bold",
            "scope": ["markup.bold"],
            "settings": { "foreground": "#ffffff", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Italic",
            "scope": ["markup.italic"],
            "settings": { "foreground": "#d0d0d0", "fontStyle": "italic" }
        },
        {
            "name": "Markdown Links",
            "scope": [
                "markup.underline.link",
                "string.other.link.title.markdown"
            ],
            "settings": { "foreground": "#00d4ff" }
        },
        {
            "name": "Markdown Code",
            "scope": ["markup.inline.raw", "markup.fenced_code.block.markdown"],
            "settings": { "foreground": "#00a8ff" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
