{
    "name": "RubyMine Dark",
    "$schema": "vscode://schemas/color-theme",
    "type": "dark",
    "colors": {
        "activityBarBadge.background": "#007acc",
        "editor.background": "#1e1f22",
        "editor.foreground": "#b5b5b5",
        "editor.inactiveSelectionBackground": "#3a3d41",
        "editor.selectionBackground": "#00a2ff7b",
        "editor.selectionHighlightBackground": "#4a6166",
        "editorIndentGuide.activeBackground": "#707070",
        "editorIndentGuide.background": "#404040",
        "input.placeholderForeground": "#3e3e3e",
        "list.activeSelectionIconForeground": "#ffffff",
        "list.dropBackground": "#383b3d",
        "menu.background": "#1e1f22",
        "menu.foreground": "#979797",
        "ports.iconRunningProcessForeground": "#369432",
        "sideBarSectionHeader.background": "#00000000",
        "sideBarSectionHeader.border": "#00000033",
        "sideBarTitle.foreground": "#bbbbbb",
        "statusBarItem.remoteBackground": "#16825d",
        "statusBarItem.remoteForeground": "#979797",
        "tab.lastPinnedBorder": "#cccccc33",
        "activityBar.background": "#282a2c",
        "activityBar.foreground": "#979797",
        "dropdown.background": "#282a2c",
        "editorGroupHeader.tabsBackground": "#282a2c",
        "editorLineNumber.foreground": "#4d4d4d",
        "editorSuggestWidget.background": "#2b2d30",
        "editorWidget.background": "#282a2c",
        "editorWidget.border": "#000000",
        "foreground": "#979797",
        "gitDecoration.ignoredResourceForeground": "#595959",
        "gitDecoration.modifiedResourceForeground": "#fcc97c",
        "input.background": "#1e1f22",
        "listFilterWidget.shadow": "#00000000",
        "menu.selectionForeground": "#ffffff",
        "menu.separatorBackground": "#000000",
        "notifications.background": "#2b2d30",
        "quickInput.background": "#282a2c",
        "scrollbar.shadow": "#000000",
        "settings.checkboxBackground": "#282a2c",
        "sideBar.background": "#282a2c",
        "sideBar.dropBackground": "#53595d80",
        "statusBar.background": "#282a2c",
        "statusBar.debuggingBackground": "#cc6633",
        "statusBar.debuggingForeground": "#ffffff",
        "statusBar.foreground": "#979797",
        "tab.inactiveBackground": "#323537",
        "titleBar.activeBackground": "#282a2c",
        "widget.shadow": "#00000000",
        "editor.lineHighlightBackground": "#282a2c",
        "menu.border": "#000000",
        "tab.activeBorder": "#1f8ad2",
        "terminal.background": "#282a2c",
        "widget.border": "#000000"
    },
    "tokenColors": [
        {
            "scope": [
                "punctuation",
                "punctuation.section.embedded",
                "meta.function-call",
                "punctuation.definition.constant.hashkey",
                "keyword.operator.assignment.ruby",
                "entity.name.function.call.cpp",
                "entity.name.function.member.cpp",
                "variable.other.property",
                "meta.brace.round.ts",
                "meta.brace.square.ts",
                "keyword.operator.type.ts",
                "keyword.operator.type.annotation.ts",
                "meta.function-call.ts",
                "keyword.operator.assignment.ts",
                "keyword.operator.relational.ts",
                "keyword.operator.increment.ts",
                "keyword.operator.bitwise.shift.ts",
                "keyword.operator.bitwise.ts",
                "punctuation.separator.key-value.ts",
                "keyword.operator.assignment.js",
                "keyword.operator.relational.js",
                "keyword.operator.increment.js",
                "keyword.operator.bitwise.shift.js",
                "keyword.operator.bitwise.js",
                "variable.other.object.property.js",
                "support.variable.property.js",
                "meta.brace.round.js",
                "meta.brace.square.js",
                "keyword.generator.asterisk.js",
                "keyword.operator.combinator.css",
                "meta.property-name.css",
                "punctuation.definition.constant.css",
                "punctuation.separator.key-value.mapping.yaml",
                "string.unquoted.plain.out.yaml",
                "source.sql",
                "constant.other.table-name.sql",
                "meta.function.call.rust"
            ],
            "settings": { "foreground": "#f1e5cc" }
        },
        {
            "scope": ["punctuation.definition.comment", "comment"],
            "settings": { "foreground": "#8d8d8d", "fontStyle": "italic" }
        },
        {
            "scope": [
                "comment.line.keyword.yard",
                "comment.line.keyword.punctuation.yard",
                "comment.line.punctuation.yard"
            ],
            "settings": { "foreground": "#F1CB9F", "fontStyle": "italic bold" }
        },
        {
            "scope": [
                "support.function.kernel.ruby",
                "keyword.other",
                "keyword.operator",
                "keyword.control",
                "keyword.other.special-method",
                "punctuation.separator.key-value",
                "variable.language",
                "storage.type.variable",
                "storage.modifier",
                "storage.type.built-in.primitive.cpp",
                "storage.type.primitive.cpp",
                "punctuation.separator.pointer-access.cpp",
                "punctuation.definition.heading.markdown",
                "punctuation.definition.constant.markdown",
                "punctuation.definition.string.begin.markdown",
                "punctuation.definition.string.end.markdown",
                "punctuation.definition.list.begin.markdown",
                "storage.type.function.arrow.ts",
                "storage.type.function.ts",
                "storage.type.interface.ts",
                "storage.type.enum.ts",
                "support.constant.media.css",
                "support.constant.property-value.css",
                "support.constant.font-name.css",
                "entity.name.type.primitive.rust",
                "entity.name.type.numeric.rust"
            ],
            "settings": { "foreground": "#ff7161be" }
        },
        {
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#ff8c00" }
        },
        {
            "scope": [
                "constant.other.symbol.hashkey.parameter.function",
                "variable.other",
                "comment.line.parameter.yard",
                "markup.inline.raw.string.markdown",
                "markup.fenced_code.block.markdown",
                "entity.other.attribute-name.html",
                "constant.other.color.rgb-value.hex.css",
                "support.constant.color.w3c-standard-color-name.css",
                "constant.other.database-name.sql"
            ],
            "settings": { "foreground": "#ffcd44ce", "fontStyle": "italic" }
        },
        {
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#fdf58cce", "fontStyle": "" }
        },
        {
            "scope": ["variable.other.readwrite"],
            "settings": { "foreground": "#babbfbdd", "fontStyle": "" }
        },
        {
            "scope": [
                "punctuation.definition.string.begin",
                "punctuation.definition.string.end",
                "string"
            ],
            "settings": { "foreground": "#76af7f" }
        },
        { "scope": "meta.embedded.line", "settings": { "fontStyle": "" } },
        {
            "scope": ["string.regexp", "punctuation.section.regexp"],
            "settings": { "foreground": "#A6CC5F", "fontStyle": "" }
        },
        {
            "scope": [
                "constant.numeric",
                "keyword.other.unit.em.css",
                "keyword.other.unit.percentage.css",
                "keyword.other.unit.rem.css",
                "keyword.other.unit.px.css"
            ],
            "settings": { "foreground": "#ffffff" }
        },
        {
            "scope": [
                "meta.class",
                "entity.name.type.class.ruby",
                "entity.other.inherited-class.ruby",
                "entity.name.type.module",
                "meta.module.ruby",
                "comment.line.type.yard",
                "entity.name.scope-resolution.cpp",
                "entity.name.scope-resolution.template.call.cpp",
                "entity.name.scope-resolution.parameter.cpp",
                "entity.name.scope-resolution.function.call.cpp",
                "markup.heading",
                "constant.other.reference.link.markdown",
                "string.other.link.title.markdown",
                "meta.selector.css",
                "entity.name.namespace.rust",
                "entity.name.type.enum.ts",
                "variable.other.readwrite.alias.ts"
            ],
            "settings": { "foreground": "#4ba7e9", "fontStyle": "bold" }
        },
        {
            "scope": ["entity.other.inherited-class.ruby"],
            "settings": { "foreground": "#55be00d4", "fontStyle": "bold" }
        },
        {
            "scope": ["support.class.ruby"],
            "settings": {
                "foreground": "#ff83aec2",
                "fontStyle": "bold italic"
            }
        },
        {
            "scope": ["variable.other.constant"],
            "settings": { "foreground": "#cfc397", "fontStyle": "" }
        },
        {
            "scope": [
                "constant.other.symbol.ruby",
                "constant.language.symbol",
                "constant.other.symbol.hashkey.ruby",
                "markup.underline.link.markdown",
                "meta.link.inline.markdown",
                "support.type.property-name.json",
                "meta.object-literal.key.ts",
                "meta.object-literal.key.js",
                "entity.name.tag.html",
                "punctuation.separator.key-value.css",
                "punctuation.terminator.rule.css",
                "entity.name.tag.yaml"
            ],
            "settings": { "foreground": "#7db2cf", "fontStyle": "" }
        },
        {
            "scope": [
                "variable.other.readwrite.class",
                "variable.other.readwrite.instance",
                "punctuation.definition.variable",
                "variable.other.readwrite.global",
                "variable.other.property"
            ],
            "settings": { "foreground": "#ff9cae", "fontStyle": "" }
        },
        {
            "scope": ["constant.language", "variable.language.this"],
            "settings": { "foreground": "#86cff8", "fontStyle": "italic bold" }
        },
        {
            "scope": [
                "variable",
                "markup.bold",
                "punctuation.definition.bold.markdown",
                "variable.object.property.ts",
                "variable.other.constant.object.ts",
                "variable.other.constant.js",
                "variable.other.constant.object.js"
            ],
            "settings": { "foreground": "#18b4e4e0", "fontStyle": "" }
        },
        {
            "scope": [
                "storage.type.ts",
                "support.type.primitive.ts",
                "storage.type.class.ts",
                "storage.type.class.js",
                "storage.type.function.js",
                "storage.type.js",
                "storage.type.function.arrow.js",
                "constant.language.null.js"
            ],
            "settings": { "foreground": "#f7654e" }
        },
        {
            "scope": [
                "meta.definition.method",
                "meta.function.method.with-arguments.ruby",
                "meta.function.method.without-arguments.ruby"
            ],
            "settings": { "foreground": "#eb9a64", "fontStyle": "" }
        },
        {
            "scope": ["meta.function-call"],
            "settings": { "foreground": "#dfceb3" }
        },
        {
            "scope": "meta.attribute.rust",
            "settings": { "foreground": "#CE74F8", "fontStyle": "italic" }
        },
        {
            "scope": [
                "meta.diff",
                "meta.diff.header",
                "punctuation.definition.to-file.diff",
                "punctuation.definition.from-file.diff",
                "punctuation.definition.range.diff"
            ],
            "settings": { "foreground": "#18B5E4", "fontStyle": "italic" }
        },
        {
            "scope": ["markup.deleted", "punctuation.definition.deleted.diff"],
            "settings": { "foreground": "#DD5555", "fontStyle": "" }
        },
        {
            "scope": "markup.changed",
            "settings": { "foreground": "#d58941", "fontStyle": "" }
        },
        {
            "scope": [
                "markup.inserted",
                "punctuation.definition.inserted.diff"
            ],
            "settings": { "foreground": "#5AC16C" }
        },
        {
            "scope": "token.info-token",
            "settings": { "foreground": "#6796E6" }
        },
        {
            "scope": "token.warn-token",
            "settings": { "foreground": "#CD9731" }
        },
        {
            "scope": "token.error-token",
            "settings": { "foreground": "#F44747" }
        },
        {
            "scope": "token.debug-token",
            "settings": { "foreground": "#B267E6" }
        }
    ]
}
