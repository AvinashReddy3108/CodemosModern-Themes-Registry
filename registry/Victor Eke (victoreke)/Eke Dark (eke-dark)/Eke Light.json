    "tokenColors": [
        {
            "name": "Comment",
            "scope": [
                "comment",
                "comment.block",
                "comment.line",
                "punctuation.definition.comment"
            ],
            "settings": { "foreground": "#9a9ea6" }
        },
        {
            "name": "Doc Comment",
            "scope": ["comment.block.documentation"],
            "settings": { "foreground": "#2e8a35" }
        },
        {
            "name": "Doc Comment Tag",
            "scope": [
                "storage.type.class.jsdoc",
                "entity.name.type.instance.jsdoc"
            ],
            "settings": { "foreground": "#2b9a3e" }
        },
        {
            "name": "String",
            "scope": [
                "string",
                "string.quoted",
                "string.template",
                "punctuation.definition.string"
            ],
            "settings": { "foreground": "#2b9a3e" }
        },
        {
            "name": "String Interpolation",
            "scope": [
                "punctuation.definition.template-expression.begin",
                "punctuation.definition.template-expression.end",
                "punctuation.section.embedded"
            ],
            "settings": { "foreground": "#a33d1e" }
        },
        {
            "name": "String Escape",
            "scope": [
                "constant.character.escape",
                "constant.other.placeholder"
            ],
            "settings": { "foreground": "#a33d1e" }
        },
        {
            "name": "Number",
            "scope": ["constant.numeric", "constant.language.numeric"],
            "settings": { "foreground": "#0891b2" }
        },
        {
            "name": "Boolean",
            "scope": ["constant.language.boolean"],
            "settings": { "foreground": "#a33d1e" }
        },
        {
            "name": "Null",
            "scope": ["constant.language.null", "constant.language.undefined"],
            "settings": { "foreground": "#a33d1e" }
        },
        {
            "name": "Keyword",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.new",
                "keyword.operator.expression",
                "keyword.operator.typeof",
                "keyword.operator.instanceof",
                "keyword.operator.delete",
                "keyword.operator.void",
                "keyword.other"
            ],
            "settings": { "foreground": "#a33d1e" }
        },
        {
            "name": "Operator",
            "scope": [
                "keyword.operator",
                "keyword.operator.arithmetic",
                "keyword.operator.assignment",
                "keyword.operator.comparison",
                "keyword.operator.logical"
            ],
            "settings": { "foreground": "#383c42" }
        },
        {
            "name": "Storage Type",
            "scope": ["storage.type", "storage.modifier"],
            "settings": { "foreground": "#a33d1e" }
        },
        {
            "name": "Function",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call entity.name.function"
            ],
            "settings": { "foreground": "#1b6bab" }
        },
        {
            "name": "Method",
            "scope": ["entity.name.function.member"],
            "settings": { "foreground": "#1c6dae" }
        },
        {
            "name": "Static Method",
            "scope": ["entity.name.function.member.static"],
            "settings": { "foreground": "#1c6dae" }
        },
        {
            "name": "Class",
            "scope": [
                "entity.name.type.class",
                "entity.name.class",
                "support.class"
            ],
            "settings": { "foreground": "#0b6e5f" }
        },
        {
            "name": "Type",
            "scope": ["entity.name.type", "support.type"],
            "settings": { "foreground": "#0b6e5f" }
        },
        {
            "name": "Type Parameter",
            "scope": ["entity.name.type.parameter"],
            "settings": { "foreground": "#096b5e" }
        },
        {
            "name": "Interface",
            "scope": ["entity.name.type.interface"],
            "settings": { "foreground": "#096b5e" }
        },
        {
            "name": "Variable",
            "scope": [
                "variable",
                "variable.other.readwrite",
                "variable.other.object"
            ],
            "settings": { "foreground": "#0b6e5f" }
        },
        {
            "name": "Constant Variable",
            "scope": ["variable.other.constant", "constant.other"],
            "settings": { "foreground": "#8b3685" }
        },
        {
            "name": "Property",
            "scope": ["variable.other.property", "support.variable.property"],
            "settings": { "foreground": "#8b3685" }
        },
        {
            "name": "Object Literal Key",
            "scope": ["meta.object-literal.key"],
            "settings": { "foreground": "#8b3685" }
        },
        {
            "name": "Static Property",
            "scope": ["variable.other.property.static"],
            "settings": { "foreground": "#8b3685" }
        },
        {
            "name": "Parameter",
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#0b6e5f" }
        },
        {
            "name": "Language Variable",
            "scope": ["variable.language.this", "variable.language.super"],
            "settings": { "foreground": "#a33d1e" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation.separator",
                "punctuation.terminator",
                "punctuation.accessor"
            ],
            "settings": { "foreground": "#383c42" }
        },
        {
            "name": "Brackets",
            "scope": ["punctuation.section", "meta.brace"],
            "settings": { "foreground": "#383c42" }
        },
        {
            "name": "Tag",
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#1b6bab" }
        },
        {
            "name": "Tag Brackets",
            "scope": ["punctuation.definition.tag"],
            "settings": { "foreground": "#6b6f77" }
        },
        {
            "name": "Tag Attribute",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#8b3685" }
        },
        {
            "name": "Namespace / Module",
            "scope": [
                "entity.name.namespace",
                "entity.name.module",
                "entity.name.type.module"
            ],
            "settings": { "foreground": "#0b6e5f" }
        },
        {
            "name": "Support Constant",
            "scope": ["support.constant", "variable.other.enummember"],
            "settings": { "foreground": "#8b3685" }
        },
        {
            "name": "Decorator/Annotation",
            "scope": [
                "meta.decorator",
                "punctuation.decorator",
                "storage.type.annotation"
            ],
            "settings": { "foreground": "#6e6b15" }
        },
        {
            "name": "CSS Class",
            "scope": ["entity.other.attribute-name.class.css"],
            "settings": { "foreground": "#1b6bab" }
        },
        {
            "name": "CSS ID",
            "scope": ["entity.other.attribute-name.id.css"],
            "settings": { "foreground": "#1b6bab" }
        },
        {
            "name": "CSS Element Selector",
            "scope": [
                "entity.name.tag.css",
                "entity.name.tag.less",
                "entity.name.tag.scss"
            ],
            "settings": { "foreground": "#a33d1e" }
        },
        {
            "name": "CSS Pseudo",
            "scope": [
                "entity.other.attribute-name.pseudo-class.css",
                "entity.other.attribute-name.pseudo-element.css"
            ],
            "settings": { "foreground": "#6e6b15" }
        },
        {
            "name": "CSS Variable",
            "scope": ["variable.css", "variable.argument.css"],
            "settings": { "foreground": "#0b6e5f" }
        },
        {
            "name": "CSS Property",
            "scope": [
                "support.type.property-name.css",
                "support.type.vendored.property-name.css",
                "support.type.property-name.scss",
                "support.type.property-name.less"
            ],
            "settings": { "foreground": "#0b6e5f" }
        },
        {
            "name": "CSS Value",
            "scope": [
                "support.constant.property-value.css",
                "support.constant.font-name.css",
                "support.constant.color.css",
                "constant.other.color.rgb-value.css",
                "support.constant.media.css"
            ],
            "settings": { "foreground": "#a33d1e" }
        },
        {
            "name": "CSS Unit",
            "scope": ["keyword.other.unit.css", "keyword.other.unit.scss"],
            "settings": { "foreground": "#0891b2" }
        },
        {
            "name": "CSS Important",
            "scope": ["keyword.other.important.css"],
            "settings": { "foreground": "#a33d1e", "fontStyle": "bold" }
        },
        {
            "name": "JSON Key",
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#8b3685" }
        },
        {
            "name": "Markdown Heading",
            "scope": ["markup.heading", "entity.name.section.markdown"],
            "settings": { "foreground": "#1b6bab", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Bold",
            "scope": ["markup.bold"],
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Markdown Italic",
            "scope": ["markup.italic"],
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "Markdown Strikethrough",
            "scope": ["markup.strikethrough"],
            "settings": { "fontStyle": "strikethrough" }
        },
        {
            "name": "Markdown Code",
            "scope": ["markup.inline.raw", "markup.fenced_code.block"],
            "settings": { "foreground": "#2b9a3e" }
        },
        {
            "name": "Markdown Link",
            "scope": ["markup.underline.link"],
            "settings": { "foreground": "#1b6bab" }
        },
        {
            "name": "Markdown List Marker",
            "scope": ["punctuation.definition.list.begin.markdown"],
            "settings": { "foreground": "#a33d1e" }
        },
        {
            "name": "Markdown Quote",
            "scope": ["markup.quote.markdown"],
            "settings": { "foreground": "#9a9ea6" }
        },
        {
            "name": "RegExp",
            "scope": ["string.regexp"],
            "settings": { "foreground": "#0891a3" }
        },
        {
            "name": "YAML Key",
            "scope": ["entity.name.tag.yaml"],
            "settings": { "foreground": "#a33d1e" }
        },
        {
            "name": "Python Decorator",
            "scope": [
                "meta.function.decorator.python",
                "entity.name.function.decorator.python"
            ],
            "settings": { "foreground": "#6e6b15" }
        },
        {
            "name": "Rust Lifetime",
            "scope": [
                "storage.modifier.lifetime.rust",
                "entity.name.type.lifetime.rust"
            ],
            "settings": { "foreground": "#0b6e5f" }
        },
        {
            "name": "JSX Tag",
            "scope": [
                "support.class.component.jsx",
                "support.class.component.tsx"
            ],
            "settings": { "foreground": "#0b6e5f" }
        },
        {
            "name": "Meta Embedded",
            "scope": ["meta.embedded"],
            "settings": { "foreground": "#383c42" }
        },
        {
            "name": "PHP Tag",
            "scope": [
                "punctuation.section.embedded.begin.php",
                "punctuation.section.embedded.end.php"
            ],
            "settings": { "foreground": "#a33d1e" }
        },
        {
            "name": "Diff Inserted",
            "scope": ["markup.inserted"],
            "settings": { "foreground": "#2b9a3e" }
        },
        {
            "name": "Diff Deleted",
            "scope": [
                "markup.deleted",
                "meta.diff.header.from-file",
                "punctuation.definition.deleted"
            ],
            "settings": { "foreground": "#cb2431" }
        },
        {
            "name": "Error",
            "scope": ["invalid.illegal"],
            "settings": { "foreground": "#cb2431" }
        },
        {
            "name": "TODO",
            "scope": ["keyword.codetag"],
            "settings": { "foreground": "#5c5a10" }
        }
    ],
    "semanticTokenColors": {
        "comment": "#9a9ea6",
        "keyword": "#a33d1e",
        "string": "#2b9a3e",
        "number": "#0891b2",
        "regexp": "#0891a3",
        "operator": "#383c42",
        "function": "#1b6bab",
        "function.declaration": "#1b6bab",
        "function.defaultLibrary": "#1b6bab",
        "method": "#1c6dae",
        "method.declaration": "#1c6dae",
        "method.static": { "foreground": "#1c6dae" },
        "namespace": "#0b6e5f",
        "class": "#0b6e5f",
        "class.defaultLibrary": "#0b6e5f",
        "interface": "#096b5e",
        "type": "#0b6e5f",
        "type.defaultLibrary": "#0b6e5f",
        "enum": "#0b6e5f",
        "struct": "#0b6e5f",
        "typeParameter": "#096b5e",
        "variable": "#0b6e5f",
        "variable.readonly": "#8b3685",
        "variable.readonly.defaultLibrary": "#7d5300",
        "variable.defaultLibrary": "#7d5300",
        "parameter": "#0b6e5f",
        "parameter.declaration": "#0b6e5f",
        "property": "#0b6e5f",
        "property.declaration": "#8b3685",
        "property.readonly": { "foreground": "#8b3685" },
        "property.static": { "foreground": "#8b3685" },
        "enumMember": "#8b3685",
        "decorator": "#6e6b15",
        "event": "#1b6bab",
        "macro": "#a33d1e",
        "*.deprecated": {
            "foreground": "#6b6f77",
            "fontStyle": "strikethrough"
        }
    }
}
