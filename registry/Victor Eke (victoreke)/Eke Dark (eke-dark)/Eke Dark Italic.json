    "tokenColors": [
        {
            "name": "Comment",
            "scope": [
                "comment",
                "comment.block",
                "comment.line",
                "punctuation.definition.comment"
            ],
            "settings": { "foreground": "#7a7e85", "fontStyle": "italic" }
        },
        {
            "name": "Doc Comment",
            "scope": ["comment.block.documentation"],
            "settings": { "foreground": "#6E9A7C", "fontStyle": "italic" }
        },
        {
            "name": "Doc Comment Tag",
            "scope": [
                "storage.type.class.jsdoc",
                "entity.name.type.instance.jsdoc"
            ],
            "settings": { "foreground": "#78B88E" }
        },
        {
            "name": "String",
            "scope": [
                "string",
                "string.quoted",
                "string.template",
                "punctuation.definition.string"
            ],
            "settings": { "foreground": "#7FCC85" }
        },
        {
            "name": "String Interpolation",
            "scope": [
                "punctuation.definition.template-expression.begin",
                "punctuation.definition.template-expression.end",
                "punctuation.section.embedded"
            ],
            "settings": { "foreground": "#E5A070" }
        },
        {
            "name": "String Escape",
            "scope": [
                "constant.character.escape",
                "constant.other.placeholder"
            ],
            "settings": { "foreground": "#E5A070" }
        },
        {
            "name": "Number",
            "scope": ["constant.numeric", "constant.language.numeric"],
            "settings": { "foreground": "#3CC8D4" }
        },
        {
            "name": "Boolean",
            "scope": ["constant.language.boolean"],
            "settings": { "foreground": "#E5A070" }
        },
        {
            "name": "Null",
            "scope": ["constant.language.null", "constant.language.undefined"],
            "settings": { "foreground": "#E5A070" }
        },
        {
            "name": "Keyword",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.new",
                "keyword.operator.expression",
                "keyword.operator.typeof",
                "keyword.operator.instanceof",
                "keyword.operator.delete",
                "keyword.operator.void",
                "keyword.other"
            ],
            "settings": { "foreground": "#E5A070" }
        },
        {
            "name": "Operator",
            "scope": [
                "keyword.operator",
                "keyword.operator.arithmetic",
                "keyword.operator.assignment",
                "keyword.operator.comparison",
                "keyword.operator.logical"
            ],
            "settings": { "foreground": "#bcbec4" }
        },
        {
            "name": "Storage Type",
            "scope": ["storage.type", "storage.modifier"],
            "settings": { "foreground": "#E5A070" }
        },
        {
            "name": "Function",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call entity.name.function"
            ],
            "settings": { "foreground": "#6BBAFF" }
        },
        {
            "name": "Method",
            "scope": ["entity.name.function.member"],
            "settings": { "foreground": "#6DBCFF" }
        },
        {
            "name": "Static Method",
            "scope": ["entity.name.function.member.static"],
            "settings": { "foreground": "#6DBCFF", "fontStyle": "italic" }
        },
        {
            "name": "Class",
            "scope": [
                "entity.name.type.class",
                "entity.name.class",
                "support.class"
            ],
            "settings": { "foreground": "#42D4BA" }
        },
        {
            "name": "Type",
            "scope": ["entity.name.type", "support.type"],
            "settings": { "foreground": "#42D4BA" }
        },
        {
            "name": "Type Parameter",
            "scope": ["entity.name.type.parameter"],
            "settings": { "foreground": "#28D6C6" }
        },
        {
            "name": "Interface",
            "scope": ["entity.name.type.interface"],
            "settings": { "foreground": "#28D6C6" }
        },
        {
            "name": "Variable",
            "scope": [
                "variable",
                "variable.other.readwrite",
                "variable.other.object"
            ],
            "settings": { "foreground": "#42D4BA" }
        },
        {
            "name": "Constant Variable",
            "scope": ["variable.other.constant", "constant.other"],
            "settings": { "foreground": "#E08FD4", "fontStyle": "italic" }
        },
        {
            "name": "Property",
            "scope": ["variable.other.property", "support.variable.property"],
            "settings": { "foreground": "#E08FD4" }
        },
        {
            "name": "Object Literal Key",
            "scope": ["meta.object-literal.key"],
            "settings": { "foreground": "#E08FD4" }
        },
        {
            "name": "Static Property",
            "scope": ["variable.other.property.static"],
            "settings": { "foreground": "#E08FD4", "fontStyle": "italic" }
        },
        {
            "name": "Parameter",
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#42D4BA" }
        },
        {
            "name": "Language Variable",
            "scope": ["variable.language.this", "variable.language.super"],
            "settings": { "foreground": "#E5A070" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation.separator",
                "punctuation.terminator",
                "punctuation.accessor"
            ],
            "settings": { "foreground": "#bcbec4" }
        },
        {
            "name": "Brackets",
            "scope": ["punctuation.section", "meta.brace"],
            "settings": { "foreground": "#bcbec4" }
        },
        {
            "name": "Tag",
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#6BB0EA" }
        },
        {
            "name": "Tag Brackets",
            "scope": ["punctuation.definition.tag"],
            "settings": { "foreground": "#6f737a" }
        },
        {
            "name": "Tag Attribute",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#E08FD4" }
        },
        {
            "name": "Namespace / Module",
            "scope": [
                "entity.name.namespace",
                "entity.name.module",
                "entity.name.type.module"
            ],
            "settings": { "foreground": "#42D4BA" }
        },
        {
            "name": "Support Constant",
            "scope": ["support.constant", "variable.other.enummember"],
            "settings": { "foreground": "#E08FD4" }
        },
        {
            "name": "Decorator/Annotation",
            "scope": [
                "meta.decorator",
                "punctuation.decorator",
                "storage.type.annotation"
            ],
            "settings": { "foreground": "#CCC76E" }
        },
        {
            "name": "CSS Class",
            "scope": ["entity.other.attribute-name.class.css"],
            "settings": { "foreground": "#6BBAFF" }
        },
        {
            "name": "CSS ID",
            "scope": ["entity.other.attribute-name.id.css"],
            "settings": { "foreground": "#6BBAFF" }
        },
        {
            "name": "CSS Element Selector",
            "scope": [
                "entity.name.tag.css",
                "entity.name.tag.less",
                "entity.name.tag.scss"
            ],
            "settings": { "foreground": "#E5A070" }
        },
        {
            "name": "CSS Pseudo",
            "scope": [
                "entity.other.attribute-name.pseudo-class.css",
                "entity.other.attribute-name.pseudo-element.css"
            ],
            "settings": { "foreground": "#CCC76E" }
        },
        {
            "name": "CSS Variable",
            "scope": ["variable.css", "variable.argument.css"],
            "settings": { "foreground": "#42D4BA" }
        },
        {
            "name": "CSS Property",
            "scope": [
                "support.type.property-name.css",
                "support.type.vendored.property-name.css",
                "support.type.property-name.scss",
                "support.type.property-name.less"
            ],
            "settings": { "foreground": "#42D4BA" }
        },
        {
            "name": "CSS Value",
            "scope": [
                "support.constant.property-value.css",
                "support.constant.font-name.css",
                "support.constant.color.css",
                "constant.other.color.rgb-value.css",
                "support.constant.media.css"
            ],
            "settings": { "foreground": "#E5A070" }
        },
        {
            "name": "CSS Unit",
            "scope": ["keyword.other.unit.css", "keyword.other.unit.scss"],
            "settings": { "foreground": "#3CC8D4" }
        },
        {
            "name": "CSS Important",
            "scope": ["keyword.other.important.css"],
            "settings": { "foreground": "#E5A070", "fontStyle": "bold" }
        },
        {
            "name": "JSON Key",
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#E08FD4" }
        },
        {
            "name": "Markdown Heading",
            "scope": ["markup.heading", "entity.name.section.markdown"],
            "settings": { "foreground": "#6BBAFF", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Bold",
            "scope": ["markup.bold"],
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Markdown Italic",
            "scope": ["markup.italic"],
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "Markdown Strikethrough",
            "scope": ["markup.strikethrough"],
            "settings": { "fontStyle": "strikethrough" }
        },
        {
            "name": "Markdown Code",
            "scope": ["markup.inline.raw", "markup.fenced_code.block"],
            "settings": { "foreground": "#7FCC85" }
        },
        {
            "name": "Markdown Link",
            "scope": ["markup.underline.link"],
            "settings": { "foreground": "#6BBAFF" }
        },
        {
            "name": "Markdown List Marker",
            "scope": ["punctuation.definition.list.begin.markdown"],
            "settings": { "foreground": "#E5A070" }
        },
        {
            "name": "Markdown Quote",
            "scope": ["markup.quote.markdown"],
            "settings": { "foreground": "#7a7e85", "fontStyle": "italic" }
        },
        {
            "name": "RegExp",
            "scope": ["string.regexp"],
            "settings": { "foreground": "#58D8E8" }
        },
        {
            "name": "YAML Key",
            "scope": ["entity.name.tag.yaml"],
            "settings": { "foreground": "#E5A070" }
        },
        {
            "name": "Python Decorator",
            "scope": [
                "meta.function.decorator.python",
                "entity.name.function.decorator.python"
            ],
            "settings": { "foreground": "#CCC76E" }
        },
        {
            "name": "Rust Lifetime",
            "scope": [
                "storage.modifier.lifetime.rust",
                "entity.name.type.lifetime.rust"
            ],
            "settings": { "foreground": "#42D4C6" }
        },
        {
            "name": "JSX Tag",
            "scope": [
                "support.class.component.jsx",
                "support.class.component.tsx"
            ],
            "settings": { "foreground": "#42D4BA" }
        },
        {
            "name": "Meta Embedded",
            "scope": ["meta.embedded"],
            "settings": { "foreground": "#bcbec4" }
        },
        {
            "name": "PHP Tag",
            "scope": [
                "punctuation.section.embedded.begin.php",
                "punctuation.section.embedded.end.php"
            ],
            "settings": { "foreground": "#E5A070" }
        },
        {
            "name": "Diff Inserted",
            "scope": ["markup.inserted"],
            "settings": { "foreground": "#7FCC85" }
        },
        {
            "name": "Diff Deleted",
            "scope": [
                "markup.deleted",
                "meta.diff.header.from-file",
                "punctuation.definition.deleted"
            ],
            "settings": { "foreground": "#ffa198" }
        },
        {
            "name": "Error",
            "scope": ["invalid.illegal"],
            "settings": { "foreground": "#f75464" }
        },
        {
            "name": "TODO",
            "scope": ["keyword.codetag"],
            "settings": { "foreground": "#A0CC4A", "fontStyle": "italic" }
        }
    ],
    "semanticTokenColors": {
        "comment": "#7a7e85",
        "keyword": "#E5A070",
        "string": "#7FCC85",
        "number": "#3CC8D4",
        "regexp": "#58D8E8",
        "operator": "#bcbec4",
        "function": "#6BBAFF",
        "function.declaration": "#6BBAFF",
        "function.defaultLibrary": "#6BBAFF",
        "method": "#6DBCFF",
        "method.declaration": "#6DBCFF",
        "method.static": { "foreground": "#6DBCFF", "fontStyle": "italic" },
        "namespace": "#42D4BA",
        "class": "#42D4BA",
        "class.defaultLibrary": "#42D4BA",
        "interface": "#28D6C6",
        "type": "#42D4BA",
        "type.defaultLibrary": "#42D4BA",
        "enum": "#42D4BA",
        "struct": "#42D4BA",
        "typeParameter": "#28D6C6",
        "variable": "#42D4BA",
        "variable.readonly": "#E08FD4",
        "variable.readonly.defaultLibrary": "#EDCF88",
        "variable.defaultLibrary": "#EDCF88",
        "parameter": "#42D4BA",
        "parameter.declaration": "#42D4BA",
        "property": "#42D4BA",
        "property.declaration": "#E08FD4",
        "property.readonly": { "foreground": "#E08FD4", "fontStyle": "italic" },
        "property.static": { "foreground": "#E08FD4", "fontStyle": "italic" },
        "enumMember": "#E08FD4",
        "decorator": "#CCC76E",
        "event": "#6BBAFF",
        "macro": "#E5A070",
        "*.deprecated": {
            "foreground": "#6f737a",
            "fontStyle": "strikethrough"
        }
    }
}
