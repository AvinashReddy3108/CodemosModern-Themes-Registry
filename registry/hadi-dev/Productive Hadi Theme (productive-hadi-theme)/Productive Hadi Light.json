{
    "name": "Productive Hadi Light",
    "type": "light",
    "colors": {
        "editor.background": "#ffffff",
        "editor.foreground": "#1a202c",
        "editorCursor.foreground": "#0066cc",
        "editor.lineHighlightBackground": "#f8f9fa",
        "editorLineNumber.foreground": "#6b7280",
        "editorLineNumber.activeForeground": "#0066cc",
        "editorIndentGuide.background": "#e1e4e8",
        "editorIndentGuide.activeBackground": "#b0b5be",
        "editorWhitespace.foreground": "#e1e4e8",
        "sideBar.background": "#f8f9fa",
        "sideBar.foreground": "#1a202c",
        "sideBar.border": "#e1e4e8",
        "sideBarTitle.foreground": "#374151",
        "activityBar.background": "#24292e",
        "activityBar.foreground": "#ffffff",
        "activityBar.border": "#e1e4e8",
        "activityBarBadge.background": "#0066cc",
        "activityBarBadge.foreground": "#ffffff",
        "statusBar.background": "#0066cc",
        "statusBar.foreground": "#ffffff",
        "statusBar.debuggingBackground": "#d97706",
        "titleBar.activeBackground": "#24292e",
        "titleBar.activeForeground": "#ffffff",
        "titleBar.inactiveBackground": "#24292e",
        "list.activeSelectionBackground": "#e1e4e8",
        "list.activeSelectionForeground": "#0066cc",
        "list.hoverBackground": "#f0f1f3",
        "tab.activeBackground": "#ffffff",
        "tab.activeForeground": "#0066cc",
        "tab.inactiveBackground": "#f8f9fa",
        "tab.inactiveForeground": "#6b7280",
        "tab.border": "#e1e4e8",
        "focusBorder": "#0066cc",
        "input.background": "#ffffff",
        "input.foreground": "#1a202c",
        "input.border": "#e1e4e8",
        "scrollbarSlider.background": "#e1e4e899",
        "scrollbarSlider.hoverBackground": "#b0b5be99",
        "scrollbarSlider.activeBackground": "#0066cc99"
    },
    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#6b7280", "fontStyle": "italic" }
        },
        {
            "name": "Strings",
            "scope": ["string"],
            "settings": { "foreground": "#047857" }
        },
        {
            "name": "Numbers",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#b45309" }
        },
        {
            "name": "Keywords",
            "scope": ["keyword", "storage"],
            "settings": { "foreground": "#7c3aed", "fontStyle": "bold" }
        },
        {
            "name": "Storage Type",
            "scope": ["storage.type"],
            "settings": { "foreground": "#7c3aed", "fontStyle": "italic" }
        },
        {
            "name": "Functions",
            "scope": ["entity.name.function", "meta.function-call"],
            "settings": { "foreground": "#2563eb" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "variable.parameter", "variable.other"],
            "settings": { "foreground": "#374151" }
        },
        {
            "name": "Classes/Types",
            "scope": ["entity.name.type", "support.class"],
            "settings": { "foreground": "#0066cc", "fontStyle": "bold" }
        },
        {
            "name": "HTML Tags",
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#7c3aed" }
        },
        {
            "name": "HTML Attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#2563eb" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
