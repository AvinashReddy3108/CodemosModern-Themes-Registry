{
    "name": "Visual Studio Standard Light",
    "type": "light",
    "colors": {
        "editor.background": "#FFFFFF",
        "editor.foreground": "#000000",
        "editor.lineHighlightBackground": "#F0F0F0",
        "editor.selectionBackground": "#ADD6FF",
        "editor.inactiveSelectionBackground": "#E5EBF180",
        "editorCursor.foreground": "#000000",
        "editorLineNumber.foreground": "#2B91AF",
        "editorLineNumber.activeForeground": "#000000",
        "editorWhitespace.foreground": "#BFBFBF",
        "editorIndentGuide.background1": "#D3D3D3",
        "editorIndentGuide.activeBackground1": "#939393",
        "editorBracketMatch.background": "#DBD7CA",
        "editorBracketMatch.border": "#00000000",
        "activityBar.background": "#F3F3F3",
        "activityBar.foreground": "#000000",
        "activityBar.inactiveForeground": "#616161",
        "activityBar.border": "#CCCCCC",
        "activityBarBadge.background": "#007ACC",
        "activityBarBadge.foreground": "#FFFFFF",
        "sideBar.background": "#F6F6F6",
        "sideBar.foreground": "#000000",
        "sideBar.border": "#CCCCCC",
        "sideBarTitle.foreground": "#000000",
        "sideBarSectionHeader.background": "#E5E5E5",
        "sideBarSectionHeader.foreground": "#000000",
        "statusBar.background": "#007ACC",
        "statusBar.foreground": "#FFFFFF",
        "statusBar.noFolderBackground": "#68217A",
        "statusBar.debuggingBackground": "#CC6633",
        "statusBarItem.hoverBackground": "#0062A3",
        "titleBar.activeBackground": "#DDDDDD",
        "titleBar.activeForeground": "#000000",
        "titleBar.inactiveBackground": "#EEEEEE",
        "titleBar.inactiveForeground": "#616161",
        "titleBar.border": "#CCCCCC",
        "tab.activeBackground": "#FFFFFF",
        "tab.activeForeground": "#000000",
        "tab.inactiveBackground": "#ECECEC",
        "tab.inactiveForeground": "#616161",
        "tab.border": "#CCCCCC",
        "tab.activeBorder": "#007ACC",
        "tab.activeBorderTop": "#007ACC",
        "button.background": "#007ACC",
        "button.foreground": "#FFFFFF",
        "button.hoverBackground": "#0062A3",
        "input.background": "#FFFFFF",
        "input.foreground": "#000000",
        "input.border": "#CCCCCC",
        "input.placeholderForeground": "#767676",
        "dropdown.background": "#FFFFFF",
        "dropdown.foreground": "#000000",
        "dropdown.border": "#CCCCCC",
        "list.activeSelectionBackground": "#007ACC",
        "list.activeSelectionForeground": "#FFFFFF",
        "list.inactiveSelectionBackground": "#E4E6F1",
        "list.inactiveSelectionForeground": "#000000",
        "list.hoverBackground": "#E8E8E8",
        "list.hoverForeground": "#000000",
        "list.focusBackground": "#007ACC",
        "list.focusForeground": "#FFFFFF",
        "panel.background": "#F6F6F6",
        "panel.border": "#CCCCCC",
        "panelTitle.activeBorder": "#007ACC",
        "panelTitle.activeForeground": "#000000",
        "panelTitle.inactiveForeground": "#616161",
        "terminal.foreground": "#000000",
        "terminal.background": "#FFFFFF",
        "terminalCursor.foreground": "#000000",
        "editorWidget.background": "#F6F6F6",
        "editorWidget.border": "#CCCCCC",
        "editorSuggestWidget.background": "#F6F6F6",
        "editorSuggestWidget.border": "#CCCCCC",
        "editorSuggestWidget.selectedBackground": "#007ACC",
        "editorSuggestWidget.selectedForeground": "#FFFFFF",
        "editorError.foreground": "#E51400",
        "editorWarning.foreground": "#BF8803",
        "editorInfo.foreground": "#1A85FF",
        "scrollbarSlider.background": "#79797966",
        "scrollbarSlider.hoverBackground": "#646464B3",
        "scrollbarSlider.activeBackground": "#BFBFBF",
        "badge.background": "#C4C4C4",
        "badge.foreground": "#000000",
        "breadcrumb.foreground": "#616161",
        "breadcrumb.background": "#F6F6F6",
        "breadcrumb.focusForeground": "#000000",
        "breadcrumb.activeSelectionForeground": "#000000",
        "gitDecoration.modifiedResourceForeground": "#007ACC",
        "gitDecoration.deletedResourceForeground": "#E51400",
        "gitDecoration.untrackedResourceForeground": "#388A34",
        "gitDecoration.ignoredResourceForeground": "#8E8E8E",
        "gitDecoration.conflictingResourceForeground": "#BF8803",
        "editorBracketHighlight.foreground1": "#000000",
        "editorBracketHighlight.foreground2": "#000000",
        "editorBracketHighlight.foreground3": "#000000",
        "editorBracketHighlight.foreground4": "#000000",
        "editorBracketHighlight.foreground5": "#000000",
        "editorBracketHighlight.foreground6": "#000000"
    },
    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#008000" }
        },
        {
            "name": "Namespace in using directive",
            "scope": ["entity.name.type.namespace"],
            "settings": { "foreground": "#808080" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation.curlybrace",
                "punctuation.parenthesis",
                "punctuation.squarebracket",
                "punctuation.separator",
                "punctuation.terminator"
            ],
            "settings": { "foreground": "#000000" }
        },
        {
            "name": "String Interpolation Content",
            "scope": ["meta.embedded.interpolation", "meta.interpolation.cs"],
            "settings": { "foreground": "#000000" }
        },
        {
            "name": "String",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#A31515" }
        },
        {
            "name": "String Interpolation Braces",
            "scope": ["punctuation.definition.interpolation"],
            "settings": { "foreground": "#A31515" }
        },
        {
            "name": "String Interpolation Expression",
            "scope": ["meta.interpolation", "source.cs meta.interpolation"],
            "settings": { "foreground": "#000000" }
        },
        {
            "name": "Number",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#098658" }
        },
        {
            "name": "Built-in constant",
            "scope": [
                "constant.language",
                "constant.character",
                "constant.other"
            ],
            "settings": { "foreground": "#0000FF" }
        },
        {
            "name": "Keyword",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.new",
                "keyword.operator.expression",
                "keyword.other.using",
                "keyword.other.namespace",
                "storage.type",
                "storage.modifier"
            ],
            "settings": { "foreground": "#0000FF" }
        },
        {
            "name": "Operator",
            "scope": [
                "keyword.operator",
                "keyword.operator.arithmetic",
                "keyword.operator.assignment",
                "keyword.operator.comparison",
                "keyword.operator.logical"
            ],
            "settings": { "foreground": "#000000" }
        },
        {
            "name": "Function",
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#000000" }
        },
        {
            "name": "C# Object Variable",
            "scope": ["variable.other.object.cs"],
            "settings": { "foreground": "#2B91AF" }
        },
        {
            "name": "Variable",
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#000000" }
        },
        {
            "name": "Class name",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.type",
                "support.class"
            ],
            "settings": { "foreground": "#2B91AF" }
        },
        {
            "name": "Interface name",
            "scope": ["entity.name.interface"],
            "settings": { "foreground": "#2B91AF" }
        },
        {
            "name": "Property",
            "scope": ["variable.other.property", "support.variable.property"],
            "settings": { "foreground": "#000000" }
        },
        {
            "name": "Tag name",
            "scope": ["entity.name.tag", "meta.tag"],
            "settings": { "foreground": "#800000" }
        },
        {
            "name": "Tag attribute",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#FF0000" }
        },
        {
            "name": "Namespace",
            "scope": ["entity.name.namespace"],
            "settings": { "foreground": "#000000" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#FF0000" }
        },
        {
            "name": "Markup Bold",
            "scope": ["markup.bold"],
            "settings": { "foreground": "#000000", "fontStyle": "bold" }
        },
        {
            "name": "Markup Italic",
            "scope": ["markup.italic"],
            "settings": { "foreground": "#000000", "fontStyle": "italic" }
        },
        {
            "name": "Markup Heading",
            "scope": ["markup.heading"],
            "settings": { "foreground": "#0000FF", "fontStyle": "bold" }
        },
        {
            "name": "Markup Link",
            "scope": ["markup.underline.link"],
            "settings": { "foreground": "#0000FF", "fontStyle": "underline" }
        },
        {
            "name": "JSON Property Name",
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#0451A5" }
        },
        {
            "name": "CSS Class",
            "scope": ["entity.other.attribute-name.class.css"],
            "settings": { "foreground": "#800000" }
        },
        {
            "name": "CSS ID",
            "scope": ["entity.other.attribute-name.id.css"],
            "settings": { "foreground": "#800000" }
        },
        {
            "name": "CSS Property Name",
            "scope": ["support.type.property-name.css"],
            "settings": { "foreground": "#9CDCFE" }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "class": "#2B91AF",
        "struct": "#2B91AF",
        "enum": "#2B91AF",
        "interface": "#2B91AF",
        "type": "#2B91AF",
        "typeParameter": "#2B91AF",
        "delegate": "#2B91AF",
        "namespace": "#000000",
        "variable.static": "#2B91AF",
        "property.static": "#2B91AF",
        "parameter": "#000000",
        "property": "#000000",
        "variable.local": "#000000",
        "method": "#000000",
        "method.static": "#000000",
        "function": "#000000",
        "punctuation": "#000000",
        "*.unused": { "foreground": "#808080" },
        "parameter.unused": { "foreground": "#808080" },
        "variable.unused": { "foreground": "#808080" }
    },
    "$schema": "vscode://schemas/color-theme"
}
