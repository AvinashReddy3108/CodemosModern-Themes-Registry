    "tokenColors": [
        {
            "scope": "variable.parameter.function",
            "settings": { "foreground": "#f87000" }
        },
        {
            "scope": "variable.parameter",
            "settings": { "foreground": "#0077ff" }
        },
        {
            "scope": "comment, punctuation.definition.comment",
            "settings": { "foreground": "#bb8432bf", "fontStyle": " italic" }
        },
        { "scope": "none", "settings": { "foreground": "#ffffff" } },
        {
            "scope": "keyword.operator",
            "settings": { "foreground": "#3cff00" }
        },
        { "scope": "keyword", "settings": { "foreground": "#B45EFF" } },
        {
            "scope": "meta.function-call",
            "settings": { "foreground": "#00ccff" }
        },
        { "scope": "meta.class", "settings": { "foreground": "#0099ff" } },
        {
            "scope": "variable.other",
            "settings": { "foreground": "#00CCFF", "fontStyle": "" }
        },
        {
            "scope": "variable.name",
            "settings": { "foreground": "#cc00ff", "fontStyle": "" }
        },
        {
            "scope": "entity.name.function, meta.require, support.function.any-method",
            "settings": { "foreground": "#FFEB00" }
        },
        {
            "scope": "support.class, entity.name.class, entity.name.type.class",
            "settings": { "foreground": "#00ffd5" }
        },
        { "scope": "meta.class", "settings": { "foreground": "#A8BDD5" } },
        {
            "scope": "keyword.other.special-method",
            "settings": { "foreground": "#00FFAE" }
        },
        { "scope": "storage", "settings": { "foreground": "#B366FF" } },
        {
            "scope": "support.function",
            "settings": { "foreground": "#FF7F29" }
        },
        {
            "scope": "string, constant.other.symbol, entity.other.inherited-class",
            "settings": { "foreground": "#64FE2E" }
        },
        {
            "scope": "constant.numeric",
            "settings": { "foreground": "#FFCC00" }
        },
        { "scope": "none", "settings": { "foreground": "#FFCC00" } },
        { "scope": "none", "settings": { "foreground": "#FF692E" } },
        { "scope": "constant", "settings": { "foreground": "#d69d00" } },
        { "scope": "entity.name.tag", "settings": { "foreground": "#FE7000" } },
        {
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#B45EFF" }
        },
        {
            "scope": "entity.other.attribute-name.id, punctuation.definition.entity",
            "settings": { "foreground": "#FF2EB9" }
        },
        { "scope": "meta.selector", "settings": { "foreground": "#DF5CFF" } },
        { "scope": "none", "settings": { "foreground": "#FF692E" } },
        {
            "scope": "markup.heading punctuation.definition.heading, entity.name.section",
            "settings": { "foreground": "#FE0099", "fontStyle": "" }
        },
        {
            "scope": "keyword.other.unit",
            "settings": { "foreground": "#FFCC00" }
        },
        {
            "scope": "markup.bold, punctuation.definition.bold",
            "settings": { "foreground": "#FFCC00" }
        },
        {
            "scope": "markup.italic, punctuation.definition.italic",
            "settings": { "foreground": "#DF5CFF" }
        },
        {
            "scope": "markup.raw.inline",
            "settings": { "foreground": "#4DFF00" }
        },
        {
            "scope": "string.other.link, punctuation.definition.string.end.markdown",
            "settings": { "foreground": "#FF8000" }
        },
        { "scope": "meta.link", "settings": { "foreground": "#FF692E" } },
        { "scope": "markup.list", "settings": { "foreground": "#FF8000" } },
        { "scope": "markup.quote", "settings": { "foreground": "#FF692E" } },
        { "scope": "meta.separator", "settings": { "foreground": "#ffffff" } },
        { "scope": "markup.inserted", "settings": { "foreground": "#4DFF00" } },
        { "scope": "markup.deleted", "settings": { "foreground": "#FF8000" } },
        { "scope": "markup.changed", "settings": { "foreground": "#DF5CFF" } },
        {
            "scope": "constant.other.color",
            "settings": { "foreground": "#FFCC00" }
        },
        { "scope": "string.regexp", "settings": { "foreground": "#eeff00" } },
        {
            "scope": "constant.character.escape",
            "settings": { "foreground": "#00e1ff" }
        },
        {
            "scope": "punctuation.section.embedded, variable.interpolation",
            "settings": { "foreground": "#ffffff" }
        },
        { "scope": "invalid.illegal", "settings": { "foreground": "#000000" } },
        { "scope": "invalid.broken", "settings": { "foreground": "#000000" } },
        {
            "scope": "invalid.deprecated",
            "settings": { "foreground": "#000000" }
        },
        {
            "scope": "invalid.unimplemented",
            "settings": { "foreground": "#000000" }
        },
        {
            "scope": "source.json                           meta.structure.dictionary.json                              string.quoted.double.json",
            "settings": { "foreground": "#bf00ff" }
        },
        {
            "scope": "source.json                       meta.structure.dictionary.json                           meta.structure.dictionary.value.json                       string.quoted.double.json",
            "settings": { "foreground": "#00CCFF" }
        },
        {
            "scope": "source.json                           meta.structure.dictionary.json                          meta.structure.dictionary.value.json                        meta.structure.dictionary.json                      string.quoted.double.json",
            "settings": { "foreground": "#FF8000" }
        },
        {
            "scope": "source.json                       meta.structure.dictionary.json                        meta.structure.dictionary.value.json                       meta.structure.dictionary.json                          meta.structure.dictionary.value.json                            string.quoted.double.json",
            "settings": { "foreground": "#4DFF00" }
        },
        {
            "scope": "support.type.property-name.json",
            "settings": { "foreground": "#A349F9" }
        },
        {
            "scope": "support.type.property-name.json punctuation",
            "settings": { "foreground": "#A349F9" }
        },
        {
            "scope": "text.html.laravel-blade                        source.php.embedded.line.html                     entity.name.tag.laravel-blade",
            "settings": { "foreground": "#DF5CFF" }
        },
        {
            "scope": "text.html.laravel-blade                         source.php.embedded.line.html                    support.constant.laravel-blade",
            "settings": { "foreground": "#DF5CFF" }
        },
        {
            "scope": "meta.function-call variable.function",
            "settings": { "foreground": "#FFEB00" }
        },
        {
            "scope": "sublimelinter.mark.error",
            "settings": { "foreground": "#c90000" }
        },
        {
            "scope": "sublimelinter.gutter-mark",
            "settings": { "foreground": "#FFFFFF" }
        },
        {
            "scope": "sublimelinter.mark.warning",
            "settings": { "foreground": "#DDB700" }
        },
        {
            "scope": "flake8lint.mark.error",
            "settings": { "foreground": "#DA2000" }
        },
        {
            "scope": "flake8lint.mark.gutter",
            "settings": { "foreground": "#FFFFFF" }
        },
        {
            "scope": "flake8lint.mark.warning",
            "settings": { "foreground": "#EDBA00" }
        },
        {
            "scope": "flake8lint.mark.critical",
            "settings": { "foreground": "#981600" }
        },
        {
            "scope": "token.info-token",
            "settings": { "foreground": "#6796E6" }
        },
        {
            "scope": "token.warn-token",
            "settings": { "foreground": "#CD9731" }
        },
        {
            "scope": "token.error-token",
            "settings": { "foreground": "#F44747" }
        },
        {
            "scope": "token.debug-token",
            "settings": { "foreground": "#B267E6" }
        },
        { "scope": "string", "settings": { "foreground": "#a2e1ff" } },
        {
            "scope": "meta.embedded.assembly",
            "settings": { "foreground": "#95DCF1" }
        },
        {
            "scope": "entity.name.function",
            "settings": { "foreground": "#00FF40" }
        },
        {
            "scope": "support.function",
            "settings": { "foreground": "#00FF40" }
        },
        { "scope": "variable", "settings": { "foreground": "#f701ff" } },
        {
            "scope": "entity.name.variable",
            "settings": { "foreground": "#f701ff" }
        },
        {
            "scope": "support.variable",
            "settings": { "foreground": "#cf7c00", "fontStyle": "italic bold" }
        },
        {
            "scope": "support.type.property-name",
            "settings": { "foreground": "#00ff0d", "fontStyle": "italic bold" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
