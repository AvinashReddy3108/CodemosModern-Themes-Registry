{
    "name": "devops highlighter",
    "include": "./dark_plus.json",
    "tokenColors": [
        {
            "scope": "pipeline.parameters.keyword",
            "settings": { "foreground": "#fdcba9" }
        },
        {
            "name": "Pipeline parameters value",
            "scope": "pipeline.parameters.value",
            "settings": { "foreground": "#dfdab0" }
        },
        {
            "scope": ["pipeline.parameters.begin", "pipeline.parameters.end"],
            "settings": { "foreground": "#80ff91" }
        },
        {
            "scope": "pipeline.runtime.variable.value",
            "settings": { "foreground": "#cda7ff" }
        },
        {
            "scope": [
                "pipeline.runtime.variable.begin",
                "pipeline.runtime.variable.end"
            ],
            "settings": { "foreground": "#80ff91" }
        },
        {
            "scope": [
                "pipeline.variable.definition.begin",
                "pipeline.variable.definition.end"
            ],
            "settings": { "foreground": "#80ff91" }
        },
        {
            "scope": [
                "pipeline.variable.definition.name",
                "pipeline.variable.definition.value"
            ],
            "settings": { "foreground": "#cda7ff" }
        },
        {
            "scope": [
                "pipeline.runtime.expression.begin",
                "pipeline.runtime.expression.end"
            ],
            "settings": { "foreground": "#80ff91" }
        },
        {
            "scope": ["pipeline.runtime.expression.value"],
            "settings": { "foreground": "#cda7ff" }
        },
        {
            "scope": ["pipeline.variables.begin", "pipeline.variables.end"],
            "settings": { "foreground": "#80ff91" }
        },
        {
            "scope": ["pipeline.variables.value"],
            "settings": { "foreground": "#dfdab0" }
        },
        {
            "scope": "pipeline.variables.keyword",
            "settings": { "foreground": "#a7b0ff" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
