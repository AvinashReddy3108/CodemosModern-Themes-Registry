    "semanticTokenColors": {
        "variable": "#1e7d62",
        "variable.local": "#616c44",
        "local": "#616c44",
        "property": "#537c5c",
        "property.declaration": "#537c5c",
        "field": "#537c5c",
        "class": { "foreground": "#856a45", "fontStyle": "bold" },
        "interface": { "foreground": "#7a7a50", "fontStyle": "bold" },
        "type": { "foreground": "#7a7a50", "fontStyle": "bold" },
        "function": "#1e7a84",
        "method": "#1e7a84",
        "extensionMethod": "#1e7a84",
        "parameter": "#838359"
    },
    "tokenColors": [
        {
            "name": "Keyword",
            "scope": "keyword.control, keyword.control punctuation, keyword.other",
            "settings": { "foreground": "#677742", "fontStyle": "bold" }
        },
        {
            "name": "Storage",
            "scope": [
                "storage",
                "storage.type",
                "keyword.operator.new",
                "entity.name.type"
            ],
            "settings": { "fontStyle": "bold", "foreground": "#875143" }
        },
        {
            "name": "Module",
            "scope": ["entity.name.type.module"],
            "settings": { "fontStyle": "bold", "foreground": "#9d9b9b" }
        },
        {
            "name": "namespace",
            "scope": ["entity.name.namespace"],
            "settings": { "foreground": "#688690" }
        },
        {
            "name": "Token",
            "scope": ["token", "meta.property-list"],
            "settings": { "foreground": "#7d889e" }
        },
        {
            "name": "Function",
            "scope": ["entity.name.function"],
            "settings": { "foreground": "#1e7a84" }
        },
        {
            "name": "Comment",
            "scope": [
                "comment",
                "puncutuation.definition.comment",
                "puncutuation.definition.comment.json",
                "comment.line.double-slash"
            ],
            "settings": { "foreground": "#4d4d44", "fontStyle": "italic" }
        },
        {
            "name": "String",
            "scope": [
                "string",
                "punctuation.definition.string",
                "string.regexp punctuation.definition.string",
                "meta.attribute-selector"
            ],
            "settings": { "foreground": "#9e9d9d" }
        },
        {
            "name": "Primitive types",
            "scope": [
                "support.type.primitive",
                "keyword.type",
                "support.type.builtin"
            ],
            "settings": { "foreground": "#3b708f", "fontStyle": "bold" }
        },
        {
            "name": "Number, boolean",
            "scope": [
                "constant.numeric",
                "constant.language",
                "keyword.other.unit",
                "keyword.operator.quantifier"
            ],
            "settings": { "foreground": "#3b708f", "fontStyle": "bold" }
        },
        {
            "name": "Scope Resolution",
            "scope": "entity.name.scope-resolution",
            "settings": { "foreground": "#5b747e" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "meta.structure",
                "punctuation.definition.block",
                "meta.brace.square",
                "meta.brace.round",
                "punctuation.definition.parameters",
                "keyword.operator.logical"
            ],
            "settings": { "foreground": "#959191" }
        },
        {
            "name": "Optional",
            "scope": ["keyword.operator.optional"],
            "settings": { "foreground": "#997f6c" }
        },
        {
            "name": "pointer access",
            "scope": ["punctuation.separator.pointer-access"],
            "settings": { "foreground": "#cecaca" }
        },
        {
            "name": "variable",
            "scope": ["source variable", "source support.variable"],
            "settings": { "foreground": "#577d8d" }
        },
        {
            "name": "operator",
            "scope": ["keyword.operator", "punctuation.separator.pointer"],
            "settings": { "foreground": "#a29f9f" }
        },
        {
            "name": "Parameter",
            "scope": "variable.parameter",
            "settings": { "foreground": "#627e89" }
        },
        {
            "name": "Constant variable",
            "scope": [
                "source variable.other.constant",
                "variable.other.constant"
            ],
            "settings": { "foreground": "#856e42" }
        },
        {
            "name": "CSS constant value",
            "scope": "support.constant.property-value",
            "settings": { "foreground": "#a8a4a4" }
        },
        {
            "name": "User-defined constant",
            "scope": "constant.character, constant.other",
            "settings": { "foreground": "#63808b" }
        },
        {
            "name": "HTML attribute",
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#4a6749" }
        },
        {
            "name": "this",
            "scope": "variable.language.this",
            "settings": { "foreground": "#b0adad" }
        },
        {
            "name": "CSS &",
            "scope": "entity.name.tag.reference",
            "settings": { "foreground": "#587c9b" }
        },
        {
            "name": "CSS",
            "scope": ["source.css", "support.type.property-name.css"],
            "settings": { "foreground": "#7e6d46" }
        },
        {
            "name": "HTML tags",
            "scope": [
                "support.class.component",
                "punctuation.definition.tag.begin.tsx",
                "punctuation.definition.tag.end.tsx",
                "punctuation.definition.tag.begin.html",
                "punctuation.definition.tag.end.html",
                "entity.name.tag"
            ],
            "settings": { "foreground": "#736b5c" }
        },
        {
            "name": "JSON Property",
            "scope": ["variable.other.property", "support.type.property-name"],
            "settings": { "foreground": "#47684e" }
        },
        {
            "name": "JSON Array",
            "scope": [
                "punctuation.definition.array.begin",
                "punctuation.definition.array.end"
            ],
            "settings": { "foreground": "#816743", "fontStyle": "bold" }
        },
        {
            "name": "JSON Dictionary",
            "scope": [
                "punctuation.definition.dictionary.begin",
                "punctuation.definition.dictionary.end"
            ],
            "settings": { "foreground": "#8f563e", "fontStyle": "bold" }
        },
        {
            "name": "JSON colon",
            "scope": ["punctuation.separator.dictionary.key-value"],
            "settings": { "foreground": "#1b7b82", "fontStyle": "bold" }
        },
        {
            "name": "JSON string",
            "scope": [
                "string.quoted.double.json",
                "punctuation.definition.string.begin.json",
                "punctuation.definition.string.end.json"
            ],
            "settings": { "foreground": "#777752" }
        },
        {
            "name": "H1 - Markdown",
            "scope": ["heading.1.markdown"],
            "settings": { "foreground": "#82823c" }
        },
        {
            "name": "H2 - Markdown",
            "scope": ["heading.2.markdown"],
            "settings": { "foreground": "#4d7e3c" }
        },
        {
            "name": "H3 - Markdown",
            "scope": ["heading.3.markdown"],
            "settings": { "foreground": "#2e7880" }
        },
        {
            "name": "H4 - Markdown",
            "scope": ["heading.4.markdown"],
            "settings": { "foreground": "#8f4d41" }
        },
        {
            "name": "H5 - Markdown",
            "scope": ["heading.5.markdown"],
            "settings": { "foreground": "#8b6f3e" }
        },
        {
            "name": "H6 - Markdown",
            "scope": ["heading.6.markdown"],
            "settings": { "foreground": "#277157" }
        },
        {
            "name": "Paragraph - Markdown",
            "scope": ["text.html.markdown"],
            "settings": { "foreground": "#a4a2a2" }
        },
        {
            "name": "Link - Markdown",
            "scope": [
                "meta.link.inline.markdown",
                "string.other.link.title.markdown"
            ],
            "settings": { "foreground": "#7e762c" }
        },
        {
            "name": "Code block - Markdown",
            "scope": ["markup.fenced_code.block.markdown"],
            "settings": { "foreground": "#52524d" }
        },
        {
            "name": "Code block content - Markdown",
            "scope": ["meta.embedded.block"],
            "settings": { "foreground": "#a5a3a3" }
        },
        {
            "name": "Bold - Markdown",
            "scope": ["markup.bold.markdown"],
            "settings": { "foreground": "#a4a4a4", "fontStyle": "bold" }
        },
        {
            "name": "Bold - Markdown",
            "scope": ["markup.italic.markdown"],
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "HR - Markdown",
            "scope": ["meta.separator.markdown"],
            "settings": { "foreground": "#775528" }
        },
        {
            "name": "Blockquote - Markdown",
            "scope": ["markup.quote.markdown"],
            "settings": { "foreground": "#62793e" }
        },
        {
            "name": "Unnumbered list - Markdown",
            "scope": ["markup.list.unnumbered.markdown"],
            "settings": { "foreground": "#1c7b80" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
