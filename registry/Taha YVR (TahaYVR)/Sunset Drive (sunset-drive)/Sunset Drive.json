        "terminal.ansiBlue": "#33A1FF",
        "terminal.ansiMagenta": "#FF66F6",
        "terminal.ansiCyan": "#3CFFED",
        "terminal.ansiWhite": "#BDBDE6",
        "terminal.ansiBrightBlack": "#8C8CB8",
        "terminal.ansiBrightRed": "#FF5588",
        "terminal.ansiBrightGreen": "#33FFBB",
        "terminal.ansiBrightYellow": "#FFEE44",
        "terminal.ansiBrightBlue": "#66BBFF",
        "terminal.ansiBrightMagenta": "#FF99FF",
        "terminal.ansiBrightCyan": "#66FFFF",
        "terminal.ansiBrightWhite": "#F8F8FF"
    },
    "tokenColors": [
        { "scope": "emphasis", "settings": { "fontStyle": "italic" } },
        {
            "name": "Imported bindings (JS/TS/Svelte)",
            "scope": [
                "meta.import variable.other.readwrite",
                "meta.import variable.other.readwrite.alias",
                "meta.import variable.other",
                "meta.import entity.name.namespace",
                "meta.import support.class",
                "entity.name.import"
            ],
            "settings": { "foreground": "#EFBF04" }
        },
        { "scope": "strong", "settings": { "fontStyle": "bold" } },
        {
            "scope": [
                "comment",
                "comment.block",
                "comment.line",
                "punctuation.definition.comment"
            ],
            "settings": { "foreground": "#7575A3", "fontStyle": "italic" }
        },
        {
            "scope": ["string", "string.quoted", "string.unquoted"],
            "settings": { "foreground": "#FF66F6" }
        },
        {
            "scope": ["string.regexp", "string.regex"],
            "settings": { "foreground": "#FF66F6" }
        },
        {
            "scope": [
                "constant.character.escape",
                "string.escape",
                "string.special",
                "string.special.symbol"
            ],
            "settings": { "foreground": "#FFEA00" }
        },
        {
            "scope": ["constant.numeric", "number", "float"],
            "settings": { "foreground": "#FFEA00" }
        },
        {
            "scope": [
                "constant.language.boolean",
                "constant.language.true",
                "constant.language.false"
            ],
            "settings": { "foreground": "#FFEA00" }
        },
        {
            "scope": ["variable", "variable.other.readwrite"],
            "settings": { "foreground": "#EDEDFE" }
        },
        {
            "scope": [
                "variable.language",
                "variable.language.this",
                "variable.builtin"
            ],
            "settings": { "foreground": "#33A1FF" }
        },
        {
            "scope": "variable.parameter",
            "settings": { "foreground": "#BDBDE6" }
        },
        {
            "scope": "variable.other.member",
            "settings": { "foreground": "#EDEDFE" }
        },
        {
            "scope": ["constant", "constant.other"],
            "settings": { "foreground": "#FFEA00" }
        },
        {
            "scope": ["meta.preprocessor", "entity.name.function.preprocessor"],
            "settings": { "foreground": "#00F59B" }
        },
        {
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.type",
                "storage.type"
            ],
            "settings": { "foreground": "#00F59B" }
        },
        {
            "scope": ["keyword.operator", "operator"],
            "settings": { "foreground": "#00F59B" }
        },
        {
            "scope": [
                "variable.other.property",
                "support.type.property-name",
                "meta.object-literal.key"
            ],
            "settings": { "foreground": "#3CFFED" }
        },
        {
            "scope": [
                "entity.name.function",
                "entity.name.function.constructor"
            ],
            "settings": { "foreground": "#3CFFED" }
        },
        {
            "scope": [
                "meta.function-call",
                "meta.method-call",
                "support.function",
                "entity.name.function.call",
                "entity.name.function.method",
                "variable.function"
            ],
            "settings": { "foreground": "#3CFFED" }
        },
        {
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.class",
                "support.type"
            ],
            "settings": { "foreground": "#33A1FF" }
        },
        {
            "scope": ["support.type.builtin", "storage.type.builtin"],
            "settings": { "foreground": "#33A1FF", "fontStyle": "italic" }
        },
        {
            "scope": ["entity.name.namespace", "support.module", "namespace"],
            "settings": { "foreground": "#33A1FF", "fontStyle": "italic" }
        },
        {
            "scope": [
                "meta.decorator",
                "entity.name.function.decorator",
                "punctuation.decorator"
            ],
            "settings": { "foreground": "#FF66F6" }
        },
        {
            "scope": ["entity.name.tag", "tag"],
            "settings": { "foreground": "#00F59B" }
        },
        {
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#3CFFED", "fontStyle": "italic" }
        },
        {
            "name": "Tag delimiters",
            "scope": ["punctuation.definition.tag"],
            "settings": { "foreground": "#BDBDE6" }
        },
        {
            "scope": [
                "punctuation",
                "punctuation.separator",
                "punctuation.accessor",
                "punctuation.bracket"
            ],
            "settings": { "foreground": "#8C8CB8" }
        },
        {
            "scope": ["punctuation.special", "punctuation.special.symbol"],
            "settings": { "foreground": "#33A1FF" }
        },
        { "scope": "markup.inserted", "settings": { "foreground": "#00F59B" } },
        { "scope": "markup.deleted", "settings": { "foreground": "#FF3366" } },
        { "scope": "markup.changed", "settings": { "foreground": "#FFEA00" } },
        {
            "scope": "markup.heading",
            "settings": { "foreground": "#3CFFED", "fontStyle": "bold" }
        },
        {
            "scope": ["markup.underline.link", "string.other.link"],
            "settings": { "foreground": "#3CFFED" }
        }
    ],
    "semanticTokenColors": {
        "variable.declaration.readonly": "#FFEA00",
        "variable.readonly": "#FFEA00",
        "variable.declaration": "#EDEDFE"
    },
    "$schema": "vscode://schemas/color-theme"
}
