    "tokenColors": [
        {
            "name": "Comment",
            "scope": "comment",
            "settings": { "foreground": "#688b57", "fontStyle": "italic" }
        },
        {
            "name": "Storage types",
            "scope": "storage.type",
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Variable",
            "scope": ["variable", "entity.name.variable"],
            "settings": { "foreground": "#00BD9D" }
        },
        {
            "name": "Types declaration and references",
            "scope": [
                "meta.return-type",
                "support.class",
                "support.type",
                "entity.name.type",
                "entity.name.type.class",
                "entity.name.namespace",
                "entity.other.attribute",
                "entity.other.inherited-class",
                "entity.name.scope-resolution",
                "entity.name.class",
                "storage.type.numeric.go",
                "storage.type.byte.go",
                "storage.type.boolean.go",
                "storage.type.string.go",
                "storage.type.uintptr.go",
                "storage.type.error.go",
                "storage.type.rune.go",
                "storage.type.cs",
                "storage.type.generic.cs",
                "storage.type.modifier.cs",
                "storage.type.variable.cs",
                "storage.type.annotation.java",
                "storage.type.generic.java",
                "storage.type.java",
                "storage.type.object.array.java",
                "storage.type.primitive.array.java",
                "storage.type.primitive.java",
                "storage.type.token.java",
                "storage.type.groovy",
                "storage.type.annotation.groovy",
                "storage.type.parameters.groovy",
                "storage.type.generic.groovy",
                "storage.type.object.array.groovy",
                "storage.type.primitive.array.groovy",
                "storage.type.primitive.groovy",
                "punctuation.definition.typeparameters"
            ],
            "settings": { "foreground": "#FFB7FF" }
        },
        {
            "name": "Round brace",
            "scope": [
                "meta.brace.round",
                "punctuation.definition.parameters.begin",
                "punctuation.definition.parameters.end"
            ],
            "settings": { "foreground": "#8000ff" }
        },
        {
            "name": "Curly brace",
            "scope": [
                "punctuation.definition.block",
                "punctuation.operation.graphql",
                "punctuation.section.embedded"
            ],
            "settings": { "foreground": "#ff60cf" }
        },
        {
            "name": "Square brace",
            "scope": ["meta.array.literal", "meta.brace.square"],
            "settings": { "foreground": "#ffff2b" }
        },
        {
            "name": "Types declaration and references, TS grammar specific",
            "scope": [
                "meta.type.cast.expr",
                "meta.type.new.expr",
                "support.constant.math",
                "support.constant.dom",
                "support.constant.json",
                "support.class.builtin"
            ],
            "settings": { "foreground": "#00aa00", "fontStyle": "italic" }
        },
        {
            "name": "String",
            "scope": [
                "string",
                "constant.other.symbol",
                "punctuation.definition.string.template"
            ],
            "settings": { "foreground": "#ffdea1" }
        },
        {
            "name": "Regular Expressions and Escape Characters",
            "scope": ["string.regexp", "constant.character", "constant.other"],
            "settings": { "foreground": "#88fcdd" }
        },
        {
            "name": "Number",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#40DFFF" }
        },
        {
            "name": "Built-in constants",
            "scope": ["constant.language"],
            "settings": { "foreground": "#40DFFF", "fontStyle": "italic" }
        },
        {
            "name": "Object properties",
            "scope": ["variable.object.property", "meta.object-literal.key"],
            "settings": { "foreground": "#A0DCFF" }
        },
        {
            "name": "Member Variable",
            "scope": ["variable.member"],
            "settings": { "foreground": "#ff877e" }
        },
        {
            "name": "Language variable",
            "scope": ["variable.language"],
            "settings": { "fontStyle": "italic", "foreground": "#40DFFF" }
        },
        {
            "name": "Storage",
            "scope": ["storage"],
            "settings": { "foreground": "#FF5722" }
        },
        {
            "name": "Keyword",
            "scope": ["keyword"],
            "settings": { "foreground": "#FF5722" }
        },
        {
            "name": "Operators",
            "scope": [
                "keyword.operator",
                "constant.language.import-export-all"
            ],
            "settings": { "foreground": "#C4CCE4" }
        },
        {
            "name": "Operators special",
            "scope": [
                "keyword.operator.logical",
                "keyword.operator.comparison",
                "keyword.operator.arithmetic",
                "keyword.operator.increment",
                "keyword.operator.ternary",
                "keyword.operator.expression.typeof",
                "keyword.operator.relational",
                "constant.language.import-export-all",
                "punctuation.accessor.optional"
            ],
            "settings": { "foreground": "#ffff2b" }
        },
        {
            "name": "Separators like ; or ,",
            "scope": ["punctuation.separator", "punctuation.terminator"],
            "settings": { "foreground": "#6c7999" }
        },
        {
            "name": "Punctuation",
            "scope": ["punctuation.section"],
            "settings": { "foreground": "#C4CCE4" }
        },
        {
            "name": "Accessor",
            "scope": ["punctuation.accessor"],
            "settings": { "foreground": "#C4CCE4" }
        },
        {
            "name": "Types fixes",
            "scope": [
                "source.java storage.type",
                "source.haskell storage.type",
                "source.c storage.type"
            ],
            "settings": { "foreground": "#6e8bff" }
        },
        {
            "name": "Java primitive variable types",
            "scope": ["source.java storage.type.primitive"],
            "settings": { "foreground": "#40DFFF" }
        },
        {
            "name": "Function name",
            "scope": ["entity.name.function", "storage.type.function"],
            "settings": { "foreground": "#DAA40E", "fontStyle": "italic" }
        },
        {
            "name": "Function arguments",
            "scope": [
                "variable.parameter",
                "meta.parameter",
                "variable.other.constant"
            ],
            "settings": { "foreground": "#00BD9D", "fontStyle": "underline" }
        },
        {
            "name": "Function call",
            "scope": [
                "variable.function",
                "variable.annotation",
                "meta.function-call.generic",
                "support.function.go"
            ],
            "settings": { "foreground": "#DAA40E" }
        },
        {
            "name": "Library function",
            "scope": ["support.function", "support.macro"],
            "settings": { "foreground": "#ff877e" }
        },
        {
            "name": "Imports and packages",
            "scope": ["entity.name.import", "entity.name.package"],
            "settings": { "foreground": "#C4CCE4" }
        },
        {
            "name": "Entity name",
            "scope": ["entity.name"],
            "settings": { "foreground": "#6e8bff" }
        },
        {
            "name": "Tag",
            "scope": ["entity.name.tag", "meta.tag.sgml"],
            "settings": { "foreground": "#0088ff" }
        },
        {
            "name": "Tag start/end",
            "scope": [
                "punctuation.definition.tag.end",
                "punctuation.definition.tag.begin",
                "punctuation.definition.tag"
            ],
            "settings": { "foreground": "#0088ff99" }
        },
        {
            "name": "Tag attribute",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#A0DCFF" }
        },
        {
            "name": "Library constant",
            "scope": ["support.constant"],
            "settings": { "fontStyle": "italic", "foreground": "#e9a929" }
        },
        {
            "name": "Library class/type",
            "scope": ["support.type", "source.go storage.type"],
            "settings": { "foreground": "#FFB7FF", "fontStyle": "underline" }
        },
        {
            "name": "File exceptions",
            "scope": ["support.type.property-name"],
            "settings": { "fontStyle": "" }
        },
        { "scope": ["support.class"], "settings": { "foreground": "#9595FF" } },
        {
            "name": "Decorators/annotation",
            "scope": [
                "meta.decorator variable.other",
                "meta.decorator punctuation.decorator",
                "storage.type.annotation"
            ],
            "settings": { "foreground": "#fbd78f" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid"],
            "settings": { "foreground": "#CC2828" }
        },
        {
            "name": "diff.header",
            "scope": ["meta.diff", "meta.diff.header"],
            "settings": { "foreground": "#c880c8" }
        },
        {
            "name": "Ruby class methods",
            "scope": ["source.ruby variable.other.readwrite"],
            "settings": { "foreground": "#DAA40E" }
        },
        {
            "name": "CSS tag names",
            "scope": [
                "source.css entity.name.tag",
                "source.sass entity.name.tag",
                "source.scss entity.name.tag",
                "source.less entity.name.tag",
                "source.stylus entity.name.tag"
            ],
            "settings": { "foreground": "#6e8bff" }
        },
        {
            "name": "CSS browser prefix",
            "scope": [
                "source.css support.type",
                "source.sass support.type",
                "source.scss support.type",
                "source.less support.type",
                "source.stylus support.type"
            ],
            "settings": { "foreground": "#ffc4d6" }
        },
        {
            "name": "CSS Properties",
            "scope": ["support.type.property-name"],
            "settings": { "foreground": "#ff877e" }
        },
        {
            "name": "Search Results Nums",
            "scope": ["constant.numeric.line-number.find-in-files - match"],
            "settings": { "foreground": "#41506C" }
        },
        {
            "name": "Search Results Match Nums",
            "scope": ["constant.numeric.line-number.match"],
            "settings": { "foreground": "#FF5722" }
        },
        {
            "name": "Search Results Lines",
            "scope": ["entity.name.filename.find-in-files"],
            "settings": { "foreground": "#C4CCE4" }
        },
        { "scope": ["message.error"], "settings": { "foreground": "#CC2828" } },
        {
            "name": "Markup heading",
            "scope": ["markup.heading", "markup.heading entity.name"],
            "settings": { "fontStyle": "bold", "foreground": "#C4CCE4" }
        },
        {
            "name": "Markup links",
            "scope": ["markup.underline.link", "string.other.link"],
            "settings": { "foreground": "#40DFFF" }
        },
        {
            "name": "Markup Italic",
            "scope": ["markup.italic"],
            "settings": { "fontStyle": "italic", "foreground": "#ff877e" }
        },
        {
            "name": "Markup Bold",
            "scope": ["markup.bold"],
            "settings": { "fontStyle": "bold", "foreground": "#ff877e" }
        },
        {
            "name": "Markup Bold/italic",
            "scope": ["markup.italic markup.bold", "markup.bold markup.italic"],
            "settings": { "fontStyle": "bold italic" }
        },
        { "name": "Markup Code", "scope": ["markup.raw"], "settings": {} },
        {
            "name": "Markup Code Inline",
            "scope": ["markup.raw.inline"],
            "settings": {}
        },
        {
            "name": "Markdown Separator",
            "scope": ["meta.separator"],
            "settings": { "fontStyle": "bold", "foreground": "#41506C" }
        },
        {
            "name": "Markup Blockquote",
            "scope": ["markup.quote"],
            "settings": { "foreground": "#88fcdd", "fontStyle": "italic" }
        },
        {
            "name": "Markup List Bullet",
            "scope": ["markup.list punctuation.definition.list.begin"],
            "settings": { "foreground": "#DAA40E" }
        },
        {
            "name": "Markup added",
            "scope": ["markup.inserted"],
            "settings": { "foreground": "#00aa00" }
        },
        {
            "name": "Markup modified",
            "scope": ["markup.changed"],
            "settings": { "foreground": "#35A0E8" }
        },
        {
            "name": "Markup removed",
            "scope": ["markup.deleted"],
            "settings": { "foreground": "#fa969e" }
        },
        {
            "name": "Markup Strike",
            "scope": ["markup.strike"],
            "settings": { "foreground": "#fbd78f" }
        },
        {
            "name": "Markup Table",
            "scope": ["markup.table"],
            "settings": { "foreground": "#40DFFF" }
        },
        {
            "name": "Markup Raw Inline",
            "scope": ["text.html.markdown markup.inline.raw"],
            "settings": { "foreground": "#e9a929" }
        },
        {
            "name": "Markdown - Line Break",
            "scope": ["text.html.markdown meta.dummy.line-break"],
            "settings": { "foreground": "#41506C" }
        },
        {
            "name": "Markdown - Raw Block Fenced",
            "scope": ["punctuation.definition.markdown"],
            "settings": { "foreground": "#41506C" }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "parameter": { "foreground": "#00BD9D", "fontStyle": "" },
        "parameter.declaration": { "fontStyle": "underline" },
        "variable.declaration.readonly": { "fontStyle": "underline" },
        "variable.declaration": { "fontStyle": "underline" },
        "variable.readonly": { "fontStyle": "" },
        "property.readonly": { "fontStyle": "" },
        "property.declaration": { "foreground": "#A0DCFF" },
        "function": { "foreground": "#DAA40E", "fontStyle": "italic" }
    },
    "$schema": "vscode://schemas/color-theme"
}
