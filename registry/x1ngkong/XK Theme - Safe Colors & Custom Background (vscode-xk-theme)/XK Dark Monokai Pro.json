    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#727072", "fontStyle": "italic" }
        },
        {
            "name": "Strings",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#ffd866" }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.new",
                "storage.type",
                "storage.modifier"
            ],
            "settings": { "foreground": "#ff6188" }
        },
        {
            "name": "Numbers",
            "scope": ["constant.numeric", "constant.language"],
            "settings": { "foreground": "#ab9df2" }
        },
        {
            "name": "Types",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "entity.name.interface",
                "entity.name.enum",
                "support.type",
                "support.class"
            ],
            "settings": { "foreground": "#78dce8" }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call entity.name.function"
            ],
            "settings": { "foreground": "#a9dc76" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "variable.other", "support.variable"],
            "settings": { "foreground": "#fc9867" }
        },
        {
            "name": "Parameters",
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#fc9867e6", "fontStyle": "italic" }
        },
        {
            "name": "Punctuation",
            "scope": ["punctuation", "meta.brace"],
            "settings": { "foreground": "#fcfcfab3" }
        },
        {
            "name": "Operators",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#fcfcfacc" }
        },
        {
            "name": "HTML Tags",
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#ff6188" }
        },
        {
            "name": "HTML Attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#a9dc76" }
        },
        {
            "name": "CSS Properties",
            "scope": ["support.type.property-name.css"],
            "settings": { "foreground": "#a9dc76" }
        },
        {
            "name": "CSS Values",
            "scope": ["support.constant.property-value.css"],
            "settings": { "foreground": "#ffd866" }
        },
        {
            "name": "Imports / Modules",
            "scope": [
                "keyword.control.import",
                "keyword.control.from",
                "keyword.control.export"
            ],
            "settings": { "foreground": "#ff6188", "fontStyle": "italic" }
        },
        {
            "name": "Decorators",
            "scope": ["meta.decorator", "punctuation.decorator"],
            "settings": { "foreground": "#ff6188", "fontStyle": "italic" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#ff6188", "fontStyle": "underline" }
        },
        {
            "name": "Markup Heading",
            "scope": ["markup.heading", "entity.name.section"],
            "settings": { "foreground": "#a9dc76", "fontStyle": "bold" }
        },
        {
            "name": "Markup Bold",
            "scope": ["markup.bold"],
            "settings": { "foreground": "#78dce8", "fontStyle": "bold" }
        },
        {
            "name": "Markup Italic",
            "scope": ["markup.italic"],
            "settings": { "foreground": "#ff6188", "fontStyle": "italic" }
        },
        {
            "name": "Markup Link",
            "scope": ["markup.underline.link", "string.other.link"],
            "settings": { "foreground": "#a9dc76", "fontStyle": "underline" }
        },
        {
            "name": "Markup Inline Code",
            "scope": ["markup.inline.raw", "markup.inline.raw.string"],
            "settings": { "foreground": "#ffd866" }
        },
        {
            "name": "Markup Fenced Code Block",
            "scope": ["markup.fenced_code.block", "markup.raw.block"],
            "settings": { "foreground": "#fcfcfa" }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "class": "#78dce8",
        "interface": "#78dce8",
        "enum": "#78dce8",
        "enum-member": "#ab9df2",
        "function": "#a9dc76",
        "method": "#a9dc76",
        "variable": "#fc9867",
        "parameter": { "foreground": "#fc9867e6" },
        "property": "#fc9867",
        "property.readonly": "#fc9867d9",
        "type": "#78dce8",
        "namespace": "#78dce8",
        "keyword": "#ff6188",
        "string": "#ffd866",
        "number": "#ab9df2",
        "comment": "#727072",
        "decorator": "#ff6188"
    },
    "$schema": "vscode://schemas/color-theme"
}
