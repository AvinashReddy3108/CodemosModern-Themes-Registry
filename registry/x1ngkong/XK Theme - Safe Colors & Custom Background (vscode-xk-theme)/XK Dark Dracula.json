    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#6272a4", "fontStyle": "italic" }
        },
        {
            "name": "Strings",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#f1fa8c" }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.new",
                "storage.type",
                "storage.modifier"
            ],
            "settings": { "foreground": "#ff79c6" }
        },
        {
            "name": "Numbers",
            "scope": ["constant.numeric", "constant.language"],
            "settings": { "foreground": "#bd93f9" }
        },
        {
            "name": "Types",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "entity.name.interface",
                "entity.name.enum",
                "support.type",
                "support.class"
            ],
            "settings": { "foreground": "#8be9fd" }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call entity.name.function"
            ],
            "settings": { "foreground": "#50fa7b" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "variable.other", "support.variable"],
            "settings": { "foreground": "#f8f8f2" }
        },
        {
            "name": "Parameters",
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#f8f8f2e6", "fontStyle": "italic" }
        },
        {
            "name": "Punctuation",
            "scope": ["punctuation", "meta.brace"],
            "settings": { "foreground": "#f8f8f2b3" }
        },
        {
            "name": "Operators",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#f8f8f2cc" }
        },
        {
            "name": "HTML Tags",
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#ff79c6" }
        },
        {
            "name": "HTML Attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#bd93f9" }
        },
        {
            "name": "CSS Properties",
            "scope": ["support.type.property-name.css"],
            "settings": { "foreground": "#bd93f9" }
        },
        {
            "name": "CSS Values",
            "scope": ["support.constant.property-value.css"],
            "settings": { "foreground": "#f1fa8c" }
        },
        {
            "name": "Imports / Modules",
            "scope": [
                "keyword.control.import",
                "keyword.control.from",
                "keyword.control.export"
            ],
            "settings": { "foreground": "#ff79c6", "fontStyle": "italic" }
        },
        {
            "name": "Decorators",
            "scope": ["meta.decorator", "punctuation.decorator"],
            "settings": { "foreground": "#ff79c6", "fontStyle": "italic" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#ff5555", "fontStyle": "underline" }
        },
        {
            "name": "Markup Heading",
            "scope": ["markup.heading", "entity.name.section"],
            "settings": { "foreground": "#bd93f9", "fontStyle": "bold" }
        },
        {
            "name": "Markup Bold",
            "scope": ["markup.bold"],
            "settings": { "foreground": "#8be9fd", "fontStyle": "bold" }
        },
        {
            "name": "Markup Italic",
            "scope": ["markup.italic"],
            "settings": { "foreground": "#ff79c6", "fontStyle": "italic" }
        },
        {
            "name": "Markup Link",
            "scope": ["markup.underline.link", "string.other.link"],
            "settings": { "foreground": "#50fa7b", "fontStyle": "underline" }
        },
        {
            "name": "Markup Inline Code",
            "scope": ["markup.inline.raw", "markup.inline.raw.string"],
            "settings": { "foreground": "#f1fa8c" }
        },
        {
            "name": "Markup Fenced Code Block",
            "scope": ["markup.fenced_code.block", "markup.raw.block"],
            "settings": { "foreground": "#f8f8f2" }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "class": "#8be9fd",
        "interface": "#8be9fd",
        "enum": "#8be9fd",
        "enum-member": "#bd93f9",
        "function": "#50fa7b",
        "method": "#50fa7b",
        "variable": "#f8f8f2",
        "parameter": { "foreground": "#f8f8f2e6" },
        "property": "#f8f8f2",
        "property.readonly": "#f8f8f2d9",
        "type": "#8be9fd",
        "namespace": "#8be9fd",
        "keyword": "#ff79c6",
        "string": "#f1fa8c",
        "number": "#bd93f9",
        "comment": "#6272a4",
        "decorator": "#ff79c6"
    },
    "$schema": "vscode://schemas/color-theme"
}
