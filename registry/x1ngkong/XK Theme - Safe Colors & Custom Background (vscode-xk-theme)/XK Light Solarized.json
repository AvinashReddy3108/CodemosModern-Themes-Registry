    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#708284", "fontStyle": "italic" }
        },
        {
            "name": "Strings",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#1d7f7a" }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.new",
                "storage.type",
                "storage.modifier"
            ],
            "settings": { "foreground": "#5c6f00" }
        },
        {
            "name": "Numbers",
            "scope": ["constant.numeric", "constant.language"],
            "settings": { "foreground": "#a81676" }
        },
        {
            "name": "Types",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "entity.name.interface",
                "entity.name.enum",
                "support.type",
                "support.class"
            ],
            "settings": { "foreground": "#8a6500" }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call entity.name.function"
            ],
            "settings": { "foreground": "#1a6ea8" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "variable.other", "support.variable"],
            "settings": { "foreground": "#073642" }
        },
        {
            "name": "Parameters",
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#073642e6", "fontStyle": "italic" }
        },
        {
            "name": "Punctuation",
            "scope": ["punctuation", "meta.brace"],
            "settings": { "foreground": "#073642b3" }
        },
        {
            "name": "Operators",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#073642cc" }
        },
        {
            "name": "HTML Tags",
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#5c6f00" }
        },
        {
            "name": "HTML Attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#1a6ea8" }
        },
        {
            "name": "CSS Properties",
            "scope": ["support.type.property-name.css"],
            "settings": { "foreground": "#1a6ea8" }
        },
        {
            "name": "CSS Values",
            "scope": ["support.constant.property-value.css"],
            "settings": { "foreground": "#1d7f7a" }
        },
        {
            "name": "Imports / Modules",
            "scope": [
                "keyword.control.import",
                "keyword.control.from",
                "keyword.control.export"
            ],
            "settings": { "foreground": "#5c6f00", "fontStyle": "italic" }
        },
        {
            "name": "Decorators",
            "scope": ["meta.decorator", "punctuation.decorator"],
            "settings": { "foreground": "#a81676", "fontStyle": "italic" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#b81c1c", "fontStyle": "underline" }
        },
        {
            "name": "Markup Heading",
            "scope": ["markup.heading", "entity.name.section"],
            "settings": { "foreground": "#1a6ea8", "fontStyle": "bold" }
        },
        {
            "name": "Markup Bold",
            "scope": ["markup.bold"],
            "settings": { "foreground": "#8a6500", "fontStyle": "bold" }
        },
        {
            "name": "Markup Italic",
            "scope": ["markup.italic"],
            "settings": { "foreground": "#a81676", "fontStyle": "italic" }
        },
        {
            "name": "Markup Link",
            "scope": ["markup.underline.link", "string.other.link"],
            "settings": { "foreground": "#1a6ea8", "fontStyle": "underline" }
        },
        {
            "name": "Markup Inline Code",
            "scope": ["markup.inline.raw", "markup.inline.raw.string"],
            "settings": { "foreground": "#165f5c" }
        },
        {
            "name": "Markup Fenced Code Block",
            "scope": ["markup.fenced_code.block", "markup.raw.block"],
            "settings": { "foreground": "#07333f" }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "class": "#8a6500",
        "interface": "#8a6500",
        "enum": "#8a6500",
        "enum-member": "#a81676",
        "function": "#1a6ea8",
        "method": "#1a6ea8",
        "variable": "#073642",
        "parameter": { "foreground": "#073642e6" },
        "property": "#073642",
        "property.readonly": "#073642d9",
        "type": "#8a6500",
        "namespace": "#8a6500",
        "keyword": "#5c6f00",
        "string": "#1d7f7a",
        "number": "#a81676",
        "comment": "#708284",
        "decorator": "#a81676"
    },
    "$schema": "vscode://schemas/color-theme"
}
