    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#565f89", "fontStyle": "italic" }
        },
        {
            "name": "Strings",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#9ece6a" }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.new",
                "storage.type",
                "storage.modifier"
            ],
            "settings": { "foreground": "#bb9af7" }
        },
        {
            "name": "Numbers",
            "scope": ["constant.numeric", "constant.language"],
            "settings": { "foreground": "#ff9e64" }
        },
        {
            "name": "Types",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "entity.name.interface",
                "entity.name.enum",
                "support.type",
                "support.class"
            ],
            "settings": { "foreground": "#2ac3de" }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call entity.name.function"
            ],
            "settings": { "foreground": "#7aa2f7" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "variable.other", "support.variable"],
            "settings": { "foreground": "#c0caf5" }
        },
        {
            "name": "Parameters",
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#c0caf5e6", "fontStyle": "italic" }
        },
        {
            "name": "Punctuation",
            "scope": ["punctuation", "meta.brace"],
            "settings": { "foreground": "#c0caf5b3" }
        },
        {
            "name": "Operators",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#c0caf5cc" }
        },
        {
            "name": "HTML Tags",
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#bb9af7" }
        },
        {
            "name": "HTML Attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#7aa2f7" }
        },
        {
            "name": "CSS Properties",
            "scope": ["support.type.property-name.css"],
            "settings": { "foreground": "#7aa2f7" }
        },
        {
            "name": "CSS Values",
            "scope": ["support.constant.property-value.css"],
            "settings": { "foreground": "#9ece6a" }
        },
        {
            "name": "Imports / Modules",
            "scope": [
                "keyword.control.import",
                "keyword.control.from",
                "keyword.control.export"
            ],
            "settings": { "foreground": "#bb9af7", "fontStyle": "italic" }
        },
        {
            "name": "Decorators",
            "scope": ["meta.decorator", "punctuation.decorator"],
            "settings": { "foreground": "#bb9af7", "fontStyle": "italic" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#f7768e", "fontStyle": "underline" }
        },
        {
            "name": "Markup Heading",
            "scope": ["markup.heading", "entity.name.section"],
            "settings": { "foreground": "#7aa2f7", "fontStyle": "bold" }
        },
        {
            "name": "Markup Bold",
            "scope": ["markup.bold"],
            "settings": { "foreground": "#2ac3de", "fontStyle": "bold" }
        },
        {
            "name": "Markup Italic",
            "scope": ["markup.italic"],
            "settings": { "foreground": "#bb9af7", "fontStyle": "italic" }
        },
        {
            "name": "Markup Link",
            "scope": ["markup.underline.link", "string.other.link"],
            "settings": { "foreground": "#7aa2f7", "fontStyle": "underline" }
        },
        {
            "name": "Markup Inline Code",
            "scope": ["markup.inline.raw", "markup.inline.raw.string"],
            "settings": { "foreground": "#9ece6a" }
        },
        {
            "name": "Markup Fenced Code Block",
            "scope": ["markup.fenced_code.block", "markup.raw.block"],
            "settings": { "foreground": "#c0caf5" }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "class": "#2ac3de",
        "interface": "#2ac3de",
        "enum": "#2ac3de",
        "enum-member": "#ff9e64",
        "function": "#7aa2f7",
        "method": "#7aa2f7",
        "variable": "#c0caf5",
        "parameter": { "foreground": "#c0caf5e6" },
        "property": "#c0caf5",
        "property.readonly": "#c0caf5d9",
        "type": "#2ac3de",
        "namespace": "#2ac3de",
        "keyword": "#bb9af7",
        "string": "#9ece6a",
        "number": "#ff9e64",
        "comment": "#565f89",
        "decorator": "#bb9af7"
    },
    "$schema": "vscode://schemas/color-theme"
}
