        "editorGutter.deletedBackground": "#6A103B99",
        "diffEditor.insertedTextBackground": "#DCF76322",
        "diffEditor.removedTextBackground": "#6A103B33",
        "editorError.foreground": "#FF2F92CC",
        "editorWarning.foreground": "#DCF763CC",
        "editorInfo.foreground": "#941751CC",
        "editorOverviewRuler.errorForeground": "#FF2F9240",
        "editorOverviewRuler.warningForeground": "#DCF76370",
