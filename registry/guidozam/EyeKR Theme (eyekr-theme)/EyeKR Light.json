{
    "name": "EyeKR Light",
    "type": "light",
    "colors": {
        "editor.background": "#faf8f5",
        "editor.foreground": "#111827",
        "activityBar.background": "#f1ede7",
        "activityBar.foreground": "#5a6470",
        "activityBar.inactiveForeground": "#9ca3af",
        "activityBarBadge.background": "#7c3aed",
        "activityBarBadge.foreground": "#ffffff",
        "sideBar.background": "#f8f6f2",
        "sideBar.foreground": "#23272e",
        "sideBarTitle.foreground": "#111827",
        "sideBarSectionHeader.background": "#ede8e0",
        "sideBarSectionHeader.foreground": "#111827",
        "editorGroup.border": "#e2e0dc",
        "editorGroupHeader.tabsBackground": "#f1ede7",
        "tab.activeBackground": "#faf8f5",
        "tab.activeForeground": "#111827",
        "tab.inactiveBackground": "#f1ede7",
        "tab.inactiveForeground": "#4b5563",
        "tab.border": "#e2e0dc",
        "statusBar.background": "#e6e0d6",
        "statusBar.foreground": "#23272e",
        "statusBar.noFolderBackground": "#e6e0d6",
        "statusBar.debuggingBackground": "#f6ad55",
        "editor.selectionBackground": "#d1e7dd80",
        "editor.selectionHighlightBackground": "#f8d7da60",
        "editor.findMatchBackground": "#fff3cd80",
        "editor.findMatchHighlightBackground": "#fff3cd50",
        "editorLineNumber.foreground": "#374151",
        "editorLineNumber.activeForeground": "#4b5563",
        "editorIndentGuide.background": "#e2e8f0",
        "editorIndentGuide.activeBackground": "#cbd5e0",
        "editorWhitespace.foreground": "#e2e8f0",
        "terminal.background": "#faf8f5",
        "terminal.foreground": "#23272e",
        "input.background": "#ffffff",
        "input.border": "#d1d5db",
        "input.foreground": "#111827",
        "scrollbarSlider.background": "#cbd5e030",
        "scrollbarSlider.hoverBackground": "#cbd5e050",
        "scrollbarSlider.activeBackground": "#cbd5e070"
    },
    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "fontStyle": "italic", "foreground": "#4b5563" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "string constant.other.placeholder"],
            "settings": { "foreground": "#111827" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#e53e3e" }
        },
        {
            "name": "Keyword, Storage",
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#7c3aed" }
        },
        {
            "name": "Operator, Misc",
            "scope": [
                "keyword.control",
                "constant.other.color",
                "punctuation",
                "meta.tag",
                "punctuation.definition.tag",
                "punctuation.separator.inheritance.php",
                "punctuation.definition.tag.html",
                "punctuation.definition.tag.begin.html",
                "punctuation.definition.tag.end.html",
                "punctuation.section.embedded",
                "keyword.other.template",
                "keyword.other.substitution"
            ],
            "settings": { "foreground": "#4299e1" }
        },
        {
            "name": "Tag",
            "scope": [
                "entity.name.tag",
                "meta.tag.sgml",
                "markup.deleted.git_gutter"
            ],
            "settings": { "foreground": "#d69e2e" }
        },
        {
            "name": "Function, Special Method",
            "scope": [
                "entity.name.function",
                "meta.function-call",
                "variable.function",
                "support.function",
                "keyword.other.special-method"
            ],
            "settings": { "foreground": "#3182ce" }
        },
        {
            "name": "Block Level Variables",
            "scope": ["meta.block variable.other"],
            "settings": { "foreground": "#d69e2e" }
        },
        {
            "name": "Other Variable, String Link",
            "scope": ["support.other.variable", "string.other.link"],
            "settings": { "foreground": "#d69e2e" }
        },
        {
            "name": "Number, Constant, Function Argument, Tag Attribute, Embedded",
            "scope": [
                "constant.numeric",
                "constant.language",
                "support.constant",
                "constant.character",
                "constant.escape",
                "variable.parameter",
                "keyword.other.unit",
                "keyword.other"
            ],
            "settings": { "foreground": "#c05621" }
        },
        {
            "name": "String, Symbols, Inherited Class, Markup Heading",
            "scope": [
                "string",
                "constant.other.symbol",
                "constant.other.key",
                "entity.other.inherited-class",
                "markup.heading",
                "markup.inserted.git_gutter",
                "meta.group.braces.curly constant.other.object.key.js string.unquoted.label.js"
            ],
            "settings": { "foreground": "#38a169" }
        },
        {
            "name": "Class, Support",
            "scope": [
                "entity.name",
                "support.type",
                "support.class",
                "support.other.namespace.use.php",
                "meta.use.php",
                "support.other.namespace.php",
                "markup.changed.git_gutter",
                "support.type.sys-types"
            ],
            "settings": { "foreground": "#d69e2e" }
        },
        {
            "name": "Entity Types",
            "scope": ["support.type"],
            "settings": { "foreground": "#374151" }
        },
        {
            "name": "CSS Class and Support",
            "scope": [
                "source.css support.type.property-name",
                "source.sass support.type.property-name",
                "source.scss support.type.property-name",
                "source.less support.type.property-name",
                "source.stylus support.type.property-name",
                "source.postcss support.type.property-name"
            ],
            "settings": { "foreground": "#374151" }
        },
        {
            "name": "Sub-methods",
            "scope": [
                "entity.name.module.js",
                "variable.import.parameter.js",
                "variable.other.class.js"
            ],
            "settings": { "foreground": "#e53e3e" }
        },
        {
            "name": "Language methods",
            "scope": ["variable.language"],
            "settings": { "fontStyle": "italic", "foreground": "#e53e3e" }
        },
        {
            "name": "entity.name.method.js",
            "scope": ["entity.name.method.js"],
            "settings": { "fontStyle": "italic", "foreground": "#3182ce" }
        },
        {
            "name": "meta.method.js",
            "scope": [
                "meta.class-method.js entity.name.function.js",
                "variable.function.constructor"
            ],
            "settings": { "foreground": "#3182ce" }
        },
        {
            "name": "Attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#7c3aed" }
        },
        {
            "name": "HTML Attributes",
            "scope": [
                "text.html.basic entity.other.attribute-name.html",
                "text.html.basic entity.other.attribute-name"
            ],
            "settings": { "fontStyle": "italic", "foreground": "#d69e2e" }
        },
        {
            "name": "CSS Classes",
            "scope": ["entity.other.attribute-name.class"],
            "settings": { "foreground": "#d69e2e" }
        },
        {
            "name": "Inserted",
            "scope": ["markup.inserted"],
            "settings": { "foreground": "#38a169" }
        },
        {
            "name": "Deleted",
            "scope": ["markup.deleted"],
            "settings": { "foreground": "#e53e3e" }
        },
        {
            "name": "Changed",
            "scope": ["markup.changed"],
            "settings": { "foreground": "#7c3aed" }
        },
        {
            "name": "Regular Expressions",
            "scope": ["string.regexp"],
            "settings": { "foreground": "#4299e1" }
        },
        {
            "name": "Escape Characters",
            "scope": ["constant.character.escape"],
            "settings": { "foreground": "#4299e1" }
        },
        {
            "name": "URL",
            "scope": ["*url*", "*link*", "*uri*"],
            "settings": { "fontStyle": "underline" }
        },
        {
            "name": "Decorators",
            "scope": [
                "tag.decorator.js entity.name.tag.js",
                "tag.decorator.js punctuation.definition.tag.js"
            ],
            "settings": { "fontStyle": "italic", "foreground": "#3182ce" }
        },
        {
            "name": "Markdown - Plain",
            "scope": [
                "text.html.markdown",
                "punctuation.definition.list_item.markdown"
            ],
            "settings": { "foreground": "#1f2937" }
        },
        {
            "name": "Markdown - Markup Raw Inline",
            "scope": ["text.html.markdown markup.inline.raw.markdown"],
            "settings": { "foreground": "#7c3aed" }
        },
        {
            "name": "Markdown - Heading",
            "scope": [
                "markdown.heading",
                "markup.heading | markup.heading entity.name",
                "markup.heading.markdown punctuation.definition.heading.markdown"
            ],
            "settings": { "foreground": "#38a169" }
        },
        {
            "name": "Markup - Italic",
            "scope": ["markup.italic"],
            "settings": { "fontStyle": "italic", "foreground": "#d69e2e" }
        },
        {
            "name": "Markup - Bold",
            "scope": ["markup.bold", "markup.bold string"],
            "settings": { "fontStyle": "bold", "foreground": "#d69e2e" }
        },
        {
            "name": "Markup - Underline",
            "scope": ["markup.underline"],
            "settings": { "fontStyle": "underline", "foreground": "#c05621" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
