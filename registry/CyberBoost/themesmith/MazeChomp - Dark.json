{
    "name": "MazeChomp",
    "type": "dark",
    "description": "A retro arcade palette inspired by Pac‑Man’s neon maze, combining the iconic yellow of Pac‑Man with the vivid ghost colors against a deep black backdrop.",
    "tags": ["pacman", "arcade", "retro", "gaming", "dark"],
    "semanticHighlighting": true,
    "colors": {
        "editor.background": "#0d0d0d",
        "editor.foreground": "#e0e0e0",
        "activityBar.background": "#141414",
        "activityBar.foreground": "#f5c542",
        "activityBar.activeBorder": "#f5c542",
        "activityBarBadge.background": "#ff4b4b",
        "activityBarBadge.foreground": "#ffffff",
        "sideBar.background": "#111111",
        "sideBar.foreground": "#c9c9c9",
        "sideBarTitle.foreground": "#f5c542",
        "sideBarSectionHeader.background": "#1a1a1a",
        "sideBarSectionHeader.foreground": "#c9c9c9",
        "titleBar.activeBackground": "#0d0d0d",
        "titleBar.activeForeground": "#f5c542",
        "titleBar.inactiveBackground": "#1a1a1a",
        "titleBar.inactiveForeground": "#999999",
        "statusBar.background": "#141414",
        "statusBar.foreground": "#f5c542",
        "statusBar.debuggingBackground": "#ff4b4b",
        "statusBar.noFolderBackground": "#141414",
        "statusBarItem.hoverBackground": "#2a2a2a",
        "tab.activeBackground": "#0d0d0d",
        "tab.activeForeground": "#f5c542",
        "tab.inactiveBackground": "#141414",
        "tab.inactiveForeground": "#777777",
        "tab.border": "#262626",
        "tab.activeBorder": "#ff4b4b",
        "editorGroupHeader.tabsBackground": "#0d0d0d",
        "editor.lineHighlightBackground": "#222222",
        "editor.lineHighlightBorder": "#333333",
        "editor.selectionBackground": "rgba(245,197,66,0.3)",
        "editor.selectionHighlightBackground": "rgba(255,75,75,0.2)",
        "editor.findMatchBackground": "rgba(0,255,255,0.3)",
        "editor.findMatchHighlightBackground": "rgba(255,165,0,0.3)",
        "editorCursor.foreground": "#ff4b4b",
        "editorWhitespace.foreground": "#444444",
        "editorIndentGuide.background": "#333333",
        "editorIndentGuide.activeBackground": "#555555",
        "editorLineNumber.foreground": "#555555",
        "editorLineNumber.activeForeground": "#f5c542",
        "editorBracketMatch.background": "rgba(255,165,0,0.2)",
        "editorBracketMatch.border": "#ff4b4b",
        "terminal.background": "#0d0d0d",
        "terminal.foreground": "#e0e0e0",
        "terminal.ansiBlue": "#4e9aef",
        "terminal.ansiCyan": "#00ffff",
        "terminal.ansiGreen": "#a6e22e",
        "terminal.ansiMagenta": "#ff79c6",
        "terminal.ansiRed": "#ff4b4b",
        "terminal.ansiYellow": "#f5c542",
        "terminal.ansiBrightBlue": "#5fb0ff",
        "terminal.ansiBrightCyan": "#66ffff",
        "terminal.ansiBrightGreen": "#b8e674",
        "terminal.ansiBrightMagenta": "#ff92d0",
        "terminal.ansiBrightRed": "#ff6b6b",
        "terminal.ansiBrightYellow": "#ffde5f",
        "panel.background": "#111111",
        "panel.border": "#262626",
        "panelTitle.activeBorder": "#ff4b4b",
        "panelTitle.activeForeground": "#f5c542",
        "panelTitle.inactiveForeground": "#777777",
        "input.background": "#1a1a1a",
        "input.foreground": "#e0e0e0",
        "input.border": "#333333",
        "input.placeholderForeground": "#777777",
        "inputOption.activeBorder": "#ff4b4b",
        "focusBorder": "#f5c542",
        "dropdown.background": "#1a1a1a",
        "dropdown.border": "#333333",
        "dropdown.foreground": "#e0e0e0",
        "list.activeSelectionBackground": "#2a2a2a",
        "list.activeSelectionForeground": "#f5c542",
        "list.hoverBackground": "#222222",
        "list.focusBackground": "#2a2a2a",
        "list.highlightForeground": "#ff4b4b",
        "button.background": "#ff4b4b",
        "button.foreground": "#ffffff",
        "button.hoverBackground": "#ff6b6b",
        "badge.background": "#ff4b4b",
        "badge.foreground": "#ffffff",
        "scrollbar.shadow": "#000000",
        "scrollbarSlider.background": "rgba(255,197,66,0.3)",
        "scrollbarSlider.hoverBackground": "rgba(255,197,66,0.5)",
        "scrollbarSlider.activeBackground": "rgba(255,197,66,0.7)",
        "gitDecoration.modifiedResourceForeground": "#ffde5f",
        "gitDecoration.deletedResourceForeground": "#ff4b4b",
        "gitDecoration.untrackedResourceForeground": "#a6e22e",
        "gitDecoration.conflictingResourceForeground": "#ff79c6",
        "minimap.background": "#0d0d0d",
        "minimapSlider.background": "rgba(255,197,66,0.4)",
        "minimapSlider.hoverBackground": "rgba(255,197,66,0.6)",
        "minimapSlider.activeBackground": "rgba(255,197,66,0.8)"
    },
    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#777777", "fontStyle": "italic" }
        },
        {
            "name": "Strings",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#ffde5f" }
        },
        {
            "name": "Keywords",
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#ff4b4b", "fontStyle": "bold" }
        },
        {
            "name": "Operators",
            "scope": ["keyword.operator", "punctuation.accessor"],
            "settings": { "foreground": "#ff79c6" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "variable.other"],
            "settings": { "foreground": "#e0e0e0" }
        },
        {
            "name": "Variable Parameters",
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#a6e22e", "fontStyle": "italic" }
        },
        {
            "name": "Functions",
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#4e9aef" }
        },
        {
            "name": "Function Calls",
            "scope": ["meta.function-call"],
            "settings": { "foreground": "#5fb0ff" }
        },
        {
            "name": "Classes",
            "scope": [
                "entity.name.class",
                "entity.name.type.class",
                "support.class"
            ],
            "settings": { "foreground": "#ff6b6b", "fontStyle": "bold" }
        },
        {
            "name": "Types",
            "scope": ["entity.name.type", "support.type"],
            "settings": { "foreground": "#5fb0ff" }
        },
        {
            "name": "Interfaces",
            "scope": ["entity.name.type.interface"],
            "settings": { "foreground": "#ff79c6", "fontStyle": "italic" }
        },
        {
            "name": "Numbers",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#ffde5f" }
        },
        {
            "name": "Constants",
            "scope": ["constant", "constant.language", "constant.character"],
            "settings": { "foreground": "#ff4b4b" }
        },
        {
            "name": "Booleans",
            "scope": ["constant.language.boolean"],
            "settings": { "foreground": "#ff4b4b", "fontStyle": "bold" }
        },
        {
            "name": "Properties",
            "scope": ["variable.other.property", "support.variable.property"],
            "settings": { "foreground": "#a6e22e" }
        },
        {
            "name": "Object Keys",
            "scope": ["meta.object-literal.key"],
            "settings": { "foreground": "#4e9aef" }
        },
        {
            "name": "Tags",
            "scope": ["entity.name.tag", "punctuation.definition.tag"],
            "settings": { "foreground": "#ff4b4b" }
        },
        {
            "name": "Attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#ff79c6", "fontStyle": "italic" }
        },
        {
            "name": "Punctuation",
            "scope": ["punctuation", "meta.brace"],
            "settings": { "foreground": "#e0e0e0" }
        },
        {
            "name": "Regex",
            "scope": ["string.regexp"],
            "settings": { "foreground": "#ff79c6" }
        },
        {
            "name": "Escape Characters",
            "scope": ["constant.character.escape"],
            "settings": { "foreground": "#ffde5f" }
        },
        {
            "name": "Decorators/Annotations",
            "scope": ["meta.decorator", "punctuation.decorator"],
            "settings": { "foreground": "#ff79c6" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": {
                "foreground": "#ff4b4b",
                "fontStyle": "strikethrough"
            }
        },
        {
            "name": "Markdown Headings",
            "scope": ["markup.heading", "entity.name.section"],
            "settings": { "foreground": "#ff4b4b", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Bold",
            "scope": ["markup.bold"],
            "settings": { "foreground": "#ff4b4b", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Italic",
            "scope": ["markup.italic"],
            "settings": { "foreground": "#ff79c6", "fontStyle": "italic" }
        },
        {
            "name": "Markdown Links",
            "scope": ["markup.underline.link"],
            "settings": { "foreground": "#4e9aef" }
        },
        {
            "name": "Markdown Code",
            "scope": ["markup.inline.raw", "markup.fenced_code"],
            "settings": { "foreground": "#ffde5f" }
        },
        {
            "name": "JSON Keys",
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#4e9aef" }
        },
        {
            "name": "CSS Selectors",
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css"
            ],
            "settings": { "foreground": "#ff79c6" }
        },
        {
            "name": "CSS Properties",
            "scope": ["support.type.property-name.css"],
            "settings": { "foreground": "#ff4b4b" }
        },
        {
            "name": "CSS Values",
            "scope": ["support.constant.property-value.css"],
            "settings": { "foreground": "#ffde5f" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
