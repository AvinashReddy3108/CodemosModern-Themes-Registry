{
    "name": "Force",
    "type": "light",
    "description": "Force is a high‑contrast VS Code theme that channels raw, unstoppable energy. It provides a blinding white light version and an abyss‑deep black version, letting you code with the feeling of wielding pure power.",
    "tags": [
        "force",
        "high-contrast",
        "dark",
        "light",
        "productivity",
        "energy",
        "passion",
        "focus",
        "intensity",
        "motivation",
        "power"
    ],
    "semanticHighlighting": true,
    "colors": {
        "editor.background": "#FAFAFA",
        "editor.foreground": "#222222",
        "activityBar.background": "#FFFFFF",
        "activityBar.foreground": "#0066FF",
        "activityBar.activeBorder": "#0066FF",
        "activityBarBadge.background": "#0066FF",
        "activityBarBadge.foreground": "#FAFAFA",
        "sideBar.background": "#F5F5F5",
        "sideBar.foreground": "#333333",
        "sideBarTitle.foreground": "#0066FF",
        "sideBarSectionHeader.background": "#FFFFFF",
        "sideBarSectionHeader.foreground": "#0066FF",
        "titleBar.activeBackground": "#FFFFFF",
        "titleBar.activeForeground": "#222222",
        "titleBar.inactiveBackground": "#F0F0F0",
        "titleBar.inactiveForeground": "#777777",
        "statusBar.background": "#E0E0E0",
        "statusBar.foreground": "#222222",
        "statusBar.debuggingBackground": "#00C853",
        "statusBar.noFolderBackground": "#E0E0E0",
        "statusBarItem.hoverBackground": "#0066FF33",
        "tab.activeBackground": "#E8E8E8",
        "tab.activeForeground": "#0066FF",
        "tab.inactiveBackground": "#FFFFFF",
        "tab.inactiveForeground": "#777777",
        "tab.border": "#CCCCCC",
        "tab.activeBorder": "#0066FF",
        "editorGroupHeader.tabsBackground": "#FFFFFF",
        "editor.lineHighlightBackground": "#0066FF10",
        "editor.lineHighlightBorder": "#0066FF30",
        "editor.selectionBackground": "#0066FF40",
        "editor.selectionHighlightBackground": "#0066FF20",
        "editor.findMatchBackground": "#00C85330",
        "editor.findMatchHighlightBackground": "#00C85315",
        "editorCursor.foreground": "#0066FF",
        "editorWhitespace.foreground": "#CCCCCC",
        "editorIndentGuide.background": "#DDDDDD",
        "editorIndentGuide.activeBackground": "#BBBBBB",
        "editorLineNumber.foreground": "#AAAAAA",
        "editorLineNumber.activeForeground": "#0066FF",
        "editorBracketMatch.background": "#0066FF20",
        "editorBracketMatch.border": "#0066FF",
        "terminal.background": "#FAFAFA",
        "terminal.foreground": "#222222",
        "terminal.ansiBlue": "#0066FF",
        "terminal.ansiCyan": "#00B5D8",
        "terminal.ansiGreen": "#00A86B",
        "terminal.ansiMagenta": "#D500F9",
        "terminal.ansiRed": "#FF3B30",
        "terminal.ansiYellow": "#FFAA00",
        "terminal.ansiBrightBlue": "#3399FF",
        "terminal.ansiBrightCyan": "#33FFFF",
        "terminal.ansiBrightGreen": "#33FF99",
        "terminal.ansiBrightMagenta": "#FF66FF",
        "terminal.ansiBrightRed": "#FF6666",
        "terminal.ansiBrightYellow": "#FFFF66",
        "panel.background": "#FAFAFA",
        "panel.border": "#E0E0E0",
        "panelTitle.activeBorder": "#0066FF",
        "panelTitle.activeForeground": "#0066FF",
        "panelTitle.inactiveForeground": "#777777",
        "input.background": "#F0F0F0",
        "input.foreground": "#222222",
        "input.border": "#0066FF",
        "input.placeholderForeground": "#999999",
        "inputOption.activeBorder": "#0066FF",
        "focusBorder": "#0066FF",
        "dropdown.background": "#F0F0F0",
        "dropdown.border": "#0066FF",
        "dropdown.foreground": "#222222",
        "list.activeSelectionBackground": "#0066FF",
        "list.activeSelectionForeground": "#FFFFFF",
        "list.hoverBackground": "#0066FF20",
        "list.focusBackground": "#0066FF30",
        "list.highlightForeground": "#00C853",
        "button.background": "#0066FF",
        "button.foreground": "#FFFFFF",
        "button.hoverBackground": "#3399FF",
        "badge.background": "#00C853",
        "badge.foreground": "#FAFAFA",
        "scrollbar.shadow": "#00000020",
        "scrollbarSlider.background": "#CCCCCC50",
        "scrollbarSlider.hoverBackground": "#CCCCCC80",
        "scrollbarSlider.activeBackground": "#CCCCCCB0",
        "gitDecoration.modifiedResourceForeground": "#0066FF",
        "gitDecoration.deletedResourceForeground": "#FF3B30",
        "gitDecoration.untrackedResourceForeground": "#00C853",
        "gitDecoration.conflictingResourceForeground": "#FFAA00",
        "minimap.background": "#FAFAFA",
        "minimapSlider.background": "#0066FF22",
        "minimapSlider.hoverBackground": "#0066FF44",
        "minimapSlider.activeBackground": "#0066FF66"
    },
    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#6A6A6A", "fontStyle": "italic" }
        },
        {
            "name": "Strings",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#00875A" }
        },
        {
            "name": "Keywords",
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#0066FF", "fontStyle": "bold" }
        },
        {
            "name": "Operators",
            "scope": ["keyword.operator", "punctuation.accessor"],
            "settings": { "foreground": "#0066FF" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "variable.other"],
            "settings": { "foreground": "#222222" }
        },
        {
            "name": "Variable Parameters",
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#00C853", "fontStyle": "italic" }
        },
        {
            "name": "Functions",
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#0066FF" }
        },
        {
            "name": "Function Calls",
            "scope": ["meta.function-call"],
            "settings": { "foreground": "#00C853" }
        },
        {
            "name": "Classes",
            "scope": [
                "entity.name.class",
                "entity.name.type.class",
                "support.class"
            ],
            "settings": { "foreground": "#0066FF", "fontStyle": "bold" }
        },
        {
            "name": "Types",
            "scope": ["entity.name.type", "support.type"],
            "settings": { "foreground": "#0066FF" }
        },
        {
            "name": "Interfaces",
            "scope": ["entity.name.type.interface"],
            "settings": { "foreground": "#00C853", "fontStyle": "italic" }
        },
        {
            "name": "Numbers",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#FFAA00" }
        },
        {
            "name": "Constants",
            "scope": ["constant", "constant.language", "constant.character"],
            "settings": { "foreground": "#FFAA00" }
        },
        {
            "name": "Booleans",
            "scope": ["constant.language.boolean"],
            "settings": { "foreground": "#FFAA00", "fontStyle": "bold" }
        },
        {
            "name": "Properties",
            "scope": ["variable.other.property", "support.variable.property"],
            "settings": { "foreground": "#222222" }
        },
        {
            "name": "Object Keys",
            "scope": ["meta.object-literal.key"],
            "settings": { "foreground": "#222222" }
        },
        {
            "name": "Tags",
            "scope": ["entity.name.tag", "punctuation.definition.tag"],
            "settings": { "foreground": "#0066FF" }
        },
        {
            "name": "Attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#D500F9", "fontStyle": "italic" }
        },
        {
            "name": "Punctuation",
            "scope": ["punctuation", "meta.brace"],
            "settings": { "foreground": "#222222" }
        },
        {
            "name": "Regex",
            "scope": ["string.regexp"],
            "settings": { "foreground": "#FF3B30" }
        },
        {
            "name": "Escape Characters",
            "scope": ["constant.character.escape"],
            "settings": { "foreground": "#FF3B30" }
        },
        {
            "name": "Decorators/Annotations",
            "scope": ["meta.decorator", "punctuation.decorator"],
            "settings": { "foreground": "#D500F9" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": {
                "foreground": "#FF3B30",
                "fontStyle": "strikethrough"
            }
        },
        {
            "name": "Markdown Headings",
            "scope": ["markup.heading", "entity.name.section"],
            "settings": { "foreground": "#0066FF", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Bold",
            "scope": ["markup.bold"],
            "settings": { "foreground": "#00C853", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Italic",
            "scope": ["markup.italic"],
            "settings": { "foreground": "#D500F9", "fontStyle": "italic" }
        },
        {
            "name": "Markdown Links",
            "scope": ["markup.underline.link"],
            "settings": { "foreground": "#3399FF" }
        },
        {
            "name": "Markdown Code",
            "scope": ["markup.inline.raw", "markup.fenced_code"],
            "settings": { "foreground": "#00875A" }
        },
        {
            "name": "JSON Keys",
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#0066FF" }
        },
        {
            "name": "CSS Selectors",
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css"
            ],
            "settings": { "foreground": "#D500F9" }
        },
        {
            "name": "CSS Properties",
            "scope": ["support.type.property-name.css"],
            "settings": { "foreground": "#00C853" }
        },
        {
            "name": "CSS Values",
            "scope": ["support.constant.property-value.css"],
            "settings": { "foreground": "#FFAA00" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
