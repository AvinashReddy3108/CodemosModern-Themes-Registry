{
    "name": "Fenrir",
    "type": "both",
    "description": "A dual‑tone VS Code theme that shifts from icy bone‑white daylight to the abyssal black of a wolf’s night, threaded with fierce rage‑red accents.",
    "tags": [
        "fenrir",
        "wolf",
        "dark",
        "light",
        "red",
        "vscode",
        "theme",
        "programming",
        "snow",
        "night"
    ],
    "semanticHighlighting": true,
    "colors": {
        "editor.background": "#FAFCFF",
        "editor.foreground": "#2B3A4F",
        "activityBar.background": "#E8F0FF",
        "activityBar.foreground": "#6B8FAE",
        "activityBar.activeBorder": "#C94141",
        "activityBarBadge.background": "#C94141",
        "activityBarBadge.foreground": "#FAFCFF",
        "sideBar.background": "#F2F7FF",
        "sideBar.foreground": "#2B3A4F",
        "sideBarTitle.foreground": "#6B8FAE",
        "sideBarSectionHeader.background": "#DCE8FF",
        "sideBarSectionHeader.foreground": "#6B8FAE",
        "titleBar.activeBackground": "#E0EDFF",
        "titleBar.activeForeground": "#2B3A4F",
        "titleBar.inactiveBackground": "#E8F0FF",
        "titleBar.inactiveForeground": "#8A99AE",
        "statusBar.background": "#6B8FAE",
        "statusBar.foreground": "#FAFCFF",
        "statusBar.debuggingBackground": "#C94141",
        "statusBar.noFolderBackground": "#C3D1E0",
        "statusBarItem.hoverBackground": "#C9414166",
        "tab.activeBackground": "#FAFCFF",
        "tab.activeForeground": "#2B3A4F",
        "tab.inactiveBackground": "#F2F7FF",
        "tab.inactiveForeground": "#8A99AE",
        "tab.border": "#C3D1E0",
        "tab.activeBorder": "#C94141",
        "editorGroupHeader.tabsBackground": "#FAFCFF",
        "editor.lineHighlightBackground": "#6B8FAE20",
        "editor.lineHighlightBorder": "#6B8FAE80",
        "editor.selectionBackground": "#C9414166",
        "editor.selectionHighlightBackground": "#C9414133",
        "editor.findMatchBackground": "#6B8FAE66",
        "editor.findMatchHighlightBackground": "#6B8FAE33",
        "editorCursor.foreground": "#C94141",
        "editorWhitespace.foreground": "#C3D1E0",
        "editorIndentGuide.background": "#C3D1E0",
        "editorIndentGuide.activeBackground": "#6B8FAE",
        "editorLineNumber.foreground": "#8A99AE",
        "editorLineNumber.activeForeground": "#C94141",
        "editorBracketMatch.background": "#6B8FAE33",
        "editorBracketMatch.border": "#6B8FAE",
        "terminal.background": "#FAFCFF",
        "terminal.foreground": "#2B3A4F",
        "terminal.ansiBlue": "#6B8FAE",
        "terminal.ansiCyan": "#3AAFA9",
        "terminal.ansiGreen": "#3A9D71",
        "terminal.ansiMagenta": "#C94141",
        "terminal.ansiRed": "#C94F4F",
        "terminal.ansiYellow": "#D9A44A",
        "terminal.ansiBrightBlue": "#A3C2FF",
        "terminal.ansiBrightCyan": "#5FD4D3",
        "terminal.ansiBrightGreen": "#4FCB7F",
        "terminal.ansiBrightMagenta": "#D96B6B",
        "terminal.ansiBrightRed": "#E46666",
        "terminal.ansiBrightYellow": "#EFC469",
        "panel.background": "#FAFCFF",
        "panel.border": "#6B8FAE",
        "panelTitle.activeBorder": "#C94141",
        "panelTitle.activeForeground": "#2B3A4F",
        "panelTitle.inactiveForeground": "#8A99AE",
        "input.background": "#FFFFFF",
        "input.foreground": "#2B3A4F",
        "input.border": "#6B8FAE",
        "input.placeholderForeground": "#A0A8B5",
        "inputOption.activeBorder": "#C94141",
        "focusBorder": "#C94141",
        "dropdown.background": "#FFFFFF",
        "dropdown.border": "#6B8FAE",
        "dropdown.foreground": "#2B3A4F",
        "list.activeSelectionBackground": "#6B8FAE33",
        "list.activeSelectionForeground": "#FAFCFF",
        "list.hoverBackground": "#6B8FAE1A",
        "list.focusBackground": "#6B8FAE33",
        "list.highlightForeground": "#C94141",
        "button.background": "#C94141",
        "button.foreground": "#FAFCFF",
        "button.hoverBackground": "#C94141CC",
        "badge.background": "#C94141",
        "badge.foreground": "#FAFCFF",
        "scrollbar.shadow": "#00000044",
        "scrollbarSlider.background": "#8A99AE66",
        "scrollbarSlider.hoverBackground": "#8A99AE99",
        "scrollbarSlider.activeBackground": "#8A99AECC",
        "gitDecoration.modifiedResourceForeground": "#6B8FAE",
        "gitDecoration.deletedResourceForeground": "#C94F4F",
        "gitDecoration.untrackedResourceForeground": "#3A9D71",
        "gitDecoration.conflictingResourceForeground": "#D9A44A",
        "minimap.background": "#FAFCFF",
        "minimapSlider.background": "#6B8FAE22",
        "minimapSlider.hoverBackground": "#6B8FAE33",
        "minimapSlider.activeBackground": "#6B8FAE44"
    },
    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#A0A8B5", "fontStyle": "italic" }
        },
        {
            "name": "Strings",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#3A9D71" }
        },
        {
            "name": "Keywords",
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#C94141", "fontStyle": "bold" }
        },
        {
            "name": "Operators",
            "scope": ["keyword.operator", "punctuation.accessor"],
            "settings": { "foreground": "#6B8FAE" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "variable.other"],
            "settings": { "foreground": "#2B3A4F" }
        },
        {
            "name": "Variable Parameters",
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#6B8FAE", "fontStyle": "italic" }
        },
        {
            "name": "Functions",
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#C94141" }
        },
        {
            "name": "Function Calls",
            "scope": ["meta.function-call"],
            "settings": { "foreground": "#6B8FAE" }
        },
        {
            "name": "Classes",
            "scope": [
                "entity.name.class",
                "entity.name.type.class",
                "support.class"
            ],
            "settings": { "foreground": "#6B8FAE", "fontStyle": "bold" }
        },
        {
            "name": "Types",
            "scope": ["entity.name.type", "support.type"],
            "settings": { "foreground": "#6B8FAE" }
        },
        {
            "name": "Interfaces",
            "scope": ["entity.name.type.interface"],
            "settings": { "foreground": "#3A9D71", "fontStyle": "italic" }
        },
        {
            "name": "Numbers",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#C94F4F" }
        },
        {
            "name": "Constants",
            "scope": ["constant", "constant.language", "constant.character"],
            "settings": { "foreground": "#C94141" }
        },
        {
            "name": "Booleans",
            "scope": ["constant.language.boolean"],
            "settings": { "foreground": "#C94141", "fontStyle": "bold" }
        },
        {
            "name": "Properties",
            "scope": ["variable.other.property", "support.variable.property"],
            "settings": { "foreground": "#3A9D71" }
        },
        {
            "name": "Object Keys",
            "scope": ["meta.object-literal.key"],
            "settings": { "foreground": "#6B8FAE" }
        },
        {
            "name": "Tags",
            "scope": ["entity.name.tag", "punctuation.definition.tag"],
            "settings": { "foreground": "#C94141" }
        },
        {
            "name": "Attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#6B8FAE", "fontStyle": "italic" }
        },
        {
            "name": "Punctuation",
            "scope": ["punctuation", "meta.brace"],
            "settings": { "foreground": "#2B3A4F" }
        },
        {
            "name": "Regex",
            "scope": ["string.regexp"],
            "settings": { "foreground": "#C94F4F" }
        },
        {
            "name": "Escape Characters",
            "scope": ["constant.character.escape"],
            "settings": { "foreground": "#C94141" }
        },
        {
            "name": "Decorators/Annotations",
            "scope": ["meta.decorator", "punctuation.decorator"],
            "settings": { "foreground": "#D9A44A" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": {
                "foreground": "#C94F4F",
                "fontStyle": "strikethrough"
            }
        },
        {
            "name": "Markdown Headings",
            "scope": ["markup.heading", "entity.name.section"],
            "settings": { "foreground": "#C94141", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Bold",
            "scope": ["markup.bold"],
            "settings": { "foreground": "#C94141", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Italic",
            "scope": ["markup.italic"],
            "settings": { "foreground": "#6B8FAE", "fontStyle": "italic" }
        },
        {
            "name": "Markdown Links",
            "scope": ["markup.underline.link"],
            "settings": { "foreground": "#6B8FAE" }
        },
        {
            "name": "Markdown Code",
            "scope": ["markup.inline.raw", "markup.fenced_code"],
            "settings": { "foreground": "#3A9D71" }
        },
        {
            "name": "JSON Keys",
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#6B8FAE" }
        },
        {
            "name": "CSS Selectors",
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css"
            ],
            "settings": { "foreground": "#C94141" }
        },
        {
            "name": "CSS Properties",
            "scope": ["support.type.property-name.css"],
            "settings": { "foreground": "#3A9D71" }
        },
        {
            "name": "CSS Values",
            "scope": ["support.constant.property-value.css"],
            "settings": { "foreground": "#6B8FAE" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
