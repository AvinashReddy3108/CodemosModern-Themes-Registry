{
    "name": "Defiance",
    "type": "light",
    "description": "A light theme inspired by the iconic black‑and‑white image of Tank Man, using stark neutrals, muted grays and a bold red accent that recalls the protest and the Chinese flag.",
    "tags": ["history", "protest", "china", "photography", "light"],
    "semanticHighlighting": true,
    "colors": {
        "editor.background": "#FAFAFA",
        "editor.foreground": "#212121",
        "activityBar.background": "#FFFFFF",
        "activityBar.foreground": "#212121",
        "activityBar.activeBorder": "#D32F2F",
        "activityBarBadge.background": "#D32F2F",
        "activityBarBadge.foreground": "#FFFFFF",
        "sideBar.background": "#F0F0F0",
        "sideBar.foreground": "#212121",
        "sideBarTitle.foreground": "#212121",
        "sideBarSectionHeader.background": "#E8E8E8",
        "sideBarSectionHeader.foreground": "#212121",
        "titleBar.activeBackground": "#FFFFFF",
        "titleBar.activeForeground": "#212121",
        "titleBar.inactiveBackground": "#EEEEEE",
        "titleBar.inactiveForeground": "#777777",
        "statusBar.background": "#D32F2F",
        "statusBar.foreground": "#FFFFFF",
        "statusBar.debuggingBackground": "#E53935",
        "statusBar.noFolderBackground": "#757575",
        "statusBarItem.hoverBackground": "#C62828",
        "tab.activeBackground": "#FFFFFF",
        "tab.activeForeground": "#212121",
        "tab.inactiveBackground": "#F5F5F5",
        "tab.inactiveForeground": "#777777",
        "tab.border": "#E0E0E0",
        "tab.activeBorder": "#D32F2F",
        "editorGroupHeader.tabsBackground": "#FAFAFA",
        "editor.lineHighlightBackground": "#FFF9C4",
        "editor.lineHighlightBorder": "#FFD54F",
        "editor.selectionBackground": "#BBDEFB",
        "editor.selectionHighlightBackground": "#90CAF9",
        "editor.findMatchBackground": "#FFE082",
        "editor.findMatchHighlightBackground": "#FFCC80",
        "editorCursor.foreground": "#D32F2F",
        "editorWhitespace.foreground": "#BDBDBD",
        "editorIndentGuide.background": "#E0E0E0",
        "editorIndentGuide.activeBackground": "#B0BEC5",
        "editorLineNumber.foreground": "#9E9E9E",
        "editorLineNumber.activeForeground": "#212121",
        "editorBracketMatch.background": "#C8E6C9",
        "editorBracketMatch.border": "#81C784",
        "terminal.background": "#FAFAFA",
        "terminal.foreground": "#212121",
        "terminal.ansiBlue": "#0366D6",
        "terminal.ansiCyan": "#39C5BB",
        "terminal.ansiGreen": "#28A745",
        "terminal.ansiMagenta": "#D63384",
        "terminal.ansiRed": "#D32F2F",
        "terminal.ansiYellow": "#E6A23C",
        "terminal.ansiBrightBlue": "#5393FF",
        "terminal.ansiBrightCyan": "#7FFFFF",
        "terminal.ansiBrightGreen": "#66D966",
        "terminal.ansiBrightMagenta": "#FF79C6",
        "terminal.ansiBrightRed": "#FF6F61",
        "terminal.ansiBrightYellow": "#FFDF57",
        "panel.background": "#F5F5F5",
        "panel.border": "#E0E0E0",
        "panelTitle.activeBorder": "#D32F2F",
        "panelTitle.activeForeground": "#212121",
        "panelTitle.inactiveForeground": "#777777",
        "input.background": "#FFFFFF",
        "input.foreground": "#212121",
        "input.border": "#CCCCCC",
        "input.placeholderForeground": "#9E9E9E",
        "inputOption.activeBorder": "#D32F2F",
        "focusBorder": "#D32F2F",
        "dropdown.background": "#FFFFFF",
        "dropdown.border": "#CCCCCC",
        "dropdown.foreground": "#212121",
        "list.activeSelectionBackground": "#BBDEFB",
        "list.activeSelectionForeground": "#212121",
        "list.hoverBackground": "#E3F2FD",
        "list.focusBackground": "#90CAF9",
        "list.highlightForeground": "#D32F2F",
        "button.background": "#D32F2F",
        "button.foreground": "#FFFFFF",
        "button.hoverBackground": "#C62828",
        "badge.background": "#D32F2F",
        "badge.foreground": "#FFFFFF",
        "scrollbar.shadow": "#BDBDBD",
        "scrollbarSlider.background": "rgba(0,0,0,0.2)",
        "scrollbarSlider.hoverBackground": "rgba(0,0,0,0.3)",
        "scrollbarSlider.activeBackground": "rgba(0,0,0,0.4)",
        "gitDecoration.modifiedResourceForeground": "#005CC5",
        "gitDecoration.deletedResourceForeground": "#D32F2F",
        "gitDecoration.untrackedResourceForeground": "#28A745",
        "gitDecoration.conflictingResourceForeground": "#FF9900",
        "minimap.background": "#F5F5F5",
        "minimapSlider.background": "rgba(0,0,0,0.2)",
        "minimapSlider.hoverBackground": "rgba(0,0,0,0.3)",
        "minimapSlider.activeBackground": "rgba(0,0,0,0.4)"
    },
    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#6A737D", "fontStyle": "italic" }
        },
        {
            "name": "Strings",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#22863A" }
        },
        {
            "name": "Keywords",
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#D32F2F", "fontStyle": "bold" }
        },
        {
            "name": "Operators",
            "scope": ["keyword.operator", "punctuation.accessor"],
            "settings": { "foreground": "#C62828" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "variable.other"],
            "settings": { "foreground": "#005C5C" }
        },
        {
            "name": "Variable Parameters",
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#005C5C", "fontStyle": "italic" }
        },
        {
            "name": "Functions",
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#0366D6" }
        },
        {
            "name": "Function Calls",
            "scope": ["meta.function-call"],
            "settings": { "foreground": "#0366D6" }
        },
        {
            "name": "Classes",
            "scope": [
                "entity.name.class",
                "entity.name.type.class",
                "support.class"
            ],
            "settings": { "foreground": "#6F42C1", "fontStyle": "bold" }
        },
        {
            "name": "Types",
            "scope": ["entity.name.type", "support.type"],
            "settings": { "foreground": "#D15704" }
        },
        {
            "name": "Interfaces",
            "scope": ["entity.name.type.interface"],
            "settings": { "foreground": "#005C5C", "fontStyle": "italic" }
        },
        {
            "name": "Numbers",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#005CC5" }
        },
        {
            "name": "Constants",
            "scope": ["constant", "constant.language", "constant.character"],
            "settings": { "foreground": "#5A0FC8" }
        },
        {
            "name": "Booleans",
            "scope": ["constant.language.boolean"],
            "settings": { "foreground": "#D32F2F", "fontStyle": "bold" }
        },
        {
            "name": "Properties",
            "scope": ["variable.other.property", "support.variable.property"],
            "settings": { "foreground": "#39C5BB" }
        },
        {
            "name": "Object Keys",
            "scope": ["meta.object-literal.key"],
            "settings": { "foreground": "#005C5C" }
        },
        {
            "name": "Tags",
            "scope": ["entity.name.tag", "punctuation.definition.tag"],
            "settings": { "foreground": "#D32F2F" }
        },
        {
            "name": "Attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#005C5C", "fontStyle": "italic" }
        },
        {
            "name": "Punctuation",
            "scope": ["punctuation", "meta.brace"],
            "settings": { "foreground": "#9E9E9E" }
        },
        {
            "name": "Regex",
            "scope": ["string.regexp"],
            "settings": { "foreground": "#28A745" }
        },
        {
            "name": "Escape Characters",
            "scope": ["constant.character.escape"],
            "settings": { "foreground": "#D63384" }
        },
        {
            "name": "Decorators/Annotations",
            "scope": ["meta.decorator", "punctuation.decorator"],
            "settings": { "foreground": "#FF9800" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": {
                "foreground": "#FF5370",
                "fontStyle": "strikethrough"
            }
        },
        {
            "name": "Markdown Headings",
            "scope": ["markup.heading", "entity.name.section"],
            "settings": { "foreground": "#0366D6", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Bold",
            "scope": ["markup.bold"],
            "settings": { "foreground": "#0366D6", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Italic",
            "scope": ["markup.italic"],
            "settings": { "foreground": "#6A737D", "fontStyle": "italic" }
        },
        {
            "name": "Markdown Links",
            "scope": ["markup.underline.link"],
            "settings": { "foreground": "#39C5BB" }
        },
        {
            "name": "Markdown Code",
            "scope": ["markup.inline.raw", "markup.fenced_code"],
            "settings": { "foreground": "#9E9E9E" }
        },
        {
            "name": "JSON Keys",
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#6F42C1" }
        },
        {
            "name": "CSS Selectors",
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css"
            ],
            "settings": { "foreground": "#6F42C1" }
        },
        {
            "name": "CSS Properties",
            "scope": ["support.type.property-name.css"],
            "settings": { "foreground": "#005C5C" }
        },
        {
            "name": "CSS Values",
            "scope": ["support.constant.property-value.css"],
            "settings": { "foreground": "#D15704" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
