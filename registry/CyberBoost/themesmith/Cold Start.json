{
    "name": "Cold Start",
    "type": "light",
    "description": "A theme that captures the hushed moment before a machine powers up, with frosty whites and LED blue highlights.",
    "tags": [
        "cold",
        "boot",
        "frost",
        "blue",
        "minimal",
        "dark",
        "light",
        "tech",
        "emotion",
        "serene",
        "quiet"
    ],
    "semanticHighlighting": true,
    "colors": {
        "editor.background": "#F0F9FF",
        "editor.foreground": "#1E2A38",
        "activityBar.background": "#E3F2F9",
        "activityBar.foreground": "#0099CC",
        "activityBar.activeBorder": "#0099CC",
        "activityBarBadge.background": "#0099CC",
        "activityBarBadge.foreground": "#F0F9FF",
        "sideBar.background": "#E8F5FF",
        "sideBar.foreground": "#1E2A38",
        "sideBarTitle.foreground": "#0099CC",
        "sideBarSectionHeader.background": "#DCEFFB",
        "sideBarSectionHeader.foreground": "#0099CC",
        "titleBar.activeBackground": "#D4ECF5",
        "titleBar.activeForeground": "#1E2A38",
        "titleBar.inactiveBackground": "#E3F2F9",
        "titleBar.inactiveForeground": "#6A7B8C",
        "statusBar.background": "#0099CC",
        "statusBar.foreground": "#F0F9FF",
        "statusBar.debuggingBackground": "#5AAE70",
        "statusBar.noFolderBackground": "#6A7B8C",
        "statusBarItem.hoverBackground": "#0099CC80",
        "tab.activeBackground": "#FFFFFF",
        "tab.activeForeground": "#1E2A38",
        "tab.inactiveBackground": "#E8F5FF",
        "tab.inactiveForeground": "#6A7B8C",
        "tab.border": "#B0D3E6",
        "tab.activeBorder": "#0099CC",
        "editorGroupHeader.tabsBackground": "#E8F5FF",
        "editor.lineHighlightBackground": "#0099CC20",
        "editor.lineHighlightBorder": "#0099CC80",
        "editor.selectionBackground": "#0099CC40",
        "editor.selectionHighlightBackground": "#0099CCF0",
        "editor.findMatchBackground": "#0099CC55",
        "editor.findMatchHighlightBackground": "#0099CC33",
        "editorCursor.foreground": "#0099CC",
        "editorWhitespace.foreground": "#C0C0C0",
        "editorIndentGuide.background": "#D0D0D0",
        "editorIndentGuide.activeBackground": "#6A7B8C",
        "editorLineNumber.foreground": "#6A7B8C",
        "editorLineNumber.activeForeground": "#0099CC",
        "editorBracketMatch.background": "#0099CC22",
        "editorBracketMatch.border": "#0099CC88",
        "terminal.background": "#F0F9FF",
        "terminal.foreground": "#1E2A38",
        "terminal.ansiBlue": "#0066CC",
        "terminal.ansiCyan": "#0099CC",
        "terminal.ansiGreen": "#5AAE70",
        "terminal.ansiMagenta": "#C580FF",
        "terminal.ansiRed": "#FF5F5F",
        "terminal.ansiYellow": "#FFC800",
        "terminal.ansiBrightBlue": "#3388FF",
        "terminal.ansiBrightCyan": "#66D9FF",
        "terminal.ansiBrightGreen": "#6CFFB4",
        "terminal.ansiBrightMagenta": "#E0A7FF",
        "terminal.ansiBrightRed": "#FF8A8A",
        "terminal.ansiBrightYellow": "#FFE580",
        "panel.background": "#F0F9FF",
        "panel.border": "#6A7B8C",
        "panelTitle.activeBorder": "#0099CC",
        "panelTitle.activeForeground": "#0099CC",
        "panelTitle.inactiveForeground": "#6A7B8C",
        "input.background": "#E8F5FF",
        "input.foreground": "#1E2A38",
        "input.border": "#6A7B8C",
        "input.placeholderForeground": "#A8A8A8",
        "inputOption.activeBorder": "#0099CC",
        "focusBorder": "#0099CC",
        "dropdown.background": "#E8F5FF",
        "dropdown.border": "#6A7B8C",
        "dropdown.foreground": "#1E2A38",
        "list.activeSelectionBackground": "#0099CC",
        "list.activeSelectionForeground": "#F0F9FF",
        "list.hoverBackground": "#0099CC20",
        "list.focusBackground": "#0099CC30",
        "list.highlightForeground": "#0099CC",
        "button.background": "#0099CC",
        "button.foreground": "#F0F9FF",
        "button.hoverBackground": "#0099CC80",
        "badge.background": "#0099CC",
        "badge.foreground": "#F0F9FF",
        "scrollbar.shadow": "#00000044",
        "scrollbarSlider.background": "#6A7B8C44",
        "scrollbarSlider.hoverBackground": "#6A7B8C88",
        "scrollbarSlider.activeBackground": "#0099CC88",
        "gitDecoration.modifiedResourceForeground": "#0099CC",
        "gitDecoration.deletedResourceForeground": "#FF5F5F",
        "gitDecoration.untrackedResourceForeground": "#5AAE70",
        "gitDecoration.conflictingResourceForeground": "#FFC800",
        "minimap.background": "#F0F9FF",
        "minimapSlider.background": "#0099CC22",
        "minimapSlider.hoverBackground": "#0099CC44",
        "minimapSlider.activeBackground": "#0099CC66"
    },
    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#A0A0A0", "fontStyle": "italic" }
        },
        {
            "name": "Strings",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#3C9F74" }
        },
        {
            "name": "Keywords",
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#0099CC", "fontStyle": "bold" }
        },
        {
            "name": "Operators",
            "scope": ["keyword.operator", "punctuation.accessor"],
            "settings": { "foreground": "#0099CC" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "variable.other"],
            "settings": { "foreground": "#1E2A38" }
        },
        {
            "name": "Variable Parameters",
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#6A7B8C", "fontStyle": "italic" }
        },
        {
            "name": "Functions",
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#5AAE70" }
        },
        {
            "name": "Function Calls",
            "scope": ["meta.function-call"],
            "settings": { "foreground": "#0099CC" }
        },
        {
            "name": "Classes",
            "scope": [
                "entity.name.class",
                "entity.name.type.class",
                "support.class"
            ],
            "settings": { "foreground": "#0099CC", "fontStyle": "bold" }
        },
        {
            "name": "Types",
            "scope": ["entity.name.type", "support.type"],
            "settings": { "foreground": "#6A7B8C" }
        },
        {
            "name": "Interfaces",
            "scope": ["entity.name.type.interface"],
            "settings": { "foreground": "#6A7B8C", "fontStyle": "italic" }
        },
        {
            "name": "Numbers",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#5AAE70" }
        },
        {
            "name": "Constants",
            "scope": ["constant", "constant.language", "constant.character"],
            "settings": { "foreground": "#0099CC" }
        },
        {
            "name": "Booleans",
            "scope": ["constant.language.boolean"],
            "settings": { "foreground": "#0099CC", "fontStyle": "bold" }
        },
        {
            "name": "Properties",
            "scope": ["variable.other.property", "support.variable.property"],
            "settings": { "foreground": "#0099CC" }
        },
        {
            "name": "Object Keys",
            "scope": ["meta.object-literal.key"],
            "settings": { "foreground": "#0099CC" }
        },
        {
            "name": "Tags",
            "scope": ["entity.name.tag", "punctuation.definition.tag"],
            "settings": { "foreground": "#0099CC" }
        },
        {
            "name": "Attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#5AAE70", "fontStyle": "italic" }
        },
        {
            "name": "Punctuation",
            "scope": ["punctuation", "meta.brace"],
            "settings": { "foreground": "#1E2A38" }
        },
        {
            "name": "Regex",
            "scope": ["string.regexp"],
            "settings": { "foreground": "#5AAE70" }
        },
        {
            "name": "Escape Characters",
            "scope": ["constant.character.escape"],
            "settings": { "foreground": "#5AAE70" }
        },
        {
            "name": "Decorators/Annotations",
            "scope": ["meta.decorator", "punctuation.decorator"],
            "settings": { "foreground": "#6A7B8C" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": {
                "foreground": "#FF5F5F",
                "fontStyle": "strikethrough"
            }
        },
        {
            "name": "Markdown Headings",
            "scope": ["markup.heading", "entity.name.section"],
            "settings": { "foreground": "#0099CC", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Bold",
            "scope": ["markup.bold"],
            "settings": { "foreground": "#0099CC", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Italic",
            "scope": ["markup.italic"],
            "settings": { "foreground": "#6A7B8C", "fontStyle": "italic" }
        },
        {
            "name": "Markdown Links",
            "scope": ["markup.underline.link"],
            "settings": { "foreground": "#0099CC" }
        },
        {
            "name": "Markdown Code",
            "scope": ["markup.inline.raw", "markup.fenced_code"],
            "settings": { "foreground": "#5AAE70" }
        },
        {
            "name": "JSON Keys",
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#0099CC" }
        },
        {
            "name": "CSS Selectors",
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css"
            ],
            "settings": { "foreground": "#6A7B8C" }
        },
        {
            "name": "CSS Properties",
            "scope": ["support.type.property-name.css"],
            "settings": { "foreground": "#0099CC" }
        },
        {
            "name": "CSS Values",
            "scope": ["support.constant.property-value.css"],
            "settings": { "foreground": "#5AAE70" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
