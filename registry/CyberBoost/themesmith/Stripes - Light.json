{
    "name": "Stripes",
    "type": "light",
    "description": "A light theme inspired by Adidas' iconic three‑stripe silhouette, using crisp whites, bold blacks and energetic accent hues.",
    "tags": ["adidas", "sports", "light", "stripes", "brand"],
    "semanticHighlighting": true,
    "colors": {
        "editor.background": "#FFFFFF",
        "editor.foreground": "#212121",
        "activityBar.background": "#FFFFFF",
        "activityBar.foreground": "#212121",
        "activityBar.activeBorder": "#000000",
        "activityBarBadge.background": "#000000",
        "activityBarBadge.foreground": "#FFFFFF",
        "sideBar.background": "#FAFAFA",
        "sideBar.foreground": "#212121",
        "sideBarTitle.foreground": "#212121",
        "sideBarSectionHeader.background": "#E0E0E0",
        "sideBarSectionHeader.foreground": "#212121",
        "titleBar.activeBackground": "#FFFFFF",
        "titleBar.activeForeground": "#212121",
        "titleBar.inactiveBackground": "#F0F0F0",
        "titleBar.inactiveForeground": "#757575",
        "statusBar.background": "#000000",
        "statusBar.foreground": "#FFFFFF",
        "statusBar.debuggingBackground": "#D32F2F",
        "statusBar.noFolderBackground": "#757575",
        "statusBarItem.hoverBackground": "#424242",
        "tab.activeBackground": "#FFFFFF",
        "tab.activeForeground": "#212121",
        "tab.inactiveBackground": "#F5F5F5",
        "tab.inactiveForeground": "#9E9E9E",
        "tab.border": "#E0E0E0",
        "tab.activeBorder": "#000000",
        "editorGroupHeader.tabsBackground": "#F5F5F5",
        "editor.lineHighlightBackground": "#EEEEEE",
        "editor.lineHighlightBorder": "#CCCCCC",
        "editor.selectionBackground": "#B3E5FC",
        "editor.selectionHighlightBackground": "#81D4FA",
        "editor.findMatchBackground": "#FFEB3B",
        "editor.findMatchHighlightBackground": "#FFF176",
        "editorCursor.foreground": "#000000",
        "editorWhitespace.foreground": "#BDBDBD",
        "editorIndentGuide.background": "#E0E0E0",
        "editorIndentGuide.activeBackground": "#9E9E9E",
        "editorLineNumber.foreground": "#9E9E9E",
        "editorLineNumber.activeForeground": "#212121",
        "editorBracketMatch.background": "#C8E6C9",
        "editorBracketMatch.border": "#66BB6A",
        "terminal.background": "#FFFFFF",
        "terminal.foreground": "#212121",
        "terminal.ansiBlue": "#2196F3",
        "terminal.ansiCyan": "#00BCD4",
        "terminal.ansiGreen": "#4CAF50",
        "terminal.ansiMagenta": "#E91E63",
        "terminal.ansiRed": "#F44336",
        "terminal.ansiYellow": "#FFEB3B",
        "terminal.ansiBrightBlue": "#64B5F6",
        "terminal.ansiBrightCyan": "#26C6DA",
        "terminal.ansiBrightGreen": "#81C784",
        "terminal.ansiBrightMagenta": "#EC407A",
        "terminal.ansiBrightRed": "#EF5350",
        "terminal.ansiBrightYellow": "#FFF176",
        "panel.background": "#FAFAFA",
        "panel.border": "#E0E0E0",
        "panelTitle.activeBorder": "#000000",
        "panelTitle.activeForeground": "#212121",
        "panelTitle.inactiveForeground": "#757575",
        "input.background": "#FFFFFF",
        "input.foreground": "#212121",
        "input.border": "#BDBDBD",
        "input.placeholderForeground": "#9E9E9E",
        "inputOption.activeBorder": "#000000",
        "focusBorder": "#2196F3",
        "dropdown.background": "#FFFFFF",
        "dropdown.border": "#BDBDBD",
        "dropdown.foreground": "#212121",
        "list.activeSelectionBackground": "#B3E5FC",
        "list.activeSelectionForeground": "#212121",
        "list.hoverBackground": "#E3F2FD",
        "list.focusBackground": "#90CAF9",
        "list.highlightForeground": "#000000",
        "button.background": "#000000",
        "button.foreground": "#FFFFFF",
        "button.hoverBackground": "#424242",
        "badge.background": "#000000",
        "badge.foreground": "#FFFFFF",
        "scrollbar.shadow": "#BDBDBD",
        "scrollbarSlider.background": "#E0E0E0",
        "scrollbarSlider.hoverBackground": "#B0BEC5",
        "scrollbarSlider.activeBackground": "#90A4AE",
        "gitDecoration.modifiedResourceForeground": "#FF9800",
        "gitDecoration.deletedResourceForeground": "#F44336",
        "gitDecoration.untrackedResourceForeground": "#4CAF50",
        "gitDecoration.conflictingResourceForeground": "#E91E63",
        "minimap.background": "#FFFFFF",
        "minimapSlider.background": "#B0BEC5",
        "minimapSlider.hoverBackground": "#90A4AE",
        "minimapSlider.activeBackground": "#78909C"
    },
    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#9E9E9E", "fontStyle": "italic" }
        },
        {
            "name": "Strings",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#388E3C" }
        },
        {
            "name": "Keywords",
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#1976D2", "fontStyle": "bold" }
        },
        {
            "name": "Operators",
            "scope": ["keyword.operator", "punctuation.accessor"],
            "settings": { "foreground": "#616161" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "variable.other"],
            "settings": { "foreground": "#D32F2F" }
        },
        {
            "name": "Variable Parameters",
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#757575", "fontStyle": "italic" }
        },
        {
            "name": "Functions",
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#7B1FA2" }
        },
        {
            "name": "Function Calls",
            "scope": ["meta.function-call"],
            "settings": { "foreground": "#512DA8" }
        },
        {
            "name": "Classes",
            "scope": [
                "entity.name.class",
                "entity.name.type.class",
                "support.class"
            ],
            "settings": { "foreground": "#0D47A1", "fontStyle": "bold" }
        },
        {
            "name": "Types",
            "scope": ["entity.name.type", "support.type"],
            "settings": { "foreground": "#00695C" }
        },
        {
            "name": "Interfaces",
            "scope": ["entity.name.type.interface"],
            "settings": { "foreground": "#5D4037", "fontStyle": "italic" }
        },
        {
            "name": "Numbers",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#F57C00" }
        },
        {
            "name": "Constants",
            "scope": ["constant", "constant.language", "constant.character"],
            "settings": { "foreground": "#C2185B" }
        },
        {
            "name": "Booleans",
            "scope": ["constant.language.boolean"],
            "settings": { "foreground": "#C62828", "fontStyle": "bold" }
        },
        {
            "name": "Properties",
            "scope": ["variable.other.property", "support.variable.property"],
            "settings": { "foreground": "#00796B" }
        },
        {
            "name": "Object Keys",
            "scope": ["meta.object-literal.key"],
            "settings": { "foreground": "#5E35B1" }
        },
        {
            "name": "Tags",
            "scope": ["entity.name.tag", "punctuation.definition.tag"],
            "settings": { "foreground": "#D81B60" }
        },
        {
            "name": "Attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#6D4C41", "fontStyle": "italic" }
        },
        {
            "name": "Punctuation",
            "scope": ["punctuation", "meta.brace"],
            "settings": { "foreground": "#9E9E9E" }
        },
        {
            "name": "Regex",
            "scope": ["string.regexp"],
            "settings": { "foreground": "#8E24AA" }
        },
        {
            "name": "Escape Characters",
            "scope": ["constant.character.escape"],
            "settings": { "foreground": "#E64A19" }
        },
        {
            "name": "Decorators/Annotations",
            "scope": ["meta.decorator", "punctuation.decorator"],
            "settings": { "foreground": "#5C6BC0" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": {
                "foreground": "#B71C1C",
                "fontStyle": "strikethrough"
            }
        },
        {
            "name": "Markdown Headings",
            "scope": ["markup.heading", "entity.name.section"],
            "settings": { "foreground": "#283593", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Bold",
            "scope": ["markup.bold"],
            "settings": { "foreground": "#0D47A1", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Italic",
            "scope": ["markup.italic"],
            "settings": { "foreground": "#5E35B1", "fontStyle": "italic" }
        },
        {
            "name": "Markdown Links",
            "scope": ["markup.underline.link"],
            "settings": { "foreground": "#1565C0" }
        },
        {
            "name": "Markdown Code",
            "scope": ["markup.inline.raw", "markup.fenced_code"],
            "settings": { "foreground": "#424242" }
        },
        {
            "name": "JSON Keys",
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#039BE5" }
        },
        {
            "name": "CSS Selectors",
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css"
            ],
            "settings": { "foreground": "#2962FF" }
        },
        {
            "name": "CSS Properties",
            "scope": ["support.type.property-name.css"],
            "settings": { "foreground": "#00897B" }
        },
        {
            "name": "CSS Values",
            "scope": ["support.constant.property-value.css"],
            "settings": { "foreground": "#F9A825" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
