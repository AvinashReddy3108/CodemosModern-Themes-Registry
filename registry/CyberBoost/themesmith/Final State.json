{
    "name": "Final State",
    "type": "light",
    "description": "A dual‑tone VS Code theme that captures the cold finality of night and the quiet hum of an idle system, juxtaposing an immutable black background with a soft, muted light mode.",
    "tags": [
        "dark",
        "light",
        "minimal",
        "high-contrast",
        "science-fiction",
        "noir",
        "calm",
        "serene",
        "future",
        "elegant",
        "soft",
        "emotions"
    ],
    "semanticHighlighting": true,
    "colors": {
        "editor.background": "#fafafa",
        "editor.foreground": "#2e2e2e",
        "activityBar.background": "#e8eff5",
        "activityBar.foreground": "#2e2e2e",
        "activityBar.activeBorder": "#5a9bd4",
        "activityBarBadge.background": "#5a9bd4",
        "activityBarBadge.foreground": "#ffffff",
        "sideBar.background": "#f0f4f8",
        "sideBar.foreground": "#2e2e2e",
        "sideBarTitle.foreground": "#2e2e2e",
        "sideBarSectionHeader.background": "#e8eff5",
        "sideBarSectionHeader.foreground": "#5a9bd4",
        "titleBar.activeBackground": "#e8eff5",
        "titleBar.activeForeground": "#2e2e2e",
        "titleBar.inactiveBackground": "#fafafa",
        "titleBar.inactiveForeground": "#777777",
        "statusBar.background": "#e0e7ed",
        "statusBar.foreground": "#2e2e2e",
        "statusBar.debuggingBackground": "#5a9bd4",
        "statusBar.noFolderBackground": "#e8eff5",
        "statusBarItem.hoverBackground": "#5a9bd433",
        "tab.activeBackground": "#ffffff",
        "tab.activeForeground": "#2e2e2e",
        "tab.inactiveBackground": "#f0f4f8",
        "tab.inactiveForeground": "#777777",
        "tab.border": "#d0d0d0",
        "tab.activeBorder": "#5a9bd4",
        "editorGroupHeader.tabsBackground": "#fafafa",
        "editor.lineHighlightBackground": "#5a9bd419",
        "editor.lineHighlightBorder": "#5a9bd433",
        "editor.selectionBackground": "#5a9bd440",
        "editor.selectionHighlightBackground": "#5a9bd430",
        "editor.findMatchBackground": "#5a9bd44d",
        "editor.findMatchHighlightBackground": "#5a9bd424",
        "editorCursor.foreground": "#5a9bd4",
        "editorWhitespace.foreground": "#c0c0c0",
        "editorIndentGuide.background": "#d0d0d0",
        "editorIndentGuide.activeBackground": "#a0a0a0",
        "editorLineNumber.foreground": "#999999",
        "editorLineNumber.activeForeground": "#5a9bd4",
        "editorBracketMatch.background": "#5a9bd422",
        "editorBracketMatch.border": "#5a9bd4",
        "terminal.background": "#fafafa",
        "terminal.foreground": "#2e2e2e",
        "terminal.ansiBlue": "#5a9bd4",
        "terminal.ansiCyan": "#6cbfa1",
        "terminal.ansiGreen": "#3c9d48",
        "terminal.ansiMagenta": "#b285d6",
        "terminal.ansiRed": "#d96c6c",
        "terminal.ansiYellow": "#d9b46c",
        "terminal.ansiBrightBlue": "#7ab5ff",
        "terminal.ansiBrightCyan": "#8cd9c4",
        "terminal.ansiBrightGreen": "#6fd67f",
        "terminal.ansiBrightMagenta": "#c979c9",
        "terminal.ansiBrightRed": "#ff7b7b",
        "terminal.ansiBrightYellow": "#ffd96c",
        "panel.background": "#fafafa",
        "panel.border": "#e0e0e0",
        "panelTitle.activeBorder": "#5a9bd4",
        "panelTitle.activeForeground": "#2e2e2e",
        "panelTitle.inactiveForeground": "#777777",
        "input.background": "#ffffff",
        "input.foreground": "#2e2e2e",
        "input.border": "#d0d0d0",
        "input.placeholderForeground": "#999999",
        "inputOption.activeBorder": "#5a9bd4",
        "focusBorder": "#5a9bd4",
        "dropdown.background": "#ffffff",
        "dropdown.border": "#d0d0d0",
        "dropdown.foreground": "#2e2e2e",
        "list.activeSelectionBackground": "#5a9bd428",
        "list.activeSelectionForeground": "#ffffff",
        "list.hoverBackground": "#5a9bd418",
        "list.focusBackground": "#5a9bd424",
        "list.highlightForeground": "#5a9bd4",
        "button.background": "#5a9bd4",
        "button.foreground": "#ffffff",
        "button.hoverBackground": "#5a9bd4aa",
        "badge.background": "#5a9bd4",
        "badge.foreground": "#ffffff",
        "scrollbar.shadow": "#00000020",
        "scrollbarSlider.background": "#c0c0c0a0",
        "scrollbarSlider.hoverBackground": "#c0c0c0b0",
        "scrollbarSlider.activeBackground": "#c0c0c0c0",
        "gitDecoration.modifiedResourceForeground": "#5a9bd4",
        "gitDecoration.deletedResourceForeground": "#d96c6c",
        "gitDecoration.untrackedResourceForeground": "#6fd67f",
        "gitDecoration.conflictingResourceForeground": "#d9b46c",
        "minimap.background": "#fafafa",
        "minimapSlider.background": "#5a9bd418",
        "minimapSlider.hoverBackground": "#5a9bd430",
        "minimapSlider.activeBackground": "#5a9bd44c"
    },
    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#999999", "fontStyle": "italic" }
        },
        {
            "name": "Strings",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#3c9d48" }
        },
        {
            "name": "Keywords",
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#5a9bd4", "fontStyle": "bold" }
        },
        {
            "name": "Operators",
            "scope": ["keyword.operator", "punctuation.accessor"],
            "settings": { "foreground": "#6cbfa1" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "variable.other"],
            "settings": { "foreground": "#2e2e2e" }
        },
        {
            "name": "Variable Parameters",
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#6cbfa1", "fontStyle": "italic" }
        },
        {
            "name": "Functions",
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#5a9bd4" }
        },
        {
            "name": "Function Calls",
            "scope": ["meta.function-call"],
            "settings": { "foreground": "#6cbfa1" }
        },
        {
            "name": "Classes",
            "scope": [
                "entity.name.class",
                "entity.name.type.class",
                "support.class"
            ],
            "settings": { "foreground": "#6cbfa1", "fontStyle": "bold" }
        },
        {
            "name": "Types",
            "scope": ["entity.name.type", "support.type"],
            "settings": { "foreground": "#b285d6" }
        },
        {
            "name": "Interfaces",
            "scope": ["entity.name.type.interface"],
            "settings": { "foreground": "#b285d6", "fontStyle": "italic" }
        },
        {
            "name": "Numbers",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#d96c6c" }
        },
        {
            "name": "Constants",
            "scope": ["constant", "constant.language", "constant.character"],
            "settings": { "foreground": "#d9b46c" }
        },
        {
            "name": "Booleans",
            "scope": ["constant.language.boolean"],
            "settings": { "foreground": "#d96c6c", "fontStyle": "bold" }
        },
        {
            "name": "Properties",
            "scope": ["variable.other.property", "support.variable.property"],
            "settings": { "foreground": "#2e2e2e" }
        },
        {
            "name": "Object Keys",
            "scope": ["meta.object-literal.key"],
            "settings": { "foreground": "#7ab5ff" }
        },
        {
            "name": "Tags",
            "scope": ["entity.name.tag", "punctuation.definition.tag"],
            "settings": { "foreground": "#5a9bd4" }
        },
        {
            "name": "Attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#6cbfa1", "fontStyle": "italic" }
        },
        {
            "name": "Punctuation",
            "scope": ["punctuation", "meta.brace"],
            "settings": { "foreground": "#2e2e2e" }
        },
        {
            "name": "Regex",
            "scope": ["string.regexp"],
            "settings": { "foreground": "#d96c6c" }
        },
        {
            "name": "Escape Characters",
            "scope": ["constant.character.escape"],
            "settings": { "foreground": "#d9b46c" }
        },
        {
            "name": "Decorators/Annotations",
            "scope": ["meta.decorator", "punctuation.decorator"],
            "settings": { "foreground": "#b285d6" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": {
                "foreground": "#ff7b7b",
                "fontStyle": "strikethrough"
            }
        },
        {
            "name": "Markdown Headings",
            "scope": ["markup.heading", "entity.name.section"],
            "settings": { "foreground": "#5a9bd4", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Bold",
            "scope": ["markup.bold"],
            "settings": { "foreground": "#d96c6c", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Italic",
            "scope": ["markup.italic"],
            "settings": { "foreground": "#6cbfa1", "fontStyle": "italic" }
        },
        {
            "name": "Markdown Links",
            "scope": ["markup.underline.link"],
            "settings": { "foreground": "#7ab5ff" }
        },
        {
            "name": "Markdown Code",
            "scope": ["markup.inline.raw", "markup.fenced_code"],
            "settings": { "foreground": "#3c9d48" }
        },
        {
            "name": "JSON Keys",
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#7ab5ff" }
        },
        {
            "name": "CSS Selectors",
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css"
            ],
            "settings": { "foreground": "#b285d6" }
        },
        {
            "name": "CSS Properties",
            "scope": ["support.type.property-name.css"],
            "settings": { "foreground": "#7ab5ff" }
        },
        {
            "name": "CSS Values",
            "scope": ["support.constant.property-value.css"],
            "settings": { "foreground": "#3c9d48" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
