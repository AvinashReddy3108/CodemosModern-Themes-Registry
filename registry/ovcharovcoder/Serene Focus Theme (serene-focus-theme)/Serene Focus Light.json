{
    "$schema": "vscode://schemas/color-theme",
    "name": "Neo-Serene Light",
    "type": "light",
    "semanticHighlighting": true,
    "colors": {
        "editor.background": "#F7F4ED",
        "editor.foreground": "#2A2E33",
        "editorCursor.foreground": "#3E8F80",
        "editor.lineHighlightBackground": "#EDE9E0",
        "editor.lineHighlightBorder": "#D9D4C8",
        "editor.selectionBackground": "#3E8F8044",
        "editor.inactiveSelectionBackground": "#3E8F8022",
        "editor.wordHighlightBackground": "#D9D4C880",
        "editor.wordHighlightStrongBackground": "#3E8F8044",
        "editorLineNumber.foreground": "#A8A39A",
        "editorLineNumber.activeForeground": "#3E8F80",
        "editorRuler.foreground": "#D9D4C8",
        "editor.findMatchBackground": "#3E8F8066",
        "editor.findMatchHighlightBackground": "#3E8F8033",
        "editorBracketMatch.background": "#E6E2D9",
        "editorBracketMatch.border": "#3E8F8066",
        "editorBracketHighlight.foreground1": "#3E8F80",
        "editorBracketHighlight.foreground2": "#2F7FA1",
        "editorBracketHighlight.foreground3": "#9A6EDB",
        "editorBracketHighlight.foreground4": "#C95A4A",
        "editorBracketHighlight.foreground5": "#C48A00",
        "editorIndentGuide.background1": "#D9D4C8",
        "editorIndentGuide.background2": "#D9D4C8",
        "editorIndentGuide.activeBackground1": "#C4BEB2",
        "editorIndentGuide.activeBackground2": "#C4BEB2",
        "editorWhitespace.foreground": "#D9D4C880",
        "editorHoverWidget.background": "#F0EDE6",
        "editorHoverWidget.border": "#D9D4C8",
        "editorSuggestWidget.background": "#F0EDE6",
        "editorSuggestWidget.border": "#D9D4C8",
        "editorSuggestWidget.selectedBackground": "#3E8F8033",
        "editorSuggestWidget.highlightForeground": "#3E8F80",
        "editorInlayHint.foreground": "#8A867C",
        "editorInlayHint.background": "#E6E2D966",
        "editorInlayHint.typeForeground": "#2F7FA1",
        "editorInlayHint.parameterForeground": "#5F9F73",
        "editorError.foreground": "#C95A4A",
        "editorError.border": "#C95A4A44",
        "editorWarning.foreground": "#C48A00",
        "editorWarning.border": "#C48A0044",
        "editorInfo.foreground": "#2F7FA1",
        "editorInfo.border": "#2F7FA144",
        "sideBar.background": "#F1EEE6",
        "sideBar.foreground": "#2A2E33",
        "sideBar.border": "#E6E2D9",
        "sideBarSectionHeader.background": "#EBE7DE",
        "sideBarSectionHeader.foreground": "#3E8F80",
        "activityBar.background": "#E7E3DA",
        "activityBar.foreground": "#2A2E33",
        "activityBar.activeBorder": "#3E8F80",
        "activityBar.activeBackground": "#3E8F800D",
        "activityBar.inactiveForeground": "#A8A39A",
        "activityBar.border": "#E6E2D9",
        "statusBar.background": "#ECE8DF",
        "statusBar.foreground": "#2A2E33",
        "statusBar.border": "#E6E2D9",
        "statusBarItem.hoverBackground": "#3E8F801A",
        "tab.activeBackground": "#F0EDE6",
        "tab.activeForeground": "#3E8F80",
        "tab.activeBorderTop": "#3E8F8066",
        "tab.inactiveBackground": "#F7F4ED",
        "tab.inactiveForeground": "#A8A39A",
        "tab.hoverBackground": "#3E8F800D",
        "tab.hoverForeground": "#3E8F80",
        "tab.border": "#E6E2D9",
        "panel.background": "#F7F4ED",
        "panel.border": "#E6E2D9",
        "panelTitle.activeBorder": "#3E8F80",
        "panelTitle.activeForeground": "#3E8F80",
        "panelTitle.inactiveForeground": "#A8A39A",
        "terminal.background": "#F7F4ED",
        "terminal.foreground": "#2A2E33",
        "terminalCursor.foreground": "#3E8F80",
        "terminal.ansiBlack": "#E7E3DA",
        "terminal.ansiRed": "#C95A4A",
        "terminal.ansiGreen": "#5F9F73",
        "terminal.ansiYellow": "#C48A00",
        "terminal.ansiBlue": "#2F7FA1",
        "terminal.ansiMagenta": "#9A6EDB",
        "terminal.ansiCyan": "#2D9C8C",
        "terminal.ansiWhite": "#2A2E33",
        "terminal.ansiBrightBlack": "#A8A39A",
        "terminal.ansiBrightRed": "#C95A4A",
        "terminal.ansiBrightGreen": "#5F9F73",
        "terminal.ansiBrightYellow": "#C48A00",
        "terminal.ansiBrightBlue": "#2F7FA1",
        "terminal.ansiBrightMagenta": "#9A6EDB",
        "terminal.ansiBrightCyan": "#2D9C8C",
        "terminal.ansiBrightWhite": "#1A1C1F",
        "terminal.selectionBackground": "#3E8F8022",
        "gitDecoration.addedResourceForeground": "#5F9F73",
        "gitDecoration.modifiedResourceForeground": "#C48A00",
        "gitDecoration.deletedResourceForeground": "#C95A4A",
        "gitDecoration.ignoredResourceForeground": "#A8A39A",
        "gitDecoration.conflictingResourceForeground": "#C95A4A",
        "diffEditor.insertedTextBackground": "#5F9F7333",
        "diffEditor.removedTextBackground": "#C95A4A33",
        "diffEditor.insertedLineBackground": "#5F9F730D",
        "diffEditor.removedLineBackground": "#C95A4A0D",
        "merge.currentHeaderBackground": "#5F9F7333",
        "merge.currentContentBackground": "#5F9F731A",
        "merge.incomingHeaderBackground": "#2F7FA133",
        "merge.incomingContentBackground": "#2F7FA11A",
        "merge.commonContentBackground": "#D9D4C866",
        "breadcrumb.foreground": "#A8A39A",
        "breadcrumb.focusForeground": "#3E8F80",
        "breadcrumb.activeSelectionForeground": "#3E8F80",
        "breadcrumbPicker.background": "#F0EDE6",
        "button.background": "#E6E2D9",
        "button.hoverBackground": "#3E8F801A",
        "button.foreground": "#2A2E33",
        "input.background": "#F0EDE6",
        "input.border": "#D9D4C8",
        "input.foreground": "#2A2E33",
        "input.placeholderForeground": "#A8A39A",
        "badge.background": "#3E8F80",
        "badge.foreground": "#F7F4ED",
        "list.activeSelectionBackground": "#3E8F801A",
        "list.activeSelectionForeground": "#3E8F80",
        "list.hoverBackground": "#3E8F800D",
        "list.highlightForeground": "#3E8F80",
        "scrollbarSlider.background": "#3E8F801A",
        "scrollbarSlider.hoverBackground": "#3E8F8033",
        "scrollbarSlider.activeBackground": "#3E8F8044",
        "minimap.background": "#F7F4ED",
        "minimap.selectionHighlight": "#3E8F8033",
        "minimap.findMatchHighlight": "#3E8F8066",
        "notifications.background": "#F0EDE6",
        "notifications.foreground": "#2A2E33",
        "notifications.border": "#D9D4C8",
        "debugToolBar.background": "#F0EDE6",
        "debugIcon.breakpointForeground": "#C95A4A",
        "debugIcon.startForeground": "#5F9F73",
        "debugIcon.pauseForeground": "#C48A00",
        "debugIcon.stopForeground": "#C95A4A",
        "debugIcon.stepOverForeground": "#2F7FA1",
        "testing.iconPassed": "#5F9F73",
        "testing.iconFailed": "#C95A4A",
        "testing.iconQueued": "#C48A00",
        "settings.headerForeground": "#3E8F80",
        "settings.modifiedItemIndicator": "#3E8F80",
        "settings.dropdownBackground": "#F0EDE6",
        "settings.dropdownBorder": "#D9D4C8",
        "settings.checkboxBackground": "#F0EDE6",
        "settings.checkboxBorder": "#D9D4C8",
        "welcomePage.tileBackground": "#F0EDE6",
        "welcomePage.tileHoverBackground": "#3E8F800D",
        "walkThrough.embeddedEditorBackground": "#F7F4ED"
    },
    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#7A766F" }
        },
        {
            "name": "Docstrings",
            "scope": ["string.docstring", "comment.block.documentation"],
            "settings": { "foreground": "#7A766F", "fontStyle": "italic" }
        },
        {
            "name": "Keywords",
            "scope": ["keyword", "storage", "storage.type", "keyword.control"],
            "settings": { "foreground": "#3E8F80", "fontStyle": "bold" }
        },
        {
            "name": "Keyword Async/Await",
            "scope": ["keyword.control.async", "keyword.control.await"],
            "settings": { "foreground": "#3E8F80", "fontStyle": "bold italic" }
        },
        {
            "name": "Operators",
            "scope": ["keyword.operator", "keyword.operator.logical"],
            "settings": { "foreground": "#2D9C8C" }
        },
        {
            "name": "Strings",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#5F9F73" }
        },
        {
            "name": "String Escape",
            "scope": ["constant.character.escape", "string.escape"],
            "settings": { "foreground": "#C95A4A" }
        },
        {
            "name": "Regular Expressions",
            "scope": ["string.regexp"],
            "settings": { "foreground": "#C95A4A" }
        },
        {
            "name": "Numbers",
            "scope": ["constant.numeric", "constant.numeric.integer"],
            "settings": { "foreground": "#9A6EDB" }
        },
        {
            "name": "Booleans & Constants",
            "scope": ["constant.language", "constant.language.boolean"],
            "settings": { "foreground": "#9A6EDB", "fontStyle": "bold" }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call"
            ],
            "settings": { "foreground": "#2F7FA1" }
        },
        {
            "name": "Function Parameters",
            "scope": ["variable.parameter", "variable.parameter.function"],
            "settings": { "foreground": "#C48A00", "fontStyle": "italic" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "variable.other"],
            "settings": { "foreground": "#2A2E33" }
        },
        {
            "name": "Special Variables (self, cls)",
            "scope": [
                "variable.language",
                "variable.language.this",
                "variable.language.self"
            ],
            "settings": { "foreground": "#3E8F80", "fontStyle": "bold italic" }
        },
        {
            "name": "Classes & Types",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.class",
                "storage.type.class"
            ],
            "settings": { "foreground": "#C48A00", "fontStyle": "bold" }
        },
        {
            "name": "Decorators & Annotations",
            "scope": [
                "meta.function.decorator",
                "entity.name.function.decorator"
            ],
            "settings": { "foreground": "#9A6EDB" }
        },
        {
            "name": "Type Hints",
            "scope": [
                "meta.type.annotation",
                "support.type",
                "storage.type.type"
            ],
            "settings": { "foreground": "#2F7FA1", "fontStyle": "italic" }
        },
        {
            "name": "HTML/JSX Tags",
            "scope": ["entity.name.tag", "meta.tag"],
            "settings": { "foreground": "#C95A4A" }
        },
        {
            "name": "HTML/JSX Attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#C48A00" }
        },
        {
            "name": "JSX Components",
            "scope": ["entity.name.tag.component", "support.class.component"],
            "settings": { "foreground": "#2F7FA1", "fontStyle": "bold" }
        },
        {
            "name": "CSS Properties",
            "scope": ["support.type.property-name", "meta.property-name"],
            "settings": { "foreground": "#2A2E33" }
        },
        {
            "name": "CSS Values",
            "scope": [
                "support.constant.property-value",
                "constant.other.color"
            ],
            "settings": { "foreground": "#C48A00" }
        },
        {
            "name": "Markdown Headers",
            "scope": ["markup.heading"],
            "settings": { "foreground": "#2F7FA1", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Links",
            "scope": ["markup.underline.link", "string.other.link"],
            "settings": { "foreground": "#5F9F73", "fontStyle": "underline" }
        },
        {
            "name": "JSON Keys",
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#C95A4A" }
        },
        {
            "name": "Punctuation",
            "scope": ["punctuation", "punctuation.separator"],
            "settings": { "foreground": "#A8A39A" }
        },
        {
            "name": "Constants (None, True, False)",
            "scope": [
                "constant.language.null",
                "constant.language.boolean.true",
                "constant.language.boolean.false"
            ],
            "settings": { "foreground": "#9A6EDB", "fontStyle": "bold" }
        },
        {
            "name": "Diff Inserted",
            "scope": ["markup.inserted"],
            "settings": { "foreground": "#5F9F73" }
        },
        {
            "name": "Diff Deleted",
            "scope": ["markup.deleted"],
            "settings": { "foreground": "#C95A4A" }
        }
    ],
    "semanticTokenColors": {
        "variable": "#2A2E33",
        "variable.defaultLibrary": "#5F9F73",
        "variable.deprecated": "#C95A4A",
        "parameter": "#C48A00",
        "function": "#2F7FA1",
        "method": "#3C8DA8",
        "method.declaration": "#2F7FA1",
        "property": "#2A2E33",
        "property.static": "#9A6EDB",
        "class": "#C48A00",
        "class.builtin": "#9A6EDB",
        "interface": "#2D9C8C",
        "enum": "#9A6EDB",
        "enumMember": "#5F9F73",
        "keyword": "#3E8F80",
        "keyword.operator": "#2D9C8C",
        "namespace": "#C48A00",
        "type": "#C48A00",
        "typeParameter": "#2F7FA1",
        "decorator": "#9A6EDB",
        "macro": "#C95A4A"
    }
}
