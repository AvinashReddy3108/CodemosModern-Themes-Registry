        "terminal.ansiBrightBlue": "#bdf",
        "terminal.ansiBrightMagenta": "#faf",
        "terminal.ansiBrightCyan": "#5ee",
        "terminal.ansiBrightWhite": "#f3f3f3"
    },
    "tokenColors": [
        {
            "scope": ["invalid"],
            "settings": { "foreground": "#e22", "fontStyle": "bold underline" }
        },
        {
            "scope": ["markup.inserted.diff"],
            "settings": { "foreground": "#6ba" }
        },
        {
            "scope": ["markup.deleted.diff"],
            "settings": { "foreground": "#c00" }
        },
        {
            "scope": ["string", "constant", "entity.name.import"],
            "settings": { "foreground": "#bdf" }
        },
        {
            "scope": [
                "meta.paragraph",
                "string.unquoted.argument",
                "constant.other.option",
                "punctuation.definition.logical-expression",
                "punctuation.definition.dictionary",
                "punctuation.definition.array",
                "punctuation.definition.evaluation",
                "meta"
            ],
            "settings": { "foreground": "#fff" }
        },
        {
            "scope": [
                "keyword",
                "fenced_code.block.language",
                "punctuation.separator",
                "constant.character.escape",
                "constant.other.placeholder"
            ],
            "settings": { "foreground": "#ecf" }
        },
        {
            "scope": [
                "entity",
                "storage",
                "support",
                "markup.heading",
                "punctuation.definition.heading",
                "entity.name.section"
            ],
            "settings": { "foreground": "#cbf" }
        },
        {
            "scope": [
                "variable",
                "entity.name",
                "meta.attribute",
                "markup.inline.raw"
            ],
            "settings": { "foreground": "#9bf" }
        },
        {
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call",
                "meta.function",
                "entity.name.command"
            ],
            "settings": { "foreground": "#8ec" }
        },
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#999" }
        },
        {
            "scope": "markup.underline",
            "settings": { "fontStyle": "underline" }
        },
        { "scope": "markup.italic", "settings": { "fontStyle": "italic" } },
        {
            "scope": "keyword.operator",
            "settings": { "fontStyle": "none", "foreground": "#fff" }
        },
        {
            "scope": [
                "strong",
                "emphasis",
                "markup.bold",
                "entity.name.type.org",
                "entity.name.function.org",
                "entity.other.attribute-name.org"
            ],
            "settings": { "fontStyle": "bold" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
