        "terminal.ansiBrightMagenta": "#80a",
        "terminal.ansiBrightCyan": "#288",
        "terminal.ansiBrightWhite": "#333"
    },
    "tokenColors": [
        {
            "scope": ["invalid"],
            "settings": { "foreground": "#e22", "fontStyle": "bold underline" }
        },
        {
            "scope": ["markup.inserted.diff"],
            "settings": { "foreground": "#163" }
        },
        {
            "scope": ["markup.deleted.diff"],
            "settings": { "foreground": "#c00" }
        },
        {
            "scope": ["string", "constant", "entity.name.import"],
            "settings": { "foreground": "#900" }
        },
        {
            "scope": [
                "meta.paragraph",
                "string.unquoted.argument",
                "constant.other.option",
                "punctuation.definition.logical-expression",
                "punctuation.definition.dictionary",
                "punctuation.definition.array",
                "punctuation.definition.evaluation",
                "meta"
            ],
            "settings": { "foreground": "#000" }
        },
        {
            "scope": [
                "keyword",
                "fenced_code.block.language",
                "punctuation.separator",
                "constant.character.escape",
                "constant.other.placeholder"
            ],
            "settings": { "foreground": "#000" }
        },
        {
            "scope": [
                "entity",
                "storage",
                "support",
                "markup.heading",
                "punctuation.definition.heading",
                "entity.name.section"
            ],
            "settings": { "foreground": "#000" }
        },
        {
            "scope": [
                "variable",
                "entity.name",
                "meta.attribute",
                "markup.inline.raw"
            ],
            "settings": { "foreground": "#000" }
        },
        {
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call",
                "meta.function",
                "entity.name.command"
            ],
            "settings": { "foreground": "#000" }
        },
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#055" }
        },
        {
            "scope": "markup.underline",
            "settings": { "fontStyle": "underline" }
        },
        { "scope": "markup.italic", "settings": { "fontStyle": "italic" } },
        {
            "scope": "keyword.operator",
            "settings": { "fontStyle": "none", "foreground": "#000" }
        },
        {
            "scope": [
                "keyword",
                "strong",
                "emphasis",
                "markup.bold",
                "entity.name.type.org",
                "entity.name.function.org",
                "entity.other.attribute-name.org"
            ],
            "settings": { "fontStyle": "bold" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
