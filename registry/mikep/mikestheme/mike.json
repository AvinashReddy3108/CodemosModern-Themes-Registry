        "variable.declaration": { "foreground": "#f5f5df", "fontStyle": "" },
        "variable.defaultLibrary": { "foreground": "#f28779", "fontStyle": "" },
        "parameter": "#cab0ff",
        "typeParameter": "#ff8f40",
        "property": "#f5f5df",
        "property.declaration": "#f5f5df",
        "property.readonly": "#f5f5df",
        "property.defaultLibrary": { "foreground": "#ffa759", "fontStyle": "" },
        "enumMember": "#9dd2bb",
        "event": "#77f6ff",
        "label": "#b3b1ad",
        "comment": "#6e6960",
        "string": "#c7f092",
        "keyword": "#ffa759",
        "number": "#77f6ff",
        "regexp": "#95e6cb",
        "operator": "#78f5cb"
