        "class.readonly": { "foreground": "#f5f5df", "fontStyle": "" },
        "class.defaultLibrary": { "foreground": "#F28779", "fontStyle": "" },
        "class.declaration": { "foreground": "#ff8f40", "fontStyle": "" },
        "interface": "#ff8f40",
        "enum": "#9dd2bb",
        "function": "#ffd17a",
        "member": { "foreground": "#ffd17a", "fontStyle": "" },
        "macro": "#ffd17a",
        "variable": "#f5f5df",
