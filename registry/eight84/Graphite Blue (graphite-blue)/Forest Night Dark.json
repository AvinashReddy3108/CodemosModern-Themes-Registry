{
    "name": "Forest Night",
    "type": "dark",
    "colors": {
        "editor.background": "#2d353b",
        "editor.foreground": "#d3c6aa",
        "activityBar.background": "#232a2e",
        "sideBar.background": "#232a2e",
        "sideBar.border": "#404040",
        "editorGroupHeader.tabsBackground": "#1e2326",
        "tab.inactiveBackground": "#1e2326",
        "tab.activeBackground": "#232a2e",
        "statusBar.background": "#1e2326",
        "panel.background": "#232a2e",
        "panel.border": "#404040",
        "titleBar.activeBackground": "#1e2326",
        "button.background": "#56b6c2",
        "button.foreground": "#000000"
    },
    "tokenColors": [
        {
            "scope": ["comment"],
            "settings": { "foreground": "#7a8478", "fontStyle": "italic" }
        },
        {
            "scope": ["string", "constant.numeric"],
            "settings": { "foreground": "#dbbc7f" }
        },
        {
            "scope": ["keyword", "storage.type"],
            "settings": { "foreground": "#e67e80" }
        },
        {
            "scope": [
                "entity.name.function",
                "support.function",
                "entity.name.class",
                "entity.name.type"
            ],
            "settings": { "foreground": "#7fbbb3" }
        },
        {
            "scope": [
                "variable.language",
                "variable.parameter",
                "support.variable"
            ],
            "settings": { "foreground": "#d699b6" }
        },
        { "scope": ["punctuation"], "settings": { "foreground": "#e67e80" } }
    ],
    "$schema": "vscode://schemas/color-theme"
}
