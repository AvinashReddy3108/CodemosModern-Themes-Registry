{
    "name": "Sunset Vibes",
    "type": "dark",
    "colors": {
        "editor.background": "#1d111d",
        "editor.foreground": "#ffeaa7",
        "activityBar.background": "#2d1b2d",
        "sideBar.background": "#2d1b2d",
        "sideBar.border": "#ff6b4a",
        "editorGroupHeader.tabsBackground": "#1a0f1a",
        "tab.inactiveBackground": "#1a0f1a",
        "tab.activeBackground": "#2d1b2d",
        "statusBar.background": "#1a0f1a",
        "panel.background": "#2d1b2d",
        "panel.border": "#ff6b4a",
        "titleBar.activeBackground": "#1a0f1a",
        "button.background": "#ff6b4a",
        "button.foreground": "#000000"
    },
    "tokenColors": [
        { "settings": { "foreground": "#ffeaa7", "background": "#0f0a0f" } },
        {
            "scope": ["keyword.other.unit"],
            "settings": { "foreground": "#ffeaa7" }
        },
        {
            "scope": ["punctuation.section.parens"],
            "settings": { "foreground": "#fd79a8" }
        },
        {
            "scope": [
                "punctuation.section.parens.begin",
                "punctuation.section.parens.end"
            ],
            "settings": { "foreground": "#fd79a8" }
        },
        {
            "scope": ["punctuation.definition.parameters"],
            "settings": { "foreground": "#fd79a8" }
        },
        {
            "scope": ["variable.css", "variable.argument.css"],
            "settings": { "foreground": "#fd79a8" }
        },
        {
            "scope": [
                "support.type.custom-property.css",
                "variable.other.custom-property.css"
            ],
            "settings": { "foreground": "#fd79a8" }
        },
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#fd79a8", "fontStyle": "italic" }
        },
        {
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#ffeaa7" }
        },
        {
            "scope": ["string.quoted.single", "string.quoted.double"],
            "settings": { "foreground": "#ffeaa7" }
        },
        {
            "scope": ["string.template", "string.interpolated"],
            "settings": { "foreground": "#ffeaa7" }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.numeric.integer",
                "constant.numeric.float"
            ],
            "settings": { "foreground": "#ffeaa7" }
        },
        {
            "scope": [
                "constant.language",
                "constant.language.boolean",
                "constant.language.null",
                "constant.language.undefined"
            ],
            "settings": { "foreground": "#ffeaa7" }
        },
        {
            "scope": ["constant.character", "constant.other"],
            "settings": { "foreground": "#ffeaa7" }
        },
        {
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.new",
                "keyword.other"
            ],
            "settings": { "foreground": "#ff6b4a" }
        },
        {
            "scope": [
                "keyword.control.flow",
                "keyword.control.conditional",
                "keyword.control.loop"
            ],
            "settings": { "foreground": "#ff6b4a" }
        },
        {
            "scope": [
                "keyword.control.import",
                "keyword.control.export",
                "keyword.control.from"
            ],
            "settings": { "foreground": "#ff6b4a" }
        },
        {
            "scope": ["storage", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#ff6b4a" }
        },
        {
            "scope": [
                "keyword.operator",
                "keyword.operator.arithmetic",
                "keyword.operator.comparison"
            ],
            "settings": { "foreground": "#ff6b4a" }
        },
        {
            "scope": [
                "keyword.operator.logical",
                "keyword.operator.assignment"
            ],
            "settings": { "foreground": "#ff6b4a" }
        },
        {
            "scope": [
                "entity.name.function",
                "meta.function-call",
                "support.function"
            ],
            "settings": { "foreground": "#ff7675" }
        },
        {
            "scope": ["entity.name.method", "meta.method-call"],
            "settings": { "foreground": "#ff7675" }
        },
        {
            "scope": ["support.function.builtin", "support.function.magic"],
            "settings": { "foreground": "#ff7675" }
        },
        {
            "scope": ["variable", "variable.other", "variable.parameter"],
            "settings": { "foreground": "#ffeaa7" }
        },
        {
            "scope": [
                "variable.language",
                "variable.language.this",
                "variable.language.super"
            ],
            "settings": { "foreground": "#ffeaa7" }
        },
        {
            "scope": ["meta.definition.variable", "meta.object-literal.key"],
            "settings": { "foreground": "#ffeaa7" }
        },
        {
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.type",
                "support.class"
            ],
            "settings": { "foreground": "#ff7675" }
        },
        {
            "scope": ["entity.other.inherited-class", "meta.type.annotation"],
            "settings": { "foreground": "#ff7675" }
        },
        {
            "scope": [
                "meta.property-name",
                "support.type.property-name",
                "variable.other.property"
            ],
            "settings": { "foreground": "#ffeaa7" }
        },
        {
            "scope": ["meta.object.member", "meta.field.declaration"],
            "settings": { "foreground": "#ffeaa7" }
        },
        {
            "scope": ["entity.name.tag", "meta.tag"],
            "settings": { "foreground": "#ff6b4a" }
        },
        {
            "scope": ["entity.other.attribute-name", "meta.attribute"],
            "settings": { "foreground": "#ffeaa7" }
        },
        {
            "scope": ["punctuation.definition.tag"],
            "settings": { "foreground": "#fd79a8" }
        },
        {
            "scope": [
                "support.type.property-name.css",
                "meta.property-name.css"
            ],
            "settings": { "foreground": "#ffeaa7" }
        },
        {
            "scope": [
                "support.constant.property-value.css",
                "meta.property-value.css"
            ],
            "settings": { "foreground": "#ffeaa7" }
        },
        {
            "scope": ["support.constant.color.w3c-standard-color-name.css"],
            "settings": { "foreground": "#ffeaa7" }
        },
        {
            "scope": ["constant.numeric.css"],
            "settings": { "foreground": "#ffeaa7" }
        },
        {
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css"
            ],
            "settings": { "foreground": "#ffeaa7" }
        },
        {
            "scope": [
                "entity.name.tag.css",
                "entity.other.attribute-name.pseudo-class.css"
            ],
            "settings": { "foreground": "#ff6b4a" }
        },
        {
            "scope": [
                "punctuation.section.property-list.begin.css",
                "punctuation.section.property-list.end.css"
            ],
            "settings": { "foreground": "#ffeaa7" }
        },
        {
            "scope": [
                "punctuation.separator.key-value.css",
                "punctuation.terminator.rule.css"
            ],
            "settings": { "foreground": "#ff6b4a" }
        },
        {
            "scope": ["string.quoted.double.css", "string.quoted.single.css"],
            "settings": { "foreground": "#ffeaa7" }
        },
        {
            "scope": ["entity.other.attribute-name.class.css"],
            "settings": { "foreground": "#ff7675" }
        },
        {
            "scope": [
                "support.type.property-name.json",
                "meta.structure.dictionary.key.json"
            ],
            "settings": { "foreground": "#ffeaa7" }
        },
        {
            "scope": ["meta.structure.dictionary.value.json"],
            "settings": { "foreground": "#fd79a8" }
        },
        {
            "scope": [
                "punctuation.definition.parameters",
                "punctuation.definition.arguments"
            ],
            "settings": { "foreground": "#fd79a8" }
        },
        {
            "scope": [
                "punctuation.section.parens",
                "punctuation.section.parens.begin",
                "punctuation.section.parens.end"
            ],
            "settings": { "foreground": "#fd79a8" }
        },
        {
            "scope": ["meta.group.braces.round", "meta.brace.round"],
            "settings": { "foreground": "#fd79a8" }
        },
        {
            "scope": [
                "punctuation.definition.group.begin",
                "punctuation.definition.group.end"
            ],
            "settings": { "foreground": "#fd79a8" }
        },
        {
            "scope": ["punctuation.section.brackets"],
            "settings": { "foreground": "#fd79a8" }
        },
        {
            "scope": ["punctuation.section.braces", "meta.brace"],
            "settings": { "foreground": "#ffeaa7" }
        },
        {
            "scope": ["punctuation.separator", "punctuation.terminator"],
            "settings": { "foreground": "#ff6b4a" }
        },
        {
            "scope": ["support.constant", "support.variable"],
            "settings": { "foreground": "#ffeaa7" }
        },
        {
            "scope": ["support.module", "support.namespace"],
            "settings": { "foreground": "#ff7675" }
        },
        {
            "scope": ["markup.heading", "entity.name.section"],
            "settings": { "foreground": "#ff7675", "fontStyle": "bold" }
        },
        {
            "scope": ["markup.bold"],
            "settings": { "foreground": "#ff6b4a", "fontStyle": "bold" }
        },
        {
            "scope": ["markup.italic"],
            "settings": { "foreground": "#ffeaa7", "fontStyle": "italic" }
        },
        {
            "scope": ["markup.raw", "markup.inline.raw"],
            "settings": { "foreground": "#ffeaa7" }
        },
        {
            "scope": ["keyword.other.unit", "keyword.other.unit.css"],
            "settings": { "foreground": "#ffeaa7" }
        },
        {
            "scope": [
                "punctuation.section.parens",
                "punctuation.section.parens.begin",
                "punctuation.section.parens.end",
                "punctuation.definition.parameters",
                "punctuation.definition.arguments",
                "meta.group.braces.round",
                "meta.brace.round"
            ],
            "settings": { "foreground": "#fd79a8" }
        },
        {
            "scope": [
                "constant.other.color.rgb-value.hex.css",
                "constant.other.rgb-value.css",
                "constant.other.color.css",
                "punctuation.definition.constant.css"
            ],
            "settings": { "foreground": "#fd79a8" }
        },
        {
            "scope": [
                "punctuation.section.function.begin.bracket.round.css",
                "punctuation.section.function.end.bracket.round.css",
                "punctuation.section.function.css",
                "meta.property-value.css punctuation"
            ],
            "settings": { "foreground": "#fd79a8" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
