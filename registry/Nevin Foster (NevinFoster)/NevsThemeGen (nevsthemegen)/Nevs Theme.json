    },
    "tokenColors": [
        {
            "name": "Mirrored Styles - Tokens that visually represent a font style, so they can display that style in the editor. No colors assigned here, group is kinda a 'don't change' group other than specific user preferences."
        },
        {
            "name": "Italic",
            "scope": ["emphasis", "markup.italic"],
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "Bold",
            "scope": ["strong", "markup.bold"],
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Underline",
            "scope": ["markup.underline"],
            "settings": { "fontStyle": "underline" }
        },
        {
            "name": "Strikethrough",
            "scope": ["markup.strikethrough"],
            "settings": { "fontStyle": "strikethrough" }
        },
        {
            "name": "All Keywords",
            "scope": [
                "keyword",
                "storage.type",
                "keyword.operator.noexcept",
                "storage.modifier"
            ],
            "settings": { "fontStyle": "italic" }
        },
        { "name": "Comment Text" },
        {
            "name": "Inline Comment",
            "scope": ["comment"],
            "settings": { "foreground": "#00c860b0" }
        },
        {
            "name": "Documentation Comment",
            "scope": [
                "comment.documentation",
                "comment.block.documentation",
                "string.quoted.docstring.multi",
                "string.unquoted.preprocessor.message",
                "meta.preprocessor.string"
            ],
            "settings": { "foreground": "#7be9afb0" }
        },
        {
            "name": "Comment Delimiter",
            "scope": [
                "comment.documentation.delimiter",
                "punctuation.definition.comment",
                "comment.block.documentation punctuation.definition.tag"
            ],
            "settings": { "foreground": "#00d070b0" }
        },
        { "name": "Primary Accent" },
        {
            "name": "Headings",
            "scope": [
                "markup.heading",
                "header",
                "meta.diff.header",
                "support.type.tag-prefix"
            ],
            "settings": { "foreground": "#00a3ff", "fontStyle": "bold" }
        },
        {
            "name": "Styled Text - Tokens that represent text displayed with some style (e.g. bold, italic, etc.)",
            "scope": [
                "markup.bold",
                "punctuation.definition.list.begin.markdown",
                "markup.italic",
                "markup.strikethrough",
                "string.other.link"
            ],
            "settings": { "foreground": "#93dcff" }
        },
        {
            "name": "Text Attribute - Tokens that represent a secondary style for styled text, usually hidden from the user",
            "scope": ["markup.underline.link", "fenced_code.block"],
            "settings": { "foreground": "#7dbdff" }
        },
        {
            "name": "Debug Token",
            "scope": ["token.debug-token"],
            "settings": { "foreground": "#8a3a8c" }
        },
        {
            "name": "Tag Punctuation",
            "scope": ["punctuation.definition.tag"],
            "settings": { "foreground": "#7B7B7B" }
        },
        { "name": "Control Keywords" },
        {
            "name": "Pure Control - Branching keywords that affect control flow (return, goto, if, else, for, while, etc.)",
            "scope": [
                "keyword.control.import",
                "keyword.control.from",
                "keyword.control.loop",
                "keyword.control.conditional",
                "keyword.control.else",
                "keyword.control.if",
                "keyword.control.flow",
                "keyword.control.while",
                "keyword.control.for",
                "keyword.control.do",
                "keyword.control.foreach",
                "keyword.control.try",
                "keyword.control.catch",
                "keyword.control.switch",
                "keyword.control.break",
                "keyword.control.continue",
                "keyword.control.goto",
                "keyword.control.return",
                "keyword.control.throw",
                "keyword.control.finally",
                "keyword.control.directive",
                "storage.modifier.import.java",
                "variable.language.wildcard.java",
                "storage.modifier.package.java"
            ],
            "settings": { "foreground": "#f36cf3" }
        },
        {
            "name": "PreProcessor + Compile Time - Keywords that are used explicitly at compile time (preprocessor, macros, using, etc.)",
            "scope": [
                "meta.preprocessor",
                "keyword.other.using",
                "keyword.other.import",
                "entity.name.function.preprocessor"
            ],
            "settings": { "foreground": "#9f5dcb" }
        },
        {
            "name": "Data Descriptors - Keywords that are used to define some data (var, let, etc.) or data factory (class, struct, enum, etc.)"
        },
        {
            "name": "Defining Keywords - Descriptor for defining some kind of referable entity (var, type/object, func, etc.)",
            "scope": [
                "storage.type",
                "keyword.other.namespace",
                "keyword.other.class",
                "keyword.other.struct",
                "keyword.other.enum",
                "keyword.other.union",
                "keyword.other.interface",
                "storage.type.accessor",
                "keyword.other.var",
                "keyword.other.delegate",
                "keyword.other.special-method",
                "keyword.other.directive",
                "punctuation.definition.directive.begin"
            ],
            "settings": { "foreground": "#ff4f6b" }
        },
        {
            "name": "Storage Modifiers - Keywords that modify the intrinsic properties or scope of a variable (static, final, public, etc.)",
            "scope": [
                "keyword.operator.noexcept",
                "storage.modifier",
                "storage.type.modifier",
                "keyword.control.default"
            ],
            "settings": { "foreground": "#ff4c8c" }
        },
        {
            "name": "Data Types - Referable names that describe the layout/functions of some data ('int', 'string', class name, struct name, etc.)"
        },
        {
            "name": "Unknown Type",
            "scope": ["entity.name.type", "entity.name.type.delegate"],
            "settings": { "foreground": "#009866" }
        },
        {
            "name": "Primitives - Primitive types that are built into the language (int, string, etc.)",
            "scope": [
                "keyword.type",
                "storage.type.primitive",
                "storage.type.built-in",
                "support.type.primitive"
            ],
            "settings": { "foreground": "#74b700" }
        },
        {
            "name": "Structs - Types that describe a class like behaviour, but with no inheritance and passed by value (struct, tuple, etc.)",
            "scope": ["entity.name.type.struct"],
            "settings": { "foreground": "#00c300" }
        },
        {
            "name": "CSS Targets - Keywords that target CSS selectors (class, id, pseudo-class, etc.)",
            "scope": [
                "entity.name.tag.css",
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.class.mixin.css",
                "entity.other.attribute-name.id.css",
                "entity.other.attribute-name.parent-selector.css",
                "entity.other.attribute-name.pseudo-class.css",
                "entity.other.attribute-name.pseudo-element.css",
                "source.css.less entity.other.attribute-name.id",
                "entity.other.attribute-name.scss"
            ],
            "settings": { "foreground": "#00c300" }
        },
        {
            "name": "Enums - Types that describe a set of fixed named values (enum, etc.)",
            "scope": ["entity.name.type.enum"],
            "settings": { "foreground": "#56d753" }
        },
        {
            "name": "Interfaces - Types that define a subset of necessary properties, without any implementation (interface, ts type, etc.)",
            "scope": ["entity.name.type.interface"],
            "settings": { "foreground": "#00c860" }
        },
        {
            "name": "Classes - Types that describe the fields and methods of a data reference",
            "scope": [
                "entity.name.class",
                "entity.name.type.class",
                "entity.other.inherited-class"
            ],
            "settings": { "foreground": "#00c985" }
        },
        {
            "name": "Namespaces - Types that describe a collection of other types (namespace, module, etc.)",
            "scope": [
                "entity.name.type.namespace",
                "entity.name.scope-resolution",
                "entity.name.type.module",
                "entity.name.tag.namespace"
            ],
            "settings": { "foreground": "#00987b" }
        },
        {
            "name": "Tags - Defines interface like data containers, usually defining serialized data (html/xml/ymal tags).",
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#00c860" }
        },
        {
            "name": "Comment Tags",
            "scope": [
                "comment.block.documentation entity.name.tag",
                "comment.documentation.name"
            ],
            "settings": { "foreground": "#00c860b0" }
        },
        {
            "name": "Add/Success - Tokens that represent a successful action (add, success, pass, etc.)"
        },
        {
            "name": "Add",
            "scope": ["markup.inserted"],
            "settings": { "foreground": "#00cc06" }
        },
        {
            "name": "Info - Tokens that represent an informational action (info, help, etc.)"
        },
        {
            "name": "Info",
            "scope": ["markup.changed", "token.info-token"],
            "settings": { "foreground": "#00c5ff" }
        },
        {
            "name": "Warning - Tokens that represent a warning action (warning, caution, etc.)"
        },
        {
            "name": "Warning",
            "scope": ["token.warn-token"],
            "settings": { "foreground": "#ff8200" }
        },
        {
            "name": "Error - Tokens that represent an error action (error, fail, etc.)"
        },
        {
            "name": "Invalid",
            "scope": ["token.error-token", "invalid"],
            "settings": { "foreground": "#ff5a39" }
        },
        {
            "name": "Deleted",
            "scope": ["markup.deleted"],
            "settings": { "foreground": "#ff724f" }
        },
        {
            "name": "Functions - Tokens that represent a function call or manipulation of data (function, operator, etc.)"
        },
        {
            "name": "Methods - Functions that are defined on some type.",
            "scope": [
                "entity.name.function",
                "keyword.command",
                "support.function.transform",
                "meta.function-call.generic"
            ],
            "settings": { "foreground": "#b9a600" }
        },
        {
            "name": "Special Token Operators - Non word tokens that should be displayed with a special style (accessors, null-conditional, etc.). Usually used to help show operator vs separators.",
            "scope": [
                "punctuation.accessor",
                "punctuation.separator.pointer-access",
                "punctuation.definition.typeparameters",
                "punctuation.section.angle-brackets",
                "punctuation.separator.scope-resolution",
                "punctuation.definition.evaluation",
                "keyword.operator.null-conditional"
            ],
            "settings": { "foreground": "#e3d763", "fontStyle": "italic" }
        },
        {
            "name": "Basic Token Operator - Non word tokens that are common enough or clear usage to be displayed with a basic style (math, assignment, etc.).",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#d4d4d4", "fontStyle": "" }
        },
        {
            "name": "Word Operator - Keyword operators that are used to manipulate data (or, new, sizeof, etc.)",
            "scope": [
                "entity.name.function keyword",
                "keyword.operator.new",
                "keyword.operator.expression",
                "keyword.operator.cast",
                "keyword.operator.sizeof",
                "keyword.operator.alignof",
                "keyword.operator.typeid",
                "keyword.operator.alignas",
                "keyword.operator.instanceof",
                "keyword.operator.logical.python",
                "keyword.operator.wordlike",
                "keyword.other.typeof",
                "keyword.other.is",
                "keyword.other.as",
                "keyword.other.new",
                "keyword.query",
                "keyword.other.get",
                "keyword.other.set",
                "keyword.other.init",
                "entity.other.keyframe-offset",
                "keyword.operator.logical"
            ],
            "settings": { "foreground": "#ff7100" }
        },
        {
            "name": "Strings - Tokens that represent a string or string like value (string, character, regex, etc.)"
        },
        {
            "name": "String Body - The text of a string, without the quotes or delimiters.",
            "scope": [
                "meta.embedded.assembly",
                "string.quoted.double",
                "string.quoted.single",
                "string.tag",
                "string.value",
                "markup.quote",
                "markup.inline.raw",
                "markup.fenced_code.block",
                "string.unquoted.plain"
            ],
            "settings": { "foreground": "#ffbca5" }
        },
        {
            "name": "Regexp Body - The text of a regular expression, without the delimiters.",
            "scope": ["string.regexp"],
            "settings": { "foreground": "#ff8d8f" }
        },
        {
            "name": "Escape Chars - The escape characters of a string (\n, \\, etc.)",
            "scope": [
                "constant.character.escape",
                "string.quoted.single.cs",
                "constant.character.entity",
                "constant.character.entity punctuation.definition.constant"
            ],
            "settings": { "foreground": "#ff724f", "fontStyle": "bold" }
        },
        {
            "name": "String Punctuation - The punctuation of a string (quotes, delimiters, etc.)",
            "scope": [
                "punctuation.definition.string.begin",
                "punctuation.definition.string.end",
                "punctuation.definition.char.begin",
                "punctuation.definition.char.end",
                "punctuation.definition.quote.begin.markdown",
                "punctuation.definition.link",
                "punctuation.definition.raw",
                "markup.fenced_code.block punctuation.definition",
                "storage.type.string.python"
            ],
            "settings": { "foreground": "#ffbbb7", "fontStyle": "italic" }
        },
        { "name": "Numbers" },
        {
            "name": "Numeric Body - Tokens that represent a numeric value (int, float, double, etc.)",
            "scope": [
                "constant.numeric",
                "keyword.operator.plus.exponent",
                "keyword.operator.minus.exponent",
                "constant.other.color"
            ],
            "settings": { "foreground": "#f1d268" }
        },
        {
            "name": "Numeric Fix - Suffixes, preffixes, and delimiters of a numeric value (0x, 0b, _, f, UL, etc.)",
            "scope": [
                "constant.numeric.other.suffix",
                "constant.numeric.other.preffix",
                "constant.numeric.other.separator.thousands",
                "keyword.other.unit",
                "constant.language",
                "punctuation.definition.constant"
            ],
            "settings": { "foreground": "#e5b800", "fontStyle": "italic" }
        },
        {
            "name": "Enum Value - The value of an enum member (not the name)",
            "scope": [
                "entity.name.variable.enum-member",
                "variable.other.enummember"
            ],
            "settings": { "foreground": "#d4db66", "fontStyle": "bold" }
        },
        {
            "name": "Variables - Tokens that represent a variable or reference to a variable (variable, property, etc.)"
        },
        {
            "name": "Constants Keywords - Variables that are declared as readonly (const, static final, readonly, etc.)",
            "scope": [
                "keyword.other.this",
                "variable.language.this",
                "variable.language.super",
                "support.constant.property-value",
                "variable.language.special.self",
                "keyword.other.base"
            ],
            "settings": { "fontStyle": "italic bold" }
        },
        {
            "name": "Constants - Variables that are declared as readonly (const, static final, readonly, etc.)",
            "scope": ["variable.other.constant"],
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Unknown Variable - Variables that are not identified as a specific variable type",
            "scope": [
                "variable.other.object",
                "variable.other.readwrite",
                "variable.other.definition.java"
            ],
            "settings": { "foreground": "#00d0ff" }
        },
        {
            "name": "Local Variables - Variables that are not attached to a specific referable scope (confined usually temporary scope)",
            "scope": [
                "entity.name.variable.local",
                "entity.name.variable.parameter",
                "meta.function-call.arguments",
                "variable.parameter",
                "variable.other.constant",
                "support.constant.property-value",
                "source.shell variable.other",
                "string.unquoted.argument.shell",
                "meta.flow-pair.key entity.name.tag",
                "meta.flow-pair.key constant.language.boolean.yaml"
            ],
            "settings": { "foreground": "#4fe8ed" }
        },
        {
            "name": "Fields - Variables that are attached to an object that are not generally watched properties",
            "scope": [
                "support.type.vendored.property-name",
                "support.type.property-name",
                "variable.css",
                "variable.scss",
                "variable.other.less",
                "source.coffee.embedded",
                "entity.other.attribute-name",
                "meta.structure.dictionary.key.python",
                "entity.name.variable.field",
                "meta.object-literal.key",
                "meta.attribute"
            ],
            "settings": { "foreground": "#00d0ff" }
        },
        {
            "name": "Property - Variables that are usually scope limited or have getters/setters",
            "scope": [
                "entity.name.variable.property",
                "variable.other.object.property",
                "keyword.other.this",
                "variable.language.this",
                "variable.language.super",
                "variable.other.property",
                "variable.object.property",
                "variable.language.special.self",
                "keyword.other.base",
                "variable.other.constant.property"
            ],
            "settings": { "foreground": "#0085e3" }
        },
        {
            "name": "Comment Attribute",
            "scope": ["comment entity.other.attribute-name"],
            "settings": { "foreground": "#00d0ffb0" }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "*.deprecated": { "strikethrough": true },
        "*.static": { "italic": true },
        "*.readonly": { "bold": true },
        "constant": { "bold": true }
    },
    "$schema": "vscode://schemas/color-theme"
}
