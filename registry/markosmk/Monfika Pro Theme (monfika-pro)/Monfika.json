        {
            "scope": ["entity.name.function"],
            "settings": { "foreground": "#a9dc76" }
        },
        {
            "scope": "\n\t\tentity.other.git-status.hex\n\t",
            "settings": { "foreground": "#9F90ED" }
        },
        { "scope": "invalid", "settings": { "fontStyle": "italic" } },
        {
            "scope": ["keyword", "keyword.control", "keyword.operator"],
            "settings": { "foreground": "#ff6188" }
