    "tokenColors": [
        {
            "scope": [
                "comment",
                "comment keyword",
                "comment markup.underline.link",
                "comment string",
                "comment punctuation.definition",
                "comment punctuation",
                "comment text"
            ],
            "settings": { "fontStyle": "italic", "foreground": "#6d767e" }
        },
        {
            "scope": "\n\t\tcomment storage.type\n\t",
            "settings": { "foreground": "#6d767e" }
        },
        {
            "scope": [
                "\n\t\tcomment entity.name.type\n\t",
                "comment variable",
                "comment variable.other"
            ],
            "settings": { "foreground": "#f48e5d" }
        },
        {
            "scope": "\n\t\tcomment keyword.codetag.notation\n\t",
            "settings": { "foreground": "#9F90ED" }
        },
        {
            "scope": "\n\t\tcomment.git-status.header.remote\n\t",
            "settings": { "foreground": "#ff6188" }
        },
        {
            "scope": "\n\t\tcomment.git-status.header.local\n\t",
            "settings": { "foreground": "#79dbe6" }
        },
        {
            "scope": "\n\t\tcomment.other.git-status.head\n\t",
            "settings": { "foreground": "#e9e9e9" }
        },
        { "scope": "constant", "settings": { "foreground": "#9F90ED" } },
        { "scope": "constant.other", "settings": { "foreground": "#9F90ED" } },
        {
            "scope": [
                "constant.other.property",
                "constant.other.color",
                "constant.other.character-class.escape",
                "constant.numeric",
                "constant.other.key"
            ],
            "settings": { "foreground": "#9F90ED" }
        },
        {
            "scope": "constant.other.symbol",
            "settings": { "foreground": "#f48e5d" }
        },
        {
            "scope": ["constant.language", "constant.character.escape"],
            "settings": { "foreground": "#9F90ED" }
        },
        {
            "scope": "constant.numeric.line-number.find-in-files",
            "settings": { "foreground": "#5b595c" }
        },
        {
            "scope": [
                "constant.numeric.line-number.match.find-in-files",
                "entity.name.section"
            ],
            "settings": { "foreground": "#fcd75e" }
        },
        { "scope": "entity.name", "settings": { "foreground": "#a9dc76" } },
        {
            "scope": "entity.name.class",
            "settings": { "foreground": "#e2e2e2" }
        },
        {
            "scope": "entity.name.constant",
            "settings": { "foreground": "#9F90ED" }
        },
        {
            "scope": "entity.name.namespace",
            "settings": { "foreground": "#e2e2e2" }
