    "tokenColors": [
        {
            "name": "Comment, Markup: Quote",
            "scope": [
                "comment",
                "punctuation.definition.comment",
                "string.quoted.docstring.multi.python",
                "string.quoted.docstring.multi.python punctuation.definition.string.begin.python",
                "string.quoted.docstring.multi.python punctuation.definition.string.end.python",
                "markup.quote"
            ],
            "settings": { "fontStyle": "italic", "foreground": "#848BBD" }
        },
        {
            "name": "String, md: link",
            "scope": [
                "string",
                "punctuation.definition.string.begin",
                "punctuation.definition.string.end",
                "markup.underline.link",
                "constant.other.reference.link"
            ],
            "settings": { "foreground": "#b2f8e3", "fontStyle": "italic" }
        },
        {
            "name": "Variables",
            "scope": [
                "variable.other",
                "entity.other.attribute-name",
                "meta.definition.variable",
                "meta.object-literal.key",
                "variable.parameter",
                "meta.block variable.other",
                "variable.object.property",
                "constant.other.caps.python",
                "meta.attribute",
                "variable.other.enummember",
                "meta.import meta.block variable.other.readwrite.alias",
                "variable.other.property",
                "entity.name.type.template.cpp",
                "meta.bracket.square.access",
                "meta.parens",
                "meta.body.function.definition.cpp",
                "variable.other.metavariable",
                "source.css variable",
                "source.css support.type.property-name",
                "source.sass support.type.property-name",
                "source.scss support.type.property-name",
                "source.less support.type.property-name",
                "source.stylus support.type.property-name",
                "source.postcss support.type.property-name"
            ],
            "settings": { "foreground": "#f1c9e5" }
        },
        {
            "name": "Function Argument, Tag Attribute, Embedded",
            "scope": [
                "variable.parameter",
                "meta.tag.attributes",
                "entity.other.attribute-name"
            ],
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "specialVariables",
            "scope": ["support.other.variable"],
            "settings": { "foreground": "#f07178" }
        },
        {
            "name": "Number",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#51c7f5" }
        },
        {
            "name": "Keyword; Storage; md: Heading,bold",
            "scope": [
                "keyword",
                "keyword.other.typedef.c",
                "keyword.control",
                "keyword.other",
                "keyword.operator",
                "storage.type",
                "keyword.other.unit",
                "storage.modifier",
                "punctuation.definition.directive",
                "markdown.heading",
                "heading",
                "markup.heading | markup.heading entity.name",
                "markup.heading.markdown punctuation.definition.heading.markdown",
                "markup.bold"
            ],
            "settings": { "foreground": "#ebe5cd" }
        },
        {
            "name": "md: Heading,bold",
            "scope": [
                "markdown.heading",
                "heading",
                "markup.heading | markup.heading entity.name",
                "markup.heading.markdown punctuation.definition.heading.markdown",
                "markup.bold"
            ],
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Constant",
            "scope": [
                "constant.other",
                "constant.enum",
                "constant.language",
                "support.constant",
                "constant.character",
                "constant.escape",
                "entity.name.function.preprocessor.c"
            ],
            "settings": { "foreground": "#f6d9ca" }
        },
        {
            "name": "Punctuation, text, Plain, md: Fenced Bode Block Variable",
            "scope": [
                "keyword.operator.assignment",
                "keyword.operator.increment",
                "keyword.operator.decrement",
                "keyword.operator.arithmetic",
                "keyword.operator.bitwise",
                "keyword.operator.comparison",
                "punctuation.separator.key-value",
                "punctuation.accessor",
                "text.html.markdown",
                "punctuation.definition.list_item.markdown",
                "markup.raw.block.fenced.markdown",
                "variable.language.fenced.markdown",
                "punctuation.section.class.end"
            ],
            "settings": { "foreground": "#EEFFFF" }
        },
        {
            "name": "Function; Special Method; md: Link Title",
            "scope": [
                "entity.name.function",
                "entity.name.function.cs",
                "entity.name.function.rust",
                "meta.definition.function",
                "keyword.other.operator.overload.cpp",
                "meta.head.function.definition.special.operator-overload.cpp",
                "meta.function-call",
                "variable.function",
                "support.function",
                "keyword.other.special-method",
                "support.class.component",
                "entity.name.function.macro",
                "string.other.link.title.markdown",
                "string.other.link",
                "string.other.link.description.title.markdown"
            ],
            "settings": { "foreground": "#80f7f5" }
        },
        {
            "name": "Class, Tag",
            "scope": [
                "meta.selector entity.name.tag",
                "text.html.derivative entity.name.tag",
                "entity.name.tag.tsx",
                "source.vue entity.name.tag",
                "meta.tag.structure entity.name.tag",
                "entity.name.tag.yaml",
                "entity.name.type",
                "entity.name.type.numeric.rust",
                "storage.type.enum.c",
                "storage.type.built-in",
                "storage.type.union",
                "storage.type.string",
                "storage.type.numeric",
                "storage.type.boolean",
                "keyword.map.go",
                "entity.name.type.primitive",
                "support.type",
                "support.class",
                "support.other.namespace.use.php",
                "meta.use.php",
                "support.other.namespace.php",
                "support.type.sys-types",
                "markup.inline.raw.string"
            ],
            "settings": { "foreground": "#e3b0fb" }
        },
        {
            "name": "self; cls; this; base",
            "scope": [
                "variable.language",
                "variable.parameter.function.language.special.self",
                "variable.parameter.function.language.special.cls",
                "entity.other.attribute-name.pseudo-class",
                "entity.other.attribute-name.pseudo-element",
                "variable.language.special.cls",
                "variable.language.special.self",
                "variable.language.self.rust",
                "keyword.control.other",
                "variable.language.this"
            ],
            "settings": { "foreground": "#e5dff5" }
        },
        {
            "name": "module; CSS Classes",
            "scope": [
                "entity.name.type.module",
                "entity.name.type.package",
                "meta.use entity.name.namespace",
                "entity.name.namespace.cpp",
                "meta.function.definition entity.name.namespace",
                "meta.function.call entity.name.namespace",
                "variable.other.readwrite.alias",
                "entity.other.attribute-name.class"
            ],
            "settings": { "foreground": "#f3a0a5" }
        },
        {
            "name": "md: Table punctuation",
            "scope": [
                "markup.table punctuation.definition.table",
                "punctuation.separator.table"
            ],
            "settings": { "foreground": "#f3a0a5" }
        },
        {
            "name": "Markdown - Markup Raw Inline",
            "scope": ["text.html.markdown markup.inline.raw.markdown"],
            "settings": { "foreground": "#C792EA" }
        },
        {
            "name": "Markdown - Markup Raw Inline Punctuation",
            "scope": [
                "text.html.markdown markup.inline.raw.markdown punctuation.definition.raw.markdown"
            ],
            "settings": { "foreground": "#65737E" }
        },
        { "name": "", "scope": [], "settings": { "foreground": "#C3E88D" } },
        {
            "name": "Markup - Italic",
            "scope": ["markup.italic"],
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "Markup - Bold-Italic",
            "scope": [
                "markup.bold markup.italic",
                "markup.italic markup.bold",
                "markup.quote markup.bold",
                "markup.bold markup.italic string",
                "markup.italic markup.bold string",
                "markup.quote markup.bold string"
            ],
            "settings": { "fontStyle": "bold italic" }
        },
        {
            "name": "Markup - Underline",
            "scope": ["markup.underline"],
            "settings": { "fontStyle": "underline" }
        },
        {
            "name": "Markup - Raw Block",
            "scope": ["markup.raw.block"],
            "settings": { "foreground": "#C792EA" }
        },
        {
            "name": "Markdown - Raw Block Fenced",
            "scope": ["markup.raw.block.fenced.markdown"],
            "settings": { "foreground": "#00000050" }
        },
        {
            "name": "Markdown - Fenced Bode Block",
            "scope": ["punctuation.definition.fenced.markdown"],
            "settings": { "foreground": "#00000050" }
        },
        {
            "name": "Markdown - Fenced Language",
            "scope": ["variable.language.fenced.markdown"],
            "settings": { "foreground": "#65737E" }
        },
        {
            "name": "Markdown - Separator",
            "scope": ["meta.separator"],
            "settings": { "fontStyle": "bold", "foreground": "#65737E" }
        },
        {
            "name": "Colors",
            "scope": ["constant.other.color"],
            "settings": { "foreground": "#ffffff" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#FF5370" }
        },
        {
            "name": "CSS Class and Support",
            "scope": [],
            "settings": { "foreground": "#B2CCD6" }
        },
        {
            "name": "Sub-methods",
            "scope": [
                "entity.name.module.js",
                "variable.import.parameter.js",
                "variable.other.class.js"
            ],
            "settings": { "foreground": "#FF5370" }
        },
        {
            "name": "entity.name.method.js",
            "scope": ["entity.name.method.js"],
            "settings": { "fontStyle": "italic", "foreground": "#82AAFF" }
        },
        {
            "name": "meta.method.js",
            "scope": [
                "meta.class-method.js entity.name.function.js",
                "variable.function.constructor"
            ],
            "settings": { "foreground": "#82AAFF" }
        },
        {
            "name": "HTML Attributes",
            "scope": [
                "text.html.basic entity.other.attribute-name.html",
                "text.html.basic entity.other.attribute-name"
            ],
            "settings": { "fontStyle": "italic", "foreground": "#FFCB6B" }
        },
        {
            "name": "CSS ID's",
            "scope": ["source.sass keyword.control"],
            "settings": { "foreground": "#82AAFF" }
        },
        {
            "name": "Inserted",
            "scope": ["markup.inserted"],
            "settings": { "foreground": "#C3E88D" }
        },
        {
            "name": "Deleted",
            "scope": ["markup.deleted", "punctuation.definition.strikethrough"],
            "settings": { "foreground": "#FF5370" }
        },
        {
            "name": "Changed",
            "scope": ["markup.changed"],
            "settings": { "foreground": "#C792EA" }
        },
        {
            "name": "Regular Expressions",
            "scope": ["string.regexp"],
            "settings": { "foreground": "#89DDFF" }
        },
        {
            "name": "Escape Characters",
            "scope": ["constant.character.escape"],
            "settings": { "foreground": "#89DDFF" }
        },
        {
            "name": "URL",
            "scope": ["*url*", "*link*", "*uri*"],
            "settings": { "fontStyle": "underline" }
        },
        {
            "name": "Decorators",
            "scope": [
                "tag.decorator.js entity.name.tag.js",
                "tag.decorator.js punctuation.definition.tag.js"
            ],
            "settings": { "fontStyle": "italic", "foreground": "#82AAFF" }
        },
        {
            "name": "ES7 Bind Operator",
            "scope": [
                "source.js constant.other.object.key.js string.unquoted.label.js"
            ],
            "settings": { "fontStyle": "italic", "foreground": "#FF5370" }
        },
        {
            "name": "JSON Key - Level 0",
            "scope": [
                "source.json meta.structure.dictionary.json support.type.property-name.json"
            ],
            "settings": { "foreground": "#C792EA" }
