{
    "$schema": "vscode://schemas/color-theme",
    "name": "Vir Forge Dark",
    "type": "dark",
    "colors": {
        "editor.background": "#111111",
        "editor.foreground": "#E5E5E5",
        "editor.lineHighlightBackground": "#1B1B1B",
        "editor.selectionBackground": "#2D2D2D",
        "editorError.foreground": "#FF5370",
        "editorWarning.foreground": "#FFB020",
        "editorInfo.foreground": "#61AFEF",
        "sideBar.background": "#161616",
        "panel.background": "#161616",
        "activityBar.background": "#161616",
        "statusBar.background": "#161616",
        "statusBar.foreground": "#E5E5E5"
    },
    "semanticHighlighting": true,
    "tokenColors": [
        {
            "scope": "keyword.declaration.vri",
            "settings": { "foreground": "#4090C0" }
        },
        {
            "scope": ["keyword.control.vri", "keyword.control.secondary.vri"],
            "settings": { "foreground": "#5098CC" }
        },
        {
            "scope": "keyword.control.include.vri",
            "settings": { "foreground": "#944048", "fontStyle": "bold" }
        },
        {
            "scope": "keyword.control.import.vri",
            "settings": { "foreground": "#C48080" }
        },
        {
            "scope": "keyword.control.error.vri",
            "settings": { "foreground": "#D4887A" }
        },
        {
            "scope": "keyword.control.async.vri",
            "settings": { "foreground": "#A898C4" }
        },
        {
            "scope": "keyword.control.module.vri",
            "settings": { "foreground": "#C4A880" }
        },
        {
            "scope": "keyword.control.messaging.vri",
            "settings": { "foreground": "#8898AC" }
        },
        {
            "scope": "keyword.control.terminator.vri",
            "settings": { "foreground": "#C678DD", "fontStyle": "bold" }
        },
        {
            "scope": "entity.name.function.vri",
            "settings": { "foreground": "#5098CC" }
        },
        {
            "scope": "entity.name.function.call.vri",
            "settings": { "foreground": "#8FC8F8", "fontStyle": "bold" }
        },
        {
            "scope": "entity.name.type.vri",
            "settings": { "foreground": "#56B6C2" }
        },
        {
            "scope": ["storage.type.tensor.vri", "storage.type.scalar.vri"],
            "settings": { "foreground": "#E5C07B" }
        },
        {
            "scope": [
                "support.function.ai.matmul.vri",
                "support.function.ai.embed.vri",
                "support.function.ai.train.vri"
            ],
            "settings": { "foreground": "#61AFEF" }
        },
        {
            "scope": "support.function.ai.grad.vri",
            "settings": { "foreground": "#98C379" }
        },
        {
            "scope": [
                "support.function.intrinsic.grade-s.simd.vri",
                "support.function.intrinsic.grade-s.matmul.vri",
                "support.function.intrinsic.grade-s.kernel.vri"
            ],
            "settings": { "foreground": "#FF2D6F", "fontStyle": "bold" }
        },
        {
            "scope": [
                "support.function.system.xor.vri",
                "support.function.system.shift.vri"
            ],
            "settings": { "foreground": "#E06C75" }
        },
        {
            "scope": "constant.numeric.vri",
            "settings": { "foreground": "#98C379" }
        },
        {
            "scope": "string.quoted.double.vri",
            "settings": { "foreground": "#D19A66" }
        },
        {
            "scope": "keyword.operator.vri",
            "settings": { "foreground": "#ABB2BF" }
        },
        {
            "scope": [
                "keyword.operator.power.vri",
                "keyword.operator.math-context.vri",
                "keyword.operator.cast.vri"
            ],
            "settings": { "foreground": "#C678DD" }
        },
        {
            "scope": "punctuation.separator.type.vri",
            "settings": { "foreground": "#6B7888" }
        },
        {
            "scope": [
                "comment.block.vri",
                "comment.line.double-slash.vri",
                "comment.line.number-sign.vri"
            ],
            "settings": { "foreground": "#5D9E7F", "fontStyle": "italic" }
        }
    ],
    "semanticTokenColors": {
        "keyword": "#5098CC",
        "importKeyword": "#C48080",
        "includeKeyword": { "foreground": "#944048", "fontStyle": "bold" },
        "terminatorKeyword": { "foreground": "#C678DD", "fontStyle": "bold" },
        "blockOpener": { "foreground": "#C678DD", "fontStyle": "bold" },
        "typeAnnotationColon": "#6B7888",
        "function": "#5098CC",
        "functionCall": { "foreground": "#8FC8F8", "fontStyle": "bold" },
        "functionUnused": "#4B6A80",
        "type": "#E5C07B",
        "number": "#98C379",
        "string": "#D19A66",
        "operator": "#ABB2BF",
        "errorKeyword": "#D4887A",
        "asyncKeyword": "#A898C4",
        "moduleKeyword": "#C4A880",
        "messagingKeyword": "#8898AC",
        "aiOp": "#61AFEF",
        "systemOp": "#E06C75",
        "tensorType": "#E5C07B",
        "shape": "#98C379"
    }
}
