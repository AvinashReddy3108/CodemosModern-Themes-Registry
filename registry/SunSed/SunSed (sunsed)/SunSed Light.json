        "titleBar.activeForeground": "#000000",
        "titleBar.border": "#0000001a",
        "titleBar.inactiveBackground": "#f8f8f8",
        "titleBar.inactiveForeground": "#8b949e",
        "welcomePage.tileBackground": "#f3f3f3",
        "widget.border": "#0000001a"
