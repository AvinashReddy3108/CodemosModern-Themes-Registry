        "editorLineNumber.foreground": "#6e7681",
        "editorOverviewRuler.border": "#0000001a",
        "editorSuggestWidget.background": "#f8f8f8",
        "editorWidget.background": "#ffffff",
        "errorForeground": "#f85149",
        "focusBorder": "#F9DE4A",
        "foreground": "#3b3b3b",
