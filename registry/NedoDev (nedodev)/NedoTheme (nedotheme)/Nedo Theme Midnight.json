    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "fontStyle": "italic", "foreground": "#3a5068" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "string constant.other.placeholder"],
            "settings": { "foreground": "#c8d6e5" }
        },
        {
            "name": "Variable.language",
            "scope": ["variable.language"],
            "settings": { "foreground": "#48b8e0", "fontStyle": "italic" }
        },
        {
            "name": "Variable.parameter",
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#a0b4c8" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#ff6b6b", "fontStyle": "bold" }
        },
        {
            "name": "Keyword",
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#48b8e0", "fontStyle": "bold" }
        },
        {
            "name": "Control flow",
            "scope": ["keyword.control", "keyword.control.flow"],
            "settings": { "foreground": "#5ce0d6", "fontStyle": "bold" }
        },
        {
            "name": "Operator",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#ff6b6b" }
        },
        {
            "name": "Punctuation",
            "scope": ["punctuation"],
            "settings": { "foreground": "#6080a0" }
        },
        {
            "name": "Tag",
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#ff6b6b" }
        },
        {
            "name": "Attribute",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#f0d060" }
        },
        {
            "name": "HTML Attribute",
            "scope": ["text.html.basic entity.other.attribute-name"],
            "settings": { "foreground": "#f0d060", "fontStyle": "italic" }
        },
        {
            "name": "Function",
            "scope": [
                "entity.name.function",
                "variable.function",
                "support.function"
            ],
            "settings": { "foreground": "#e0e8f0", "fontStyle": "bold" }
        },
        {
            "name": "Method",
            "scope": ["entity.name.method"],
            "settings": { "foreground": "#e0e8f0", "fontStyle": "bold" }
        },
        {
            "name": "Class",
            "scope": [
                "entity.name",
                "entity.name.class",
                "entity.name.type.class",
                "support.class"
            ],
            "settings": { "foreground": "#5ce0d6", "fontStyle": "bold" }
        },
        {
            "name": "Type",
            "scope": ["support.type", "entity.name.type"],
            "settings": { "foreground": "#48b8e0" }
        },
        {
            "name": "Number",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#f0a04b" }
        },
        {
            "name": "Boolean / null",
            "scope": ["constant.language"],
            "settings": { "foreground": "#ff6b6b", "fontStyle": "bold" }
        },
        {
            "name": "Constant",
            "scope": ["constant", "support.constant"],
            "settings": { "foreground": "#f0d060" }
        },
        {
            "name": "String",
            "scope": ["string"],
            "settings": { "foreground": "#5ce0a0" }
        },
        {
            "name": "String escape",
            "scope": ["constant.character.escape", "string.regexp"],
            "settings": { "foreground": "#48b8e0" }
        },
        {
            "name": "Template string",
            "scope": [
                "string.template",
                "punctuation.definition.template-expression"
            ],
            "settings": { "foreground": "#80f0b8" }
        },
        {
            "name": "CSS Property",
            "scope": [
                "source.css support.type.property-name",
                "source.scss support.type.property-name",
                "source.less support.type.property-name"
            ],
            "settings": { "foreground": "#c490f0" }
        },
        {
            "name": "CSS Value",
            "scope": ["support.constant.property-value"],
            "settings": { "foreground": "#5ce0d6" }
        },
        {
            "name": "CSS ID",
            "scope": ["entity.other.attribute-name.id.css"],
            "settings": { "foreground": "#48b8e0", "fontStyle": "bold" }
        },
        {
            "name": "CSS Class",
            "scope": ["entity.other.attribute-name.class.css"],
            "settings": { "foreground": "#f0d060" }
        },
        {
            "name": "Decorator",
            "scope": ["meta.decorator", "punctuation.decorator"],
            "settings": { "foreground": "#f0a04b", "fontStyle": "italic" }
        },
        {
            "name": "Import / Export",
            "scope": [
                "keyword.control.import",
                "keyword.control.export",
                "keyword.control.from"
            ],
            "settings": { "foreground": "#48b8e0", "fontStyle": "bold" }
        },
        {
            "name": "Inserted",
            "scope": ["markup.inserted"],
            "settings": { "foreground": "#5ce0a0" }
        },
        {
            "name": "Deleted",
            "scope": ["markup.deleted"],
            "settings": { "foreground": "#ff6b6b" }
        },
        {
            "name": "Changed",
            "scope": ["markup.changed"],
            "settings": { "foreground": "#f0d060" }
        },
        {
            "name": "URL",
            "scope": ["*url*", "*link*", "*uri*"],
            "settings": { "fontStyle": "underline", "foreground": "#48b8e0" }
        },
        {
            "name": "Markdown Heading",
            "scope": ["markup.heading", "markup.heading entity.name"],
            "settings": { "foreground": "#5ce0d6", "fontStyle": "bold" }
        },
        {
            "name": "Markup Bold",
            "scope": ["markup.bold"],
            "settings": { "fontStyle": "bold", "foreground": "#f0d060" }
        },
        {
            "name": "Markup Italic",
            "scope": ["markup.italic"],
            "settings": { "fontStyle": "italic", "foreground": "#48b8e0" }
        },
        {
            "name": "Markdown Code",
            "scope": ["markup.inline.raw.markdown", "markup.raw.block"],
            "settings": { "foreground": "#5ce0a0" }
        },
        {
            "name": "JSON Key 0",
            "scope": [
                "source.json meta.structure.dictionary.json support.type.property-name.json"
            ],
            "settings": { "foreground": "#48b8e0" }
        },
        {
            "name": "JSON Key 1",
            "scope": [
                "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
            ],
            "settings": { "foreground": "#f0d060" }
        },
        {
            "name": "JSON Key 2",
            "scope": [
                "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
            ],
            "settings": { "foreground": "#5ce0a0" }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "namespace": "#5ce0d6",
        "class": { "foreground": "#5ce0d6", "bold": true },
        "interface": { "foreground": "#48b8e0", "italic": true },
        "enum": { "foreground": "#f0d060", "bold": true },
        "enumMember": "#f0d060",
        "function": { "foreground": "#e0e8f0", "bold": true },
        "method": { "foreground": "#e0e8f0", "bold": true },
        "property": "#c8d6e5",
        "variable": "#c8d6e5",
        "parameter": "#a0b4c8",
        "typeParameter": { "foreground": "#48b8e0", "italic": true },
        "keyword": { "foreground": "#48b8e0", "bold": true },
        "string": "#5ce0a0",
        "number": "#f0a04b",
        "regexp": "#48b8e0",
        "decorator": { "foreground": "#f0a04b", "italic": true },
        "comment": { "foreground": "#3a5068", "italic": true },
        "type": "#48b8e0",
        "struct": { "foreground": "#5ce0d6", "bold": true },
        "variable.readonly": { "foreground": "#f0d060" },
        "property.readonly": { "foreground": "#f0d060" }
    },
    "$schema": "vscode://schemas/color-theme"
}
