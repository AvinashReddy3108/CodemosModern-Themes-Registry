    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "fontStyle": "italic", "foreground": "#553366" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "string constant.other.placeholder"],
            "settings": { "foreground": "#f0e0ff" }
        },
        {
            "name": "Variable.language",
            "scope": ["variable.language"],
            "settings": { "foreground": "#dd66ff", "fontStyle": "italic" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#ff0066", "fontStyle": "bold" }
        },
        {
            "name": "Keyword",
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#ff00ff", "fontStyle": "bold" }
        },
        {
            "name": "Control flow",
            "scope": ["keyword.control"],
            "settings": { "foreground": "#ff44cc", "fontStyle": "bold" }
        },
        {
            "name": "Operator",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#ff0066" }
        },
        {
            "name": "Punctuation",
            "scope": ["punctuation"],
            "settings": { "foreground": "#774488" }
        },
        {
            "name": "Tag",
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#ff0066" }
        },
        {
            "name": "Attribute",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#ff00ff" }
        },
        {
            "name": "Function",
            "scope": [
                "entity.name.function",
                "variable.function",
                "support.function"
            ],
            "settings": { "foreground": "#ffffff", "fontStyle": "bold" }
        },
        {
            "name": "Class",
            "scope": ["entity.name", "entity.name.class", "support.class"],
            "settings": { "foreground": "#dd66ff", "fontStyle": "bold" }
        },
        {
            "name": "Type",
            "scope": ["support.type", "entity.name.type"],
            "settings": { "foreground": "#aa00ff" }
        },
        {
            "name": "Number",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#ff44cc" }
        },
        {
            "name": "Boolean / null",
            "scope": ["constant.language"],
            "settings": { "foreground": "#ff0066", "fontStyle": "bold" }
        },
        {
            "name": "Constant",
            "scope": ["constant", "support.constant"],
            "settings": { "foreground": "#ff44cc" }
        },
        {
            "name": "String",
            "scope": ["string"],
            "settings": { "foreground": "#cc66ff" }
        },
        {
            "name": "String escape",
            "scope": ["constant.character.escape", "string.regexp"],
            "settings": { "foreground": "#ff00ff" }
        },
        {
            "name": "CSS Property",
            "scope": ["source.css support.type.property-name"],
            "settings": { "foreground": "#ff44cc" }
        },
        {
            "name": "Decorator",
            "scope": ["meta.decorator"],
            "settings": { "foreground": "#ff0066", "fontStyle": "italic" }
        },
        {
            "name": "Markdown Heading",
            "scope": ["markup.heading"],
            "settings": { "foreground": "#ff00ff", "fontStyle": "bold" }
        },
        {
            "name": "Markup Bold",
            "scope": ["markup.bold"],
            "settings": { "fontStyle": "bold", "foreground": "#ff44cc" }
        },
        {
            "name": "JSON Key 0",
            "scope": [
                "source.json meta.structure.dictionary.json support.type.property-name.json"
            ],
            "settings": { "foreground": "#ff00ff" }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "class": { "foreground": "#dd66ff", "bold": true },
        "interface": { "foreground": "#aa00ff", "italic": true },
        "enum": { "foreground": "#ff44cc", "bold": true },
        "function": { "foreground": "#ffffff", "bold": true },
        "method": { "foreground": "#ffffff", "bold": true },
        "keyword": { "foreground": "#ff00ff", "bold": true },
        "string": "#cc66ff",
        "number": "#ff44cc",
        "variable.readonly": { "foreground": "#ff44cc" },
        "property.readonly": { "foreground": "#ff44cc" }
    },
    "$schema": "vscode://schemas/color-theme"
}
