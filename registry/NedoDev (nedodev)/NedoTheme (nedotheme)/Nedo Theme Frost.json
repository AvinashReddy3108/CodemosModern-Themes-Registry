        "quickInput.background": "#ffffff",
        "quickInput.foreground": "#1c2e3e",
        "quickInputList.focusBackground": "#1870a020",
        "focusBorder": "#1870a0",
        "foreground": "#1c2e3e",
        "selection.background": "#1870a040",
        "descriptionForeground": "#607080",
        "errorForeground": "#c03030",
        "icon.foreground": "#607080"
    },
    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "fontStyle": "italic", "foreground": "#8898a8" }
        },
        {
            "name": "Variables",
            "scope": ["variable"],
            "settings": { "foreground": "#1c2e3e" }
        },
        {
            "name": "Variable.language",
            "scope": ["variable.language"],
            "settings": { "foreground": "#1870a0", "fontStyle": "italic" }
        },
        {
            "name": "Variable.parameter",
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#2c4058" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#c03030", "fontStyle": "bold" }
        },
        {
            "name": "Keyword",
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#1870a0", "fontStyle": "bold" }
        },
        {
            "name": "Control flow",
            "scope": ["keyword.control"],
            "settings": { "foreground": "#2888c0", "fontStyle": "bold" }
        },
        {
            "name": "Operator",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#c03030" }
        },
        {
            "name": "Punctuation",
            "scope": ["punctuation"],
            "settings": { "foreground": "#7090a8" }
        },
        {
            "name": "Tag",
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#c03030" }
        },
        {
            "name": "Attribute",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#8a6800", "fontStyle": "italic" }
        },
        {
            "name": "Function",
            "scope": [
                "entity.name.function",
                "variable.function",
                "support.function"
            ],
            "settings": { "foreground": "#0c1e2e", "fontStyle": "bold" }
        },
        {
            "name": "Class",
            "scope": ["entity.name", "entity.name.class", "support.class"],
            "settings": { "foreground": "#187888", "fontStyle": "bold" }
        },
        {
            "name": "Type",
            "scope": ["support.type", "entity.name.type"],
            "settings": { "foreground": "#1870a0" }
        },
        {
            "name": "Number",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#8848a0" }
        },
        {
            "name": "Boolean / null",
            "scope": ["constant.language"],
            "settings": { "foreground": "#c03030", "fontStyle": "bold" }
        },
        {
            "name": "Constant",
            "scope": ["constant", "support.constant"],
            "settings": { "foreground": "#8a6800" }
        },
        {
            "name": "String",
            "scope": ["string"],
            "settings": { "foreground": "#2a7848" }
        },
        {
            "name": "String escape",
            "scope": ["constant.character.escape", "string.regexp"],
            "settings": { "foreground": "#1870a0" }
        },
        {
            "name": "Template string",
            "scope": ["string.template"],
            "settings": { "foreground": "#38905c" }
        },
        {
            "name": "CSS Property",
            "scope": [
                "source.css support.type.property-name",
                "source.scss support.type.property-name",
                "source.less support.type.property-name"
            ],
            "settings": { "foreground": "#8848a0" }
        },
        {
            "name": "CSS Value",
            "scope": ["support.constant.property-value"],
            "settings": { "foreground": "#187888" }
        },
        {
            "name": "CSS Class",
            "scope": ["entity.other.attribute-name.class.css"],
            "settings": { "foreground": "#8a6800" }
        },
        {
            "name": "Decorator",
            "scope": ["meta.decorator"],
            "settings": { "foreground": "#a08000", "fontStyle": "italic" }
        },
        {
            "name": "Import / Export",
            "scope": [
                "keyword.control.import",
                "keyword.control.export",
                "keyword.control.from"
            ],
            "settings": { "foreground": "#1870a0", "fontStyle": "bold" }
        },
        {
            "name": "Inserted",
            "scope": ["markup.inserted"],
            "settings": { "foreground": "#2a7848" }
        },
        {
            "name": "Deleted",
            "scope": ["markup.deleted"],
            "settings": { "foreground": "#c03030" }
        },
        {
            "name": "Changed",
            "scope": ["markup.changed"],
            "settings": { "foreground": "#8a6800" }
        },
        {
            "name": "URL",
            "scope": ["*url*", "*link*", "*uri*"],
            "settings": { "fontStyle": "underline", "foreground": "#1870a0" }
        },
        {
            "name": "Markdown Heading",
            "scope": ["markup.heading"],
            "settings": { "foreground": "#1870a0", "fontStyle": "bold" }
        },
        {
            "name": "Markup Bold",
            "scope": ["markup.bold"],
            "settings": { "fontStyle": "bold", "foreground": "#0c1e2e" }
        },
        {
            "name": "Markup Italic",
            "scope": ["markup.italic"],
            "settings": { "fontStyle": "italic", "foreground": "#1870a0" }
        },
        {
            "name": "Markdown Code",
            "scope": ["markup.inline.raw.markdown", "markup.raw.block"],
            "settings": { "foreground": "#2a7848" }
        },
        {
            "name": "JSON Key 0",
            "scope": [
                "source.json meta.structure.dictionary.json support.type.property-name.json"
            ],
            "settings": { "foreground": "#1870a0" }
        },
        {
            "name": "JSON Key 1",
            "scope": [
                "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
            ],
            "settings": { "foreground": "#8a6800" }
        },
        {
            "name": "JSON Key 2",
            "scope": [
                "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
            ],
            "settings": { "foreground": "#2a7848" }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "namespace": "#187888",
        "class": { "foreground": "#187888", "bold": true },
        "interface": { "foreground": "#1870a0", "italic": true },
        "enum": { "foreground": "#8a6800", "bold": true },
        "enumMember": "#8a6800",
        "function": { "foreground": "#0c1e2e", "bold": true },
        "method": { "foreground": "#0c1e2e", "bold": true },
        "property": "#1c2e3e",
        "variable": "#1c2e3e",
        "parameter": "#2c4058",
        "typeParameter": { "foreground": "#1870a0", "italic": true },
        "keyword": { "foreground": "#1870a0", "bold": true },
        "string": "#2a7848",
        "number": "#8848a0",
        "regexp": "#1870a0",
        "decorator": { "foreground": "#a08000", "italic": true },
        "comment": { "foreground": "#8898a8", "italic": true },
        "type": "#1870a0",
        "struct": { "foreground": "#187888", "bold": true },
        "variable.readonly": { "foreground": "#8a6800" },
        "property.readonly": { "foreground": "#8a6800" }
    },
    "$schema": "vscode://schemas/color-theme"
}
