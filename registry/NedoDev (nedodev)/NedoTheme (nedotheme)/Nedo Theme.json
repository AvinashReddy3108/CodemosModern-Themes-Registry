    "tokenColors": [
        {
            "name": "Comment — серый, как наша жизнь",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "fontStyle": "italic", "foreground": "#555555" }
        },
        {
            "name": "TODO/FIXME в комментах — жёлтый",
            "scope": ["comment.line keyword", "meta.preprocessor.todo"],
            "settings": { "foreground": "#e8ff00", "fontStyle": "italic bold" }
        },
        {
            "name": "Variables — белый",
            "scope": ["variable", "string constant.other.placeholder"],
            "settings": { "foreground": "#e0e0e0" }
        },
        {
            "name": "Variable — this/self — синий",
            "scope": ["variable.language"],
            "settings": { "foreground": "#00b4ff", "fontStyle": "italic" }
        },
        {
            "name": "Variable Parameter — светлее",
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#cccccc" }
        },
        {
            "name": "Invalid — красный жирный",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#ff0040", "fontStyle": "bold" }
        },
        {
            "name": "Keyword, Storage — кислотно-синий",
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#00b4ff", "fontStyle": "bold" }
        },
        {
            "name": "Control flow — ярко-синий",
            "scope": ["keyword.control", "keyword.control.flow"],
            "settings": { "foreground": "#00d4ff", "fontStyle": "bold" }
        },
        {
            "name": "Operator — красный",
            "scope": [
                "keyword.operator",
                "keyword.operator.assignment",
                "keyword.operator.arithmetic",
                "keyword.operator.comparison",
                "keyword.operator.logical"
            ],
            "settings": { "foreground": "#ff0040" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation",
                "punctuation.separator",
                "punctuation.terminator",
                "punctuation.accessor"
            ],
            "settings": { "foreground": "#888888" }
        },
        {
            "name": "Tag — красный",
            "scope": [
                "entity.name.tag",
                "meta.tag.sgml",
                "markup.deleted.git_gutter"
            ],
            "settings": { "foreground": "#ff0040" }
        },
        {
            "name": "Tag Attribute — жёлтый",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#e8ff00" }
        },
        {
            "name": "HTML Attributes — жёлтый курсив",
            "scope": [
                "text.html.basic entity.other.attribute-name.html",
                "text.html.basic entity.other.attribute-name"
            ],
            "settings": { "fontStyle": "italic", "foreground": "#e8ff00" }
        },
        {
            "name": "Function — ярко-белый",
            "scope": [
                "entity.name.function",
                "variable.function",
                "support.function"
            ],
            "settings": { "foreground": "#ffffff", "fontStyle": "bold" }
        },
        {
            "name": "Function call — чуть тусклее",
            "scope": ["meta.function-call"],
            "settings": { "foreground": "#f0f0f0" }
        },
        {
            "name": "Method — жирный белый",
            "scope": ["entity.name.method", "entity.name.method.js"],
            "settings": { "foreground": "#ffffff", "fontStyle": "bold" }
        },
        {
            "name": "Class — бирюзовый",
            "scope": [
                "entity.name",
                "entity.name.class",
                "entity.name.type.class",
                "support.class"
            ],
            "settings": { "foreground": "#00ffcc", "fontStyle": "bold" }
        },
        {
            "name": "Type — голубой",
            "scope": [
                "support.type",
                "entity.name.type",
                "entity.name.type.interface",
                "entity.name.type.alias"
            ],
            "settings": { "foreground": "#00b4ff" }
        },
        {
            "name": "Number — жёлтый",
            "scope": ["constant.numeric", "constant.language.numeric"],
            "settings": { "foreground": "#e8ff00" }
        },
        {
            "name": "Boolean / null / undefined — красный",
            "scope": ["constant.language"],
            "settings": { "foreground": "#ff0040", "fontStyle": "bold" }
        },
        {
            "name": "Constant — жёлтый",
            "scope": [
                "constant",
                "support.constant",
                "constant.character",
                "constant.escape"
            ],
            "settings": { "foreground": "#e8ff00" }
        },
        {
            "name": "String — зелёный",
            "scope": ["string"],
            "settings": { "foreground": "#00ff88" }
        },
        {
            "name": "String escape — голубой",
            "scope": ["constant.character.escape", "string.regexp"],
            "settings": { "foreground": "#00b4ff" }
        },
        {
            "name": "Template string — немного светлее",
            "scope": [
                "string.template",
                "punctuation.definition.template-expression"
            ],
            "settings": { "foreground": "#33ff99" }
        },
        {
            "name": "CSS Property — розовый",
            "scope": [
                "source.css support.type.property-name",
                "source.sass support.type.property-name",
                "source.scss support.type.property-name",
                "source.less support.type.property-name",
                "source.stylus support.type.property-name",
                "source.postcss support.type.property-name"
            ],
            "settings": { "foreground": "#ff66cc" }
        },
        {
            "name": "CSS Value",
            "scope": ["support.constant.property-value"],
            "settings": { "foreground": "#00ffcc" }
        },
        {
            "name": "CSS ID — синий жирный",
            "scope": ["entity.other.attribute-name.id.css"],
            "settings": { "foreground": "#00b4ff", "fontStyle": "bold" }
        },
        {
            "name": "CSS Class — жёлтый",
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.class"
            ],
            "settings": { "foreground": "#e8ff00" }
        },
        {
            "name": "Decorator — оранжевый",
            "scope": [
                "meta.decorator",
                "tag.decorator.js entity.name.tag.js",
                "tag.decorator.js punctuation.definition.tag.js",
                "punctuation.decorator"
            ],
            "settings": { "foreground": "#ff6600", "fontStyle": "italic" }
        },
        {
            "name": "Import / Export — синий",
            "scope": [
                "keyword.control.import",
                "keyword.control.export",
                "keyword.control.from"
            ],
            "settings": { "foreground": "#00b4ff", "fontStyle": "bold" }
        },
        {
            "name": "Inserted — зелёный",
            "scope": ["markup.inserted"],
            "settings": { "foreground": "#00ff88" }
        },
        {
            "name": "Deleted — красный",
            "scope": ["markup.deleted"],
            "settings": { "foreground": "#ff0040" }
        },
        {
            "name": "Changed — жёлтый",
            "scope": ["markup.changed"],
            "settings": { "foreground": "#e8ff00" }
        },
        {
            "name": "URL — подчёркнутый голубой",
            "scope": ["*url*", "*link*", "*uri*"],
            "settings": { "fontStyle": "underline", "foreground": "#00b4ff" }
        },
        {
            "name": "Markdown - Heading — жёлтый жирный",
            "scope": [
                "markup.heading",
                "markup.heading entity.name",
                "markup.heading.markdown punctuation.definition.heading.markdown"
            ],
            "settings": { "foreground": "#e8ff00", "fontStyle": "bold" }
        },
        {
            "name": "Markup - Bold — жёлтый жирный",
            "scope": ["markup.bold", "markup.bold string"],
            "settings": { "fontStyle": "bold", "foreground": "#e8ff00" }
        },
        {
            "name": "Markup - Italic — синий курсив",
            "scope": ["markup.italic"],
            "settings": { "fontStyle": "italic", "foreground": "#00b4ff" }
        },
        {
            "name": "Markdown - Link — голубой",
            "scope": ["string.other.link.title.markdown"],
            "settings": { "foreground": "#00b4ff" }
        },
        {
            "name": "Markdown - Code — зелёный",
            "scope": ["markup.inline.raw.markdown", "markup.raw.block"],
            "settings": { "foreground": "#00ff88" }
        },
        {
            "name": "Markdown Plain",
            "scope": [
                "text.html.markdown",
                "punctuation.definition.list_item.markdown"
            ],
            "settings": { "foreground": "#cccccc" }
        },
        {
            "name": "JSON Key Level 0 — синий",
            "scope": [
                "source.json meta.structure.dictionary.json support.type.property-name.json"
            ],
            "settings": { "foreground": "#00b4ff" }
        },
        {
            "name": "JSON Key Level 1 — жёлтый",
            "scope": [
