    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "fontStyle": "italic", "foreground": "#3d5848" }
        },
        {
            "name": "Variables",
            "scope": ["variable"],
            "settings": { "foreground": "#c8d8c8" }
        },
        {
            "name": "Variable.language",
            "scope": ["variable.language"],
            "settings": { "foreground": "#50b0a0", "fontStyle": "italic" }
        },
        {
            "name": "Variable.parameter",
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#98b8a0" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#c85050", "fontStyle": "bold" }
        },
        {
            "name": "Keyword",
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#5cb878", "fontStyle": "bold" }
        },
        {
            "name": "Control flow",
            "scope": ["keyword.control"],
            "settings": { "foreground": "#7cc890", "fontStyle": "bold" }
        },
        {
            "name": "Operator",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#c85050" }
        },
        {
            "name": "Punctuation",
            "scope": ["punctuation"],
            "settings": { "foreground": "#688878" }
        },
        {
            "name": "Tag",
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#c85050" }
        },
        {
            "name": "Attribute",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#d4a050" }
        },
        {
            "name": "Function",
            "scope": [
                "entity.name.function",
                "variable.function",
                "support.function"
            ],
            "settings": { "foreground": "#d8e8d8", "fontStyle": "bold" }
        },
        {
            "name": "Class",
            "scope": ["entity.name", "entity.name.class", "support.class"],
            "settings": { "foreground": "#50b0a0", "fontStyle": "bold" }
        },
        {
            "name": "Type",
            "scope": ["support.type", "entity.name.type"],
            "settings": { "foreground": "#5098c0" }
        },
        {
            "name": "Number",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#b070a0" }
        },
        {
            "name": "Boolean / null",
            "scope": ["constant.language"],
            "settings": { "foreground": "#c85050", "fontStyle": "bold" }
        },
        {
            "name": "Constant",
            "scope": ["constant", "support.constant"],
            "settings": { "foreground": "#d4a050" }
        },
        {
            "name": "String",
            "scope": ["string"],
            "settings": { "foreground": "#80d098" }
        },
        {
            "name": "String escape",
            "scope": ["constant.character.escape", "string.regexp"],
            "settings": { "foreground": "#5098c0" }
        },
        {
            "name": "Template string",
            "scope": ["string.template"],
            "settings": { "foreground": "#98d8a8" }
        },
        {
            "name": "CSS Property",
            "scope": [
                "source.css support.type.property-name",
                "source.scss support.type.property-name",
                "source.less support.type.property-name"
            ],
            "settings": { "foreground": "#b070a0" }
        },
        {
            "name": "CSS Value",
            "scope": ["support.constant.property-value"],
            "settings": { "foreground": "#50b0a0" }
        },
        {
            "name": "CSS Class",
            "scope": ["entity.other.attribute-name.class.css"],
            "settings": { "foreground": "#d4a050" }
        },
        {
            "name": "Decorator",
            "scope": ["meta.decorator"],
            "settings": { "foreground": "#d4a050", "fontStyle": "italic" }
        },
        {
            "name": "Import / Export",
            "scope": [
                "keyword.control.import",
                "keyword.control.export",
                "keyword.control.from"
            ],
            "settings": { "foreground": "#5cb878", "fontStyle": "bold" }
        },
        {
            "name": "Inserted",
            "scope": ["markup.inserted"],
            "settings": { "foreground": "#5cb878" }
        },
        {
            "name": "Deleted",
            "scope": ["markup.deleted"],
            "settings": { "foreground": "#c85050" }
        },
        {
            "name": "Changed",
            "scope": ["markup.changed"],
            "settings": { "foreground": "#d4a050" }
        },
        {
            "name": "URL",
            "scope": ["*url*", "*link*", "*uri*"],
            "settings": { "fontStyle": "underline", "foreground": "#5098c0" }
        },
        {
            "name": "Markdown Heading",
            "scope": ["markup.heading"],
            "settings": { "foreground": "#7cc890", "fontStyle": "bold" }
        },
        {
            "name": "Markup Bold",
            "scope": ["markup.bold"],
            "settings": { "fontStyle": "bold", "foreground": "#d4a050" }
        },
        {
            "name": "Markup Italic",
            "scope": ["markup.italic"],
            "settings": { "fontStyle": "italic", "foreground": "#5098c0" }
        },
        {
            "name": "Markdown Code",
            "scope": ["markup.inline.raw.markdown", "markup.raw.block"],
            "settings": { "foreground": "#80d098" }
        },
        {
            "name": "JSON Key 0",
            "scope": [
                "source.json meta.structure.dictionary.json support.type.property-name.json"
            ],
            "settings": { "foreground": "#5cb878" }
        },
        {
            "name": "JSON Key 1",
            "scope": [
                "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
            ],
            "settings": { "foreground": "#d4a050" }
        },
        {
            "name": "JSON Key 2",
            "scope": [
                "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
            ],
            "settings": { "foreground": "#50b0a0" }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "namespace": "#50b0a0",
        "class": { "foreground": "#50b0a0", "bold": true },
        "interface": { "foreground": "#5098c0", "italic": true },
        "enum": { "foreground": "#d4a050", "bold": true },
        "enumMember": "#d4a050",
        "function": { "foreground": "#d8e8d8", "bold": true },
        "method": { "foreground": "#d8e8d8", "bold": true },
        "property": "#c8d8c8",
        "variable": "#c8d8c8",
        "parameter": "#98b8a0",
        "typeParameter": { "foreground": "#5098c0", "italic": true },
        "keyword": { "foreground": "#5cb878", "bold": true },
        "string": "#80d098",
        "number": "#b070a0",
        "regexp": "#5098c0",
        "decorator": { "foreground": "#d4a050", "italic": true },
        "comment": { "foreground": "#3d5848", "italic": true },
        "type": "#5098c0",
        "struct": { "foreground": "#50b0a0", "bold": true },
        "variable.readonly": { "foreground": "#d4a050" },
        "property.readonly": { "foreground": "#d4a050" }
    },
    "$schema": "vscode://schemas/color-theme"
}
