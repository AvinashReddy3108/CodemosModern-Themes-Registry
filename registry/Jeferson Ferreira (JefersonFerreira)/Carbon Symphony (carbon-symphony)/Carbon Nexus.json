        "debugIcon.restartForeground": "#79b8ff",
        "debugIcon.startForeground": "#79b8ff",
        "debugIcon.stepBackForeground": "#FF7A84",
        "debugIcon.stepIntoForeground": "#FF7A84",
        "debugIcon.stepOutForeground": "#FF7A84",
