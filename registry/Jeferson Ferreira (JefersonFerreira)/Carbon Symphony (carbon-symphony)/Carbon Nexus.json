    "tokenColors": [
        { "settings": { "foreground": "#B392F0" } },
        {
            "scope": [
                "keyword.operator.accessor",
                "meta.group.braces.round.function.arguments",
                "markup.fenced_code meta.embedded.block"
            ],
            "settings": { "foreground": "#D1D1D1" }
        },
        {
            "scope": "meta.template.expression",
            "settings": { "foreground": "#FF8336" }
        },
        {
            "scope": "support.function",
            "settings": { "foreground": "#A3DC6B" }
        },
        { "scope": "emphasis", "settings": { "fontStyle": "italic" } },
        {
            "scope": [
                "strong",
                "markup.heading.markdown",
                "markup.bold.markdown"
            ],
            "settings": { "fontStyle": "bold", "foreground": "#FF8336" }
        },
        {
            "scope": ["strong", "heading.2.markdown"],
            "settings": { "fontStyle": "bold", "foreground": "#FF80D2" }
        },
        {
            "scope": ["strong", "heading.3.markdown"],
            "settings": { "fontStyle": "bold", "foreground": "#C49CFF" }
        },
        {
            "scope": ["strong", "heading.4.markdown"],
            "settings": { "fontStyle": "bold", "foreground": "#60F360" }
        },
        {
            "scope": ["strong", "heading.5.markdown"],
            "settings": { "fontStyle": "bold", "foreground": "#FF6A86" }
        },
        {
            "scope": ["strong", "heading.6.markdown"],
            "settings": { "fontStyle": "bold", "foreground": "#FFDC42" }
        },
        {
            "scope": ["markup.italic.markdown"],
            "settings": { "fontStyle": "italic", "foreground": "#D495FF" }
        },
        {
            "scope": "meta.link.inline.markdown",
            "settings": { "fontStyle": "underline", "foreground": "#6CFF67" }
        },
        {
            "name": "[Custom] Markdown meta definition",
            "scope": "meta.paragraph.markdown",
            "settings": { "foreground": "#82B8FF" }
        },
        {
            "scope": ["string", "markup.fenced_code", "markup.inline"],
            "settings": { "foreground": "#FF8336" }
        },
        {
            "scope": ["comment", "string.quoted.docstring.multi"],
            "settings": { "foreground": "#838589" }
        },
        { "scope": "variable", "settings": { "foreground": "#E6E6E6" } },
        {
            "scope": "variable.language.this",
            "settings": { "foreground": "#6ABAFF" }
        },
        {
            "scope": "variable.language",
            "settings": { "foreground": "#FF6A86" }
        },
        {
            "scope": "constant.character",
            "settings": { "foreground": "#6ABAFF" }
        },
        {
            "scope": [
                "constant.language",
                "variable.other.class",
                "variable.other.constant",
                "meta.property-name",
                "support",
                "string.other.link.title.markdown"
            ],
            "settings": { "foreground": "#32F1FF" }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.other.placeholder",
                "meta.property-value",
                "keyword.other.unit",
                "keyword.other.template",
                "entity.name.tag.yaml",
                "entity.other.attribute-name",
                "support.type.property-name.json"
            ],
            "settings": { "foreground": "#D495FF" }
        },
        {
            "scope": [
                "storage.modifier",
                "storage.control.clojure",
                "entity.name.function.clojure",
                "support.function.node"
            ],
            "settings": { "foreground": "#6ABAFF" }
        },
        {
            "scope": ["storage.modifier"],
            "settings": { "foreground": "#FF6A86" }
        },
        { "scope": ["support.class"], "settings": { "foreground": "#6ABAFF" } },
        {
            "scope": "constant.character.format.placeholder",
            "settings": { "foreground": "#D495FF" }
        },
        {
            "scope": ["keyword", "keyword.operator", "storage.type"],
            "settings": { "foreground": "#FF6A86" }
        },
        {
            "scope": [
                "entity.name.type",
                "entity.other.inherited-class",
                "meta.function-call",
                "meta.instance.constructor",
                "entity.other.attribute-name",
                "constant.keyword.clojure"
            ],
            "settings": { "foreground": "#6ABAFF" }
        },
        {
            "scope": ["entity.name.function"],
            "settings": { "foreground": "#A7E964" }
        },
        {
            "scope": [
                "entity.name.tag",
                "string.quoted",
                "string.regexp",
                "string.interpolated",
                "string.template",
                "string.unquoted.plain.out.yaml",
                "keyword.other.template"
            ],
            "settings": { "foreground": "#FFE56C" }
        },
        {
            "scope": "token.info-token",
            "settings": { "foreground": "#316BCD" }
        },
        {
            "scope": "token.warn-token",
            "settings": { "foreground": "#CD9731" }
        },
        {
            "scope": "token.error-token",
            "settings": { "foreground": "#CD3131" }
        },
        {
            "scope": "token.debug-token",
            "settings": { "foreground": "#800080" }
        },
        {
            "scope": [
                "punctuation.separator",
                "punctuation.definition.dict",
                "meta.function"
            ],
            "settings": { "foreground": "#D1D1D1" }
        },
        {
            "scope": ["punctuation.definition.parameters"],
            "settings": { "foreground": "#D1D1D1" }
        },
        {
            "scope": ["punctuation.definition.arguments"],
            "settings": { "foreground": "#D1D1D1" }
        },
        {
            "scope": ["punctuation.accessor", "meta.function-call"],
            "settings": { "foreground": "#D1D1D1" }
        },
        {
            "scope": [
                "variable.other.property",
                "meta.object-literal.key",
                "meta.object.member",
                "meta.objectliteral"
            ],
            "settings": { "foreground": "#D495FF" }
        },
        {
            "scope": "support.variable",
            "settings": { "foreground": "#6ABAFF" }
        },
        {
            "scope": "support.constant.property",
            "settings": { "foreground": "#D495FF" }
        },
        {
            "scope": [
                "punctuation.definition.tag.begin.html",
                "meta.tag.structure.html.end.html",
                "text.html.derivative"
            ],
            "settings": { "foreground": "#DADADA" }
        },
        { "scope": "entity.name.tag", "settings": { "foreground": "#FF6A86" } },
        {
            "scope": "meta.function-call.arguments",
            "settings": { "foreground": "#E6E6E6" }
        },
        {
            "scope": "variable.parameter",
            "settings": { "foreground": "#FF9661" }
        },
        {
            "scope": "meta.function-call",
            "settings": { "foreground": "#6ABAFF" }
        },
        { "scope": "source.python", "settings": { "foreground": "#E6E6E6" } },
        {
            "name": "[Custom] Markdown links",
            "scope": "markup.underline.link",
            "settings": { "foreground": "#60F360" }
        },
        {
            "name": "[Custom] Markdown list",
            "scope": ["beginning.punctuation.definition.list.markdown"],
            "settings": { "foreground": "#FF7A84" }
        },
        {
            "name": "[Custom] Markdown punctuation definition",
            "scope": "punctuation.definition.metadata.markdown",
            "settings": { "foreground": "#5FAAFF" }
        },
        {
            "name": "[Custom] Markdown punctuation definition brackets",
            "scope": [
                "punctuation.definition.string.begin.markdown",
                "punctuation.definition.string.end.markdown"
            ],
            "settings": { "foreground": "#79B8FF" }
        }
    ],
    "semanticHighlighting": true,
    "$schema": "vscode://schemas/color-theme"
}
