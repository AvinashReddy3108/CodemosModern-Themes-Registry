{
    "name": "Mercedes W14 Apex",
    "type": "dark",
    "colors": {
        "foreground": "#D4D4D4",
        "focusBorder": "#00A69C",
        "widget.shadow": "#00000080",
        "selection.background": "#00A69C50",
        "errorForeground": "#E4002B",
        "activityBar.background": "#121212",
        "activityBar.foreground": "#E4002B",
        "activityBar.inactiveForeground": "#FFFFFF80",
        "activityBar.border": "#00A69C40",
        "activityBarBadge.background": "#4df01c",
        "activityBarBadge.foreground": "#121212",
        "sideBar.background": "#121212",
        "sideBar.foreground": "#CCCCCC",
        "sideBar.border": "#00A69C",
        "sideBarTitle.foreground": "#FFFFFF",
        "sideBarSectionHeader.background": "#121212",
        "sideBarSectionHeader.border": "#00A69C40",
        "list.hoverBackground": "#FFFFFF1A",
        "list.inactiveSelectionBackground": "#FFFFFF15",
        "list.activeSelectionBackground": "#00A69C40",
        "list.activeSelectionForeground": "#FFFFFF",
        "list.focusBackground": "#00A69C40",
        "list.highlightForeground": "#FFD300",
        "editor.background": "#121212",
        "editor.foreground": "#D4D4D4",
        "editorGroup.border": "#00A69C80",
        "editorGroupHeader.tabsBackground": "#121212",
        "editorLineNumber.foreground": "#858585",
        "editorLineNumber.activeForeground": "#00A69C",
        "editorCursor.foreground": "#5afbc5",
        "editor.selectionBackground": "#00A69C50",
        "editor.wordHighlightBackground": "#FFFFFF1A",
        "editorIndentGuide.background": "#FFFFFF1A",
        "editorIndentGuide.activeBackground": "#00A69C",
        "tab.border": "#12121200",
        "tab.activeBorderTop": "#00A69C",
        "tab.activeBackground": "#181818",
        "tab.activeForeground": "#FFFFFF",
        "tab.inactiveBackground": "#121212",
        "tab.inactiveForeground": "#CCCCCC",
        "statusBar.background": "#121212",
        "statusBar.foreground": "#FFFFFF",
        "statusBar.border": "#00A69C",
        "statusBar.debuggingBackground": "#E4002B",
        "statusBar.debuggingForeground": "#FFFFFF",
        "statusBarItem.remoteBackground": "#00A69C",
        "statusBarItem.remoteForeground": "#FFFFFF",
        "panel.background": "#121212",
        "panel.border": "#00A69C80",
        "button.background": "#00A69C",
        "button.foreground": "#FFFFFF",
        "dropdown.background": "#181818",
        "dropdown.border": "#00A69C",
        "input.background": "#181818",
        "input.border": "#00A69C80",
        "titleBar.activeBackground": "#121212",
        "titleBar.activeForeground": "#FFFFFF"
    },
    "tokenColors": [
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "fontStyle": "italic", "foreground": "#6A9955" }
        },
        {
            "scope": ["string", "punctuation.definition.string"],
            "settings": { "foreground": "#4ce1df" }
        },
        {
            "scope": ["constant.numeric", "constant.language.boolean"],
            "settings": { "foreground": "#b5cea8" }
        },
        {
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "fontStyle": "italic", "foreground": "#00A69C" }
        },
        {
            "scope": ["entity.name.function", "support.function"],
            "settings": { "fontStyle": "italic", "foreground": "#66D9EF" }
        },
        {
            "scope": "variable.parameter",
            "settings": { "fontStyle": "italic", "foreground": "#CE9178" }
        },
        {
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "entity.name.namespace",
                "entity.other.inherited-class"
            ],
            "settings": { "fontStyle": "italic", "foreground": "#4EC9B0" }
        },
        {
            "scope": ["variable.language", "keyword.control"],
            "settings": { "fontStyle": "italic", "foreground": "#C586C0" }
        },
        { "scope": "entity.name.tag", "settings": { "foreground": "#E4002B" } },
        {
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#9CDCFE" }
        },
        {
            "scope": "variable.other.property",
            "settings": { "foreground": "#9CDCFE" }
        },
        { "scope": "variable", "settings": { "foreground": "#D4D4D4" } },
        { "scope": "punctuation", "settings": { "foreground": "#808080" } }
    ],
    "$schema": "vscode://schemas/color-theme"
}
