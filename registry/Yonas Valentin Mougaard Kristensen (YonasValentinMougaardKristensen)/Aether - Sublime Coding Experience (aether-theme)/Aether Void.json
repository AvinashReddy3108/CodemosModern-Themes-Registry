    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "fontStyle": "italic", "foreground": "#5c6370" }
        },
        {
            "name": "Strings",
            "scope": ["string", "string.quoted"],
            "settings": { "foreground": "#98c379" }
        },
        {
            "name": "Template Strings & String interpolation",
            "scope": [
                "string.template",
                "punctuation.definition.template-expression",
                "string.interpolated"
            ],
            "settings": { "foreground": "#56b6c2" }
        },
        {
            "name": "Numbers",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#d19a66" }
        },
        {
            "name": "Booleans & Null",
            "scope": [
                "constant.language.boolean",
                "constant.language.null",
                "constant.language.undefined"
            ],
            "settings": { "foreground": "#d19a66", "fontStyle": "bold" }
        },
        {
            "name": "Keywords",
            "scope": ["keyword", "keyword.control"],
            "settings": { "foreground": "#c678dd", "fontStyle": "bold" }
        },
        {
            "name": "Storage & Type Keywords",
            "scope": ["storage.type", "storage.modifier"],
            "settings": { "foreground": "#c678dd", "fontStyle": "italic" }
        },
        {
            "name": "Operators",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#56b6c2" }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "meta.function-call",
                "support.function",
                "keyword.other.special-method"
            ],
            "settings": { "foreground": "#70c0e8", "fontStyle": "bold" }
        },
        {
            "name": "Classes & Types",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.class",
                "support.type",
                "entity.name.namespace",
                "entity.other.attribute",
                "entity.name.scope-resolution",
                "entity.name.interface",
                "storage.type.numeric.go",
                "storage.type.byte.go",
                "storage.type.boolean.go",
                "storage.type.string.go",
                "storage.type.uintptr.go",
                "storage.type.error.go",
                "storage.type.rune.go",
                "storage.type.cs",
                "storage.type.generic.cs",
                "storage.type.modifier.cs",
                "storage.type.variable.cs",
                "storage.type.annotation.java",
                "storage.type.generic.java",
                "storage.type.java",
                "storage.type.object.array.java",
                "storage.type.primitive.array.java",
                "storage.type.primitive.java",
                "storage.type.token.java",
                "storage.type.groovy",
                "storage.type.annotation.groovy",
                "storage.type.parameters.groovy",
                "storage.type.generic.groovy",
                "storage.type.object.array.groovy",
                "storage.type.primitive.array.groovy",
                "storage.type.primitive.groovy"
            ],
            "settings": { "foreground": "#e5c07b", "fontStyle": "bold" }
        },
        {
            "name": "Constructor",
            "scope": ["entity.name.function.constructor"],
            "settings": { "foreground": "#e5c07b", "fontStyle": "bold" }
        },
        {
            "name": "Methods",
            "scope": ["entity.name.method", "entity.name.function.member"],
            "settings": { "foreground": "#70c0e8", "fontStyle": "italic bold" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "meta.definition.variable"],
            "settings": { "foreground": "#e06c75" }
        },
        {
            "name": "Parameters",
            "scope": ["variable.parameter", "parameter.variable"],
            "settings": { "foreground": "#e5c07b", "fontStyle": "italic" }
        },
        {
            "name": "Properties",
            "scope": [
                "variable.other.property",
                "support.variable.property",
                "variable.other.object.property",
                "entity.name.variable.property",
                "meta.property-name"
            ],
            "settings": { "foreground": "#e06c75" }
        },
        {
            "name": "This & Super",
            "scope": [
                "variable.language.this",
                "variable.language.super",
                "variable.language.self"
            ],
            "settings": { "foreground": "#e06c75", "fontStyle": "italic bold" }
        },
        {
            "name": "Constants",
            "scope": [
                "constant",
                "variable.other.constant",
                "variable.readonly",
                "variable.other.readwrite.alias"
            ],
            "settings": { "foreground": "#d19a66", "fontStyle": "bold" }
        },
        {
            "name": "Attributes",
            "scope": [
                "entity.other.attribute-name",
                "support.function.attribute"
            ],
            "settings": { "foreground": "#d19a66", "fontStyle": "italic" }
        },
        {
            "name": "CSS/SCSS/Less - Properties",
            "scope": [
                "support.type.property-name",
                "support.type.vendored.property-name"
            ],
            "settings": { "foreground": "#56b6c2" }
        },
        {
            "name": "CSS/SCSS/Less - Values",
            "scope": [
                "support.constant.property-value",
                "support.constant.font-name",
                "support.constant.media",
                "constant.other.color",
                "constant.other.rgb-value",
                "support.constant.color"
            ],
            "settings": { "foreground": "#d19a66" }
        },
        {
            "name": "CSS/SCSS - Selector",
            "scope": [
                "entity.name.tag.css",
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css",
                "entity.other.attribute-name.pseudo-class.css",
                "entity.other.attribute-name.pseudo-element.css"
            ],
            "settings": { "foreground": "#e06c75" }
        },
        {
            "name": "HTML/XML - Tags",
            "scope": [
                "entity.name.tag",
                "meta.tag",
                "punctuation.definition.tag"
            ],
            "settings": { "foreground": "#e06c75" }
        },
        {
            "name": "HTML/XML - Attributes",
            "scope": [
                "entity.other.attribute-name.html",
                "entity.other.attribute-name.xml"
            ],
            "settings": { "foreground": "#d19a66", "fontStyle": "italic" }
        },
        {
            "name": "Markdown - Headings",
            "scope": [
                "markup.heading",
                "punctuation.definition.heading",
                "entity.name.section"
            ],
            "settings": { "foreground": "#e06c75", "fontStyle": "bold" }
        },
        {
            "name": "Markdown - Bold",
            "scope": ["markup.bold", "punctuation.definition.bold"],
            "settings": { "foreground": "#d19a66", "fontStyle": "bold" }
        },
        {
            "name": "Markdown - Italic",
            "scope": ["markup.italic", "punctuation.definition.italic"],
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "Markdown - Links",
            "scope": ["markup.underline.link", "string.other.link"],
            "settings": { "foreground": "#70c0e8", "fontStyle": "underline" }
        },
        {
            "name": "Markdown - Code",
            "scope": ["markup.raw", "markup.inline.raw"],
            "settings": { "foreground": "#98c379" }
        },
        {
            "name": "Markdown - Quote",
            "scope": ["markup.quote"],
            "settings": { "foreground": "#5c6370", "fontStyle": "italic" }
        },
        {
            "name": "JSON Keys",
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#e06c75" }
        },
        {
            "name": "YAML Keys",
            "scope": ["entity.name.tag.yaml"],
            "settings": { "foreground": "#e06c75" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": {
                "foreground": "#ffffff",
                "background": "#e06c75",
                "fontStyle": "bold"
            }
        },
        {
            "name": "Deprecated",
            "scope": ["invalid.deprecated"],
            "settings": {
                "foreground": "#ffffff",
                "background": "#d19a66",
                "fontStyle": "bold"
            }
        },
        {
            "name": "Diff - Inserted",
            "scope": ["markup.inserted", "meta.diff.header.to-file"],
            "settings": { "foreground": "#98c379" }
        },
        {
            "name": "Diff - Deleted",
            "scope": ["markup.deleted", "meta.diff.header.from-file"],
            "settings": { "foreground": "#e06c75" }
        },
        {
            "name": "Diff - Changed",
            "scope": ["markup.changed"],
            "settings": { "foreground": "#e5c07b" }
        },
        {
            "name": "Regular Expressions",
            "scope": ["string.regexp"],
            "settings": { "foreground": "#56b6c2" }
        },
        {
            "name": "Escape Characters",
            "scope": ["constant.character.escape"],
            "settings": { "foreground": "#56b6c2" }
        },
        {
            "name": "Embedded",
            "scope": ["punctuation.section.embedded", "variable.interpolation"],
            "settings": { "foreground": "#e06c75" }
        },
        {
            "name": "Illegal",
            "scope": ["invalid.illegal.bad-ampersand.html"],
            "settings": { "foreground": "#ffffff", "background": "#e06c75" }
        },
        {
            "name": "Broken",
            "scope": ["invalid.broken"],
            "settings": { "foreground": "#ffffff", "background": "#d19a66" }
        },
        {
            "name": "Unimplemented",
            "scope": ["invalid.unimplemented"],
            "settings": { "foreground": "#ffffff", "background": "#5c6370" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
