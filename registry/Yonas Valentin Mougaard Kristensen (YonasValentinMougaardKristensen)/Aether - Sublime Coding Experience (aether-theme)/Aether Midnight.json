    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#6b6b6b", "fontStyle": "italic" }
        },
        {
            "name": "String",
            "scope": ["string", "punctuation.definition.string"],
            "settings": { "foreground": "#98fb98" }
        },
        {
            "name": "String Interpolated",
            "scope": [
                "string.template",
                "punctuation.definition.template-expression"
            ],
            "settings": { "foreground": "#87ceeb" }
        },
        {
            "name": "Number",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#ee82ee" }
        },
        {
            "name": "Boolean",
            "scope": ["constant.language.boolean"],
            "settings": { "foreground": "#ee82ee", "fontStyle": "bold" }
        },
        {
            "name": "Keyword",
            "scope": ["keyword", "storage.modifier"],
            "settings": { "foreground": "#9370db", "fontStyle": "bold" }
        },
        {
            "name": "Operator",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#ba55d3" }
        },
        {
            "name": "Function",
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#87ceeb", "fontStyle": "bold" }
        },
        {
            "name": "Class",
            "scope": ["entity.name.class", "entity.name.type", "support.class"],
            "settings": { "foreground": "#ffd700", "fontStyle": "bold" }
        },
        {
            "name": "Variable",
            "scope": ["variable", "meta.definition.variable"],
            "settings": { "foreground": "#e0e0e0" }
        },
        {
            "name": "Property",
            "scope": ["variable.other.property"],
            "settings": { "foreground": "#b0e0e6" }
        },
        {
            "name": "Tag",
            "scope": ["entity.name.tag", "meta.tag"],
            "settings": { "foreground": "#9370db" }
        },
        {
            "name": "Attribute",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#87ceeb", "fontStyle": "italic" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid"],
            "settings": { "foreground": "#ffffff", "background": "#ff6b6b" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
