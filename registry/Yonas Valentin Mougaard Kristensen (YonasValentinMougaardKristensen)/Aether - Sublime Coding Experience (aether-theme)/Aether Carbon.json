    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#606060", "fontStyle": "italic" }
        },
        {
            "name": "String",
            "scope": ["string", "punctuation.definition.string"],
            "settings": { "foreground": "#b0b0b0" }
        },
        {
            "name": "String Interpolated",
            "scope": [
                "string.template",
                "punctuation.definition.template-expression"
            ],
            "settings": { "foreground": "#c0c0c0" }
        },
        {
            "name": "Number",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#a0a0a0" }
        },
        {
            "name": "Boolean",
            "scope": ["constant.language.boolean"],
            "settings": { "foreground": "#a0a0a0", "fontStyle": "bold" }
        },
        {
            "name": "Keyword",
            "scope": ["keyword", "storage.modifier"],
            "settings": { "foreground": "#d0d0d0", "fontStyle": "bold" }
        },
        {
            "name": "Operator",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#c8c8c8" }
        },
        {
            "name": "Function",
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#e0e0e0", "fontStyle": "bold" }
        },
        {
            "name": "Class",
            "scope": ["entity.name.class", "entity.name.type", "support.class"],
            "settings": { "foreground": "#f0f0f0", "fontStyle": "bold" }
        },
        {
            "name": "Variable",
            "scope": ["variable", "meta.definition.variable"],
            "settings": { "foreground": "#b8b8b8" }
        },
        {
            "name": "Property",
            "scope": ["variable.other.property"],
            "settings": { "foreground": "#c8c8c8" }
        },
        {
            "name": "Tag",
            "scope": ["entity.name.tag", "meta.tag"],
            "settings": { "foreground": "#d0d0d0" }
        },
        {
            "name": "Attribute",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#b0b0b0", "fontStyle": "italic" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid"],
            "settings": { "foreground": "#ffffff", "background": "#808080" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
