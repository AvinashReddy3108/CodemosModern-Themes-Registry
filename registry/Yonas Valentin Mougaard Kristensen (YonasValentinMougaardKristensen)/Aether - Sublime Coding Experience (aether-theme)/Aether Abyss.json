    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#64748b", "fontStyle": "italic" }
        },
        {
            "name": "String",
            "scope": ["string", "punctuation.definition.string"],
            "settings": { "foreground": "#10b981" }
        },
        {
            "name": "String Interpolated",
            "scope": [
                "string.template",
                "punctuation.definition.template-expression"
            ],
            "settings": { "foreground": "#22d3ee" }
        },
        {
            "name": "Number",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#c084fc" }
        },
        {
            "name": "Boolean",
            "scope": ["constant.language.boolean"],
            "settings": { "foreground": "#c084fc", "fontStyle": "bold" }
        },
        {
            "name": "Keyword",
            "scope": ["keyword", "storage.modifier"],
            "settings": { "foreground": "#f472b6", "fontStyle": "bold" }
        },
        {
            "name": "Operator",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#60a5fa" }
        },
        {
            "name": "Function",
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#818cf8", "fontStyle": "bold" }
        },
        {
            "name": "Class",
            "scope": ["entity.name.class", "entity.name.type", "support.class"],
            "settings": { "foreground": "#fb923c", "fontStyle": "bold" }
        },
        {
            "name": "Variable",
            "scope": ["variable", "meta.definition.variable"],
            "settings": { "foreground": "#facc15" }
        },
        {
            "name": "Property",
            "scope": ["variable.other.property"],
            "settings": { "foreground": "#67e8f9" }
        },
        {
            "name": "Tag",
            "scope": ["entity.name.tag", "meta.tag"],
            "settings": { "foreground": "#ef4444" }
        },
        {
            "name": "Attribute",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#facc15", "fontStyle": "italic" }
        },
        {
            "name": "Constant",
            "scope": [
                "constant",
                "variable.other.constant",
                "support.constant"
            ],
            "settings": { "foreground": "#f59e0b" }
        },
        {
            "name": "Support",
            "scope": ["support", "support.type", "support.class"],
            "settings": { "foreground": "#22d3ee" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid"],
            "settings": { "foreground": "#ffffff", "background": "#ef4444" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
