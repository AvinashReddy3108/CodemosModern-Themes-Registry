    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#6b8d91", "fontStyle": "italic" }
        },
        {
            "name": "String",
            "scope": ["string", "punctuation.definition.string"],
            "settings": { "foreground": "#84cc16" }
        },
        {
            "name": "String Interpolated",
            "scope": [
                "string.template",
                "punctuation.definition.template-expression"
            ],
            "settings": { "foreground": "#2dd4bf" }
        },
        {
            "name": "Number",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#e879f9" }
        },
        {
            "name": "Boolean",
            "scope": ["constant.language.boolean"],
            "settings": { "foreground": "#e879f9", "fontStyle": "bold" }
        },
        {
            "name": "Keyword",
            "scope": ["keyword", "storage.modifier"],
            "settings": { "foreground": "#fbbf24", "fontStyle": "bold" }
        },
        {
            "name": "Operator",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#38bdf8" }
        },
        {
            "name": "Function",
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#14b8a6", "fontStyle": "bold" }
        },
        {
            "name": "Class",
            "scope": ["entity.name.class", "entity.name.type", "support.class"],
            "settings": { "foreground": "#f97316", "fontStyle": "bold" }
        },
        {
            "name": "Variable",
            "scope": ["variable", "meta.definition.variable"],
            "settings": { "foreground": "#fcd34d" }
        },
        {
            "name": "Property",
            "scope": ["variable.other.property"],
            "settings": { "foreground": "#5eead4" }
        },
        {
            "name": "Tag",
            "scope": ["entity.name.tag", "meta.tag"],
            "settings": { "foreground": "#dc2626" }
        },
        {
            "name": "Attribute",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#fcd34d", "fontStyle": "italic" }
        },
        {
            "name": "Constant",
            "scope": [
                "constant",
                "variable.other.constant",
                "support.constant"
            ],
            "settings": { "foreground": "#f59e0b" }
        },
        {
            "name": "Support",
            "scope": ["support", "support.type", "support.class"],
            "settings": { "foreground": "#2dd4bf" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid"],
            "settings": { "foreground": "#ffffff", "background": "#dc2626" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
