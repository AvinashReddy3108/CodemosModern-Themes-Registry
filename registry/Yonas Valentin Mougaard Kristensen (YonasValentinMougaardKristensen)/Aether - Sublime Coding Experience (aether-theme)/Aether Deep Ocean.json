    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#5c8ec7", "fontStyle": "italic" }
        },
        {
            "name": "String",
            "scope": ["string", "punctuation.definition.string"],
            "settings": { "foreground": "#00e676" }
        },
        {
            "name": "String Interpolated",
            "scope": [
                "string.template",
                "punctuation.definition.template-expression"
            ],
            "settings": { "foreground": "#00acc1" }
        },
        {
            "name": "Number",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#7c4dff" }
        },
        {
            "name": "Boolean",
            "scope": ["constant.language.boolean"],
            "settings": { "foreground": "#7c4dff", "fontStyle": "bold" }
        },
        {
            "name": "Keyword",
            "scope": ["keyword", "storage.modifier"],
            "settings": { "foreground": "#0288d1", "fontStyle": "bold" }
        },
        {
            "name": "Operator",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#00bcd4" }
        },
        {
            "name": "Function",
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#4fc3f7", "fontStyle": "bold" }
        },
        {
            "name": "Class",
            "scope": ["entity.name.class", "entity.name.type", "support.class"],
            "settings": { "foreground": "#81d4fa", "fontStyle": "bold" }
        },
        {
            "name": "Variable",
            "scope": ["variable", "meta.definition.variable"],
            "settings": { "foreground": "#c3e2ff" }
        },
        {
            "name": "Property",
            "scope": ["variable.other.property"],
            "settings": { "foreground": "#84ffff" }
        },
        {
            "name": "Tag",
            "scope": ["entity.name.tag", "meta.tag"],
            "settings": { "foreground": "#0288d1" }
        },
        {
            "name": "Attribute",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#4fc3f7", "fontStyle": "italic" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid"],
            "settings": { "foreground": "#ffffff", "background": "#ff5252" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
