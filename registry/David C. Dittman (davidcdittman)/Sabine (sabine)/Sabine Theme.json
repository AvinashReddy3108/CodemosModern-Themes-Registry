        "statusBar.noFolderBackground": "#1a181b",
        "statusBar.noFolderForeground": "#FAFAFA",
        "statusBarItem.prominentBackground": "#FF9AA2",
        "statusBarItem.prominentHoverBackground": "#FFB86C",
        "statusBarItem.remoteForeground": "#2F2C30",
        "statusBarItem.remoteBackground": "#CBAACB",
