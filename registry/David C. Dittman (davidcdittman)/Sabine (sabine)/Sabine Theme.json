        "peekViewResult.selectionBackground": "#756e77",
        "peekViewResult.selectionForeground": "#FAFAFA",
        "peekViewTitle.background": "#1a181b",
        "peekViewTitleDescription.foreground": "#595959",
        "peekViewTitleLabel.foreground": "#FAFAFA",
