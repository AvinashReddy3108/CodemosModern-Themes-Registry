        "breadcrumb.background": "#2F2C30",
        "breadcrumb.focusForeground": "#FAFAFA",
        "breadcrumb.activeSelectionForeground": "#FAFAFA",
        "breadcrumbPicker.background": "#1a181b",
        "listFilterWidget.background": "#343135",
        "listFilterWidget.outline": "#413d42",
        "listFilterWidget.noMatchesOutline": "#FF9AA2"
