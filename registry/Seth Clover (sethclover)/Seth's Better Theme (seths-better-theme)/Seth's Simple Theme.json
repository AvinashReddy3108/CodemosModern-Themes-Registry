{
    "name": "Seth's Simple Theme",
    "type": "dark",
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "variable": "#4385BE",
        "variable.readonly": "#4385BE",
        "variable.defaultLibrary": "#4385BE",
        "variable.local": "#4385BE",
        "variable.parameter": "#4385BE",
        "property": "#4385BE",
        "property.readonly": "#4385BE",
        "property.static": "#4385BE",
        "function": "#DA702C",
        "function.declaration": "#DA702C",
        "function.defaultLibrary": "#DA702C",
        "method": "#DA702C",
        "method.declaration": "#DA702C",
        "method.static": "#DA702C",
        "method.virtual": "#DA702C",
        "class": "#4385BE",
        "class.declaration": "#4385BE",
        "class.defaultLibrary": "#4385BE",
        "struct": "#4385BE",
        "struct.declaration": "#4385BE",
        "enum": "#4385BE",
        "enum.declaration": "#4385BE",
        "type": "#4385BE",
        "type.defaultLibrary": "#4385BE",
        "typeParameter": "#4385BE",
        "enumMember": "#D0A215",
        "enumMember.declaration": "#D0A215",
        "enumMember.readonly": "#D0A215",
        "namespace": "#D14D41",
        "namespace.declaration": "#D14D41",
        "keyword": "#879A39",
        "keyword.controlFlow": "#879A39",
        "keyword.operator": "#879A39",
        "keyword.other": "#879A39",
        "operator": "#878580",
        "operator.overloaded": "#878580",
        "number": "#8B7EC8",
        "string": "#3AA99F",
        "string.escape": "#3AA99F",
        "comment": "#B7B5AC",
        "comment.documentation": "#B7B5AC",
        "macro": "#CE5D97",
        "macro.declaration": "#CE5D97",
        "variable.readonly.defaultLibrary": "#D0A215",
        "typeParameter.declaration": "#4385BE",
        "concept": "#4385BE",
        "concept.declaration": "#4385BE",
        "property.declaration": "#4385BE",
        "member": "#4385BE",
        "parameter": "#4385BE",
        "parameter.declaration": "#4385BE",
        "parameter.readonly": "#4385BE",
        "label": "#CE5D97",
        "*.static": { "fontStyle": "italic" },
        "*.abstract": { "fontStyle": "italic" },
        "*.virtual": { "fontStyle": "italic" },
        "*.const": { "fontStyle": "" },
        "*.inline": { "fontStyle": "italic" },
        "*.constexpr": { "fontStyle": "" },
        "keyword.directive": "#879A39",
        "punctuation": "#878580",
        "punctuation.bracket": "#878580",
        "punctuation.delimiter": "#878580",
        "punctuation.parenthesis": "#878580",
        "invalid": "#D14D41",
        "deprecated": "#D14D41"
    },
    "$schema": "vscode://schemas/color-theme"
}
