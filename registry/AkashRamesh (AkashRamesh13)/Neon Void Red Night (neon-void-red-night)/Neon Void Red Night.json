{
    "name": "neon-void-red-night",
    "colors": {
        "editor.background": "#000000",
        "editor.foreground": "#cdd6f4",
        "editorLineNumber.foreground": "#666666",
        "editorCursor.foreground": "#ff5555",
        "editor.selectionBackground": "#ff555577",
        "editor.selectionHighlightBackground": "#ff555599",
        "editor.lineHighlightBackground": "#140000",
        "editorBracketMatch.background": "#1a0000",
        "editorBracketMatch.border": "#ff5555",
        "editorGutter.background": "#000000",
        "activityBar.background": "#000000",
        "activityBar.foreground": "#cdd6f4",
        "activityBarBadge.background": "#ff5555",
        "activityBarBadge.foreground": "#ffffff",
        "sideBar.background": "#000000",
        "sideBar.foreground": "#cdd6f4",
        "statusBar.background": "#000000",
        "statusBar.foreground": "#cdd6f4",
        "statusBar.debuggingBackground": "#ff5555",
        "tab.activeBackground": "#000000",
        "tab.inactiveBackground": "#111111",
        "tab.activeForeground": "#cdd6f4",
        "tab.inactiveForeground": "#888888",
        "editorIndentGuide.background": "#111111",
        "editorIndentGuide.activeBackground": "#ff555533"
    },
    "tokenColors": [
        {
            "name": "Keywords & language constants",
            "scope": [
                "keyword",
                "storage.type",
                "storage.modifier",
                "constant.language"
            ],
            "settings": { "foreground": "#ff5555" }
        },
        {
            "name": "Functions (bold)",
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#00aaff", "fontStyle": "bold" }
        },
        {
            "name": "Variables & identifiers (NOT bold)",
            "scope": [
                "variable",
                "identifier",
                "support.constant",
                "meta.definition.variable"
            ],
            "settings": { "foreground": "#00aaff", "fontStyle": "" }
        },
        {
            "name": "Types, classes, interfaces",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.class",
                "support.type"
            ],
            "settings": { "foreground": "#ff8888" }
        },
        {
            "name": "Strings & numbers",
            "scope": [
                "string",
                "constant.numeric",
                "constant.character",
                "constant.other"
            ],
            "settings": { "foreground": "#ddd500" }
        },
        {
            "name": "Comments",
            "scope": "comment",
            "settings": { "foreground": "#666666", "fontStyle": "italic" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
