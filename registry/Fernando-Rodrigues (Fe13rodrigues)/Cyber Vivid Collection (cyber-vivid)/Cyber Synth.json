{
    "$schema": "vscode://schemas/color-theme",
    "name": "Cyber Synth",
    "type": "dark",
    "semanticHighlighting": true,
    "colors": {
        "foreground": "#edecee",
        "focusBorder": "#a277ff40",
        "selection.background": "#3d375e7f",
        "widget.shadow": "#00000060",
        "activityBar.background": "#15141b",
        "activityBar.foreground": "#a277ff",
        "activityBar.inactiveForeground": "#6d6d6d",
        "activityBar.activeBorder": "#a277ff",
        "activityBar.activeBackground": "#3d375e40",
        "activityBarBadge.background": "#a277ff",
        "activityBarBadge.foreground": "#15141b",
        "sideBar.background": "#15141b",
        "sideBar.foreground": "#edecee",
        "sideBar.border": "#15141b",
        "sideBarSectionHeader.background": "#15141b",
        "sideBarSectionHeader.foreground": "#edecee",
        "sideBarSectionHeader.border": "#15141b",
        "sideBarTitle.foreground": "#6d6d6d",
        "list.hoverBackground": "#3d375e40",
        "list.activeSelectionBackground": "#3d375e7f",
        "list.activeSelectionForeground": "#edecee",
        "list.inactiveSelectionBackground": "#3d375e40",
        "list.inactiveSelectionForeground": "#edecee",
        "list.focusBackground": "#3d375e7f",
        "list.focusForeground": "#edecee",
        "list.highlightForeground": "#a277ff",
        "button.background": "#a277ff",
        "button.foreground": "#15141b",
        "button.hoverBackground": "#8464c6",
        "button.secondaryBackground": "#6d6d6d40",
        "button.secondaryForeground": "#edecee",
        "button.secondaryHoverBackground": "#6d6d6d80",
        "editor.background": "#15141b",
        "editor.foreground": "#edecee",
        "editorLineNumber.foreground": "#6d6d6d",
        "editorLineNumber.activeForeground": "#a277ff",
        "editorCursor.foreground": "#a277ff",
        "editorCursor.background": "#15141b",
        "editor.selectionBackground": "#3d375e7f",
        "editor.inactiveSelectionBackground": "#3d375e40",
        "editor.selectionHighlightBackground": "#3d375e40",
        "editor.wordHighlightBackground": "#3d375e40",
        "editor.wordHighlightStrongBackground": "#3d375e7f",
        "editor.findMatchBackground": "#3d375e7f",
        "editor.findMatchHighlightBackground": "#3d375e40",
        "editor.hoverHighlightBackground": "#3d375e40",
        "editor.lineHighlightBackground": "#edecee0A",
        "editor.lineHighlightBorder": "#3d375e40",
        "editorIndentGuide.background1": "#6d6d6d40",
        "editorIndentGuide.activeBackground1": "#a277ff",
        "editorBracketMatch.background": "#a277ff40",
        "editorBracketMatch.border": "#a277ff",
        "editor.foldBackground": "#3d375e40",
        "editorError.foreground": "#ff6767",
        "editorWarning.foreground": "#ffca85",
        "editorInfo.foreground": "#82e2ff",
        "editorGutter.background": "#15141b",
        "editorGutter.modifiedBackground": "#82e2ff",
        "editorGutter.addedBackground": "#61ffca",
        "editorGutter.deletedBackground": "#ff6767",
        "diffEditor.insertedTextBackground": "#61ffca20",
        "diffEditor.removedTextBackground": "#ff676720",
        "panel.background": "#15141b",
        "panel.border": "#15141b",
        "panelTitle.activeBorder": "#a277ff",
        "panelTitle.activeForeground": "#edecee",
        "panelTitle.inactiveForeground": "#6d6d6d",
        "badge.background": "#a277ff",
        "badge.foreground": "#15141b",
        "terminal.background": "#15141b",
        "terminal.foreground": "#edecee",
        "terminalCursor.background": "#a277ff",
        "terminalCursor.foreground": "#15141b",
        "terminal.ansiBlack": "#15141b",
        "terminal.ansiRed": "#ff6767",
        "terminal.ansiGreen": "#61ffca",
        "terminal.ansiYellow": "#ffca85",
        "terminal.ansiBlue": "#82e2ff",
        "terminal.ansiMagenta": "#f694ff",
        "terminal.ansiCyan": "#61ffca",
        "terminal.ansiWhite": "#edecee",
        "terminal.ansiBrightBlack": "#6d6d6d",
        "terminal.ansiBrightRed": "#c55858",
        "terminal.ansiBrightGreen": "#54c59f",
        "terminal.ansiBrightYellow": "#c7a06f",
        "terminal.ansiBrightBlue": "#6cb2c7",
        "terminal.ansiBrightMagenta": "#c17ac8",
        "terminal.ansiBrightCyan": "#54c59f",
        "terminal.ansiBrightWhite": "#bdbdbd",
        "breadcrumb.background": "#15141b",
        "breadcrumb.foreground": "#6d6d6d",
        "breadcrumb.focusForeground": "#edecee",
        "editorGroupHeader.tabsBackground": "#15141b",
        "tab.activeBackground": "#15141b",
        "tab.activeForeground": "#edecee",
        "tab.activeBorderTop": "#a277ff",
        "tab.inactiveBackground": "#15141b",
        "tab.inactiveForeground": "#6d6d6d",
        "tab.border": "#15141b",
        "scrollbarSlider.background": "#6d6d6d40",
        "scrollbarSlider.hoverBackground": "#6d6d6d80",
        "scrollbarSlider.activeBackground": "#a277ff80",
        "progressBar.background": "#a277ff",
        "statusBar.background": "#15141b",
        "statusBar.foreground": "#edecee",
        "statusBar.border": "#15141b",
        "statusBar.debuggingBackground": "#ffca85",
        "statusBar.debuggingForeground": "#15141b",
        "statusBar.noFolderBackground": "#15141b",
        "titleBar.activeBackground": "#15141b",
        "titleBar.activeForeground": "#edecee",
        "titleBar.inactiveBackground": "#15141b",
        "titleBar.inactiveForeground": "#6d6d6d",
        "menu.background": "#15141b",
        "menu.foreground": "#edecee",
        "menu.selectionBackground": "#3d375e7f",
        "menu.selectionForeground": "#edecee",
        "minimap.background": "#15141b",
        "minimap.findMatchHighlight": "#a277ff80",
        "minimap.selectionHighlight": "#3d375e80",
        "minimap.errorHighlight": "#ff676780",
        "minimap.warningHighlight": "#ffca8580",
        "editorWidget.background": "#15141b",
        "editorWidget.foreground": "#edecee",
        "editorWidget.border": "#3d375e7f",
        "editorSuggestWidget.background": "#15141b",
        "editorSuggestWidget.border": "#3d375e7f",
        "editorSuggestWidget.foreground": "#edecee",
        "editorSuggestWidget.highlightForeground": "#a277ff",
        "editorSuggestWidget.selectedBackground": "#3d375e7f",
        "notifications.background": "#15141b",
        "notifications.foreground": "#edecee",
        "notifications.border": "#3d375e7f",
        "notificationsErrorIcon.foreground": "#ff6767",
        "notificationsWarningIcon.foreground": "#ffca85",
        "notificationsInfoIcon.foreground": "#82e2ff",
        "pickerGroup.border": "#3d375e7f",
        "pickerGroup.foreground": "#a277ff"
    },
    "tokenColors": [
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#6d6d6d", "fontStyle": "italic" }
        },
        {
            "scope": [
                "keyword",
                "storage.type",
                "storage.modifier",
                "keyword.control"
            ],
            "settings": { "foreground": "#a277ff" }
        },
        {
            "scope": [
                "string",
                "punctuation.definition.string",
                "string.quoted"
            ],
            "settings": { "foreground": "#61ffca" }
        },
        {
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call"
            ],
            "settings": { "foreground": "#82e2ff" }
        },
        {
            "scope": [
                "variable",
                "variable.parameter",
                "entity.name.variable",
                "variable.other.readwrite"
            ],
            "settings": { "foreground": "#edecee" }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.language",
                "support.constant"
            ],
            "settings": { "foreground": "#ffca85" }
        },
        {
            "scope": ["entity.name.type", "entity.name.class", "support.class"],
            "settings": { "foreground": "#f694ff" }
        },
        {
            "scope": ["entity.name.tag", "entity.other.attribute-name"],
            "settings": { "foreground": "#82e2ff" }
        },
        {
            "scope": ["punctuation", "keyword.operator"],
            "settings": { "foreground": "#edecee" }
        },
        {
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#ff6767" }
        },
        {
            "scope": ["markup.heading", "markup.bold"],
            "settings": { "foreground": "#a277ff", "fontStyle": "bold" }
        },
        {
            "scope": ["markup.italic"],
            "settings": { "foreground": "#61ffca", "fontStyle": "italic" }
        }
    ]
}
