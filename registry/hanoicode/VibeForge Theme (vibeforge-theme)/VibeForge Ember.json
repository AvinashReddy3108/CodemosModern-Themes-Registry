        "gitDecoration.modifiedResourceForeground": "#E07A5F",
        "gitDecoration.deletedResourceForeground": "#D87767",
        "gitDecoration.untrackedResourceForeground": "#A4B892",
        "gitDecoration.ignoredResourceForeground": "#74685E",
        "badge.background": "#E07A5F",
        "badge.foreground": "#1C1916",
        "button.background": "#C9684F",
        "button.foreground": "#FFF8F0",
        "button.hoverBackground": "#DE765B"
    },
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "keyword": { "foreground": "#E07A5F" },
        "modifier": { "foreground": "#E07A5F" },
        "function": { "foreground": "#7BC4AA" },
        "method": { "foreground": "#7BC4AA" },
        "class": { "foreground": "#EBC17C" },
        "struct": { "foreground": "#EBC17C" },
        "type": { "foreground": "#CFAF7A" },
        "namespace": { "foreground": "#B48EAD" },
        "parameter": { "foreground": "#D8CBBB" },
        "property": { "foreground": "#C7D4AE" },
        "variable": { "foreground": "#F6ECE3" },
        "decorator": { "foreground": "#D9A45F" },
        "enumMember": { "foreground": "#D9A45F" },
        "operator": { "foreground": "#D7C4B2" },
        "string": { "foreground": "#CFAF7A" },
        "number": { "foreground": "#B48EAD" },
        "comment": { "foreground": "#857A6F" }
    },
    "tokenColors": [
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "storage.type",
                "storage.modifier",
                "keyword.control"
            ],
            "settings": { "foreground": "#E07A5F", "fontStyle": "bold" }
        },
        {
            "name": "Strings",
            "scope": ["string", "string.quoted"],
            "settings": { "foreground": "#CFAF7A" }
        },
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#857A6F", "fontStyle": "italic" }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "meta.function-call entity.name.function",
                "support.function"
            ],
            "settings": { "foreground": "#7BC4AA" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "variable.other", "variable.parameter"],
            "settings": { "foreground": "#F6ECE3" }
        },
        {
            "name": "Types and Classes",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.type",
                "support.class"
            ],
            "settings": { "foreground": "#EBC17C" }
        },
        {
            "name": "Numbers and Constants",
            "scope": [
                "constant.numeric",
                "constant.language",
                "constant.other"
            ],
            "settings": { "foreground": "#B48EAD" }
        },
        {
            "name": "Punctuation",
            "scope": ["keyword.operator", "punctuation", "meta.brace"],
            "settings": { "foreground": "#D7C4B2" }
        },
        {
            "name": "Tags",
            "scope": ["entity.name.tag", "entity.other.attribute-name"],
            "settings": { "foreground": "#E09972" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
