{
    "$schema": "vscode://schemas/color-theme",
    "name": "Claude Dark+",
    "include": "./dark_plus.json",
    "colors": {
        "editor.background": "#1F1D1C",
        "editor.foreground": "#D4D4D4",
        "editor.inactiveSelectionBackground": "#bd694e22",
        "editorIndentGuide.background1": "#43403E",
        "editorIndentGuide.activeBackground1": "#73706D",
        "list.dropBackground": "#3A3533",
        "sideBarTitle.foreground": "#BBBBBB",
        "input.placeholderForeground": "#A6A6A6",
        "menu.background": "#2B2623",
        "menu.foreground": "#CCCCCC",
        "menu.separatorBackground": "#514843",
        "menu.border": "#514843",
        "statusBarItem.remoteForeground": "#FFFFFF",
        "statusBarItem.remoteBackground": "#16825D",
        "ports.iconRunningProcessForeground": "#369432",
        "sideBarSectionHeader.background": "#00000000",
        "sideBarSectionHeader.border": "#cccccc33",
        "tab.selectedBackground": "#3A3430",
        "tab.selectedForeground": "#ffffffa0",
        "tab.inactiveBackground": "#342E2B",
        "tab.inactiveForeground": "#D0C8C3B3",
        "tab.unfocusedActiveBackground": "#332D2A",
        "tab.unfocusedInactiveBackground": "#312B28",
        "tab.unfocusedInactiveForeground": "#C8C0BB99",
        "tab.border": "#433B37",
        "tab.lastPinnedBorder": "#cccccc33",
        "list.activeSelectionIconForeground": "#FFFFFF",
        "terminal.inactiveSelectionBackground": "#3D3734",
        "widget.border": "#3E3733",
        "actionBar.toggledBackground": "#3B3431",
        "activityBar.background": "#211D1B",
        "sideBar.background": "#25211F",
        "titleBar.activeBackground": "#2E2825",
        "titleBar.inactiveBackground": "#282320",
        "editorGroupHeader.tabsBackground": "#25201E",
        "panel.background": "#1D1A18",
        "panel.border": "#3A3330",
        "menu.selectionForeground": "#FFFFFF",
        "input.background": "#302925",
        "input.foreground": "#E6E1DE",
        "input.border": "#3E3733",
        "editorWidget.background": "#302925",
        "editorWidget.border": "#3E3733",
        "quickInput.background": "#302925",
        "quickInput.foreground": "#E6E1DE",
        "quickInputList.focusBackground": "#332B27",
        "quickInputList.focusForeground": "#FFFFFF",
        "chat.requestBackground": "#302925",
        "chat.requestBorder": "#3E3733",
        "chat.slashCommandBackground": "#332B27",
        "chat.slashCommandForeground": "#E6E1DE",
        "notifications.background": "#302925",
        "notificationCenterHeader.background": "#312A26",
        "editorHoverWidget.background": "#302925",
        "editorHoverWidget.border": "#3E3733",
        "list.hoverBackground": "#332B27",
        "focusBorder": "#bd694e",
        "sash.hoverBorder": "#bd694e",
        "pickerGroup.border": "#bd694e",
        "pickerGroup.foreground": "#bd694e",
        "progressBar.background": "#bd694e",
        "textLink.foreground": "#bd694e",
        "textLink.activeForeground": "#d37d64",
        "notificationLink.foreground": "#bd694e",
        "activityBarBadge.background": "#bd694e",
        "activityBarBadge.foreground": "#ffffff",
        "activityBar.activeBorder": "#bd694e",
        "tab.activeBorder": "#bd694e",
        "panelTitle.activeBorder": "#bd694e",
        "button.background": "#bd694e",
        "button.foreground": "#ffffff",
        "button.hoverBackground": "#a85f47",
        "button.secondaryBackground": "#3a2a26",
        "button.secondaryForeground": "#ffffff",
        "button.secondaryHoverBackground": "#47332e",
        "extensionButton.prominentBackground": "#bd694e",
        "extensionButton.prominentForeground": "#ffffff",
        "extensionButton.prominentHoverBackground": "#a85f47",
        "inputOption.activeBorder": "#bd694e",
        "checkbox.border": "#bd694e",
        "checkbox.background": "#2c1f1b",
        "checkbox.foreground": "#ffffff",
        "badge.background": "#bd694e",
        "badge.foreground": "#ffffff",
        "statusBar.background": "#bd694e",
        "statusBar.foreground": "#ffffff",
        "statusBar.border": "#00000000",
        "statusBarItem.hoverBackground": "#a85f47",
        "statusBarItem.activeBackground": "#a85f47",
        "statusBar.noFolderBackground": "#bd694e",
        "statusBar.debuggingBackground": "#bd694e",
        "menu.selectionBackground": "#bd694e",
        "editor.selectionBackground": "#bd694e44",
        "editor.selectionHighlightBackground": "#bd694e33",
        "selection.background": "#bd694e55",
        "list.activeSelectionBackground": "#bd694e33",
        "list.activeSelectionForeground": "#ffffff",
        "list.inactiveSelectionBackground": "#bd694e22",
        "list.inactiveSelectionForeground": "#ffffff",
        "list.highlightForeground": "#bd694e",
        "editorSuggestWidget.selectedBackground": "#4a312b",
        "editorSuggestWidget.highlightForeground": "#bd694e",
        "editorHoverWidget.highlightForeground": "#bd694e",
        "list.focusOutline": "#bd694e",
        "editor.wordHighlightBackground": "#bd694e22",
        "editor.wordHighlightStrongBackground": "#bd694e33",
        "editorBracketMatch.border": "#bd694e"
    },
    "tokenColors": [
        {
            "name": "Function declarations",
            "scope": [
                "entity.name.function",
                "support.function",
                "support.constant.handlebars",
                "source.powershell variable.other.member",
                "entity.name.operator.custom-literal"
            ],
            "settings": { "foreground": "#DCDCAA" }
        },
        {
            "name": "Types declaration and references",
            "scope": [
                "support.class",
                "support.type",
                "entity.name.type",
                "entity.name.namespace",
                "entity.other.attribute",
                "entity.name.scope-resolution",
                "entity.name.class",
                "storage.type.numeric.go",
                "storage.type.byte.go",
                "storage.type.boolean.go",
                "storage.type.string.go",
                "storage.type.uintptr.go",
                "storage.type.error.go",
                "storage.type.rune.go",
                "storage.type.cs",
                "storage.type.generic.cs",
                "storage.type.modifier.cs",
                "storage.type.variable.cs",
                "storage.type.annotation.java",
                "storage.type.generic.java",
                "storage.type.java",
                "storage.type.object.array.java",
                "storage.type.primitive.array.java",
                "storage.type.primitive.java",
                "storage.type.token.java",
                "storage.type.groovy",
                "storage.type.annotation.groovy",
                "storage.type.parameters.groovy",
                "storage.type.generic.groovy",
                "storage.type.object.array.groovy",
                "storage.type.primitive.array.groovy",
                "storage.type.primitive.groovy"
            ],
            "settings": { "foreground": "#4EC9B0" }
        },
        {
            "name": "Types declaration and references, TS grammar specific",
            "scope": [
                "meta.type.cast.expr",
                "meta.type.new.expr",
                "support.constant.math",
                "support.constant.dom",
                "support.constant.json",
                "entity.other.inherited-class",
                "punctuation.separator.namespace.ruby"
            ],
            "settings": { "foreground": "#4EC9B0" }
        },
        {
            "name": "Control flow / Special keywords",
            "scope": [
                "keyword.control",
                "source.cpp keyword.operator.new",
                "keyword.operator.delete",
                "keyword.other.using",
                "keyword.other.directive.using",
                "keyword.other.operator",
                "entity.name.operator"
            ],
            "settings": { "foreground": "#C586C0" }
        },
        {
            "name": "Variable and parameter name",
            "scope": [
                "variable",
                "meta.definition.variable.name",
                "support.variable",
                "entity.name.variable",
                "constant.other.placeholder"
            ],
            "settings": { "foreground": "#9CDCFE" }
        },
        {
            "name": "Constants and enums",
            "scope": ["variable.other.constant", "variable.other.enummember"],
            "settings": { "foreground": "#4FC1FF" }
        },
        {
            "name": "Object keys, TS grammar specific",
            "scope": ["meta.object-literal.key"],
            "settings": { "foreground": "#9CDCFE" }
        },
        {
            "name": "CSS property value",
            "scope": [
                "support.constant.property-value",
                "support.constant.font-name",
                "support.constant.media-type",
                "support.constant.media",
                "constant.other.color.rgb-value",
                "constant.other.rgb-value",
                "support.constant.color"
            ],
            "settings": { "foreground": "#CE9178" }
        },
        {
            "name": "Regular expression groups",
            "scope": [
                "punctuation.definition.group.regexp",
                "punctuation.definition.group.assertion.regexp",
                "punctuation.definition.character-class.regexp",
                "punctuation.character.set.begin.regexp",
                "punctuation.character.set.end.regexp",
                "keyword.operator.negation.regexp",
                "support.other.parenthesis.regexp"
            ],
            "settings": { "foreground": "#CE9178" }
        },
        {
            "scope": [
                "constant.character.character-class.regexp",
                "constant.other.character-class.set.regexp",
                "constant.other.character-class.regexp",
                "constant.character.set.regexp"
            ],
            "settings": { "foreground": "#d16969" }
        },
        {
            "scope": [
                "keyword.operator.or.regexp",
                "keyword.control.anchor.regexp"
            ],
            "settings": { "foreground": "#DCDCAA" }
        },
        {
            "scope": "keyword.operator.quantifier.regexp",
            "settings": { "foreground": "#d7ba7d" }
        },
        {
            "scope": ["constant.character", "constant.other.option"],
            "settings": { "foreground": "#569cd6" }
        },
        {
            "scope": "constant.character.escape",
            "settings": { "foreground": "#d7ba7d" }
        },
        {
            "scope": "entity.name.label",
            "settings": { "foreground": "#C8C8C8" }
        }
    ],
    "semanticHighlighting": true
}
