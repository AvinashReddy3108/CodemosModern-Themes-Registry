        "notifications.background": "#2C2E32",
        "notifications.foreground": "#D4D0CC",
        "notifications.border": "#3A3C42",
        "scrollbarSlider.background": "#4A4C5055",
        "scrollbarSlider.hoverBackground": "#5A5C6066",
        "scrollbarSlider.activeBackground": "#6A6C7077",
        "gitDecoration.addedResourceForeground": "#78A280",
        "gitDecoration.modifiedResourceForeground": "#8898AC",
        "gitDecoration.deletedResourceForeground": "#D87080",
        "gitDecoration.untrackedResourceForeground": "#78A280"
    },
    "tokenColors": [
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#6C6864", "fontStyle": "italic" }
        },
        {
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#5E8A64" }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.language",
                "constant.character"
            ],
            "settings": { "foreground": "#B89040" }
        },
        {
            "scope": ["constant.character.escape", "constant.other.symbol"],
            "settings": { "foreground": "#9C6880" }
        },
        {
            "scope": ["keyword", "storage", "storage.modifier"],
            "settings": { "foreground": "#C45C6A" }
        },
        {
            "scope": ["keyword.operator", "punctuation"],
            "settings": { "foreground": "#9C9894" }
        },
        {
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call"
            ],
            "settings": { "foreground": "#B89040" }
        },
        {
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#5E8A64", "fontStyle": "italic" }
        },
        {
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.type",
                "support.class"
            ],
            "settings": { "foreground": "#6B7F94" }
        },
        {
            "scope": [
                "entity.other.attribute-name",
                "support.constant.property-value",
                "meta.object-literal.key"
            ],
            "settings": { "foreground": "#B89040" }
        },
        {
            "scope": ["variable", "identifier"],
            "settings": { "foreground": "#D4D0CC" }
        },
        {
            "scope": ["entity.name.tag", "punctuation.definition.tag"],
            "settings": { "foreground": "#C45C6A" }
        },
        {
            "scope": ["support.constant", "support.variable"],
            "settings": { "foreground": "#6B7F94" }
        },
        {
            "scope": ["markup.heading", "markup.bold"],
            "settings": { "foreground": "#B89040", "fontStyle": "bold" }
        },
        {
            "scope": ["markup.italic"],
            "settings": { "foreground": "#C45C6A", "fontStyle": "italic" }
        },
        {
            "scope": ["markup.inline.raw", "markup.fenced_code"],
            "settings": { "foreground": "#6B7F94" }
        },
        {
            "scope": ["markup.quote"],
            "settings": { "foreground": "#9C9894", "fontStyle": "italic" }
        },
        {
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#E8E4E0", "background": "#C45C6A" }
        }
    ],
    "semanticTokenColors": {
        "comment": { "foreground": "#6C6864", "fontStyle": "italic" },
        "keyword": "#C45C6A",
        "operator": "#9C9894",
        "string": "#5E8A64",
        "number": "#B89040",
        "regexp": "#6B7F94",
        "variable": "#D4D0CC",
        "parameter": { "foreground": "#5E8A64", "fontStyle": "italic" },
        "property": "#9C9894",
        "function": "#B89040",
        "method": "#B89040",
        "namespace": "#B89040",
        "type": "#6B7F94",
        "class": "#6B7F94",
        "interface": { "foreground": "#6B7F94", "fontStyle": "italic" },
        "enum": "#B89040",
        "enumMember": "#D0A850",
        "typeParameter": "#6B7F94",
        "decorator": "#C45C6A",
        "macro": "#C45C6A"
    }
}
