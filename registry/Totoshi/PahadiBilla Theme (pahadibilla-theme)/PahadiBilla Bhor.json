        "notifications.background": "#FAF5EE",
        "notifications.foreground": "#2E2419",
        "notifications.border": "#D4C4B0",
        "scrollbarSlider.background": "#B5A49455",
        "scrollbarSlider.hoverBackground": "#A0908066",
        "scrollbarSlider.activeBackground": "#8C7B6B77",
        "gitDecoration.addedResourceForeground": "#5A7A63",
        "gitDecoration.modifiedResourceForeground": "#6E8FA8",
        "gitDecoration.deletedResourceForeground": "#7A3530",
        "gitDecoration.untrackedResourceForeground": "#5A7A63"
    },
    "tokenColors": [
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#8C7B6B", "fontStyle": "italic" }
        },
        {
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#5A7A63" }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.language",
                "constant.character"
            ],
            "settings": { "foreground": "#8A6A28" }
        },
        {
            "scope": ["constant.character.escape", "constant.other.symbol"],
            "settings": { "foreground": "#7A4A5C" }
        },
        {
            "scope": ["keyword", "storage", "storage.modifier"],
            "settings": { "foreground": "#7A3530" }
        },
        {
            "scope": ["keyword.operator", "punctuation"],
            "settings": { "foreground": "#5C4D40" }
        },
        {
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call"
            ],
            "settings": { "foreground": "#A86832" }
        },
        {
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#5A7A63", "fontStyle": "italic" }
        },
        {
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.type",
                "support.class"
            ],
            "settings": { "foreground": "#6E8FA8" }
        },
        {
            "scope": [
                "entity.other.attribute-name",
                "support.constant.property-value",
                "meta.object-literal.key"
            ],
            "settings": { "foreground": "#8A6A28" }
        },
        {
            "scope": ["variable", "identifier"],
            "settings": { "foreground": "#2E2419" }
        },
        {
            "scope": ["entity.name.tag", "punctuation.definition.tag"],
            "settings": { "foreground": "#7A3530" }
        },
        {
            "scope": ["support.constant", "support.variable"],
            "settings": { "foreground": "#6E8FA8" }
        },
        {
            "scope": ["markup.heading", "markup.bold"],
            "settings": { "foreground": "#A86832", "fontStyle": "bold" }
        },
        {
            "scope": ["markup.italic"],
            "settings": { "foreground": "#7A3530", "fontStyle": "italic" }
        },
        {
            "scope": ["markup.inline.raw", "markup.fenced_code"],
            "settings": { "foreground": "#6E8FA8" }
        },
        {
            "scope": ["markup.quote"],
            "settings": { "foreground": "#5C4D40", "fontStyle": "italic" }
        },
        {
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#FAF5EE", "background": "#7A3530" }
        }
    ],
    "semanticTokenColors": {
        "comment": { "foreground": "#8C7B6B", "fontStyle": "italic" },
        "keyword": "#7A3530",
        "operator": "#5C4D40",
        "string": "#5A7A63",
        "number": "#8A6A28",
        "regexp": "#6E8FA8",
        "variable": "#2E2419",
        "parameter": { "foreground": "#5A7A63", "fontStyle": "italic" },
        "property": "#5C4D40",
        "function": "#A86832",
        "method": "#A86832",
        "namespace": "#8A6A28",
        "type": "#6E8FA8",
        "class": "#6E8FA8",
        "interface": { "foreground": "#6E8FA8", "fontStyle": "italic" },
        "enum": "#8A6A28",
        "enumMember": "#9A7B3A",
        "typeParameter": "#6E8FA8",
        "decorator": "#7A3530",
        "macro": "#7A3530"
    }
}
