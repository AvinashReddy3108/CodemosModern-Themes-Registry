        "terminal.ansiBlue": "#E7A5FF",
        "terminal.ansiBrightBlack": "#6A2AFF",
        "terminal.ansiBrightBlue": "#E7A5FF",
        "terminal.ansiBrightCyan": "#F6D2FF",
