        "terminal.ansiBrightYellow": "#8167FF",
        "terminal.ansiCyan": "#F6D2FF",
        "terminal.ansiGreen": "#5A2FD0",
        "terminal.ansiMagenta": "#8167FF",
        "terminal.ansiRed": "#B6A7FF",
