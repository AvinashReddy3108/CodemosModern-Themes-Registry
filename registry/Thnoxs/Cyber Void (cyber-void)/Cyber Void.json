{
    "name": "Aura Glass One Master",
    "type": "dark",
    "colors": {
        "editor.background": "#0d1117",
        "editor.foreground": "#aab2bf",
        "editorGroupHeader.tabsBackground": "#0d1117",
        "breadcrumb.background": "#0d1117",
        "activityBar.background": "#0d1117",
        "activityBar.border": "#ffffff15",
        "sideBar.background": "#0d1117",
        "sideBar.border": "#ffffff15",
        "titleBar.activeBackground": "#0d1117",
        "titleBar.border": "#ffffff15",
        "tab.activeBackground": "#161b22",
        "tab.activeForeground": "#ffffff",
        "tab.activeBorderTop": "#c376da",
        "tab.border": "#ffffff15",
        "tab.inactiveBackground": "#0d1117",
        "tab.inactiveForeground": "#5c6370",
        "editorCursor.foreground": "#ffffff",
        "editor.lineHighlightBackground": "#ffffff08",
        "editor.selectionBackground": "#61b0ef33",
        "list.hoverBackground": "#ffffff10",
        "list.activeSelectionBackground": "#ffffff1a"
    },
    "tokenColors": [
        {
            "scope": ["support.type.property-name.css"],
            "settings": { "foreground": "#61b0ef" }
        },
        {
            "name": "Function Names",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call",
                "entity.name.function.member"
            ],
            "settings": { "foreground": "#61b0ef" }
        },
        {
            "name": "Console Object",
            "scope": ["support.class.console", "support.variable.dom"],
            "settings": { "foreground": "#61b0ef" }
        },
        {
            "name": "Console Methods",
            "scope": ["support.function.console"],
            "settings": { "foreground": "#d19966" }
        },
        {
            "scope": [
                "keyword",
                "storage.type",
                "storage.modifier",
                "keyword.control"
            ],
            "settings": { "foreground": "#c376da", "fontStyle": "bold" }
        },
        {
            "scope": [
                "variable",
                "variable.other.readwrite",
                "variable.parameter"
            ],
            "settings": { "foreground": "#aab2bf" }
        },
        { "scope": ["string"], "settings": { "foreground": "#8bb170" } },
        {
            "scope": ["support.constant.property-value.css"],
            "settings": { "foreground": "#d19966" }
        },
        {
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#c376da" }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "function": "#61b0ef",
        "method": "#d19966",
        "variable.defaultLibrary": "#61b0ef",
        "variable": "#aab2bf",
        "keyword": "#c376da",
        "property": "#aab2bf"
    },
    "$schema": "vscode://schemas/color-theme"
}
