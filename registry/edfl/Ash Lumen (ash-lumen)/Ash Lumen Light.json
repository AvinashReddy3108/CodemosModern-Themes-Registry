    "tokenColors": [
        { "settings": { "foreground": "#505050" } },
        {
            "scope": [
                "keyword.operator.accessor",
                "meta.group.braces.round.function.arguments",
                "meta.template.expression",
                "markup.fenced_code meta.embedded.block"
            ],
            "settings": { "foreground": "#404040" }
        },
        { "scope": "emphasis", "settings": { "fontStyle": "italic" } },
        {
            "scope": [
                "strong",
                "markup.heading.markdown",
                "markup.bold.markdown"
            ],
            "settings": { "fontStyle": "bold", "foreground": "#303030" }
        },
        {
            "scope": ["markup.italic.markdown"],
            "settings": { "fontStyle": "italic" }
        },
        {
            "scope": "meta.link.inline.markdown",
            "settings": { "fontStyle": "underline", "foreground": "#707070" }
        },
        {
            "scope": ["string", "markup.fenced_code", "markup.inline"],
            "settings": { "foreground": "#436843" }
        },
        {
            "scope": ["comment", "string.quoted.docstring.multi"],
            "settings": { "foreground": "#b8b8b8" }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.language",
                "constant.other.placeholder",
                "constant.character.format.placeholder",
                "variable.language.this",
                "variable.other.object",
                "variable.other.class",
                "variable.other.constant",
                "meta.property-name",
                "meta.property-value",
                "support"
            ],
            "settings": { "foreground": "#445068" }
        },
        {
            "scope": [
                "keyword",
                "storage.modifier",
                "storage.type",
                "storage.control.clojure",
                "entity.name.function.clojure",
                "entity.name.tag.yaml",
                "support.function.node",
                "support.type.property-name.json",
                "punctuation.separator.key-value",
                "punctuation.definition.template-expression"
            ],
            "settings": { "foreground": "#7a4e4e" }
        },
        {
            "scope": "variable.parameter.function",
            "settings": { "foreground": "#6a4e4e" }
        },
        {
            "scope": [
                "support.function",
                "entity.name.type",
                "entity.other.inherited-class",
                "meta.function-call",
                "meta.instance.constructor",
                "entity.other.attribute-name",
                "entity.name.function",
                "constant.keyword.clojure"
            ],
            "settings": { "foreground": "#404040" }
        },
        {
            "scope": [
                "entity.name.tag",
                "string.quoted",
                "string.regexp",
                "string.interpolated",
                "string.template",
                "string.unquoted.plain.out.yaml",
                "keyword.other.template"
            ],
            "settings": { "foreground": "#486048" }
        },
        {
            "scope": "token.info-token",
            "settings": { "foreground": "#607080" }
        },
        {
            "scope": "token.warn-token",
            "settings": { "foreground": "#808060" }
        },
        {
            "scope": "token.error-token",
            "settings": { "foreground": "#806060" }
        },
        {
            "scope": "token.debug-token",
            "settings": { "foreground": "#808080" }
        },
        {
            "scope": [
                "punctuation.definition.arguments",
                "punctuation.definition.dict",
                "punctuation.separator",
                "meta.function-call.arguments"
            ],
            "settings": { "foreground": "#909090" }
        },
        {
            "name": "[Custom] Markdown links",
            "scope": [
                "markup.underline.link",
                "punctuation.definition.metadata.markdown"
            ],
            "settings": { "foreground": "#436843" }
        },
        {
            "name": "[Custom] Markdown list",
            "scope": ["beginning.punctuation.definition.list.markdown"],
            "settings": { "foreground": "#7a4e4e" }
        },
        {
            "name": "[Custom] Markdown punctuation definition brackets",
            "scope": [
                "punctuation.definition.string.begin.markdown",
                "punctuation.definition.string.end.markdown",
                "string.other.link.title.markdown",
                "string.other.link.description.markdown"
            ],
            "settings": { "foreground": "#445068" }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "function": "#404040",
        "function.declaration": "#404040",
        "method": "#404040",
        "method.declaration": "#404040",
        "variable": "#505050",
        "variable.declaration": "#505050",
        "variable.readonly": "#445068",
        "variable.readonly.defaultLibrary": "#445068",
        "parameter": "#6a4e4e",
        "parameter.declaration": "#6a4e4e",
        "property": "#505050",
        "property.readonly": "#445068",
        "type": "#404040",
        "type.declaration": "#404040",
        "class": "#404040",
        "interface": "#404040",
        "enum": "#404040",
        "enumMember": "#445068",
        "namespace": "#505050",
        "string": "#436843",
        "number": "#505050",
        "regexp": "#486048",
        "keyword": "#7a4e4e",
        "comment": "#b8b8b8",
        "decorator": "#707070",
        "typeParameter": "#505050"
    },
    "$schema": "vscode://schemas/color-theme"
}
