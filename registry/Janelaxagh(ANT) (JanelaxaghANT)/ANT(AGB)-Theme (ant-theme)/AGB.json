{
    "name": "AGB",
    "colors": {
        "editor.background": "#0E0D0E",
        "editor.foreground": "#FFFEFF",
        "list.activeSelectionIconForeground": "#FFFD19"
    },
    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "fontStyle": "italic", "foreground": "#878D86" }
        },
        {
            "name": "Operators",
            "scope": "keyword.operator",
            "settings": { "foreground": "#777777" }
        },
        {
            "name": "Keywords",
            "scope": ["keyword", "storage"],
            "settings": { "foreground": "#EC2828" }
        },
        {
            "name": "Types",
            "scope": ["storage.type", "support.type"],
            "settings": { "foreground": "#214A5E" }
        },
        {
            "name": "Language Constants",
            "scope": [
                "constant.language",
                "support.constant",
                "variable.language"
            ],
            "settings": { "foreground": "#AB6526" }
        },
        {
            "name": "Constants",
            "scope": [
                "constant.language",
                "support.constant",
                "variable.language"
            ],
            "settings": { "foreground": "#B88941" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "support.variable"],
            "settings": { "foreground": "#3872BD" }
        },
        {
            "name": "Functions",
            "scope": ["entity.name.function", "support.function"],
            "settings": { "fontStyle": "bold", "foreground": "#6B1105" }
        },
        {
            "name": "Classes",
            "scope": [
                "entity.name.type",
                "entity.other.inherited-class",
                "support.class"
            ],
            "settings": { "fontStyle": "bold", "foreground": "#DAFEAA" }
        },
        {
            "name": "Numbers, Characters",
            "scope": ["constant.numeric", "constant.character", "constant"],
            "settings": { "foreground": "#EDEEEC" }
        },
        {
            "name": "Strings",
            "scope": "string",
            "settings": { "foreground": "#F3110C" }
        },
        {
            "name": "Strings: Regular Expressions",
            "scope": "string.regexp",
            "settings": { "foreground": "#4B83CD" }
        },
        {
            "name": "HTML: Tags",
            "scope": [
                "meta.tag",
                "punctuation.definition.tag.html",
                "punctuation.definition.tag.begin.html",
                "punctuation.definition.tag.end.html"
            ],
            "settings": { "foreground": "#91B3E0" }
        },
        {
            "name": "HTML: Tag Names",
            "scope": "entity.name.tag",
            "settings": { "foreground": "#4B83CD" }
        },
        {
            "name": "HTML: Attribute Names",
            "scope": [
                "meta.tag entity.other.attribute-name",
                "entity.other.attribute-name.html"
            ],
            "settings": { "fontStyle": "italic", "foreground": "#91B3E0" }
        },
        {
            "name": "CSS: Property Names",
            "scope": ["meta.property-name", "support.type.property-name"],
            "settings": { "foreground": "#AB6526" }
        },
        {
            "name": "CSS: Property Values",
            "scope": [
                "meta.property-value",
                "meta.property-value constant.other",
                "support.constant.property-value"
            ],
            "settings": { "foreground": "#448C27" }
        },
        {
            "name": "Invalid - Illegal",
            "scope": "invalid.illegal",
            "settings": { "foreground": "#660000" }
        },
        {
            "name": "Markup: Changed",
            "scope": "markup.changed",
            "settings": { "foreground": "#FEFFD8" }
        },
        {
            "name": "Markup: Deletion",
            "scope": "markup.deleted",
            "settings": { "foreground": "#F3110C" }
        },
        {
            "name": "Markup: Insertion",
            "scope": "markup.inserted",
            "settings": { "foreground": "#DAFEAA" }
        },
        {
            "name": "Markup: Emphasis",
            "scope": "markup.italic",
            "settings": { "fontStyle": "italic", "foreground": "#B88941" }
        },
        {
            "name": "Markup: Link",
            "scope": "meta.link",
            "settings": { "foreground": "#3872BD" }
        },
        {
            "name": "Markup: Strong",
            "scope": "markup.bold",
            "settings": { "fontStyle": "bold", "foreground": "#EC2828" }
        },
        {
            "name": "Markup: Heading",
            "scope": "markup.heading",
            "settings": { "foreground": "#6B1105", "fontStyle": "bold" }
        },
        {
            "name": "Markup: Quote",
            "scope": "markup.quote",
            "settings": { "foreground": "#7A3E9D" }
        },
        {
            "name": "Markup Lists",
            "scope": "markup.list",
            "settings": { "foreground": "#4B83CD" }
        },
        {
            "name": "Extra: Diff Range",
            "scope": ["meta.diff.range", "meta.diff.index", "meta.separator"],
            "settings": { "foreground": "#434343" }
        },
        {
            "name": "Extra: Diff From",
            "scope": "meta.diff.header.from-file",
            "settings": { "foreground": "#B88941" }
        },
        {
            "name": "Extra: Diff To",
            "scope": "meta.diff.header.to-file",
            "settings": { "foreground": "#B88941" }
        },
        {
            "name": "HTML: Entities",
            "scope": [
                "constant.character.entity",
                "punctuation.definition.entity"
            ],
            "settings": { "foreground": "#FEFFD8" }
        },
        {
            "name": "CSS: Selectors",
            "scope": [
                "meta.selector",
                "meta.selector entity",
                "meta.selector entity punctuation",
                "entity.name.tag.css"
            ],
            "settings": { "foreground": "#DAFEAA" }
        },
        {
            "name": "Markup: Error",
            "scope": "markup.error",
            "settings": { "foreground": "#F3110C" }
        },
        {
            "name": "Markup: Link",
            "scope": "markup.link",
            "settings": { "foreground": "#3872BD" }
        },
        {
            "name": "Markup: Strong",
            "scope": "markup.bold",
            "settings": { "fontStyle": "bold", "foreground": "#6B1105" }
        },
        {
            "name": "Markup: Emphasis",
            "scope": "markup.italic",
            "settings": { "fontStyle": "italic", "foreground": "#878D86" }
        },
        {
            "name": "Markup: Insertion",
            "scope": "markup.inserted",
            "settings": { "foreground": "#DAFEAA" }
        },
        {
            "name": "Markup: Deletion",
            "scope": "markup.deleted",
            "settings": { "foreground": "#F3110C" }
        },
        {
            "name": "Diff: Added",
            "scope": "markup.inserted.diff",
            "settings": { "foreground": "#DAFEAA" }
        },
        {
            "name": "Diff: Removed",
            "scope": "markup.deleted.diff",
            "settings": { "foreground": "#F3110C" }
        },
        {
            "name": "Diff: Changed",
            "scope": "markup.changed.diff",
            "settings": { "foreground": "#FFFD19" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
