    "tokenColors": [
        {
            "name": "Comment",
            "scope": "comment",
            "settings": { "foreground": "#737d8c", "fontStyle": "italic" }
        },
        {
            "name": "Preprocessor Statements",
            "scope": ["meta.preprocessor", "keyword.control.import"],
            "settings": { "foreground": "#734b32" }
        },
        {
            "name": "String",
            "scope": "string",
            "settings": { "foreground": "#c83c28" }
        },
        {
            "name": "Number",
            "scope": "constant.numeric",
            "settings": { "foreground": "#3c00dc" }
        },
        {
            "name": "Built-in constant",
            "scope": "constant.language",
            "settings": { "foreground": "#c800a5" }
        },
        {
            "name": "User-defined constant",
            "scope": ["constant.character", "constant.other"],
            "settings": { "foreground": "#285a5f" }
        },
        {
            "name": "Variable",
            "scope": ["variable.language", "variable.other"],
            "settings": { "foreground": "#c800a5" }
        },
        {
            "name": "Keyword",
            "scope": "keyword",
            "settings": { "foreground": "#c800a5" }
        },
        {
            "name": "Storage",
            "scope": "storage",
            "settings": { "foreground": "#c800a5" }
        },
        {
            "name": "Class name",
            "scope": "entity.name.class",
            "settings": { "foreground": "#418787" }
        },
        {
            "name": "Inherited class",
            "scope": "entity.other.inherited-class",
            "settings": {}
        },
        {
            "name": "Function name",
            "scope": "entity.name.function",
            "settings": {}
        },
        {
            "name": "Function argument",
            "scope": "variable.parameter",
            "settings": {}
        },
        {
            "name": "Tag name",
            "scope": "entity.name.tag",
            "settings": { "foreground": "#780faf" }
        },
        {
            "name": "Tag attribute",
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#460082" }
        },
        {
            "name": "Library function",
            "scope": "support.function",
            "settings": { "foreground": "#460082" }
        },
        {
            "name": "Library constant",
            "scope": "support.constant",
            "settings": { "foreground": "#460082" }
        },
        {
            "name": "Library class/type",
            "scope": ["support.type", "support.class"],
            "settings": { "foreground": "#780faf" }
        },
        {
            "name": "Library variable",
            "scope": "support.other.variable",
            "settings": { "foreground": "#780faf" }
        },
        { "name": "Invalid", "scope": "invalid", "settings": {} },
        {
            "name": "Info Token",
            "scope": "token.info-token",
            "settings": { "foreground": "#3264c8" }
        },
        {
            "name": "Warning Token",
            "scope": "token.warn-token",
            "settings": { "foreground": "#c89632" }
        },
        {
            "name": "Error Token",
            "scope": "token.error-token",
            "settings": { "foreground": "#c83232" }
        },
        {
            "name": "Debug Token",
            "scope": "token.debug-token",
            "settings": { "foreground": "#820082" }
        },
        {
            "name": "Markup Heading",
            "scope": "markup.heading",
            "settings": { "foreground": "#80bdff", "fontStyle": "bold" }
        },
        {
            "name": "Markup Top-Level Heading",
            "scope": "markup.heading.1.html",
            "settings": { "foreground": "#3396ff" }
        },
        {
            "name": "Markup Heading Level 2",
            "scope": "markup.heading.2.html",
            "settings": { "foreground": "#4da3ff" }
        },
        {
            "name": "Markup Heading Level 3",
            "scope": "markup.heading.3.html",
            "settings": { "foreground": "#66b0ff" }
        },
        {
            "name": "Markup Bold",
            "scope": "markup.bold",
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Markup Italic",
            "scope": "markup.italic",
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "Markup Underline",
            "scope": "markup.underline",
            "settings": { "fontStyle": "underline" }
        },
        {
            "name": "Markup Quote",
            "scope": "markup.quote",
            "settings": { "foreground": "#1abeff" }
        },
        {
            "name": "Markup Raw Inline",
            "scope": "markup.inline.raw",
            "settings": { "foreground": "#64d2ff" }
        },
        {
            "name": "Markup Link",
            "scope": "markup.underline.link",
            "settings": { "foreground": "#0a84ff" }
        },
        {
            "name": "Markup List",
            "scope": "markup.list",
            "settings": { "foreground": "#e6e6e6" }
        }
    ]
}
