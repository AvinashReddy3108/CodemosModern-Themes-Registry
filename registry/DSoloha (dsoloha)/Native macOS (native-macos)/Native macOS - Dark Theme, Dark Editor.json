    "tokenColors": [
        {
            "name": "Comment",
            "scope": "comment",
            "settings": { "foreground": "#828c96", "fontStyle": "italic" }
        },
        {
            "name": "Preprocessor Statements",
            "scope": ["meta.preprocessor", "keyword.control.import"],
            "settings": { "foreground": "#f5a55f" }
        },
        {
            "name": "String",
            "scope": "string",
            "settings": { "foreground": "#ff8773" }
        },
        {
            "name": "Template string expressions",
            "scope": [
                "meta.template.expression",
                "keyword.operator.assignment"
            ],
            "settings": { "foreground": "#ffffff" }
        },
        {
            "name": "Template string interpolation",
            "scope": [
                "punctuation.definition.template-expression.begin",
                "punctuation.definition.template-expression.end",
                "punctuation.section.embedded"
            ],
            "settings": { "foreground": "#9664c8" }
        },
        {
            "name": "Number",
            "scope": "constant.numeric",
            "settings": { "foreground": "#d7cd7d" }
        },
        {
            "name": "Built-in constant",
            "scope": "constant.language",
            "settings": { "foreground": "#f082aa", "fontStyle": "bold" }
        },
        {
            "name": "User-defined constant",
            "scope": "constant.character",
            "settings": { "foreground": "#64afc8" }
        },
        {
            "name": "Variable",
            "scope": "variable",
            "settings": { "foreground": "#64b4a0" }
        },
        {
            "name": "Variable property",
            "scope": "variable.other.property",
            "settings": { "foreground": "#a0f0dc" }
        },
        {
            "name": "Keyword",
            "scope": "keyword",
            "settings": { "foreground": "#f082aa", "fontStyle": "bold" }
        },
        {
            "name": "Operator",
            "scope": [
                "keyword.operator",
                "keyword.operator.arithmetic",
                "storage.type.function.arrow"
            ],
            "settings": { "foreground": "#9664c8" }
        },
        {
            "name": "Storage",
            "scope": "storage",
            "settings": { "foreground": "#f082aa", "fontStyle": "bold" }
        },
        {
            "name": "Types",
            "scope": "support.type.property-name",
            "settings": { "foreground": "#87dcfa" }
        },
        {
            "name": "Class name",
            "scope": "entity.name.type.class",
            "settings": { "foreground": "#bef0e6" }
        },
        {
            "name": "Superclass",
            "scope": "entity.other.inherited-class",
            "settings": { "foreground": "#87beb4", "fontStyle": "bold" }
        },
        {
            "name": "Function name",
            "scope": "entity.name.function",
            "settings": { "foreground": "#64afc8" }
        },
        {
            "name": "Invoked function",
            "scope": "entity.name.function.method",
            "settings": { "foreground": "#64b4a0" }
        },
        {
            "name": "Function argument",
            "scope": "variable.parameter",
            "settings": { "foreground": "#ffffff" }
        },
        {
            "name": "Reserved keywords",
            "scope": "variable.language",
            "settings": { "foreground": "#f082aa", "fontStyle": "bold" }
        },
        {
            "name": "Tag name",
            "scope": "entity.name.tag",
            "settings": { "foreground": "#f082aa" }
        },
        {
            "name": "Tag attribute",
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#d7cd7d" }
        },
        {
            "name": "Library function",
            "scope": "support.function",
            "settings": { "foreground": "#aa82e6" }
        },
        {
            "name": "Library constant",
            "scope": "support.constant",
            "settings": { "foreground": "#aa82e6" }
        },
        {
            "name": "Library class/type",
            "scope": ["support.type", "support.class"],
            "settings": { "foreground": "#d2befa" }
        },
        {
            "name": "Library variable",
            "scope": "support.other.variable",
            "settings": { "foreground": "#d2befa" }
        },
        { "name": "Invalid", "scope": "invalid", "settings": {} },
        {
            "name": "Info Token",
            "scope": "token.info-token",
            "settings": { "foreground": "#3264c8" }
        },
        {
            "name": "Warning Token",
            "scope": "token.warn-token",
            "settings": { "foreground": "#c89632" }
        },
        {
            "name": "Error Token",
            "scope": "token.error-token",
            "settings": { "foreground": "#c83232" }
        },
        {
            "name": "Debug Token",
            "scope": "token.debug-token",
            "settings": { "foreground": "#820082" }
        },
        {
            "name": "Markup Heading",
            "scope": "markup.heading",
            "settings": { "foreground": "#80bdff", "fontStyle": "bold" }
        },
        {
            "name": "Markup Top-Level Heading",
            "scope": "markup.heading.1.html",
            "settings": { "foreground": "#3396ff" }
        },
        {
            "name": "Markup Heading Level 2",
            "scope": "markup.heading.2.html",
            "settings": { "foreground": "#4da3ff" }
        },
        {
            "name": "Markup Heading Level 3",
            "scope": "markup.heading.3.html",
            "settings": { "foreground": "#66b0ff" }
        },
        {
            "name": "Markup Bold",
            "scope": "markup.bold",
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Markup Italic",
            "scope": "markup.italic",
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "Markup Underline",
            "scope": "markup.underline",
            "settings": { "fontStyle": "underline" }
        },
        {
            "name": "Markup Quote",
            "scope": "markup.quote",
            "settings": { "foreground": "#1abeff" }
        },
        {
            "name": "Markup Raw Inline",
            "scope": "markup.inline.raw",
            "settings": { "foreground": "#64d2ff" }
        },
        {
            "name": "Markup Link",
            "scope": "markup.underline.link",
            "settings": { "foreground": "#0a84ff" }
        },
        {
            "name": "Markup List",
            "scope": "markup.list",
            "settings": { "foreground": "#e6e6e6" }
        }
    ]
}
