    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#8799a8", "fontStyle": "italic" }
        },
        {
            "name": "String",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#9ec8bf" }
        },
        {
            "name": "String Escape / Regexp",
            "scope": ["constant.character.escape", "string.regexp"],
            "settings": { "foreground": "#88bdb5" }
        },
        {
            "name": "Number",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#c9a96a" }
        },
        {
            "name": "Boolean / Language Constant",
            "scope": ["constant.language"],
            "settings": { "foreground": "#c9a96a" }
        },
        {
            "name": "Keyword / Storage",
            "scope": ["keyword", "storage"],
            "settings": { "foreground": "#c44f5f" }
        },
        {
            "name": "Operator",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#6c92b3" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation.separator",
                "punctuation.terminator",
                "punctuation.accessor"
            ],
            "settings": { "foreground": "#6f7f8a" }
        },
        {
            "name": "Function / Method Name",
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#ff8a98" }
        },
        {
            "name": "Type / Class / Namespace",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "entity.name.namespace",
                "entity.name.enum",
                "support.class",
                "support.type"
            ],
            "settings": { "foreground": "#8fa9bf" }
        },
        {
            "name": "Variable",
            "scope": ["variable", "meta.definition.variable"],
            "settings": { "foreground": "#e7edf2" }
        },
        {
            "name": "Language Variable (this / self / super)",
            "scope": ["variable.language"],
            "settings": { "foreground": "#ff8a98", "fontStyle": "italic" }
        },
        {
            "name": "Constant",
            "scope": [
                "constant",
                "variable.other.constant",
                "support.constant"
            ],
            "settings": { "foreground": "#c26b73" }
        },
        {
            "name": "Decorator / Annotation",
            "scope": [
                "meta.decorator",
                "punctuation.decorator",
                "storage.type.decorator",
                "entity.name.function.decorator"
            ],
            "settings": { "foreground": "#c26b73" }
        },
        {
            "name": "Tag Name",
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#c44f5f" }
        },
        {
            "name": "Tag Attribute",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#9ec8bf" }
        },
        {
            "name": "Tag Punctuation",
            "scope": [
                "punctuation.definition.tag.begin",
                "punctuation.definition.tag.end"
            ],
            "settings": { "foreground": "#6f7f8a" }
        },
        {
            "name": "CSS Property",
            "scope": ["support.type.property-name.css"],
            "settings": { "foreground": "#9ec8bf" }
        },
        {
            "name": "Markdown Heading",
            "scope": ["markup.heading", "entity.name.section"],
            "settings": { "foreground": "#bac9d4", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Bold",
            "scope": ["markup.bold"],
            "settings": { "foreground": "#e7edf2", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Italic",
            "scope": ["markup.italic"],
            "settings": { "foreground": "#c9d5df", "fontStyle": "italic" }
        },
        {
            "name": "Markdown Code",
            "scope": [
                "markup.inline.raw",
                "markup.fenced_code",
                "markup.raw.block"
            ],
            "settings": { "foreground": "#9ec8bf" }
        },
        {
            "name": "Markdown Link",
            "scope": ["markup.underline.link", "string.other.link"],
            "settings": { "foreground": "#ff8a98", "fontStyle": "underline" }
        },
        {
            "name": "Markdown Blockquote",
            "scope": ["markup.quote"],
            "settings": { "foreground": "#8799a8", "fontStyle": "italic" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#c44f5f", "fontStyle": "underline" }
        }
    ],
    "semanticTokenColors": {
        "variable": "#e7edf2",
        "variable.readonly": "#c26b73",
        "parameter": "#c9d5df",
        "property": "#ff8a98",
        "property.readonly": "#c26b73",
        "function": "#ff8a98",
        "method": "#ff8a98",
        "class": "#8fa9bf",
        "interface": "#8fa9bf",
        "enum": "#8fa9bf",
        "enumMember": "#c26b73",
        "type": "#8fa9bf",
        "typeParameter": "#8fa9bf",
        "namespace": "#8fa9bf",
        "keyword": "#c44f5f",
        "modifier": "#c44f5f",
        "operator": "#6c92b3",
        "decorator": "#c26b73",
        "string": "#9ec8bf",
        "number": "#c9a96a",
        "regexp": "#88bdb5"
    },
    "$schema": "vscode://schemas/color-theme"
}
