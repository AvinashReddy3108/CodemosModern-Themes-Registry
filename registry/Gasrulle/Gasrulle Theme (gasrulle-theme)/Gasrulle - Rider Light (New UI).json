                "support.constant.color.w3c-standard-color-name.css"
            ],
            "settings": { "foreground": "#0033B3" }
        },
        {
            "scope": ["entity.name.tag.css"],
            "settings": { "foreground": "#080808" }
        },
        {
            "scope": ["keyword.other.unit.css"],
            "settings": { "foreground": "#1750EB" }
        },
        {
            "scope": ["variable.css", "variable.argument.css"],
            "settings": { "foreground": "#871094" }
        },
        {
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#871094" }
        },
        {
            "scope": ["string.value.json", "string.quoted.double.json"],
            "settings": { "foreground": "#067D17" }
        },
        {
            "scope": ["markup.heading", "markup.heading entity.name"],
            "settings": { "foreground": "#0033B3", "fontStyle": "bold" }
        },
        { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
        { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
        {
            "scope": ["markup.underline"],
            "settings": { "fontStyle": "underline" }
        },
        {
            "scope": ["markup.inline.raw", "markup.fenced_code", "markup.raw"],
            "settings": { "foreground": "#067D17" }
        },
        { "scope": ["markup.quote"], "settings": { "foreground": "#8C8C8C" } },
        {
            "scope": ["markup.underline.link"],
            "settings": { "foreground": "#3574F0" }
        },
        {
            "scope": ["markup.inserted"],
            "settings": { "foreground": "#067D17" }
        },
        {
            "scope": ["markup.deleted"],
            "settings": { "foreground": "#DB3B4B" }
        },
        {
            "scope": ["markup.changed"],
            "settings": { "foreground": "#3574F0" }
        },
        {
            "scope": [
                "string.regexp",
