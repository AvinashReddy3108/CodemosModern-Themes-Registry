    "tokenColors": [
        {
            "scope": ["source", "text"],
            "settings": { "foreground": "#C2C2CA" }
        },
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#566698", "fontStyle": "italic" }
        },
        {
            "scope": ["comment.block.documentation", "comment.block.javadoc"],
            "settings": { "foreground": "#4E5688", "fontStyle": "italic" }
        },
        {
            "scope": [
                "comment.block.documentation keyword",
                "comment.block.documentation storage.type",
                "entity.name.type.instance.jsdoc",
                "keyword.other.documentation",
                "storage.type.class.jsdoc"
            ],
            "settings": { "foreground": "#8C7C94" }
        },
        {
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.delete",
                "keyword.operator.expression",
                "keyword.operator.instanceof",
                "keyword.operator.new",
                "keyword.operator.typeof",
                "keyword.operator.void",
                "storage",
                "storage.modifier",
                "storage.type"
            ],
            "settings": { "foreground": "#ee8ac3" }
        },
        {
            "scope": [
                "keyword.control.conditional",
                "keyword.control.flow",
                "keyword.control.loop",
                "keyword.control.trycatch"
            ],
            "settings": { "foreground": "#f1a0ce", "fontStyle": "italic" }
        },
        {
            "scope": [
                "keyword.operator",
                "keyword.operator.arithmetic",
                "keyword.operator.assignment",
                "keyword.operator.bitwise",
                "keyword.operator.comparison",
                "keyword.operator.decrement",
                "keyword.operator.increment",
                "keyword.operator.relational",
                "keyword.operator.ternary",
                "punctuation.accessor",
                "punctuation.separator",
                "punctuation.terminator"
            ],
            "settings": { "foreground": "#9090c0" }
        },
        {
            "scope": [
                "keyword.operator.logical",
                "keyword.operator.logical.python"
            ],
            "settings": { "foreground": "#98e1f0" }
        },
        {
            "scope": [
                "string",
                "string.interpolated",
                "string.quoted",
                "string.template"
            ],
            "settings": { "foreground": "#e9f096" }
        },
        {
            "scope": [
                "constant.character.escape",
                "string.template punctuation.definition.template-expression"
            ],
            "settings": { "foreground": "#edb77e" }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.numeric.binary",
                "constant.numeric.float",
                "constant.numeric.hex",
                "constant.numeric.integer",
                "constant.numeric.octal"
            ],
            "settings": { "foreground": "#be9bf1" }
        },
        {
            "scope": [
                "constant.language",
                "constant.language.boolean",
                "constant.language.null",
                "constant.language.undefined",
                "support.constant",
                "variable.language.self",
                "variable.language.super",
                "variable.language.this"
            ],
            "settings": { "foreground": "#be9bf1", "fontStyle": "italic" }
        },
        {
            "scope": [
                "entity.name.function",
                "meta.function-call entity.name.function",
                "meta.method-call entity.name.function",
                "support.function"
            ],
            "settings": { "foreground": "#61e984" }
        },
        {
            "scope": [
                "entity.name.function.member",
                "meta.function-call support.function"
            ],
            "settings": { "foreground": "#61e984" }
        },
        {
            "scope": [
                "entity.name.type",
                "entity.name.type.class",
                "entity.name.type.enum",
                "entity.name.type.interface",
                "entity.name.type.struct",
                "entity.other.inherited-class",
                "support.class",
                "support.type"
            ],
            "settings": { "foreground": "#98e1f0" }
        },
        {
            "scope": [
                "entity.name.type.parameter",
                "entity.name.type.type-parameter"
            ],
            "settings": { "foreground": "#a4ffff" }
        },
        {
            "scope": [
                "meta.parameter",
                "variable",
                "variable.other",
                "variable.parameter"
            ],
            "settings": { "foreground": "#C2C2CA" }
        },
        {
            "scope": [
                "entity.name.tag.yaml",
                "meta.object-literal.key",
                "support.type.property-name",
                "variable.other.object.property",
                "variable.other.property"
            ],
            "settings": { "foreground": "#edb77e" }
        },
        {
            "scope": ["variable.other.constant", "variable.other.enummember"],
            "settings": { "foreground": "#be9bf1", "fontStyle": "italic" }
        },
        {
            "scope": [
                "meta.attribute",
                "meta.decorator",
                "meta.decorator entity.name.function",
                "meta.decorator punctuation.decorator",
                "punctuation.definition.annotation",
                "storage.type.annotation"
            ],
            "settings": { "foreground": "#efd090" }
        },
        {
            "scope": [
                "entity.name.module",
                "entity.name.namespace",
                "entity.name.type.module",
                "entity.name.type.namespace"
            ],
            "settings": { "foreground": "#7a7fb5" }
        },
        {
            "scope": [
                "meta.brace",
                "punctuation.bracket",
                "punctuation.definition.arguments",
                "punctuation.definition.block",
                "punctuation.definition.parameters",
                "punctuation.section"
            ],
            "settings": { "foreground": "#9090c0" }
        },
        {
            "scope": ["entity.name.tag", "punctuation.definition.tag"],
            "settings": { "foreground": "#ff6e6e" }
        },
        {
            "scope": [
                "entity.name.tag.custom",
                "entity.name.tag.other.custom",
                "support.class.component"
            ],
            "settings": { "foreground": "#98e1f0" }
        },
        {
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#efd090" }
        },
        {
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.class.mixin.css",
                "entity.other.attribute-name.id.css"
            ],
            "settings": { "foreground": "#61e984" }
        },
        {
            "scope": [
                "support.type.property-name.css",
                "support.type.vendored.property-name.css"
            ],
            "settings": { "foreground": "#edb77e" }
        },
        {
            "scope": [
                "constant.other.color.rgb-value.hex.css",
