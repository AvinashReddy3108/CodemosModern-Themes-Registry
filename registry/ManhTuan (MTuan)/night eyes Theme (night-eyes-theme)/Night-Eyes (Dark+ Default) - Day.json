{
    "$schema": "vscode://schemas/color-theme",
    "name": "night-eyes-default-day",
    "colors": {
        "editor.background": "#1E1E1E",
        "editor.foreground": "#D4D4D4",
        "editor.inactiveSelectionBackground": "#3A3D41",
        "editorIndentGuide.background": "#404040",
        "editorIndentGuide.activeBackground": "#707070",
        "editor.selectionHighlightBackground": "#ADD6FF26",
        "list.dropBackground": "#383B3D",
        "activityBarBadge.background": "#007ACC",
        "sideBarTitle.foreground": "#BBBBBB",
        "input.placeholderForeground": "#A6A6A6",
        "menu.background": "#252526",
        "menu.foreground": "#CCCCCC",
        "statusBarItem.remoteForeground": "#FFF",
        "statusBarItem.remoteBackground": "#16825D",
        "ports.iconRunningProcessForeground": "#369432",
        "sideBarSectionHeader.background": "#383a3d",
        "sideBarSectionHeader.border": "#ccc3",
        "tab.lastPinnedBorder": "#ccc3",
        "titleBar.inactiveBackground": "#303640",
        "titleBar.border": "#93a7cb33",
        "statusBar.background": "#404040",
        "statusBar.foreground": "#ecebeb",
        "editor.selectionBackground": "#3362b3c2",
        "editor.lineHighlightBackground": "#2e2e2e",
        "editorCursor.foreground": "#ff8d03",
        "editor.findMatchBackground": "#1B5227",
        "activityBar.background": "#323336",
        "activityBar.inactiveForeground": "#cfcfcf9c",
        "tab.activeBorder": "#ff8d03",
        "tab.activeBackground": "#313e52",
        "tab.inactiveBackground": "#272829",
        "tab.unfocusedActiveBackground": "#2b323b",
        "tab.unfocusedActiveBorder": "#97a7c8",
        "tab.border": "#3a3d3f",
        "tab.hoverBackground": "#293238",
        "list.focusBackground": "#243a53",
        "list.activeSelectionBackground": "#195094",
        "list.hoverBackground": "#2c455f",
        "panel.border": "#ff8d03",
        "input.border": "#3c8ec5",
        "editor.findMatchHighlightBackground": "#501f36",
        "editorGutter.foldingControlForeground": "#db8d33",
        "editorLineNumber.activeForeground": "#FE8100",
        "editorGroup.border": "#27537c8f",
        "editorWidget.resizeBorder": "#21d42ace",
        "editorBracketMatch.background": "#036128",
        "editorBracketMatch.border": "#00ff0000"
    },
    "tokenColors": [
        { "scope": "emphasis", "settings": { "fontStyle": "italic" } },
        { "scope": "strong", "settings": { "fontStyle": "bold" } },
        {
            "scope": "markup.underline",
            "settings": { "fontStyle": "underline" }
        },
        { "scope": "markup.italic", "settings": { "fontStyle": "italic" } },
        { "scope": "header", "settings": { "foreground": "#000080" } },
        { "scope": "constant.regexp", "settings": { "foreground": "#646695" } },
        { "scope": "invalid", "settings": { "foreground": "#f44747" } },
        {
            "scope": "punctuation.definition.list.begin.markdown",
            "settings": { "foreground": "#6796e6" }
        },
        {
            "name": "brackets of XML/HTML tags",
            "scope": "punctuation.definition.tag",
            "settings": { "foreground": "#808080" }
        },
        { "scope": "comment", "settings": { "foreground": "#6A9955" } },
        {
            "scope": "punctuation.definition.quote.begin.markdown",
            "settings": { "foreground": "#6A9955" }
        },
        {
            "scope": "entity.name.label",
            "settings": { "foreground": "#C0A649" }
        },
        {
            "scope": [
                "entity.other.attribute-name.class.mixin.css",
                "entity.other.attribute-name.id.css",
                "entity.other.attribute-name.parent-selector.css",
                "source.css.less entity.other.attribute-name.id",
                "entity.other.attribute-name.scss"
            ],
            "settings": { "foreground": "#d79e7d" }
        },
        {
            "scope": "entity.other.attribute-name.class.css",
            "settings": { "foreground": "#DDB974" }
        },
        {
            "scope": "entity.other.attribute-name.pseudo-class.css, entity.other.attribute-name.pseudo-element.css",
            "settings": { "foreground": "#B67FFF" }
        },
        {
            "name": "Control flow / Special keywords",
            "scope": [
                "keyword.control",
                "source.cpp keyword.operator.new",
                "keyword.operator.delete",
                "keyword.other.using",
                "keyword.other.operator",
                "entity.name.operator"
            ],
            "settings": { "foreground": "#d67797" }
        },
        {
            "scope": "text.html.derivative",
            "settings": { "foreground": "#b4c7d8" }
        },
        {
            "scope": "keyword.operator",
            "settings": { "foreground": "#d4d4d4" }
        },
        { "scope": "keyword.operator.assignment", "settings": {} },
        {
            "scope": "source.js, source.cs",
            "settings": { "foreground": "#d4d4d4" }
        },
        {
            "scope": ["meta.embedded", "source.groovy.embedded"],
            "settings": { "foreground": "#b3b3b3" }
        },
        {
            "name": "Reset JavaScript string interpolation expression",
            "scope": ["meta.template.expression"],
            "settings": { "foreground": "#b3b3b3" }
        },
        {
            "name": "coloring of the Java import and package identifiers",
            "scope": [
                "storage.modifier.import.java",
                "variable.language.wildcard.java",
                "storage.modifier.package.java"
            ],
            "settings": { "foreground": "#b3b3b3" }
        },
        {
            "name": "Variable and parameter name",
            "scope": [
                "variable",
                "meta.definition.variable.name",
                "support.variable",
                "entity.name.variable"
            ],
            "settings": { "foreground": "#81C6E5" }
        },
        {
            "name": "Library constant",
            "scope": "support.constant",
            "settings": { "fontStyle": "", "foreground": "#81C6E5" }
        },
        {
            "name": "Constants and enums",
            "scope": ["variable.other.constant", "variable.other.enummember"],
            "settings": { "foreground": "#4CAEF3" }
        },
        {
            "name": "Object keys, TS grammar specific",
            "scope": ["meta.object-literal.key"],
            "settings": { "foreground": "#65aac7" }
        },
        {
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#81C6E5" }
        },
        {
            "scope": "meta.structure.dictionary.key.python",
            "settings": { "foreground": "#65aac7" }
        },
        {
            "scope": [
                "support.type.vendored.property-name",
                "support.type.property-name",
                "source.coffee.embedded"
            ],
            "settings": { "foreground": "#81C6E5" }
        },
        {
            "scope": [
                "variable.css",
                "variable.scss",
                "variable.argument.css",
                "variable.other.less"
            ],
            "settings": { "foreground": "#29B6E5" }
        },
        {
            "scope": "support.function.git-rebase",
            "settings": { "foreground": "#65aac7" }
        },
        {
            "scope": "constant.language",
            "settings": { "foreground": "#3688cc" }
        },
        {
            "scope": "constant.character",
            "settings": { "foreground": "#3688cc" }
        },
        { "scope": "entity.name.tag", "settings": { "foreground": "#569cd6" } },
        {
            "scope": "markup.bold",
            "settings": { "fontStyle": "bold", "foreground": "#3688cc" }
        },
        {
            "scope": "markup.heading",
            "settings": { "fontStyle": "bold", "foreground": "#3688cc" }
        },
        {
            "name": "String interpolation",
            "scope": [
                "punctuation.definition.template-expression.begin",
                "punctuation.definition.template-expression.end",
                "punctuation.section.embedded"
            ],
            "settings": { "foreground": "#3688cc" }
        },
        { "scope": "keyword", "settings": { "foreground": "#3688cc" } },
        {
            "scope": [
                "keyword.operator.new",
                "keyword.operator.expression",
                "keyword.operator.cast",
                "keyword.operator.sizeof",
                "keyword.operator.alignof",
                "keyword.operator.typeid",
                "keyword.operator.alignas",
                "keyword.operator.instanceof",
                "keyword.operator.logical.python",
                "keyword.operator.wordlike"
            ],
            "settings": { "foreground": "#3688cc" }
        },
        {
            "scope": [
                "punctuation.section.embedded.begin.php",
                "punctuation.section.embedded.end.php"
            ],
            "settings": { "foreground": "#3688cc" }
        },
        {
            "name": "this.self",
            "scope": "variable.language",
            "settings": { "foreground": "#3688cc" }
        },
        { "scope": "markup.changed", "settings": { "foreground": "#3688cc" } },
        {
            "scope": ["meta.preprocessor", "entity.name.function.preprocessor"],
            "settings": { "foreground": "#3688cc" }
        },
        {
            "scope": "meta.diff.header",
            "settings": { "foreground": "#3688cc" }
        },
        { "scope": "storage", "settings": { "foreground": "#3688cc" } },
        { "scope": "storage.type", "settings": { "foreground": "#B67FFF" } },
        {
            "scope": ["storage.modifier", "keyword.operator.noexcept"],
            "settings": { "foreground": "#3688cc" }
        },
        {
            "scope": [
                "constant.numeric",
                "keyword.operator.plus.exponent",
                "keyword.operator.minus.exponent"
            ],
            "settings": { "foreground": "#84BB7C" }
        },
        { "scope": "markup.inserted", "settings": { "foreground": "#b5cea8" } },
        {
            "scope": "meta.preprocessor.numeric",
            "settings": { "foreground": "#b5cea8" }
        },
        {
            "scope": "keyword.other.unit",
            "settings": { "foreground": "#C389CB" }
        },
        {
            "scope": "constant.sha.git-rebase",
            "settings": { "foreground": "#b5cea8" }
        },
        { "scope": "markup.deleted", "settings": { "foreground": "#ce9178" } },
        {
            "scope": "markup.inline.raw",
            "settings": { "foreground": "#ce9178" }
        },
        {
            "scope": "meta.preprocessor.string",
            "settings": { "foreground": "#ce9178" }
        },
        {
            "scope": ["string", "meta.embedded.assembly"],
            "settings": { "foreground": "#ce9178" }
        },
        { "scope": "string.tag", "settings": { "foreground": "#ce9178" } },
        { "scope": "string.value", "settings": { "foreground": "#ce9178" } },
        {
            "name": "CSS property value",
            "scope": [
                "support.constant.property-value",
                "support.constant.font-name",
                "support.constant.media-type",
                "support.constant.media",
                "support.constant.color"
            ],
            "settings": { "foreground": "#D97A70" }
        },
        {
            "scope": "constant.other.color.rgb-value, constant.other.rgb-value",
            "settings": { "foreground": "#5ea79e" }
        },
        {
            "name": "Regular expression groups",
            "scope": [
                "punctuation.definition.group.regexp",
                "punctuation.definition.group.assertion.regexp",
                "punctuation.definition.character-class.regexp",
                "punctuation.character.set.begin.regexp",
                "punctuation.character.set.end.regexp",
                "keyword.operator.negation.regexp",
                "support.other.parenthesis.regexp"
            ],
            "settings": { "foreground": "#CE9178" }
        },
        {
            "name": "Function declarations",
            "scope": [
                "entity.name.function",
                "support.function",
                "support.constant.handlebars",
                "source.powershell variable.other.member",
                "entity.name.operator.custom-literal"
            ],
            "settings": { "foreground": "#D6C589" }
        },
        {
            "scope": [
                "keyword.operator.or.regexp",
                "keyword.control.anchor.regexp"
            ],
            "settings": { "foreground": "#c0a649" }
        },
        {
            "name": "Types declaration and references",
            "scope": [
                "meta.return-type",
                "support.class",
                "support.type",
                "entity.name.type",
                "entity.name.namespace",
                "entity.other.attribute",
                "entity.name.scope-resolution",
                "entity.name.class",
                "storage.type.numeric.go",
                "storage.type.byte.go",
                "storage.type.boolean.go",
                "storage.type.string.go",
                "storage.type.uintptr.go",
                "storage.type.error.go",
                "storage.type.rune.go",
                "storage.type.cs",
                "storage.type.generic.cs",
                "storage.type.modifier.cs",
                "storage.type.variable.cs",
                "storage.type.annotation.java",
                "storage.type.generic.java",
                "storage.type.java",
                "storage.type.object.array.java",
                "storage.type.primitive.array.java",
                "storage.type.primitive.java",
                "storage.type.token.java",
                "storage.type.groovy",
                "storage.type.annotation.groovy",
                "storage.type.parameters.groovy",
                "storage.type.generic.groovy",
                "storage.type.object.array.groovy",
                "storage.type.primitive.array.groovy",
                "storage.type.primitive.groovy"
            ],
            "settings": { "foreground": "#4EC9B0" }
        },
        {
            "name": "Types declaration and references, TS grammar specific",
            "scope": [
                "meta.type.cast.expr",
                "meta.type.new.expr",
                "support.constant.math",
                "support.constant.dom",
                "support.constant.json",
                "entity.other.inherited-class"
            ],
            "settings": { "foreground": "#4EC9B0" }
        },
        {
            "scope": [
                "constant.character.character-class.regexp",
                "constant.other.character-class.set.regexp",
                "constant.other.character-class.regexp",
                "constant.character.set.regexp"
            ],
            "settings": { "foreground": "#d16969" }
        },
        { "scope": "string.regexp", "settings": { "foreground": "#d16969" } },
        {
            "scope": "entity.name.tag.css",
            "settings": { "foreground": "#d7ba7d" }
        },
        {
            "scope": "keyword.operator.quantifier.regexp",
            "settings": { "foreground": "#d7ba7d" }
        },
        {
            "scope": "constant.character.escape",
            "settings": { "foreground": "#d7ba7d" }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "newOperator": "#C586C0",
        "stringLiteral": "#ce9178",
        "customLiteral": "#DCDCAA",
        "numberLiteral": "#b5cea8"
    }
}
