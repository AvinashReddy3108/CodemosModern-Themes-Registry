{
    "$schema": "vscode://schemas/color-theme",
    "name": "night-eyes-color-maze",
    "type": "dark",
    "colors": {
        "focusBorder": "#DA9FE5",
        "foreground": "#F0EBDF",
        "button.background": "#DA9FE5",
        "button.foreground": "#ffffff",
        "dropdown.background": "#303951",
        "input.background": "#303951",
        "inputOption.activeBorder": "#DA9FE5",
        "list.activeSelectionBackground": "#DA9FE580",
        "list.activeSelectionForeground": "#FFFFFF",
        "list.dropBackground": "#DA9FE580",
        "list.focusBackground": "#DA9FE580",
        "list.focusForeground": "#FFFFFF",
        "list.highlightForeground": "#DA9FE5",
        "list.hoverBackground": "#FFFFFF1a",
        "list.inactiveSelectionBackground": "#FFFFFF33",
        "activityBar.background": "#2a3247",
        "activityBarBadge.background": "#c06acf",
        "activityBarBadge.foreground": "#ffffff",
        "badge.background": "#DA9FE5",
        "badge.foreground": "#ffffff",
        "sideBar.background": "#242b3d",
        "sideBarSectionHeader.background": "#2a3247",
        "editorGroup.dropBackground": "#DA9FE580",
        "editorGroup.focusedEmptyBorder": "#DA9FE5",
        "editorGroupHeader.tabsBackground": "#242b3d",
        "tab.border": "#00000033",
        "tab.activeBorder": "#DA9FE5",
        "tab.inactiveBackground": "#2a3247",
        "tab.activeModifiedBorder": "#DA9FE5",
        "tab.inactiveModifiedBorder": "#83432e",
        "tab.unfocusedActiveModifiedBorder": "#af593e",
        "tab.unfocusedInactiveModifiedBorder": "#83432e",
        "editor.background": "#1E2433",
        "editor.foreground": "#F0EBDF",
        "editorLineNumber.foreground": "#FFFFFF4d",
        "editorLineNumber.activeForeground": "#DA9FE5",
        "editorCursor.foreground": "#ff8d03",
        "editor.lineHighlightBorder": "#FFFFFF1a",
        "editor.rangeHighlightBackground": "#FFFFFF0d",
        "editorWidget.background": "#242b3d",
        "editorHoverWidget.background": "#242b3d",
        "editorMarkerNavigation.background": "#242b3d",
        "peekView.border": "#DA9FE5",
        "peekViewEditor.background": "#181c28",
        "peekViewResult.background": "#242b3d",
        "peekViewTitle.background": "#1E2433",
        "panel.background": "#242b3d",
        "panel.border": "#FFFFFF1a",
        "panelTitle.activeBorder": "#F0EBDF80",
        "panelTitle.inactiveForeground": "#F0EBDF80",
        "statusBar.debuggingBackground": "#DA9FE5",
        "statusBar.debuggingForeground": "#ffffff",
        "statusBar.noFolderBackground": "#181c28",
        "statusBarItem.activeBackground": "#DA9FE580",
        "statusBarItem.hoverBackground": "#FFFFFF1a",
        "statusBarItem.remoteBackground": "#DA9FE5",
        "statusBarItem.remoteForeground": "#ffffff",
        "pickerGroup.border": "#FFFFFF1a",
        "terminal.ansiBlue": "#1E2433",
        "terminal.ansiBrightBlue": "#F0EBDF",
        "debugToolBar.background": "#2a3247",
        "selection.background": "#DA9FE5",
        "tab.activeBackground": "#3e4b5f",
        "tab.unfocusedActiveBorder": "#97a7c8",
        "tab.unfocusedActiveBackground": "#2a3247",
        "titleBar.activeBackground": "#283249",
        "titleBar.activeForeground": "#ebeaea",
        "titleBar.inactiveBackground": "#303640",
        "titleBar.border": "#93a7cb33",
        "tab.hoverBackground": "#4e5961d2",
        "statusBar.background": "#40485a",
        "input.border": "#DA9FE5",
        "editor.findMatchBackground": "#1B5227",
        "editor.findMatchHighlightBackground": "#501f36",
        "editorGutter.foldingControlForeground": "#DA9FE5",
        "editorBracketMatch.background": "#036128",
        "editorBracketMatch.border": "#00ff0000",
        "editorWidget.resizeBorder": "#21d42ace"
    },
    "tokenColors": [
        { "settings": { "foreground": "#D4D4D4" } },
        {
            "scope": ["meta.embedded", "source.groovy.embedded"],
            "settings": { "foreground": "#D4D4D4" }
        },
        {
            "name": "Comment",
            "scope": "comment",
            "settings": { "foreground": "#7D8CB2", "fontStyle": "italic" }
        },
        {
            "name": "Template Definition",
            "scope": [
                "punctuation.definition.template-expression",
                "punctuation.section.embedded"
            ],
            "settings": { "foreground": "#df5077" }
        },
        {
            "name": "Reset JavaScript string interpolation expression",
            "scope": ["meta.template.expression"],
            "settings": { "foreground": "#D4D4D4" }
        },
        {
            "name": "Number",
            "scope": "constant.numeric",
            "settings": { "foreground": "#7d72c8" }
        },
        {
            "name": "Built-in constant",
            "scope": "constant.language",
            "settings": { "foreground": "#7d72c8" }
        },
        {
            "name": "User-defined constant",
            "scope": "constant.character, constant.other",
            "settings": { "foreground": "#7d72c8" }
        },
        {
            "name": "Keyword",
            "scope": "keyword",
            "settings": { "foreground": "#df5077" }
        },
        {
            "name": "Storage",
            "scope": "storage",
            "settings": { "fontStyle": "", "foreground": "#df5077" }
        },
        {
            "name": "Storage type",
            "scope": "storage.type",
            "settings": { "fontStyle": "italic", "foreground": "#66D9EF" }
        },
        {
            "name": "Class name",
            "scope": "entity.name.type, entity.name.class, entity.name.namespace, entity.name.scope-resolution",
            "settings": { "fontStyle": "underline", "foreground": "#ADCF3F" }
        },
        {
            "name": "Inherited class",
            "scope": "entity.other.inherited-class",
            "settings": {
                "fontStyle": "italic underline",
                "foreground": "#ADCF3F"
            }
        },
        {
            "name": "Function name",
            "scope": "entity.name.function",
            "settings": { "fontStyle": "", "foreground": "#99C265" }
        },
        {
            "name": "Function argument",
            "scope": "variable.parameter",
            "settings": { "fontStyle": "italic", "foreground": "#F1A471" }
        },
        {
            "name": "Tag name",
            "scope": "entity.name.tag",
            "settings": { "fontStyle": "", "foreground": "#df5077" }
        },
        {
            "name": "Tag attribute",
            "scope": "entity.other.attribute-name",
            "settings": { "fontStyle": "", "foreground": "#ADCF3F" }
        },
        {
            "name": "Library class/type",
            "scope": "support.type, support.class",
            "settings": { "foreground": "#99CDEA" }
        },
        {
            "name": "Library variable",
            "scope": "support.other.variable",
            "settings": { "fontStyle": "" }
        },
        {
            "name": "Invalid",
            "scope": "invalid",
            "settings": { "fontStyle": "", "foreground": "#F44747" }
        },
        {
            "name": "Invalid deprecated",
            "scope": "invalid.deprecated",
            "settings": { "foreground": "#F44747" }
        },
        {
            "name": "JSON String",
            "scope": "meta.structure.dictionary.json string.quoted.double.json",
            "settings": { "foreground": "#87c578" }
        },
        {
            "name": "diff.header",
            "scope": "meta.diff, meta.diff.header",
            "settings": { "foreground": "#75715E" }
        },
        {
            "name": "diff.deleted",
            "scope": "markup.deleted",
            "settings": { "foreground": "#df5077" }
        },
        {
            "name": "diff.inserted",
            "scope": "markup.inserted",
            "settings": { "foreground": "#ADCF3F" }
        },
        {
            "name": "diff.changed",
            "scope": "markup.changed",
            "settings": { "foreground": "#e0d77b" }
        },
        {
            "scope": "constant.numeric.line-number.find-in-files - match",
            "settings": { "foreground": "#7d72c8A0" }
        },
        {
            "scope": "entity.name.filename.find-in-files",
            "settings": { "foreground": "#e0d77b" }
        },
        {
            "name": "Markup Quote",
            "scope": "markup.quote",
            "settings": { "foreground": "#df5077" }
        },
        {
            "name": "Markup Lists",
            "scope": "markup.list",
            "settings": { "foreground": "#e0d77b" }
        },
        {
            "name": "Markup Styling",
            "scope": "markup.bold, markup.italic",
            "settings": { "foreground": "#99CDEA" }
        },
        {
            "name": "Markup Inline",
            "scope": "markup.inline.raw",
            "settings": { "fontStyle": "", "foreground": "#ea9b40" }
        },
        {
            "name": "Markup Headings",
            "scope": "markup.heading",
            "settings": { "foreground": "#ADCF3F" }
        },
        {
            "name": "Markup Setext Header",
            "scope": "markup.heading.setext",
            "settings": { "foreground": "#ADCF3F", "fontStyle": "bold" }
        },
        {
            "name": "Markup Headings",
            "scope": "markup.heading.markdown",
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Markdown Quote",
            "scope": "markup.quote.markdown",
            "settings": { "fontStyle": "italic", "foreground": "#75715E" }
        },
        {
            "name": "Markdown Bold",
            "scope": "markup.bold.markdown",
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Markdown Link Title/Description",
            "scope": "string.other.link.title.markdown,string.other.link.description.markdown",
            "settings": { "foreground": "#AE81FF" }
        },
        {
            "name": "Markdown Underline Link/Image",
            "scope": "markup.underline.link.markdown,markup.underline.link.image.markdown",
            "settings": { "foreground": "#E6DB74" }
        },
        {
            "name": "Markdown Emphasis",
            "scope": "markup.italic.markdown",
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "Markdown Punctuation Definition Link",
            "scope": "markup.list.unnumbered.markdown, markup.list.numbered.markdown",
            "settings": { "foreground": "#D3D3D4" }
        },
        {
            "name": "Markdown List Punctuation",
            "scope": ["punctuation.definition.list.begin.markdown"],
            "settings": { "foreground": "#A6E22E" }
        },
        {
            "scope": "token.info-token",
            "settings": { "foreground": "#99CDEA" }
        },
        {
            "scope": "token.warn-token",
            "settings": { "foreground": "#ea9b40" }
        },
        {
            "scope": "token.error-token",
            "settings": { "foreground": "#d13b2e" }
        },
        {
            "scope": "token.debug-token",
            "settings": { "foreground": "#7d72c8" }
        },
        {
            "name": "this.self",
            "scope": "variable.language",
            "settings": { "foreground": "#DA9FE5" }
        },
        {
            "name": "Numeric suffix",
            "scope": "numeric-suffix",
            "settings": { "fontStyle": "italic", "foreground": "#99CDEA" }
        },
        {
            "name": "Punctuation tilde ~",
            "scope": "punctuation.tilde",
            "settings": { "fontStyle": "", "foreground": "#ADCF3F" }
        },
        {
            "name": "Punctuation brackets attribute",
            "scope": "punctuation.squarebracket-attribute",
            "settings": { "fontStyle": "", "foreground": "#df5077" }
        },
        {
            "name": "Keyword type",
            "scope": "keyword.type",
            "settings": { "fontStyle": "italic", "foreground": "#99CDEA" }
        },
        {
            "name": "Keyword other class",
            "scope": "keyword.other.class",
            "settings": { "fontStyle": "italic", "foreground": "#99CDEA" }
        },
        {
            "name": "Function call",
            "scope": "meta.function-call",
            "settings": { "fontStyle": "", "foreground": "#99CDEA" }
        },
        {
            "name": "Meta function call and type-parameter",
            "scope": "storage.type, entity.name.type.type-parameter",
            "settings": { "fontStyle": "italic", "foreground": "#99CDEA" }
        },
        {
            "name": "La f del 10.0f",
            "scope": "storage.type.numeric",
            "settings": { "fontStyle": "italic", "foreground": "#99CDEA" }
        },
        {
            "name": "Parameters and this",
            "scope": "entity.name.variable.parameter, keyword.other.this, keyword.other.base",
            "settings": { "fontStyle": "italic", "foreground": "#ea9b40" }
        },
        {
            "scope": ["meta.preprocessor", "entity.name.function.preprocessor"],
            "settings": { "foreground": "#3688cc" }
        },
        {
            "scope": "meta.preprocessor.numeric",
            "settings": { "foreground": "#b5cea8" }
        },
        {
            "scope": "meta.preprocessor.string",
            "settings": { "foreground": "#ce9178" }
        },
        {
            "scope": ["meta.preprocessor", "entity.name.function.preprocessor"],
            "settings": { "foreground": "#3688cc" }
        },
        {
            "name": "Variable and parameter name",
            "scope": [
                "meta.definition.variable.name",
                "support.variable",
                "entity.name.variable"
            ],
            "settings": { "foreground": "#99CDEA" }
        },
        {
            "name": "Library constant",
            "scope": "support.constant",
            "settings": { "fontStyle": "", "foreground": "#99CDEA" }
        },
        {
            "name": "Constants and enums",
            "scope": ["variable.other.constant", "variable.other.enummember"],
            "settings": { "foreground": "#77ABFF" }
        },
        {
            "scope": [
                "support.type.vendored.property-name",
                "support.type.property-name",
                "source.coffee.embedded"
            ],
            "settings": { "foreground": "#A1B6EA" }
        },
        {
            "name": "JSON key",
            "scope": "support.type.property-name.json",
            "settings": { "foreground": "#99CDEA" }
        },
        {
            "scope": [
                "variable.css",
                "variable.scss",
                "variable.argument.css",
                "variable.other.less"
            ],
            "settings": { "foreground": "#77ABFF" }
        },
        {
            "scope": "storage.type",
            "settings": { "foreground": "#DA9FE5", "fontStyle": "" }
        },
        {
            "name": "Storage",
            "scope": "storage.type, storage.modifier",
            "settings": { "foreground": "#DA9FE5", "fontStyle": "" }
        },
        {
            "name": "Object keys, TS grammar specific",
            "scope": ["variable.other.property"],
            "settings": { "foreground": "#99CDEA" }
        },
        {
            "name": "Library function",
            "scope": "support.function",
            "settings": { "fontStyle": "", "foreground": "#CDC10F" }
        },
        {
            "name": "Control flow / Special keywords",
            "scope": [
                "keyword.control",
                "source.cpp keyword.operator.new",
                "keyword.operator.delete",
                "keyword.other.using",
                "keyword.other.operator",
                "entity.name.operator"
            ],
            "settings": { "foreground": "#FF6CAB" }
        },
        {
            "name": "Types declaration and references",
            "scope": [
                "meta.return-type",
                "support.class",
                "entity.name.type",
                "entity.name.namespace",
                "entity.other.attribute",
                "entity.name.scope-resolution",
                "entity.name.class",
                "storage.type.numeric.go",
                "storage.type.byte.go",
                "storage.type.boolean.go",
                "storage.type.string.go",
                "storage.type.uintptr.go",
                "storage.type.error.go",
                "storage.type.rune.go",
                "storage.type.cs",
                "storage.type.generic.cs",
                "storage.type.modifier.cs",
                "storage.type.variable.cs",
                "storage.type.annotation.java",
                "storage.type.generic.java",
                "storage.type.java",
                "storage.type.object.array.java",
                "storage.type.primitive.array.java",
                "storage.type.primitive.java",
                "storage.type.token.java",
                "storage.type.groovy",
                "storage.type.annotation.groovy",
                "storage.type.parameters.groovy",
                "storage.type.generic.groovy",
                "storage.type.object.array.groovy",
                "storage.type.primitive.array.groovy",
                "storage.type.primitive.groovy"
            ],
            "settings": { "foreground": "#4EC9B0" }
        },
        {
            "name": "Types declaration and references, TS grammar specific",
            "scope": [
                "meta.type.cast.expr",
                "meta.type.new.expr",
                "support.constant.math",
                "support.constant.dom",
                "support.constant.json",
                "entity.other.inherited-class"
            ],
            "settings": { "foreground": "#4EC9B0" }
        },
        {
            "name": "Built-in constant",
            "scope": "constant.language",
            "settings": { "foreground": "#FF6774", "fontStyle": "italic" }
        },
        {
            "scope": "keyword.operator",
            "settings": { "foreground": "#CD90D5" }
        },
        {
            "scope": "keyword.operator.assignment",
            "settings": { "foreground": "#b3b3b3" }
        },
        {
            "scope": "source.js, source.cs",
            "settings": { "foreground": "#d4d4d4" }
        },
        {
            "scope": [
                "constant.numeric",
                "keyword.operator.plus.exponent",
                "keyword.operator.minus.exponent"
            ],
            "settings": { "foreground": "#94D18B" }
        },
        {
            "scope": "constant.other.color.rgb-value, constant.other.rgb-value",
            "settings": { "foreground": "#DDB974" }
        },
        {
            "scope": "keyword.other.unit",
            "settings": { "foreground": "#B67FFF" }
        },
        {
            "name": "String interpolation",
            "scope": [
                "punctuation.definition.template-expression.begin",
                "punctuation.definition.template-expression.end",
                "punctuation.section.embedded"
            ],
            "settings": { "foreground": "#DA9FE5" }
        },
        {
            "name": "CSS property value",
            "scope": [
                "support.constant.property-value",
                "support.constant.font-name",
                "support.constant.media-type",
                "support.constant.media",
                "support.constant.color"
            ],
            "settings": { "foreground": "#E4B768" }
        },
        {
            "scope": "entity.other.attribute-name",
            "settings": { "fontStyle": "italic", "foreground": "#D4CA49" }
        },
        {
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.class.mixin.css",
                "entity.other.attribute-name.id.css",
                "entity.other.attribute-name.parent-selector.css",
                "source.css.less entity.other.attribute-name.id",
                "entity.other.attribute-name.scss"
            ],
            "settings": { "foreground": "#DA9FE5" }
        },
        {
            "scope": "entity.other.attribute-name.pseudo-class.css, entity.other.attribute-name.pseudo-element.css",
            "settings": { "foreground": "#F6CE00" }
        },
        {
            "scope": "text.html.derivative",
            "settings": { "foreground": "#b4c7d8" }
        },
        { "scope": "entity.name.tag", "settings": { "foreground": "#8ACFED" } },
        {
            "name": "brackets of XML/HTML tags",
            "scope": "punctuation.definition.tag",
            "settings": { "foreground": "#808080" }
        },
        { "scope": "string", "settings": { "foreground": "#87c578" } },
        {
            "name": "HTML String",
            "scope": "string.quoted.single, string.quoted.double",
            "settings": { "foreground": "#87c578" }
        },
        {
            "name": "Javascript String",
            "scope": [
                "string.template.js",
                "string.quoted.single.js",
                "string.quoted.double.js"
            ],
            "settings": { "foreground": "#e0d77b" }
        },
        {
            "scope": "meta.paragraph.markdown, text.html.markdown",
            "settings": { "foreground": "#D3D3D4" }
        },
        {
            "name": "",
            "scope": [
                "variable.other.object",
                "variable.other.readwrite",
                "variable.other.object.property",
                "variable.other.readwrite.alias",
                "variable.other",
                "variable.other.global"
            ],
            "settings": { "fontStyle": "", "foreground": "#99CDEA" }
        },
        {
            "name": "Class name",
            "scope": "entity.name.type.namespace",
            "settings": { "foreground": "#4EC9B0" }
        }
    ],
    "semanticHighlighting": true
}
