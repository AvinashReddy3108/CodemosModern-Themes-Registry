    "tokenColors": [
        {
            "name": "Comments",
            "scope": [
                "comment",
                "comment.line",
                "comment.block",
                "punctuation.definition.comment"
            ],
            "settings": { "foreground": "#4A6A28", "fontStyle": "italic" }
        },
        {
            "name": "Documentation Comments",
            "scope": [
                "comment.block.documentation",
                "comment.block.javadoc",
                "string.quoted.docstring",
                "comment.block.documentation punctuation.definition.comment"
            ],
            "settings": { "foreground": "#4A6A28", "fontStyle": "italic" }
        },
        {
            "name": "Strings",
            "scope": [
                "string",
                "string.quoted",
                "string.quoted.single",
                "string.quoted.double",
                "string.quoted.triple",
                "string.template",
                "string.interpolated"
            ],
            "settings": { "foreground": "#B52080" }
        },
        {
            "name": "String Escape Characters",
            "scope": ["constant.character.escape"],
            "settings": { "foreground": "#D42995" }
        },
        {
            "name": "Regular Expressions",
            "scope": ["string.regexp", "constant.regexp", "string.regexp.js"],
            "settings": { "foreground": "#B52080" }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.new",
                "keyword.operator.expression",
                "keyword.other"
            ],
            "settings": { "foreground": "#7B3399" }
        },
        {
            "name": "Control Flow Keywords",
            "scope": [
                "keyword.control.flow",
                "keyword.control.return",
                "keyword.control.conditional",
                "keyword.control.loop",
                "keyword.control.trycatch",
                "keyword.control.exception"
            ],
            "settings": { "foreground": "#7B3399", "fontStyle": "bold" }
        },
        {
            "name": "Storage Types",
            "scope": ["storage", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#7B3399" }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "meta.function-call",
                "support.function",
                "support.function.any-method"
            ],
            "settings": { "foreground": "#2E5E8A" }
        },
        {
            "name": "Method Definitions",
            "scope": ["meta.definition.method", "entity.name.method"],
            "settings": { "foreground": "#2E5E8A" }
        },
        {
            "name": "Built-in Functions",
            "scope": ["support.function.builtin", "support.function.magic"],
            "settings": { "foreground": "#3972A8" }
        },
        {
            "name": "Types",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.type",
                "support.class"
            ],
            "settings": { "foreground": "#806000" }
        },
        {
            "name": "Type Parameters",
            "scope": ["entity.name.type.parameter", "meta.type.parameters"],
            "settings": { "foreground": "#806000", "fontStyle": "italic" }
        },
        {
            "name": "Interfaces",
            "scope": ["entity.name.type.interface", "entity.name.type.alias"],
            "settings": { "foreground": "#997300" }
        },
        {
            "name": "Constants",
            "scope": [
                "constant",
                "constant.language",
                "constant.numeric",
                "constant.character"
            ],
            "settings": { "foreground": "#1A6B69" }
        },
        {
            "name": "Boolean Constants",
            "scope": [
                "constant.language.boolean",
                "constant.language.true",
                "constant.language.false"
            ],
            "settings": { "foreground": "#1A6B69", "fontStyle": "bold" }
        },
        {
            "name": "Null/Nil/None",
            "scope": [
                "constant.language.null",
                "constant.language.nil",
                "constant.language.undefined"
            ],
            "settings": { "foreground": "#1A6B69", "fontStyle": "italic" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "variable.other", "variable.other.readwrite"],
            "settings": { "foreground": "#3B3228" }
        },
        {
            "name": "Variable Parameters",
            "scope": ["variable.parameter", "variable.other.parameter"],
            "settings": { "foreground": "#4A4238", "fontStyle": "italic" }
        },
        {
            "name": "Object Properties",
            "scope": [
                "variable.other.property",
                "variable.other.object.property",
                "meta.object-literal.key"
            ],
            "settings": { "foreground": "#3B3228" }
        },
        {
            "name": "This/Self",
            "scope": [
                "variable.language.this",
                "variable.language.self",
                "variable.language.special.self"
            ],
            "settings": { "foreground": "#7B3399", "fontStyle": "italic" }
        },
        {
            "name": "Operators",
            "scope": [
                "keyword.operator",
                "keyword.operator.arithmetic",
                "keyword.operator.assignment",
                "keyword.operator.comparison",
                "keyword.operator.logical"
            ],
            "settings": { "foreground": "#2E5E8A" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation",
                "punctuation.definition",
                "punctuation.separator",
                "punctuation.terminator"
            ],
            "settings": { "foreground": "#4A4238" }
        },
        {
            "name": "Brackets",
            "scope": [
                "punctuation.definition.block",
                "punctuation.definition.parameters",
                "punctuation.definition.arguments",
                "punctuation.section",
                "meta.brace"
            ],
            "settings": { "foreground": "#4A4238" }
        },
        {
            "name": "HTML Tags",
            "scope": [
                "entity.name.tag",
                "meta.tag",
                "punctuation.definition.tag"
            ],
            "settings": { "foreground": "#2E5E8A" }
        },
        {
            "name": "HTML Attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#1A6B69", "fontStyle": "italic" }
        },
        {
            "name": "JSX Components",
            "scope": [
                "support.class.component",
                "entity.name.tag.component",
                "support.class.component.jsx",
                "support.class.component.tsx"
            ],
            "settings": { "foreground": "#806000" }
        },
        {
            "name": "CSS Selectors",
            "scope": [
                "entity.name.tag.css",
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css"
            ],
            "settings": { "foreground": "#2E5E8A" }
        },
        {
            "name": "CSS Properties",
            "scope": [
                "support.type.property-name.css",
                "support.type.property-name.scss",
                "meta.property-name.css"
            ],
            "settings": { "foreground": "#1A6B69" }
        },
        {
            "name": "CSS Values",
            "scope": [
                "support.constant.property-value.css",
                "constant.numeric.css",
                "meta.property-value.css"
            ],
            "settings": { "foreground": "#B52080" }
        },
        {
            "name": "CSS Units",
            "scope": ["keyword.other.unit.css", "keyword.other.unit.scss"],
            "settings": { "foreground": "#806000" }
        },
        {
            "name": "SCSS Variables",
            "scope": ["variable.scss", "variable.css"],
            "settings": { "foreground": "#B52080" }
        },
        {
            "name": "JSON Keys",
            "scope": [
                "support.type.property-name.json",
                "string.json support.type.property-name"
            ],
            "settings": { "foreground": "#2E5E8A" }
        },
        {
            "name": "YAML Keys",
            "scope": ["entity.name.tag.yaml"],
            "settings": { "foreground": "#2E5E8A" }
        },
        {
            "name": "YAML Anchors",
            "scope": [
                "entity.name.type.anchor.yaml",
                "punctuation.definition.anchor.yaml"
            ],
            "settings": { "foreground": "#7B3399" }
        },
        {
            "name": "Markdown Headings",
            "scope": [
                "markup.heading",
                "entity.name.section.markdown",
                "markup.heading.setext"
            ],
            "settings": { "foreground": "#7B3399", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Bold",
            "scope": ["markup.bold"],
            "settings": { "foreground": "#806000", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Italic",
            "scope": ["markup.italic"],
            "settings": { "foreground": "#B52080", "fontStyle": "italic" }
        },
        {
            "name": "Markdown Links",
            "scope": ["markup.underline.link", "string.other.link"],
            "settings": { "foreground": "#2E5E8A" }
        },
        {
            "name": "Markdown Code",
            "scope": [
                "markup.inline.raw",
                "markup.fenced_code",
                "markup.raw.block",
                "markup.raw.inline"
            ],
            "settings": { "foreground": "#4A6A28" }
        },
        {
            "name": "Markdown Lists",
            "scope": [
                "punctuation.definition.list.begin.markdown",
                "markup.list"
            ],
            "settings": { "foreground": "#1A6B69" }
        },
        {
            "name": "Markdown Quotes",
            "scope": [
                "markup.quote",
                "punctuation.definition.quote.begin.markdown"
            ],
            "settings": { "foreground": "#4A6A28", "fontStyle": "italic" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#A62828", "fontStyle": "underline" }
        },
        {
            "name": "Deprecated",
            "scope": ["invalid.deprecated"],
            "settings": {
                "foreground": "#A65000",
                "fontStyle": "strikethrough"
            }
        },
        {
            "name": "Entity Names",
            "scope": ["entity.name"],
            "settings": { "foreground": "#806000" }
        },
        {
            "name": "Namespace",
            "scope": ["entity.name.namespace", "entity.name.module"],
            "settings": { "foreground": "#806000" }
        },
        {
            "name": "Decorator/Annotation",
            "scope": [
                "meta.decorator",
                "meta.annotation",
                "punctuation.decorator"
            ],
            "settings": { "foreground": "#9440B3" }
        },
        {
            "name": "Import/Export",
            "scope": [
                "keyword.control.import",
                "keyword.control.export",
                "keyword.control.from",
                "keyword.control.as"
            ],
            "settings": { "foreground": "#7B3399" }
        },
        {
            "name": "Language Primitives",
            "scope": ["support.type.primitive", "support.type.builtin"],
            "settings": { "foreground": "#1A6B69" }
        },
        {
            "name": "Rust Macros",
            "scope": ["entity.name.function.macro.rust", "meta.macro.rust"],
            "settings": { "foreground": "#7B3399" }
        },
        {
            "name": "Rust Lifetimes",
            "scope": [
                "punctuation.definition.lifetime.rust",
                "entity.name.lifetime.rust",
                "storage.modifier.lifetime.rust"
            ],
            "settings": { "foreground": "#B52080", "fontStyle": "italic" }
        },
        {
            "name": "Rust Attributes",
            "scope": ["meta.attribute.rust"],
            "settings": { "foreground": "#9440B3" }
        },
        {
            "name": "Python Decorators",
            "scope": [
                "entity.name.function.decorator.python",
                "meta.function.decorator.python"
            ],
            "settings": { "foreground": "#9440B3" }
        },
        {
            "name": "Python Magic Methods",
            "scope": ["support.function.magic.python"],
            "settings": { "foreground": "#3972A8" }
        },
        {
            "name": "Ruby Symbols",
            "scope": [
                "constant.language.symbol.ruby",
                "constant.other.symbol.ruby"
            ],
            "settings": { "foreground": "#1A6B69" }
        },
        {
            "name": "Ruby Instance Variables",
            "scope": ["variable.other.readwrite.instance.ruby"],
            "settings": { "foreground": "#B52080" }
        },
        {
            "name": "Ruby Class Variables",
            "scope": ["variable.other.readwrite.class.ruby"],
            "settings": { "foreground": "#806000" }
        },
        {
            "name": "Shell Variables",
            "scope": [
                "variable.other.normal.shell",
                "variable.other.positional.shell",
                "variable.other.special.shell"
            ],
            "settings": { "foreground": "#B52080" }
        },
        {
            "name": "SQL Keywords",
            "scope": ["keyword.other.DML.sql", "keyword.other.DDL.sql"],
            "settings": { "foreground": "#7B3399", "fontStyle": "bold" }
        },
        {
            "name": "Template Expressions",
            "scope": [
                "punctuation.definition.template-expression",
                "punctuation.section.embedded"
            ],
            "settings": { "foreground": "#7B3399" }
        },
        {
            "name": "Embedded Source",
            "scope": ["meta.embedded", "source.embedded"],
            "settings": { "foreground": "#3B3228" }
        }
    ],
    "semanticTokenColors": {
        "variable": "#3B3228",
        "variable.readonly": "#1A6B69",
        "variable.defaultLibrary": "#1A6B69",
        "parameter": { "foreground": "#4A4238", "fontStyle": "italic" },
        "function": "#2E5E8A",
        "function.declaration": "#2E5E8A",
        "function.defaultLibrary": "#3972A8",
        "method": "#2E5E8A",
        "method.declaration": "#2E5E8A",
        "type": "#806000",
        "type.declaration": "#806000",
        "type.defaultLibrary": "#997300",
        "class": "#806000",
        "class.declaration": "#806000",
        "interface": "#997300",
        "interface.declaration": "#997300",
        "enum": "#806000",
        "enumMember": "#1A6B69",
        "struct": "#806000",
        "typeParameter": { "foreground": "#806000", "fontStyle": "italic" },
        "property": "#3B3228",
        "property.readonly": "#1A6B69",
        "property.declaration": "#3B3228",
        "namespace": "#806000",
        "module": "#806000",
        "keyword": "#7B3399",
        "string": "#B52080",
        "regexp": "#B52080",
        "number": "#1A6B69",
        "comment": { "foreground": "#4A6A28", "fontStyle": "italic" },
        "operator": "#2E5E8A",
        "decorator": "#9440B3",
        "annotation": "#9440B3",
        "macro": "#7B3399",
        "label": "#B52080"
    },
    "$schema": "vscode://schemas/color-theme"
}
