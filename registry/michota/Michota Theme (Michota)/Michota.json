{
    "name": "Michota",
    "type": "dark",
    "colors": {
        "focusBorder": "#bebebe",
        "activityBar.background": "#202020",
        "activityBar.activeFocusBorder": "#ffdc52",
        "activityBar.dropBorder": "#ffdc52",
        "activityBar.foreground": "#bebebe",
        "activityBarBadge.background": "#ffdc52",
        "activityBarBadge.foreground": "#303030",
        "activityBar.activeBorder": "#bebebe",
        "activityBar.inactiveForeground": "#646464",
        "tab.activeForeground": "#bebebe",
        "button.foreground": "#161616",
        "button.hoverBackground": "#ffdc52",
        "button.background": "#e8c94d",
        "icon.foreground": "#ffdc52",
        "diffEditor.insertedTextBackground": "#87878733",
        "textLink.foreground": "#e8c94d",
        "textLink.activeForeground": "#ffdc52",
        "dropdown.background": "#2c2c2c",
        "dropdown.border": "#202020",
        "dropdown.foreground": "#bebebe",
        "editor.background": "#202020",
        "editor.findMatchBackground": "#ffffff4d",
        "editor.findMatchHighlightBackground": "#ffffff1a",
        "editor.lineHighlightBackground": "#292929",
        "editor.selectionBackground": "#373737",
        "selection.background": "#424242",
        "inputOption.activeForeground": "#ffdc52",
        "inputOption.activeBackground": "#ffffff00",
        "inputOption.activeBorder": "#ffffff00",
        "editorCursor.foreground": "#bebebe",
        "editorError.foreground": "#c24038",
        "editorGroup.emptyBackground": "#1d1d1d",
        "editorGroup.border": "#1a1a1a",
        "editorGroupHeader.tabsBackground": "#202020",
        "editorIndentGuide.background1": "#3b3b3b",
        "editorHoverWidget.background": "#2c2c2c",
        "editorHoverWidget.border": "#3b3b3b",
        "editorLineNumber.foreground": "#404040",
        "editorRuler.foreground": "#484848",
        "editorSuggestWidget.background": "#2c2c2c",
        "editorSuggestWidget.border": "#1f1f1f",
        "editorSuggestWidget.selectedBackground": "#3b3b3b",
        "editorSuggestWidget.selectedIconForeground": "#ffdc52",
        "editorUnnecessaryCode.opacity": "#000000c0",
        "editorWhitespace.foreground": "#3b3b3b",
        "editorWidget.background": "#1d1d1d",
        "tab.dragAndDropBorder": "#3b3b3b",
        "tab.activeBackground": "#2c2c2c",
        "tab.inactiveBackground": "#202020",
        "tab.border": "#222222",
        "tab.hoverForeground": "#bebebe",
        "input.background": "#2c2c2c",
        "list.activeSelectionBackground": "#2c2c2c",
        "list.activeSelectionForeground": "#e1e1e1",
        "list.inactiveFocusBackground": "#2c2c2c",
        "list.inactiveSelectionForeground": "#bebebe",
        "list.focusBackground": "#2c2c2c",
        "list.highlightForeground": "#C5C5C5",
        "list.focusOutline": "#bebebe",
        "list.hoverBackground": "#282828",
        "list.hoverForeground": "#e1e1e1",
        "list.dropBackground": "#bebebe1a",
        "notifications.background": "#2c2c2c",
        "notificationCenterHeader.background": "#2c2c2c",
        "notificationCenter.border": "#3b3b3b",
        "scrollbarSlider.activeBackground": "#8b8b8b80",
        "scrollbarSlider.background": "#62626280",
        "scrollbarSlider.hoverBackground": "#74747480",
        "sideBar.background": "#202020",
        "sideBarSectionHeader.background": "#202020",
        "sideBar.foreground": "#bebebe",
        "statusBar.background": "#202020",
        "statusBar.foreground": "#b9b8b9",
        "statusBarItem.prominentHoverBackground": "#333333",
        "statusBar.noFolderBackground": "#202020",
        "statusBar.debuggingBackground": "#202020",
        "statusBarItem.activeBackground": "#333333",
        "statusBarItem.hoverBackground": "#333333",
        "statusBarItem.remoteForeground": "#b9b8b9",
        "statusBarItem.remoteBackground": "#202020",
        "statusBarItem.remoteHoverBackground": "#333333",
        "widget.shadow": "#00000000",
        "inlineChat.shadow": "#00000000",
        "scrollbar.shadow": "#00000000",
        "listFilterWidget.shadow": "#00000000",
        "editorStickyScroll.shadow": "#00000000",
        "diffEditor.unchangedRegionShadow": "#00000000",
        "titleBar.activeBackground": "#202020",
        "titleBar.activeForeground": "#b6b6b6",
        "titleBar.inactiveBackground": "#202020",
        "titleBar.inactiveForeground": "#717171",
        "titleBar.border": "#2c2c2c",
        "inlineChat.background": "#2c2c2c",
        "inlineChat.border": "#2c2c2c",
        "panel.border": "#2c2c2c",
        "panelTitle.activeBorder": "#e1e1e1",
        "panelTitle.activeForeground": "#e1e1e1",
        "panelTitle.inactiveForeground": "#bebebe",
        "badge.background": "#ffdc52",
        "badge.foreground": "#161616",
        "editorLightBulb.foreground": "#ffdc52",
        "editorLightBulbAutoFix.foreground": "#d186d8",
        "editorLightBulbAi.foreground": "#ffdc52",
        "editorBracketHighlight.foreground1": "#e5c07b",
        "editorBracketHighlight.foreground2": "#d186d8",
        "editorBracketHighlight.foreground3": "#56c2b0",
        "editorBracketHighlight.foreground4": "#98c379",
        "terminal.foreground": "#abb2bf",
        "terminal.ansiBlack": "#2d3139",
        "terminal.ansiBlue": "#FF52A3",
        "terminal.ansiGreen": "#98c379",
        "terminal.ansiYellow": "#e5c07b",
        "terminal.ansiCyan": "#56c2b0",
        "terminal.ansiMagenta": "#d186d8",
        "terminal.ansiRed": "#e06c75",
        "terminal.ansiWhite": "#d7dae0",
        "terminal.ansiBrightBlack": "#7f848e",
        "terminal.ansiBrightBlue": "#FF52A3",
        "terminal.ansiBrightGreen": "#98c379",
        "terminal.ansiBrightYellow": "#e5c07b",
        "terminal.ansiBrightCyan": "#56c2b0",
        "terminal.ansiBrightMagenta": "#7e0097",
        "terminal.ansiBrightRed": "#f44747",
        "terminal.ansiBrightWhite": "#d7dae0"
    },
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "*.declaration": { "italic": true, "bold": true },
        "*.definition": { "italic": true, "bold": false },
        "type": "#3a86d8",
        "enum": "#3a86d8",
        "interface": "#3a86d8",
        "parameter.declaration": "#d19a66"
    },
    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "string.comment"],
            "settings": { "foreground": "#606060" }
        },
        {
            "name": "String",
            "scope": ["string", "string.template"],
            "settings": { "foreground": "#e5c07b" }
        },
        {
            "name": "Number",
            "scope": "constant.numeric",
            "settings": { "foreground": "#c678dd" }
        },
        {
            "name": "Embedded String Begin/End",
            "scope": [
                "string.embedded.begin",
                "string.embedded.end",
                "punctuation.definition.template-expression",
                "punctuation.section.embedded"
            ],
            "settings": { "foreground": "#c678dd" }
        },
        {
            "name": "Default Embedded Color",
            "scope": [
                "punctuation.section.embedded.begin.js",
                "punctuation.section.embedded.end.js",
                "punctuation.section.embedded.begin.erb",
                "punctuation.section.embedded.end.erb",
                "source.elixir.embedded",
                "punctuation.separator",
                "punctuation.accessor",
                "meta.brace"
            ],
            "settings": { "foreground": "#abb2bf" }
        },
        {
            "name": "Built-in constant",
            "scope": "constant.language",
            "settings": { "foreground": "#56c2b0" }
        },
        {
            "name": "User-defined constant",
            "scope": ["constant.character", "constant.other"],
            "settings": { "foreground": "#56c2b0" }
        },
        {
            "name": "Type and interface definitions",
            "scope": [
                "entity.name.type.ts",
                "meta.type.declaration.ts",
                "entity.name.type.interface.ts",
                "entity.name.type.alias.ts"
            ],
            "settings": { "foreground": "#3178c6" }
        },
        {
            "name": "Language Variable",
            "scope": "variable.language",
            "settings": { "foreground": "#e06c75" }
        },
        {
            "name": "Keyword",
            "scope": [
                "keyword",
                "keyword.operator.logical",
                "keyword.operator.constructor"
            ],
            "settings": { "foreground": "#e06c75" }
        },
        {
            "name": "Keyword Operator",
            "scope": "keyword.operator",
            "settings": { "foreground": "#e06c75" }
        },
        {
            "name": "Storage",
            "scope": "storage",
            "settings": { "foreground": "#e06c75" }
        },
        {
            "name": "Types",
            "scope": "storage.type",
            "settings": { "foreground": "#56c2b0" }
        },
        {
            "name": "Class",
            "scope": [
                "entity.name.class",
                "entity.name.module",
                "entity.name.type",
                "storage.identifier",
                "support.class"
            ],
            "settings": { "foreground": "#74c0ff" }
        },
        {
            "name": "Variable Object",
            "scope": [
                "variable.other.object",
                "variable.other.constant",
                "variable.other.global",
                "variable.other.readwrite.instance",
                "variable.other.readwrite.batchfile",
                "variable.readwrite",
                "variable.readwrite.other.block"
            ],
            "settings": { "foreground": "#74c0ff" }
        },
        {
            "name": "React Component",
            "scope": ["support.class.component.tsx"],
            "settings": { "foreground": "#58c4dc" }
        },
        {
            "name": "Other variable",
            "scope": [
                "variable.other",
                "variable.other.readwrite",
                "variable.other.property",
                "variable.other.block"
            ],
            "settings": { "foreground": "#abb2bf" }
        },
        {
            "name": "Inherited Class",
            "scope": "entity.other.inherited-class",
            "settings": { "foreground": "#98c379" }
        },
        {
            "name": "Package Import",
            "scope": ["storage.modifier.import", "storage.modifier.package"],
            "settings": { "foreground": "#74c0ff" }
        },
        {
            "name": "Function name",
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#98c379" }
        },
        {
            "name": "Function parameter",
            "scope": ["entity.name.variable.parameter", "parameter.variable"],
            "settings": { "fontStyle": "italic", "foreground": "#d19a66" }
        },
        {
            "name": "Function call",
            "scope": "entity.name.function-call",
            "settings": { "foreground": "#abb2bf" }
        },
        {
            "name": "Builtin Functions",
            "scope": ["function.support.builtin", "function.support.core"],
            "settings": { "foreground": "#98c379" }
        },
        {
            "name": "Tag Name",
            "scope": ["entity.name.tag", "entity.name.tag.class.js"],
            "settings": { "foreground": "#e06c75" }
        },
        {
            "name": "Tag Class and ID",
            "scope": ["entity.name.tag.class", "entity.name.tag.id"],
            "settings": { "foreground": "#56c2b0" }
        },
        {
            "name": "Tag Attribute",
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#98c379" }
        },
        {
            "name": "Library constant",
            "scope": "support.constant",
            "settings": { "foreground": "#56c2b0" }
        },
        {
            "name": "Library class/type",
            "scope": ["support.type", "support.variable"],
            "settings": { "foreground": "#56c2b0" }
        },
        {
            "name": "Json Property",
            "scope": "support.dictionary.json",
            "settings": { "foreground": "#56c2b0" }
        },
        {
            "name": "StyleSheet Property name",
            "scope": [
                "support.type.property-name.css",
                "support.type.property-name.scss",
                "support.type.property-name.less",
                "support.type.property-name.sass"
            ],
            "settings": { "foreground": "#abb2bf" }
        },
        {
            "name": "CSS: Pseudo Attribute Names",
            "scope": [
                "entity.other.attribute-name.pseudo-class.css",
                "entity.other.attribute-name.pseudo-class.scss",
                "entity.other.attribute-name.pseudo-class.less",
                "entity.other.attribute-name.pseudo-class.sass",
                "entity.other.attribute-name.pseudo-element.css",
                "entity.other.attribute-name.pseudo-element.scss",
                "entity.other.attribute-name.pseudo-element.less",
                "entity.other.attribute-name.pseudo-element.sass"
            ],
            "settings": { "foreground": "#56c2b0" }
        },
        {
            "name": "StyleSheet Property value",
            "scope": [
                "support.constant.css",
                "support.constant.scss",
                "support.constant.less",
                "support.constant.sass"
            ],
            "settings": { "foreground": "#98c379" }
        },
        {
            "name": "StyleSheet Variable",
            "scope": [
                "variable.css",
                "variable.scss",
                "variable.less",
                "variable.sass"
            ],
            "settings": { "foreground": "#56c2b0" }
        },
        {
            "name": "StyleSheet Variable String",
            "scope": [
                "variable.css.string",
                "variable.scss.string",
                "variable.less.string",
                "variable.sass.string"
            ],
            "settings": { "foreground": "#e5c07b" }
        },
        {
            "name": "StyleSheet Unit",
            "scope": ["unit.css", "unit.scss", "unit.less", "unit.sass"],
            "settings": { "foreground": "#c678dd" }
        },
        {
            "name": "StyleSheet Function",
            "scope": [
                "function.css",
                "function.scss",
                "function.less",
                "function.sass"
            ],
            "settings": { "foreground": "#56c2b0" }
        },
        {
            "name": "Library variable",
            "scope": "support.other.variable",
            "settings": { "fontStyle": "" }
        },
        {
            "name": "Invalid",
            "scope": "invalid",
            "settings": { "background": "#c678dd", "foreground": "#F8F8F0" }
        },
        {
            "name": "Invalid deprecated",
            "scope": "invalid.deprecated",
            "settings": { "background": "#56c2b0", "foreground": "#F8F8F0" }
        },
        {
            "name": "JSON String",
            "scope": "support.type.property-name.json",
            "settings": { "foreground": "#56c2b0" }
        },
        {
            "name": "Link",
            "scope": "string.detected-link",
            "settings": { "foreground": "#74c0ff" }
        },
        {
            "name": "diff.header",
            "scope": ["meta.diff", "meta.diff.header"],
            "settings": { "foreground": "#75715E" }
        },
        {
            "name": "diff.deleted",
            "scope": "markup.deleted",
            "settings": { "foreground": "#e06c75" }
        },
        {
            "name": "diff.inserted",
            "scope": "markup.inserted",
            "settings": { "foreground": "#98c379" }
        },
        {
            "name": "diff.changed",
            "scope": "markup.changed",
            "settings": { "foreground": "#e5c07b" }
        },
        {
            "scope": "constant.numeric.line-number.find-in-files - match",
            "settings": { "foreground": "#56c2b0A0" }
        },
        {
            "scope": "entity.name.filename.find-in-files",
            "settings": { "foreground": "#e5c07b" }
        },
        {
            "name": "Markup: Emphasis",
            "scope": "markup.italic, markup.italic.markdown",
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "Markup: Punctuation",
            "scope": [
                "punctuation.definition.italic.markdown",
                "punctuation.definition.bold.markdown",
                "punctuation.definition.heading.markdown"
            ],
            "settings": { "foreground": "#676f7d" }
        },
        {
            "name": "Markup: Emphasis Punctuation",
            "scope": "punctuation.definition.italic.markdown",
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "Markdown: Link",
            "scope": "markup.underline.link.markdown",
            "settings": { "foreground": "#74c0ff" }
        },
        {
            "name": "Markup: Bold",
            "scope": "markup.bold.markdown",
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Markup: Heading",
            "scope": "markup.heading.markdown",
            "settings": { "fontStyle": "bold", "foreground": "#e06c75" }
        },
        {
            "name": "Markup: Quote",
            "scope": "markup.quote.markdown",
            "settings": { "foreground": "#98c379" }
        },
        {
            "name": "Markup: Separator",
            "scope": "meta.separator.markdown",
            "settings": { "foreground": "#c678dd", "fontStyle": "bold" }
        },
        {
            "name": "Markup: Raw",
            "scope": [
                "markup.raw.inline.markdown",
                "markup.raw.block.markdown"
            ],
            "settings": { "foreground": "#56c2b0" }
        },
        {
            "name": "Markup: List Punctuation",
            "scope": "punctuation.definition.list_item.markdown",
            "settings": { "fontStyle": "bold", "foreground": "#ffffff" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
