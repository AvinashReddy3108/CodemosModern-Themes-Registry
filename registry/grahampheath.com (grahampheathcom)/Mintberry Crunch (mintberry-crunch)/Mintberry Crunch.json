{
    "$schema": "vscode://schemas/color-theme",
    "name": "Mintberry Crunch",
    "type": "dark",
    "colors": {
        "editor.background": "#211e1efc",
        "editor.foreground": "#E6D7E6",
        "editorCursor.foreground": "#FFFFFF",
        "editor.selectionBackground": "#6F2c32",
        "editor.lineHighlightBackground": "#353030",
        "editorWhitespace.foreground": "#3F2D2D",
        "editorGutter.background": "#333333",
        "editorGutter.modifiedBackground": "#d35791",
        "editorGutter.addedBackground": "#d35791",
        "editorGutter.deletedBackground": "#d35791",
        "editorGutter.foldingControlForeground": "#d35791",
        "editorLineNumber.foreground": "#d35791",
        "editorLineNumber.activeForeground": "#ffffff",
        "editor.selectionHighlightBackground": "#87355B40",
        "editorIndentGuide.activeBackground1": "#008040",
        "editorIndentGuide.background1": "#008040",
        "editorGroup.border": "#d35791",
        "editorGroupHeader.tabsBackground": "#333333",
        "editorGroupHeader.tabsBorder": "#d35791",
        "tab.activeBackground": "#211e1efc",
        "tab.activeForeground": "#ffffff",
        "tab.inactiveBackground": "#2a2a2a",
        "tab.inactiveForeground": "#d35791",
        "tab.border": "#d35791",
        "tab.activeBorder": "#d35791",
        "activityBar.background": "#333333",
        "activityBar.foreground": "#008040",
        "activityBar.inactiveForeground": "#6e7d69",
        "activityBarBadge.background": "#d35791",
        "activityBarBadge.foreground": "#ffffff",
        "activityBar.border": "#d35791",
        "sideBar.background": "#333333",
        "sideBar.foreground": "#E6D7E6",
        "sideBar.border": "#d35791",
        "sideBarTitle.foreground": "#008040",
        "sideBarSectionHeader.background": "#2a2a2a",
        "sideBarSectionHeader.foreground": "#008040",
        "sideBarSectionHeader.border": "#d35791",
        "panel.background": "#333333",
        "panel.border": "#f0f",
        "panelTitle.activeForeground": "#ffffff",
        "panelTitle.inactiveForeground": "#6e7d69",
        "statusBar.background": "#333333",
        "statusBar.foreground": "#008040",
        "statusBar.border": "#d35791",
        "statusBar.noFolderBackground": "#333333",
        "statusBar.debuggingBackground": "#87355B",
        "statusBarItem.prominentBackground": "#87355B",
        "statusBarItem.prominentHoverBackground": "#6F2c32",
        "titleBar.activeBackground": "#333333",
        "titleBar.activeForeground": "#ffffff",
        "titleBar.inactiveBackground": "#2a2a2a",
        "titleBar.inactiveForeground": "#6e7d69",
        "titleBar.border": "#d35791",
        "menu.background": "#333333",
        "menu.foreground": "#E6D7E6",
        "menu.selectionBackground": "#87355B",
        "menu.selectionForeground": "#ffffff",
        "menu.separatorBackground": "#008040",
        "menubar.selectionBackground": "#87355B",
        "menubar.selectionForeground": "#ffffff",
        "dropdown.background": "#333333",
        "dropdown.foreground": "#E6D7E6",
        "dropdown.border": "#d35791",
        "list.activeSelectionBackground": "#87355B",
        "list.activeSelectionForeground": "#ffffff",
        "list.inactiveSelectionBackground": "#6F2c32",
        "list.hoverBackground": "#353030",
        "list.focusBackground": "#87355B",
        "input.background": "#211e1e",
        "input.foreground": "#E6D7E6",
        "input.border": "#d35791",
        "inputOption.activeBorder": "#d35791",
        "button.background": "#87355B",
        "button.foreground": "#ffffff",
        "button.hoverBackground": "#6F2c32",
        "scrollbar.shadow": "#00000000",
        "scrollbarSlider.background": "#00804040",
        "scrollbarSlider.hoverBackground": "#00804060",
        "scrollbarSlider.activeBackground": "#00804080",
        "badge.background": "#d35791",
        "badge.foreground": "#ffffff",
        "progressBar.background": "#008040",
        "widget.shadow": "#00000040"
    },
    "tokenColors": [
        {
            "scope": "comment",
            "settings": { "foreground": "#6e7d69", "background": "#211e1e" }
        },
        {
            "scope": "string",
            "settings": { "foreground": "#AD9361", "background": "#211e1e" }
        },
        {
            "scope": "constant.numeric",
            "settings": { "foreground": "#CCCCCC", "background": "#211e1e" }
        },
        {
            "scope": ["keyword", "keyword.control.js"],
            "settings": { "foreground": "#6CE26A", "background": "#211e1e" }
        },
        {
            "scope": "meta.preprocessor",
            "settings": { "foreground": "#dcdf73", "background": "#211e1e" }
        },
        {
            "scope": "keyword.control.import",
            "settings": {
                "fontStyle": "bold",
                "foreground": "#E6D7E6",
                "background": "#211e1e"
            }
        },
        {
            "scope": "support.function",
            "settings": { "foreground": "#6CE26A", "background": "#211e1e" }
        },
        {
            "scope": "declaration.function function-result",
            "settings": { "foreground": "#0000FF", "background": "#211e1e" }
        },
        {
            "scope": "declaration.function function-name",
            "settings": {
                "fontStyle": "bold",
                "foreground": "#E6D7E6",
                "background": "#211e1e"
            }
        },
        {
            "scope": "declaration.function argument-name",
            "settings": {
                "fontStyle": "bold",
                "foreground": "#E6D7E6",
                "background": "#211e1e"
            }
        },
        {
            "scope": "declaration.function function-arg-type",
            "settings": { "foreground": "#0000FF", "background": "#211e1e" }
        },
        {
            "scope": "declaration.function function-argument",
            "settings": {
                "fontStyle": "italic",
                "foreground": "#E6D7E6",
                "background": "#211e1e"
            }
        },
        {
            "scope": "declaration.class class-name",
            "settings": {
                "fontStyle": "underline",
                "foreground": "#E6D7E6",
                "background": "#211e1e"
            }
        },
        {
            "scope": "declaration.class class-inheritance",
            "settings": {
                "fontStyle": "italic underline",
                "foreground": "#E6D7E6",
                "background": "#211e1e"
            }
        },
        {
            "scope": [
                "comment.merge-marker.yours",
                "comment.merge-marker.end",
                "comment.merge-marker.theirs"
            ],
            "settings": { "foreground": "#00ffaa", "background": "#44112C" }
        },
        {
            "scope": "invalid.warning",
            "settings": { "foreground": "#ffffff", "background": "#ad9361" }
        },
        {
            "scope": "invalid",
            "settings": {
                "fontStyle": "bold",
                "foreground": "#FFF9F9",
                "background": "#d1524d"
            }
        },
        {
            "scope": "invalid.deprecated.trailing-whitespace",
            "settings": { "foreground": "#E6D7E6", "background": "#FFD0D0" }
        },
        {
            "scope": "declaration.section section-name",
            "settings": {
                "fontStyle": "italic",
                "foreground": "#E6D7E6",
                "background": "#211e1e"
            }
        },
        {
            "scope": "string.interpolation",
            "settings": { "foreground": "#C10006", "background": "#211e1e" }
        },
        {
            "scope": "string.regexp",
            "settings": { "foreground": "#666666", "background": "#211e1e" }
        },
        {
            "scope": "variable",
            "settings": { "foreground": "#C1C144", "background": "#211e1e" }
        },
        {
            "scope": ["constant", "support.constant"],
            "settings": { "foreground": "#6782D3", "background": "#211e1e" }
        },
        {
            "scope": "constant.character",
            "settings": { "foreground": "#AFA472", "background": "#211e1e" }
        },
        {
            "scope": "constant.language",
            "settings": {
                "fontStyle": "bold",
                "foreground": "#6CE26A",
                "background": "#211e1e"
            }
        },
        {
            "scope": "embedded",
            "settings": {
                "fontStyle": "underline",
                "foreground": "#E6D7E6",
                "background": "#211e1e"
            }
        },
        {
            "scope": "keyword.markup.element-name",
            "settings": { "foreground": "#858EF4", "background": "#211e1e" }
        },
        {
            "scope": [
                "keyword.markup.attribute-name",
                "entity.name.type.attribute-name"
            ],
            "settings": { "foreground": "#D25B95", "background": "#211e1e" }
        },
        {
            "scope": "meta.attribute-with-value",
            "settings": { "foreground": "#9B456F", "background": "#211e1e" }
        },
        {
            "scope": "keyword.exception",
            "settings": {
                "fontStyle": "bold",
                "foreground": "#C82255",
                "background": "#211e1e"
            }
        },
        {
            "scope": "keyword.operator",
            "settings": { "foreground": "#3ED6A8", "background": "#211e1e" }
        },
        {
            "scope": "keyword.control",
            "settings": {
                "fontStyle": "bold",
                "foreground": "#6969FA",
                "background": "#211e1e"
            }
        },
        {
            "scope": [
                "support.constant.tm-language-def",
                "support.constant.name.tm-language-def"
            ],
            "settings": { "foreground": "#7171F3", "background": "#211e1e" }
        },
        {
            "scope": "meta.tag.preprocessor.xml",
            "settings": { "foreground": "#68685B", "background": "#211e1e" }
        },
        {
            "scope": "meta.tag.sgml.doctype",
            "settings": { "foreground": "#888888", "background": "#211e1e" }
        },
        {
            "scope": "string.quoted.docinfo.doctype.DTD",
            "settings": {
                "fontStyle": "italic",
                "foreground": "#E6D7E6",
                "background": "#211e1e"
            }
        },
        {
            "scope": [
                "comment.other.server-side-include.xhtml",
                "comment.other.server-side-include.html"
            ],
            "settings": { "foreground": "#909090", "background": "#211e1e" }
        },
        {
            "scope": [
                "text.html declaration.tag",
                "text.html meta.tag",
                "source.scss entity.name.tag",
                "text.html entity.name.tag.xhtml"
            ],
            "settings": { "foreground": "#48d62c", "background": "#211e1e" }
        },
        {
            "scope": "keyword.other.phpdoc.php",
            "settings": { "foreground": "#777777", "background": "#211e1e" }
        },
        {
            "scope": "keyword.other.include.php",
            "settings": { "foreground": "#C82255", "background": "#211e1e" }
        },
        {
            "scope": "support.constant.core.php",
            "settings": {
                "fontStyle": "bold",
                "foreground": "#DE8E20",
                "background": "#211e1e"
            }
        },
        {
            "scope": "support.constant.std.php",
            "settings": {
                "fontStyle": "bold",
                "foreground": "#DE8E10",
                "background": "#211e1e"
            }
        },
        {
            "scope": "variable.other.global.php",
            "settings": { "foreground": "#B72E1D", "background": "#211e1e" }
        },
        {
            "scope": "variable.other.global.safer.php",
            "settings": { "foreground": "#00FF00", "background": "#211e1e" }
        },
        {
            "scope": "string.quoted.single.php",
            "settings": { "foreground": "#CEA4B5", "background": "#211e1e" }
        },
        {
            "scope": "keyword.storage.php",
            "settings": { "foreground": "#6969FA", "background": "#211e1e" }
        },
        {
            "scope": "string.quoted.double.php",
            "settings": { "foreground": "#CEA4B5", "background": "#211e1e" }
        },
        {
            "scope": "entity.other.attribute-name.id.css",
            "settings": { "foreground": "#EC9E00", "background": "#211e1e" }
        },
        {
            "scope": "entity.name.tag.css",
            "settings": {
                "fontStyle": "bold",
                "foreground": "#91d506",
                "background": "#211e1e"
            }
        },
        {
            "scope": "entity.other.attribute-name.class.css",
            "settings": { "foreground": "#EDCA06", "background": "#211e1e" }
        },
        {
            "scope": "entity.other.attribute-name.pseudo-class.css",
            "settings": { "foreground": "#9b456f", "background": "#211e1e" }
        },
        {
            "scope": "invalid.bad-comma.css",
            "settings": { "foreground": "#FFFFFF", "background": "#FF0000" }
        },
        {
            "scope": "support.constant.property-value.css",
            "settings": { "foreground": "#d2679a", "background": "#211e1e" }
        },
        {
            "scope": ["support.type.property-name.css", "storage.modifier"],
            "settings": { "foreground": "#E1C96B", "background": "#211e1e" }
        },
        {
            "scope": "support.constant.font-name.css",
            "settings": { "foreground": "#cea4b5", "background": "#211e1e" }
        },
        {
            "scope": "keyword.other.unit.css",
            "settings": { "foreground": "#6969FA", "background": "#211e1e" }
        },
        {
            "scope": "string.quoted.single.js",
            "settings": { "foreground": "#C1538A", "background": "#211e1e" }
        },
        {
            "scope": "string.quoted.double.js",
            "settings": { "foreground": "#C1538A", "background": "#211e1e" }
        },
        {
            "scope": "keyword.operator.new.js",
            "settings": { "foreground": "#6EBD87", "background": "#211e1e" }
        },
        {
            "scope": "storage.type",
            "settings": { "foreground": "#6EBD87", "background": "#211e1e" }
        },
        {
            "scope": "comment.line.number-sign.r",
            "settings": { "fontStyle": "italic", "foreground": "#279797" }
        },
        {
            "scope": "comment.line.number-sign-tick.r",
            "settings": { "fontStyle": "italic", "foreground": "#C5060B" }
        },
        {
            "scope": "comment.line.number-sign-plus.r",
            "settings": { "fontStyle": "italic", "foreground": "#ff00ff" }
        },
        {
            "scope": "markup.raw.block.markdown",
            "settings": { "foreground": "#CEA4B5", "background": "#211e1e" }
        }
    ]
}
