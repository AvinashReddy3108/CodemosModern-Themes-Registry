    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#dd9944", "fontStyle": "italic" }
        },
        {
            "name": "Keywords",
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#ffaabb", "fontStyle": "bold" }
        },
        {
            "name": "Control Flow",
            "scope": ["keyword.control"],
            "settings": { "foreground": "#ffccdd", "fontStyle": "bold" }
        },
        {
            "name": "Strings",
            "scope": ["string", "string.quoted"],
            "settings": { "foreground": "#fff0aa" }
        },
        {
            "name": "String Escapes",
            "scope": ["constant.character.escape", "string.regexp"],
            "settings": { "foreground": "#fff8cc" }
        },
        {
            "name": "Numbers & Constants",
            "scope": [
                "constant.numeric",
                "constant.language",
                "constant.other"
            ],
            "settings": { "foreground": "#ddccff" }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "meta.function-call entity.name.function"
            ],
            "settings": { "foreground": "#ffe8cc" }
        },
        {
            "name": "Function Parameters",
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#ffcc99", "fontStyle": "italic" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "variable.other"],
            "settings": { "foreground": "#ffdd55" }
        },
        {
            "name": "Types & Classes",
            "scope": ["entity.name.type", "entity.name.class", "support.class"],
            "settings": { "foreground": "#ffccdd", "fontStyle": "bold" }
        },
        {
            "name": "Interfaces",
            "scope": ["entity.name.interface", "entity.other.inherited-class"],
            "settings": { "foreground": "#ffbbcc", "fontStyle": "italic" }
        },
        {
            "name": "Properties",
            "scope": ["variable.other.property", "support.type.property-name"],
            "settings": { "foreground": "#ffcc88" }
        },
        {
            "name": "Operators",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#ffaabb" }
        },
        {
            "name": "Punctuation",
            "scope": ["punctuation"],
            "settings": { "foreground": "#ddaa44" }
        },
        {
            "name": "Tags (HTML/JSX)",
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#ddccff" }
        },
        {
            "name": "Tag Attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#fff0aa" }
        },
        {
            "name": "Decorators / Annotations",
            "scope": ["meta.decorator", "punctuation.decorator"],
            "settings": { "foreground": "#ffccdd", "fontStyle": "italic" }
        },
        {
            "name": "CSS Selectors",
            "scope": [
                "entity.name.tag.css",
                "entity.other.attribute-name.class.css"
            ],
            "settings": { "foreground": "#ddccff" }
        },
        {
            "name": "CSS Property Values",
            "scope": ["support.constant.property-value.css"],
            "settings": { "foreground": "#fff0aa" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid"],
            "settings": {
                "foreground": "#ff6688",
                "fontStyle": "underline bold"
            }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
