        "list.warningForeground": "#0000FF",
        "listFilterWidget.background": "#00001030",
        "listFilterWidget.noMatchesOutline": "#00001030",
        "listFilterWidget.outline": "#00001030",
        "menu.background": "#000010f8",
        "menu.border": "#0083FF50",
        "menu.foreground": "#0080DC",
        "menu.selectionBackground": "#142850",
        "menu.selectionBorder": "#00001030",
        "menu.selectionForeground": "#0080DC",
        "menu.separatorBackground": "#0080DC",
        "menubar.selectionBackground": "#142850",
        "menubar.selectionBorder": "#0083FF50",
