        "gitDecoration.ignoredResourceForeground": "#0083FF",
        "gitDecoration.modifiedResourceForeground": "#6EBDFF",
        "gitDecoration.untrackedResourceForeground": "#50B4FF",
        "input.background": "#142850",
        "input.border": "#50B4FF10",
        "input.foreground": "#0080DC",
        "input.placeholderForeground": "#0080DC60",
