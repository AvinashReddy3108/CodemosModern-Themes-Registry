        "minimapSlider.activeBackground": "#00ACFFb0",
        "minimapSlider.background": "#00ACFF80",
        "minimapSlider.hoverBackground": "#00ACFFa0",
        "notificationLink.foreground": "#0083FF",
        "notifications.background": "#000010",
        "notifications.foreground": "#0080DC",
        "panel.background": "#000010",
        "panel.border": "#00001060",
        "panelTitle.activeBorder": "#0083FF",
        "panelTitle.activeForeground": "#50B4FF",
        "panelTitle.inactiveForeground": "#0080DC",
        "peekView.border": "#00001030",
        "peekViewEditor.background": "#0080DC05",
        "peekViewEditor.matchHighlightBackground": "#0083FF50",
        "peekViewEditorGutter.background": "#0080DC05",
        "peekViewResult.background": "#0080DC05",
        "peekViewResult.matchHighlightBackground": "#0083FF50",
        "peekViewResult.selectionBackground": "#0083FF70",
        "peekViewTitle.background": "#0080DC05",
        "peekViewTitleDescription.foreground": "#0080DC60",
        "pickerGroup.foreground": "#0083FF",
        "progressBar.background": "#0083FF",
        "scrollbar.shadow": "#00001000",
        "scrollbarSlider.activeBackground": "#0083FFcc",
        "scrollbarSlider.background": "#0083FFbb",
        "scrollbarSlider.hoverBackground": "#0083FFee",
        "selection.background": "#0083FF",
        "settings.checkboxBackground": "#000010",
        "settings.checkboxForeground": "#0080DC",
        "settings.dropdownBackground": "#000010",
        "settings.dropdownForeground": "#0080DC",
        "settings.headerForeground": "#0083FF",
        "settings.modifiedItemIndicator": "#0083FF",
        "settings.numberInputBackground": "#000010",
        "settings.numberInputForeground": "#0080DC",
        "settings.textInputBackground": "#000010",
        "settings.textInputForeground": "#0080DC",
        "sideBar.background": "#000010",
        "sideBar.border": "#0083FF50",
        "sideBar.foreground": "#50B4FF",
        "sideBarSectionHeader.background": "#000010",
        "sideBarSectionHeader.border": "#00001060",
        "sideBarSectionHeader.foreground": "#50B4FF",
        "sideBarTitle.foreground": "#0080DC",
        "statusBar.background": "#0064DC",
        "statusBar.border": "#00001060",
        "statusBar.debuggingBackground": "#0000FF",
        "statusBar.debuggingForeground": "#50B4FF",
        "statusBar.foreground": "#F0FFFF",
        "statusBar.noFolderBackground": "#000010",
        "statusBarItem.hoverBackground": "#0083FF20",
        "statusBarItem.remoteBackground": "#0083FF",
        "statusBarItem.remoteForeground": "#000010",
        "tab.activeBackground": "#0083FF50",
        "tab.activeBorder": "#0083FF",
        "tab.activeForeground": "#50B4FF",
        "tab.activeModifiedBorder": "#0083FF",
        "tab.border": "#000010",
        "tab.inactiveBackground": "#0083FF20",
        "tab.inactiveForeground": "#0080DCaf",
        "tab.unfocusedActiveBorder": "#0083FF",
        "tab.unfocusedActiveBackground": "#0083FF40",
        "tab.unfocusedActiveForeground": "#0080DC",
        "tab.unfocusedInactiveBackground": "#0083FF10",
        "tab.unfocusedInactiveForeground": "#0080DC7f",
        "terminal.ansiBlack": "#000010",
        "terminal.ansiBlue": "#50B4FF",
        "terminal.ansiBrightBlack": "#0083FF",
        "terminal.ansiBrightBlue": "#50B4FF",
        "terminal.ansiBrightCyan": "#F0FFFF",
        "terminal.ansiBrightGreen": "#00ACFF",
        "terminal.ansiBrightMagenta": "#0000FF",
        "terminal.ansiBrightRed": "#F0FFFF",
        "terminal.ansiBrightWhite": "#50B4FF",
        "terminal.ansiBrightYellow": "#0000FF",
        "terminal.ansiCyan": "#F0FFFF",
        "terminal.ansiGreen": "#00ACFF",
        "terminal.ansiMagenta": "#0000FF",
        "terminal.ansiRed": "#F0FFFF",
        "terminal.ansiWhite": "#50B4FF",
        "terminal.ansiYellow": "#0000FF",
        "terminalCursor.background": "#000010",
        "terminalCursor.foreground": "#0000FF",
        "textLink.activeForeground": "#0080DC",
        "textLink.foreground": "#0083FF",
        "titleBar.activeBackground": "#000010",
        "titleBar.activeForeground": "#0080DC",
        "titleBar.border": "#00001060",
        "titleBar.inactiveBackground": "#000010",
        "titleBar.inactiveForeground": "#0083FF",
        "tree.indentGuidesStroke": "#92B7FF",
        "widget.shadow": "#00001030"
    },
    "tokenColors": [
        {
            "scope": [
                "variable",
                "string constant.other.placeholder",
                "invalid.deprecated",
                "keyword",
                "storage.type",
                "storage.modifier"
            ],
            "settings": { "foreground": "#0000FF" }
        },
        {
            "scope": [
                "variable",
                "string constant.other.placeholder",
                "entity.name.function",
                "punctuation.definition.interpolation.end.bracket.curly.scss",
                "punctuation.definition.interpolation.begin.bracket.curly.scss"
            ],
            "settings": { "fontStyle": "italic" }
        },
        {
            "scope": [
                "punctuation.definition.interpolation.end.bracket.curly.scss",
                "punctuation.definition.interpolation.begin.bracket.curly.scss"
            ],
            "settings": { "foreground": "#00ACFF" }
        },
        {
            "scope": ["constant.other.php"],
            "settings": { "foreground": "#0000FF" }
        },
        {
            "scope": ["constant.other.color"],
            "settings": { "foreground": "#50B4FF" }
        },
        {
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#F0FFFF" }
        },
        {
            "scope": ["Keyword", "Storage"],
            "settings": { "fontStyle": "italic" }
        },
        {
            "scope": [
                "keyword.control",
                "constant.other.color",
                "punctuation.definition.tag",
                "punctuation",
                "punctuation.separator.inheritance.php",
                "punctuation.definition.tag.html",
                "punctuation.section.embedded",
                "keyword.other.template",
                "keyword.other.substitution",
                "entity.name.tag.reference.scss"
            ],
            "settings": { "foreground": "#A7A8AF" }
        },
        {
            "scope": [
                "punctuation.definition.tag.begin.html",
                "punctuation.definition.tag.end.html",
                "entity.name.type.module.js"
            ],
            "settings": { "foreground": "#6EBDFF" }
        },
        {
            "scope": [
                "keyword.control.at-rule",
                "punctuation.terminator.rule.css",
                "keyword.control.operator",
                "punctuation.definition.entity.css",
                "keyword.operator.assignment.js",
                "punctuation.separator.comma.js",
                "punctuation.definition.string.begin.js",
                "punctuation.definition.string.end.js",
                "punctuation.definition.binding-pattern.object.js"
            ],
            "settings": { "foreground": "#0080DC" }
        },
        {
            "scope": ["punctuation.definition", "string.quoted.single.scss"],
            "settings": { "foreground": "#A7A8AF" }
        },
        { "scope": ["keyword.control"], "settings": { "fontStyle": "bold" } },
        {
            "scope": [
                "comment.line.scss",
                "comment.line.double-slash.js",
                "punctuation.definition.comment.scss",
                "punctuation.definition.comment.js",
                "punctuation.definition.comment.html",
                "comment.block.html"
            ],
            "settings": { "foreground": "#bedfff" }
        },
        {
            "scope": ["text.html.derivative"],
            "settings": { "foreground": "#ececec" }
        },
        {
            "scope": [
                "entity.name.tag",
                "meta.tag.sgml",
                "markup.deleted.git_gutter"
            ],
            "settings": { "foreground": "#0095ff" }
        },
        {
            "scope": ["entity.name.tag.html"],
            "settings": { "fontStyle": "bold" }
        },
        {
            "scope": [
                "variable.parameter.js",
                "variable.parameter.keyframe-list.css"
            ],
            "settings": { "foreground": "#0000FF" }
        },
        {
            "scope": [
                "variable.other.object.js",
                "storage.type.js",
                "string.other.link.title.markdown",
                "variable.other.readwrite.js",
                "variable.other.property.js"
            ],
            "settings": { "foreground": "#6EBDFF", "fontStyle": "" }
        },
        {
            "scope": [
                "string",
                "string.quoted.double.html",
                "variable.other.constant.js",
                "variable.other.object.property.js",
                "string.quoted.double.json",
                "markup.fenced_code.block.markdown",
                "markup.inline.raw.string.markdown",
                "variable.function",
                "keyword.other.special-method",
                "entity.name.function",
                "markup.bold",
                "markup.bold.markdown",
                "markup.italic.markdown",
                "meta.class-method.js entity.name.function.js",
                "variable.function.constructor",
                "entity.name.tag.other.html",
                "entity.name.tag.block.any.html",
                "source.sass keyword.control"
            ],
            "settings": { "foreground": "#A03CDC" }
        },
        {
            "scope": [
                "punctuation.definition.string.begin.html",
                "punctuation.definition.string.end.html"
            ],
            "settings": { "foreground": "#F0FFFF" }
        },
        {
            "scope": [
                "support.other.variable",
                "string.other.link",
                "markup.table"
            ],
            "settings": { "foreground": "#0080DC" }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.language",
                "constant.character",
                "constant.escape",
                "keyword.other.unit",
                "keyword.other",
                "punctuation.separator.key-value.html"
            ],
            "settings": { "foreground": "#0000FF" }
        },
        {
            "scope": [
                "variable.parameter.function.language.special",
                "variable.parameter"
            ],
            "settings": { "foreground": "#F0FFFF" }
        },
        {
            "scope": [
                "constant.other.symbol",
                "constant.other.key",
                "entity.other.inherited-class",
                "keyword.other.unit",
                "markup.heading",
                "markup.inserted.git_gutter",
                "meta.group.braces.curly",
                "constant.other.object.key.js",
                "string.unquoted.label.js"
            ],
            "settings": { "foreground": "#00ACFF", "fontStyle": "" }
        },
        {
            "scope": [
                "entity.name",
                "support.type",
                "support.class",
                "support.orther.namespace.use.php",
                "meta.use.php",
                "support.other.namespace.php",
                "markup.changed.git_gutter",
                "support.type.sys-types",
                "entity.other.attribute-name.html"
            ],
            "settings": { "foreground": "#0000FF" }
        },
        { "scope": ["support.type"], "settings": { "foreground": "#B2CCD6" } },
        {
            "scope": [
                "source.css support.type.property-name",
                "source.sass support.type.property-name",
                "source.scss support.type.property-name",
                "source.less support.type.property-name",
                "source.stylus support.type.property-name",
                "source.postcss support.type.property-name"
            ],
            "settings": { "foreground": "#6EBDFF" }
        },
        {
            "scope": [
                "entity.name.module.js",
                "variable.import.parameter.js",
                "variable.other.class.js"
            ],
            "settings": { "foreground": "#F0FFFF" }
        },
        {
            "scope": [
                "entity.name.method.js",
                "tag.decorator.js entity.name.tag.js",
                "tag.decorator.js punctuation.definition.tag.js"
            ],
            "settings": { "foreground": "#50B4FF", "fontStyle": "italic" }
        },
        {
            "scope": ["entity.other.attribute-name", "support.function"],
            "settings": { "foreground": "#0000FF" }
        },
        {
            "scope": [
                "entity.other.attribute-name.id",
                "entity.other.attribute-name.class",
                "entity.other.attribute-name.pseudo-class",
                "entity.name.tag.css",
                "keyword.control.conditional.js",
                "support.constant",
                "entity.other.attribute-name.html",
                "string.quoted.single.js",
                "storage.type.function.js",
                "meta.object-literal.key"
            ],
            "settings": { "foreground": "#84ccff" }
        },
        {
            "scope": ["source.scss keyword.control"],
            "settings": { "foreground": "#0000FF" }
        },
        {
            "scope": ["markup.inserted"],
            "settings": { "foreground": "#00ACFF" }
        },
        {
            "scope": ["markup.deleted"],
            "settings": { "foreground": "#F0FFFF" }
        },
        {
            "scope": ["markup.changed"],
            "settings": { "foreground": "#0000FF" }
        },
        { "scope": ["string.regexp"], "settings": { "foreground": "#F0FFFF" } },
        {
            "scope": ["constant.character.escape"],
            "settings": { "foreground": "#F0FFFF" }
        },
        {
            "scope": ["*url*", "*link*", "*uri*"],
            "settings": { "fontStyle": "underline" }
        },
        {
            "scope": [
                "source.js constant.other.object.key.js string.unquoted.label.js"
            ],
            "settings": { "foreground": "#0080DC", "fontStyle": "italic" }
        },
        {
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#0080DC" }
        },
        {
            "scope": [
                "text.html.markdown",
                "punctuation.definition.list_item.markdown"
            ],
            "settings": { "foreground": "#0080DC" }
        },
        {
            "scope": ["text.html.markdown markup.inline.raw.markdown"],
            "settings": { "foreground": "#0000FF" }
        },
        {
            "scope": [
                "text.html.markdown markup.inline.raw.markdown",
                "punctuation.definition.raw.markdown"
            ],
            "settings": { "foreground": "#0083FF50" }
        },
        {
            "scope": ["text.html.markdown meta.dummy.line-break"],
            "settings": {}
        },
        {
            "scope": [
                "markdown.heading",
                "markup.heading | markup.heading entity.name",
                "markup.heading.markdown punctuation.definition.heading.markdown",
                "entity.name.section.markdown"
            ],
            "settings": { "foreground": "#6EBDFF", "fontStyle": "bold" }
        },
        {
            "scope": ["markup.underline"],
            "settings": { "foreground": "#50B4FF", "fontStyle": "underline" }
        },
        { "scope": ["markup.strike"], "settings": { "fontStyle": "" } },
        {
            "scope": [
                "markup.quote punctuation.definition.blockquote.markdown"
            ],
            "settings": { "foreground": "#0083FF50" }
        },
        { "scope": ["markup.quote"], "settings": { "fontStyle": "italic" } },
        {
            "scope": ["string.other.link.description.title.markdown"],
            "settings": { "foreground": "#0000FF" }
        },
        {
            "scope": ["constant.other.reference.link.markdown"],
            "settings": { "foreground": "#0000FF" }
        },
        {
            "scope": ["markup.raw.block"],
            "settings": { "foreground": "#0000FF" }
        },
        {
            "scope": [
                "punctuation.definition.raw.markdown",
                "punctuation.definition.markdown"
            ],
            "settings": { "foreground": "#F0FFFF" }
        },
        {
            "scope": ["variable.language.fenced.markdown"],
            "settings": { "foreground": "#0083FF" }
        },
        {
            "scope": ["meta.separator"],
            "settings": { "foreground": "#A7A8AF", "fontStyle": "bold" }
        },
        {
            "scope": "token.info-token",
            "settings": { "foreground": "#0083FF" }
        },
        {
            "scope": "token.warn-token",
            "settings": { "foreground": "#0000FF" }
        },
        {
            "scope": "token.error-token",
            "settings": { "foreground": "#FF293B" }
        },
        {
            "scope": "token.debug-token",
            "settings": { "foreground": "#F0FFFF" }
        }
    ]
}
