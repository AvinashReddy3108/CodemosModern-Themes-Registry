{
    "name": "Ashen Darker",
    "type": "dark",
    "colors": {
        "editor.background": "#0D0D0D",
        "editor.foreground": "#b4b4b4",
        "editor.lineHighlightBackground": "#161616",
        "editor.selectionBackground": "#262626",
        "editorCursor.foreground": "#e5e5e5",
        "editorWhitespace.foreground": "#262626",
        "editorIndentGuide.background": "#262626",
        "editorIndentGuide.activeBackground": "#404040",
        "editorLineNumber.foreground": "#262626",
        "editorLineNumber.activeForeground": "#737373",
        "statusBar.background": "#0D0D0D",
        "statusBar.foreground": "#b4b4b4",
        "statusBar.noFolderBackground": "#212121",
        "statusBar.debuggingBackground": "#212121",
        "activityBar.background": "#0D0D0D",
        "activityBar.foreground": "#b4b4b4",
        "activityBarBadge.background": "#C4693D",
        "activityBarBadge.foreground": "#121212",
        "sideBar.background": "#0D0D0D",
        "sideBar.foreground": "#b4b4b4",
        "sideBarTitle.foreground": "#d5d5d5",
        "titleBar.activeBackground": "#0D0D0D",
        "titleBar.activeForeground": "#b4b4b4",
        "titleBar.inactiveBackground": "#0D0D0D",
        "titleBar.inactiveForeground": "#404040",
        "tab.activeBackground": "#161616",
        "tab.activeForeground": "#d5d5d5",
        "tab.inactiveBackground": "#0D0D0D",
        "tab.inactiveForeground": "#404040",
        "tab.activeBorder": "#C4693D",
        "list.activeSelectionBackground": "#161616",
        "list.activeSelectionForeground": "#d5d5d5",
        "list.inactiveSelectionBackground": "#161616",
        "list.inactiveSelectionForeground": "#b4b4b4",
        "list.hoverBackground": "#161616",
        "input.background": "#161616",
        "input.foreground": "#b4b4b4",
        "input.placeholderForeground": "#535353",
        "dropdown.background": "#161616",
        "dropdown.foreground": "#b4b4b4",
        "button.background": "#C4693D",
        "button.foreground": "#0D0D0D",
        "progressBar.background": "#C4693D",
        "terminal.foreground": "#b4b4b4",
        "terminal.background": "#0D0D0D",
        "terminal.ansiBlack": "#151515",
        "terminal.ansiBrightBlack": "#535353",
        "terminal.ansiRed": "#B14242",
        "terminal.ansiBrightRed": "#DF6464",
        "terminal.ansiGreen": "#1E6F54",
        "terminal.ansiBrightGreen": "#629C7D",
        "terminal.ansiYellow": "#E5A72A",
        "terminal.ansiBrightYellow": "#E49A44",
        "terminal.ansiBlue": "#4A8B8B",
        "terminal.ansiBrightBlue": "#4A8B8B",
        "terminal.ansiMagenta": "#C53030",
        "terminal.ansiBrightMagenta": "#DF6464",
        "terminal.ansiCyan": "#D87C4A",
        "terminal.ansiBrightCyan": "#C4693D",
        "terminal.ansiWhite": "#b4b4b4",
        "terminal.ansiBrightWhite": "#e5e5e5",
        "editorError.foreground": "#C53030",
        "editorWarning.foreground": "#E5A72A",
        "editorInfo.foreground": "#d5d5d5",
        "editorHint.foreground": "#a7a7a7"
    },
    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#737373", "fontStyle": "italic" }
        },
        {
            "name": "Documentation Comments",
            "scope": ["comment.block.documentation"],
            "settings": { "foreground": "#949494", "fontStyle": "italic" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "string constant.other.placeholder"],
            "settings": { "foreground": "#b4b4b4" }
        },
        {
            "name": "Parameters",
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#d5d5d5", "fontStyle": "italic" }
        },
        {
            "name": "Builtin Variables",
            "scope": ["variable.builtin"],
            "settings": { "foreground": "#4A8B8B" }
        },
        {
            "name": "Member Variables",
            "scope": ["variable.other.member"],
            "settings": { "foreground": "#d5d5d5" }
        },
        {
            "name": "Keywords",
            "scope": ["keyword"],
            "settings": { "foreground": "#B14242" }
        },
        {
            "name": "Operators",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#C4693D" }
        },
        {
            "name": "Directives",
            "scope": ["keyword.directive"],
            "settings": { "foreground": "#B14242", "fontStyle": "italic" }
        },
        {
            "name": "Storage modifiers",
            "scope": ["storage.modifier"],
            "settings": { "foreground": "#B14242", "fontStyle": "italic" }
        },
        {
            "name": "Types",
            "scope": ["storage.type", "support.type"],
            "settings": { "foreground": "#4A8B8B" }
        },
        {
            "name": "Built-in Types",
            "scope": ["support.type.builtin"],
            "settings": { "foreground": "#4A8B8B" }
        },
        {
            "name": "Type Parameters",
            "scope": ["entity.name.type.parameter"],
            "settings": { "foreground": "#D87C4A" }
        },
        {
            "name": "Enum Variants",
            "scope": ["entity.name.type.enum.variant"],
            "settings": { "foreground": "#C4693D" }
        },
        {
            "name": "Classes",
            "scope": ["entity.name.type.class"],
            "settings": { "foreground": "#4A8B8B" }
        },
        {
            "name": "Functions",
            "scope": ["entity.name.function"],
            "settings": { "foreground": "#b4b4b4", "fontStyle": "bold" }
        },
        {
            "name": "Built-in Functions",
            "scope": ["support.function.builtin"],
            "settings": { "foreground": "#b4b4b4", "fontStyle": "bold italic" }
        },
        {
            "name": "Macros",
            "scope": ["entity.name.function.macro"],
            "settings": { "foreground": "#B14242" }
        },
        {
            "name": "Strings",
            "scope": ["string"],
            "settings": { "foreground": "#DF6464" }
        },
        {
            "name": "RegEx",
            "scope": ["string.regexp"],
            "settings": { "foreground": "#D87C4A" }
        },
        {
            "name": "Special Strings (URLs, Paths)",
            "scope": ["string.other.link"],
            "settings": { "foreground": "#DF6464", "fontStyle": "bold" }
        },
        {
            "name": "Character",
            "scope": ["constant.character"],
            "settings": { "foreground": "#DF6464", "fontStyle": "bold" }
        },
        {
            "name": "Escape Characters",
            "scope": ["constant.character.escape"],
            "settings": { "foreground": "#d5d5d5" }
        },
        {
            "name": "Numbers",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#4A8B8B" }
        },
        {
            "name": "Constants",
            "scope": ["constant"],
            "settings": { "foreground": "#C4693D" }
        },
        {
            "name": "Built-in Constants",
            "scope": ["constant.language"],
            "settings": { "foreground": "#4A8B8B" }
        },
        {
            "name": "Attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#a7a7a7" }
        },
        {
            "name": "HTML/XML Tags",
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#D87C4A", "fontStyle": "italic" }
        },
        {
            "name": "Punctuation",
            "scope": ["punctuation"],
            "settings": { "foreground": "#d5d5d5" }
        },
        {
            "name": "Special Punctuation",
            "scope": ["punctuation.special"],
            "settings": { "foreground": "#E5A72A" }
        },
        {
            "name": "Bracket Punctuation",
            "scope": ["punctuation.bracket"],
            "settings": { "foreground": "#737373" }
        },
        {
            "name": "Delimiter Punctuation",
            "scope": ["punctuation.delimiter"],
            "settings": { "foreground": "#E49A44" }
        },
        {
            "name": "Operators",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#D87C4A" }
        },
        {
            "name": "Namespaces",
            "scope": ["entity.name.namespace"],
            "settings": { "foreground": "#D87C4A", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Headings",
            "scope": ["markup.heading"],
            "settings": { "foreground": "#DF6464", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Lists",
            "scope": ["markup.list"],
            "settings": { "foreground": "#D87C4A" }
        },
        {
            "name": "Markdown Bold",
            "scope": ["markup.bold"],
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Markdown Italic",
            "scope": ["markup.italic"],
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "Markdown Links",
            "scope": ["markup.underline.link"],
            "settings": {
                "foreground": "#DF6464",
                "fontStyle": "italic underline"
            }
        },
        {
            "name": "Markdown Link Text",
            "scope": ["string.other.link.title"],
            "settings": { "foreground": "#B14242" }
        },
        {
            "name": "Markdown Code Blocks",
            "scope": ["markup.raw"],
            "settings": { "foreground": "#d5d5d5", "background": "#1d1d1d" }
        },
        {
            "name": "Markdown Quotes",
            "scope": ["markup.quote"],
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "Diff Plus",
            "scope": ["markup.inserted"],
            "settings": { "foreground": "#a7a7a7" }
        },
        {
            "name": "Diff Minus",
            "scope": ["markup.deleted"],
            "settings": { "foreground": "#B14242" }
        },
        {
            "name": "Diff Delta",
            "scope": ["markup.changed"],
            "settings": { "foreground": "#E49A44" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
