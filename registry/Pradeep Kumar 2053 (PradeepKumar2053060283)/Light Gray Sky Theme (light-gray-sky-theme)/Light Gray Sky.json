{
    "name": "Light Gray Sky",
    "type": "dark",
    "colors": {
        "editor.background": "#5A5A5A",
        "editor.foreground": "#F5F5F5",
        "activityBar.background": "#626262",
        "sideBar.background": "#5D5D5D",
        "statusBar.background": "#626262",
        "titleBar.activeBackground": "#626262",
        "editor.selectionBackground": "#767676",
        "editor.lineHighlightBackground": "#606060",
        "list.activeSelectionBackground": "#767676",
        "list.hoverBackground": "#656565",
        "tab.activeBackground": "#4169E1",
        "tab.activeForeground": "#FFFFFF",
        "tab.inactiveBackground": "#4D4D4D",
        "tab.inactiveForeground": "#BBBBBB",
        "tab.activeBorder": "#00BFFF",
        "tab.unfocusedActiveBorder": "#87CEEB",
        "tab.hoverBackground": "#5A82E2",
        "tab.unfocusedActiveBackground": "#5A6B9F"
    },
    "tokenColors": [
        { "scope": ["comment"], "settings": { "foreground": "#BEBEBE" } },
        {
            "scope": [
                "variable",
                "variable.other",
                "variable.parameter",
                "variable.other.readwrite",
                "meta.definition.variable",
                "meta.function-call.arguments"
            ],
            "settings": { "foreground": "#FFFFFF" }
        },
        {
            "scope": ["string", "string.quoted.single"],
            "settings": { "foreground": "#90EE90" }
        },
        {
            "scope": ["constant.character.escape", "constant.character.format"],
            "settings": { "foreground": "#FFA07A" }
        },
        {
            "scope": [
                "keyword",
                "storage.type",
                "storage.modifier",
                "keyword.control",
                "keyword.operator.new"
            ],
            "settings": { "foreground": "#FFD700" }
        },
        {
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#DA70D6" }
        },
        {
            "scope": [
                "variable.other.property.python",
                "meta.function-call.python",
                "meta.function-call.generic.python",
                "meta.function-call.python support.function.builtin.python",
                "meta.function-call.python support.module.python"
            ],
            "settings": { "foreground": "#FFA500" }
        },
        {
            "scope": [
                "entity.name.type.class",
                "entity.name.class",
                "support.class",
                "entity.other.inherited-class"
            ],
            "settings": { "foreground": "#FF69B4" }
        },
        {
            "scope": [
                "constant.language",
                "support.constant",
                "support.variable.magic",
                "variable.language"
            ],
            "settings": { "foreground": "#00FFFF" }
        },
        {
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#1E90FF" }
        },
        {
            "scope": [
                "keyword.operator",
                "punctuation.separator",
                "punctuation.terminator"
            ],
            "settings": { "foreground": "#FF00FF" }
        },
        {
            "scope": ["constant.other", "variable.other.constant"],
            "settings": { "foreground": "#F5F5F5" }
        },
        {
            "scope": ["support.function", "support.class", "support.type"],
            "settings": { "foreground": "#00FFFF" }
        },
        {
            "scope": [
                "entity.name.decorator",
                "meta.decorator",
                "punctuation.decorator"
            ],
            "settings": { "foreground": "#87CEFA" }
        },
        {
            "scope": ["keyword.control.import", "keyword.control.export"],
            "settings": { "foreground": "#DDA0DD" }
        },
        {
            "scope": [
                "meta.fstring.python",
                "constant.character.format.placeholder"
            ],
            "settings": { "foreground": "#FFA500" }
        },
        {
            "scope": ["support.type.python", "storage.type.annotation"],
            "settings": { "foreground": "#98FB98" }
        },
        {
            "scope": ["support.module.python"],
            "settings": { "foreground": "#00FFFF" }
        },
        {
            "scope": ["meta.member.access.python"],
            "settings": { "foreground": "#DA70D6" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
