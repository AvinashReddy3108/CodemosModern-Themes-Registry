    "tokenColors": [
        { "settings": { "foreground": "#898576" } },
        {
            "scope": ["meta.embedded", "source.groovy.embedded"],
            "settings": { "foreground": "#806731" }
        },
        {
            "name": "Comment",
            "scope": "comment",
            "settings": {
                "fontStyle": "italic bold",
                "foreground": "#374238af"
            }
        },
        {
            "scope": "string.quoted.docstring.multi.python",
            "settings": {
                "fontStyle": "italic bold",
                "foreground": "#374238af"
            }
        },
        {
            "name": "String",
            "scope": "string",
            "settings": { "foreground": "#326777" }
        },
        {
            "name": "Regexp",
            "scope": "string.regexp",
            "settings": { "foreground": "#814b49" }
        },
        {
            "name": "Number",
            "scope": "constant.numeric",
            "settings": { "foreground": "#6a4771" }
        },
        {
            "name": "Variable",
            "scope": ["variable.language", "variable.other"],
            "settings": { "foreground": "#806731" }
        },
        {
            "name": "Keyword",
            "scope": "keyword",
            "settings": { "foreground": "#416644" }
        },
        {
            "name": "Storage",
            "scope": "storage",
            "settings": { "fontStyle": "bold", "foreground": "#806731" }
        },
        {
            "name": "Class name",
            "scope": ["entity.name.class", "entity.name.type"],
            "settings": { "fontStyle": "italic bold", "foreground": "#814b49" }
        },
        {
            "name": "Function name",
            "scope": "entity.name.function",
            "settings": { "fontStyle": "italic bold", "foreground": "#806731" }
        },
        {
            "name": "Variable start",
            "scope": "punctuation.definition.variable",
            "settings": { "foreground": "#416644" }
        },
        {
            "name": "Embedded code markers",
            "scope": [
                "punctuation.section.embedded.begin",
                "punctuation.section.embedded.end"
            ],
            "settings": { "foreground": "#814b49" }
        },
        {
            "name": "Built-in constant",
            "scope": ["constant.language", "meta.preprocessor"],
            "settings": { "foreground": "#806731" }
        },
        {
            "name": "Support.construct",
            "scope": ["support.function.construct", "keyword.other.new"],
            "settings": { "foreground": "#814b49" }
        },
        {
            "name": "User-defined constant",
            "scope": ["constant.character", "constant.other"],
            "settings": { "foreground": "#814b49" }
        },
        {
            "name": "Inherited class",
            "scope": "entity.other.inherited-class",
            "settings": { "foreground": "#6a4771" }
        },
        {
            "name": "Function argument",
            "scope": "variable.parameter",
            "settings": {}
        },
        {
            "name": "Tag name",
            "scope": "entity.name.tag",
            "settings": { "foreground": "#806731" }
        },
        {
            "name": "Tag start/end",
            "scope": "punctuation.definition.tag",
            "settings": { "foreground": "#796137" }
        },
        {
            "name": "Tag attribute",
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#806731" }
        },
        {
            "name": "Library function",
            "scope": "support.function",
            "settings": { "foreground": "#806731" }
        },
        {
            "name": "Continuation",
            "scope": "punctuation.separator.continuation",
            "settings": { "foreground": "#814b49" }
        },
        {
            "name": "Library constant",
            "scope": "support.constant",
            "settings": {}
        },
        {
            "name": "Library class/type",
            "scope": ["support.type", "support.class"],
            "settings": { "foreground": "#416644" }
        },
        {
            "name": "Library Exception",
            "scope": "support.type.exception",
            "settings": { "foreground": "#814b49" }
        },
        {
            "name": "Library variable",
            "scope": "support.other.variable",
            "settings": {}
        },
        { "name": "Invalid", "scope": "invalid", "settings": {} },
        {
            "name": "diff: header",
            "scope": ["meta.diff", "meta.diff.header"],
            "settings": { "fontStyle": "italic", "foreground": "#416644" }
        },
        {
            "name": "diff: deleted",
            "scope": "markup.deleted",
            "settings": { "fontStyle": "", "foreground": "#814b49" }
        },
        {
            "name": "diff: changed",
            "scope": "markup.changed",
            "settings": { "fontStyle": "", "foreground": "#814b49" }
        },
        {
            "name": "diff: inserted",
            "scope": "markup.inserted",
            "settings": { "foreground": "#416644" }
        },
        {
            "name": "Markup Quote",
            "scope": "markup.quote",
            "settings": { "foreground": "#416644" }
        },
        {
            "name": "Markup Lists",
            "scope": "markup.list",
            "settings": { "foreground": "#806731" }
        },
        {
            "name": "Markup Styling",
            "scope": ["markup.bold", "markup.italic"],
            "settings": { "foreground": "#6a4771" }
        },
        {
            "name": "Markup Inline",
            "scope": "markup.inline.raw",
            "settings": { "fontStyle": "", "foreground": "#326777" }
        },
        {
            "name": "Markup Headings",
            "scope": "markup.heading",
            "settings": { "foreground": "#806731" }
        },
        {
            "name": "Markup Setext Header",
            "scope": "markup.heading.setext",
            "settings": { "fontStyle": "", "foreground": "#806731" }
        },
        {
            "scope": "token.info-token",
            "settings": { "foreground": "#806731" }
        },
        {
            "scope": "token.warn-token",
            "settings": { "foreground": "#806731" }
        },
        {
            "scope": "token.error-token",
            "settings": { "foreground": "#814b49" }
        },
        {
            "scope": "token.debug-token",
            "settings": { "foreground": "#6a4771" }
        },
        {
            "scope": "variable.object.property",
            "settings": { "foreground": "#806731" }
        },
        {
            "scope": "variable.parameter",
            "settings": { "foreground": "#806731" }
        },
        { "scope": "support.type", "settings": { "fontStyle": "" } },
        { "scope": "storage.type.function", "settings": { "fontStyle": "" } },
        {
            "scope": "entity.other.inherited-class",
            "settings": { "foreground": "#806731" }
        },
        {
            "scope": "storage.modifier",
            "settings": { "foreground": "#416644ff", "fontStyle": "" }
        },
        {
            "scope": "storage.type",
            "settings": { "foreground": "#416644ff", "fontStyle": "" }
        },
        {
            "scope": "keyword.control.import",
            "settings": { "foreground": "#6a4771" }
        },
        {
            "scope": "storage.modifier.async",
            "settings": { "foreground": "#416644ff", "fontStyle": "" }
        },
        { "scope": "meta.import", "settings": { "foreground": "#806731" } },
        { "scope": "source.ts", "settings": { "foreground": "#806731" } },
        {
            "scope": "meta.function-call",
            "settings": { "foreground": "#806731" }
        },
        {
            "scope": "entity.name.type",
            "settings": { "foreground": "#806731" }
        },
        {
            "scope": "entity.name.function",
            "settings": { "foreground": "#806731" }
        },
        { "scope": "variable.other", "settings": { "foreground": "#806731" } },
        {
            "scope": "storage.modifier.tsx",
            "settings": { "foreground": "#416644" }
        },
        {
            "scope": "entity.name.type.class.python",
            "settings": { "foreground": "#806731" }
        },
        {
            "scope": "support.type.python",
            "settings": { "foreground": "#806731" }
        },
        { "scope": "source.python", "settings": { "foreground": "#898576" } },
        {
            "scope": "keyword.control.import",
            "settings": { "foreground": "#814b49" }
        },
        {
            "scope": "keyword.control.from",
            "settings": { "foreground": "#814b49" }
        },
        {
            "scope": "constant.language.python",
            "settings": { "foreground": "#326777" }
        },
        {
            "scope": "entity.name.function.python",
            "settings": { "foreground": "#326777" }
        },
        {
            "scope": "punctuation.separator.dictionary.key-value.json, punctuation.separator.array.json, punctuation.separator.dictionary.pair.json",
            "settings": { "foreground": "#806731" }
        },
        { "scope": "storage.type.ts", "settings": { "foreground": "#806731" } },
        {
            "scope": "support.type.primitive",
            "settings": { "foreground": "#806731" }
        },
        {
            "scope": "punctuation.definition.dictionary.begin.json, punctuation.definition.dictionary.end.json, punctuation.definition.array.begin.json, punctuation.definition.array.end.json",
            "settings": { "foreground": "#6a4771" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
