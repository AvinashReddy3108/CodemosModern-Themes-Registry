        "tab.activeBackground": "#111111",
        "tab.inactiveBackground": "#2b2b2b",
        "tab.hoverBackground": "#5e5e5e80",
        "tab.border": "#00000000",
        "quickInput.background": "#2b2b2b",
        "quickInput.foreground": "#d4d4d4",
        "quickInputList.focusBackground": "#216dbf",
        "quickInputList.focusForeground": "#e9e9e9",
        "quickInputList.focusIconForeground": "#e9e9e9",
        "keybindingLabel.background": "#5e5e5e",
        "keybindingLabel.border": "#5e5e5e",
        "keybindingLabel.bottomBorder": "#bfbfbf",
        "keybindingLabel.foreground": "#e9e9e9",
        "scrollbarSlider.background": "#5e5e5e",
        "scrollbarSlider.activeBackground": "#bfbfbf80",
        "scrollbarSlider.hoverBackground": "#bfbfbf40",
        "minimap.selectionHighlight": "#2b2b2b",
        "editorOverviewRuler.background": "#2b2b2b",
        "editorOverviewRuler.border": "#2b2b2b",
        "editorOverviewRuler.findMatchForeground": "#b78738",
        "editorOverviewRuler.addedForeground": "#167a42",
        "editorOverviewRuler.deletedForeground": "#b04744",
        "editorOverviewRuler.modifiedForeground": "#8c6110",
        "editorOverviewRuler.errorForeground": "#b04744",
        "editorOverviewRuler.warningForeground": "#8c6110",
        "editorOverviewRuler.infoForeground": "#216dbf",
        "editorOverviewRuler.bracketMatchForeground": "#5e5e5e",
        "editorOverviewRuler.currentContentForeground": "#29757f",
        "editorOverviewRuler.incomingContentForeground": "#216dbf",
        "editorOverviewRuler.commonContentForeground": "#5e5e5e",
        "editorOverviewRuler.rangeHighlightForeground": "#414141",
        "editorOverviewRuler.selectionHighlightForeground": "#41414180",
        "editorOverviewRuler.wordHighlightForeground": "#216dbf",
        "editorOverviewRuler.wordHighlightStrongForeground": "#0000ff",
        "editor.background": "#111111",
        "editor.foreground": "#d4d4d4",
        "editorLineNumber.foreground": "#5e5e5e",
        "editorLineNumber.activeForeground": "#d4d4d4",
        "editorCursor.foreground": "#d4d4d4",
        "editorCursor.background": "#000000",
        "editor.selectionBackground": "#414141",
        "editor.inactiveSelectionBackground": "#41414180",
        "editorWhitespace.foreground": "#5e5e5e",
        "editor.selectionHighlightBackground": "#41414180",
        "editor.selectionHighlightBorder": "#414141",
        "editor.findMatchBackground": "#b7873880",
        "editor.findMatchBorder": "#b7873880",
        "editor.findMatchHighlightBackground": "#b7873840",
        "editor.findMatchHighlightBorder": "#b7873840",
        "editor.findRangeHighlightBackground": "#41414140",
        "editor.findRangeHighlightBorder": "#41414140",
        "editor.rangeHighlightBackground": "#41414180",
        "editor.rangeHighlightBorder": "#414141",
        "editor.hoverHighlightBackground": "#5e5e5e80",
        "editor.wordHighlightBackground": "#216dbf80",
        "editor.wordHighlightBorder": "#216dbf",
        "editor.lineHighlightBackground": "#2b2b2b",
        "editor.lineHighlightBorder": "#2b2b2b",
        "editorLink.activeForeground": "#3a94fb",
        "editorIndentGuide.background": "#2b2b2b",
        "editorIndentGuide.activeBackground": "#5e5e5e",
        "editorRuler.foreground": "#5e5e5e",
        "editorBracketMatch.background": "#2b2b2b",
        "editorBracketMatch.border": "#5e5e5e",
        "editor.foldBackground": "#2b2b2b80",
        "editorError.foreground": "#eb7c74",
        "editorWarning.foreground": "#b78738",
        "editorInfo.foreground": "#66a1f8",
        "editorGutter.background": "#111111",
        "editorGutter.modifiedBackground": "#8c6110",
        "editorGutter.addedBackground": "#167a42",
        "editorGutter.deletedBackground": "#b04744",
        "editorGutter.foldingControlForeground": "#d4d4d4",
        "editorCodeLens.foreground": "#bfbfbf",
        "editorGroup.border": "#5e5e5e",
        "editorInlayHint.background": "#2b2b2b",
        "editorInlayHint.foreground": "#d4d4d4",
        "editor.stackFrameHighlightBackground": "#8c611060",
        "diffEditor.insertedTextBackground": "#167a4240",
        "diffEditor.insertedTextBorder": "#00000000",
        "diffEditor.removedTextBackground": "#b0474440",
        "diffEditor.removedTextBorder": "#00000000",
        "diffEditor.border": "#5e5e5e",
        "editorMarkerNavigation.background": "#111",
        "editorMarkerNavigationWarning.background": "#8c6110",
        "editorMarkerNavigationError.background": "#b04744",
        "editorMarkerNavigationInfo.background": "#216dbf",
        "merge.currentHeaderBackground": "#61aab380",
        "merge.currentContentBackground": "#29757f80",
        "merge.incomingHeaderBackground": "#66a1f880",
        "merge.incomingContentBackground": "#216dbf80",
        "merge.commonContentBackground": "#5e5e5ec0",
        "merge.commonHeaderBackground": "#5e5e5e80",
        "editorHoverWidget.background": "#111111",
        "editorHoverWidget.border": "#2b2b2b",
        "peekView.border": "#216dbf",
        "peekViewEditor.background": "#216dbf20",
        "peekViewEditor.matchHighlightBackground": "#8c611080",
        "peekViewResult.background": "#2b2b2b",
        "peekViewResult.lineForeground": "#d4d4d4",
        "terminal.ansiBlack": "#2b2b2b",
        "terminal.ansiBrightBlack": "#5e5e5e",
        "terminal.ansiRed": "#b04744",
        "terminal.ansiBrightRed": "#eb7c74",
        "terminal.ansiGreen": "#167a42",
        "terminal.ansiBrightGreen": "#54b073",
        "terminal.ansiYellow": "#8c6110",
        "terminal.ansiBrightYellow": "#b78738",
        "terminal.ansiBlue": "#216dbf",
        "terminal.ansiBrightBlue": "#66a1f8",
        "terminal.ansiMagenta": "#9f4b95",
        "terminal.ansiBrightMagenta": "#d87fcc",
        "terminal.ansiCyan": "#29757f",
        "terminal.ansiBrightCyan": "#61aab3",
        "terminal.ansiWhite": "#bfbfbf",
        "terminal.ansiBrightWhite": "#e9e9e9",
        "terminal.selectionBackground": "#414141",
        "terminal.selectionForeground": "#e9e9e9"
    },
    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "fontStyle": "italic", "foreground": "#5e5e5e" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "string constant.other.placeholder"],
            "settings": { "foreground": "#d4d4d4" }
        },
        {
            "name": "Colors",
            "scope": ["constant.other.color"],
            "settings": { "foreground": "#d4d4d4" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#b04744" }
        },
        {
            "name": "Keyword, Storage",
            "scope": [
                "keyword",
                "storage.type",
                "storage.modifier",
                "keyword.other.unit",
                "keyword.other",
                "keyword.control",
                "entity.name.type.lifetime",
                "punctuation.definition.lifetime"
            ],
            "settings": { "foreground": "#9f4b95" }
        },
        {
            "name": "Operator, Misc",
            "scope": [
                "keyword.operator",
                "constant.other.color",
                "keyword.other.template",
                "keyword.other.substitution"
            ],
            "settings": { "foreground": "#d4d4d4" }
        },
        {
            "name": "Punctuation",
            "scope": ["punctuation"],
            "settings": { "foreground": "#d4d4d4" }
        },
        {
            "name": "Tag",
            "scope": [
                "entity.name.tag",
                "meta.tag.sgml",
                "markup.deleted.git_gutter"
            ],
            "settings": { "foreground": "#29757f" }
        },
        {
            "name": "Function, Special Method",
            "scope": [
                "entity.name.function",
                "meta.function-call",
                "variable.function",
                "support.function",
                "keyword.other.special-method"
            ],
            "settings": { "fontStyle": "", "foreground": "#29757f" }
        },
        {
            "name": "Block Level Variables",
            "scope": ["meta.block variable.other"],
            "settings": { "foreground": "#d4d4d4" }
        },
        {
            "name": "Other Variable, String Link",
            "scope": ["support.other.variable", "string.other.link"],
            "settings": { "foreground": "#00ffff" }
        },
        {
            "name": "Macros",
            "scope": ["entity.name.function.macro"],
            "settings": { "foreground": "#b04744", "fontStyle": "bold" }
        },
        {
            "name": "Attributes",
            "scope": [
                "meta.attribute.rust",
                "meta.attribute.rust punctuation",
                "meta.attribute.rust keyword.operator"
            ],
            "settings": { "foreground": "#b04744" }
        },
        {
            "name": "Number, Constant, Function Argument, Tag Attribute, Embedded, Escape",
            "scope": [
                "constant.numeric",
                "constant.language",
                "support.constant",
                "constant.character",
                "constant.escape",
                "constant.character.escape"
            ],
            "settings": { "foreground": "#8c6110" }
        },
        {
            "name": "String, Symbols, Inherited Class, Markup Heading",
            "scope": [
                "string",
                "constant.other.symbol",
                "constant.other.key",
                "entity.other.inherited-class",
                "markup.heading",
                "markup.inserted.git_gutter",
                "meta.group.braces.curly constant.other.object.key.js string.unquoted.label.js"
            ],
            "settings": { "foreground": "#167a42" }
        },
        {
            "name": "Class, Support",
            "scope": [
                "entity.name",
                "support.type",
                "support.class",
                "support.other.namespace.use.php",
                "meta.use.php",
                "support.other.namespace.php",
                "markup.changed.git_gutter",
                "support.type.sys-types"
            ],
            "settings": { "fontStyle": "bold", "foreground": "#216dbf" }
        },
        {
            "name": "Make lifetimes not bold",
            "scope": ["entity.name.type.lifetime"],
            "settings": { "fontStyle": "" }
        },
        {
            "name": "Entity Types",
            "scope": ["support.type"],
            "settings": { "foreground": "#29757f" }
        },
        {
            "name": "CSS Class and Support",
            "scope": [
                "source.css support.type.property-name",
                "source.sass support.type.property-name",
                "source.scss support.type.property-name",
                "source.less support.type.property-name",
                "source.stylus support.type.property-name",
                "source.postcss support.type.property-name"
            ],
            "settings": { "fontStyle": "", "foreground": "#9f4b95" }
        },
        {
            "name": "CSS Vendored Class",
            "scope": [
                "source.css support.type.vendored.property-name",
                "source.sass support.type.vendored.property-name",
                "source.scss support.type.vendored.property-name",
                "source.less support.type.vendored.property-name",
                "source.stylus support.type.vendored.property-name",
                "source.postcss support.type.vendored.property-name"
            ],
            "settings": { "fontStyle": "italic", "foreground": "#9f4b95" }
        },
        {
            "name": "Sub-methods",
            "scope": [
                "entity.name.module.js",
                "variable.import.parameter.js",
                "variable.other.class.js"
            ],
            "settings": { "foreground": "#FF5370" }
        },
        {
            "name": "Language methods",
            "scope": ["variable.language"],
            "settings": { "fontStyle": "italic", "foreground": "#9f4b95" }
        },
        {
            "name": "entity.name.method.js",
            "scope": ["entity.name.method.js"],
            "settings": { "fontStyle": "italic", "foreground": "#82AAFF" }
        },
        {
            "name": "meta.method.js",
            "scope": [
                "meta.class-method.js entity.name.function.js",
                "variable.function.constructor"
            ],
            "settings": { "foreground": "#82AAFF" }
        },
        {
            "name": "Attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#8c6110" }
        },
        {
            "name": "HTML Attributes",
            "scope": [
                "text.html.basic entity.other.attribute-name.html",
                "text.html.basic entity.other.attribute-name"
            ],
            "settings": { "foreground": "#9f4b95" }
        },
        {
            "name": "CSS Classes",
            "scope": [
                "entity.other.attribute-name.class",
                "entity.other.attribute-name.id.css"
            ],
            "settings": { "fontStyle": "bold", "foreground": "#216dbf" }
        },
        {
            "name": "CSS ID's",
            "scope": ["source.sass keyword.control"],
            "settings": { "fontStyle": "bold", "foreground": "#216dbf" }
        },
        {
            "name": "Inserted",
            "scope": ["markup.inserted"],
            "settings": { "foreground": "#C3E88D" }
        },
        {
            "name": "Deleted",
            "scope": ["markup.deleted"],
            "settings": { "foreground": "#FF5370" }
        },
        {
            "name": "Changed",
            "scope": ["markup.changed"],
            "settings": { "foreground": "#C792EA" }
        },
        {
            "name": "Regular Expressions",
            "scope": ["string.regexp"],
            "settings": { "foreground": "#89DDFF" }
        },
        {
            "name": "URL",
            "scope": ["*url*", "*link*", "*uri*"],
            "settings": { "fontStyle": "underline" }
        },
        {
            "name": "Decorators",
            "scope": [
                "tag.decorator.js entity.name.tag.js",
                "tag.decorator.js punctuation.definition.tag.js"
            ],
            "settings": { "fontStyle": "italic", "foreground": "#82AAFF" }
        },
        {
            "name": "ES7 Bind Operator",
            "scope": [
                "source.js constant.other.object.key.js string.unquoted.label.js"
            ],
            "settings": { "fontStyle": "italic", "foreground": "#FF5370" }
        },
        {
            "name": "JSON Key",
            "scope": [
                "source.json meta.structure.dictionary.json support.type.property-name.json"
            ],
            "settings": { "fontStyle": "", "foreground": "#29757f" }
        },
        {
            "name": "Markdown - Plain",
            "scope": [
                "text.html.markdown",
                "punctuation.definition.list_item.markdown"
            ],
            "settings": { "foreground": "#d4d4d4" }
        },
        {
            "name": "Markdown - Markup Raw Inline",
            "scope": ["text.html.markdown markup.inline.raw.markdown"],
            "settings": { "foreground": "#C792EA" }
        },
        {
            "name": "Markdown - Markup Raw Inline Punctuation",
            "scope": [
                "text.html.markdown markup.inline.raw.markdown punctuation.definition.raw.markdown"
            ],
            "settings": { "foreground": "#65737E" }
        },
        {
            "name": "Markup - Italic",
            "scope": ["markup.italic"],
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "Markup - Bold",
            "scope": ["markup.bold", "markup.bold string"],
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Markup - Bold-Italic",
            "scope": [
                "markup.bold markup.italic",
                "markup.italic markup.bold",
                "markup.quote markup.bold",
                "markup.bold markup.italic string",
                "markup.italic markup.bold string",
                "markup.quote markup.bold string"
            ],
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Markup - Underline",
            "scope": ["markup.underline"],
            "settings": { "fontStyle": "underline" }
        },
        {
            "name": "Markup - Quote",
            "scope": ["markup.quote"],
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "Markdown - Link",
            "scope": ["string.other.link.title.markdown"],
            "settings": { "fontStyle": "underline", "foreground": "#3a94fb" }
        },
        {
            "name": "Markdown - Inline Link",
            "scope": [
                "markup.underline.link.markdown",
                "markup.underline.link.image.markdown"
            ],
            "settings": { "fontStyle": "italic", "foreground": "#167a42" }
        },
        {
            "name": "Markdown - Link Description",
            "scope": ["string.other.link.description.title.markdown"],
            "settings": { "foreground": "#C792EA" }
        },
        {
            "name": "Markdown - Link Anchor",
            "scope": ["constant.other.reference.link.markdown"],
            "settings": { "foreground": "#29757f" }
        },
        {
            "name": "Markup - Raw Block",
            "scope": ["markup.raw.block"],
            "settings": { "foreground": "#C792EA" }
        },
        {
            "name": "Markdown - Raw Block Fenced",
            "scope": ["markup.raw.block.fenced.markdown"],
            "settings": { "foreground": "#00000050" }
        },
        {
            "name": "Markdown - Fenced Bode Block",
            "scope": ["punctuation.definition.fenced.markdown"],
            "settings": { "foreground": "#00000050" }
        },
        {
            "name": "Markdown - Fenced Bode Block Variable",
            "scope": [
                "markup.raw.block.fenced.markdown",
                "variable.language.fenced.markdown",
                "punctuation.section.class.end"
            ],
            "settings": { "foreground": "#EEFFFF" }
        },
        {
            "name": "Markdown - Fenced Language",
            "scope": ["variable.language.fenced.markdown"],
            "settings": { "foreground": "#65737E" }
        },
        {
            "name": "Markdown - Separator",
            "scope": ["meta.separator"],
            "settings": { "fontStyle": "bold", "foreground": "#65737E" }
        },
        {
            "name": "Markup - Table",
            "scope": ["markup.table"],
            "settings": { "foreground": "#EEFFFF" }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "comment": { "foreground": "#5e5e5e", "fontStyle": "italic" },
        "*.documentation": { "foreground": "#9f4b95", "fontStyle": "" },
        "keyword": { "foreground": "#9f4b95", "fontStyle": "" },
        "number": { "foreground": "#8c6110", "fontStyle": "" },
        "boolean": { "foreground": "#8c6110", "fontStyle": "" },
        "string": { "foreground": "#167a42", "fontStyle": "" },
        "escapeSequence": { "foreground": "#8c6110", "fontStyle": "" },
        "function": { "foreground": "#29757f", "fontStyle": "" },
        "method": { "foreground": "#29757f", "fontStyle": "italic" },
        "parameter": { "foreground": "#d4d4d4", "fontStyle": "" },
        "variable": { "foreground": "#d4d4d4", "fontStyle": "" },
        "property": { "foreground": "#d4d4d4", "fontStyle": "" },
        "namespace": { "foreground": "#216dbf", "fontStyle": "" },
        "class": { "foreground": "#216dbf", "fontStyle": "bold" },
        "enum": { "foreground": "#216dbf", "fontStyle": "bold" },
        "interface": { "foreground": "#216dbf", "fontStyle": "bold" },
        "struct": { "foreground": "#216dbf", "fontStyle": "bold" },
        "type": { "foreground": "#216dbf", "fontStyle": "bold" },
        "typeParameter": { "foreground": "#216dbf", "fontStyle": "italic" },
        "enumMember": { "foreground": "#29757f", "fontStyle": "bold" },
        "*.attribute": { "foreground": "#b04744", "fontStyle": "" },
        "macro": { "foreground": "#b04744", "fontStyle": "bold" },
        "macroBang": { "foreground": "#b04744", "fontStyle": "bold" },
        "unresolvedReference": {
            "foreground": "#b04744",
            "fontStyle": "strikethrough"
        }
    },
    "$schema": "vscode://schemas/color-theme"
}
