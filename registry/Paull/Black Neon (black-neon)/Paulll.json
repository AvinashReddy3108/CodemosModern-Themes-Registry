    "tokenColors": [
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#3b6a70", "fontStyle": "italic" }
        },
        {
            "scope": ["keyword", "storage.type"],
            "settings": { "foreground": "#fa5b7c" }
        },
        {
            "scope": ["string", "constant.other.symbol"],
            "settings": { "foreground": "#9effd3" }
        },
        {
            "scope": ["variable", "meta.definition.variable.name"],
            "settings": { "foreground": "#f4f99d" }
        },
        {
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#bd93f9" }
        },
        {
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#69e0ff" }
        },
        {
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#f4f99d" }
        },
        {
            "scope": ["entity.name.type", "support.type"],
            "settings": { "foreground": "#8be9fd" }
        },
        { "scope": ["punctuation"], "settings": { "foreground": "#ffb86c" } },
        {
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#ffffff" }
        },
        {
            "scope": ["meta.function-call"],
            "settings": { "foreground": "#69e0ff" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
