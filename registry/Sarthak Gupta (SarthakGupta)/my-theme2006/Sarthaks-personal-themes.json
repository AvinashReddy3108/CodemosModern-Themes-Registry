{
    "name": "Sarthaks-personal-themes",
    "type": "dark",
    "colors": {
        "editor.background": "#000000",
        "editor.foreground": "#d6deeb",
        "activityBar.background": "#070910",
        "activityBar.foreground": "#ffffff",
        "activityBarBadge.background": "#82aaff",
        "sideBar.background": "#1a1a1a",
        "sideBar.foreground": "#a9b1d6",
        "sideBarTitle.foreground": "#ffffff",
        "statusBar.background": "#070910",
        "statusBar.foreground": "#d6deeb",
        "titleBar.activeBackground": "#070910",
        "titleBar.activeForeground": "#ffffff",
        "tab.activeBackground": "#0b0f17",
        "tab.inactiveBackground": "#0a0d14",
        "tab.activeForeground": "#ffffff",
        "tab.inactiveForeground": "#6c7393",
        "editor.lineHighlightBackground": "#ffffff12",
        "editor.selectionBackground": "#82aaff44",
        "editorCursor.foreground": "#ffcc66",
        "editorBracketMatch.background": "#82aaff33",
        "editorBracketMatch.border": "#82aaff",
        "editorIndentGuide.background": "#ffffff10",
        "editorIndentGuide.activeBackground": "#82aaff66",
        "editorHoverWidget.background": "#111827",
        "editorHoverWidget.border": "#82aaff55"
    },
    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment"],
            "settings": { "foreground": "#5f6b99", "fontStyle": "italic" }
        },
        {
            "name": "Keywords",
            "scope": ["keyword", "storage.type"],
            "settings": { "foreground": "#bb9af7" }
        },
        {
            "name": "Strings",
            "scope": ["string"],
            "settings": { "foreground": "#9ece6a" }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "support.function",
                "variable.function"
            ],
            "settings": { "foreground": "#7aa2f7" }
        },
        {
            "name": "Variables",
            "scope": ["variable"],
            "settings": { "foreground": "#e0e6ff" }
        },
        {
            "name": "Numbers",
            "scope": ["constant.numeric", "constant.language"],
            "settings": { "foreground": "#ff9e64" }
        },
        {
            "name": "Classes",
            "scope": ["entity.name.type", "support.class", "support.type"],
            "settings": { "foreground": "#e0af68" }
        },
        {
            "name": "Tags",
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#f7768e" }
        },
        {
            "name": "Attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#c099ff" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
