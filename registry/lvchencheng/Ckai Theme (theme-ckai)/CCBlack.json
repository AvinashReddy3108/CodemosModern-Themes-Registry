    "name": "CCBlack-color-theme",
    "semanticTokenColors": {
        "class.declaration": { "foreground": "#935cd1" },
        "class.decorator": { "foreground": "#CC71BC" },
        "enumMember": { "foreground": "#935cd1" },
        "meta.decorator": { "foreground": "#CC71BC" },
        "namespace": { "foreground": "#3398DB" },
        "parameter": { "foreground": "#CC71BC" },
        "property": { "foreground": "#D26D32" },
        "property.declaration": { "foreground": "#c8ccd4" },
        "variable.defaultLibrary": { "foreground": "#24B5A8" }
    },
    "tokenColors": [
        { "settings": { "foreground": "#F8F8F2" } },
        {
            "scope": [
                "meta.embedded",
                "source.groovy.embedded",
                "string meta.image.inline.markdown",
                "variable.legacy.builtin.python"
            ],
            "settings": { "foreground": "#F8F8F2" }
        },
        {
            "name": "Comment",
            "scope": "comment",
            "settings": { "foreground": "#88846f" }
        },
        {
            "name": "String",
            "scope": "string",
            "settings": { "foreground": "#E6DB74" }
        },
        {
            "name": "Template Definition",
            "scope": [
                "punctuation.definition.template-expression",
                "punctuation.section.embedded"
            ],
            "settings": { "foreground": "#FF6188" }
        },
        {
            "name": "Reset JavaScript string interpolation expression",
            "scope": ["meta.template.expression"],
            "settings": { "foreground": "#F8F8F2" }
        },
        {
            "name": "Number",
            "scope": "constant.numeric",
            "settings": { "foreground": "#AE81FF" }
        },
        {
            "name": "Built-in constant",
            "scope": "constant.language",
            "settings": { "foreground": "#AE81FF" }
        },
        {
            "name": "User-defined constant",
            "scope": "constant.character, constant.other",
            "settings": { "foreground": "#AE81FF" }
        },
        {
            "name": "Variable",
            "scope": "variable",
            "settings": { "fontStyle": "", "foreground": "#F8F8F2" }
        },
        {
            "name": "variable.other.constant",
            "scope": "variable.other.constant",
            "settings": { "fontStyle": "", "foreground": "#AB9DF2" }
        },
        {
            "name": "Keyword",
            "scope": "keyword",
            "settings": { "fontStyle": "", "foreground": "#FF6188" }
        },
        {
            "name": "keyword.control.from",
            "scope": "keyword.control.from",
            "settings": { "fontStyle": "", "foreground": "#FF6188" }
        },
        {
            "name": "keyword.control.import",
            "scope": "keyword.control.import",
            "settings": { "fontStyle": "", "foreground": "#FF6188" }
        },
        {
            "name": "keyword.control.export",
            "scope": "keyword.control.export",
            "settings": { "fontStyle": "", "foreground": "#FF6188" }
        },
        {
            "name": "keyword.control.default",
            "scope": "keyword.control.default",
            "settings": { "fontStyle": "", "foreground": "#FF6188" }
        },
        {
            "name": "keyword.control.flow",
            "scope": "keyword.control.flow",
            "settings": { "fontStyle": "", "foreground": "#FF6188" }
        },
        {
            "name": "keyword.control.type",
            "scope": "keyword.control.type",
            "settings": { "fontStyle": "", "foreground": "#FF6188" }
        },
        {
            "name": "keyword.control.module.js",
            "scope": "keyword.control.module.js",
            "settings": { "fontStyle": "", "foreground": "#FF6188" }
        },
        {
            "name": "keyword.control.module",
            "scope": "keyword.control.module",
            "settings": { "fontStyle": "", "foreground": "#FF6188" }
        },
        {
            "name": "keyword.other.unit",
            "scope": "keyword.other.unit",
