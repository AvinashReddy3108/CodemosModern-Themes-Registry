    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#6b7280", "fontStyle": "italic" }
        },
        {
            "name": "Keyword",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.new",
                "keyword.operator.expression",
                "keyword.operator.logical",
                "storage",
                "storage.type",
                "storage.modifier"
            ],
            "settings": { "foreground": "#d97706" }
        },
        {
            "name": "Keyword Operator",
            "scope": [
                "keyword.operator",
                "keyword.operator.assignment",
                "keyword.operator.arithmetic",
                "keyword.operator.comparison",
                "keyword.operator.relational"
            ],
            "settings": { "foreground": "#5a6a7e" }
        },
        {
            "name": "Function",
            "scope": [
                "entity.name.function",
                "meta.function-call",
                "support.function",
                "meta.method-call entity.name.function"
            ],
            "settings": { "foreground": "#0f766e" }
        },
        {
            "name": "String",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#0f6e3a" }
        },
        {
            "name": "String Escape",
            "scope": ["constant.character.escape"],
            "settings": { "foreground": "#0a5c2e" }
        },
        {
            "name": "Template String Punctuation",
            "scope": [
                "string.template punctuation.definition",
                "punctuation.definition.template-expression"
            ],
            "settings": { "foreground": "#d97706" }
        },
        {
            "name": "Number",
            "scope": [
                "constant.numeric",
                "constant.numeric.integer",
                "constant.numeric.float",
                "constant.numeric.hex"
            ],
            "settings": { "foreground": "#a3390d" }
        },
        {
            "name": "Constant Language",
            "scope": ["constant.language", "support.constant"],
            "settings": { "foreground": "#a3390d", "fontStyle": "italic" }
        },
        {
            "name": "Constant Other",
            "scope": ["constant", "constant.other"],
            "settings": { "foreground": "#a3390d" }
        },
        {
            "name": "Variable",
            "scope": ["variable", "variable.other", "variable.other.readwrite"],
            "settings": { "foreground": "#1e2a3a" }
        },
        {
            "name": "Variable Parameter",
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#2d3d52" }
        },
        {
            "name": "Variable Language (this/self)",
            "scope": ["variable.language"],
            "settings": { "foreground": "#d97706", "fontStyle": "italic" }
        },
        {
            "name": "Object Property",
            "scope": [
                "variable.other.property",
                "variable.other.object.property",
                "meta.object-literal.key"
            ],
            "settings": { "foreground": "#1e2a3a" }
        },
        {
            "name": "Type",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "entity.name.namespace",
                "support.type",
                "support.class",
                "entity.other.inherited-class"
            ],
            "settings": { "foreground": "#6d28d9" }
        },
        {
            "name": "Type Annotation",
            "scope": ["meta.type.annotation", "meta.return.type"],
            "settings": { "foreground": "#6d28d9" }
        },
        {
            "name": "Interface",
            "scope": ["entity.name.type.interface"],
            "settings": { "foreground": "#6d28d9" }
        },
        {
            "name": "Enum",
            "scope": ["entity.name.type.enum"],
            "settings": { "foreground": "#6d28d9" }
        },
        {
            "name": "Decorator",
            "scope": ["meta.decorator", "meta.decorator entity.name.function"],
            "settings": { "foreground": "#d97706", "fontStyle": "italic" }
        },
        {
            "name": "Tag",
            "scope": ["entity.name.tag", "meta.tag"],
            "settings": { "foreground": "#d97706" }
        },
        {
            "name": "Tag Attribute",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#0f766e", "fontStyle": "italic" }
        },
        {
            "name": "JSX Component",
            "scope": [
                "support.class.component",
                "entity.name.tag support.class.component"
            ],
            "settings": { "foreground": "#6d28d9" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation",
                "meta.brace",
                "punctuation.definition.block",
                "punctuation.definition.parameters",
                "punctuation.separator",
                "punctuation.terminator"
            ],
            "settings": { "foreground": "#5a6a7e" }
        },
        {
            "name": "Import/Export",
            "scope": [
                "keyword.control.import",
                "keyword.control.export",
                "keyword.control.from",
                "keyword.control.as"
            ],
            "settings": { "foreground": "#d97706" }
        },
        {
            "name": "Regular Expression",
            "scope": ["string.regexp"],
            "settings": { "foreground": "#0f766e" }
        },
        {
            "name": "Markdown Heading",
            "scope": ["markup.heading", "entity.name.section"],
            "settings": { "foreground": "#0f766e", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Bold",
            "scope": ["markup.bold"],
            "settings": { "foreground": "#d97706", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Italic",
            "scope": ["markup.italic"],
            "settings": { "foreground": "#6d28d9", "fontStyle": "italic" }
        },
        {
            "name": "Markdown Link",
            "scope": ["markup.underline.link"],
            "settings": { "foreground": "#0f766e" }
        },
        {
            "name": "Markdown Code",
            "scope": ["markup.inline.raw", "markup.fenced_code"],
            "settings": { "foreground": "#a3390d" }
        },
        {
            "name": "Markdown List",
            "scope": ["markup.list"],
            "settings": { "foreground": "#d97706" }
        },
        {
            "name": "Markdown Quote",
            "scope": ["markup.quote"],
            "settings": { "foreground": "#6b7280", "fontStyle": "italic" }
        },
        {
            "name": "CSS Property",
            "scope": [
                "support.type.property-name.css",
                "support.type.vendored.property-name.css"
            ],
            "settings": { "foreground": "#0f766e" }
        },
        {
            "name": "CSS Value",
            "scope": [
                "support.constant.property-value.css",
                "support.constant.color.css"
            ],
            "settings": { "foreground": "#a3390d" }
        },
        {
            "name": "CSS Selector",
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css"
            ],
            "settings": { "foreground": "#d97706" }
        },
        {
            "name": "CSS Unit",
            "scope": ["keyword.other.unit.css"],
            "settings": { "foreground": "#a3390d" }
        },
        {
            "name": "JSON Key",
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#0f766e" }
        },
        {
            "name": "JSON Value String",
            "scope": ["meta.structure.dictionary.value.json string.quoted"],
            "settings": { "foreground": "#0f6e3a" }
        },
        {
            "name": "YAML Key",
            "scope": ["entity.name.tag.yaml"],
            "settings": { "foreground": "#0f766e" }
        },
        {
            "name": "Python Self",
            "scope": [
                "variable.parameter.function.language.special.self.python",
                "variable.language.special.self.python"
            ],
            "settings": { "foreground": "#d97706", "fontStyle": "italic" }
        },
        {
            "name": "Python Decorator",
            "scope": ["entity.name.function.decorator.python"],
            "settings": { "foreground": "#d97706", "fontStyle": "italic" }
        },
        {
            "name": "Python F-String",
            "scope": ["meta.fstring"],
            "settings": { "foreground": "#0f6e3a" }
        },
        {
            "name": "Go Package",
            "scope": ["entity.name.package.go"],
            "settings": { "foreground": "#6d28d9" }
        },
        {
            "name": "Rust Lifetime",
            "scope": [
                "storage.modifier.lifetime.rust",
                "entity.name.lifetime.rust"
            ],
            "settings": { "foreground": "#d97706", "fontStyle": "italic" }
        },
        {
            "name": "Rust Macro",
            "scope": ["entity.name.function.macro.rust"],
            "settings": { "foreground": "#0f766e", "fontStyle": "bold" }
        },
        {
            "name": "Shell Variable",
            "scope": [
                "variable.other.normal.shell",
                "variable.other.special.shell"
            ],
            "settings": { "foreground": "#0f766e" }
        },
        {
            "name": "Diff Added",
            "scope": ["markup.inserted"],
            "settings": { "foreground": "#0f6e3a" }
        },
        {
            "name": "Diff Deleted",
            "scope": ["markup.deleted"],
            "settings": { "foreground": "#c73040" }
        },
        {
            "name": "Diff Changed",
            "scope": ["markup.changed"],
            "settings": { "foreground": "#d97706" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#c73040" }
        },
        {
            "name": "Deprecated",
            "scope": ["invalid.deprecated"],
            "settings": {
                "foreground": "#a3390d",
                "fontStyle": "strikethrough"
            }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
