    "tokenColors": [
        {
            "scope": [
                "comment",
                "punctuation.definition.comment",
                "string.quoted.docstring"
            ],
            "settings": { "foreground": "#C4C1D0", "fontStyle": "italic" }
        },
        {
            "scope": ["string", "string.quoted"],
            "settings": { "foreground": "#E07BCD" }
        },
        {
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#E689BE" }
        },
        {
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#3AAAD9" }
        },
        {
            "scope": ["keyword.control"],
            "settings": { "foreground": "#F184BF" }
        },
        {
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#975CEA" }
        },
        {
            "scope": ["entity.name.class", "entity.name.type", "support.class"],
            "settings": { "foreground": "#CB72DD" }
        },
        {
            "scope": ["variable", "variable.other"],
            "settings": { "foreground": "#676E7E" }
        },
        {
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#788294" }
        },
        {
            "scope": ["constant", "constant.language"],
            "settings": { "foreground": "#E48AD3" }
        },
        {
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#96A0B6" }
        },
        { "scope": ["meta.brace"], "settings": { "foreground": "#60BAD4" } },
        {
            "scope": [
                "punctuation",
                "punctuation.definition.string",
                "punctuation.separator",
                "punctuation.terminator"
            ],
            "settings": { "foreground": "#629DD4" }
        },
        {
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#E667B3" }
        },
        {
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#C481D9" }
        },
        {
            "scope": ["support.type.property-name", "variable.other.property"],
            "settings": { "foreground": "#929FB5" }
        },
        {
            "scope": ["support.type", "entity.name.type"],
            "settings": { "foreground": "#C481D9" }
        },
        {
            "scope": ["meta.decorator", "punctuation.decorator"],
            "settings": { "foreground": "#5CD1EC" }
        },
        { "scope": ["string.regexp"], "settings": { "foreground": "#3CBCDE" } },
        {
            "scope": ["markup.heading"],
            "settings": { "foreground": "#F184BF", "fontStyle": "bold" }
        },
        { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
        { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
        {
            "scope": ["markup.inline.raw"],
            "settings": { "foreground": "#4DCBE8" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
