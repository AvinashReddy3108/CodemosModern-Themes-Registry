    "tokenColors": [
        {
            "scope": [
                "comment",
                "punctuation.definition.comment",
                "string.quoted.docstring"
            ],
            "settings": { "foreground": "#ECCDDA", "fontStyle": "italic" }
        },
        {
            "scope": ["string", "string.quoted"],
            "settings": { "foreground": "#F268BB" }
        },
        {
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#F2719C" }
        },
        {
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#42A6EC" }
        },
        {
            "scope": ["keyword.control"],
            "settings": { "foreground": "#F26795" }
        },
        {
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#9D4EF2" }
        },
        {
            "scope": ["entity.name.class", "entity.name.type", "support.class"],
            "settings": { "foreground": "#EE69EE" }
        },
        {
            "scope": ["variable", "variable.other"],
            "settings": { "foreground": "#CFB8C2" }
        },
        {
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#D4BFC9" }
        },
        {
            "scope": ["constant", "constant.language"],
            "settings": { "foreground": "#F273C3" }
        },
        {
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#DDC1D1" }
        },
        { "scope": ["meta.brace"], "settings": { "foreground": "#72C9EA" } },
        {
            "scope": [
                "punctuation",
                "punctuation.definition.string",
                "punctuation.separator",
                "punctuation.terminator"
            ],
            "settings": { "foreground": "#759BEA" }
        },
        {
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#F25589" }
        },
        {
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#EC7BEC" }
        },
        {
            "scope": ["support.type.property-name", "variable.other.property"],
            "settings": { "foreground": "#DCC4D1" }
        },
        {
            "scope": ["support.type", "entity.name.type"],
            "settings": { "foreground": "#EC7BEC" }
        },
        {
            "scope": ["meta.decorator", "punctuation.decorator"],
            "settings": { "foreground": "#5DCDF2" }
        },
        { "scope": ["string.regexp"], "settings": { "foreground": "#43BFEF" } },
        {
            "scope": ["markup.heading"],
            "settings": { "foreground": "#F26795", "fontStyle": "bold" }
        },
        { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
        { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
        {
            "scope": ["markup.inline.raw"],
            "settings": { "foreground": "#51CCF2" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
