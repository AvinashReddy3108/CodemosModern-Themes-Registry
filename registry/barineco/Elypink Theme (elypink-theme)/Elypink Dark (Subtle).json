    "tokenColors": [
        {
            "scope": [
                "comment",
                "punctuation.definition.comment",
                "string.quoted.docstring"
            ],
            "settings": { "foreground": "#ECD2DD", "fontStyle": "italic" }
        },
        {
            "scope": ["string", "string.quoted"],
            "settings": { "foreground": "#F27DC3" }
        },
        {
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#F284A9" }
        },
        {
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#5BB0EC" }
        },
        {
            "scope": ["keyword.control"],
            "settings": { "foreground": "#F27CA3" }
        },
        {
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#AA67F2" }
        },
        {
            "scope": ["entity.name.class", "entity.name.type", "support.class"],
            "settings": { "foreground": "#EE7DEE" }
        },
        {
            "scope": ["variable", "variable.other"],
            "settings": { "foreground": "#CFBBC4" }
        },
        {
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#D4C2CB" }
        },
        {
            "scope": ["constant", "constant.language"],
            "settings": { "foreground": "#F286CA" }
        },
        {
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#DDC5D3" }
        },
        { "scope": ["meta.brace"], "settings": { "foreground": "#84CEEA" } },
        {
            "scope": [
                "punctuation",
                "punctuation.definition.string",
                "punctuation.separator",
                "punctuation.terminator"
            ],
            "settings": { "foreground": "#87A7EA" }
        },
        {
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#F26D99" }
        },
        {
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#EC8CEC" }
        },
        {
            "scope": ["support.type.property-name", "variable.other.property"],
            "settings": { "foreground": "#DCC8D3" }
        },
        {
            "scope": ["support.type", "entity.name.type"],
            "settings": { "foreground": "#EC8CEC" }
        },
        {
            "scope": ["meta.decorator", "punctuation.decorator"],
            "settings": { "foreground": "#73D3F2" }
        },
        { "scope": ["string.regexp"], "settings": { "foreground": "#5DC6EF" } },
        {
            "scope": ["markup.heading"],
            "settings": { "foreground": "#F27CA3", "fontStyle": "bold" }
        },
        { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
        { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
        {
            "scope": ["markup.inline.raw"],
            "settings": { "foreground": "#69D2F2" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
