    "tokenColors": [
        {
            "scope": [
                "comment",
                "punctuation.definition.comment",
                "string.quoted.docstring"
            ],
            "settings": { "foreground": "#C0ABB3", "fontStyle": "italic" }
        },
        {
            "scope": ["string", "string.quoted"],
            "settings": { "foreground": "#DE72B3" }
        },
        {
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#E47C9F" }
        },
        {
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#4B90C0" }
        },
        {
            "scope": ["keyword.control"],
            "settings": { "foreground": "#F07BA2" }
        },
        {
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#9B5DDC" }
        },
        {
            "scope": ["entity.name.class", "entity.name.type", "support.class"],
            "settings": { "foreground": "#C769C7" }
        },
        {
            "scope": ["variable", "variable.other"],
            "settings": { "foreground": "#60575B" }
        },
        {
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#70676B" }
        },
        {
            "scope": ["constant", "constant.language"],
            "settings": { "foreground": "#E27DBD" }
        },
        {
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#8E7F87" }
        },
        { "scope": ["meta.brace"], "settings": { "foreground": "#68A2B8" } },
        {
            "scope": [
                "punctuation",
                "punctuation.definition.string",
                "punctuation.separator",
                "punctuation.terminator"
            ],
            "settings": { "foreground": "#6A83B8" }
        },
        {
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#E46690" }
        },
        {
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#C072C0" }
        },
        {
            "scope": ["support.type.property-name", "variable.other.property"],
            "settings": { "foreground": "#8A7D84" }
        },
        {
            "scope": ["support.type", "entity.name.type"],
            "settings": { "foreground": "#C072C0" }
        },
        {
            "scope": ["meta.decorator", "punctuation.decorator"],
            "settings": { "foreground": "#6BC3E0" }
        },
        { "scope": ["string.regexp"], "settings": { "foreground": "#4EA6C8" } },
        {
            "scope": ["markup.heading"],
            "settings": { "foreground": "#F07BA2", "fontStyle": "bold" }
        },
        { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
        { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
        {
            "scope": ["markup.inline.raw"],
            "settings": { "foreground": "#5EBBD8" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
