    "tokenColors": [
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "storage.type",
                "storage.modifier",
                "keyword.control"
            ],
            "settings": { "foreground": "#FF2D78", "fontStyle": "italic bold" }
        },
        {
            "name": "Strings",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#FFD6EC" }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call"
            ],
            "settings": { "foreground": "#D485F5", "fontStyle": "bold" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "variable.other"],
            "settings": { "foreground": "#FFFFFF" }
        },
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#5a3050", "fontStyle": "italic" }
        },
        {
            "name": "Numbers",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#FF79C6", "fontStyle": "bold" }
        },
        {
            "name": "Operators",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#FF2D78", "fontStyle": "bold" }
        },
        {
            "name": "Constants",
            "scope": ["constant.language", "support.constant"],
            "settings": { "foreground": "#FFB3DE", "fontStyle": "bold" }
        },
        {
            "name": "JS/TS Keywords",
            "scope": [
                "keyword.control.js",
                "keyword.control.ts",
                "storage.type.js",
                "storage.type.ts"
            ],
            "settings": { "foreground": "#FF2D78", "fontStyle": "italic bold" }
        },
        {
            "name": "JS/TS Functions",
            "scope": ["entity.name.function.js", "entity.name.function.ts"],
            "settings": { "foreground": "#D485F5", "fontStyle": "bold" }
        },
        {
            "name": "JS/TS Classes",
            "scope": [
                "entity.name.class.js",
                "entity.name.class.ts",
                "entity.name.type.ts"
            ],
            "settings": { "foreground": "#CF6BFF", "fontStyle": "bold" }
        },
        {
            "name": "JS/TS Arrow Functions",
            "scope": ["storage.type.function.arrow"],
            "settings": { "foreground": "#FF2D78", "fontStyle": "bold" }
        },
        {
            "name": "JS/TS Template Literals",
            "scope": ["string.template.js", "string.template.ts"],
            "settings": { "foreground": "#FFD6EC" }
        },
        {
            "name": "JS/TS Types",
            "scope": ["support.type.primitive.ts", "entity.name.type.ts"],
            "settings": { "foreground": "#CF6BFF" }
        },
        {
            "name": "JS/TS Decorators",
            "scope": ["meta.decorator.ts", "punctuation.decorator.ts"],
            "settings": { "foreground": "#FFB3DE", "fontStyle": "italic" }
        },
        {
            "name": "Python Keywords",
            "scope": ["keyword.control.python", "storage.type.function.python"],
            "settings": { "foreground": "#FF2D78", "fontStyle": "italic bold" }
        },
        {
            "name": "Python Functions",
            "scope": [
                "entity.name.function.python",
                "support.function.builtin.python"
            ],
            "settings": { "foreground": "#D485F5", "fontStyle": "bold" }
        },
        {
            "name": "Python Classes",
            "scope": ["entity.name.class.python"],
            "settings": { "foreground": "#CF6BFF", "fontStyle": "bold" }
        },
        {
            "name": "Python Self",
            "scope": ["variable.language.special.self.python"],
            "settings": { "foreground": "#FFB3DE", "fontStyle": "italic" }
        },
        {
            "name": "Python Decorators",
            "scope": ["entity.name.function.decorator.python"],
            "settings": { "foreground": "#FF79C6", "fontStyle": "italic bold" }
        },
        {
            "name": "Python Docstrings",
            "scope": ["string.quoted.docstring.multi.python"],
            "settings": { "foreground": "#7B3F6E", "fontStyle": "italic" }
        },
        {
            "name": "HTML Tags",
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#FF2D78", "fontStyle": "bold" }
        },
        {
            "name": "HTML Tag Punctuation",
            "scope": ["punctuation.definition.tag"],
            "settings": { "foreground": "#FF6EB4" }
        },
        {
            "name": "HTML Attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#FFB3DE" }
        },
        {
            "name": "HTML Attribute Values",
            "scope": ["string.quoted.double.html", "string.quoted.single.html"],
            "settings": { "foreground": "#FFD6EC" }
        },
        {
            "name": "HTML Doctype",
            "scope": ["meta.tag.sgml.doctype"],
            "settings": { "foreground": "#7B3F6E", "fontStyle": "italic" }
        },
        {
            "name": "HTML Text Content",
            "scope": ["text.html.basic"],
            "settings": { "foreground": "#FFFFFF" }
        },
        {
            "name": "CSS Properties",
            "scope": ["support.type.property-name.css"],
            "settings": { "foreground": "#D485F5" }
        },
        {
            "name": "CSS Values",
            "scope": [
                "support.constant.property-value.css",
                "constant.other.color.rgb-value.css"
            ],
            "settings": { "foreground": "#FFD6EC" }
        },
        {
            "name": "CSS Selectors",
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css"
            ],
            "settings": { "foreground": "#FF2D78", "fontStyle": "bold" }
        },
        {
            "name": "CSS Variables",
            "scope": [
                "variable.css",
                "variable.other.custom-property.name.css"
            ],
            "settings": { "foreground": "#CF6BFF" }
        },
        {
            "name": "Java/C Keywords",
            "scope": [
                "keyword.control.java",
                "keyword.control.cpp",
                "keyword.control.cs"
            ],
            "settings": { "foreground": "#FF2D78", "fontStyle": "italic bold" }
        },
        {
            "name": "Java/C Classes",
            "scope": [
                "entity.name.class.java",
                "entity.name.class.cpp",
                "entity.name.class.cs"
            ],
            "settings": { "foreground": "#CF6BFF", "fontStyle": "bold" }
        },
        {
            "name": "Java/C Functions",
            "scope": [
                "entity.name.function.java",
                "entity.name.function.cpp",
                "entity.name.function.cs"
            ],
            "settings": { "foreground": "#D485F5", "fontStyle": "bold" }
        },
        {
            "name": "Java Annotations",
            "scope": ["storage.type.annotation.java", "meta.attribute.cs"],
            "settings": { "foreground": "#FFB3DE", "fontStyle": "italic" }
        },
        {
            "name": "JSON Keys",
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#FF2D78", "fontStyle": "bold" }
        },
        {
            "name": "JSON String Values",
            "scope": ["string.quoted.double.json"],
            "settings": { "foreground": "#FFD6EC" }
        },
        {
            "name": "JSON Numbers",
            "scope": ["constant.numeric.json"],
            "settings": { "foreground": "#FF79C6", "fontStyle": "bold" }
        },
        {
            "name": "JSON Booleans",
            "scope": ["constant.language.json"],
            "settings": { "foreground": "#D485F5", "fontStyle": "bold" }
        },
        {
            "name": "JSON Null",
            "scope": ["constant.language.null.json"],
            "settings": { "foreground": "#FFB3DE", "fontStyle": "italic bold" }
        },
        {
            "name": "JSON Punctuation Brackets",
            "scope": [
                "punctuation.definition.dictionary.begin.json",
                "punctuation.definition.dictionary.end.json"
            ],
            "settings": { "foreground": "#FF2D78", "fontStyle": "bold" }
        },
        {
            "name": "JSON Array Brackets",
            "scope": [
                "punctuation.definition.array.begin.json",
                "punctuation.definition.array.end.json"
            ],
            "settings": { "foreground": "#CF6BFF", "fontStyle": "bold" }
        },
        {
            "name": "JSON Colon & Comma",
            "scope": [
                "punctuation.separator.dictionary.key-value.json",
                "punctuation.separator.array.json"
            ],
            "settings": { "foreground": "#FF79C6" }
        },
        {
            "name": "JSON Key Quotes",
            "scope": [
                "punctuation.definition.string.begin.json",
                "punctuation.definition.string.end.json"
            ],
            "settings": { "foreground": "#FF2D78" }
        },
        {
            "name": "Shell Keywords",
            "scope": ["keyword.control.shell", "keyword.other.shell"],
            "settings": { "foreground": "#FF2D78", "fontStyle": "bold" }
        },
        {
            "name": "Shell Commands",
            "scope": [
                "support.function.builtin.shell",
