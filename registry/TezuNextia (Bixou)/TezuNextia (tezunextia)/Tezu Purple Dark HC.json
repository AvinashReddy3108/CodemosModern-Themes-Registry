{
    "name": "Tezu Purple Dark HC",
    "colors": {
        "editor.background": "#0d071a",
        "editor.foreground": "#ffffff",
        "editorLineNumber.foreground": "#8866cc",
        "editorLineNumber.activeForeground": "#bb99ff",
        "editor.selectionBackground": "#4a3080",
        "editor.selectionHighlightBackground": "#2d1850",
        "editor.findMatchBackground": "#6633cc",
        "editor.findMatchHighlightBackground": "#5522aa",
        "editorCursor.foreground": "#ff88cc",
        "editorWhitespace.foreground": "#5522aa",
        "editorIndentGuide.background": "#4a3080",
        "editorIndentGuide.activeBackground": "#6633cc",
        "editorGroupHeader.tabsBackground": "#050210",
        "tab.activeBackground": "#0d071a",
        "tab.inactiveBackground": "#050210",
        "tab.activeForeground": "#ffffff",
        "tab.inactiveForeground": "#bb99ff",
        "sideBar.background": "#050210",
        "sideBar.foreground": "#ddccff",
        "activityBar.background": "#020108",
        "activityBar.foreground": "#ccbbff",
        "statusBar.background": "#2a1555",
        "statusBar.foreground": "#ffffff",
        "titleBar.activeBackground": "#0d071a",
        "titleBar.activeForeground": "#ffffff",
        "panel.background": "#050210",
        "terminal.background": "#0d071a",
        "focusBorder": "#7733ff",
        "contrastBorder": "#9955ff",
        "editorGroup.border": "#6633ff",
        "editor.lineHighlightBorder": "#7733ff80",
        "editorWidget.border": "#7733ff",
        "panel.border": "#6633ff",
        "sideBar.border": "#6633ff",
        "activityBar.border": "#5522cc",
        "statusBar.border": "#7733ff",
        "titleBar.border": "#6633ff",
        "tab.border": "#5522cc",
        "tab.activeBorder": "#7733ff",
        "input.border": "#7733ff",
        "dropdown.border": "#7733ff",
        "list.focusOutline": "#7733ff"
    },
    "tokenColors": [
        { "scope": "emphasis", "settings": { "fontStyle": "italic" } },
        { "scope": "strong", "settings": { "fontStyle": "bold" } },
        {
            "scope": "meta.diff.header",
            "settings": { "foreground": "#7733ff" }
        },
        {
            "scope": "comment",
            "settings": { "foreground": "#aa99cc", "fontStyle": "italic" }
        },
        {
            "scope": "constant.language",
            "settings": { "foreground": "#ff88cc" }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.other.color.rgb-value",
                "constant.other.rgb-value",
                "support.constant.color"
            ],
            "settings": { "foreground": "#bbffdd" }
        },
        { "scope": "constant.regexp", "settings": { "foreground": "#ffaacc" } },
        { "scope": "entity.name.tag", "settings": { "foreground": "#ff88cc" } },
        {
            "scope": "entity.name.tag.css",
            "settings": { "foreground": "#ffdd88" }
        },
        {
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#bb88ff" }
        },
        {
            "scope": [
                "source.css entity.other.attribute-name",
                "source.css.less entity.other.attribute-name.id",
                "source.scss entity.other.attribute-name"
            ],
            "settings": { "foreground": "#ffdd88" }
        },
        { "scope": "invalid", "settings": { "foreground": "#ff6666" } },
        {
            "scope": "markup.underline",
            "settings": { "fontStyle": "underline" }
        },
        { "scope": "markup.bold", "settings": { "fontStyle": "bold" } },
        { "scope": "markup.heading", "settings": { "foreground": "#bb88ff" } },
        { "scope": "markup.italic", "settings": { "fontStyle": "italic" } },
        { "scope": "markup.inserted", "settings": { "foreground": "#bbffdd" } },
        { "scope": "markup.deleted", "settings": { "foreground": "#ffaacc" } },
        { "scope": "markup.changed", "settings": { "foreground": "#7733ff" } },
        { "scope": "meta.selector", "settings": { "foreground": "#ffdd88" } },
        {
            "name": "brackets of XML/HTML tags",
            "scope": ["punctuation.definition.tag"],
            "settings": { "foreground": "#bb99ff" }
        },
        {
            "scope": "meta.preprocessor",
            "settings": { "foreground": "#7733ff" }
        },
        {
            "scope": "meta.preprocessor.string",
            "settings": { "foreground": "#ffaacc" }
        },
        {
            "scope": "meta.preprocessor.numeric",
            "settings": { "foreground": "#bbffdd" }
        },
        {
            "scope": "meta.structure.dictionary.key.python",
            "settings": { "foreground": "#bb88ff" }
        },
        { "scope": "storage", "settings": { "foreground": "#ff88cc" } },
        { "scope": "storage.type", "settings": { "foreground": "#ff88cc" } },
        {
            "scope": "storage.modifier",
            "settings": { "foreground": "#ff88cc" }
        },
        { "scope": "string", "settings": { "foreground": "#bbffdd" } },
        { "scope": "string.tag", "settings": { "foreground": "#bbffdd" } },
        { "scope": "string.value", "settings": { "foreground": "#bbffdd" } },
        { "scope": "string.regexp", "settings": { "foreground": "#ffaacc" } },
        {
            "name": "JavaScript string interpolation ${}",
            "scope": [
                "punctuation.definition.template-expression.begin.js",
                "punctuation.definition.template-expression.begin.ts",
                "punctuation.definition.template-expression.end.ts",
                "punctuation.definition.template-expression.end.js"
            ],
            "settings": { "foreground": "#7733ff" }
        },
        {
            "scope": [
                "support.type.vendored.property-name",
                "support.type.property-name",
                "variable.css",
                "variable.scss",
                "variable.other.less"
            ],
            "settings": { "foreground": "#ffffff" }
        },
        { "scope": "keyword", "settings": { "foreground": "#ff88cc" } },
        { "scope": "keyword.control", "settings": { "foreground": "#ff88cc" } },
        {
            "scope": "keyword.operator",
            "settings": { "foreground": "#ffffff" }
        },
        {
            "scope": [
                "keyword.operator.new",
                "keyword.operator.expression",
                "keyword.operator.cast",
                "keyword.operator.sizeof",
                "keyword.operator.logical.python"
            ],
            "settings": { "foreground": "#ff88cc" }
        },
        {
            "scope": "keyword.other.unit",
            "settings": { "foreground": "#bbffdd" }
        },
        {
            "scope": "support.function.git-rebase",
            "settings": { "foreground": "#ffffff" }
        },
        {
            "scope": "constant.sha.git-rebase",
            "settings": { "foreground": "#bbffdd" }
        },
        {
            "name": "coloring of the Java import and package identifiers",
            "scope": [
                "storage.modifier.import.java",
                "variable.language.wildcard.java",
                "storage.modifier.package.java"
            ],
            "settings": { "foreground": "#ffffff" }
        },
        {
            "name": "coloring of the TS this",
            "scope": "variable.language.this",
            "settings": { "foreground": "#ff88cc" }
        },
        {
            "name": "Function declarations",
            "scope": [
                "entity.name.function",
                "support.function",
                "support.constant.handlebars"
            ],
            "settings": { "foreground": "#ffdd88" }
        },
        {
            "name": "Types declaration and references",
            "scope": [
                "meta.return-type",
                "support.class",
                "support.type",
                "entity.name.type",
                "entity.name.class",
                "source.cs storage.type"
            ],
            "settings": { "foreground": "#7733ff" }
        },
        {
            "name": "Types declaration and references, TS grammar specific",
            "scope": [
                "meta.type.cast.expr",
                "meta.type.new.expr",
                "support.constant.math",
                "support.constant.dom",
                "support.constant.json",
                "entity.other.inherited-class"
            ],
            "settings": { "foreground": "#7733ff" }
        },
        {
            "name": "Control flow keywords",
            "scope": "keyword.control",
            "settings": { "foreground": "#ff88cc" }
        },
        {
            "name": "Variable and parameter name",
            "scope": [
                "variable",
                "meta.definition.variable.name",
                "support.variable"
            ],
            "settings": { "foreground": "#bb88ff" }
        },
        {
            "name": "Object keys, TS grammar specific",
            "scope": [
                "meta.object-literal.key",
                "meta.object-literal.key entity.name.function"
            ],
            "settings": { "foreground": "#bb88ff" }
        },
        {
            "name": "CSS property value",
            "scope": [
                "support.constant.property-value",
                "support.constant.font-name",
                "support.constant.media-type",
                "support.constant.media",
                "constant.other.color.rgb-value",
                "constant.other.rgb-value",
                "support.constant.color"
            ],
            "settings": { "foreground": "#bbffdd" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
