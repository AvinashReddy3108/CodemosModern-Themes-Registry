{
    "name": "Tezu Blue Dark",
    "colors": {
        "editor.background": "#06131a",
        "editor.foreground": "#aaccee",
        "editorLineNumber.foreground": "#446688",
        "editorLineNumber.activeForeground": "#66aadd",
        "editor.selectionBackground": "#153350",
        "editor.selectionHighlightBackground": "#0f2a44",
        "editor.findMatchBackground": "#336699",
        "editor.findMatchHighlightBackground": "#4477aa",
        "editorCursor.foreground": "#00aaff",
        "editorWhitespace.foreground": "#336699",
        "editorIndentGuide.background": "#1a2633",
        "editorIndentGuide.activeBackground": "#336699",
        "editorGroupHeader.tabsBackground": "#0a1620",
        "tab.activeBackground": "#06131a",
        "tab.inactiveBackground": "#0a1620",
        "tab.activeForeground": "#aaccee",
        "tab.inactiveForeground": "#6688aa",
        "sideBar.background": "#0a1620",
        "sideBar.foreground": "#8baacf",
        "activityBar.background": "#0e1a26",
        "activityBar.foreground": "#99bbdd",
        "statusBar.background": "#0f2a44",
        "statusBar.foreground": "#ccddff",
        "titleBar.activeBackground": "#06131a",
        "titleBar.activeForeground": "#aaccee",
        "panel.background": "#0a1620",
        "terminal.background": "#06131a",
        "focusBorder": "#00aaff60",
        "editor.lineHighlightBorder": "#ffffff08"
    },
    "tokenColors": [
        { "scope": "emphasis", "settings": { "fontStyle": "italic" } },
        { "scope": "strong", "settings": { "fontStyle": "bold" } },
        {
            "scope": "meta.diff.header",
            "settings": { "foreground": "#00aaff" }
        },
        {
            "scope": "comment",
            "settings": { "foreground": "#6688aa", "fontStyle": "italic" }
        },
        {
            "scope": "constant.language",
            "settings": { "foreground": "#7799bb" }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.other.color.rgb-value",
                "constant.other.rgb-value",
                "support.constant.color"
            ],
            "settings": { "foreground": "#44ddaa" }
        },
        { "scope": "constant.regexp", "settings": { "foreground": "#dd7744" } },
        { "scope": "entity.name.tag", "settings": { "foreground": "#7799bb" } },
        {
            "scope": "entity.name.tag.css",
            "settings": { "foreground": "#ffaa77" }
        },
        {
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#99bbdd" }
        },
        {
            "scope": [
                "source.css entity.other.attribute-name",
                "source.css.less entity.other.attribute-name.id",
                "source.scss entity.other.attribute-name"
            ],
            "settings": { "foreground": "#ffaa77" }
        },
        { "scope": "invalid", "settings": { "foreground": "#ff6666" } },
        {
            "scope": "markup.underline",
            "settings": { "fontStyle": "underline" }
        },
        { "scope": "markup.bold", "settings": { "fontStyle": "bold" } },
        { "scope": "markup.heading", "settings": { "foreground": "#99bbdd" } },
        { "scope": "markup.italic", "settings": { "fontStyle": "italic" } },
        { "scope": "markup.inserted", "settings": { "foreground": "#44ddaa" } },
        { "scope": "markup.deleted", "settings": { "foreground": "#dd7744" } },
        { "scope": "markup.changed", "settings": { "foreground": "#00aaff" } },
        { "scope": "meta.selector", "settings": { "foreground": "#ffaa77" } },
        {
            "name": "brackets of XML/HTML tags",
            "scope": ["punctuation.definition.tag"],
            "settings": { "foreground": "#6688aa" }
        },
        {
            "scope": "meta.preprocessor",
            "settings": { "foreground": "#00aaff" }
        },
        {
            "scope": "meta.preprocessor.string",
            "settings": { "foreground": "#dd7744" }
        },
        {
            "scope": "meta.preprocessor.numeric",
            "settings": { "foreground": "#44ddaa" }
        },
        {
            "scope": "meta.structure.dictionary.key.python",
            "settings": { "foreground": "#99bbdd" }
        },
        { "scope": "meta.diff.range", "settings": { "foreground": "#7799bb" } },
        { "scope": "storage", "settings": { "foreground": "#7799bb" } },
        { "scope": "storage.type", "settings": { "foreground": "#00aaff" } },
        {
            "scope": "storage.modifier",
            "settings": { "foreground": "#7799bb" }
        },
        { "scope": "string", "settings": { "foreground": "#44ddaa" } },
        { "scope": "string.tag", "settings": { "foreground": "#44ddaa" } },
        {
            "scope": "string.other.link",
            "settings": { "foreground": "#44ddaa" }
        },
        { "scope": "string.regexp", "settings": { "foreground": "#dd7744" } },
        {
            "scope": "string.interpolated",
            "settings": { "foreground": "#44ddaa" }
        },
        { "scope": "string.template", "settings": { "foreground": "#44ddaa" } },
        {
            "scope": [
                "source.regexp",
                "string.regexp.character-class",
                "string.regexp.group",
                "string.regexp.quantifier"
            ],
            "settings": { "foreground": "#dd7744" }
        },
        {
            "scope": "support.function",
            "settings": { "foreground": "#ffaa77" }
        },
        {
            "scope": "support.constant",
            "settings": { "foreground": "#7799bb" }
        },
        { "scope": "support.type", "settings": { "foreground": "#00aaff" } },
        { "scope": "support.class", "settings": { "foreground": "#00aaff" } },
        {
            "scope": "support.variable",
            "settings": { "foreground": "#99bbdd" }
        },
        {
            "scope": "support.other.variable",
            "settings": { "foreground": "#99bbdd" }
        },
        { "scope": "variable", "settings": { "foreground": "#99bbdd" } },
        {
            "scope": "variable.parameter",
            "settings": { "foreground": "#ccddff" }
        },
        {
            "scope": "variable.language",
            "settings": { "foreground": "#7799bb" }
        },
        { "scope": "variable.other", "settings": { "foreground": "#99bbdd" } },
        { "scope": "keyword", "settings": { "foreground": "#7799bb" } },
        { "scope": "keyword.control", "settings": { "foreground": "#7799bb" } },
        {
            "scope": "keyword.operator",
            "settings": { "foreground": "#ccddff" }
        },
        {
            "scope": "keyword.other.special-method",
            "settings": { "foreground": "#ffaa77" }
        },
        {
            "scope": "keyword.other.unit",
            "settings": { "foreground": "#44ddaa" }
        },
        {
            "scope": "entity.name.function",
            "settings": { "foreground": "#ffaa77" }
        },
        {
            "scope": "entity.name.class",
            "settings": { "foreground": "#00aaff" }
        },
        {
            "scope": "entity.name.type",
            "settings": { "foreground": "#00aaff" }
        },
        {
            "scope": "entity.other.inherited-class",
            "settings": { "foreground": "#00aaff" }
        },
        {
            "scope": "punctuation.definition.comment",
            "settings": { "foreground": "#6688aa" }
        },
        {
            "scope": "punctuation.definition.string",
            "settings": { "foreground": "#44ddaa" }
        },
        {
            "scope": "punctuation.definition.variable",
            "settings": { "foreground": "#ccddff" }
        },
        {
            "scope": "punctuation.definition.string.begin.html",
            "settings": { "foreground": "#44ddaa" }
        },
        {
            "scope": "punctuation.definition.string.end.html",
            "settings": { "foreground": "#44ddaa" }
        },
        {
            "scope": "punctuation.section.embedded",
            "settings": { "foreground": "#ccddff" }
        },
        {
            "scope": "punctuation.separator.key-value",
            "settings": { "foreground": "#ccddff" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
