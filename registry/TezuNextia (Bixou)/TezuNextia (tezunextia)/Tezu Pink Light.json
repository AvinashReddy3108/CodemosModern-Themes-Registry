{
    "name": "Tezu Pink Light",
    "colors": {
        "editor.background": "#ffe6f7",
        "editor.foreground": "#351226",
        "editorLineNumber.foreground": "#a06674",
        "editorLineNumber.activeForeground": "#aa4455",
        "editor.selectionBackground": "#e8c7d7",
        "editor.selectionHighlightBackground": "#f5d5e5",
        "editor.findMatchBackground": "#d0a0ba",
        "editor.findMatchHighlightBackground": "#e0b0ca",
        "editorCursor.foreground": "#800036",
        "editorWhitespace.foreground": "#e0b0ca",
        "editorIndentGuide.background": "#e8c7d7",
        "editorIndentGuide.activeBackground": "#d0a0ba",
        "editorGroupHeader.tabsBackground": "#fff2f6",
        "tab.activeBackground": "#ffe6f7",
        "tab.inactiveBackground": "#fff2f6",
        "tab.activeForeground": "#351226",
        "tab.inactiveForeground": "#8b5469",
        "sideBar.background": "#fff2f6",
        "sideBar.foreground": "#48283c",
        "activityBar.background": "#fff7fa",
        "activityBar.foreground": "#58354c",
        "statusBar.background": "#eac7da",
        "statusBar.foreground": "#300f20",
        "titleBar.activeBackground": "#ffe6f7",
        "titleBar.activeForeground": "#351226",
        "panel.background": "#fff2f6",
        "terminal.background": "#ffe6f7",
        "focusBorder": "#ff00a6",
        "contrastBorder": "#cc0080",
        "editorGroup.border": "#ff33b8",
        "editor.lineHighlightBorder": "#ff00a640",
        "editorWidget.border": "#ff00a6",
        "panel.border": "#ff33b8",
        "sideBar.border": "#ff33b8",
        "activityBar.border": "#ff55c4",
        "statusBar.border": "#ff00a6",
        "titleBar.border": "#ff33b8",
        "tab.border": "#ff55c4",
        "tab.activeBorder": "#ff00a6",
        "input.border": "#ff00a6",
        "dropdown.border": "#ff00a6",
        "list.focusOutline": "#ff00a6"
    },
    "tokenColors": [
        { "scope": "emphasis", "settings": { "fontStyle": "italic" } },
        { "scope": "strong", "settings": { "fontStyle": "bold" } },
        {
            "scope": "meta.diff.header",
            "settings": { "foreground": "#ff00a6" }
        },
        {
            "scope": "comment",
            "settings": { "foreground": "#776870", "fontStyle": "italic" }
        },
        {
            "scope": "constant.language",
            "settings": { "foreground": "#d9424d" }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.other.color.rgb-value",
                "constant.other.rgb-value",
                "support.constant.color"
            ],
            "settings": { "foreground": "#10aa55" }
        },
        { "scope": "constant.regexp", "settings": { "foreground": "#c7457a" } },
        { "scope": "entity.name.tag", "settings": { "foreground": "#d9424d" } },
        {
            "scope": "entity.name.tag.css",
            "settings": { "foreground": "#cc6600" }
        },
        {
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#bb6655" }
        },
        {
            "scope": [
                "source.css entity.other.attribute-name",
                "source.css.less entity.other.attribute-name.id",
                "source.scss entity.other.attribute-name"
            ],
            "settings": { "foreground": "#cc6600" }
        },
        { "scope": "invalid", "settings": { "foreground": "#dd0000" } },
        {
            "scope": "markup.underline",
            "settings": { "fontStyle": "underline" }
        },
        { "scope": "markup.bold", "settings": { "fontStyle": "bold" } },
        { "scope": "markup.heading", "settings": { "foreground": "#bb6655" } },
        { "scope": "markup.italic", "settings": { "fontStyle": "italic" } },
        { "scope": "markup.inserted", "settings": { "foreground": "#10aa55" } },
        { "scope": "markup.deleted", "settings": { "foreground": "#c7457a" } },
        { "scope": "markup.changed", "settings": { "foreground": "#ff00a6" } },
        { "scope": "meta.selector", "settings": { "foreground": "#cc6600" } },
        {
            "name": "brackets of XML/HTML tags",
            "scope": ["punctuation.definition.tag"],
            "settings": { "foreground": "#8b5469" }
        },
        {
            "scope": "meta.preprocessor",
            "settings": { "foreground": "#ff00a6" }
        },
        {
            "scope": "meta.preprocessor.string",
            "settings": { "foreground": "#c7457a" }
        },
        {
            "scope": "meta.preprocessor.numeric",
            "settings": { "foreground": "#10aa55" }
        },
        {
            "scope": "meta.structure.dictionary.key.python",
            "settings": { "foreground": "#bb6655" }
        },
        { "scope": "storage", "settings": { "foreground": "#d9424d" } },
        { "scope": "storage.type", "settings": { "foreground": "#d9424d" } },
        {
            "scope": "storage.modifier",
            "settings": { "foreground": "#d9424d" }
        },
        { "scope": "string", "settings": { "foreground": "#10aa55" } },
        { "scope": "string.tag", "settings": { "foreground": "#10aa55" } },
        { "scope": "string.value", "settings": { "foreground": "#10aa55" } },
        { "scope": "string.regexp", "settings": { "foreground": "#c7457a" } },
        {
            "name": "JavaScript string interpolation ${}",
            "scope": [
                "punctuation.definition.template-expression.begin.js",
                "punctuation.definition.template-expression.begin.ts",
                "punctuation.definition.template-expression.end.ts",
                "punctuation.definition.template-expression.end.js"
            ],
            "settings": { "foreground": "#ff00a6" }
        },
        {
            "scope": [
                "support.type.vendored.property-name",
                "support.type.property-name",
                "variable.css",
                "variable.scss",
                "variable.other.less"
            ],
            "settings": { "foreground": "#351226" }
        },
        { "scope": "keyword", "settings": { "foreground": "#d9424d" } },
        { "scope": "keyword.control", "settings": { "foreground": "#d9424d" } },
        {
            "scope": "keyword.operator",
            "settings": { "foreground": "#351226" }
        },
        {
            "scope": [
                "keyword.operator.new",
                "keyword.operator.expression",
                "keyword.operator.cast",
                "keyword.operator.sizeof",
                "keyword.operator.logical.python"
            ],
            "settings": { "foreground": "#d9424d" }
        },
        {
            "scope": "keyword.other.unit",
            "settings": { "foreground": "#10aa55" }
        },
        {
            "scope": "support.function.git-rebase",
            "settings": { "foreground": "#351226" }
        },
        {
            "scope": "constant.sha.git-rebase",
            "settings": { "foreground": "#10aa55" }
        },
        {
            "name": "coloring of the Java import and package identifiers",
            "scope": [
                "storage.modifier.import.java",
                "variable.language.wildcard.java",
                "storage.modifier.package.java"
            ],
            "settings": { "foreground": "#351226" }
        },
        {
            "name": "coloring of the TS this",
            "scope": "variable.language.this",
            "settings": { "foreground": "#d9424d" }
        },
        {
            "name": "Function declarations",
            "scope": [
                "entity.name.function",
                "support.function",
                "support.constant.handlebars"
            ],
            "settings": { "foreground": "#cc6600" }
        },
        {
            "name": "Types declaration and references",
            "scope": [
                "meta.return-type",
                "support.class",
                "support.type",
                "entity.name.type",
                "entity.name.class",
                "source.cs storage.type"
            ],
            "settings": { "foreground": "#ff00a6" }
        },
        {
            "name": "Types declaration and references, TS grammar specific",
            "scope": [
                "meta.type.cast.expr",
                "meta.type.new.expr",
                "support.constant.math",
                "support.constant.dom",
                "support.constant.json",
                "entity.other.inherited-class"
            ],
            "settings": { "foreground": "#ff00a6" }
        },
        {
            "name": "Control flow keywords",
            "scope": "keyword.control",
            "settings": { "foreground": "#d9424d" }
        },
        {
            "name": "Variable and parameter name",
            "scope": [
                "variable",
                "meta.definition.variable.name",
                "support.variable"
            ],
            "settings": { "foreground": "#bb6655" }
        },
        {
            "name": "Object keys, TS grammar specific",
            "scope": [
                "meta.object-literal.key",
                "meta.object-literal.key entity.name.function"
            ],
            "settings": { "foreground": "#bb6655" }
        },
        {
            "name": "CSS property value",
            "scope": [
                "support.constant.property-value",
                "support.constant.font-name",
                "support.constant.media-type",
                "support.constant.media",
                "constant.other.color.rgb-value",
                "constant.other.rgb-value",
                "support.constant.color"
            ],
            "settings": { "foreground": "#10aa55" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
