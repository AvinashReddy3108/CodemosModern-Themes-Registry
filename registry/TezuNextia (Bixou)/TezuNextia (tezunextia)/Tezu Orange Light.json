{
    "name": "Tezu Orange Light",
    "colors": {
        "editor.background": "#ffeee6",
        "editor.foreground": "#351a0f",
        "editorLineNumber.foreground": "#a07466",
        "editorLineNumber.activeForeground": "#aa5544",
        "editor.selectionBackground": "#e8c7d2",
        "editor.selectionHighlightBackground": "#f5d5e0",
        "editor.findMatchBackground": "#d0a0b5",
        "editor.findMatchHighlightBackground": "#e0b0c5",
        "editorCursor.foreground": "#800020",
        "editorWhitespace.foreground": "#e0b0c5",
        "editorIndentGuide.background": "#e8c7d2",
        "editorIndentGuide.activeBackground": "#d0a0b5",
        "editorGroupHeader.tabsBackground": "#fff7f2",
        "tab.activeBackground": "#ffeee6",
        "tab.inactiveBackground": "#fff7f2",
        "tab.activeForeground": "#351a0f",
        "tab.inactiveForeground": "#8b5464",
        "sideBar.background": "#fff7f2",
        "sideBar.foreground": "#482837",
        "activityBar.background": "#fffaf7",
        "activityBar.foreground": "#583547",
        "statusBar.background": "#eac7d5",
        "statusBar.foreground": "#301020",
        "titleBar.activeBackground": "#ffeee6",
        "titleBar.activeForeground": "#351a0f",
        "panel.background": "#fff7f2",
        "terminal.background": "#ffeee6",
        "focusBorder": "#ff550060",
        "editor.lineHighlightBorder": "#00000008"
    },
    "tokenColors": [
        { "scope": "emphasis", "settings": { "fontStyle": "italic" } },
        { "scope": "strong", "settings": { "fontStyle": "bold" } },
        {
            "scope": "meta.diff.header",
            "settings": { "foreground": "#ff5500" }
        },
        {
            "scope": "comment",
            "settings": { "foreground": "#776875", "fontStyle": "italic" }
        },
        {
            "scope": "constant.language",
            "settings": { "foreground": "#d94248" }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.other.color.rgb-value",
                "constant.other.rgb-value",
                "support.constant.color"
            ],
            "settings": { "foreground": "#109955" }
        },
        { "scope": "constant.regexp", "settings": { "foreground": "#c7456b" } },
        { "scope": "entity.name.tag", "settings": { "foreground": "#d94248" } },
        {
            "scope": "entity.name.tag.css",
            "settings": { "foreground": "#cc7600" }
        },
        {
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#bb6644" }
        },
        {
            "scope": [
                "source.css entity.other.attribute-name",
                "source.css.less entity.other.attribute-name.id",
                "source.scss entity.other.attribute-name"
            ],
            "settings": { "foreground": "#cc7600" }
        },
        { "scope": "invalid", "settings": { "foreground": "#dd0000" } },
        {
            "scope": "markup.underline",
            "settings": { "fontStyle": "underline" }
        },
        { "scope": "markup.bold", "settings": { "fontStyle": "bold" } },
        { "scope": "markup.heading", "settings": { "foreground": "#bb6644" } },
        { "scope": "markup.italic", "settings": { "fontStyle": "italic" } },
        { "scope": "markup.inserted", "settings": { "foreground": "#109955" } },
        { "scope": "markup.deleted", "settings": { "foreground": "#c7456b" } },
        { "scope": "markup.changed", "settings": { "foreground": "#ff5500" } },
        { "scope": "meta.selector", "settings": { "foreground": "#cc7600" } },
        {
            "name": "brackets of XML/HTML tags",
            "scope": ["punctuation.definition.tag"],
            "settings": { "foreground": "#8b5464" }
        },
        {
            "scope": "meta.preprocessor",
            "settings": { "foreground": "#ff5500" }
        },
        {
            "scope": "meta.preprocessor.string",
            "settings": { "foreground": "#c7456b" }
        },
        {
            "scope": "meta.preprocessor.numeric",
            "settings": { "foreground": "#109955" }
        },
        {
            "scope": "meta.structure.dictionary.key.python",
            "settings": { "foreground": "#bb6644" }
        },
        { "scope": "storage", "settings": { "foreground": "#d94248" } },
        { "scope": "storage.type", "settings": { "foreground": "#d94248" } },
        {
            "scope": "storage.modifier",
            "settings": { "foreground": "#d94248" }
        },
        { "scope": "string", "settings": { "foreground": "#109955" } },
        { "scope": "string.tag", "settings": { "foreground": "#109955" } },
        { "scope": "string.value", "settings": { "foreground": "#109955" } },
        { "scope": "string.regexp", "settings": { "foreground": "#c7456b" } },
        {
            "name": "JavaScript string interpolation ${}",
            "scope": [
                "punctuation.definition.template-expression.begin.js",
                "punctuation.definition.template-expression.begin.ts",
                "punctuation.definition.template-expression.end.ts",
                "punctuation.definition.template-expression.end.js"
            ],
            "settings": { "foreground": "#ff5500" }
        },
        {
            "scope": [
                "support.type.vendored.property-name",
                "support.type.property-name",
                "variable.css",
                "variable.scss",
                "variable.other.less"
            ],
            "settings": { "foreground": "#351a0f" }
        },
        { "scope": "keyword", "settings": { "foreground": "#d94248" } },
        { "scope": "keyword.control", "settings": { "foreground": "#d94248" } },
        {
            "scope": "keyword.operator",
            "settings": { "foreground": "#351a0f" }
        },
        {
            "scope": [
                "keyword.operator.new",
                "keyword.operator.expression",
                "keyword.operator.cast",
                "keyword.operator.sizeof",
                "keyword.operator.logical.python"
            ],
            "settings": { "foreground": "#d94248" }
        },
        {
            "scope": "keyword.other.unit",
            "settings": { "foreground": "#109955" }
        },
        {
            "scope": "support.function.git-rebase",
            "settings": { "foreground": "#351a0f" }
        },
        {
            "scope": "constant.sha.git-rebase",
            "settings": { "foreground": "#109955" }
        },
        {
            "name": "coloring of the Java import and package identifiers",
            "scope": [
                "storage.modifier.import.java",
                "variable.language.wildcard.java",
                "storage.modifier.package.java"
            ],
            "settings": { "foreground": "#351a0f" }
        },
        {
            "name": "coloring of the TS this",
            "scope": "variable.language.this",
            "settings": { "foreground": "#d94248" }
        },
        {
            "name": "Function declarations",
            "scope": [
                "entity.name.function",
                "support.function",
                "support.constant.handlebars"
            ],
            "settings": { "foreground": "#cc7600" }
        },
        {
            "name": "Types declaration and references",
            "scope": [
                "meta.return-type",
                "support.class",
                "support.type",
                "entity.name.type",
                "entity.name.class",
                "source.cs storage.type"
            ],
            "settings": { "foreground": "#ff5500" }
        },
        {
            "name": "Types declaration and references, TS grammar specific",
            "scope": [
                "meta.type.cast.expr",
                "meta.type.new.expr",
                "support.constant.math",
                "support.constant.dom",
                "support.constant.json",
                "entity.other.inherited-class"
            ],
            "settings": { "foreground": "#ff5500" }
        },
        {
            "name": "Control flow keywords",
            "scope": "keyword.control",
            "settings": { "foreground": "#d94248" }
        },
        {
            "name": "Variable and parameter name",
            "scope": [
                "variable",
                "meta.definition.variable.name",
                "support.variable"
            ],
            "settings": { "foreground": "#bb6644" }
        },
        {
            "name": "Object keys, TS grammar specific",
            "scope": [
                "meta.object-literal.key",
                "meta.object-literal.key entity.name.function"
            ],
            "settings": { "foreground": "#bb6644" }
        },
        {
            "name": "CSS property value",
            "scope": [
                "support.constant.property-value",
                "support.constant.font-name",
                "support.constant.media-type",
                "support.constant.media",
                "constant.other.color.rgb-value",
                "constant.other.rgb-value",
                "support.constant.color"
            ],
            "settings": { "foreground": "#109955" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
