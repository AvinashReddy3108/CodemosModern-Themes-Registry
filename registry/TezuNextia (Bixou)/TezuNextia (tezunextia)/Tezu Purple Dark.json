{
    "name": "Tezu Purple Dark",
    "colors": {
        "editor.background": "#0d071a",
        "editor.foreground": "#e6e1ff",
        "editorLineNumber.foreground": "#6b5b8c",
        "editorLineNumber.activeForeground": "#9b8bb8",
        "editor.selectionBackground": "#2d1840",
        "editor.selectionHighlightBackground": "#1a0f2a",
        "editor.findMatchBackground": "#4a3070",
        "editor.findMatchHighlightBackground": "#3a2060",
        "editorCursor.foreground": "#ff6b9d",
        "editorWhitespace.foreground": "#3a2060",
        "editorIndentGuide.background": "#2d1840",
        "editorIndentGuide.activeBackground": "#4a3070",
        "editorGroupHeader.tabsBackground": "#080315",
        "tab.activeBackground": "#0d071a",
        "tab.inactiveBackground": "#080315",
        "tab.activeForeground": "#e6e1ff",
        "tab.inactiveForeground": "#9b8bb8",
        "sideBar.background": "#080315",
        "sideBar.foreground": "#c8b8e0",
        "activityBar.background": "#050210",
        "activityBar.foreground": "#b8a5d8",
        "statusBar.background": "#1a0f35",
        "statusBar.foreground": "#d5c7f0",
        "titleBar.activeBackground": "#0d071a",
        "titleBar.activeForeground": "#e6e1ff",
        "panel.background": "#080315",
        "terminal.background": "#0d071a",
        "focusBorder": "#5500ff60",
        "editor.lineHighlightBorder": "#ffffff08"
    },
    "tokenColors": [
        { "scope": "emphasis", "settings": { "fontStyle": "italic" } },
        { "scope": "strong", "settings": { "fontStyle": "bold" } },
        {
            "scope": "meta.diff.header",
            "settings": { "foreground": "#5500ff" }
        },
        {
            "scope": "comment",
            "settings": { "foreground": "#8a7ca8", "fontStyle": "italic" }
        },
        {
            "scope": "constant.language",
            "settings": { "foreground": "#ff6b9d" }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.other.color.rgb-value",
                "constant.other.rgb-value",
                "support.constant.color"
            ],
            "settings": { "foreground": "#9bffcd" }
        },
        { "scope": "constant.regexp", "settings": { "foreground": "#ff8fab" } },
        { "scope": "entity.name.tag", "settings": { "foreground": "#ff6b9d" } },
        {
            "scope": "entity.name.tag.css",
            "settings": { "foreground": "#ffc975" }
        },
        {
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#9966ff" }
        },
        {
            "scope": [
                "source.css entity.other.attribute-name",
                "source.css.less entity.other.attribute-name.id",
                "source.scss entity.other.attribute-name"
            ],
            "settings": { "foreground": "#ffc975" }
        },
        { "scope": "invalid", "settings": { "foreground": "#ff4757" } },
        {
            "scope": "markup.underline",
            "settings": { "fontStyle": "underline" }
        },
        { "scope": "markup.bold", "settings": { "fontStyle": "bold" } },
        { "scope": "markup.heading", "settings": { "foreground": "#9966ff" } },
        { "scope": "markup.italic", "settings": { "fontStyle": "italic" } },
        { "scope": "markup.inserted", "settings": { "foreground": "#9bffcd" } },
        { "scope": "markup.deleted", "settings": { "foreground": "#ff8fab" } },
        { "scope": "markup.changed", "settings": { "foreground": "#5500ff" } },
        { "scope": "meta.selector", "settings": { "foreground": "#ffc975" } },
        {
            "name": "brackets of XML/HTML tags",
            "scope": ["punctuation.definition.tag"],
            "settings": { "foreground": "#9b8bb8" }
        },
        {
            "scope": "meta.preprocessor",
            "settings": { "foreground": "#5500ff" }
        },
        {
            "scope": "meta.preprocessor.string",
            "settings": { "foreground": "#ff8fab" }
        },
        {
            "scope": "meta.preprocessor.numeric",
            "settings": { "foreground": "#9bffcd" }
        },
        {
            "scope": "meta.structure.dictionary.key.python",
            "settings": { "foreground": "#9966ff" }
        },
        { "scope": "storage", "settings": { "foreground": "#ff6b9d" } },
        { "scope": "storage.type", "settings": { "foreground": "#ff6b9d" } },
        {
            "scope": "storage.modifier",
            "settings": { "foreground": "#ff6b9d" }
        },
        { "scope": "string", "settings": { "foreground": "#9bffcd" } },
        { "scope": "string.tag", "settings": { "foreground": "#9bffcd" } },
        { "scope": "string.value", "settings": { "foreground": "#9bffcd" } },
        { "scope": "string.regexp", "settings": { "foreground": "#ff8fab" } },
        {
            "name": "JavaScript string interpolation ${}",
            "scope": [
                "punctuation.definition.template-expression.begin.js",
                "punctuation.definition.template-expression.begin.ts",
                "punctuation.definition.template-expression.end.ts",
                "punctuation.definition.template-expression.end.js"
            ],
            "settings": { "foreground": "#5500ff" }
        },
        {
            "scope": [
                "support.type.vendored.property-name",
                "support.type.property-name",
                "variable.css",
                "variable.scss",
                "variable.other.less"
            ],
            "settings": { "foreground": "#e6e1ff" }
        },
        { "scope": "keyword", "settings": { "foreground": "#ff6b9d" } },
        { "scope": "keyword.control", "settings": { "foreground": "#ff6b9d" } },
        {
            "scope": "keyword.operator",
            "settings": { "foreground": "#e6e1ff" }
        },
        {
            "scope": [
                "keyword.operator.new",
                "keyword.operator.expression",
                "keyword.operator.cast",
                "keyword.operator.sizeof",
                "keyword.operator.logical.python"
            ],
            "settings": { "foreground": "#ff6b9d" }
        },
        {
            "scope": "keyword.other.unit",
            "settings": { "foreground": "#9bffcd" }
        },
        {
            "scope": "support.function.git-rebase",
            "settings": { "foreground": "#e6e1ff" }
        },
        {
            "scope": "constant.sha.git-rebase",
            "settings": { "foreground": "#9bffcd" }
        },
        {
            "name": "coloring of the Java import and package identifiers",
            "scope": [
                "storage.modifier.import.java",
                "variable.language.wildcard.java",
                "storage.modifier.package.java"
            ],
            "settings": { "foreground": "#e6e1ff" }
        },
        {
            "name": "coloring of the TS this",
            "scope": "variable.language.this",
            "settings": { "foreground": "#ff6b9d" }
        },
        {
            "name": "Function declarations",
            "scope": [
                "entity.name.function",
                "support.function",
                "support.constant.handlebars"
            ],
            "settings": { "foreground": "#ffc975" }
        },
        {
            "name": "Types declaration and references",
            "scope": [
                "meta.return-type",
                "support.class",
                "support.type",
                "entity.name.type",
                "entity.name.class",
                "source.cs storage.type"
            ],
            "settings": { "foreground": "#5500ff" }
        },
        {
            "name": "Types declaration and references, TS grammar specific",
            "scope": [
                "meta.type.cast.expr",
                "meta.type.new.expr",
                "support.constant.math",
                "support.constant.dom",
                "support.constant.json",
                "entity.other.inherited-class"
            ],
            "settings": { "foreground": "#5500ff" }
        },
        {
            "name": "Control flow keywords",
            "scope": "keyword.control",
            "settings": { "foreground": "#ff6b9d" }
        },
        {
            "name": "Variable and parameter name",
            "scope": [
                "variable",
                "meta.definition.variable.name",
                "support.variable"
            ],
            "settings": { "foreground": "#9966ff" }
        },
        {
            "name": "Object keys, TS grammar specific",
            "scope": [
                "meta.object-literal.key",
                "meta.object-literal.key entity.name.function"
            ],
            "settings": { "foreground": "#9966ff" }
        },
        {
            "name": "CSS property value",
            "scope": [
                "support.constant.property-value",
                "support.constant.font-name",
                "support.constant.media-type",
                "support.constant.media",
                "constant.other.color.rgb-value",
                "constant.other.rgb-value",
                "support.constant.color"
            ],
            "settings": { "foreground": "#9bffcd" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
