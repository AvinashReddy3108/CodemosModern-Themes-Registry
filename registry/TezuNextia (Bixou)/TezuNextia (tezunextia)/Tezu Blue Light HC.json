{
    "name": "Tezu Blue Light HC",
    "colors": {
        "editor.background": "#e6f7ff",
        "editor.foreground": "#000000",
        "editorLineNumber.foreground": "#444444",
        "editorLineNumber.activeForeground": "#000000",
        "editor.selectionBackground": "#c7e8f7",
        "editor.selectionHighlightBackground": "#d5f5ff",
        "editor.findMatchBackground": "#a0d0ee",
        "editor.findMatchHighlightBackground": "#b0e0f0",
        "editorCursor.foreground": "#000000",
        "editorWhitespace.foreground": "#888888",
        "editorIndentGuide.background": "#cccccc",
        "editorIndentGuide.activeBackground": "#000000",
        "editorGroupHeader.tabsBackground": "#f2faff",
        "tab.activeBackground": "#e6f7ff",
        "tab.inactiveBackground": "#f2faff",
        "tab.activeForeground": "#000000",
        "tab.inactiveForeground": "#444444",
        "sideBar.background": "#f2faff",
        "sideBar.foreground": "#000000",
        "activityBar.background": "#f7fcff",
        "activityBar.foreground": "#000000",
        "statusBar.background": "#c7e8f5",
        "statusBar.foreground": "#000000",
        "titleBar.activeBackground": "#e6f7ff",
        "titleBar.activeForeground": "#000000",
        "panel.background": "#f2faff",
        "terminal.background": "#e6f7ff",
        "focusBorder": "#00aaff",
        "contrastBorder": "#000000",
        "editorGroup.border": "#000000",
        "editor.lineHighlightBorder": "#00000040",
        "editorWidget.border": "#000000",
        "panel.border": "#000000",
        "sideBar.border": "#000000",
        "activityBar.border": "#000000",
        "statusBar.border": "#000000",
        "titleBar.border": "#000000",
        "tab.border": "#000000",
        "tab.activeBorder": "#000000",
        "input.border": "#000000",
        "dropdown.border": "#000000",
        "list.focusOutline": "#000000"
    },
    "tokenColors": [
        {
            "scope": "comment",
            "settings": { "foreground": "#666666", "fontStyle": "italic" }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.other.color.rgb-value",
                "constant.other.rgb-value",
                "support.constant.color"
            ],
            "settings": { "foreground": "#000000" }
        },
        { "scope": "string", "settings": { "foreground": "#000000" } },
        {
            "scope": "entity.name.function",
            "settings": { "foreground": "#000000" }
        },
        {
            "scope": "entity.name.class",
            "settings": { "foreground": "#000000" }
        },
        {
            "scope": "entity.name.type",
            "settings": { "foreground": "#000000" }
        },
        { "scope": "variable", "settings": { "foreground": "#000000" } },
        { "scope": "keyword", "settings": { "foreground": "#000000" } },
        { "scope": "entity.name.tag", "settings": { "foreground": "#000000" } },
        { "scope": "invalid", "settings": { "foreground": "#ff0000" } }
    ],
    "$schema": "vscode://schemas/color-theme"
}
