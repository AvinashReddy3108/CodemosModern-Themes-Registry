{
    "name": "Tezu Orange Light HC",
    "colors": {
        "editor.background": "#ffeee6",
        "editor.foreground": "#000000",
        "editorLineNumber.foreground": "#805544",
        "editorLineNumber.activeForeground": "#553322",
        "editor.selectionBackground": "#d8a7c2",
        "editor.selectionHighlightBackground": "#e5b5d0",
        "editor.findMatchBackground": "#c090a5",
        "editor.findMatchHighlightBackground": "#d0a0b5",
        "editorCursor.foreground": "#800020",
        "editorWhitespace.foreground": "#d0a0b5",
        "editorIndentGuide.background": "#d8a7c2",
        "editorIndentGuide.activeBackground": "#c090a5",
        "editorGroupHeader.tabsBackground": "#fff4e8",
        "tab.activeBackground": "#ffeee6",
        "tab.inactiveBackground": "#fff4e8",
        "tab.activeForeground": "#000000",
        "tab.inactiveForeground": "#6b3454",
        "sideBar.background": "#fff4e8",
        "sideBar.foreground": "#281827",
        "activityBar.background": "#ffefe8",
        "activityBar.foreground": "#382537",
        "statusBar.background": "#daa7c5",
        "statusBar.foreground": "#000000",
        "titleBar.activeBackground": "#ffeee6",
        "titleBar.activeForeground": "#000000",
        "panel.background": "#fff4e8",
        "terminal.background": "#ffeee6",
        "focusBorder": "#cc4400",
        "contrastBorder": "#aa3300",
        "editorGroup.border": "#cc4400",
        "editor.lineHighlightBorder": "#cc440060",
        "editorWidget.border": "#cc4400",
        "panel.border": "#cc4400",
        "sideBar.border": "#cc4400",
        "activityBar.border": "#ee6633",
        "statusBar.border": "#cc4400",
        "titleBar.border": "#cc4400",
        "tab.border": "#ee6633",
        "tab.activeBorder": "#cc4400",
        "input.border": "#cc4400",
        "dropdown.border": "#cc4400",
        "list.focusOutline": "#cc4400"
    },
    "tokenColors": [
        { "scope": "emphasis", "settings": { "fontStyle": "italic" } },
        { "scope": "strong", "settings": { "fontStyle": "bold" } },
        {
            "scope": "meta.diff.header",
            "settings": { "foreground": "#cc4400" }
        },
        {
            "scope": "comment",
            "settings": { "foreground": "#555555", "fontStyle": "italic" }
        },
        {
            "scope": "constant.language",
            "settings": { "foreground": "#cc1100" }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.other.color.rgb-value",
                "constant.other.rgb-value",
                "support.constant.color"
            ],
            "settings": { "foreground": "#006633" }
        },
        { "scope": "constant.regexp", "settings": { "foreground": "#991144" } },
        { "scope": "entity.name.tag", "settings": { "foreground": "#cc1100" } },
        {
            "scope": "entity.name.tag.css",
            "settings": { "foreground": "#bb4400" }
        },
        {
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#884422" }
        },
        {
            "scope": [
                "source.css entity.other.attribute-name",
                "source.css.less entity.other.attribute-name.id",
                "source.scss entity.other.attribute-name"
            ],
            "settings": { "foreground": "#bb4400" }
        },
        { "scope": "invalid", "settings": { "foreground": "#cc0000" } },
        {
            "scope": "markup.underline",
            "settings": { "fontStyle": "underline" }
        },
        { "scope": "markup.bold", "settings": { "fontStyle": "bold" } },
        { "scope": "markup.heading", "settings": { "foreground": "#884422" } },
        { "scope": "markup.italic", "settings": { "fontStyle": "italic" } },
        { "scope": "markup.inserted", "settings": { "foreground": "#006633" } },
        { "scope": "markup.deleted", "settings": { "foreground": "#991144" } },
        { "scope": "markup.changed", "settings": { "foreground": "#cc4400" } },
        { "scope": "meta.selector", "settings": { "foreground": "#bb4400" } },
        {
            "name": "brackets of XML/HTML tags",
            "scope": ["punctuation.definition.tag"],
            "settings": { "foreground": "#6b3454" }
        },
        {
            "scope": "meta.preprocessor",
            "settings": { "foreground": "#cc4400" }
        },
        {
            "scope": "meta.preprocessor.string",
            "settings": { "foreground": "#991144" }
        },
        {
            "scope": "meta.preprocessor.numeric",
            "settings": { "foreground": "#006633" }
        },
        {
            "scope": "meta.structure.dictionary.key.python",
            "settings": { "foreground": "#884422" }
        },
        { "scope": "storage", "settings": { "foreground": "#cc1100" } },
        { "scope": "storage.type", "settings": { "foreground": "#cc1100" } },
        {
            "scope": "storage.modifier",
            "settings": { "foreground": "#cc1100" }
        },
        { "scope": "string", "settings": { "foreground": "#006633" } },
        { "scope": "string.tag", "settings": { "foreground": "#006633" } },
        { "scope": "string.value", "settings": { "foreground": "#006633" } },
        { "scope": "string.regexp", "settings": { "foreground": "#991144" } },
        {
            "name": "JavaScript string interpolation ${}",
            "scope": [
                "punctuation.definition.template-expression.begin.js",
                "punctuation.definition.template-expression.begin.ts",
                "punctuation.definition.template-expression.end.ts",
                "punctuation.definition.template-expression.end.js"
            ],
            "settings": { "foreground": "#cc4400" }
        },
        {
            "scope": [
                "support.type.vendored.property-name",
                "support.type.property-name",
                "variable.css",
                "variable.scss",
                "variable.other.less"
            ],
            "settings": { "foreground": "#000000" }
        },
        { "scope": "keyword", "settings": { "foreground": "#cc1100" } },
        { "scope": "keyword.control", "settings": { "foreground": "#cc1100" } },
        {
            "scope": "keyword.operator",
            "settings": { "foreground": "#000000" }
        },
        {
            "scope": [
                "keyword.operator.new",
                "keyword.operator.expression",
                "keyword.operator.cast",
                "keyword.operator.sizeof",
                "keyword.operator.logical.python"
            ],
            "settings": { "foreground": "#cc1100" }
        },
        {
            "scope": "keyword.other.unit",
            "settings": { "foreground": "#006633" }
        },
        {
            "scope": "support.function.git-rebase",
            "settings": { "foreground": "#000000" }
        },
        {
            "scope": "constant.sha.git-rebase",
            "settings": { "foreground": "#006633" }
        },
        {
            "name": "coloring of the Java import and package identifiers",
            "scope": [
                "storage.modifier.import.java",
                "variable.language.wildcard.java",
                "storage.modifier.package.java"
            ],
            "settings": { "foreground": "#000000" }
        },
        {
            "name": "coloring of the TS this",
            "scope": "variable.language.this",
            "settings": { "foreground": "#cc1100" }
        },
        {
            "name": "Function declarations",
            "scope": [
                "entity.name.function",
                "support.function",
                "support.constant.handlebars"
            ],
            "settings": { "foreground": "#bb4400" }
        },
        {
            "name": "Types declaration and references",
            "scope": [
                "meta.return-type",
                "support.class",
                "support.type",
                "entity.name.type",
                "entity.name.class",
                "source.cs storage.type"
            ],
            "settings": { "foreground": "#cc4400" }
        },
        {
            "name": "Types declaration and references, TS grammar specific",
            "scope": [
                "meta.type.cast.expr",
                "meta.type.new.expr",
                "support.constant.math",
                "support.constant.dom",
                "support.constant.json",
                "entity.other.inherited-class"
            ],
            "settings": { "foreground": "#cc4400" }
        },
        {
            "name": "Control flow keywords",
            "scope": "keyword.control",
            "settings": { "foreground": "#cc1100" }
        },
        {
            "name": "Variable and parameter name",
            "scope": [
                "variable",
                "meta.definition.variable.name",
                "support.variable"
            ],
            "settings": { "foreground": "#884422" }
        },
        {
            "name": "Object keys, TS grammar specific",
            "scope": [
                "meta.object-literal.key",
                "meta.object-literal.key entity.name.function"
            ],
            "settings": { "foreground": "#884422" }
        },
        {
            "name": "CSS property value",
            "scope": [
                "support.constant.property-value",
                "support.constant.font-name",
                "support.constant.media-type",
                "support.constant.media",
                "constant.other.color.rgb-value",
                "constant.other.rgb-value",
                "support.constant.color"
            ],
            "settings": { "foreground": "#006633" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
