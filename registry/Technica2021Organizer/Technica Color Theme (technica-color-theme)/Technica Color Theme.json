        "terminal.ansiBrightRed": "#00FFFF",
        "terminal.ansiBrightWhite": "#FFFFFF",
        "terminal.ansiBrightYellow": "#FF7BAC",
        "terminal.ansiCyan": "#FFFFFF",
        "terminal.ansiGreen": "#2D2D2D",
        "terminal.ansiMagenta": "#FF7BAC",
        "terminal.ansiRed": "#00FFFF",
        "terminal.ansiWhite": "#FFFFFF",
        "terminal.ansiYellow": "#FF7BAC",
