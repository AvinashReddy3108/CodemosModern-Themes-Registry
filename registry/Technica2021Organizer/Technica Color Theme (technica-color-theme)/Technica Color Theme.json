        "tab.inactiveBackground": "#00000020",
        "tab.inactiveForeground": "#FF7BACaf",
        "tab.unfocusedActiveBorder": "#000000",
        "tab.unfocusedActiveBackground": "#00000040",
        "tab.unfocusedActiveForeground": "#FF7BAC",
        "tab.unfocusedInactiveBackground": "#00000010",
        "tab.unfocusedInactiveForeground": "#FF7BAC7f",
