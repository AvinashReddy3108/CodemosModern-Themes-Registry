    "tokenColors": [
        {
            "scope": "token.info-token",
            "settings": { "foreground": "#1d2e36" }
        },
        {
            "scope": "token.warn-token",
            "settings": { "foreground": "#ff7bac" }
        },
        {
            "scope": "token.error-token",
            "settings": { "foreground": "#e33c63" }
        },
        {
            "scope": "token.debug-token",
            "settings": { "foreground": "#1d2e36" }
        },
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#e4f7ff7f", "fontStyle": "italic" }
        },
        {
            "scope": ["variable", "identifier"],
            "settings": { "foreground": "#00c0bc", "fontStyle": "italic" }
        },
        { "scope": ["string"], "settings": { "foreground": "#e4f7ff" } },
        {
            "scope": [
                "constant.numeric",
                "constant.language",
                "support.constant",
                "constant.character",
                "constant.escape",
                "keyword.other.unit",
                "keyword.other",
                "constant.other.color",
                "punctuation.definition.constant.css"
            ],
            "settings": { "foreground": "#e4f7ff", "fontStyle": "bold" }
        },
        {
            "scope": ["type", "class"],
            "settings": { "foreground": "#00c0bc", "fontStyle": "bold" }
        },
        {
            "scope": [
                "function",
                "method",
                "entity.name.function",
                "meta.function-call",
                "variable.function",
                "support.function",
                "keyword.other.special-method"
            ],
            "settings": { "foreground": "#ff7bac", "fontStyle": "bold" }
        },
        {
            "scope": [
                "keyword",
                "storage",
                "meta.tag",
                "punctuation.definition",
                "punctuation.definition.tag",
                "punctuation.separator.inheritance.php",
                "punctuation.definition.tag.html",
                "punctuation.definition.tag.begin.html",
                "punctuation.definition.tag.end.html",
                "punctuation.section.embedded",
                "keyword.other.template",
                "keyword.other.substitution",
                "meta.property-value"
            ],
            "settings": { "foreground": "#ffc5da" }
        },
        {
            "scope": ["entity.name.tag", "meta.separator"],
            "settings": { "foreground": "#ff7bac", "fontStyle": "bold" }
        },
        {
            "scope": [
                "support.type.property-name",
                "meta.link.inline",
                "meta.image.inline"
            ],
            "settings": { "foreground": "#00c0bc", "fontStyle": "italic" }
        },
        { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
        { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
        {
            "name": "Python Token",
            "scope": ["source.python"],
            "settings": { "foreground": "#00c0bc" }
        },
        {
            "scope": ["invalid"],
            "settings": { "foreground": "#e33c63", "fontStyle": "bold" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
