        "gitDecoration.ignoredResourceForeground": "#003F2E",
        "gitDecoration.conflictingResourceForeground": "#deab35",
        "diffEditor.insertedTextBackground": "#FA8A4020",
        "diffEditor.removedTextBackground": "#9F9DAA50",
        "editorWidget.background": "#292826",
        "editorSuggestWidget.background": "#292826",
        "editorSuggestWidget.foreground": "#DAA190",
        "editorSuggestWidget.selectedBackground": "#272e2a",
        "editorHoverWidget.background": "#02090c",
        "editorHoverWidget.border": "#003F2E",
        "editorMarkerNavigation.background": "#292826",
        "peekView.border": "#272e2a",
        "peekViewEditor.background": "#02090c",
        "peekViewEditor.matchHighlightBackground": "#BE9B5C80",
        "peekViewResult.background": "#292826",
        "peekViewResult.fileForeground": "#DAA190",
        "peekViewResult.lineForeground": "#DAA190",
        "peekViewResult.matchHighlightBackground": "#BE9B5C80",
        "peekViewResult.selectionBackground": "#272e2a",
        "peekViewResult.selectionForeground": "#DAA190",
        "peekViewTitle.background": "#171616",
        "peekViewTitleDescription.foreground": "#003F2E",
        "peekViewTitleLabel.foreground": "#DAA190",
        "merge.currentHeaderBackground": "#FA8A4090",
        "merge.incomingHeaderBackground": "#37795690",
        "editorOverviewRuler.currentContentForeground": "#FA8A40",
        "editorOverviewRuler.incomingContentForeground": "#377956",
        "panel.background": "#02090c",
        "panel.border": "#377956",
        "panelTitle.activeBorder": "#5779b5",
        "panelTitle.activeForeground": "#DAA190",
        "panelTitle.inactiveForeground": "#003F2E",
        "statusBar.background": "#171616",
        "statusBar.foreground": "#DAA190",
        "statusBar.debuggingBackground": "#9F9DAA",
        "statusBar.debuggingForeground": "#171616",
        "statusBar.noFolderBackground": "#171616",
        "statusBar.noFolderForeground": "#DAA190",
        "statusBarItem.prominentBackground": "#9F9DAA",
        "statusBarItem.prominentHoverBackground": "#deab35",
        "statusBarItem.remoteForeground": "#DAA190",
        "statusBarItem.remoteBackground": "#377956",
        "titleBar.activeBackground": "#292826",
        "titleBar.activeForeground": "#DAA190",
        "titleBar.inactiveBackground": "#171616",
        "titleBar.inactiveForeground": "#003F2E",
        "notification.background": "#02090c",
        "notification.foreground": "#DAA190",
        "notification.buttonBackground": "#272e2a",
        "notification.buttonForeground": "#DAA190",
        "notification.buttonHoverBackground": "#44475A75",
        "notification.errorBackground": "#9F9DAA",
        "notification.errorForeground": "#DAA190",
        "notification.infoBackground": "#AA2366",
        "notification.infoForeground": "#02090c",
        "notification.warningBackground": "#deab35",
        "notification.warningForeground": "#02090c",
        "extensionButton.prominentForeground": "#DAA190",
        "extensionButton.prominentBackground": "#FA8A4090",
        "extensionButton.prominentHoverBackground": "#FA8A4060",
        "pickerGroup.border": "#377956",
        "pickerGroup.foreground": "#AA2366",
        "debugToolBar.background": "#292826",
        "walkThrough.embeddedEditorBackground": "#292826",
        "settings.headerForeground": "#DAA190",
        "settings.modifiedItemForeground": "#deab35",
        "settings.modifiedItemIndicator": "#deab35",
        "settings.dropdownBackground": "#292826",
        "settings.dropdownForeground": "#DAA190",
        "settings.dropdownBorder": "#171616",
        "settings.checkboxBackground": "#292826",
        "settings.checkboxForeground": "#DAA190",
        "settings.checkboxBorder": "#171616",
        "settings.textInputBackground": "#292826",
        "settings.textInputForeground": "#DAA190",
        "settings.textInputBorder": "#171616",
        "settings.numberInputBackground": "#292826",
        "settings.numberInputForeground": "#DAA190",
        "settings.numberInputBorder": "#171616",
        "breadcrumb.foreground": "#003F2E",
        "breadcrumb.background": "#02090c",
        "breadcrumb.focusForeground": "#DAA190",
        "breadcrumb.activeSelectionForeground": "#DAA190",
        "breadcrumbPicker.background": "#171616",
        "listFilterWidget.background": "#1f1e1e",
        "listFilterWidget.outline": "#262525",
        "listFilterWidget.noMatchesOutline": "#9F9DAA"
