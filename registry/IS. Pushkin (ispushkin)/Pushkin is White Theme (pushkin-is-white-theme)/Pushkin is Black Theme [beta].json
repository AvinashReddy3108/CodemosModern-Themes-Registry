{
    "type": "dark",
    "name": "Pushkin is Black",
    "tokenColors": [
        {
            "name": "String",
            "scope": [
                "string.quoted",
                "string.template",
                "source.css entity.other.attribute-name"
            ],
            "settings": { "foreground": "#fc3d7f" }
        },
        {
            "name": "Quotes",
            "scope": ["string.quoted punctuation.definition.string"],
            "settings": { "foreground": "#E08283" }
        },
        {
            "name": "String template",
            "scope": [
                "string.template punctuation.definition.template-expression",
                "punctuation.section.embedded"
            ],
            "settings": { "foreground": "#8757ad" }
        },
        {
            "name": "Variable template",
            "scope": [
                "string.template variable",
                "string.template entity",
                "meta.object-literal.key variable.other.readwrite",
                "source.elixir.embedded",
                "keyword.operator.arithmetic"
            ],
            "settings": { "foreground": "#F8F8F8" }
        },
        {
            "name": "String template quotes",
            "scope": ["string.template punctuation.definition.string.template"],
            "settings": { "foreground": "#c7254e" }
        },
        {
            "name": "Number",
            "scope": [
                "constant",
                "support.constant.property",
                "support.variable.object",
                "keyword.operator.ternary",
                "comment.wildcard"
            ],
            "settings": { "foreground": "#5cb4de" }
        },
        {
            "name": "Braces Array",
            "scope": [
                "meta.brace.square",
                "punctuation.definition.binding-pattern.array",
                "punctuation.section.array",
                "punctuation.definition.array"
            ],
            "settings": { "foreground": "#A5C261" }
        },
        {
            "name": "Array literal punctuation",
            "scope": ["meta.array.literal punctuation"],
            "settings": { "foreground": "#F9F9F9" }
        },
        {
            "name": "Braces object",
            "scope": [
                "meta.var meta.objectliteral punctuation.definition",
                "meta.object-binding-pattern-variable punctuation.definition",
                "meta.objectliteral punctuation.definition",
                "meta.import punctuation.definition",
                "punctuation.definition.binding-pattern.object",
                "meta.block meta.objectliteral punctuation.definition.block",
                "keyword.operator.spread",
                "punctuation.section.scope",
                "punctuation.section.property-list.begin.bracket.curly",
                "punctuation.definition.dictionary"
            ],
            "settings": { "foreground": "#BC9458" }
        },
        {
            "name": "Braces",
            "scope": [
                "meta.brace",
                "punctuation.definition",
                "punctuation.definition.parameters",
                "punctuation.terminator",
                "punctuation.accessor",
                "meta.objectliteral meta.block punctuation.definition.block",
                "punctuation.section.function"
            ],
            "settings": { "foreground": "#555555" }
        },
        {
            "name": "Punctuation",
            "scope": ["punctuation.definition.section"],
            "settings": { "foreground": "#F9F9F9" }
        },
        {
            "name": "Object literal",
            "scope": [
                "meta.object-literal.key",
                "source.css support.type.property-name",
                "support.type.vendored",
                "string punctuation.support.type.property-name",
                "entity.other.attribute-name",
                "punctuation.definition.entity"
            ],
            "settings": { "foreground": "#CC7833" }
        },
        {
            "name": "Object literal punctuation",
            "scope": ["meta.object-literal punctuation"],
            "settings": { "foreground": "#F9F9F9" }
        },
        {
            "name": "Object literal as func. arg",
            "scope": ["meta.function variable"],
            "settings": { "foreground": "#F9F9F9" }
        },
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#555555" }
        },
        {
            "name": "Keyword operator",
            "scope": ["keyword.operator.logical"],
            "settings": { "foreground": "#5cb4de" }
        },
        {
            "name": "Keyword controls",
            "scope": [
                "keyword.control",
                "storage.control",
                "storage.type",
                "keyword.operator.expression",
                "keyword.operator.new",
                "variable.language.this",
                "storage.modifier",
                "support.type.object",
                "keyword.other.unit"
            ],
            "settings": { "fontStyle": "bold", "foreground": "#555555" }
        },
        {
            "name": "Storage",
            "scope": [
                "punctuation.definition.block.tag.jsdoc",
                "storage.type.class.jsdoc"
            ],
            "settings": { "fontStyle": "bold", "foreground": "#708394" }
        },
        {
            "name": "Braces object",
            "scope": ["punctuation.definition.dictionary"],
            "settings": { "foreground": "#BC9458" }
        },
        {
            "name": "Braces array",
            "scope": ["punctuation.definition.array"],
            "settings": { "foreground": "#A5C261" }
        },
        {
            "name": "String type",
            "scope": [
                "source.rust keyword.other",
                "source.rust keyword.operator.misc"
            ],
            "settings": { "fontStyle": "bold", "foreground": "#555555" }
        },
        {
            "name": "Storage type",
            "scope": ["storage.type.core.rust"],
            "settings": { "fontStyle": "normal", "foreground": "#8757ad" }
        },
        {
            "name": "Storage modifier",
            "scope": ["storage.modifier.lifetime.rust"],
            "settings": { "fontStyle": "normal", "foreground": "#8757ad" }
        },
        {
            "name": "Entity name",
            "scope": ["storage.modifier.lifetime.rust entity.name"],
            "settings": { "fontStyle": "normal", "foreground": "#c7254e" }
        },
        {
            "name": "Keyword",
            "scope": ["source.php keyword.other"],
            "settings": { "fontStyle": "bold", "foreground": "#555555" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "text.html.php punctuation.section.embedded",
                "source.php punctuation.section.embedded",
                "source.php punctuation.separator.inheritance.php"
            ],
            "settings": { "fontStyle": "bold", "foreground": "#555555" }
        },
        {
            "name": "Variable",
            "scope": ["source.php punctuation.definition.variable.php"],
            "settings": { "fontStyle": "bold", "foreground": "#519F50" }
        },
        {
            "name": "Braces",
            "scope": ["source.php punctuation.section.scope"],
            "settings": { "foreground": "#555555" }
        },
        {
            "name": "Keyword",
            "scope": ["keyword.other.phpdoc.php"],
            "settings": { "fontStyle": "bold", "foreground": "#708394" }
        },
        {
            "name": "Braces CSS",
            "scope": ["source.css punctuation.section"],
            "settings": { "foreground": "#BC9458" }
        },
        {
            "name": "Integer",
            "scope": ["storage.type.primitive.java"],
            "settings": { "fontStyle": "normal", "foreground": "#5cb4de" }
        },
        {
            "name": "String",
            "scope": [
                "meta.method.identifier.java storage.type.java",
                "meta.definition.variable.java storage.type.java"
            ],
            "settings": { "fontStyle": "normal", "foreground": "#fc3d7f" }
        },
        {
            "name": "Keyword",
            "scope": ["source.java keyword.other"],
            "settings": { "fontStyle": "bold", "foreground": "#555555" }
        },
        {
            "name": "Import or Package args",
            "scope": [
                "source.java storage.modifier.package",
                "source.java storage.modifier.import"
            ],
            "settings": { "fontStyle": "normal", "foreground": "#F9F9F9" }
        },
        {
            "name": "Punctuation separator",
            "scope": ["source.java storage.modifier punctuation.separator"],
            "settings": { "fontStyle": "bold", "foreground": "#555555" }
        },
        {
            "name": "Method",
            "scope": ["meta.method.return-type.java storage.type.java"],
            "settings": { "fontStyle": "normal", "foreground": "#F9F9F9" }
        },
        {
            "name": "Storage",
            "scope": ["storage.type.java"],
            "settings": { "fontStyle": "normal", "foreground": "#F9F9F9" }
        },
        {
            "name": "Punctuation",
            "scope": ["punctuation.separator.period.java"],
            "settings": { "foreground": "#555555" }
        },
        {
            "name": "Braces",
            "scope": ["source.java punctuation.section"],
            "settings": { "foreground": "#555555" }
        },
        {
            "name": "Type keyword",
            "scope": ["keyword.type.cs"],
            "settings": { "foreground": "#FFB054" }
        },
        {
            "name": "Keyword",
            "scope": [
                "source.cs keyword.other",
                "source.cs keyword.preprocessor"
            ],
            "settings": { "fontStyle": "bold", "foreground": "#555555" }
        },
        {
            "name": "Braces",
            "scope": [
                "source.cs punctuation.parenthesis",
                "source.cs punctuation.curlybrace"
            ],
            "settings": { "foreground": "#555555" }
        },
        {
            "name": "Brackets square",
            "scope": ["source.cs punctuation.squarebracket"],
            "settings": { "foreground": "#A5C261" }
        },
        {
            "name": "String",
            "scope": ["source.cs string"],
            "settings": { "foreground": "#fc3d7f" }
        },
        {
            "name": "Punctuation separator",
            "scope": [],
            "settings": { "foreground": "#82AAFF" }
        },
        {
            "name": "Keyword import",
            "scope": ["source.fsharp namespace keyword"],
            "settings": { "fontStyle": "bold", "foreground": "#555555" }
        },
        {
            "name": "Keyword",
            "scope": [
                "source.fsharp keyword.other.binding",
                "source.fsharp keyword.other.access",
                "keyword.other.fsharp"
            ],
            "settings": { "fontStyle": "bold", "foreground": "#555555" }
        },
        {
            "name": "Keyword binding other",
            "scope": [],
            "settings": { "fontStyle": "normal", "foreground": "#F9F9F9" }
        },
        {
            "name": "Keyword function",
            "scope": [
                "source.fsharp keyword.other.function-recursive",
                "variable.other.binding.fsharp"
            ],
            "settings": { "foreground": "#FFB054" }
        },
        {
            "name": "Punctuation separator",
            "scope": ["source.fsharp punctuation.separator"],
            "settings": { "foreground": "#555555" }
        },
        {
            "name": "Keyword",
            "scope": [
                "source.python variable.language.special.self.python",
                "meta.function.decorator.python support.type.python"
            ],
            "settings": { "fontStyle": "bold", "foreground": "#555555" }
        },
        {
            "name": "List",
            "scope": ["source.python punctuation.definition.list"],
            "settings": { "foreground": "#A5C261" }
        },
        {
            "name": "String",
            "scope": ["source.racket string"],
            "settings": { "foreground": "#fc3d7f" }
        },
        {
            "name": "Vector",
            "scope": ["meta.vector punctuation.section.vector"],
            "settings": { "foreground": "#A5C261" }
        },
        {
            "name": "Map",
            "scope": ["meta.map punctuation.section.map"],
            "settings": { "foreground": "#BC9458" }
        },
