{
    "name": "Come Back to City",
    "colors": {
        "editor.background": "#1A1A1A",
        "editor.foreground": "#F8F8F2",
        "editor.selectionBackground": "#49483EAA",
        "editor.lineHighlightBackground": "#2A2A2A",
        "editorCursor.foreground": "#F8F8F0",
        "editor.lineHighlightBorder": "#00000000",
        "editorWhitespace.foreground": "#3B3A32",
        "editorIndentGuide.activeBackground": "#75715E",
        "editorIndentGuide.background": "#3B3A32",
        "sideBar.background": "#1A1A1A",
        "sideBar.foreground": "#F8F8F2",
        "activityBar.background": "#1A1A1A",
        "tab.activeBackground": "#1F1F1F",
        "tab.inactiveBackground": "#2E2E2E",
        "tab.activeBorder": "#F92672",
        "statusBar.background": "#1A1A1A",
        "statusBar.foreground": "#F8F8F2",
        "titleBar.activeBackground": "#1A1A1A",
        "titleBar.inactiveBackground": "#2E2E2E",
        "badge.background": "#F92672",
        "list.activeSelectionBackground": "#34342E",
        "list.inactiveSelectionBackground": "#2A2A2A",
        "list.hoverBackground": "#2D2D2D",
        "editorGutter.background": "#1A1A1A",
        "editorGutter.modifiedBackground": "#FD971F",
        "editorGutter.addedBackground": "#A6E22E",
        "editorGutter.deletedBackground": "#F92672"
    },
    "tokenColors": [
        {
            "scope": "comment",
            "settings": { "foreground": "#75715E", "fontStyle": "italic" }
        },
        {
            "scope": ["keyword", "storage.type", "keyword.control"],
            "settings": { "foreground": "#F92672", "fontStyle": "bold" }
        },
        {
            "scope": ["variable", "meta.definition.variable.name"],
            "settings": { "foreground": "#F8F8F2" }
        },
        { "scope": "string", "settings": { "foreground": "#E6DB74" } },
        {
            "scope": "constant.numeric",
            "settings": { "foreground": "#AE81FF" }
        },
        {
            "scope": ["entity.name.function", "meta.function-call"],
            "settings": { "foreground": "#A6E22E" }
        },
        {
            "scope": ["entity.name.tag", "meta.tag", "support.class.component"],
            "settings": { "foreground": "#F92672" }
        },
        {
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#FD971F" }
        },
        {
            "scope": ["support.function", "support.constant"],
            "settings": { "foreground": "#66D9EF" }
        },
        {
            "scope": "invalid",
            "settings": { "foreground": "#F8F8F0", "background": "#F92672" }
        },
        { "scope": "punctuation", "settings": { "foreground": "#F8F8F2" } },
        {
            "scope": "constant.language",
            "settings": { "foreground": "#AE81FF" }
        },
        { "scope": "markup.inserted", "settings": { "foreground": "#A6E22E" } },
        { "scope": "markup.deleted", "settings": { "foreground": "#F92672" } },
        { "scope": "markup.changed", "settings": { "foreground": "#FD971F" } },
        {
            "scope": "markup.inline.raw",
            "settings": { "foreground": "#66D9EF" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
