        },
        {
            "name": "Class, Support",
            "scope": ["support.class"],
            "settings": { "fontStyle": "bold", "foreground": "#F9AE57" }
        },
        {
            "name": "Entity Types",
            "scope": ["support.type"],
            "settings": { "foreground": "#d6b2b7" }
        },
