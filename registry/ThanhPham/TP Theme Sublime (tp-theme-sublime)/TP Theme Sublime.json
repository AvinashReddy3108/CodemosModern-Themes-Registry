                "operator",
                "definition",
                "readonly",
                "static",
                "deprecated",
                "abstract"
            ],
            "settings": { "foreground": "#ffff00" }
        },
        {
            "name": "Funcpython",
            "scope": ["entity.name.type.enum", "entity.name.function.member"],
            "settings": { "foreground": "#DCDCAA" }
        },
        {
            "name": "PHP Array Brackets ([])",
            "scope": [
                "punctuation.section.array.begin.bracket",
                "punctuation.section.array.end.bracket.square.php"
            ],
            "settings": { "foreground": "#00ff37" }
        },
        {
            "scope": [
                "constant.character.character-class.regexp",
                "constant.other.character-class.set.regexp",
                "constant.other.character-class.regexp",
                "constant.character.set.regexp"
            ],
            "settings": { "foreground": "#d16969" }
        },
        {
            "scope": "entity.name.label",
            "settings": { "foreground": "#b3ff00" }
        },
        {
            "name": "Square Brackets",
            "scope": ["punctuation.section.array"],
            "settings": { "foreground": "#d8d8d8" }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "newOperator": "#ff0101",
