    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "fontStyle": "italic", "foreground": "#0B6E8F" }
        },
        {
            "name": "Comment Keywords",
            "scope": ["comment-keywords"],
            "settings": { "foreground": "#FFBF7De8", "fontStyle": "bold" }
        },
        {
            "name": "Note Comment Keywords",
            "scope": ["comment-keywords.note"],
            "settings": {
                "foreground": "#0B6E8F",
                "fontStyle": "bold underline"
            }
        },
        {
            "name": "Text",
            "scope": ["source", "text"],
            "settings": { "foreground": "#91BDCC" }
        },
        {
            "name": "Operators",
