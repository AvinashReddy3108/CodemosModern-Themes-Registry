{
    "name": "Polar Paradise",
    "description": "❄️ Where penguins code! A refreshing light theme inspired by pristine Arctic landscapes, crystalline igloos, and our tuxedo-wearing friends. Featuring ice-crisp whites, glacier blues, and just a hint of penguin personality. Perfect for developers who keep their cool under pressure! 🐧",
    "version": "1.0.0",
    "author": "Hatem Soliman",
    "type": "light",
    "colors": {
        "editor.background": "#EEF3F9",
        "editor.foreground": "#2C3E50",
        "editor.lineHighlightBackground": "#E5EDF7",
        "editor.selectionBackground": "#D0E1F0",
        "editor.inactiveSelectionBackground": "#DCE8F3",
        "activityBar.background": "#C9E0F4",
        "activityBar.foreground": "#2C3E50",
        "activityBar.inactiveForeground": "#7FA7C9",
        "activityBarBadge.background": "#1B2F42",
        "activityBarBadge.foreground": "#FFFFFF",
        "sideBar.background": "#DBE8F4",
        "sideBar.foreground": "#2C3E50",
        "sideBarTitle.foreground": "#1B2F42",
        "sideBarSectionHeader.background": "#C9E0F4",
        "sideBarSectionHeader.foreground": "#2C3E50",
        "titleBar.activeBackground": "#C9E0F4",
        "titleBar.activeForeground": "#2C3E50",
        "titleBar.inactiveBackground": "#DBE8F4",
        "titleBar.inactiveForeground": "#7FA7C9",
        "tab.activeBackground": "#EEF3F9",
        "tab.inactiveBackground": "#DBE8F4",
        "tab.activeForeground": "#2C3E50",
        "tab.inactiveForeground": "#7FA7C9",
        "tab.activeBorderTop": "#4A90E2",
        "statusBar.background": "#C9E0F4",
        "statusBar.foreground": "#2C3E50",
        "statusBar.debuggingBackground": "#4A90E2",
        "input.background": "#FFFFFF",
        "input.foreground": "#2C3E50",
        "panel.background": "#DBE8F4",
        "panelTitle.activeForeground": "#2C3E50"
    },
    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#8CA6BE", "fontStyle": "italic" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "string constant.other.placeholder"],
            "settings": { "foreground": "#2C3E50" }
        },
        {
            "name": "Keywords and Control",
            "scope": [
                "keyword",
                "storage.type",
                "storage.modifier",
                "keyword.control"
            ],
            "settings": { "foreground": "#4A90E2" }
        },
        {
            "name": "Strings",
            "scope": [
                "string",
                "string.quoted.double.html",
                "string.quoted.single.html"
            ],
            "settings": { "foreground": "#3D7A5F" }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "meta.function-call",
                "variable.function",
                "support.function",
                "keyword.other.special-method"
            ],
            "settings": { "foreground": "#2E78C7" }
        },
        {
            "name": "Classes and Types",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "entity.other.inherited-class",
                "support.class"
            ],
            "settings": { "foreground": "#1B2F42" }
        },
        {
            "name": "Numbers and Constants",
            "scope": [
                "constant.numeric",
                "constant.language",
                "constant.character",
                "constant.escape"
            ],
            "settings": { "foreground": "#FF9B50" }
        },
        {
            "name": "Tags",
            "scope": ["entity.name.tag", "meta.tag.sgml"],
            "settings": { "foreground": "#4A90E2" }
        },
        {
            "name": "Attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#1B2F42", "fontStyle": "italic" }
        },
        {
            "name": "Markup Headings",
            "scope": ["markup.heading"],
            "settings": { "foreground": "#4A90E2", "fontStyle": "bold" }
        },
        {
            "name": "Markup Bold",
            "scope": ["markup.bold"],
            "settings": { "foreground": "#1B2F42", "fontStyle": "bold" }
        },
        {
            "name": "Markup Italic",
            "scope": ["markup.italic"],
            "settings": { "foreground": "#2E78C7", "fontStyle": "italic" }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "parameter": "#2C3E50",
        "property": "#3A5269",
        "type": "#1B2F42",
        "class": "#1B2F42",
        "enum": "#4A90E2",
        "interface": "#2E78C7",
        "typeParameter": "#FF9B50",
        "function": "#2E78C7",
        "method": "#2E78C7",
        "decorator": "#4A90E2",
        "regex": "#3D7A5F"
    },
    "$schema": "vscode://schemas/color-theme"
}
