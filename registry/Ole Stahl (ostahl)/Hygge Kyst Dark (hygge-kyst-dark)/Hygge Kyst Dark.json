    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#5E5A6E", "fontStyle": "italic" }
        },
        {
            "name": "Documentation Comments",
            "scope": ["comment.block.documentation", "string.quoted.docstring"],
            "settings": { "foreground": "#736A82", "fontStyle": "italic" }
        },
        {
            "name": "Strings",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#B4D0EC" }
        },
        {
            "name": "String Escape Characters",
            "scope": [
                "constant.character.escape",
                "string.quoted constant.character.escape"
            ],
            "settings": { "foreground": "#CCDCEB" }
        },
        {
            "name": "String Interpolation",
            "scope": [
                "meta.interpolation",
                "punctuation.section.interpolation",
                "punctuation.definition.template-expression"
            ],
            "settings": { "foreground": "#E8B8D4" }
        },
        {
            "name": "F-string Expression",
            "scope": [
                "source.python meta.fstring",
                "meta.fstring.python meta.embedded"
            ],
            "settings": { "foreground": "#ECE4EE" }
        },
        {
            "name": "Numbers",
            "scope": [
                "constant.numeric",
                "constant.numeric.integer",
                "constant.numeric.float",
                "constant.numeric.hex",
                "constant.numeric.octal",
                "constant.numeric.binary"
            ],
            "settings": { "foreground": "#B0B0EC" }
        },
        {
            "name": "Built-in Constants",
            "scope": ["constant.language", "constant.language.python"],
            "settings": { "foreground": "#B0B0EC" }
        },
        {
            "name": "Other Constants",
            "scope": ["constant.other", "constant.other.caps"],
            "settings": { "foreground": "#B0B0EC" }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.control.conditional",
                "keyword.control.loop",
                "keyword.control.flow"
            ],
            "settings": { "foreground": "#E8B8D4" }
        },
        {
            "name": "Keyword Operators",
            "scope": [
                "keyword.operator",
                "keyword.operator.logical",
                "keyword.operator.comparison",
                "keyword.operator.assignment",
                "keyword.operator.arithmetic"
            ],
            "settings": { "foreground": "#D8B4D8" }
        },
        {
            "name": "Python Specific Keywords",
            "scope": [
                "keyword.control.import.python",
                "keyword.control.from.python",
                "keyword.control.as.python"
            ],
            "settings": { "foreground": "#E8B8D4", "fontStyle": "italic" }
        },
        {
            "name": "Return, Yield, Raise",
            "scope": [
                "keyword.control.flow.return",
                "keyword.control.flow.yield",
                "keyword.control.flow.raise",
                "keyword.control.flow.break",
                "keyword.control.flow.continue"
            ],
            "settings": { "foreground": "#E8B8D4", "fontStyle": "italic" }
        },
        {
            "name": "Storage",
            "scope": ["storage", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#E8B8D4" }
        },
        {
            "name": "Class & Function Definition Keywords",
            "scope": [
                "storage.type.function",
                "storage.type.class",
                "keyword.control.def.python",
                "keyword.control.class.python"
            ],
            "settings": { "foreground": "#E8B8D4", "fontStyle": "italic" }
        },
        {
            "name": "Async/Await",
            "scope": [
                "storage.type.function.async",
                "keyword.control.flow.await"
            ],
            "settings": { "foreground": "#E8B8D4", "fontStyle": "italic" }
        },
        {
            "name": "Function Definitions",
            "scope": [
                "entity.name.function",
                "meta.function entity.name.function"
            ],
            "settings": { "foreground": "#CCCCEB" }
        },
        {
            "name": "Function Calls",
            "scope": [
                "meta.function-call entity.name.function",
                "meta.function-call.generic",
                "support.function",
                "support.function.builtin"
            ],
            "settings": { "foreground": "#CCCCEB" }
        },
        {
            "name": "Built-in Functions",
            "scope": [
                "support.function.builtin.python",
                "support.function.magic.python"
            ],
            "settings": { "foreground": "#B4D0EC" }
        },
        {
            "name": "Method Calls",
            "scope": [
                "meta.method-call entity.name.function",
                "meta.function-call.method"
            ],
            "settings": { "foreground": "#CCCCEB" }
        },
        {
            "name": "Lambda",
            "scope": [
                "storage.type.function.lambda",
                "keyword.control.flow.lambda"
            ],
            "settings": { "foreground": "#E8B8D4", "fontStyle": "italic" }
        },
        {
            "name": "Class Names",
            "scope": [
                "entity.name.class",
                "entity.name.type.class",
                "support.class"
            ],
            "settings": { "foreground": "#90B4EC" }
        },
        {
            "name": "Inherited Class",
            "scope": ["entity.other.inherited-class"],
            "settings": { "foreground": "#90B4EC", "fontStyle": "italic" }
        },
        {
            "name": "Type Hints",
            "scope": [
                "meta.function.parameters.python support.type",
                "meta.function.return-type support.type",
                "support.type.python"
            ],
            "settings": { "foreground": "#90B4EC" }
        },
        {
            "name": "Type Annotation Punctuation",
            "scope": [
                "punctuation.separator.annotation.python",
                "punctuation.separator.annotation.result.python"
            ],
            "settings": { "foreground": "#D8B4D8" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "variable.other", "variable.other.readwrite"],
            "settings": { "foreground": "#ECE4EE" }
        },
        {
            "name": "Function Parameters",
            "scope": [
                "variable.parameter",
                "meta.function.parameters variable.parameter"
            ],
            "settings": { "foreground": "#CCCCEB", "fontStyle": "italic" }
        },
        {
            "name": "Self/This",
            "scope": [
                "variable.language.self",
                "variable.language.this",
                "variable.language.special.self.python"
            ],
            "settings": { "foreground": "#E8B8D4", "fontStyle": "italic" }
        },
        {
            "name": "Special Variables",
            "scope": ["variable.language", "variable.language.python"],
            "settings": { "foreground": "#E8B8D4" }
        },
        {
            "name": "Object Properties",
            "scope": [
                "variable.other.property",
                "variable.other.object.property",
                "meta.attribute.python"
            ],
            "settings": { "foreground": "#90B4EC" }
        },
        {
            "name": "Decorators",
            "scope": [
                "entity.name.function.decorator",
                "meta.decorator",
                "punctuation.definition.decorator"
            ],
            "settings": { "foreground": "#E8B8D4" }
        },
        {
            "name": "Decorator @",
            "scope": ["punctuation.definition.decorator.python"],
            "settings": { "foreground": "#E8B8D4" }
        },
        {
            "name": "Operators",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#D8B4D8" }
        },
        {
            "name": "Arithmetic Operators",
            "scope": ["keyword.operator.arithmetic"],
            "settings": { "foreground": "#D8B4D8" }
        },
        {
            "name": "Comparison Operators",
            "scope": [
                "keyword.operator.comparison",
                "keyword.operator.logical"
            ],
            "settings": { "foreground": "#D8B4D8" }
        },
        {
            "name": "Assignment",
            "scope": ["keyword.operator.assignment"],
            "settings": { "foreground": "#D8B4D8" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation",
                "punctuation.separator",
                "punctuation.terminator"
            ],
            "settings": { "foreground": "#7A7088" }
        },
        {
            "name": "Brackets",
            "scope": [
                "punctuation.definition.list",
                "punctuation.definition.dict",
                "punctuation.parenthesis",
                "punctuation.bracket",
                "punctuation.section"
            ],
            "settings": { "foreground": "#A89EB4" }
        },
        {
            "name": "Magic Methods",
            "scope": [
                "support.function.magic.python",
                "support.variable.magic.python"
            ],
            "settings": { "foreground": "#B4D0EC", "fontStyle": "italic" }
        },
        {
            "name": "Dunder Variables",
            "scope": ["support.variable.magic.python"],
            "settings": { "foreground": "#B0B0EC", "fontStyle": "italic" }
        },
        {
            "name": "Exception Types",
            "scope": ["support.type.exception.python"],
            "settings": { "foreground": "#C89090" }
        },
        {
            "name": "Import Module Name",
            "scope": [
                "meta.import entity.name.import",
                "entity.name.import.go"
            ],
            "settings": { "foreground": "#90B4EC" }
        },
        {
            "name": "From Import Module",
            "scope": ["meta.statement.import.python entity.name.tag"],
            "settings": { "foreground": "#90B4EC" }
        },
        {
            "name": "Regex",
            "scope": ["string.regexp"],
            "settings": { "foreground": "#8A8A60" }
        },
        {
            "name": "Regex Character Classes",
            "scope": ["constant.other.character-class.regexp"],
            "settings": { "foreground": "#A8A878" }
        },
        {
            "name": "Regex Anchors",
            "scope": ["keyword.control.anchor.regexp"],
            "settings": { "foreground": "#D8B4D8" }
        },
        {
            "name": "Regex Groups",
            "scope": ["punctuation.definition.group.regexp"],
            "settings": { "foreground": "#E8B8D4" }
        },
        {
            "name": "JSON Keys",
            "scope": [
                "support.type.property-name.json",
                "string.json support.type.property-name"
            ],
            "settings": { "foreground": "#90B4EC" }
        },
        {
            "name": "YAML Keys",
            "scope": ["entity.name.tag.yaml"],
            "settings": { "foreground": "#90B4EC" }
        },
        {
            "name": "Markdown Headings",
            "scope": [
                "heading.1.markdown entity.name",
                "heading.2.markdown entity.name",
                "heading.3.markdown entity.name",
                "markup.heading"
            ],
            "settings": { "foreground": "#E8B8D4", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Bold",
            "scope": ["markup.bold"],
            "settings": { "foreground": "#E8B8D4", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Italic",
            "scope": ["markup.italic"],
            "settings": { "foreground": "#D8B4D8", "fontStyle": "italic" }
        },
        {
            "name": "Markdown Code",
            "scope": ["markup.inline.raw", "markup.fenced_code"],
            "settings": { "foreground": "#B4D0EC" }
        },
        {
            "name": "Markdown Links",
            "scope": ["markup.underline.link"],
            "settings": { "foreground": "#90B4EC" }
        },
        {
            "name": "Markdown Link Text",
            "scope": ["string.other.link.title.markdown"],
            "settings": { "foreground": "#CCCCEB" }
        },
        {
            "name": "Markdown Quote",
            "scope": ["markup.quote"],
            "settings": { "foreground": "#A89EB4", "fontStyle": "italic" }
        },
        {
            "name": "Markdown List",
            "scope": [
                "markup.list",
                "punctuation.definition.list.begin.markdown"
            ],
            "settings": { "foreground": "#E8B8D4" }
        },
        {
            "name": "HTML Tags",
            "scope": ["entity.name.tag.html", "entity.name.tag.xml"],
            "settings": { "foreground": "#E8B8D4" }
        },
        {
            "name": "HTML Attributes",
            "scope": [
                "entity.other.attribute-name.html",
                "entity.other.attribute-name.xml"
            ],
            "settings": { "foreground": "#D8B4D8" }
        },
        {
            "name": "CSS Selectors",
            "scope": [
                "entity.name.tag.css",
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css"
            ],
            "settings": { "foreground": "#90B4EC" }
        },
        {
            "name": "CSS Properties",
            "scope": ["support.type.property-name.css"],
            "settings": { "foreground": "#90B4EC" }
        },
        {
            "name": "CSS Values",
            "scope": ["support.constant.property-value.css"],
            "settings": { "foreground": "#E8B8D4" }
        },
        {
            "name": "CSS Units",
            "scope": ["keyword.other.unit.css"],
            "settings": { "foreground": "#B0B0EC" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#C89090", "fontStyle": "underline" }
        },
        {
            "name": "Deprecated",
            "scope": ["invalid.deprecated"],
            "settings": {
                "foreground": "#C4A878",
                "fontStyle": "strikethrough"
            }
        },
        {
            "name": "Entity Names",
            "scope": ["entity.name"],
            "settings": { "foreground": "#CCCCEB" }
        },
        {
            "name": "Namespace",
            "scope": ["entity.name.namespace", "entity.name.type.namespace"],
            "settings": { "foreground": "#90B4EC" }
        },
        {
            "name": "Support Other",
            "scope": ["support.other"],
            "settings": { "foreground": "#90B4EC" }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "function": "#CCCCEB",
        "function.declaration": "#CCCCEB",
        "function.builtin": "#B4D0EC",
        "method": "#CCCCEB",
        "method.declaration": "#CCCCEB",
        "class": "#90B4EC",
        "class.declaration": "#90B4EC",
        "parameter": { "foreground": "#CCCCEB", "fontStyle": "italic" },
        "variable": "#ECE4EE",
        "variable.readonly": "#B0B0EC",
        "property": "#90B4EC",
        "property.readonly": "#90B4EC",
        "type": "#90B4EC",
        "interface": "#90B4EC",
        "enum": "#90B4EC",
        "enumMember": "#B0B0EC",
        "namespace": "#90B4EC",
        "decorator": "#E8B8D4",
        "string": "#B4D0EC",
        "number": "#B0B0EC",
        "keyword": "#E8B8D4",
        "operator": "#D8B4D8",
        "comment": { "foreground": "#5E5A6E", "fontStyle": "italic" },
        "selfParameter": { "foreground": "#E8B8D4", "fontStyle": "italic" },
        "clsParameter": { "foreground": "#E8B8D4", "fontStyle": "italic" }
    },
    "$schema": "vscode://schemas/color-theme"
}
