{
    "$schema": "vscode://schemas/color-theme",
    "type": "light",
    "semanticHighlighting": true,
    "colors": {
        "foreground": "#444444",
        "selection.background": "#CCCCCC",
        "editor.background": "#EEEEEE",
        "editor.foreground": "#444444",
        "editorCursor.foreground": "#111111",
        "editor.selectionBackground": "#CCCCCC",
        "editor.inactiveSelectionBackground": "#CCCCCC",
        "editor.selectionHighlightBackground": "#CCCCCC",
        "diffEditor.insertedTextBackground": "#FFFFFF",
        "diffEditor.removedTextBackground": "#CCCCCC",
        "diffEditor.diagonalFill": "#888888"
    },
    "tokenColors": [
        { "scope": "emphasis", "settings": { "fontStyle": "italic" } },
        { "scope": "strong", "settings": { "fontStyle": "bold" } },
        {
            "name": "Underlined markup",
            "scope": "markup.underline",
            "settings": { "fontStyle": "underline" }
        },
        {
            "name": "Bold markup",
            "scope": "markup.bold",
            "settings": { "foreground": "#683824", "fontStyle": "bold" }
        },
        {
            "name": "Markup headings",
            "scope": ["markup.heading"],
            "settings": { "foreground": "#484069", "fontStyle": "bold" }
        },
        {
            "name": "Markup italic",
            "scope": "markup.italic",
            "settings": { "foreground": "#554600", "fontStyle": "italic" }
        },
        {
            "name": "Bullets, lists (prose)",
            "scope": [
                "beginning.punctuation.definition.list.markdown",
                "beginning.punctuation.definition.quote.markdown",
                "punctuation.definition.link.restructuredtext"
            ],
            "settings": { "foreground": "#234B69" }
        },
        {
            "name": "Inline code (prose)",
            "scope": ["markup.inline.raw", "markup.raw.restructuredtext"],
            "settings": { "foreground": "#2E502E" }
        },
        {
            "name": "Links (prose)",
            "scope": ["markup.underline.link", "markup.underline.link.image"],
            "settings": { "foreground": "#234B69" }
        },
        {
            "name": "Link text, image alt text (prose)",
            "scope": [
                "meta.link.reference.def.restructuredtext",
                "punctuation.definition.directive.restructuredtext",
                "string.other.link.description",
                "string.other.link.title"
            ],
            "settings": { "foreground": "#613651" }
        },
        {
            "name": "Blockquotes (prose)",
            "scope": ["entity.name.directive.restructuredtext", "markup.quote"],
            "settings": { "foreground": "#554600", "fontStyle": "italic" }
        },
        {
            "name": "Horizontal rule (prose)",
            "scope": "meta.separator.markdown",
            "settings": { "foreground": "#888888" }
        },
        {
            "name": "Code blocks",
            "scope": [
                "fenced_code.block.language",
                "markup.raw.inner.restructuredtext",
                "markup.fenced_code.block.markdown punctuation.definition.markdown"
            ],
            "settings": { "foreground": "#2E502E" }
        },
        {
            "name": "Prose constants",
            "scope": "punctuation.definition.constant.restructuredtext",
            "settings": { "foreground": "#484069" }
        },
        {
            "name": "Braces in markdown headings",
            "scope": [
                "markup.heading.markdown punctuation.definition.string.begin",
                "markup.heading.markdown punctuation.definition.string.end"
            ],
            "settings": { "foreground": "#484069" }
        },
        {
            "name": "Braces in markdown paragraphs",
            "scope": [
                "meta.paragraph.markdown punctuation.definition.string.begin",
                "meta.paragraph.markdown punctuation.definition.string.end"
            ],
            "settings": { "foreground": "#444444" }
        },
        {
            "name": "Braces in markdown blockquotes",
            "scope": [
                "markup.quote.markdown meta.paragraph.markdown punctuation.definition.string.begin",
                "markup.quote.markdown meta.paragraph.markdown punctuation.definition.string.end"
            ],
            "settings": { "foreground": "#554600" }
        },
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#888888" }
        },
        { "scope": "keyword", "settings": { "fontStyle": "bold" } },
        {
            "scope": ["storage.modifier", "storage.type.modifier"],
            "settings": { "foreground": "#234B69", "fontStyle": "bold" }
        },
        {
            "name": "Namespace keywords",
            "scope": "storage.type.namespace",
            "settings": { "foreground": "#111111", "fontStyle": "bold" }
        },
        {
            "name": "Class-key/enum keywords",
            "scope": [
                "storage.type.class",
                "storage.type.struct",
                "storage.type.union",
                "storage.type.enum"
            ],
            "settings": { "foreground": "#683824", "fontStyle": "bold" }
        },
        {
            "scope": "storage.type.template",
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Function keywords",
            "scope": "storage.type.function",
            "settings": { "foreground": "#111111", "fontStyle": "bold" }
        },
        {
            "name": "This/self parameter",
            "scope": [
                "variable.language.this",
                "variable.parameter.function.language.special.self"
            ],
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Control keywords",
            "scope": "keyword.control",
            "settings": { "foreground": "#234B69" }
        },
        {
            "name": "Return statement keywords",
            "scope": ["keyword.control.return", "keyword.control.throw"],
            "settings": { "foreground": "#683824" }
        },
        {
            "scope": ["keyword.operator", "entity.name.operator"],
            "settings": { "foreground": "#234B69", "fontStyle": "" }
        },
        {
            "scope": "storage.modifier.reference",
            "settings": { "fontStyle": "" }
        },
        {
            "scope": "constant.language",
            "settings": { "foreground": "#234B69", "fontStyle": "bold" }
        },
        {
            "name": "Numeric value",
            "scope": "constant.numeric",
            "settings": { "foreground": "#234B69" }
        },
        {
            "name": "String value",
            "scope": "string",
            "settings": { "foreground": "#2E502E" }
        },
        {
            "name": "Namespace name",
            "scope": ["entity.name.namespace"],
            "settings": { "foreground": "#554600" }
        },
        {
            "name": "Primitive type name",
            "scope": ["storage.type.primitive", "storage.type.built-in"],
            "settings": { "foreground": "#484069", "fontStyle": "bold" }
        },
        {
            "name": "User type name",
            "scope": ["entity.name.type"],
            "settings": { "foreground": "#484069" }
        },
        {
            "scope": "storage.type.return-type.lambda",
            "settings": { "foreground": "#484069" }
        },
        {
            "name": "Members name",
            "scope": [
                "entity.name.function.member",
                "variable.other.property",
                "variable.other.enummember"
            ],
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "Function parameter",
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#613651" }
        },
        {
            "name": "Keyword parameter of function",
            "scope": "variable.parameter.function-call",
            "settings": { "foreground": "#888888", "fontStyle": "bold" }
        },
        {
            "name": "Function parameter in definition",
            "scope": ["meta.function.definition.parameters variable.parameter"],
            "settings": { "fontStyle": "underline" }
        },
        {
            "scope": [
                "entity.name.function.preprocessor",
                "entity.name.function.macro"
            ],
            "settings": { "foreground": "#888888" }
        },
        {
            "scope": "entity.name.other.preprocessor.macro.predefined",
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Built-in function",
            "scope": "support.function.builtin",
            "settings": { "fontStyle": "bold" }
        },
        {
            "scope": ["keyword.operator.new", "keyword.operator.delete"],
            "settings": { "foreground": "#683824", "fontStyle": "bold" }
        },
        {
            "scope": ["keyword.other.using", "keyword.other.typedef"],
            "settings": { "foreground": "#683824" }
        },
        {
            "scope": [
                "keyword.other.default.constructor.cpp",
                "keyword.other.delete.constructor.cpp"
            ],
            "settings": { "foreground": "#234B69" }
        },
        {
            "scope": "keyword.other.operator.overload.cpp",
            "settings": { "foreground": "#234B69", "fontStyle": "" }
        },
        {
            "scope": "variable.parameter.preprocessor.cpp",
            "settings": { "fontStyle": "underline" }
        },
        {
            "scope": "keyword.operator.logical.python",
            "settings": { "fontStyle": "bold" }
        },
        {
            "scope": "punctuation.definition.decorator.python",
            "settings": { "foreground": "#888888" }
        },
        {
            "scope": "entity.name.function.decorator.python",
            "settings": { "foreground": "#888888", "fontStyle": "bold" }
        },
        {
            "scope": "keyword.control.new.java",
            "settings": { "foreground": "#683824" }
        },
        {
            "scope": "keyword.operator.instanceof.java",
            "settings": { "fontStyle": "bold" }
        },
        {
            "scope": "variable.language.java",
            "settings": { "fontStyle": "bold" }
        },
        {
            "scope": "storage.modifier.import.java",
            "settings": { "fontStyle": "" }
        },
        {
            "scope": "punctuation.definition.annotation.java",
            "settings": { "foreground": "#888888" }
        },
        {
            "scope": "storage.type.annotation.java",
            "settings": { "foreground": "#888888", "fontStyle": "bold" }
        },
        {
            "scope": "key.function.go",
            "settings": { "foreground": "#111111", "fontStyle": "bold" }
        },
        {
            "scope": "storage.type.boolean.go",
            "settings": { "foreground": "#234B69", "fontStyle": "bold" }
        },
        {
            "name": "HTML tags",
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#484069" }
        },
        {
            "name": "HTML/CSS attribute names",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#613651", "fontStyle": "italic" }
        },
        {
            "name": "CSS attribute parent selectors ('&')",
            "scope": ["entity.other.attribute-name.parent-selector"],
            "settings": { "foreground": "#484069" }
        },
        {
            "scope": "storage.type.js",
            "settings": { "foreground": "#234B69", "fontStyle": "bold" }
        },
        {
            "scope": "keyword.operator.expression",
            "settings": { "fontStyle": "bold" }
        },
        { "scope": "support.function.js", "settings": { "fontStyle": "bold" } },
        {
            "scope": "meta.directive.vue entity.other.attribute-name",
            "settings": { "fontStyle": "bold italic" }
        },
        {
            "scope": [
                "expression.embedded punctuation.definition.generic.begin",
                "expression.embedded punctuation.definition.generic.end"
            ],
            "settings": { "foreground": "#234B69" }
        },
        {
            "scope": [
                "entity.name.function.target.makefile",
                "entity.name.tag.yaml",
                "support.type.property-name.json"
            ],
            "settings": { "foreground": "#234B69" }
        }
    ],
    "semanticTokenColors": {
        "comment": { "foreground": "#888888" },
        "keyword": { "bold": true },
        "operator": { "foreground": "#234B69", "bold": false },
        "number": { "foreground": "#234B69" },
        "string": { "foreground": "#2E502E" },
        "regexp": { "foreground": "#683824" },
        "variable.builtin": { "bold": true },
        "namespace": { "foreground": "#554600" },
        "type": { "foreground": "#484069" },
        "class": { "foreground": "#484069" },
        "enum": { "foreground": "#484069" },
        "interface": { "foreground": "#484069" },
        "struct": { "foreground": "#484069" },
        "class.builtin": { "bold": true },
        "method": { "italic": true },
        "property": { "italic": true },
        "enumMember": { "italic": true },
        "method.static": { "italic": false },
        "property.static": { "italic": false },
        "parameter": { "foreground": "#613651" },
        "parameter.declaration": { "underline": true },
        "macro": { "foreground": "#888888" },
        "magicFunction:python": { "bold": true, "italic": true },
        "function.decorator:python": { "foreground": "#888888", "bold": true },
        "selfParameter:python": { "bold": true },
        "selfParameter.declaration:python": { "underline": false },
        "variable.declaration:python": { "underline": true },
        "annotation:java": { "foreground": "#888888", "bold": true },
        "variable.definition:go": { "underline": true },
        "variable.declaration:javascript": { "underline": true }
    }
}
