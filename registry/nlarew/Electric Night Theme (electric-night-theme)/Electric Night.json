{
    "name": "Electric Night",
    "type": "dark",
    "colors": {
        "editor.background": "#101010",
        "editor.foreground": "#f0f0f0",
        "editor.selectionBackground": "#5886b9",
        "editor.selectionHighlightBackground": "#76a0d8",
        "editor.selectionHighlightBorder": "#5886b9",
        "editor.inactiveSelectionBackground": "#0040A9",
        "editor.lineHighlightBackground": "#205070",
        "editorCursor.foreground": "#f0f0f0",
        "editorWhitespace.foreground": "#3e4c59",
        "editorLineNumber.foreground": "#616263",
        "editorLineNumber.activeForeground": "#a0aec0",
        "editor.findMatchBackground": "#101010",
        "editor.findMatchBorder": "#5886b9",
        "editor.findMatchHighlightBackground": "#5886b980",
        "editor.findMatchHighlightBorder": "#ffffff",
        "editor.findRangeHighlightBackground": "#54555e",
        "editor.hoverHighlightBackground": "#54555e",
        "editor.rangeHighlightBackground": "#54555e",
        "editor.wordHighlightBackground": "#54555e",
        "editor.wordHighlightStrongBackground": "#54555e",
        "activityBar.background": "#050505",
        "activityBar.foreground": "#ffffff",
        "activityBar.inactiveForeground": "#ffffff66",
        "activityBar.activeBorder": "#1565c0",
        "activityBarBadge.background": "#1565c0",
        "activityBarBadge.foreground": "#f0f0f0",
        "sideBar.background": "#050505",
        "sideBar.foreground": "#f0f0f0",
        "sideBarSectionHeader.background": "#1565c0",
        "sideBarSectionHeader.foreground": "#f0f0f0",
        "sideBarTitle.foreground": "#f0f0f0",
        "editorGroup.emptyBackground": "#101010",
        "editorGroup.dropBackground": "#232631",
        "editorGroupHeader.tabsBackground": "#101010",
        "tab.activeBackground": "#1565c0",
        "tab.activeForeground": "#f0f0f0",
        "tab.inactiveBackground": "#101010",
        "tab.inactiveForeground": "#f0f0f080",
        "tab.border": "#101010",
        "statusBar.background": "#1565c0",
        "statusBar.foreground": "#f0f0f0",
        "statusBar.noFolderBackground": "#1565c0",
        "statusBar.debuggingBackground": "#1565c0",
        "statusBarItem.activeBackground": "#448aff",
        "statusBarItem.hoverBackground": "#0d47a1",
        "panel.background": "#101010",
        "panel.border": "#292929",
        "panelTitle.activeForeground": "#f0f0f0",
        "panelTitle.inactiveForeground": "#f0f0f080",
        "terminal.background": "#101010",
        "terminal.foreground": "#eff0eb",
        "terminal.ansiBlack": "#282a36",
        "terminal.ansiBlue": "#57c7ff",
        "terminal.ansiBrightBlack": "#282a36",
        "terminal.ansiBrightBlue": "#57c7ff",
        "terminal.ansiBrightCyan": "#9aedfe",
        "terminal.ansiBrightGreen": "#5af78e",
        "terminal.ansiBrightMagenta": "#ff6ac1",
        "terminal.ansiBrightRed": "#ff5c57",
        "terminal.ansiBrightWhite": "#eff0eb",
        "terminal.ansiBrightYellow": "#f3f99d",
        "terminal.ansiCyan": "#9aedfe",
        "terminal.ansiGreen": "#5af78e",
        "terminal.ansiMagenta": "#ff6ac1",
        "terminal.ansiRed": "#ff5c57",
        "terminal.ansiWhite": "#eff0eb",
        "terminal.ansiYellow": "#f3f99d",
        "titleBar.activeBackground": "#050505",
        "titleBar.activeForeground": "#f0f0f0",
        "titleBar.inactiveBackground": "#050505",
        "titleBar.inactiveForeground": "#999999",
        "input.background": "#101010",
        "input.foreground": "#f0f0f0",
        "input.border": "#292929",
        "inputFocus.border": "#1565c0",
        "dropdown.background": "#101010",
        "dropdown.foreground": "#f0f0f0",
        "dropdown.border": "#292929",
        "editorWidget.background": "#222222",
        "editorWidget.border": "#292929",
        "editorHoverWidget.background": "#0e0e0e",
        "editorHoverWidget.border": "#01579B",
        "editorHoverWidget.foreground": "#f0f0f0",
        "editorSuggestWidget.background": "#0e0e0e",
        "editorSuggestWidget.border": "#01579B",
        "editorSuggestWidget.foreground": "#f0f0f0",
        "editorSuggestWidget.highlightForeground": "#2b93e9",
        "editorSuggestWidget.selectedBackground": "#2b93e9",
        "editorSuggestWidget.selectedForeground": "#0e0e0e",
        "editorSuggestWidget.focusHighlightForeground": "#11da11",
        "list.activeSelectionBackground": "#2b93e9",
        "list.activeSelectionForeground": "#0e0e0e",
        "list.inactiveSelectionBackground": "#404040",
        "list.inactiveSelectionForeground": "#11da11",
        "list.hoverBackground": "#01579B",
        "list.focusBackground": "#01579B",
        "list.focusHighlightForeground": "#11da11",
        "list.highlightForeground": "#11da11",
        "button.background": "#1565c0",
        "button.foreground": "#f0f0f0",
        "button.hoverBackground": "#0d47a1",
        "peekView.border": "#5af78e",
        "peekViewEditor.background": "#101010",
        "editorLink.activeForeground": "#ff5c57",
        "editorIndentGuide.background": "#616263"
    },
    "tokenColors": [
        {
            "name": "Global settings",
            "settings": { "background": "#101010", "foreground": "#eff0eb" }
        },
        {
            "name": "Strong",
            "scope": "strong, markup.bold",
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Emphasis",
            "scope": "emphasis, markup.italic",
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "Underline",
            "scope": "markup.underline",
            "settings": { "fontStyle": "underline" }
        },
        {
            "name": "Comment",
            "scope": "comment, punctuation.definition.comment, string.quoted.docstring",
            "settings": { "foreground": "#616263", "fontStyle": "italic" }
        },
        {
            "name": "Storage",
            "scope": "storage.type",
            "settings": { "foreground": "#f3f99d" }
        },
        {
            "name": "Type",
            "scope": "storage.type.primitive, support.type, entity.name.type, keyword.type, keyword.other.unit",
            "settings": { "foreground": "#9aedfe" }
        },
        {
            "name": "String",
            "scope": "string, meta.structure.dictionary.json string.quoted.double.json",
            "settings": { "foreground": "#5af78e" }
        },
        {
            "name": "Boolean",
            "scope": "constant.language.boolean",
            "settings": { "foreground": "#5af78e" }
        },
        {
            "name": "Number",
            "scope": "constant.numeric, support.constant",
            "settings": { "foreground": "#5af78e" }
        },
        {
            "name": "Null",
            "scope": "constant.language.null",
            "settings": { "foreground": "#5af78e" }
        },
        {
            "name": "Undefined",
            "scope": "constant.language.undefined",
            "settings": { "foreground": "#5af78e" }
        },
        {
            "name": "Function definition",
            "scope": "meta.function entity.name.function",
            "settings": { "foreground": "#57c7ff" }
        },
        {
            "name": "Function call",
            "scope": "entity.name.function, meta.function-call, support.function, keyword.other.special-method, meta.require, variable.language.super, keyword.other.get, keyword.other.set",
            "settings": { "foreground": "#57c7ff" }
        },
        {
            "name": "Identifier",
            "scope": "variable, support.variable, support.class, support.constant, meta.definition.variable entity.name.function",
            "settings": { "foreground": "#eff0eb" }
        },
        {
            "name": "Constants",
            "scope": "variable.other.constant.property",
            "settings": { "foreground": "#f3f99d" }
        },
        {
            "name": "Class",
            "scope": "entity.name.type.class",
            "settings": { "foreground": "#ff5c57" }
        },
        {
            "name": "Inherited class",
            "scope": "entity.other.inherited-class entity.name.type.module",
            "settings": { "foreground": "#ff5c57", "fontStyle": "italic" }
        },
        {
            "name": "Class variable",
            "scope": "variable.object.property",
            "settings": { "foreground": "#f3f99d" }
        },
        {
            "name": "Function argument",
            "scope": "variable.parameter",
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "Class method",
            "scope": "meta.definition.method entity.name.function",
            "settings": { "foreground": "#f3f99d" }
        },
        {
            "name": "Keyword",
            "scope": "keyword, modifier, storage.modifier, support.type.object, constant.language, variable.language.this, variable.language.special.self",
            "settings": { "foreground": "#ff6ac1" }
        },
        {
            "name": "Storage Modifier [e.g. class, extends, static] (JS)",
            "scope": "storage.modifier, storage.type.class.js, variable.language.this, variable.language.this.js",
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "Modules",
            "scope": "support.module, support.node",
            "settings": { "foreground": "#ff5c57", "fontStyle": "italic" }
        },
        {
            "name": "Template expression",
            "scope": "template.expression.begin, template.expression.end",
            "settings": { "foreground": "#ff6ac1" }
        },
        {
            "name": "Exception",
            "scope": "support.type.exception",
            "settings": { "foreground": "#f3f99d" }
        },
        {
            "name": "Diff insertion",
            "scope": "markup.inserted.diff, meta.diff.header.to-file",
            "settings": { "foreground": "#5af78e", "background": "#616263" }
        },
        {
            "name": "Diff deletion",
            "scope": "markup.deleted.diff, meta.diff.header.from-file",
            "settings": { "foreground": "#ff5c57", "background": "#616263" }
        },
        {
            "name": "C# class",
            "scope": "source.cs meta.class.identifier storage.type",
            "settings": { "foreground": "#ff5c57" }
        },
        {
            "name": "C# class method",
            "scope": "source.cs meta.method.identifier entity.name.function",
            "settings": { "foreground": "#f3f99d" }
        },
        {
            "name": "C# method call",
            "scope": "source.cs meta.method-call meta.method, source.cs entity.name.function",
            "settings": { "foreground": "#57c7ff" }
        },
        {
            "name": "C# type",
            "scope": "source.cs storage.type",
            "settings": { "foreground": "#f3f99d" }
        },
        {
            "name": "C# return type",
            "scope": "source.cs meta.method.return-type",
            "settings": { "foreground": "#9aedfe" }
        },
        {
            "name": "C# preprocessor",
            "scope": "source.cs meta.preprocessor",
            "settings": { "foreground": "#616263" }
        },
        {
            "name": "C# namespace",
            "scope": "source.cs entity.name.type.namespace",
            "settings": { "foreground": "#eff0eb" }
        },
        {
            "name": "CSS class",
            "scope": "entity.other.attribute-name.class",
            "settings": { "foreground": "#9aedfe" }
        },
        {
            "name": "CSS id",
            "scope": "entity.other.attribute-name.id",
            "settings": { "foreground": "#9aedfe" }
        },
        {
            "name": "CSS tag",
            "scope": "source.css entity.name.tag",
            "settings": { "foreground": "#f3f99d" }
        },
        {
            "name": "CSS property",
            "scope": "source.css support.type.property-name",
            "settings": { "foreground": "#ff5c57" }
        },
        {
            "name": "HTML tag outer",
            "scope": "meta.tag, punctuation.definition.tag",
            "settings": { "foreground": "#eff0eb" }
        },
        {
            "name": "HTML tag inner",
            "scope": "entity.name.tag",
            "settings": { "foreground": "#ff5c57" }
        },
        {
            "name": "HTML tag attribute",
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#f3f99d", "fontStyle": "italic" }
        },
        {
            "name": "HTML tag expression",
            "scope": "punctuation.section.embedded",
            "settings": { "foreground": "#ff5c57" }
        },
        {
            "name": "INI property name",
            "scope": "keyword.other.definition.ini",
            "settings": { "foreground": "#ff5c57" }
        },
        {
            "name": "INI section title",
            "scope": "entity.name.section.group-title.ini",
            "settings": { "foreground": "#57c7ff" }
        },
        {
            "name": "Java package & import",
            "scope": "source.java storage.modifier.package, source.java storage.modifier.import",
            "settings": { "foreground": "#eff0eb" }
        },
        {
            "name": "Java annotation",
            "scope": "source.java storage.type.annotation",
            "settings": { "foreground": "#ff5c57", "fontStyle": "italic" }
        },
        {
            "name": "Java method call",
            "scope": "source.java meta.method-call meta.method",
            "settings": { "foreground": "#57c7ff" }
        },
        {
            "name": "Java inner-class variable",
            "scope": "source.java meta.method-call meta.inner-class meta.method",
            "settings": { "foreground": "#eff0eb" }
        },
        {
            "name": "Java inner-class method call",
            "scope": "source.java meta.method-call meta.inner-class meta.method meta.method-call meta.method",
            "settings": { "foreground": "#57c7ff" }
        },
        {
            "name": "Java inner-class method",
            "scope": "source.java meta.definition.variable entity.name.function",
            "settings": { "foreground": "#57c7ff" }
        },
        {
            "name": "Java null",
            "scope": "source.java constant.language",
            "settings": { "foreground": "#5af78e" }
        },
        {
            "name": "Async",
            "scope": "source.js storage.modifier.async",
            "settings": { "foreground": "#ff6ac1" }
        },
        {
            "name": "JSON key",
            "scope": "meta.object-literal.key, meta.object-literal.key string, support.type.property-name.json",
            "settings": { "foreground": "#ff5c57" }
        },
        {
            "name": "JSON constant",
            "scope": "constant.language.json",
            "settings": { "foreground": "#ff6ac1" }
        },
        {
            "name": "Markdown heading",
            "scope": "markup.heading",
            "settings": { "foreground": "#57c7ff" }
        },
        {
            "name": "Markdown link text",
            "scope": "text.html.markdown meta.link.inline, meta.link.reference, markup.underline.link.image",
            "settings": { "foreground": "#ff5c57" }
        },
        {
            "name": "Markdown block quote",
            "scope": "text.html.markdown markup.quote",
            "settings": { "foreground": "#9aedfe" }
        },
        {
            "name": "Markdown list item",
            "scope": "text.html.markdown beginning.punctuation.definition.list",
            "settings": { "foreground": "#f3f99d" }
        },
        {
            "name": "Markdown code",
            "scope": "text.html.markdown markup.inline.raw",
            "settings": { "foreground": "#ff6ac1" }
        },
        {
            "name": "Markdown italic",
            "scope": "markup.italic",
            "settings": { "foreground": "#ff5c57", "fontStyle": "italic" }
        },
        {
            "name": "Markdown bold",
            "scope": "markup.bold",
            "settings": { "foreground": "#ff5c57", "fontStyle": "bold" }
        },
        {
            "name": "Markdown bold italic",
            "scope": "markup.bold markup.italic, markup.italic markup.bold",
            "settings": { "foreground": "#ff5c57", "fontStyle": "italic bold" }
        },
        {
            "name": "Python import *",
            "scope": "source.python keyword.operator.arithmetic",
            "settings": { "foreground": "#eff0eb" }
        },
        {
            "name": "Python def",
            "scope": "source.python meta.function storage.type.function",
            "settings": { "foreground": "#ff6ac1" }
        },
        {
            "name": "Python function arguments",
            "scope": "source.python meta.function-call.arguments",
            "settings": { "foreground": "#eff0eb" }
        },
        {
            "name": "Python function decorators",
            "scope": "source.python meta.function entity.name.function.decorator",
            "settings": { "foreground": "#ff5c57" }
        },
        {
            "name": "Python True & False & None",
            "scope": "source.python constant.language",
            "settings": { "foreground": "#5af78e" }
        },
        {
            "name": "YAML key",
            "scope": "entity.name.tag.yaml",
            "settings": { "foreground": "#ff5c57" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
