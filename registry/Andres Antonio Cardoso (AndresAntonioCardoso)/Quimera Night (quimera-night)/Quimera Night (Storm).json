    "semanticHighlighting": true,
    "semanticTokenColors": {
        "*.deprecated": {
            "foreground": "#556783",
            "fontStyle": "strikethrough"
        },
        "variable.readonly": { "foreground": "#e0af68" },
        "property.readonly": { "foreground": "#4fd6be" }
    },
    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#556783", "fontStyle": "italic" }
        },
        {
            "name": "Strings",
            "scope": ["string", "punctuation.definition.string"],
            "settings": { "foreground": "#a6f0c6" }
        },
        {
            "name": "Numbers",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#ffd166" }
        },
        {
            "name": "Keywords",
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#7aa2ff" }
        },
        {
            "name": "Control flow (TS/JS/Python)",
            "scope": [
                "keyword.control",
                "keyword.control.flow",
                "keyword.control.conditional",
                "keyword.control.loop",
                "keyword.control.import",
                "keyword.control.exception",
                "keyword.control.return",
                "keyword.control.trycatch",
                "keyword.control.async",
                "keyword.control.await"
            ],
            "settings": { "foreground": "#7aa2ff" }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call"
            ],
            "settings": { "foreground": "#5aa7ff" }
        },
        {
            "name": "Types",
            "scope": ["entity.name.type", "support.type", "support.class"],
            "settings": { "foreground": "#4fd6be" }
        },
        {
            "name": "Variables",
            "scope": [
                "variable",
                "meta.definition.variable.name",
                "entity.name.variable"
            ],
            "settings": { "foreground": "#c7d0e3" }
        },
        {
            "name": "Readonly (TextMate fallbacks)",
            "scope": [
                "storage.modifier.readonly",
                "storage.modifier.immutable"
            ],
            "settings": { "foreground": "#e0af68" }
        },
        {
            "name": "Constants",
            "scope": ["constant.language", "support.constant"],
            "settings": { "foreground": "#ff6b8a" }
        },
        {
            "name": "Deprecated",
            "scope": ["invalid.deprecated", "markup.deleted"],
            "settings": {
                "foreground": "#556783",
                "fontStyle": "strikethrough"
            }
        },
        {
            "name": "Operators and punctuation",
            "scope": [
                "keyword.operator",
                "punctuation",
                "meta.brace",
                "meta.delimiter"
            ],
            "settings": { "foreground": "#91a0be" }
        },
        {
            "name": "Properties",
            "scope": [
                "variable.other.property",
                "support.type.property-name",
                "meta.object-literal.key"
            ],
            "settings": { "foreground": "#4fd6be" }
        },
        {
            "name": "JSON keys",
            "scope": [
                "support.type.property-name.json",
                "support.type.property-name.jsonc"
            ],
            "settings": { "foreground": "#4fd6be" }
        },
        {
            "name": "Parameters",
            "scope": ["variable.parameter", "meta.function.parameters"],
            "settings": { "foreground": "#e0af68" }
        },
        {
            "name": "Classes and namespaces",
            "scope": [
                "entity.name.class",
                "entity.name.struct",
                "entity.name.namespace",
                "entity.name.module"
            ],
            "settings": { "foreground": "#4fd6be" }
        },
        {
            "name": "Tags",
            "scope": [
                "entity.name.tag",
                "entity.name.tag.jsx",
                "entity.name.tag.tsx"
            ],
            "settings": { "foreground": "#7aa2ff" }
        },
        {
            "name": "Attributes (HTML/JSX)",
            "scope": [
                "entity.other.attribute-name",
                "entity.other.attribute-name.jsx",
                "entity.other.attribute-name.tsx"
            ],
            "settings": { "foreground": "#4fd6be" }
        },
        {
            "name": "RegExp",
            "scope": ["string.regexp", "constant.character.escape"],
            "settings": { "foreground": "#bb9af7" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#ff6b8a", "fontStyle": "underline" }
        },
        {
            "name": "Markdown headings",
            "scope": ["markup.heading", "entity.name.section"],
            "settings": { "foreground": "#7aa2ff", "fontStyle": "bold" }
        },
        {
            "name": "Markdown inline and fenced code",
            "scope": [
                "markup.inline.raw",
                "markup.fenced_code.block",
                "markup.raw.block"
            ],
            "settings": { "foreground": "#a6f0c6" }
        },
        {
            "name": "Markdown links",
            "scope": ["markup.underline.link", "markup.underline.link.image"],
            "settings": { "foreground": "#5aa7ff", "fontStyle": "underline" }
        },
        {
            "name": "Python builtins and self",
            "scope": [
                "support.function.builtin.python",
                "support.type.python",
                "variable.language.special.self.python"
            ],
            "settings": { "foreground": "#5aa7ff" }
        }
    ]
}
