{
    "name": "Nebula Dark Muted",
    "type": "dark",
    "colors": {
        "editor.background": "#121212",
        "editor.foreground": "#e9ecef",
        "editor.selectionBackground": "#6f42c130",
        "editor.selectionHighlightBackground": "#6f42c120",
        "editor.lineHighlightBackground": "#1a1a1a",
        "editorCursor.foreground": "#6f42c1",
        "editorBracketMatch.background": "#6f42c120",
        "editorBracketMatch.border": "#6f42c1",
        "sideBar.background": "#151515",
        "sideBar.foreground": "#dee2e6",
        "activityBar.background": "#151515",
        "activityBar.foreground": "#6f42c1",
        "statusBar.background": "#1a1a1a",
        "statusBar.foreground": "#6f42c1",
        "terminal.background": "#1a1a1a",
        "terminal.foreground": "#e9ecef",
        "tab.activeBackground": "#121212",
        "tab.activeForeground": "#ffffff",
        "tab.inactiveBackground": "#151515",
        "tab.inactiveForeground": "#adb5bd",
        "button.background": "#6f42c1",
        "button.foreground": "#ffffff",
        "button.hoverBackground": "#5a32a3"
    },
    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#868e96", "fontStyle": "italic" }
        },
        {
            "name": "Strings",
            "scope": ["string", "punctuation.definition.string"],
            "settings": { "foreground": "#20c997", "fontStyle": "normal" }
        },
        {
            "name": "Numbers",
            "scope": ["constant.numeric", "constant.language.numeric"],
            "settings": { "foreground": "#ff8787" }
        },
        {
            "name": "Keywords",
            "scope": ["keyword", "keyword.control", "storage"],
            "settings": { "foreground": "#4dabf7", "fontStyle": "normal" }
        },
        {
            "name": "Functions",
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#ffa94d" }
        },
        {
            "name": "Classes & Types",
            "scope": ["entity.name.type.class", "support.class"],
            "settings": { "foreground": "#cc5de8" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "variable.parameter"],
            "settings": { "foreground": "#f8f9fa" }
        },
        {
            "name": "Brackets",
            "scope": ["punctuation", "meta.brace"],
            "settings": { "foreground": "#adb5bd" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
