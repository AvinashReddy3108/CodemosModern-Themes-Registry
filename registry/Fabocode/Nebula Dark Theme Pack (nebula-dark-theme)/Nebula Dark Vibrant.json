    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#6c757d", "fontStyle": "italic" }
        },
        {
            "name": "Strings",
            "scope": ["string", "punctuation.definition.string"],
            "settings": { "foreground": "#20c997" }
        },
        {
            "name": "Numbers",
            "scope": ["constant.numeric", "constant.language.numeric"],
            "settings": { "foreground": "#ff6b6b" }
        },
        {
            "name": "Keywords & Control Flow",
            "scope": ["keyword", "keyword.control", "storage", "storage.type"],
            "settings": { "foreground": "#339af0" }
        },
        {
            "name": "Functions & Methods",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call"
            ],
            "settings": { "foreground": "#ff922b" }
        },
        {
            "name": "Classes & Types",
            "scope": [
                "entity.name.type.class",
                "entity.name.type",
                "support.class",
                "support.type"
            ],
            "settings": { "foreground": "#da77f2" }
        },
        {
            "name": "Variables & Parameters",
            "scope": [
                "variable",
                "variable.parameter",
                "variable.other",
                "meta.parameter"
            ],
            "settings": { "foreground": "#f8f9fa" }
        },
        {
            "name": "Properties",
            "scope": ["variable.object.property", "support.variable.property"],
            "settings": { "foreground": "#e9ecef" }
        },
        {
            "name": "Brackets & Operators",
            "scope": ["punctuation", "keyword.operator", "meta.brace"],
            "settings": { "foreground": "#adb5bd" }
        },
        {
            "name": "Special & Constants",
            "scope": [
                "constant.language",
                "constant.other",
                "support.constant"
            ],
            "settings": { "foreground": "#da77f2" }
        },
        {
            "name": "Tags (HTML/JSX)",
            "scope": ["entity.name.tag", "punctuation.definition.tag"],
            "settings": { "foreground": "#ff6b6b" }
        },
        {
            "name": "Attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#ff922b" }
        },
        {
            "name": "CSS Properties",
            "scope": ["support.type.property-name.css"],
            "settings": { "foreground": "#20c997" }
        },
        {
            "name": "JSON Keys",
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#339af0" }
        },
        {
            "name": "Markdown Headers",
            "scope": ["markup.heading"],
            "settings": { "foreground": "#6610f2", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Links",
            "scope": ["markup.underline.link"],
            "settings": { "foreground": "#20c997", "fontStyle": "underline" }
        },
        {
            "name": "Markdown Bold",
            "scope": ["markup.bold"],
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Markdown Italic",
            "scope": ["markup.italic"],
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "Python Decorators",
            "scope": ["entity.name.function.decorator"],
            "settings": { "foreground": "#da77f2" }
        },
        {
            "name": "PHP Variables",
            "scope": ["variable.other.php"],
            "settings": { "foreground": "#f8f9fa" }
        },
        {
            "name": "C# Keywords",
            "scope": ["keyword.cs"],
            "settings": { "foreground": "#339af0", "fontStyle": "bold" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
