{
    "name": "Spock Docs Dark",
    "type": "dark",
    "colors": {
        "editor.background": "#2d3748",
        "editor.foreground": "#e2e8f0",
        "editorCursor.foreground": "#e2e8f0",
        "editorLineNumber.foreground": "#a0aec0",
        "editor.selectionBackground": "#4a5568",
        "editorIndentGuide.background": "#4a5568"
    },
    "tokenColors": [
        {
            "scope": ["keyword", "keyword.control"],
            "settings": { "foreground": "#9ae6b4" }
        },
        {
            "scope": ["entity.other.attribute-name", "meta.annotation"],
            "settings": { "foreground": "#D7BAFF" }
        },
        { "scope": "string", "settings": { "foreground": "#fbd38d" } },
        {
            "scope": "comment",
            "settings": { "foreground": "#a0aec0", "fontStyle": "italic" }
        },
        {
            "scope": ["constant.numeric", "constant.language.numeric"],
            "settings": { "foreground": "#fca5a5" }
        },
        {
            "scope": ["entity.name.class", "support.class", "support.type"],
            "settings": { "foreground": "#faf089" }
        },
        {
            "scope": ["variable", "entity.name.function", "identifier"],
            "settings": { "foreground": "#e2e8f0" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
