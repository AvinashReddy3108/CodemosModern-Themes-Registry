{
    "name": "Spock Docs Light",
    "type": "light",
    "colors": {
        "editor.background": "#F1F2F4",
        "editor.foreground": "#2d3748",
        "editorCursor.foreground": "#2d3748",
        "editorLineNumber.foreground": "#6B7280",
        "editor.selectionBackground": "#D1D5DB",
        "editorIndentGuide.background": "#e0e0e0"
    },
    "tokenColors": [
        {
            "scope": ["keyword", "keyword.control"],
            "settings": { "foreground": "#3182CE" }
        },
        {
            "scope": ["entity.other.attribute-name", "meta.annotation"],
            "settings": { "foreground": "#6B46C1" }
        },
        { "scope": "string", "settings": { "foreground": "#B7791F" } },
        {
            "scope": "comment",
            "settings": { "foreground": "#718096", "fontStyle": "italic" }
        },
        {
            "scope": ["constant.numeric", "constant.language.numeric"],
            "settings": { "foreground": "#DD6B20" }
        },
        {
            "scope": ["entity.name.class", "support.class", "support.type"],
            "settings": { "foreground": "#B794F4" }
        },
        {
            "scope": ["variable", "entity.name.function", "identifier"],
            "settings": { "foreground": "#2d3748" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
