    "tokenColors": [
        { "settings": { "foreground": "#dedede", "background": "#181b1f" } },
        {
            "scope": ["meta.embedded", "source.groovy.embedded"],
            "settings": { "background": "#181b1f", "foreground": "#fffdfb" }
        },
        {
            "name": "Comment",
            "scope": "comment",
            "settings": { "foreground": "#636363" }
        },
        {
            "name": "String",
            "scope": "string",
            "settings": { "foreground": "#c7ad40" }
        },
        {
            "name": "Template Definition",
            "scope": [
                "punctuation.definition.template-expression",
                "punctuation.section.embedded"
            ],
            "settings": { "foreground": "#f58c81" }
        },
        {
            "name": "Reset JavaScript string interpolation expression",
            "scope": ["meta.template.expression"],
            "settings": { "foreground": "#fffdfb" }
        },
        {
            "name": "Number",
            "scope": "constant.numeric",
            "settings": { "foreground": "#b69cf6" }
        },
        {
            "name": "Built-in constant",
            "scope": "constant.language",
            "settings": { "foreground": "#b69cf6" }
        },
        {
            "name": "User-defined constant",
            "scope": "constant.character, constant.other",
            "settings": { "foreground": "#b69cf6" }
        },
        {
            "name": "Variable",
            "scope": "variable",
            "settings": { "fontStyle": "", "foreground": "#fffdfb" }
        },
        {
            "name": "Keyword",
            "scope": "keyword",
            "settings": { "foreground": "#f58c81" }
        },
        {
            "name": "Storage",
            "scope": "storage",
            "settings": { "fontStyle": "", "foreground": "#f58c81" }
        },
        {
            "name": "Storage type",
            "scope": "storage.type",
            "settings": { "fontStyle": "italic", "foreground": "#00c4d7" }
        },
        {
            "name": "Class name",
            "scope": "entity.name.type, entity.name.class",
            "settings": { "fontStyle": "underline", "foreground": "#61c68a" }
        },
        {
            "name": "Inherited class",
            "scope": "entity.other.inherited-class",
            "settings": {
                "fontStyle": "italic underline",
                "foreground": "#61c68a"
            }
        },
        {
            "name": "Function name",
            "scope": "entity.name.function",
            "settings": { "fontStyle": "", "foreground": "#61c68a" }
        },
        {
            "name": "Function argument",
            "scope": "variable.parameter",
            "settings": { "fontStyle": "italic", "foreground": "#ea9856" }
        },
        {
            "name": "Tag name",
            "scope": "entity.name.tag",
            "settings": { "fontStyle": "", "foreground": "#f58c81" }
        },
        {
            "name": "Tag attribute",
            "scope": "entity.other.attribute-name",
            "settings": { "fontStyle": "", "foreground": "#61c68a" }
        },
        {
            "name": "Library function",
            "scope": "support.function",
            "settings": { "fontStyle": "", "foreground": "#00c4d7" }
        },
        {
            "name": "Library constant",
            "scope": "support.constant",
            "settings": { "fontStyle": "", "foreground": "#00c4d7" }
        },
        {
            "name": "Library class/type",
            "scope": "support.type, support.class",
            "settings": { "fontStyle": "italic", "foreground": "#00c4d7" }
        },
        {
            "name": "Library variable",
            "scope": "support.other.variable",
            "settings": { "fontStyle": "" }
        },
        {
            "name": "Invalid",
            "scope": "invalid",
            "settings": {
                "background": "#f58c81",
                "fontStyle": "",
                "foreground": "#fffdfb"
            }
        },
        {
            "name": "Invalid deprecated",
            "scope": "invalid.deprecated",
            "settings": { "background": "#b69cf6", "foreground": "#fffdfb" }
        },
        {
            "name": "Invalid deprecated HTML element",
            "scope": "invalid.deprecated.html",
            "settings": { "background": "#b69cf6", "foreground": "#f58c81" }
        },
        {
            "name": "JSON String",
            "scope": "meta.structure.dictionary.json string.quoted.double.json",
            "settings": { "foreground": "#c7ad40" }
        },
        {
            "name": "diff.header",
            "scope": "meta.diff, meta.diff.header",
            "settings": { "foreground": "#636363" }
        },
        {
            "name": "diff.deleted",
            "scope": "markup.deleted",
            "settings": { "foreground": "#f58c81" }
        },
        {
            "name": "diff.inserted",
            "scope": "markup.inserted",
            "settings": { "foreground": "#61c68a" }
        },
        {
            "name": "diff.changed",
            "scope": "markup.changed",
            "settings": { "foreground": "#c7ad40" }
        },
        {
            "scope": "constant.numeric.line-number.find-in-files - match",
            "settings": { "foreground": "#b69cf6" }
        },
        {
            "scope": "entity.name.filename.find-in-files",
            "settings": { "foreground": "#c7ad40" }
        },
        {
            "name": "Markup Quote",
            "scope": "markup.quote",
            "settings": { "foreground": "#f58c81" }
        },
        {
            "name": "Markup Lists",
            "scope": "markup.list",
            "settings": { "foreground": "#c7ad40" }
        },
        {
            "name": "Markup Styling",
            "scope": "markup.bold, markup.italic",
            "settings": { "foreground": "#00c4d7" }
        },
        {
            "name": "Markup Inline",
            "scope": "markup.inline.raw",
            "settings": { "fontStyle": "", "foreground": "#ea9856" }
        },
        {
            "name": "Markup Headings",
            "scope": "markup.heading",
            "settings": { "foreground": "#61c68a" }
        },
        {
            "name": "Markup Setext Header",
            "scope": "markup.heading.setext",
            "settings": { "fontStyle": "", "foreground": "#61c68a" }
        },
        {
            "scope": "token.info-token",
            "settings": { "foreground": "#6eb2fd" }
        },
        {
            "scope": "token.warn-token",
            "settings": { "foreground": "#c7ad40" }
        },
        {
            "scope": "token.error-token",
            "settings": { "foreground": "#f18aa1" }
        },
        {
            "scope": "token.debug-token",
            "settings": { "foreground": "#b69cf6" }
        },
        {
            "name": "this.self",
            "scope": "variable.language",
            "settings": { "foreground": "#ea9856" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
