{
    "$schema": "vscode://schemas/color-theme",
    "name": "Sunset Gradient Soft",
    "author": "Sunset Themes",
    "semanticClass": "theme.sunset-gradient-soft",
    "semanticHighlighting": true,
    "colors": {
