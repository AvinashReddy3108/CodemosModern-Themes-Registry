        "statusBar.noFolderBackground": "#181825",
        "statusBarItem.hoverBackground": "#313244",
        "statusBarItem.remoteBackground": "#CBA6F7",
        "statusBarItem.remoteForeground": "#1E1E2E",
        "tab.activeBackground": "#1E1E2E",
        "tab.activeBorder": "#CBA6F7",
        "tab.activeForeground": "#B4BEFE",
        "tab.activeModifiedBorder": "#CBA6F7",
        "tab.border": "#1E1E2E",
        "tab.inactiveBackground": "#181825",
        "tab.inactiveForeground": "#CDD6F4AF",
        "tab.unfocusedActiveBorder": "#CBA6F780",
        "tab.unfocusedActiveBackground": "#1E1E2E",
        "tab.unfocusedActiveForeground": "#CDD6F4",
        "tab.unfocusedInactiveBackground": "#181825",
