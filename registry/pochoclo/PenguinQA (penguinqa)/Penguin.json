        "sideBar.background": "#181825",
        "sideBar.border": "#CBA6F730",
        "sideBar.foreground": "#CBA6F7",
        "sideBarSectionHeader.background": "#181825",
        "sideBarSectionHeader.border": "#1E1E2E60",
        "sideBarSectionHeader.foreground": "#CBA6F7",
        "sideBarTitle.foreground": "#CDD6F4",
        "statusBar.background": "#181825",
        "statusBar.border": "#1E1E2E60",
        "statusBar.debuggingBackground": "#FAB387",
        "statusBar.debuggingForeground": "#1E1E2E",
