        "textLink.foreground": "#CBA6F7",
        "titleBar.activeBackground": "#181825",
        "titleBar.activeForeground": "#CDD6F4",
        "titleBar.border": "#1E1E2E60",
        "titleBar.inactiveBackground": "#181825",
        "titleBar.inactiveForeground": "#6C7086",
        "tree.indentGuidesStroke": "#45475A",
        "widget.shadow": "#00000040"
    },
    "tokenColors": [
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#6C7086", "fontStyle": "italic" }
        },
        {
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator",
                "storage",
                "storage.type",
                "storage.modifier"
            ],
            "settings": { "foreground": "#CBA6F7", "fontStyle": "italic" }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.language",
                "constant.character",
                "constant.other"
            ],
            "settings": { "foreground": "#FAB387" }
        },
        {
            "scope": [
                "string",
                "string.template",
                "string.quoted",
                "constant.other.symbol"
            ],
            "settings": { "foreground": "#F5C2E7" }
        },
        {
            "scope": [
                "variable",
                "variable.other.readwrite",
                "variable.other.object",
                "variable.other.readwrite.js",
                "variable.other.readwrite.ts",
                "variable.other.property",
                "variable.other.object.property"
            ],
            "settings": { "foreground": "#CDD6F4" }
        },
        {
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call",
                "meta.method-call",
                "variable.function",
                "meta.class-method.js entity.name.function.js"
            ],
            "settings": { "foreground": "#B4BEFE" }
        },
        {
            "scope": [
                "entity.name.type.class",
                "entity.name.class",
                "support.class",
                "support.type",
                "entity.name.type.interface",
                "entity.other.inherited-class"
            ],
            "settings": { "foreground": "#CBA6F7", "fontStyle": "bold" }
        },
        {
            "scope": [
                "entity.name.tag",
                "entity.name.tag.html",
                "entity.name.tag.jsx",
                "entity.name.tag.tsx"
            ],
            "settings": { "foreground": "#CBA6F7" }
        },
        {
            "scope": [
                "entity.other.attribute-name",
                "entity.other.attribute-name.id",
                "entity.other.attribute-name.class"
            ],
            "settings": { "foreground": "#FAB387" }
        },
        {
            "scope": [
                "punctuation",
                "punctuation.definition.tag",
                "punctuation.separator",
                "punctuation.terminator",
                "punctuation.section.embedded"
            ],
            "settings": { "foreground": "#A7A8AF" }
        },
        {
            "scope": ["string.regexp", "constant.character.escape"],
            "settings": { "foreground": "#F5C2E7", "fontStyle": "italic" }
        },
        {
            "scope": ["variable.parameter", "variable.parameter.function"],
            "settings": { "foreground": "#F5E0DC" }
        },
        {
            "scope": [
                "meta.import",
                "keyword.control.import",
                "keyword.control.export",
                "keyword.control.from"
            ],
            "settings": { "foreground": "#CBA6F7", "fontStyle": "italic" }
        },
        {
            "scope": [
                "meta.object-literal.key",
                "constant.other.object.key.js",
                "string.unquoted.label.js"
            ],
            "settings": { "foreground": "#B4BEFE" }
        },
        {
            "scope": [
                "markup.heading",
                "entity.name.section.markdown",
                "markup.heading.markdown punctuation.definition.heading.markdown"
            ],
            "settings": { "foreground": "#B4BEFE", "fontStyle": "bold" }
        },
        {
            "scope": ["markup.bold", "markup.italic"],
            "settings": { "foreground": "#F5C2E7" }
        },
        {
            "scope": ["markup.inline.raw", "markup.fenced_code.block.markdown"],
            "settings": { "foreground": "#FAB387" }
        },
        {
            "scope": [
                "markup.link",
                "string.other.link",
                "constant.other.reference.link.markdown"
            ],
            "settings": { "foreground": "#CBA6F7", "fontStyle": "underline" }
        },
        {
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#F38BA8" }
        },
        {
            "scope": "meta.separator",
            "settings": { "foreground": "#A7A8AF", "fontStyle": "bold" }
        },
        {
            "scope": "token.info-token",
            "settings": { "foreground": "#B4BEFE" }
        },
        {
            "scope": "token.warn-token",
            "settings": { "foreground": "#FAB387" }
        },
        {
            "scope": "token.error-token",
            "settings": { "foreground": "#F38BA8" }
        },
        {
            "scope": "token.debug-token",
            "settings": { "foreground": "#F5C2E7" }
        },
        {
            "scope": [
                "storage.modifier.async",
                "storage.modifier.async.js",
                "storage.modifier.async.ts",
                "keyword.control.async",
                "keyword.control.await",
                "keyword.operator.await",
                "keyword.operator.expression.await",
                "keyword.control.flow.await"
            ],
            "settings": { "foreground": "#CBA6F7", "fontStyle": "italic bold" }
        },
        {
            "scope": [
                "storage.type.function.arrow",
                "storage.type.function.arrow.js",
                "storage.type.function.arrow.ts",
                "keyword.declaration.function.arrow"
            ],
            "settings": { "foreground": "#74C7EC", "fontStyle": "bold" }
        },
        {
            "scope": [
                "punctuation.definition.parameters.begin",
                "punctuation.definition.parameters.end",
                "punctuation.section.group.begin",
                "punctuation.section.group.end",
                "punctuation.section.block.begin",
                "punctuation.section.block.end",
                "meta.brace.round",
                "meta.brace.curly"
            ],
            "settings": { "foreground": "#74C7EC" }
        }
    ]
}
