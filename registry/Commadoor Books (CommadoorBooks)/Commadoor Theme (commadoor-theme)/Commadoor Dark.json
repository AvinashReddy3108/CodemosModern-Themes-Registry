{
    "name": "commadoor dark",
    "type": "dark",
    "colors": {
        "editor.background": "#26231C",
        "editor.foreground": "#B2AA9A",
        "activityBar.background": "#1F1C16",
        "activityBar.foreground": "#B2AA9A",
        "sideBar.background": "#26231C",
        "sideBar.foreground": "#B2AA9A",
        "sideBar.border": "#2D2A24",
        "statusBar.background": "#1F1C16",
        "statusBar.foreground": "#B2AA9A",
        "titleBar.activeBackground": "#1F1C16",
        "titleBar.activeForeground": "#B2AA9A",
        "tab.activeBackground": "#26231C",
        "tab.inactiveBackground": "#1F1C16",
        "tab.activeForeground": "#B2AA9A",
        "tab.inactiveForeground": "#69645A",
        "tab.activeBorderBottom": "#9B3D99",
        "tab.activeBorder": "#9B3D99",
        "editorGroupHeader.tabsBackground": "#1F1C16",
        "button.background": "#9B3D99",
        "button.foreground": "#E8D7C7",
        "button.hoverBackground": "#45074B",
        "list.activeSelectionBackground": "#45074B",
        "list.activeSelectionForeground": "#E8D7C7",
        "list.hoverBackground": "#2D2A24",
        "list.hoverForeground": "#B2AA9A",
        "input.background": "#2D2A24",
        "input.foreground": "#B2AA9A",
        "input.border": "#69645A",
        "editor.selectionBackground": "#45074B80",
        "editor.selectionHighlightBackground": "#45074B40",
        "editor.lineHighlightBackground": "#2D2A2450",
        "editor.wordHighlightBackground": "#0B7F9940",
        "terminal.ansiBlack": "#1F1C16",
        "terminal.ansiRed": "#8C1F3D",
        "terminal.ansiGreen": "#6C7D0F",
        "terminal.ansiYellow": "#944A00",
        "terminal.ansiBlue": "#0B7F99",
        "terminal.ansiMagenta": "#9B3D99",
        "terminal.ansiCyan": "#186644",
        "terminal.ansiWhite": "#B2AA9A",
        "terminal.ansiBrightBlack": "#69645A",
        "terminal.ansiBrightRed": "#8C1F3D",
        "terminal.ansiBrightGreen": "#6C7D0F",
        "terminal.ansiBrightYellow": "#944A00",
        "terminal.ansiBrightBlue": "#0B7F99",
        "terminal.ansiBrightMagenta": "#9B3D99",
        "terminal.ansiBrightCyan": "#186644",
        "terminal.ansiBrightWhite": "#E8D7C7"
    },
    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#69645A" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "string constant.other.placeholder"],
            "settings": { "foreground": "#B2AA9A" }
        },
        {
            "name": "Colors",
            "scope": ["constant.other.color"],
            "settings": { "foreground": "#E8D7C7" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#8C1F3D" }
        },
        {
            "name": "Keyword, Storage",
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#9B3D99" }
        },
        {
            "name": "Operator, Misc",
            "scope": [
                "keyword.control",
                "constant.other.color",
                "punctuation",
                "meta.tag",
                "punctuation.definition.tag",
                "punctuation.separator.inheritance.php",
                "punctuation.definition.tag.html",
                "punctuation.definition.tag.begin.html",
                "punctuation.definition.tag.end.html",
                "punctuation.section.embedded",
                "keyword.other.template",
                "keyword.other.substitution"
            ],
            "settings": { "foreground": "#69645A" }
        },
        {
            "name": "Tag",
            "scope": [
                "entity.name.tag",
                "meta.tag.sgml",
                "markup.deleted.git_gutter"
            ],
            "settings": { "foreground": "#0B7F99" }
        },
        {
            "name": "Function, Special Method",
            "scope": [
                "entity.name.function",
                "meta.function-call",
                "variable.function",
                "support.function",
                "keyword.other.special-method"
            ],
            "settings": { "foreground": "#0B7F99" }
        },
        {
            "name": "Block Level Variables",
            "scope": ["meta.block variable.other"],
            "settings": { "foreground": "#B2AA9A" }
        },
        {
            "name": "Other Variable, String Link",
            "scope": ["support.other.variable", "string.other.link"],
            "settings": { "foreground": "#8C1F3D" }
        },
        {
            "name": "Number, Constant, Function Argument, Tag Attribute, Embedded",
            "scope": [
                "constant.numeric",
                "constant.language",
                "support.constant",
                "constant.character",
                "constant.escape",
                "variable.parameter",
                "keyword.other.unit",
                "keyword.other"
            ],
            "settings": { "foreground": "#944A00" }
        },
        {
            "name": "String, Symbols, Inherited Class, Markup Heading",
            "scope": [
                "string",
                "constant.other.symbol",
                "constant.other.key",
                "markup.heading",
                "markup.inserted.git_gutter",
                "meta.group.braces.curly constant.other.object.key.js string.unquoted.label.js"
            ],
            "settings": { "foreground": "#6C7D0F" }
        },
        {
            "name": "Class, Support",
            "scope": [
                "entity.name",
                "support.type",
                "support.class",
                "support.other.namespace.use.php",
                "meta.use.php",
                "support.other.namespace.php",
                "markup.changed.git_gutter",
                "support.type.sys-types"
            ],
            "settings": { "foreground": "#944A00" }
        },
        {
            "name": "Entity Types",
            "scope": ["support.type"],
            "settings": { "foreground": "#186644" }
        },
        {
            "name": "CSS Class and Support",
            "scope": [
                "source.css support.type.property-name",
                "source.sass support.type.property-name",
                "source.scss support.type.property-name",
                "source.less support.type.property-name",
                "source.stylus support.type.property-name",
                "source.postcss support.type.property-name"
            ],
            "settings": { "foreground": "#186644" }
        },
        {
            "name": "Sub-methods",
            "scope": [
                "entity.name.module.js",
                "variable.import.parameter.js",
                "variable.other.class.js"
            ],
            "settings": { "foreground": "#8C1F3D" }
        },
        {
            "name": "Language methods",
            "scope": ["variable.language"],
            "settings": { "fontStyle": "italic", "foreground": "#8C1F3D" }
        },
        {
            "name": "entity.name.method.js",
            "scope": ["entity.name.method.js"],
            "settings": { "fontStyle": "italic", "foreground": "#0B7F99" }
        },
        {
            "name": "meta.method.js",
            "scope": [
                "meta.class-method.js entity.name.function.js",
                "variable.function.constructor"
            ],
            "settings": { "foreground": "#0B7F99" }
        },
        {
            "name": "Attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#9B3D99" }
        },
        {
            "name": "HTML Attributes",
            "scope": [
                "text.html.basic entity.other.attribute-name.html",
                "text.html.basic entity.other.attribute-name"
            ],
            "settings": { "fontStyle": "italic", "foreground": "#944A00" }
        },
        {
            "name": "CSS Classes",
            "scope": ["entity.other.attribute-name.class"],
            "settings": { "foreground": "#944A00" }
        },
        {
            "name": "Markup - Italic",
            "scope": ["markup.italic"],
            "settings": { "fontStyle": "italic", "foreground": "#8C1F3D" }
        },
        {
            "name": "Markup - Bold",
            "scope": ["markup.bold"],
            "settings": { "fontStyle": "bold", "foreground": "#8C1F3D" }
        },
        {
            "name": "Markup - Heading",
            "scope": ["markup.heading"],
            "settings": { "fontStyle": "bold", "foreground": "#9B3D99" }
        },
        {
            "name": "SNIPPET: Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#69645A" }
        },
        {
            "name": "SNIPPET: Strings",
            "scope": ["string"],
            "settings": { "foreground": "#f49d0c" }
        },
        {
            "name": "SNIPPET: Keywords",
            "scope": ["keyword"],
            "settings": { "foreground": "#41B3C9", "fontStyle": "" }
        },
        {
            "name": "SNIPPET: Variables",
            "scope": ["variable"],
            "settings": { "foreground": "#6C7D0F" }
        },
        {
            "name": "SNIPPET: Numbers",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#f49d0c" }
        },
        {
            "name": "SNIPPET: Object/Other Property",
            "scope": [
                "variable.object.property",
                "variable.other.property",
                "variable.other.object.property"
            ],
            "settings": { "foreground": "#f49d0c" }
        },
        {
            "name": "SNIPPET: Tag/Markup Deleted",
            "scope": [
                "entity.name.tag",
                "meta.tag",
                "markup.deleted.git_gutter"
            ],
            "settings": { "foreground": "#41B3C9" }
        },
        {
            "name": "SNIPPET: Support Class Component",
            "scope": ["support.class.component"],
            "settings": { "foreground": "#41B3C9" }
        },
        {
            "name": "SNIPPET: Function/Call",
            "scope": [
                "entity.name.function",
                "meta.function-call",
                "variable.function",
                "keyword.control"
            ],
            "settings": { "foreground": "#0B7F99" }
        },
        {
            "name": "SNIPPET: Type/Class/Inherited",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "entity.other.inherited-class",
                "variable.other.readwrite.alias"
            ],
            "settings": { "foreground": "#41B3C999" }
        },
        {
            "name": "SNIPPET: JSX Children",
            "scope": [
                "meta.jsx.children",
                "meta.jsx.children.js",
                "meta.jsx.children.tsx"
            ],
            "settings": { "foreground": "#E8D7C7" }
        },
        {
            "name": "SNIPPET: Member Fn/JS-TS Prop/Obj Key/JSON Prop Name",
            "scope": [
                "entity.name.function.member",
                "variable.other.property.js",
                "variable.other.property.ts",
                "meta.object-literal.key",
                "support.type.property-name.json"
            ],
            "settings": { "foreground": "#6C7D0F" }
        },
        {
            "name": "Keywords",
            "scope": ["keyword.control"],
            "settings": { "foreground": "#C64BC499" }
        },
        {
            "name": "Variables Inline",
            "scope": ["meta.block variable.other"],
            "settings": { "foreground": "#6C7D0F" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
