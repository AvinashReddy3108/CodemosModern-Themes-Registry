    "tokenColors": [
        {
            "name": "Operator",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#cbdbeb" }
        },
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "fontStyle": "italic", "foreground": "#6f767e" }
        },
        {
            "name": "Storage",
            "scope": [
                "keyword.type",
                "storage.modifier",
                "keyword.declaration",
                "keyword.other.definition",
                "punctuation.definition.variable.php",
                "keyword.other.class",
                "storage.type",
                "keyword.other.fn.rust",
                "keyword.other.rust",
                "keyword.function.go",
                "keyword.var.go",
                "keyword.interface.go",
                "keyword.struct.go"
            ],
            "settings": { "fontStyle": "italic", "foreground": "#839fe7" }
        },
        {
            "name": "Variables",
            "scope": ["variable"],
            "settings": { "fontStyle": "italic", "foreground": "#cbdbeb" }
        },
        {
            "name": "Control Flow",
            "scope": ["keyword.control", "keyword.other.new.cs"],
            "settings": { "foreground": "#a288b8", "fontStyle": "italic" }
        },
        {
            "name": "Parameter",
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#ffb957" }
        },
        {
            "name": "Builtin functions",
            "scope": ["support.function.builtin"],
            "settings": { "foreground": "#a288b8" }
        },
        {
            "name": "Class and types",
            "scope": [
                "support.other.namespace.use.php",
                "meta.use.php",
                "support.other.namespace.php",
                "support.class",
                "entity.name.type.class",
                "entity.name.type.struct.rust",
                "entity.name.type",
                "entity.name.class",
                "support.type.python"
            ],
            "settings": { "foreground": "#de889a" }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "support.function.any-method.lua",
                "support.function"
            ],
            "settings": { "foreground": "#e7598c" }
        },
        {
            "name": "Properties",
            "scope": ["variable.other.property"],
            "settings": { "foreground": "#cbdbeb" }
        },
        {
            "name": "Constants",
            "scope": ["constant", "string"],
            "settings": { "foreground": "#839fe7" }
        },
        {
            "name": "Templates",
            "scope": [
                "punctuation.definition.template-expression",
                "variable.string-escape",
                "constant.character.format",
                "constant.other.placeholder"
            ],
            "settings": { "foreground": "#59bad0" }
        },
        {
            "name": "Escape codes",
            "scope": ["constant.character.escape"],
            "settings": { "foreground": "#95e3f4" }
        },
        {
            "name": "Import",
            "scope": [
                "keyword.other.import",
                "keyword.control.import",
                "keyword.control.directive.include",
                "storage.type.import",
                "meta.import",
                "keyword.other.using.cs",
                "keyword.other.using.directive.cpp",
                "meta.use.rust keyword.other.rust",
                "keyword.import.go"
            ],
            "settings": { "foreground": "#a288b8", "fontStyle": "italic" }
        },
        {
            "name": "Package/Namespace Name",
            "scope": [
                "storage.modifier.import",
                "string.quoted.other.lt-gt.include",
                "entity.name.package",
                "entity.name.type.namespace.cs",
                "storage.modifier.package.java"
            ],
            "settings": { "foreground": "#cbdbeb", "fontStyle": "italic" }
        },
        {
            "name": "Package/Namespace",
            "scope": [
                "storage.type.namespace.directive.cpp",
                "keyword.package.go",
                "storage.type.package",
                "keyword.other.package",
                "keyword.other.namespace.cs"
            ],
            "settings": { "foreground": "#839fe7", "fontStyle": "italic" }
        },
        {
            "name": "Regular Expressions",
            "scope": ["string.regexp"],
            "settings": { "foreground": "#ffb957" }
        },
        {
            "name": "Inheritance",
            "scope": ["entity.other.inherited-class"],
            "settings": { "foreground": "#de889a" }
        },
        {
            "name": "This/Self",
            "scope": [
                "variable.language.this.js",
                "variable.language.this.ts",
                "variable.language.special.self.python",
                "variable.language.self.lua"
            ],
            "settings": { "foreground": "#de889a", "fontStyle": "italic" }
        },
        {
            "name": "URL",
            "scope": ["*url*", "*link*", "*uri*"],
            "settings": { "fontStyle": "underline" }
        },
        {
            "name": "Objects",
            "scope": ["variable.other.object"],
            "settings": { "foreground": "#de889a" }
        },
        {
            "name": "Tag",
            "scope": [
                "entity.name.tag",
                "punctuation.definition.tag",
                "meta.tag.sgml"
            ],
            "settings": { "foreground": "#e7598c" }
        },
        {
            "name": "Attributes",
            "scope": [
                "entity.other.attribute-name",
                "text.html.basic entity.other.attribute-name.html",
                "text.html.basic entity.other.attribute-name"
            ],
            "settings": { "foreground": "#f5bf97" }
        },
        {
            "name": "Svelte: embedded",
            "scope": [
                "punctuation.section.embedded.begin.svelte",
                "punctuation.section.embedded.end.svelte"
            ],
            "settings": { "foreground": "#a288b8" }
        },
        {
            "name": "CSS: Id",
            "scope": ["entity.other.attribute-name.id.css"],
            "settings": { "foreground": "#59bad0", "fontStyle": "italic" }
        },
        {
            "name": "CSS: Class",
            "scope": ["entity.other.attribute-name.class.css"],
            "settings": { "foreground": "#de889a", "fontStyle": "italic" }
        },
        {
            "name": "CSS: Functions",
            "scope": ["source.css support.function"],
            "settings": { "foreground": "#a288b8" }
        },
        {
            "name": "CSS: Pseudo Elements and Pseudo Classes",
            "scope": [
                "entity.other.attribute-name.pseudo-element.css",
                "entity.other.attribute-name.pseudo-class.css"
            ],
            "settings": { "foreground": "#ffb957", "fontStyle": "italic" }
        },
        {
            "name": "CSS: values",
            "scope": [
                "source.css meta.property-value",
                "source.sass meta.property-value",
                "source.scss meta.property-value",
                "source.less meta.property-value",
                "source.stylus meta.property-value",
                "source.postcss meta.property-value"
            ],
            "settings": { "foreground": "#839fe7" }
        },
        {
            "name": "CSS: Units",
            "scope": [
                "source.css keyword.other.unit",
                "source.sass keyword.other.unit",
                "source.scss keyword.other.unit",
                "source.less keyword.other.unit",
                "source.stylus keyword.other.unit",
                "source.postcss keyword.other.unit"
            ],
            "settings": { "foreground": "#f5bf97", "fontStyle": "italic" }
        },
        {
            "name": "CSS: Function Parentheses",
            "scope": [
                "punctuation.section.function.begin.bracket.round.css",
                "punctuation.section.function.end.bracket.round.css",
                "punctuation.section.function.scss"
            ],
            "settings": { "foreground": "#cbdbeb" }
        },
        {
            "name": "CSS: At rules",
            "scope": [
                "source.css keyword.control.at-rule",
                "source.sass keyword.control.at-rule",
                "source.scss keyword.control.at-rule",
                "source.less keyword.control.at-rule",
                "source.stylus keyword.control.at-rule",
                "source.postcss keyword.control.at-rule"
            ],
            "settings": { "foreground": "#a288b8", "fontStyle": "italic" }
        },
        {
            "name": "Python: Magic Function",
            "scope": ["support.function.magic.python"],
            "settings": { "foreground": "#59bad0", "fontStyle": "italic" }
        },
        {
            "name": "JSON: Key",
            "scope": [
                "source.json meta.structure.dictionary.json support.type.property-name.json",
                "meta.embedded.block.json meta.structure.dictionary.json support.type.property-name.json"
            ],
            "settings": { "foreground": "#e7598c" }
        },
        {
            "name": "Markdown - Heading",
            "scope": [
                "markdown.heading",
                "markup.heading | markup.heading entity.name",
                "markup.heading.markdown punctuation.definition.heading.markdown",
                "entity.name.section.markdown"
