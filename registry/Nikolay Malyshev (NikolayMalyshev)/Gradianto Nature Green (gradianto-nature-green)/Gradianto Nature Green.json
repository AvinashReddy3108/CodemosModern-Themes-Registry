    "tokenColors": [
        {
            "name": "Text",
            "scope": ["source", "text.html"],
            "settings": { "foreground": "#a8afbe" }
        },
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#54806d", "fontStyle": "italic" }
        },
        {
            "name": "Doc comments",
            "scope": [
                "comment.block.documentation",
                "comment.line.documentation"
            ],
            "settings": { "foreground": "#4c836d", "fontStyle": "italic" }
        },
        {
            "name": "Doc comment tags",
            "scope": [
                "storage.type.class.jsdoc",
                "punctuation.definition.block.tag.jsdoc",
                "entity.name.tag.javadoc",
                "keyword.other.documentation"
            ],
            "settings": { "foreground": "#599575", "fontStyle": "bold" }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.new",
                "keyword.operator.expression",
                "keyword.operator.logical",
                "keyword.operator.delete",
                "keyword.operator.typeof",
                "keyword.operator.void",
                "keyword.operator.instanceof",
                "keyword.operator.in",
                "keyword.operator.of",
                "storage.modifier",
                "storage.type.function",
                "storage.type.class",
                "storage.type.interface",
                "storage.type.enum"
            ],
            "settings": { "foreground": "#2ea9aa" }
        },
        {
            "name": "Storage types (var, let, const, function, class)",
            "scope": ["storage.type"],
            "settings": { "foreground": "#2ea9aa" }
        },
        {
            "name": "Strings",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#a6aa43" }
        },
        {
            "name": "String escape sequences",
            "scope": ["constant.character.escape", "string.regexp"],
            "settings": { "foreground": "#aab77c" }
        },
        {
            "name": "Numbers",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#bb8f73" }
        },
        {
            "name": "Boolean & built-in constants",
            "scope": ["constant.language"],
            "settings": { "foreground": "#71aa84", "fontStyle": "bold italic" }
        },
        {
            "name": "Constants",
            "scope": ["variable.other.constant", "entity.name.constant"],
            "settings": { "foreground": "#71aa84" }
        },
        {
            "name": "Class & type names",
            "scope": [
                "entity.name.class",
                "entity.name.type.class",
                "entity.name.type",
                "support.class"
            ],
            "settings": { "foreground": "#c6c666", "fontStyle": "bold" }
        },
        {
            "name": "Interface names",
            "scope": ["entity.name.type.interface"],
            "settings": { "foreground": "#c6c666", "fontStyle": "bold" }
        },
        {
            "name": "Enum names",
            "scope": ["entity.name.type.enum"],
            "settings": { "foreground": "#c6c666", "fontStyle": "bold" }
        },
        {
            "name": "Function & method declarations",
            "scope": [
                "entity.name.function",
                "meta.definition.method entity.name.function"
            ],
            "settings": { "foreground": "#d07bd2" }
        },
        {
            "name": "Static methods",
            "scope": [
                "meta.function-call support.function",
                "support.function"
            ],
            "settings": { "foreground": "#c48d9c", "fontStyle": "italic" }
        },
        {
            "name": "Function calls",
            "scope": [
                "meta.function-call entity.name.function",
                "meta.method-call entity.name.function"
            ],
            "settings": { "foreground": "#d07bd2" }
        },
        {
            "name": "Parameters",
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#8675a9" }
        },
        {
            "name": "Local variables",
            "scope": ["variable.other.local", "variable.other.readwrite.local"],
            "settings": { "foreground": "#af6e86" }
        },
        {
            "name": "Instance fields / properties",
            "scope": [
                "variable.other.property",
                "variable.other.object.property",
                "support.variable.property"
            ],
            "settings": { "foreground": "#6baa85" }
        },
        {
            "name": "Static fields",
            "scope": [
                "variable.other.static",
                "variable.other.property.static"
            ],
            "settings": { "foreground": "#a5aa7c", "fontStyle": "italic" }
        },
        {
            "name": "Global variables",
            "scope": [
                "variable.other.global",
                "variable.language.this",
                "variable.language.self",
                "variable.language.super"
            ],
            "settings": { "foreground": "#b19a6f" }
        },
        {
            "name": "General variables",
            "scope": ["variable", "variable.other"],
            "settings": { "foreground": "#518dc6" }
        },
        {
            "name": "Annotations / decorators",
            "scope": [
                "entity.name.decorator",
                "entity.name.function.decorator",
                "meta.decorator",
                "punctuation.decorator",
                "storage.type.annotation",
                "meta.attribute"
            ],
            "settings": { "foreground": "#9ebb52" }
        },
        {
            "name": "Operators",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#ccb86c" }
        },
        {
            "name": "Punctuation",
            "scope": ["punctuation.terminator", "punctuation.separator"],
            "settings": { "foreground": "#a3ccb5" }
        },
        {
            "name": "Brackets & braces",
            "scope": [
                "punctuation.definition.block",
                "punctuation.section.block",
                "meta.brace.round",
                "meta.brace.square",
                "punctuation.brackets"
            ],
            "settings": { "foreground": "#a8afbe" }
        },
        {
            "name": "JSON property keys",
            "scope": [
                "support.type.property-name.json",
                "meta.object-literal.key"
            ],
            "settings": { "foreground": "#5686aa" }
        },
        {
            "name": "HTML tags",
            "scope": ["entity.name.tag", "meta.tag"],
            "settings": { "foreground": "#aa614f" }
        },
        {
            "name": "HTML attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#2ea9aa" }
        },
        {
            "name": "CSS selectors",
            "scope": [
                "entity.name.tag.css",
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css"
            ],
            "settings": { "foreground": "#c6c666" }
        },
        {
            "name": "CSS properties",
            "scope": ["support.type.property-name.css", "meta.property-name"],
            "settings": { "foreground": "#2ea9aa" }
        },
        {
            "name": "CSS values",
            "scope": ["meta.property-value", "support.constant.property-value"],
            "settings": { "foreground": "#a6aa43" }
        },
        {
            "name": "Markdown headings",
            "scope": ["markup.heading", "entity.name.section.markdown"],
            "settings": { "foreground": "#c6c666", "fontStyle": "bold" }
        },
        {
            "name": "Markdown bold",
            "scope": ["markup.bold"],
            "settings": { "foreground": "#cccece", "fontStyle": "bold" }
        },
        {
            "name": "Markdown italic",
            "scope": ["markup.italic"],
            "settings": { "foreground": "#cccece", "fontStyle": "italic" }
        },
        {
            "name": "Markdown inline code",
            "scope": ["markup.inline.raw", "markup.raw.inline"],
            "settings": { "foreground": "#a6aa43" }
        },
        {
            "name": "Markdown links",
            "scope": [
                "markup.underline.link",
                "string.other.link.title.markdown"
            ],
            "settings": { "foreground": "#cded91" }
        },
        {
            "name": "Markdown list punctuation",
            "scope": [
                "punctuation.definition.list.begin.markdown",
                "markup.list.bullet"
            ],
            "settings": { "foreground": "#4aa275" }
        },
        {
            "name": "Regex",
            "scope": ["string.regexp"],
            "settings": { "foreground": "#75aa7b" }
        },
        {
            "name": "Regex brackets",
            "scope": [
                "punctuation.definition.character-class.regexp",
                "constant.character.character-class.regexp"
            ],
            "settings": { "foreground": "#4f9c55" }
        },
        {
            "name": "Regex groups",
            "scope": ["punctuation.definition.group.regexp"],
            "settings": { "foreground": "#c2e89b" }
        },
        {
            "name": "Invalid / deprecated",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#ff4d4c" }
        },
        {
            "name": "Inherited class reference",
            "scope": ["entity.other.inherited-class"],
            "settings": { "foreground": "#6ea58a" }
        },
        {
            "name": "Namespace / module",
            "scope": ["entity.name.namespace", "entity.name.module"],
            "settings": { "foreground": "#a5aa7c" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
