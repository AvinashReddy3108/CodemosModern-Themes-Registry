        "list.activeSelectionBackground": "#f4f3f1",
        "list.activeSelectionForeground": "#171717",
        "list.inactiveSelectionBackground": "#f4f3f1",
        "list.inactiveSelectionForeground": "#171717",
        "list.hoverBackground": "#f8f5f1",
        "list.hoverForeground": "#171717",
        "list.focusBackground": "#f4f3f1",
        "list.highlightForeground": "#16a34a",
        "list.errorForeground": "#a6271c",
        "list.warningForeground": "#a36a1a",
        "activityBar.background": "#fbfaf8",
        "activityBar.foreground": "#171717",
        "activityBar.inactiveForeground": "#a1a1a1",
        "activityBar.border": "#e5e5e5",
        "activityBarBadge.background": "#08331f",
        "activityBarBadge.foreground": "#ffffff",
        "statusBar.background": "#fbfaf8",
        "statusBar.foreground": "#525252",
        "statusBar.border": "#e5e5e5",
        "statusBar.debuggingBackground": "#a36a1a",
        "statusBar.debuggingForeground": "#ffffff",
        "statusBar.noFolderBackground": "#f3f3f3",
        "statusBarItem.hoverBackground": "#f4f3f1",
        "statusBarItem.activeBackground": "#e5e5e5",
        "statusBarItem.remoteBackground": "#08331f",
        "statusBarItem.remoteForeground": "#ffffff",
        "titleBar.activeBackground": "#fbfaf8",
        "titleBar.activeForeground": "#171717",
        "titleBar.inactiveBackground": "#fbfaf8",
        "titleBar.inactiveForeground": "#a1a1a1",
        "titleBar.border": "#e5e5e5",
        "menu.background": "#fbfaf8",
        "menu.foreground": "#171717",
        "menu.selectionBackground": "#f4f3f1",
        "menu.selectionForeground": "#171717",
        "menu.separatorBackground": "#e5e5e5",
        "menubar.selectionBackground": "#f4f3f1",
        "menubar.selectionForeground": "#171717",
        "input.background": "#ffffff",
        "input.border": "#e5e5e5",
        "input.foreground": "#171717",
        "input.placeholderForeground": "#a1a1a1",
        "inputOption.activeBackground": "#08331f20",
        "inputOption.activeBorder": "#08331f",
        "inputValidation.errorBackground": "#ffe6e6",
        "inputValidation.errorBorder": "#a6271c",
        "inputValidation.warningBackground": "#fff5e4",
        "inputValidation.warningBorder": "#a36a1a",
        "inputValidation.infoBackground": "#f1f0f9",
        "inputValidation.infoBorder": "#8574ad",
        "dropdown.background": "#fbfaf8",
        "dropdown.border": "#e5e5e5",
        "dropdown.foreground": "#171717",
        "dropdown.listBackground": "#fbfaf8",
        "button.background": "#08331f",
        "button.foreground": "#ffffff",
        "button.hoverBackground": "#0a4528",
        "button.secondaryBackground": "#f4f3f1",
        "button.secondaryForeground": "#404040",
        "button.secondaryHoverBackground": "#e5e5e5",
        "scrollbar.shadow": "#00000010",
        "scrollbarSlider.background": "#17171720",
        "scrollbarSlider.hoverBackground": "#17171735",
        "scrollbarSlider.activeBackground": "#17171750",
        "badge.background": "#08331f",
        "badge.foreground": "#ffffff",
        "notifications.background": "#fbfaf8",
        "notifications.foreground": "#171717",
        "notifications.border": "#e5e5e5",
        "notificationCenterHeader.background": "#fbfaf8",
        "notificationCenterHeader.foreground": "#171717",
        "panel.background": "#fbfaf8",
        "panel.border": "#e5e5e5",
        "panelTitle.activeBorder": "#08331f",
        "panelTitle.activeForeground": "#171717",
        "panelTitle.inactiveForeground": "#a1a1a1",
        "terminal.background": "#fbfaf8",
        "terminal.foreground": "#171717",
        "terminal.ansiBlack": "#171717",
        "terminal.ansiRed": "#a6271c",
        "terminal.ansiGreen": "#16a34a",
        "terminal.ansiYellow": "#a36a1a",
        "terminal.ansiBlue": "#4b7fe1",
        "terminal.ansiMagenta": "#8574ad",
        "terminal.ansiCyan": "#08331f",
        "terminal.ansiWhite": "#f5f5f5",
        "terminal.ansiBrightBlack": "#525252",
        "terminal.ansiBrightRed": "#fe4a49",
        "terminal.ansiBrightGreen": "#63b780",
        "terminal.ansiBrightYellow": "#b57b24",
        "terminal.ansiBrightBlue": "#9385bb",
        "terminal.ansiBrightMagenta": "#65538a",
        "terminal.ansiBrightCyan": "#0a4528",
        "terminal.ansiBrightWhite": "#ffffff",
        "terminalCursor.foreground": "#08331f",
        "gitDecoration.addedResourceForeground": "#16a34a",
        "gitDecoration.modifiedResourceForeground": "#a36a1a",
        "gitDecoration.deletedResourceForeground": "#a6271c",
        "gitDecoration.untrackedResourceForeground": "#8574ad",
        "gitDecoration.ignoredResourceForeground": "#a1a1a1",
        "gitDecoration.conflictingResourceForeground": "#a6271c",
        "diffEditor.insertedTextBackground": "#16a34a20",
        "diffEditor.removedTextBackground": "#a6271c20",
        "diffEditor.insertedLineBackground": "#16a34a10",
        "diffEditor.removedLineBackground": "#a6271c10",
        "merge.currentHeaderBackground": "#16a34a40",
        "merge.currentContentBackground": "#16a34a15",
        "merge.incomingHeaderBackground": "#8574ad40",
        "merge.incomingContentBackground": "#8574ad15",
        "editorBracketMatch.background": "#08331f15",
        "editorBracketMatch.border": "#08331f60",
        "editorBracketHighlight.foreground1": "#08331f",
        "editorBracketHighlight.foreground2": "#16a34a",
        "editorBracketHighlight.foreground3": "#8574ad",
        "editorBracketHighlight.foreground4": "#a36a1a",
        "editorError.foreground": "#a6271c",
        "editorWarning.foreground": "#a36a1a",
        "editorInfo.foreground": "#8574ad",
        "editorHint.foreground": "#16a34a",
        "minimap.background": "#ffffff",
        "minimap.findMatchHighlight": "#16a34a",
        "minimap.selectionHighlight": "#08331f30",
        "minimapSlider.background": "#17171710",
        "minimapSlider.hoverBackground": "#17171720",
        "minimapSlider.activeBackground": "#17171730",
        "breadcrumb.foreground": "#525252",
        "breadcrumb.focusForeground": "#171717",
        "breadcrumb.activeSelectionForeground": "#171717",
        "breadcrumbPicker.background": "#fbfaf8",
        "quickInput.background": "#fbfaf8",
        "quickInput.foreground": "#171717",
        "quickInputList.focusBackground": "#f4f3f1",
        "quickInputTitle.background": "#fbfaf8",
        "peekView.border": "#08331f",
        "peekViewEditor.background": "#fbfaf8",
        "peekViewEditorGutter.background": "#fbfaf8",
        "peekViewResult.background": "#fbfaf8",
        "peekViewResult.fileForeground": "#171717",
        "peekViewResult.lineForeground": "#525252",
        "peekViewResult.matchHighlightBackground": "#16a34a30",
        "peekViewResult.selectionBackground": "#f4f3f1",
        "peekViewResult.selectionForeground": "#171717",
        "peekViewTitle.background": "#f4f3f1",
        "peekViewTitleDescription.foreground": "#525252",
        "peekViewTitleLabel.foreground": "#171717",
        "settings.headerForeground": "#171717",
        "settings.modifiedItemIndicator": "#16a34a",
        "settings.focusedRowBackground": "#f8f5f1",
        "debugToolBar.background": "#fbfaf8",
        "debugTokenExpression.name": "#08331f",
        "debugTokenExpression.value": "#16a34a",
        "debugTokenExpression.string": "#a36a1a",
        "debugTokenExpression.boolean": "#a6271c",
        "debugTokenExpression.number": "#8574ad",
        "welcomePage.background": "#ffffff",
        "welcomePage.tileBackground": "#fbfaf8",
        "welcomePage.tileBorder": "#e5e5e5",
        "welcomePage.tileHoverBackground": "#f4f3f1",
        "focusBorder": "#08331f60",
        "contrastBorder": "#00000000",
        "widget.shadow": "#00000015"
    },
    "tokenColors": [
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#a1a1a1", "fontStyle": "italic" }
        },
        {
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#a36a1a" }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.language.boolean",
                "constant.language.null",
                "constant.language.undefined"
            ],
            "settings": { "foreground": "#8574ad" }
        },
        {
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.new",
                "keyword.operator.expression",
                "storage.type",
                "storage.modifier"
            ],
            "settings": { "foreground": "#a6271c" }
        },
        {
            "scope": [
                "keyword.operator",
                "keyword.operator.assignment",
                "keyword.operator.arithmetic",
                "keyword.operator.logical",
                "keyword.operator.comparison"
            ],
            "settings": { "foreground": "#525252" }
        },
        {
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call"
            ],
            "settings": { "foreground": "#16a34a" }
        },
        {
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.class",
                "support.type"
            ],
            "settings": { "foreground": "#b57b24" }
        },
        {
            "scope": ["entity.name.tag", "support.tag"],
            "settings": { "foreground": "#a6271c" }
        },
        {
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#b57b24" }
        },
        {
            "scope": ["variable", "variable.other", "variable.language"],
            "settings": { "foreground": "#171717" }
        },
        {
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#08331f", "fontStyle": "italic" }
        },
        {
            "scope": ["variable.other.property", "support.variable.property"],
            "settings": { "foreground": "#0a5c34" }
        },
        {
            "scope": ["punctuation", "meta.brace"],
            "settings": { "foreground": "#525252" }
        },
        {
            "scope": ["constant.other.placeholder", "string.interpolated"],
            "settings": { "foreground": "#16a34a" }
        },
        {
            "scope": ["meta.object-literal.key"],
            "settings": { "foreground": "#08331f" }
        },
        {
            "scope": ["entity.other.inherited-class"],
            "settings": { "foreground": "#16a34a", "fontStyle": "italic" }
        },
        {
            "scope": ["entity.name.namespace", "entity.name.module"],
            "settings": { "foreground": "#b57b24" }
        },
        {
            "scope": ["support.constant", "constant.other"],
            "settings": { "foreground": "#8574ad" }
        },
        {
            "scope": ["meta.decorator", "entity.name.decorator"],
            "settings": { "foreground": "#65538a" }
        },
        {
            "scope": [
                "keyword.control.import",
                "keyword.control.export",
                "keyword.control.from",
                "keyword.control.as"
            ],
            "settings": { "foreground": "#a6271c" }
        },
        {
            "scope": ["support.type.primitive"],
            "settings": { "foreground": "#16a34a" }
        },
        {
            "scope": ["entity.name.type.interface", "entity.name.type.alias"],
            "settings": { "foreground": "#b57b24" }
        },
        {
            "scope": ["markup.heading"],
            "settings": { "foreground": "#08331f", "fontStyle": "bold" }
        },
        { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
        { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
        {
            "scope": ["markup.inline.raw", "markup.fenced_code"],
            "settings": { "foreground": "#a36a1a" }
        },
        {
            "scope": ["markup.underline.link"],
            "settings": { "foreground": "#4b7fe1" }
        },
        {
            "scope": ["markup.quote"],
            "settings": { "foreground": "#a1a1a1", "fontStyle": "italic" }
        },
        { "scope": ["markup.list"], "settings": { "foreground": "#a6271c" } },
        {
            "scope": ["meta.diff.header"],
            "settings": { "foreground": "#8574ad" }
        },
        {
            "scope": ["markup.deleted"],
            "settings": { "foreground": "#a6271c" }
        },
        {
            "scope": ["markup.inserted"],
            "settings": { "foreground": "#16a34a" }
        },
        {
            "scope": ["markup.changed"],
            "settings": { "foreground": "#a36a1a" }
        },
        {
            "scope": ["invalid", "invalid.illegal"],
            "settings": {
                "foreground": "#a6271c",
                "fontStyle": "strikethrough"
            }
        },
        {
            "scope": ["invalid.deprecated"],
            "settings": {
                "foreground": "#a36a1a",
                "fontStyle": "strikethrough"
            }
        },
        {
            "scope": ["meta.embedded", "source.groovy.embedded"],
            "settings": { "foreground": "#171717" }
        },
        {
            "scope": [
                "support.type.property-name.css",
                "support.type.property-name.json"
            ],
            "settings": { "foreground": "#08331f" }
        },
        {
            "scope": ["support.constant.property-value.css"],
            "settings": { "foreground": "#171717" }
        },
        {
            "scope": ["constant.other.color.rgb-value.hex.css"],
            "settings": { "foreground": "#8574ad" }
        },
        {
            "scope": ["support.constant.color.w3c-standard-color-name.css"],
            "settings": { "foreground": "#b57b24" }
        },
        {
            "scope": ["entity.other.keyframe-offset.css"],
            "settings": { "foreground": "#8574ad" }
        },
        {
            "scope": [
                "punctuation.definition.tag.begin.html",
                "punctuation.definition.tag.end.html"
            ],
            "settings": { "foreground": "#a1a1a1" }
        },
        {
            "scope": ["entity.name.tag.html"],
            "settings": { "foreground": "#a6271c" }
        },
        {
            "scope": [
                "support.class.component.tsx",
                "support.class.component.jsx"
            ],
            "settings": { "foreground": "#b57b24" }
        },
        {
            "scope": ["punctuation.section.embedded"],
            "settings": { "foreground": "#08331f" }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "function": "#16a34a",
        "function.declaration": "#16a34a",
        "method": "#16a34a",
        "method.declaration": "#16a34a",
        "variable": "#171717",
        "variable.declaration": "#171717",
        "variable.readonly": "#8574ad",
        "variable.defaultLibrary": "#8574ad",
        "parameter": { "foreground": "#08331f", "fontStyle": "italic" },
        "property": "#0a5c34",
        "property.declaration": "#0a5c34",
        "property.readonly": "#8574ad",
        "class": "#b57b24",
        "class.declaration": "#b57b24",
        "interface": "#b57b24",
        "interface.declaration": "#b57b24",
        "type": "#b57b24",
        "type.declaration": "#b57b24",
        "typeParameter": "#b57b24",
        "enum": "#b57b24",
        "enumMember": "#8574ad",
        "namespace": "#b57b24",
        "module": "#b57b24",
        "keyword": "#a6271c",
        "comment": { "foreground": "#a1a1a1", "fontStyle": "italic" },
        "string": "#a36a1a",
        "number": "#8574ad",
        "regexp": "#16a34a",
        "operator": "#525252"
    }
}
