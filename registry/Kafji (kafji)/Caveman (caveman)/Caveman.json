{
    "$schema": "vscode://schemas/color-theme",
    "name": "Caveman",
    "type": "dark",
    "colors": {
        "activityBar.background": "#000",
        "activityBar.inactiveForeground": "#666",
        "activityBar.foreground": "#ccc",
        "editorGroupHeader.tabsBackground": "#000",
        "tab.inactiveBackground": "#000",
        "tab.activeBackground": "#222",
        "tab.hoverBackground": "#444",
        "tab.inactiveForeground": "#999",
        "tab.activeForeground": "#fff",
        "tab.border": "#000",
        "editor.foreground": "#fff",
        "editor.background": "#222",
        "editor.selectionBackground": "#555a",
        "editor.selectionHighlightBackground": "#444a",
        "editor.wordHighlightBackground": "#0000",
        "editor.wordHighlightStrongBackground": "#0000",
        "editorUnnecessaryCode.opacity": "#000",
        "editorInlayHint.foreground": "#9999",
        "editorInlayHint.background": "#0000",
        "editorInlayHint.typeForeground": "#9999",
        "editorInlayHint.typeBackground": "#0000",
        "editorInlayHint.parameterForeground": "#9999",
        "editorInlayHint.parameterBackground": "#0000",
        "statusBar.background": "#000",
        "statusBar.foreground": "#999",
        "statusBar.debuggingBackground": "#000",
        "statusBar.debuggingForeground": "#999",
        "breadcrumb.background": "#222",
        "breadcrumb.foreground": "#999"
    },
    "tokenColors": [
        {
            "name": "Literal",
            "scope": [
                "constant.character",
                "constant.language",
                "constant.numeric",
                "constant.regexp",
                "constant.rgb-value",
                "string"
            ],
            "settings": { "foreground": "#f66" }
        },
        {
            "name": "Variable",
            "scope": [
                "comment.char.underscore",
                "meta.function-call.arguments",
                "string.other",
                "support.type.property-name",
                "variable.parameter",
                "variable.other",
                "keyword.operator"
            ],
            "settings": { "foreground": "#fff" }
        },
        {
            "name": "Keyword",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.other",
                "storage.modifier",
                "storage.type",
                "variable.language"
            ],
            "settings": { "foreground": "#cf6" }
        },
        {
            "name": "Function",
            "scope": [
                "entity.name.function",
                "entity.name.method",
                "meta.function-call.generic",
                "support.function"
            ],
            "settings": { "foreground": "#ff6" }
        },
        {
            "name": "Type",
            "scope": [
                "constant.other",
                "entity.name.class",
                "entity.name.tag",
                "entity.name.type",
                "entity.name.type.primitive",
                "support.class",
                "variable.other.generic-type"
            ],
            "settings": { "foreground": "#fc6" }
        },
        {
            "name": "Comment",
            "scope": [
                "comment",
                "string.quoted.docstring",
                "punctuation.definition.comment"
            ],
            "settings": { "foreground": "#aaa" }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "string": "#f66",
        "number": "#f66",
        "regexp": "#f66",
        "parameter": "#fff",
        "variable": "#fff",
        "property": "#fff",
        "keyword": "#cf6",
        "function": "#ff6",
        "method": "#ff6",
        "macro": "#ff6",
        "class": "#fc6",
        "enum": "#fc6",
        "interface": "#fc6",
        "struct": "#fc6",
        "typeParameter": "#fc6",
        "enumMember": "#fc6",
        "typeAlias": "#fc6",
        "builtinType": "#fc6",
        "comment": "#aaa",
        "*.injected": "#aaa"
    }
}
