    "tokenColors": [
        { "scope": ["emphasis"], "settings": { "fontStyle": "italic" } },
        { "scope": ["strong"], "settings": { "fontStyle": "bold" } },
        { "scope": ["header"], "settings": { "foreground": "#A2546E" } },
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#6D6259", "fontStyle": "italic" }
        },
        {
            "name": "JSDoc keywords",
            "scope": [
                "comment keyword.codetag.notation",
                "comment.block.documentation keyword",
                "storage.type.class.jsdoc"
            ],
            "settings": { "foreground": "#9B7BB0" }
        },
        {
            "name": "JSDoc types",
            "scope": [
                "comment.block.documentation variable.other",
                "comment.block.documentation entity.name.type"
            ],
            "settings": { "foreground": "#6B9B9B", "fontStyle": "italic" }
        },
        {
            "name": "Strings",
            "scope": ["string"],
            "settings": { "foreground": "#C9A86C" }
        },
        {
            "name": "String quotes",
            "scope": [
                "punctuation.definition.string.begin",
                "punctuation.definition.string.end"
            ],
            "settings": { "foreground": "#A68B52" }
        },
        {
            "name": "Template string punctuation",
            "scope": [
                "punctuation.definition.template-expression.begin",
                "punctuation.definition.template-expression.end"
            ],
            "settings": { "foreground": "#A2546E" }
        },
        {
            "name": "Template string interpolation",
            "scope": ["meta.template.expression"],
            "settings": { "foreground": "#E8E0D8" }
        },
        {
            "name": "Constants",
            "scope": ["constant", "variable.other.constant"],
            "settings": { "foreground": "#D4B483" }
        },
        {
            "name": "Numbers",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#9B7BB0" }
        },
        {
            "name": "Boolean",
            "scope": ["constant.language.boolean"],
            "settings": { "foreground": "#C4728A" }
        },
        {
            "name": "Null/Undefined",
            "scope": ["constant.language.null", "constant.language.undefined"],
            "settings": { "foreground": "#C4728A", "fontStyle": "italic" }
        },
        {
            "name": "Keywords",
            "scope": ["keyword"],
            "settings": { "foreground": "#A2546E" }
        },
        {
            "name": "Storage keywords",
            "scope": ["storage.type", "storage.modifier"],
            "settings": { "foreground": "#A2546E", "fontStyle": "italic" }
        },
        {
            "name": "Control keywords",
            "scope": ["keyword.control"],
            "settings": { "foreground": "#A2546E" }
        },
        {
            "name": "Import/Export",
            "scope": [
                "keyword.control.import",
                "keyword.control.export",
                "keyword.control.from"
            ],
            "settings": { "foreground": "#A2546E", "fontStyle": "italic" }
        },
        {
            "name": "Function names",
            "scope": ["entity.name.function", "meta.function-call"],
            "settings": { "foreground": "#8B9EB0" }
        },
        {
            "name": "Function parameters",
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#D4B483", "fontStyle": "italic" }
        },
        {
            "name": "Arrow functions",
            "scope": ["storage.type.function.arrow"],
            "settings": { "foreground": "#A2546E" }
        },
        {
            "name": "Classes",
            "scope": ["entity.name.type.class", "entity.name.class"],
            "settings": { "foreground": "#6B9B9B", "fontStyle": "bold" }
        },
        {
            "name": "Interfaces",
            "scope": ["entity.name.type.interface"],
            "settings": { "foreground": "#6B9B9B", "fontStyle": "italic" }
        },
        {
            "name": "Types",
            "scope": ["entity.name.type", "support.type"],
            "settings": { "foreground": "#6B9B9B", "fontStyle": "italic" }
        },
        {
            "name": "Type parameters",
            "scope": ["entity.name.type.parameter"],
            "settings": { "foreground": "#D4B483" }
        },
        {
            "name": "Variables",
            "scope": ["variable"],
            "settings": { "foreground": "#E8E0D8" }
        },
        {
            "name": "Language variables",
            "scope": ["variable.language"],
            "settings": { "foreground": "#C4728A", "fontStyle": "italic" }
        },
        {
            "name": "Object properties",
            "scope": ["variable.other.property", "meta.object-literal.key"],
            "settings": { "foreground": "#B0A59A" }
        },
        {
            "name": "HTML tags",
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#A2546E" }
        },
        {
            "name": "HTML attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#D4B483", "fontStyle": "italic" }
        },
        {
            "name": "HTML attribute values",
            "scope": ["string.quoted.double.html", "string.quoted.single.html"],
            "settings": { "foreground": "#C9A86C" }
        },
        {
            "name": "CSS selectors",
            "scope": [
                "meta.selector",
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css"
            ],
            "settings": { "foreground": "#6B9B9B" }
        },
        {
            "name": "CSS properties",
            "scope": ["support.type.property-name.css"],
            "settings": { "foreground": "#8B9EB0" }
        },
        {
            "name": "CSS values",
            "scope": [
                "support.constant.property-value.css",
