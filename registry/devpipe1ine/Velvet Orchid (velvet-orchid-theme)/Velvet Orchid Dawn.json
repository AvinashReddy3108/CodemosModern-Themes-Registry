            ],
            "settings": { "foreground": "#D4B483" }
        },
        {
            "name": "CSS units",
            "scope": ["keyword.other.unit.css"],
            "settings": { "foreground": "#9B7BB0" }
        },
        {
            "name": "CSS pseudo",
            "scope": [
                "entity.other.attribute-name.pseudo-class.css",
                "entity.other.attribute-name.pseudo-element.css"
            ],
            "settings": { "foreground": "#A2546E" }
        },
        {
            "name": "Operators",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#A2546E" }
        },
        {
            "name": "Comparison operators",
            "scope": [
                "keyword.operator.comparison",
                "keyword.operator.relational"
            ],
            "settings": { "foreground": "#6B9B9B" }
        },
        {
            "name": "Logical operators",
            "scope": ["keyword.operator.logical"],
            "settings": { "foreground": "#A2546E" }
        },
        {
            "name": "Punctuation",
            "scope": ["punctuation"],
            "settings": { "foreground": "#B0A59A" }
        },
        {
            "name": "Brackets",
            "scope": ["punctuation.definition.block", "meta.brace"],
            "settings": { "foreground": "#B0A59A" }
        },
        {
            "name": "RegExp",
            "scope": ["string.regexp"],
            "settings": { "foreground": "#C4728A" }
        },
        {
            "name": "RegExp groups",
            "scope": [
                "punctuation.definition.group.regexp",
                "keyword.operator.quantifier.regexp"
            ],
            "settings": { "foreground": "#9B7BB0" }
        },
        {
            "name": "Decorators/Annotations",
            "scope": ["meta.decorator", "punctuation.decorator"],
            "settings": { "foreground": "#9B7BB0" }
        },
        {
            "name": "Markdown headings",
            "scope": [
                "markup.heading",
                "heading.1.markdown",
                "heading.2.markdown",
                "heading.3.markdown"
            ],
            "settings": { "foreground": "#A2546E", "fontStyle": "bold" }
        },
        {
            "name": "Markdown bold",
            "scope": ["markup.bold"],
            "settings": { "foreground": "#D4B483", "fontStyle": "bold" }
        },
        {
            "name": "Markdown italic",
            "scope": ["markup.italic"],
            "settings": { "foreground": "#9B7BB0", "fontStyle": "italic" }
        },
        {
            "name": "Markdown links",
            "scope": ["markup.underline.link", "string.other.link"],
            "settings": { "foreground": "#8B9EB0" }
        },
        {
            "name": "Markdown code",
            "scope": ["markup.inline.raw", "markup.fenced_code.block"],
            "settings": { "foreground": "#C9A86C" }
        },
        {
            "name": "Markdown quotes",
            "scope": ["markup.quote"],
            "settings": { "foreground": "#6D6259", "fontStyle": "italic" }
        },
        {
            "name": "Markdown list",
            "scope": ["punctuation.definition.list.begin.markdown"],
            "settings": { "foreground": "#A2546E" }
        },
        {
            "name": "JSON keys",
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#A2546E" }
        },
        {
            "name": "JSON strings",
            "scope": ["string.quoted.double.json"],
