            "settings": { "foreground": "#85c057" }
        },
        {
            "name": "char",
            "scope": "string.quoted.single.char",
            "settings": { "foreground": "#b9c252" }
        },
        {
            "name": "string raw",
            "scope": [
                "string.regexp",
                "punctuation.definition.string.raw",
                "string.quoted.byte.raw"
            ],
            "settings": { "foreground": "#D16969" }
        },
        {
            "name": "other string",
            "scope": [
                "string",
                "string.tag",
                "string.value",
                "string.quoted.single",
                "meta.embedded.assembly"
            ],
            "settings": { "foreground": "#aeca76" }
        },
        {
            "name": "interpolation / fstring",
            "scope": "meta.interpolation",
            "settings": { "foreground": "#b466d7", "fontStyle": "italic" }
        },
        {
            "name": "interpolation / fstring punctuation",
            "scope": [
                "punctuation.definition.template-expression",
                "punctuation.definition.interpolation"
            ],
            "settings": { "foreground": "#942CC4", "fontStyle": "" }
        },
        {
            "name": "escape character",
