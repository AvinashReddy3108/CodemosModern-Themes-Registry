                "meta.item-access.arguments.python"
            ],
            "settings": { "foreground": "#4BE37E", "fontStyle": "" }
        },
        {
            "name": "type number",
            "scope": "entity.name.type.numeric",
            "settings": { "foreground": "#39f19b", "fontStyle": "" }
        },
        {
            "name": "type primitive",
            "scope": [
                "entity.name.type.primitive",
