            "settings": { "foreground": "#FFFF0086", "fontStyle": "italic" }
        },
        {
            "name": "mutable",
            "scope": "storage.modifier.mut",
            "settings": { "foreground": "#C862E4", "fontStyle": "" }
        },
        {
            "name": "async",
            "scope": ["storage.type.function.async", "storage.modifier.async"],
            "settings": { "foreground": "#D9B036", "fontStyle": "italic" }
        },
        {
            "name": "keyword loop",
            "scope": ["keyword.control.while", "keyword.control.for"],
            "settings": { "foreground": "#CB62D9" }
        },
        {
            "name": "keyword logical",
            "scope": "keyword.operator.logical",
            "settings": { "foreground": "#E9BB32" }
        },
        {
            "name": "keyword logical python",
            "scope": "keyword.operator.logical.python",
            "settings": { "foreground": "#E3E932" }
        },
        {
            "name": "keyword comparison",
            "scope": [
