        },
        {
            "scope": "storage.type.string",
            "settings": { "foreground": "#EBFCFC", "fontStyle": "" }
        },
        {
            "name": "variable",
            "scope": "variable",
            "settings": { "foreground": "#EBFCFC", "fontStyle": "italic" }
        },
        {
            "scope": "variable.language",
            "settings": { "foreground": "#569CD6" }
        },
        {
            "name": "string double quoted",
