    "tokenColors": [
        {
            "name": "plain",
            "scope": ["source", "support.type.property-name.css"],
            "settings": { "foreground": "#f0f0f0" }
        },
        {
            "name": "punctuation",
            "scope": [
                "punctuation",
                "punctuation.terminator",
                "punctuation.definition.tag",
                "punctuation.separator",
                "punctuation.definition.string",
                "punctuation.section.block"
            ],
            "settings": { "foreground": "#a0a0a0" }
        },
        {
            "name": "classes",
            "scope": ["entity.name.type.class"],
            "settings": { "foreground": "#ff6969" }
        },
        {
            "name": "interfaces",
            "scope": ["entity.name.type.interface", "entity.name.type"],
            "settings": { "foreground": "#ff6969" }
        },
        {
            "name": "structs",
            "scope": ["entity.name.type.struct"],
            "settings": { "foreground": "#ff6969" }
        },
        {
            "name": "enums",
            "scope": ["entity.name.type.enum"],
            "settings": { "foreground": "#ff6969" }
        },
        {
            "name": "types",
            "scope": ["support.type"],
            "settings": { "foreground": "#8a8c91" }
        },
        {
            "name": "typeParameters",
            "scope": ["variable.type.parameter", "variable.parameter.type"],
            "settings": { "foreground": "#ff6969" }
        },
        {
            "name": "functions",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call.generic"
            ],
            "settings": { "foreground": "#ff6969" }
        },
        {
            "name": "methods",
            "scope": ["entity.name.function.method", "meta.function.method"],
            "settings": { "foreground": "#8a8c91" }
        },
        {
            "name": "calls",
            "scope": ["variable.function"],
            "settings": { "foreground": "#f0f0f0" }
        },
        {
            "name": "variables",
            "scope": [
                "variable",
                "meta.variable",
                "variable.other.object.property",
                "variable.other.readwrite.alias"
            ],
            "settings": { "foreground": "#f0f0f0" }
        },
        {
            "name": "variablesOther",
            "scope": ["variable.other.object"],
            "settings": { "foreground": "#f0f0f0" }
        },
        {
            "name": "globalVariables",
            "scope": ["variable.other.global", "variable.language.this"],
            "settings": { "foreground": "#ffad69" }
        },
        {
            "name": "localVariables",
            "scope": ["variable.other.local"],
            "settings": { "foreground": "#f0f0f0" }
        },
        {
            "name": "parameters",
            "scope": ["variable.parameter", "meta.parameter"],
            "settings": { "foreground": "#f0f0f0" }
        },
        {
            "name": "properties",
            "scope": ["variable.other.property", "meta.property"],
            "settings": { "foreground": "#f0f0f0" }
        },
        {
            "name": "keys",
            "scope": ["meta.object-literal.key"],
            "settings": { "foreground": "#f0f0f0" }
        },
        {
            "name": "keywords",
            "scope": ["keyword"],
            "settings": { "foreground": "#8a8c91" }
        },
        {
            "name": "keywordsControl",
            "scope": [
                "keyword.control.import",
                "keyword.control.from",
                "keyword.import"
            ],
            "settings": { "foreground": "#8a8c91" }
        },
        {
            "name": "storageModifiers",
            "scope": [
                "storage.modifier",
                "keyword.modifier",
                "storage.type",
                "keyword.other",
                "keyword.control"
            ],
            "settings": { "fontStyle": "bold", "foreground": "#8a8c91" }
        },
        {
            "name": "operators",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#8a8c91" }
        },
        {
            "name": "strings",
            "scope": [
                "string",
                "string.other.link",
                "markup.inline.raw.string.markdown"
            ],
            "settings": { "foreground": "#ffad69" }
        },
        {
            "name": "stringEscapeSequences",
            "scope": [
                "constant.character.escape",
                "constant.other.placeholder"
            ],
            "settings": { "foreground": "#f0f0f0" }
        },
        {
            "name": "numbers",
            "scope": ["constant.numeric", "string.unquoted.shell"],
            "settings": { "foreground": "#ffd169" }
        },
        {
            "name": "booleans",
            "scope": [
                "constant.language.boolean",
                "constant.language.json",
                "constant.language",
                "constant.language.java"
            ],
            "settings": { "foreground": "#ffd169" }
        },
        {
            "name": "constants",
            "scope": [
                "variable.other.constant",
                "variable.readonly",
                "constant.other.colors"
            ],
            "settings": { "foreground": "#f0f0f0" }
        },
        {
            "name": "comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "fontStyle": "italic", "foreground": "#818387" }
        },
        {
            "name": "docComments",
            "scope": ["comment.documentation", "comment.line.documentation"],
            "settings": { "foreground": "#818387" }
        },
        {
            "name": "tags",
            "scope": ["entity.name.tag"],
            "settings": { "fontStyle": "bold", "foreground": "#8a8c91" }
        },
        {
            "name": "jsxTags",
            "scope": ["support.class.component"],
            "settings": { "foreground": "#8a8c91" }
        },
        {
            "name": "attributes",
            "scope": ["entity.other.attribute-name", "meta.attribute"],
            "settings": { "foreground": "#ff6969" }
        },
        {
            "name": "urls",
            "scope": ["markup.underline.link"],
            "settings": { "foreground": "#8a8c91" }
        },
        {
            "name": "namespaces",
            "scope": [
                "entity.name.namespace",
                "storage.modifier.namespace",
                "markup.bold.markdown",
                "entity.name.scope-resolution.cpp"
            ],
            "settings": { "foreground": "#ff6969" }
        },
        {
            "name": "modules",
            "scope": ["entity.name.module", "storage.modifier.module"],
            "settings": { "foreground": "#8a8c91" }
        },
        {
            "name": "macros",
            "scope": ["entity.name.function.preprocessor", "meta.preprocessor"],
            "settings": { "foreground": "#8a8c91" }
        },
        {
            "name": "preprocessor",
            "scope": ["meta.preprocessor"],
            "settings": { "foreground": "#ffad69" }
        },
        {
            "name": "exceptions",
            "scope": ["keyword.control.exception", "keyword.control.trycatch"],
            "settings": { "foreground": "#8a8c91" }
        },
        {
            "name": "decorators",
            "scope": [
                "meta.decorator",
                "punctuation.decorator",
                "entity.name.function.decorator"
            ],
            "settings": { "foreground": "#ff6969" }
        },
        {
            "name": "labels",
            "scope": ["entity.name.label", "punctuation.definition.label"],
            "settings": { "foreground": "#ffad69" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
