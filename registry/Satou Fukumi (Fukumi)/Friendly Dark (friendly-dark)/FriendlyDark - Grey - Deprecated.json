            "settings": { "foreground": "#569CD6", "fontStyle": "italic" }
        },
        {
            "scope": ["markup.changed"],
            "settings": { "foreground": "#FFB86C" }
        },
        {
            "scope": ["invalid"],
            "settings": {
                "foreground": "#FF5555",
                "fontStyle": "underline italic"
            }
        },
        {
            "scope": ["invalid.deprecated"],
