    "tokenColors": [
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#3D5960", "fontStyle": "italic" }
        },
        {
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#ACEECB" }
        },
        {
            "scope": ["constant.character.escape", "string.regexp"],
            "settings": { "foreground": "#80D1C6" }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.numeric.integer",
                "constant.numeric.float",
                "constant.numeric.hex"
            ],
            "settings": { "foreground": "#FF8C00" }
        },
        {
            "scope": [
                "constant.language",
                "constant.language.boolean",
                "constant.language.null",
                "constant.language.undefined"
            ],
            "settings": { "foreground": "#FF8C00", "fontStyle": "italic" }
        },
        {
            "scope": ["constant.other", "variable.other.constant"],
            "settings": { "foreground": "#80D1C6" }
        },
        {
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.new",
                "keyword.operator.delete",
                "keyword.operator.expression",
                "keyword.operator.typeof",
                "keyword.operator.instanceof",
                "keyword.operator.void"
            ],
            "settings": { "foreground": "#8B86FF" }
        },
        {
            "scope": [
                "keyword.control.import",
                "keyword.control.export",
                "keyword.control.from"
            ],
            "settings": { "foreground": "#8B86FF" }
        },
        {
            "scope": [
                "keyword.control.flow",
                "keyword.control.conditional",
                "keyword.control.loop"
            ],
            "settings": { "foreground": "#8B86FF" }
        },
        {
            "scope": ["keyword.operator", "keyword.operator.assignment"],
            "settings": { "foreground": "#47BDAD" }
        },
        {
            "scope": [
                "keyword.operator.arithmetic",
                "keyword.operator.comparison",
                "keyword.operator.relational",
                "keyword.operator.logical"
            ],
            "settings": { "foreground": "#47BDAD" }
        },
        {
            "scope": ["storage", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#8B86FF" }
        },
        {
            "scope": [
                "entity.name.function",
                "meta.function-call entity.name.function",
                "support.function"
            ],
            "settings": { "foreground": "#FFC125" }
        },
        {
            "scope": ["entity.name.function.method"],
            "settings": { "foreground": "#FFC125" }
        },
        {
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "entity.name.type.class",
                "support.class",
                "support.type"
            ],
            "settings": { "foreground": "#47BDAD" }
        },
        {
            "scope": ["entity.name.type.interface", "entity.name.type.alias"],
            "settings": { "foreground": "#47BDAD", "fontStyle": "italic" }
        },
        {
            "scope": [
                "entity.name.type.enum",
                "entity.name.type.module",
                "entity.name.namespace"
            ],
            "settings": { "foreground": "#47BDAD" }
        },
        {
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#FF8C00", "fontStyle": "italic" }
        },
        {
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#8B86FF" }
        },
        {
            "scope": ["variable", "variable.other", "variable.other.readwrite"],
            "settings": { "foreground": "#F0F0F0" }
        },
        {
            "scope": ["variable.parameter", "variable.other.parameter"],
            "settings": { "foreground": "#F0F0F0", "fontStyle": "italic" }
        },
        {
            "scope": [
                "variable.language",
                "variable.language.this",
                "variable.language.self",
                "variable.language.super"
            ],
            "settings": { "foreground": "#8B86FF", "fontStyle": "italic" }
        },
        {
            "scope": [
                "variable.other.property",
                "variable.other.object.property"
            ],
            "settings": { "foreground": "#8A929E" }
        },
        {
            "scope": [
                "punctuation",
                "punctuation.definition.tag",
                "punctuation.separator",
                "punctuation.terminator",
                "meta.brace"
            ],
            "settings": { "foreground": "#8A929E" }
        },
        {
            "scope": ["support.type.builtin", "support.type.primitive"],
            "settings": { "foreground": "#47BDAD" }
        },
        {
            "scope": ["support.constant"],
            "settings": { "foreground": "#80D1C6" }
        },
        {
            "scope": ["entity.other.inherited-class"],
            "settings": {
                "foreground": "#47BDAD",
                "fontStyle": "italic underline"
            }
        },
        {
            "scope": [
                "meta.decorator",
                "meta.decorator entity.name.function",
                "meta.decorator punctuation.decorator"
            ],
            "settings": { "foreground": "#FFC125", "fontStyle": "italic" }
        },
        {
            "scope": [
                "entity.name.function.decorator",
                "meta.decorator variable.other"
            ],
            "settings": { "foreground": "#FFC125", "fontStyle": "italic" }
        },
        {
            "name": "Markup Heading",
            "scope": ["markup.heading", "entity.name.section"],
            "settings": { "foreground": "#8B86FF", "fontStyle": "bold" }
        },
        {
            "name": "Markup Bold",
            "scope": ["markup.bold"],
            "settings": { "foreground": "#FF8C00", "fontStyle": "bold" }
        },
        {
            "name": "Markup Italic",
            "scope": ["markup.italic"],
            "settings": { "foreground": "#FFC125", "fontStyle": "italic" }
        },
        {
            "name": "Markup Underline",
            "scope": ["markup.underline"],
            "settings": { "fontStyle": "underline" }
        },
        {
            "name": "Markup Link",
            "scope": ["markup.underline.link", "string.other.link"],
            "settings": { "foreground": "#25D695" }
        },
        {
            "name": "Markup Code",
            "scope": ["markup.inline.raw", "markup.fenced_code", "markup.raw"],
            "settings": { "foreground": "#ACEECB" }
        },
        {
            "name": "Markup Quote",
            "scope": ["markup.quote"],
            "settings": { "foreground": "#5A6E76", "fontStyle": "italic" }
        },
        {
            "name": "Markup List",
            "scope": ["markup.list"],
            "settings": { "foreground": "#F0F0F0" }
        },
        {
            "name": "Markup Inserted",
            "scope": ["markup.inserted"],
            "settings": { "foreground": "#25D695" }
        },
        {
            "name": "Markup Deleted",
            "scope": ["markup.deleted"],
            "settings": { "foreground": "#F23645" }
        },
        {
            "name": "Markup Changed",
            "scope": ["markup.changed"],
            "settings": { "foreground": "#8B86FF" }
        },
        {
            "scope": ["meta.embedded", "source.groovy.embedded"],
            "settings": { "foreground": "#F0F0F0" }
        },
        {
            "name": "JSON Key",
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#47BDAD" }
        },
        {
            "name": "JSON String Value",
            "scope": ["meta.structure.dictionary.value.json string.quoted"],
            "settings": { "foreground": "#ACEECB" }
        },
        {
            "name": "YAML Key",
            "scope": ["entity.name.tag.yaml"],
            "settings": { "foreground": "#47BDAD" }
        },
        {
            "name": "CSS Property",
            "scope": [
                "support.type.property-name.css",
                "support.type.vendored.property-name.css"
            ],
            "settings": { "foreground": "#8A929E" }
        },
        {
            "name": "CSS Value",
            "scope": [
                "support.constant.property-value.css",
                "support.constant.color.css"
            ],
            "settings": { "foreground": "#FF8C00" }
        },
        {
            "name": "CSS Selector",
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css"
            ],
            "settings": { "foreground": "#FFC125" }
        },
        {
            "name": "CSS Tag",
            "scope": ["entity.name.tag.css"],
            "settings": { "foreground": "#8B86FF" }
        },
        {
            "name": "CSS Pseudo",
            "scope": [
                "entity.other.attribute-name.pseudo-class.css",
                "entity.other.attribute-name.pseudo-element.css"
            ],
            "settings": { "foreground": "#47BDAD", "fontStyle": "italic" }
        },
        {
            "name": "Python Self",
            "scope": [
                "variable.parameter.function.language.special.self.python"
            ],
            "settings": { "foreground": "#8B86FF", "fontStyle": "italic" }
        },
        {
            "name": "Python Magic Methods",
            "scope": ["support.function.magic.python"],
            "settings": { "foreground": "#FFC125", "fontStyle": "italic" }
        },
        {
            "name": "Rust Lifetime",
            "scope": [
                "storage.modifier.lifetime.rust",
                "entity.name.type.lifetime.rust"
            ],
            "settings": { "foreground": "#FF8C00", "fontStyle": "italic" }
        },
        {
            "name": "Go Package",
            "scope": ["entity.name.package.go"],
            "settings": { "foreground": "#47BDAD" }
        },
        {
            "name": "Shell Variable",
            "scope": [
                "variable.other.normal.shell",
                "variable.other.special.shell",
                "variable.other.positional.shell"
            ],
            "settings": { "foreground": "#80D1C6" }
        },
        {
            "name": "Solidity",
            "scope": ["storage.type.solidity"],
            "settings": { "foreground": "#8B86FF" }
        },
        {
            "name": "Type Annotation",
            "scope": ["meta.type.annotation", "meta.return.type"],
            "settings": { "foreground": "#47BDAD" }
        }
    ],
    "semanticTokenColors": {
        "type": "#47BDAD",
        "class": "#47BDAD",
        "interface": { "foreground": "#47BDAD", "fontStyle": "italic" },
        "enum": "#47BDAD",
        "enumMember": "#80D1C6",
        "typeParameter": { "foreground": "#FF8C00", "fontStyle": "italic" },
        "namespace": "#47BDAD",
        "struct": "#47BDAD",
        "function": "#FFC125",
        "method": "#FFC125",
        "macro": { "foreground": "#FFC125", "fontStyle": "bold" },
        "variable": "#F0F0F0",
        "variable.readonly": "#80D1C6",
        "variable.defaultLibrary": "#8B86FF",
        "parameter": { "foreground": "#F0F0F0", "fontStyle": "italic" },
        "property": "#8A929E",
        "property.readonly": "#80D1C6",
        "decorator": { "foreground": "#FFC125", "fontStyle": "italic" },
        "keyword": "#8B86FF",
        "comment": { "foreground": "#3D5960", "fontStyle": "italic" },
        "string": "#ACEECB",
        "number": "#FF8C00",
        "regexp": "#80D1C6",
        "operator": "#47BDAD"
    },
    "$schema": "vscode://schemas/color-theme"
}
