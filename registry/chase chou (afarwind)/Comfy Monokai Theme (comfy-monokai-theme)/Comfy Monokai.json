    "tokenColors": [
        {
            "settings": { "foreground": "#eeffffff", "background": "#263238ff" }
        },
        {
            "name": "Functions",
            "scope": [
                "meta.function-call.php",
                "support.function.builtin.rust",
                "support.function.C99",
                "support.function.core.ruby",
                "support.function.go",
                "support.function.js",
                "support.function.log.rust",
                "support.function.magic.php",
                "support.function.std.rust",
                "support.function.builtin.python"
            ],
            "settings": { "foreground": "#98C379" }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "meta.function-call.generic",
                "meta.function-call.method",
                "support.function.any-method",
                "support.function.misc",
                "variable.function"
            ],
            "settings": { "foreground": "#98C379" }
        },
        {
            "name": "Comment",
            "scope": "comment",
            "settings": { "foreground": "#6B7178" }
        },
        {
            "name": "String",
            "scope": "string",
            "settings": { "foreground": "#E6DB74" }
        },
        {
            "name": "Template Definition",
            "scope": [
                "punctuation.definition.template-expression",
                "punctuation.section.embedded.coffee"
            ],
            "settings": { "foreground": "#E06C75" }
        },
        {
            "name": "Number",
            "scope": "constant.numeric",
            "settings": { "foreground": "#baa0f8" }
        },
        {
            "name": "Built-in constant",
            "scope": "constant.language",
            "settings": { "foreground": "#baa0f8" }
        },
        {
            "name": "User-defined constant",
            "scope": ["constant.character", "constant.other"],
            "settings": { "foreground": "#baa0f8" }
        },
        {
            "name": "Variable",
            "scope": "variable",
            "settings": { "fontStyle": "" }
        },
        {
            "name": "Keyword",
            "scope": "keyword",
            "settings": { "foreground": "#E06C75" }
        },
        {
            "name": "Storage",
            "scope": "storage",
            "settings": { "fontStyle": "", "foreground": "#E06C75" }
        },
        {
            "name": "Storage type",
            "scope": "storage.type",
            "settings": { "fontStyle": "italic", "foreground": "#61AFEF" }
        },
        {
            "name": "Class name",
            "scope": "entity.name.class",
            "settings": { "fontStyle": "underline", "foreground": "#98C379" }
        },
        {
            "name": "Inherited class",
            "scope": "entity.other.inherited-class",
            "settings": {
                "fontStyle": "italic underline",
                "foreground": "#98C379"
            }
        },
        {
            "name": "Function name",
            "scope": "entity.name.function",
            "settings": { "fontStyle": "", "foreground": "#98C379" }
        },
        {
            "name": "Function argument",
            "scope": "variable.parameter",
            "settings": { "fontStyle": "italic", "foreground": "#FD971F" }
        },
        {
            "name": "Tag name",
            "scope": "entity.name.tag",
            "settings": { "fontStyle": "", "foreground": "#E06C75" }
        },
        {
            "name": "Tag attribute",
            "scope": "entity.other.attribute-name",
            "settings": { "fontStyle": "", "foreground": "#98C379" }
        },
        {
            "name": "Library function",
            "scope": "support.function",
            "settings": { "fontStyle": "", "foreground": "#61AFEF" }
        },
        {
            "name": "Library constant",
            "scope": "support.constant",
            "settings": { "fontStyle": "", "foreground": "#61AFEF" }
        },
        {
            "name": "Library class/type",
            "scope": ["support.type", "support.class"],
            "settings": { "fontStyle": "italic", "foreground": "#61AFEF" }
        },
        {
            "name": "Library variable",
            "scope": "support.other.variable",
            "settings": { "fontStyle": "" }
        },
        {
            "name": "Invalid",
            "scope": "invalid",
            "settings": {
                "background": "#E06C75",
                "fontStyle": "",
                "foreground": "#F8F8F0"
            }
        },
        {
            "name": "Invalid deprecated",
            "scope": "invalid.deprecated",
            "settings": { "background": "#baa0f8", "foreground": "#F8F8F0" }
        },
        {
            "name": "JSON String",
            "scope": "meta.structure.dictionary.json string.quoted.double.json",
            "settings": { "foreground": "#CFCFC2" }
        },
        {
            "name": "diff.header",
            "scope": ["meta.diff", "meta.diff.header"],
            "settings": { "foreground": "#6B7178" }
        },
        {
            "name": "diff.deleted",
            "scope": "markup.deleted",
            "settings": { "foreground": "#E06C75" }
        },
        {
            "name": "diff.inserted",
            "scope": "markup.inserted",
            "settings": { "foreground": "#98C379" }
        },
        {
            "name": "diff.changed",
            "scope": "markup.changed",
            "settings": { "foreground": "#E6DB74" }
        },
        {
            "name": "GitGutter deleted",
            "scope": "markup.deleted.git_gutter",
            "settings": { "foreground": "#E06C75" }
        },
        {
            "name": "GitGutter inserted",
            "scope": "markup.inserted.git_gutter",
            "settings": { "foreground": "#98C379" }
        },
        {
            "name": "GitGutter changed",
            "scope": "markup.changed.git_gutter",
            "settings": { "foreground": "#E6DB74" }
        },
        {
            "name": "GitGutter ignored",
            "scope": "markup.ignored.git_gutter",
            "settings": { "foreground": "#6B7178" }
        },
        {
            "name": "GitGutter untracked",
            "scope": "markup.untracked.git_gutter",
            "settings": { "foreground": "#6B7178" }
        },
        {
            "scope": "constant.numeric.line-number.find-in-files - match",
            "settings": { "foreground": "#baa0f8A0" }
        },
        {
            "scope": "entity.name.filename.find-in-files",
            "settings": { "foreground": "#E6DB74" }
        },
        {
            "name": "Markup Quote",
            "scope": "markup.quote",
            "settings": { "foreground": "#F92672" }
        },
        {
            "name": "Markup Lists",
            "scope": "markup.list",
            "settings": { "foreground": "#E6DB74" }
        },
        {
            "name": "Markup Styling",
            "scope": "markup.bold, markup.italic",
            "settings": { "foreground": "#61AFEF" }
        },
        {
            "name": "Markup Inline",
            "scope": "markup.inline.raw",
            "settings": { "fontStyle": "", "foreground": "#FD971F" }
        },
        {
            "name": "Markup Headings",
            "scope": "markup.heading",
            "settings": { "foreground": "#98C379" }
        },
        {
            "name": "Markup Setext Header",
            "scope": "markup.heading.setext",
            "settings": { "fontStyle": "", "foreground": "#98C379" }
        },
        {
            "scope": "token.info-token",
            "settings": { "foreground": "#6796e6" }
        },
        {
            "scope": "token.warn-token",
            "settings": { "foreground": "#cd9731" }
        },
        {
            "scope": "token.error-token",
            "settings": { "foreground": "#f44747" }
        },
        {
            "scope": "token.debug-token",
            "settings": { "foreground": "#b267e6" }
        },
        {
            "name": "this.self",
            "scope": "variable.language",
            "settings": { "foreground": "#FD971F" }
        }
    ],
    "semanticTokenColors": {
        "variable": { "foreground": "#CBD2D8" },
        "parameter": { "foreground": "#839C96" },
        "variable.readonly": { "foreground": "#7FB0CE" },
        "property": { "foreground": "#DDEFF1" },
        "function": { "foreground": "#98C379" },
        "class": { "foreground": "#98C379" },
        "type": { "foreground": "#baa0f8" },
        "enum": { "foreground": "#baa0f8" },
        "namespace": { "foreground": "#baa0f8" }
    },
    "$schema": "vscode://schemas/color-theme"
}
