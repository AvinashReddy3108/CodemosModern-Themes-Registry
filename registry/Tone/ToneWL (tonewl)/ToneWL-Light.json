{
    "$schema": "vscode://schemas/color-theme",
    "type": "light",
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "variable.Module": "#4aa030",
        "variable.Block": "#0f9d65",
        "variable.With": "#0a9d7a",
        "variable.shadowed": "#b33c1d",
        "variable.error": "#d01026",
        "variable.unused": "#777777",
        "parameter": "#c0369a",
        "parameter.shadowed": "#b33c1d",
        "parameter.error": "#d01026",
        "parameter.unused": "#777777"
    },
    "tokenColors": [
        {
            "scope": ["symbol.unrecognized"],
            "settings": { "foreground": "#2c2c3263" }
        },
        {
            "scope": [
                "keyword.operator.Function",
                "keyword.operator.BlankNullSequence",
                "keyword.operator.BlankSequence",
                "keyword.operator.Optional",
                "keyword.operator.Blank",
                "keyword.other.Slot",
                "keyword.other.SlotSequence"
            ],
            "settings": { "foreground": "#d01d73" }
        },
        {
            "scope": "keyword.operator",
            "settings": { "foreground": "#337733" }
        },
        {
            "scope": "punctuation.section",
            "settings": { "foreground": "#333333" }
        },
        {
            "name": "Comment",
            "scope": "comment",
            "settings": { "foreground": "#8a8a7a" }
        },
        {
            "name": "Number",
            "scope": "constant.numeric",
            "settings": { "foreground": "#7733a0" }
        },
        {
            "name": "Built-in constant",
            "scope": "constant.language",
            "settings": { "foreground": "#7733a0" }
        },
        {
            "name": "User-defined constant",
            "scope": ["constant.character", "constant.other"],
            "settings": { "foreground": "#7733a0" }
        },
        {
            "name": "Variable",
            "scope": "variable",
            "settings": { "fontStyle": "" }
        },
        {
            "name": "Keyword",
            "scope": "keyword",
            "settings": { "foreground": "#9c1ac1" }
        },
        {
            "name": "Storage",
            "scope": "storage",
            "settings": { "fontStyle": "", "foreground": "#9c1ac1" }
        },
        {
            "name": "Storage type",
            "scope": "storage.type",
            "settings": { "fontStyle": "italic", "foreground": "#0d87a0" }
        },
        {
            "name": "Class name",
            "scope": "entity.name.class",
            "settings": { "fontStyle": "underline", "foreground": "#0a9b76" }
        },
        {
            "name": "Inherited class",
            "scope": "entity.other.inherited-class",
            "settings": {
                "fontStyle": "italic underline",
                "foreground": "#0a9b76"
            }
        },
        {
            "name": "Function name",
            "scope": "entity.name.function",
            "settings": { "fontStyle": "", "foreground": "#0a9b76" }
        },
        {
            "name": "User function",
            "scope": "variable.function",
            "settings": { "fontStyle": "", "foreground": "#2c5159" }
        },
        {
            "name": "Function argument",
            "scope": "variable.parameter",
            "settings": { "fontStyle": "italic", "foreground": "#7e0da6" }
        },
        {
            "name": "Tag name",
            "scope": "entity.name.tag",
            "settings": { "fontStyle": "", "foreground": "#9c1ac1" }
        },
        {
            "name": "Tag attribute",
            "scope": "entity.other.attribute-name",
            "settings": { "fontStyle": "", "foreground": "#0a9b76" }
        },
        {
            "name": "Library function",
            "scope": "support.function",
            "settings": { "fontStyle": "", "foreground": "#0d87a0" }
        },
        {
            "name": "Undocumented",
            "scope": "support.function.undocumented",
            "settings": { "foreground": "#222222" }
        },
        {
            "name": "Library constant",
            "scope": "support.constant",
            "settings": { "fontStyle": "", "foreground": "#0d87a0" }
        },
        {
            "name": "Library class/type",
            "scope": ["support.type", "support.class"],
            "settings": { "fontStyle": "italic", "foreground": "#0d87a0" }
        },
        {
            "name": "Library variable",
            "scope": "support.other.variable",
            "settings": { "fontStyle": "" }
        },
        {
            "name": "Invalid",
            "scope": "invalid",
            "settings": { "foreground": "#FF0000" }
        },
        { "scope": "string", "settings": { "foreground": "#d18f00" } },
        {
            "scope": "variable",
            "settings": { "foreground": "#0d0707", "fontStyle": "" }
        },
        {
            "scope": "variable.language",
            "settings": { "foreground": "#7e0da6" }
        }
    ],
    "colors": {
        "editorBracketHighlight.foreground1": "#0f9b74",
        "editorBracketHighlight.foreground2": "#0f809d",
        "editorBracketHighlight.foreground3": "#0d6ab7",
        "editorBracketHighlight.foreground4": "#463dab",
        "editorBracketHighlight.foreground5": "#6d2a9d",
        "editorBracketHighlight.foreground6": "#9d2294",
        "commandCenter.foreground": "#242a2e",
        "commandCenter.background": "#eff1f3",
        "commandCenter.activeBackground": "#d1e5e7",
        "titleBar.inactiveBackground": "#cfd5d3",
        "titleBar.activeBackground": "#cfd5d3cc",
        "titleBar.activeForeground": "#151f1c",
        "titleBar.inactiveForeground": "#151f1a88",
        "editor.background": "#f8f8ff",
        "editorCursor.foreground": "#2f0513",
        "editor.foreground": "#0D0819",
        "editorWhitespace.foreground": "#D5D7CD",
        "editor.lineHighlightBackground": "#cdc6d2",
        "editor.selectionBackground": "#dcd2e7",
        "editor.selectionHighlightBackground": "#cec2acf0",
        "editor.wordHighlightBackground": "#B5A9B3F0",
        "editor.wordHighlightStrongBackground": "#7173957f",
        "activityBar.background": "#DBD9D5",
        "activityBar.foreground": "#0D0709",
        "badge.background": "#95967A",
        "badge.foreground": "#07070D",
        "button.background": "#95967A",
        "debugToolBar.background": "#DEE1DA",
        "diffEditor.insertedTextBackground": "#C0897A80",
        "diffEditor.removedTextBackground": "#6FC49B80",
        "dropdown.background": "#C4C5BD",
        "dropdown.listBackground": "#E1E2DD",
        "editorGroup.border": "#C6C7BF",
        "editorGroup.dropBackground": "#BCBFD480",
        "editorGroupHeader.tabsBackground": "#E0E1DE",
        "editorHoverWidget.background": "#C4C5BD",
        "editorHoverWidget.border": "#95967A",
        "editorIndentGuide.activeBackground1": "#919688",
        "editorIndentGuide.background1": "#B6BCAD",
        "editorLineNumber.activeForeground": "#40423D",
        "editorLineNumber.foreground": "#73736B",
        "editorSuggestWidget.background": "#D6D9D0",
        "editorSuggestWidget.border": "#95967A",
        "editorWidget.background": "#E3E5E0",
        "focusBorder": "#95967A",
        "input.background": "#C4C5BD",
        "inputOption.activeBorder": "#95967A",
        "inputValidation.errorBackground": "#6BD8AB",
        "inputValidation.errorBorder": "#34a707",
        "inputValidation.infoBackground": "#AB9E6F",
        "inputValidation.infoBorder": "#7E6500",
        "inputValidation.warningBackground": "#7B7AD7",
        "inputValidation.warningBorder": "#1D1DD1",
        "list.activeSelectionBackground": "#95967A",
        "list.dropBackground": "#C6CCBB",
        "list.focusBackground": "#C6CCBB",
        "list.highlightForeground": "#0D0709",
        "list.hoverBackground": "#CBCFC3",
        "list.inactiveSelectionBackground": "#C6CCBB",
        "menu.background": "#E1E2DD",
        "menu.foreground": "#333333",
        "minimap.selectionHighlight": "#78747E7F",
        "panel.border": "#C3C8BB",
        "panelTitle.activeBorder": "#95967A",
        "panelTitle.activeForeground": "#0D0707",
        "panelTitle.inactiveForeground": "#95967A",
        "peekView.border": "#95967A",
        "peekViewEditor.background": "#DBD9D5",
        "peekViewEditor.matchHighlightBackground": "#95967A",
        "peekViewResult.background": "#E0E1DC",
        "peekViewResult.matchHighlightBackground": "#95967A",
        "peekViewResult.selectionBackground": "#B9BCA9",
        "peekViewTitle.background": "#E3E1E0",
        "pickerGroup.foreground": "#95967A",
        "progressBar.background": "#95967A",
        "selection.background": "#4F4C47",
        "settings.focusedRowBackground": "#C6CCBB90",
        "sideBar.background": "#E0E1DC",
        "sideBarSectionHeader.background": "#D7D7D1",
        "statusBar.background": "#C4C5BD",
        "statusBar.debuggingBackground": "#95967A",
        "statusBar.noFolderBackground": "#C4C5BD",
        "statusBarItem.remoteBackground": "#BFE7F3",
        "tab.border": "#E0E1DE",
        "tab.inactiveBackground": "#CFCFC9",
        "tab.inactiveForeground": "#354130",
        "tab.lastPinnedBorder": "#C4C5BD",
        "terminal.ansiBlack": "#CCCCCC",
        "terminal.ansiBlue": "#3541A7",
        "terminal.ansiBrightBlack": "#999999",
        "terminal.ansiBrightBlue": "#2D4CF0",
        "terminal.ansiBrightCyan": "#0860BA",
        "terminal.ansiBrightGreen": "#0F9B50",
        "terminal.ansiBrightMagenta": "#7733a0",
        "terminal.ansiBrightRed": "#9c1ac1",
        "terminal.ansiBrightWhite": "#07070D",
        "terminal.ansiBrightYellow": "#1D1DD1",
        "terminal.ansiCyan": "#06638f",
        "terminal.ansiGreen": "#068905",
        "terminal.ansiMagenta": "#5714a7",
        "terminal.ansiRed": "#3b99a1",
        "terminal.ansiWhite": "#1C1C22",
        "terminal.ansiYellow": "#4c4bd4",
        "terminal.background": "#E4E5DF",
        "widget.shadow": "#00000050"
    },
    "name": "ToneWL Light"
}
