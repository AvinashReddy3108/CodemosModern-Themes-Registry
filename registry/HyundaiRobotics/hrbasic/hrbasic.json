{
    "name": "hrbasic",
    "type": "dark",
    "colors": {
        "editor.background": "#1e1e1e",
        "editor.foreground": "#d4d4d4",
        "activityBarBadge.background": "#007acc",
        "sideBarTitle.foreground": "#bbbbbb"
    },
    "tokenColors": [
        {
            "settings": { "foreground": "#eeffffff", "background": "#263238ff" }
        },
        {
            "name": "JobHeader",
            "scope": ["comment.line.header.hrbasic"],
            "settings": { "foreground": "#AAAAAA" }
        },
        {
            "name": "Comment",
            "scope": [
                "comment.line.rem.hrbasic",
                "comment.line.single-quot.hrbasic"
            ],
            "settings": { "fontStyle": "italic", "foreground": "#608b4e" }
        },
        {
            "name": "String",
            "scope": ["string.quoted.double.hrbasic"],
            "settings": { "foreground": "#ce9178" }
        },
        {
            "name": "Command",
            "scope": ["entity.name.function.step"],
            "settings": { "foreground": "#FF8822" }
        },
        {
            "name": "Function",
            "scope": ["entity.name.function"],
            "settings": { "foreground": "#DCDCAA" }
        },
        {
            "name": "Variable",
            "scope": ["variable"],
            "settings": { "foreground": "#77EEFF" }
        },
        {
            "name": "Numeric",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#BBFFCC" }
        },
        {
            "name": "StepNo",
            "scope": ["keyword.control.stepno.hrbasic"],
            "settings": { "foreground": "#cc5555" }
        },
        {
            "name": "Pose",
            "scope": ["constant.language.pose.hrbasic"],
            "settings": { "foreground": "#569CD6" }
        },
        {
            "name": "Label",
            "scope": ["constant.language.label.hrbasic"],
            "settings": { "foreground": "#AAAAAA" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
