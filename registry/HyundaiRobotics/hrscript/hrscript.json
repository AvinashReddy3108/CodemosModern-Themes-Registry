{
    "name": "hrscript",
    "type": "dark",
    "colors": {
        "editor.background": "#1e1e1e",
        "editor.foreground": "#d4d4d4",
        "activityBarBadge.background": "#007acc",
        "sideBarTitle.foreground": "#bbbbbb"
    },
    "tokenColors": [
        { "settings": { "foreground": "#eeffffff" } },
        {
            "name": "JobHeader",
            "scope": ["comment.line.header.hrscript"],
            "settings": { "foreground": "#999999", "fontStyle": "italic" }
        },
        {
            "name": "Comment",
            "scope": ["comment.line.number-sign.hrscript"],
            "settings": { "fontStyle": "italic", "foreground": "#608b4e" }
        },
        {
            "name": "String",
            "scope": ["string.quoted.double.hrscript"],
            "settings": { "foreground": "#ce9178" }
        },
        {
            "name": "Proc",
            "scope": ["entity.name.proc"],
            "settings": { "foreground": "#DCDCAA" }
        },
        {
            "name": "ProcDef",
            "scope": ["entity.name.proc.def"],
            "settings": { "foreground": "#99bbbb" }
        },
        {
            "name": "ProcFlowCtrl",
            "scope": ["entity.name.proc.flowctrl"],
            "settings": { "foreground": "#66bbff" }
        },
        {
            "name": "ProcMove",
            "scope": ["entity.name.proc.move"],
            "settings": { "foreground": "#ffd6b5" }
        },
        {
            "name": "Function",
            "scope": ["entity.name.function"],
            "settings": { "foreground": "#DCDCAA" }
        },
        {
            "name": "Numeric",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#ddffee" }
        },
        {
            "name": "StepNo",
            "scope": ["address.stepno.hrscript"],
            "settings": { "foreground": "#eeccdd" }
        },
        {
            "name": "Pose",
            "scope": ["constant.language.pose.hrscript"],
            "settings": { "foreground": "#AACCEE" }
        },
        {
            "name": "LineNo",
            "scope": ["address.lineno.hrscript"],
            "settings": { "foreground": "#eeccdd" }
        },
        {
            "name": "Label",
            "scope": ["address.label.hrscript"],
            "settings": { "foreground": "#eeccdd" }
        },
        {
            "name": "Test1",
            "scope": ["my-keyword.hrscript"],
            "settings": { "foreground": "#0000ff" }
        },
        {
            "name": "Test2",
            "scope": ["my-dual-keyword2.hrscript"],
            "settings": { "foreground": "#00ff00" }
        },
        {
            "name": "Test3",
            "scope": ["my-test3.hrscript"],
            "settings": { "foreground": "#ff00ff" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
