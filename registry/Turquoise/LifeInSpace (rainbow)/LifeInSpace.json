            "settings": { "foreground": "#aa00ff" }
        },
        {
            "scope": ["string.quoted.single.js"],
            "settings": { "foreground": "#FFD587" }
        },
        {
            "scope": ["comment.block.js"],
            "settings": { "foreground": "#546868" }
        },
        {
            "scope": ["keyword.control.conditional.js"],
            "settings": { "foreground": "#EB00FF" }
        },
        {
            "scope": ["source.scss keyword.control"],
            "settings": { "foreground": "#729EFF" }
        },
        {
            "scope": ["markup.inserted"],
            "settings": { "foreground": "#FF2553" }
        },
        {
            "scope": ["markup.deleted"],
            "settings": { "foreground": "#C102FF" }
        },
        {
            "scope": ["markup.changed"],
            "settings": { "foreground": "#729EFF" }
