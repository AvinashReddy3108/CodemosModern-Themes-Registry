        },
        {
            "scope": [
                "source.js",
                "constant.other.object.key",
                "string.unquoted.label.js"
            ],
            "settings": { "foreground": "#00BEFF", "fontStyle": "italic" }
        },
        {
            "scope": ["support.type.property-name.json"],
