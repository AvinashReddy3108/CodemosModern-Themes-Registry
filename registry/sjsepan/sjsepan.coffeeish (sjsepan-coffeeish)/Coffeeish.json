{
    "name": "coffeish",
    "$schema": "vscode://schemas/color-theme",
    "type": "light",
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "enumMember": { "foreground": "#0fcf24" },
        "variable.constant": { "foreground": "#0fcf24" },
        "variable.defaultLibrary": { "foreground": "#0fcf24" }
    },
    "colors": {
        "activityBar.activeBorder": "#f7e4d6",
        "activityBar.background": "#280c00",
        "activityBar.border": "#280C00",
        "activityBar.foreground": "#fffffe",
        "activityBar.inactiveForeground": "#f2e3daf0",
        "activityBarBadge.background": "#bd0303",
        "activityBarBadge.foreground": "#eec6c6",
        "badge.background": "#bd0303",
        "badge.foreground": "#eec6c6",
        "breadcrumb.background": "#fff2e6",
        "editor.background": "#fefdf7",
        "editor.foreground": "#7d301f",
        "editor.lineHighlightBackground": "#fadfc9",
        "editor.selectionBackground": "#fff0d5",
        "editorCursor.foreground": "#e43d00",
        "editorGroup.border": "#280C00",
        "editorGroup.emptyBackground": "#fff2e6",
        "editorGroupHeader.tabsBackground": "#FCEDDC",
        "editorGroupHeader.tabsBorder": "#280C00",
        "editorGutter.background": "#fff2e6",
        "editorHoverWidget.background": "#FCEDDC",
        "editorHoverWidget.border": "#c8c8c8",
        "editorHoverWidget.foreground": "#570606",
        "editorLineNumber.activeForeground": "#0b216f",
        "editorLineNumber.foreground": "#da762a",
        "editorSuggestWidget.selectedBackground": "#dec280",
        "editorWhitespace.foreground": "#f7d3ad",
        "editorWidget.background": "#FCEDDC",
        "editorWidget.foreground": "#570606",
        "editorWidget.resizeBorder": "#c7c7c7",
        "input.background": "#FEFDF7",
        "input.border": "#00000000",
        "input.foreground": "#830909",
        "input.placeholderForeground": "#767676",
        "list.activeSelectionBackground": "#e8590080",
        "list.activeSelectionForeground": "#ffffff",
        "list.dropBackground": "#fff0d6",
        "list.errorForeground": "#b01011",
        "list.filterMatchBackground": "#ea5c0055",
        "list.focusBackground": "#ffe2d6f9",
        "list.highlightForeground": "#e15600",
        "list.hoverBackground": "#fddd92",
        "list.inactiveSelectionBackground": "#fdefc0",
        "list.invalidItemForeground": "#b89500",
        "list.warningForeground": "#855f00",
        "listFilterWidget.background": "#efc1ad",
        "listFilterWidget.noMatchesOutline": "#be1100",
        "listFilterWidget.outline": "#fcfbfb00",
        "menu.background": "#ffffff",
        "menu.foreground": "#6d0606",
        "minimap.background": "#fff2e6",
        "minimapSlider.activeBackground": "#00000040",
        "minimapSlider.background": "#00000020",
        "minimapSlider.hoverBackground": "#00000060",
        "notificationCenter.border": "#d5d5d5",
        "notificationCenterHeader.background": "#FCEDDC",
        "notificationCenterHeader.foreground": "#570606",
        "notifications.background": "#FCEDDC",
        "notifications.border": "#e7e7e7",
        "notifications.foreground": "#570606",
        "panel.background": "#fcfaf9",
        "panel.border": "#280C00",
        "panelTitle.activeForeground": "#ba3737f1",
        "panelTitle.inactiveForeground": "#4b4747bf",
        "profileBadge.background": "#bd0303",
        "profileBadge.foreground": "#eec6c6",
        "scrollbar.shadow": "#202020",
        "scrollbarSlider.activeBackground": "#00000040",
        "scrollbarSlider.background": "#00000020",
        "scrollbarSlider.hoverBackground": "#00000060",
        "settings.dropdownBackground": "#ffffff",
        "settings.dropdownBorder": "#dba276",
        "settings.dropdownListBorder": "#c29c85",
        "settings.headerForeground": "#444444",
        "settings.modifiedItemIndicator": "#66afe0",
        "sideBar.background": "#fceddc",
        "sideBar.border": "#280C00",
        "sideBar.dropBackground": "#0000001a",
        "sideBarSectionHeader.background": "#80808033",
        "statusBar.background": "#FCEDDC",
        "statusBar.border": "#280C00",
        "statusBar.debuggingBackground": "#cc6633",
        "statusBar.debuggingForeground": "#ffffff",
        "statusBar.foreground": "#570606",
        "statusBar.noFolderBackground": "#FCEDDC",
        "statusBar.noFolderBorder": "#280C00",
        "statusBar.noFolderForeground": "#570606",
        "tab.activeBackground": "#fdead8",
        "tab.activeBorder": "#280C00",
        "tab.activeBorderTop": "#280C00",
        "tab.activeForeground": "#333333",
        "tab.hoverBorder": "#280C00",
        "tab.hoverBackground": "#fdead8",
        "tab.activeModifiedBorder": "#ed5402",
        "tab.inactiveBackground": "#ffdec3",
        "tab.inactiveForeground": "#473e26b3",
        "terminal.background": "#fcf9f8",
        "terminal.border": "#280C00",
        "terminal.foreground": "#452304",
        "titleBar.activeBackground": "#FCEDDC",
        "titleBar.activeForeground": "#4f3822",
        "titleBar.border": "#280C00",
        "titleBar.inactiveBackground": "#FCEDDCcc",
        "titleBar.inactiveForeground": "#9d8264cc",
        "widget.shadow": "#292929"
    },
    "tokenColors": [
        { "scope": "comment", "settings": { "foreground": "#137e00e7" } },
        { "scope": "string", "settings": { "foreground": "#c73905" } },
        {
            "scope": "constant.numeric",
            "settings": { "foreground": "#3e8501" }
        },
        {
            "scope": "constant.language",
            "settings": { "foreground": "#ff6302" }
        },
        {
            "scope": "constant.character, constant.other",
            "settings": { "foreground": "#f0b606" }
        },
        {
            "scope": "variable",
            "settings": { "foreground": "#9b0303", "fontStyle": "" }
        },
        { "scope": "keyword", "settings": { "foreground": "#ff6c10" } },
        {
            "scope": "storage",
            "settings": { "foreground": "#ea6a25", "fontStyle": "" }
        },
        {
            "scope": "storage.type",
            "settings": { "foreground": "#cb6540", "fontStyle": "italic" }
        },
        {
            "scope": "entity.name.class",
            "settings": { "foreground": "#0c4124", "fontStyle": "underline" }
        },
        {
            "scope": "entity.other.inherited-class",
            "settings": {
                "foreground": "#f39472",
                "fontStyle": "italic underline"
            }
        },
        {
            "scope": "entity.name.function",
            "settings": { "foreground": "#d02c07", "fontStyle": "" }
        },
        {
            "scope": "variable.parameter",
            "settings": { "foreground": "#ea1707", "fontStyle": "italic" }
        },
        {
            "scope": "entity.name.tag",
            "settings": { "foreground": "#1d6c03", "fontStyle": "underline" }
        },
        {
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#cf4f0a", "fontStyle": "" }
        },
        {
            "scope": "support.function",
            "settings": { "foreground": "#d85904", "fontStyle": "" }
        },
        {
            "scope": "support.constant",
            "settings": { "foreground": "#df2f07", "fontStyle": "" }
        },
        {
            "scope": "support.type, support.class",
            "settings": { "foreground": "#CB1B45", "fontStyle": "italic" }
        },
        {
            "scope": "support.other.variable",
            "settings": { "foreground": "#EB7A77", "fontStyle": "" }
        },
        {
            "scope": "invalid",
            "settings": { "foreground": "#fee6df", "fontStyle": "" }
        },
        {
            "scope": "invalid.deprecated",
            "settings": { "foreground": "#fee6df" }
        },
        { "scope": "meta.attribute", "settings": { "foreground": "#eec3a9" } },
        {
            "scope": "token.info-token",
            "settings": { "foreground": "#bb110e" }
        },
        {
            "scope": "token.warn-token",
            "settings": { "foreground": "#CD9731" }
        },
        {
            "scope": "token.error-token",
            "settings": { "foreground": "#ad4949" }
        },
        {
            "scope": "token.debug-token",
            "settings": { "foreground": "#800080" }
        },
        { "scope": "terminal.background", "settings": {} }
    ]
}
