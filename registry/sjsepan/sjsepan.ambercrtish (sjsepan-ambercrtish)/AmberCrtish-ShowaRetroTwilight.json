    "tokenColors": [
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#D28E3980", "fontStyle": "italic" }
        },
        {
            "scope": ["string", "punctuation.definition.string"],
            "settings": { "foreground": "#E0A20A" }
        },
        {
            "scope": "constant.numeric",
            "settings": { "foreground": "#E0A20A" }
        },
        {
            "scope": "constant.language",
            "settings": { "foreground": "#DE693D", "fontStyle": "bold" }
        },
        {
            "scope": ["constant.character", "constant.other"],
            "settings": { "foreground": "#E0A20A" }
        },
        { "scope": "variable", "settings": { "foreground": "#D28E39" } },
        {
            "scope": "variable.language",
            "settings": { "foreground": "#DE693D", "fontStyle": "italic" }
        },
        {
            "scope": "keyword",
            "settings": { "foreground": "#DE693D", "fontStyle": "bold" }
        },
        {
            "scope": "storage",
            "settings": { "foreground": "#DE693D", "fontStyle": "" }
        },
        {
            "scope": "storage.type",
            "settings": { "foreground": "#D28E39", "fontStyle": "italic" }
        },
        {
            "scope": ["entity.name.type", "entity.name.class", "support.class"],
            "settings": {
                "foreground": "#D28E39",
                "fontStyle": "bold underline"
            }
        },
        {
            "scope": "entity.other.inherited-class",
            "settings": {
                "foreground": "#D28E39",
                "fontStyle": "italic underline"
            }
        },
        {
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#D28E39", "fontStyle": "bold" }
        },
        {
            "scope": "variable.parameter",
            "settings": { "foreground": "#D28E39", "fontStyle": "italic" }
        },
        {
            "scope": "entity.name.tag",
            "settings": { "foreground": "#DE693D", "fontStyle": "bold" }
        },
        {
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#E0A20A", "fontStyle": "italic" }
        },
        {
            "scope": "support.function",
            "settings": { "foreground": "#E0A20A", "fontStyle": "bold" }
        },
        {
            "scope": "support.constant",
            "settings": { "foreground": "#E0A20A" }
        },
        {
            "scope": ["support.type", "support.class"],
            "settings": { "foreground": "#E0A20A", "fontStyle": "italic" }
        },
        {
            "scope": "support.variable",
            "settings": { "foreground": "#E0A20A" }
        },
        {
            "scope": "invalid",
            "settings": { "foreground": "#0C0907", "background": "#DE693D" }
        },
        {
            "scope": "invalid.deprecated",
            "settings": { "foreground": "#0C0907", "background": "#E0A20A" }
        },
        {
            "scope": "support.type.property-name.json",
            "settings": { "foreground": "#DE693D" }
        },
        {
            "scope": "string.quoted.double.json",
            "settings": { "foreground": "#E0A20A" }
        },
        {
            "scope": "constant.language.json",
            "settings": { "foreground": "#D28E39" }
        },
        {
            "scope": "markup.heading",
            "settings": { "foreground": "#DE693D", "fontStyle": "bold" }
        },
        {
            "scope": "markup.underline.link",
            "settings": { "foreground": "#E0A20A", "fontStyle": "underline" }
        },
        {
            "scope": "markup.bold",
            "settings": { "foreground": "#D28E39", "fontStyle": "bold" }
        },
        {
            "scope": "markup.italic",
            "settings": { "foreground": "#D28E39", "fontStyle": "italic" }
        },
        {
            "scope": "markup.inline.raw",
            "settings": { "foreground": "#E0A20A" }
        },
        {
            "scope": "token.info-token",
            "settings": { "foreground": "#6796E6" }
        },
        {
            "scope": "token.warn-token",
            "settings": { "foreground": "#CD9731" }
        },
        {
            "scope": "token.error-token",
            "settings": { "foreground": "#F44747" }
        },
        {
            "scope": "token.debug-token",
