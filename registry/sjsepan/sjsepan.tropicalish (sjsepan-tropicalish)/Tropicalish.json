    "tokenColors": [
        {
            "name": "Invalid - Illegal",
            "scope": "invalid.illegal",
            "settings": { "foreground": "#FF5C56" }
        },
        {
            "name": "Property names",
            "scope": [
                "meta.object-literal.key",
                "meta.object-literal.key constant.character.escape",
                "meta.object-literal string",
                "meta.object-literal string constant.character.escape",
                "support.type.property-name",
                "support.type.property-name constant.character.escape"
            ],
            "settings": { "foreground": "#118f69" }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "storage",
                "meta.class storage.type",
                "keyword.operator.expression.import",
                "keyword.operator.new"
            ],
            "settings": { "foreground": "#e98800" }
        },
        {
            "name": "Types",
            "scope": [
                "support.type",
                "meta.type.annotation entity.name.type",
                "new.expr meta.type.parameters entity.name.type",
                "storage.type.primitive",
                "storage.type.built-in.primitive",
                "meta.function.parameter storage.type"
            ],
            "settings": { "foreground": "#2DAE58" }
        },
        {
            "name": "Annotations",
            "scope": ["storage.type.annotation"],
            "settings": { "foreground": "#C25193" }
        },
        {
            "name": "Units",
            "scope": "keyword.other.unit",
            "settings": { "foreground": "#FF5C57CC" }
        },
        {
            "name": "Language Constants",
            "scope": [
                "constant.language",
                "support.constant",
                "variable.language"
            ],
            "settings": { "foreground": "#2DAE58" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "support.variable"],
            "settings": { "foreground": "#565869" }
        },
        {
            "name": "this Variables",
            "scope": "variable.language.this",
            "settings": { "foreground": "#2d910f" }
        },
        {
            "name": "Functions",
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#089eb9" }
        },
        {
            "name": "Decorators",
            "scope": ["entity.name.function.decorator"],
            "settings": { "foreground": "#118f69" }
        },
        {
            "name": "Classes",
            "scope": [
                "meta.class entity.name.type",
                "new.expr entity.name.type",
                "entity.other.inherited-class",
                "support.class"
            ],
            "settings": { "foreground": "#2d910f" }
        },
        {
            "name": "Preprocessors",
            "scope": [
                "keyword.preprocessor.pragma",
                "keyword.control.directive.include",
                "keyword.other.preprocessor"
            ],
            "settings": { "foreground": "#118f69" }
        },
        {
            "name": "Exceptions",
            "scope": "entity.name.exception",
            "settings": { "foreground": "#FF5C56" }
        },
        { "name": "Sections", "scope": "entity.name.section", "settings": {} },
        {
            "name": "Numbers, Characters",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#FF5C57" }
        },
        {
            "name": "Constants",
            "scope": ["constant", "constant.character"],
            "settings": { "foreground": "#2DAE58" }
        },
        {
            "name": "Strings",
            "scope": "string",
            "settings": { "foreground": "#ebb100" }
        },
        {
            "name": "Strings",
            "scope": "string",
            "settings": { "foreground": "#ebb100" }
        },
        {
            "name": "Strings: Escape Sequences",
            "scope": "constant.character.escape",
            "settings": { "foreground": "#F5B900" }
        },
        {
            "name": "Strings: Regular Expressions",
            "scope": [
                "string.regexp",
                "string.regexp constant.character.escape"
            ],
            "settings": { "foreground": "#2d910f" }
        },
        {
            "name": "Strings: Regular Expressions Punctuation",
            "scope": ["string.regexp punctuation"],
            "settings": { "foreground": "#00A39F" }
        },
        {
            "name": "Strings: Regular Expressions Special Characters",
            "scope": [
                "string.regexp keyword",
                "string.regexp keyword.control",
                "string.regexp constant"
            ],
            "settings": { "foreground": "#e98800" }
        },
        {
            "name": "Strings: Regular Expressions Modifier Flags",
            "scope": ["string.regexp keyword.other"],
            "settings": { "foreground": "#00A39FBB" }
        },
        {
            "name": "Strings: Symbols",
            "scope": "constant.other.symbol",
            "settings": { "foreground": "#ebb100" }
        },
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "fontStyle": "italic", "foreground": "#ADB1C2" }
        },
        {
            "name": "Comments: Preprocessor",
            "scope": "comment.block.preprocessor",
            "settings": { "fontStyle": "", "foreground": "#9194A2" }
        },
        {
            "name": "DocBlock: Type",
            "scope": "comment.block.documentation entity.name.type",
            "settings": { "foreground": "#2DAE58" }
        },
        {
            "name": "DocBlock: Keyword",
            "scope": [
                "comment.block.documentation storage",
                "comment.block.documentation keyword.other",
                "meta.class comment.block.documentation storage.type"
            ],
            "settings": { "foreground": "#9194A2" }
        },
        {
            "name": "DocBlock: Variable",
            "scope": ["comment.block.documentation variable"],
            "settings": { "foreground": "#C25193" }
        },
        {
            "name": "Punctuation",
            "scope": ["punctuation"],
            "settings": { "foreground": "#ADB1C2" }
        },
        {
            "name": "Operators",
            "scope": [
                "keyword.operator",
                "keyword.other.arrow",
                "keyword.control.@"
            ],
            "settings": { "foreground": "#ADB1C2" }
        },
        {
            "name": "HTML: Doctype Declaration",
            "scope": [
                "meta.tag.metadata.doctype.html entity.name.tag",
                "meta.tag.metadata.doctype.html entity.other.attribute-name.html",
                "meta.tag.sgml.doctype",
                "meta.tag.sgml.doctype string",
                "meta.tag.sgml.doctype entity.name.tag",
                "meta.tag.sgml punctuation.definition.tag.html"
            ],
            "settings": { "foreground": "#9194A2" }
        },
        {
            "name": "HTML: Tags",
            "scope": [
                "meta.tag",
                "punctuation.definition.tag.html",
                "punctuation.definition.tag.begin.html",
                "punctuation.definition.tag.end.html"
            ],
            "settings": { "foreground": "#ADB1C2" }
        },
        {
            "name": "HTML: Tag Names",
            "scope": "entity.name.tag",
            "settings": { "foreground": "#2d910f" }
        },
        {
            "name": "HTML: Attribute Names",
            "scope": [
                "meta.tag entity.other.attribute-name",
                "entity.other.attribute-name.html"
            ],
            "settings": { "foreground": "#e98800" }
        },
        {
            "name": "HTML: Entities",
            "scope": [
                "constant.character.entity",
                "punctuation.definition.entity"
            ],
            "settings": { "foreground": "#ebb100" }
        },
        {
            "name": "CSS: Selectors",
            "scope": [
                "meta.selector",
                "meta.selector entity",
                "meta.selector entity punctuation",
                "source.css entity.name.tag"
            ],
            "settings": { "foreground": "#e98800" }
        },
        {
            "name": "CSS: Variables",
            "scope": "source.css variable",
            "settings": { "foreground": "#118f69" }
        },
        {
            "name": "CSS: Punctuation",
            "scope": "punctuation.definition.entity.css",
            "settings": { "foreground": "#FF82CBBB" }
        },
        {
            "name": "CSS: Property Names",
            "scope": [
                "source.css meta.property-name",
                "source.css support.type.property-name"
            ],
            "settings": { "foreground": "#565869" }
        },
        {
            "name": "CSS: Vendored Property Names",
            "scope": ["source.css support.type.vendored.property-name"],
            "settings": { "foreground": "#565869AA" }
        },
        {
            "name": "CSS: Property Values",
            "scope": ["meta.property-value", "support.constant.property-value"],
            "settings": { "foreground": "#2d910f" }
        },
        {
            "name": "CSS: Constant",
            "scope": ["source.css support.constant"],
            "settings": { "foreground": "#2DAE58" }
        },
        {
            "name": "CSS: Pseudo classes",
            "scope": [
                "entity.other.attribute-name.pseudo-class.css",
                "entity.other.attribute-name.pseudo-element.css"
            ],
            "settings": { "foreground": "#ebb100" }
        },
        {
            "name": "CSS: Functions",
            "scope": ["source.css support.function"],
            "settings": { "foreground": "#089eb9" }
        },
        {
            "name": "CSS: Important Keyword",
            "scope": "keyword.other.important",
            "settings": { "foreground": "#2d910f" }
        },
        {
            "name": "SCSS: Class names & IDs",
            "scope": [
                "source.css.scss entity.other.attribute-name.class.css",
                "source.css.scss entity.other.attribute-name.id.css"
            ],
            "settings": { "foreground": "#e98800" }
        },
        {
            "name": "Less: Class names",
            "scope": ["source.css.less entity.other.attribute-name.class.css"],
            "settings": { "foreground": "#e98800" }
        },
        {
            "name": "Stylus: Curly Braces",
            "scope": "source.stylus meta.brace.curly.css",
            "settings": { "foreground": "#ADB1C2" }
        },
        {
            "name": "Stylus: Selectors",
            "scope": [
                "source.stylus entity.other.attribute-name.class",
                "source.stylus entity.other.attribute-name.id",
                "source.stylus entity.name.tag"
            ],
            "settings": { "foreground": "#e98800" }
        },
        {
            "name": "Stylus: Properties",
            "scope": ["source.stylus support.type.property-name"],
            "settings": { "foreground": "#565869" }
        },
        {
            "name": "Stylus: Variables",
            "scope": ["source.stylus variable"],
            "settings": { "foreground": "#118f69" }
        },
        {
            "name": "Markup: Changed",
            "scope": "markup.changed",
            "settings": { "foreground": "#888888" }
        },
        {
            "name": "Markup: Deletion",
            "scope": "markup.deleted",
            "settings": { "foreground": "#888888" }
        },
        {
            "name": "Markup: Emphasis",
            "scope": "markup.italic",
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "Markup: Error",
            "scope": "markup.error",
            "settings": { "foreground": "#FF5C56" }
        },
        {
            "name": "Markup: Insertion",
            "scope": "markup.inserted",
            "settings": { "foreground": "#888888" }
        },
        {
            "name": "Markup: Link",
            "scope": "meta.link",
            "settings": { "foreground": "#ebb100" }
        },
        {
            "name": "Markup: Link Title",
            "scope": "string.other.link.title.markdown",
            "settings": { "foreground": "#089eb9" }
        },
        {
            "name": "Markup: Output",
            "scope": ["markup.output", "markup.raw"],
            "settings": { "foreground": "#999999" }
        },
        {
            "name": "Markup: Prompt",
            "scope": "markup.prompt",
            "settings": { "foreground": "#999999" }
        },
        {
            "name": "Markup: Heading",
            "scope": "markup.heading",
            "settings": { "foreground": "#2DAE58" }
        },
        {
            "name": "Markup: Strong",
            "scope": "markup.bold",
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Markup: Traceback",
            "scope": "markup.traceback",
            "settings": { "foreground": "#FF5C56" }
        },
        {
            "name": "Markup: Underline",
            "scope": "markup.underline",
            "settings": { "fontStyle": "underline" }
        },
        {
            "name": "Markup Quote",
            "scope": "markup.quote",
            "settings": { "foreground": "#777985" }
        },
        {
            "name": "Markup Styling",
            "scope": ["markup.bold", "markup.italic"],
            "settings": { "foreground": "#2d910f" }
        },
        {
            "name": "Markup Inline",
            "scope": "markup.inline.raw",
            "settings": { "fontStyle": "", "foreground": "#e98800" }
        },
        {
            "name": "JavaScript: Braces and fat arrow",
            "scope": [
                "meta.brace.round",
                "meta.brace.square",
                "storage.type.function.arrow"
            ],
            "settings": { "foreground": "#ADB1C2" }
        },
        {
            "scope": ["support.function.js"],
            "settings": { "foreground": "#118f69" }
        },
        {
            "name": "JavaScript: RegExp",
            "scope": "string.regexp.js",
            "settings": { "foreground": "#2d910f" }
        },
        {
            "name": "JavaScript: super() call and Node.js 'module'",
            "scope": [
                "variable.language.super",
                "support.type.object.module.js"
            ],
            "settings": { "foreground": "#e98800" }
        },
        {
            "name": "JSX: Plain text",
            "scope": "meta.jsx.children",
            "settings": { "foreground": "#686968" }
        },
        {
            "name": "YAML: Keys",
            "scope": "entity.name.tag.yaml",
            "settings": { "foreground": "#118f69" }
        },
        {
            "name": "YAML: Keys",
            "scope": "variable.other.alias.yaml",
            "settings": { "foreground": "#2DAE58" }
        },
        {
            "name": "PHP: Start / End Tags",
            "scope": [
                "punctuation.section.embedded.begin.php",
                "punctuation.section.embedded.end.php"
            ],
            "settings": { "foreground": "#75798F" }
        },
        {
            "name": "PHP: Use Aliases",
            "scope": ["meta.use.php entity.other.alias.php"],
            "settings": { "foreground": "#2d910f" }
        },
        {
            "name": "PHP: Constructs",
            "scope": [
                "source.php support.function.construct",
                "source.php support.function.var"
