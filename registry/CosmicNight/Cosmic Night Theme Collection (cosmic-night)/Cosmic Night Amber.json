{
    "name": "Cosmic Night Amber",
    "type": "dark",
    "colors": {
        "editor.background": "#1A1711",
        "editor.foreground": "#F3EDE2",
        "activityBar.background": "#16130F",
        "activityBar.foreground": "#FFB84A",
        "sideBar.background": "#1A1711",
        "sideBar.foreground": "#E2D1B8",
        "titleBar.activeBackground": "#16130F",
        "statusBar.background": "#16130F",
        "statusBar.foreground": "#FFB84A",
        "tab.activeBackground": "#1A1711",
        "tab.inactiveBackground": "#16130F",
        "editorGroupHeader.tabsBackground": "#16130F",
        "editor.selectionBackground": "#4F3D1F",
        "editor.wordHighlightBackground": "#4F3D1F",
        "editor.lineHighlightBackground": "#2E2314",
        "button.background": "#FFB84A",
        "button.foreground": "#16130F",
        "button.hoverBackground": "#FFCB7F",
        "progressBar.background": "#FFB84A",
        "inputOption.activeBorder": "#FFB84A",
        "focusBorder": "#FFB84A50"
    },
    "tokenColors": [
        {
            "name": "Comments",
            "scope": [
                "comment",
                "punctuation.definition.comment",
                "comment.line.double-slash",
                "comment.block",
                "comment.block.documentation",
                "comment.line.number-sign.python",
                "comment.line.hash.ruby",
                "comment.line.percentage.ruby"
            ],
            "settings": { "foreground": "#9F8661", "fontStyle": "italic" }
        },
        {
            "name": "Variables",
            "scope": [
                "variable",
                "string constant.other.placeholder",
                "variable.other.readwrite",
                "variable.other.object",
                "variable.parameter",
                "variable.language",
                "variable.other.property",
                "variable.other.ruby",
                "variable.other.php",
                "variable.other.normal.shell",
                "variable.other.special.rust"
            ],
            "settings": { "foreground": "#F3EDE2" }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "storage.type",
                "storage.modifier",
                "keyword.control",
                "keyword.operator.new",
                "keyword.operator.expression",
                "keyword.declaration",
                "keyword.control.flow",
                "storage.type.class.python",
                "storage.type.function.python",
                "storage.type.js",
                "storage.type.ts",
                "storage.type.java",
                "storage.type.kotlin",
                "storage.type.rust",
                "storage.type.cs",
                "storage.type.go"
            ],
            "settings": { "foreground": "#FFB84A" }
        },
        {
            "name": "Operators",
            "scope": [
                "keyword.operator",
                "punctuation",
                "meta.brace",
                "meta.delimiter",
                "punctuation.definition.parameters",
                "punctuation.separator",
                "punctuation.terminator",
                "punctuation.accessor",
                "keyword.operator.arithmetic",
                "keyword.operator.comparison",
                "keyword.operator.assignment"
            ],
            "settings": { "foreground": "#FFD700" }
        },
        {
            "name": "Tags and Components",
            "scope": [
                "entity.name.tag",
                "support.class.component",
                "entity.name.tag.html",
                "entity.name.tag.xml",
                "entity.name.tag.jsx",
                "entity.name.tag.tsx",
                "entity.name.tag.css",
                "entity.name.tag.custom",
                "punctuation.definition.tag"
            ],
            "settings": { "foreground": "#FFC773" }
        },
        {
            "name": "Function calls",
            "scope": [
                "entity.name.function",
                "meta.function-call",
                "variable.function",
                "support.function",
                "keyword.other.special-method",
                "meta.method-call",
                "meta.function",
                "support.function.builtin",
                "support.function.core",
                "support.function.dom",
                "support.function.php",
                "support.function.magic.python"
            ],
            "settings": { "foreground": "#FFD68A" }
        },
        {
            "name": "Numbers and Constants",
            "scope": [
                "constant.numeric",
                "constant.language",
                "support.constant",
                "constant.character",
                "constant.escape",
                "keyword.other.unit",
                "constant.other.color",
                "constant.other.symbol",
                "constant.other.key",
                "support.constant.property-value",
                "constant.numeric.decimal"
            ],
            "settings": { "foreground": "#FFA94D" }
        },
        {
            "name": "Strings",
            "scope": [
                "string",
                "string.quoted.single",
                "string.quoted.double",
                "string.template",
                "string.interpolated",
                "string.regexp",
                "string.other.link",
                "string.quoted.backtick",
                "string.unquoted.heredoc"
            ],
            "settings": { "foreground": "#98FF98" }
        },
        {
            "name": "Classes and Types",
            "scope": [
                "entity.name.type",
                "support.type",
                "support.class",
                "storage.type.generic",
                "storage.type.primitive",
                "entity.name.class",
                "entity.other.inherited-class",
                "entity.name.struct",
                "entity.name.enum",
                "entity.name.interface",
                "support.type.primitive"
            ],
            "settings": { "foreground": "#FFE5B4" }
        },
        {
            "name": "HTML/JSX Attributes",
            "scope": [
                "entity.other.attribute-name",
                "entity.other.attribute-name.html",
                "entity.other.attribute-name.jsx",
                "entity.other.attribute-name.tsx",
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css"
            ],
            "settings": { "foreground": "#FFD68A" }
        },
        {
            "name": "Decorators and Annotations",
            "scope": [
                "meta.decorator",
                "meta.decorator entity.name.function",
                "meta.decorator variable.other.readwrite",
                "meta.decorator punctuation.decorator",
                "storage.type.annotation",
                "punctuation.definition.annotation"
            ],
            "settings": { "foreground": "#FFB84A" }
        },
        {
            "name": "CSS Properties and Values",
            "scope": [
                "support.type.property-name.css",
                "support.type.property-name.scss",
                "support.type.property-name.less",
                "support.type.property-name.sass",
                "support.type.vendored.property-name",
                "support.constant.property-value.css"
            ],
            "settings": { "foreground": "#FFC773" }
        },
        {
            "name": "Language-specific Keywords",
            "scope": [
                "keyword.control.import",
                "keyword.control.export",
                "keyword.control.from",
                "keyword.control.default",
                "keyword.control.async",
                "keyword.control.await",
                "storage.type.class.python",
                "storage.type.function.python",
                "storage.modifier.rust",
                "keyword.declaration.rust"
            ],
            "settings": { "foreground": "#FFB84A" }
        },
        {
            "name": "Template Literals",
            "scope": [
                "punctuation.definition.template-expression",
                "punctuation.section.embedded",
                "meta.embedded.line"
            ],
            "settings": { "foreground": "#FFD700" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
