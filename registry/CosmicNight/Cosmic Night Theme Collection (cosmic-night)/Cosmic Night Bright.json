{
    "name": "Cosmic Night Bright",
    "type": "dark",
    "colors": {
        "editor.background": "#0D1218",
        "editor.foreground": "#E8F3FF",
        "activityBar.background": "#0B1015",
        "activityBar.foreground": "#76DFEB",
        "sideBar.background": "#0D1218",
        "sideBar.foreground": "#B7C8DC",
        "titleBar.activeBackground": "#0B1015",
        "statusBar.background": "#0B1015",
        "statusBar.foreground": "#76DFEB",
        "tab.activeBackground": "#0D1218",
        "tab.inactiveBackground": "#0B1015",
        "editorGroupHeader.tabsBackground": "#0B1015",
        "editor.selectionBackground": "#223445",
        "editor.wordHighlightBackground": "#223445",
        "editor.lineHighlightBackground": "#111720"
    },
    "tokenColors": [
        {
            "name": "Comments and Documentation",
            "scope": [
                "comment",
                "punctuation.definition.comment",
                "comment.block.documentation",
                "comment.block.javadoc",
                "comment.line.double-slash",
                "comment.line.number-sign.python",
                "comment.line.hash.ruby",
                "comment.block.documentation.rust",
                "comment.line.documentation.rust",
                "comment.block.documentation.ts",
                "comment.block.html"
            ],
            "settings": { "foreground": "#627185", "fontStyle": "italic" }
        },
        {
            "name": "Variables and Parameters",
            "scope": [
                "variable",
                "string constant.other.placeholder",
                "variable.other.readwrite",
                "variable.parameter",
                "variable.other.object",
                "variable.language",
                "variable.other.property",
                "variable.other.member",
                "variable.scss",
                "variable.other.php",
                "variable.other.normal.shell",
                "variable.other.special.rust"
            ],
            "settings": { "foreground": "#D8E3F0" }
        },
        {
            "name": "Keywords and Control",
            "scope": [
                "keyword",
                "storage.type",
                "storage.modifier",
                "keyword.control",
                "keyword.operator.new",
                "keyword.operator.expression",
                "keyword.control.flow",
                "storage.type.class.python",
                "storage.type.function.python",
                "keyword.other.fn.rust",
                "storage.type.cs",
                "keyword.package.go",
                "storage.type.kotlin",
                "keyword.control.import",
                "keyword.control.export",
                "keyword.control.default"
            ],
            "settings": { "foreground": "#D7A2FA" }
        },
        {
            "name": "Operators and Delimiters",
            "scope": [
                "keyword.operator",
                "punctuation",
                "meta.brace",
                "meta.delimiter",
                "punctuation.definition.parameters",
                "punctuation.separator",
                "punctuation.terminator",
                "punctuation.accessor",
                "keyword.operator.arithmetic",
                "keyword.operator.comparison",
                "keyword.operator.assignment",
                "keyword.operator.type.annotation"
            ],
            "settings": { "foreground": "#76DFEB" }
        },
        {
            "name": "Tags and Components",
            "scope": [
                "entity.name.tag",
                "support.class.component",
                "entity.name.tag.html",
                "entity.name.tag.xml",
                "entity.name.tag.jsx",
                "entity.name.tag.tsx",
                "punctuation.definition.tag",
                "meta.tag.sgml",
                "meta.tag.html",
                "meta.tag.xml"
            ],
            "settings": { "foreground": "#76DFEB" }
        },
        {
            "name": "Functions and Methods",
            "scope": [
                "entity.name.function",
                "meta.function-call",
                "variable.function",
                "support.function",
                "keyword.other.special-method",
                "meta.method-call",
                "meta.function",
                "support.function.builtin",
                "support.function.core",
                "meta.function.python",
                "entity.name.function.go",
                "entity.name.function.rust",
                "entity.name.function.php"
            ],
            "settings": { "foreground": "#92BAFF" }
        },
        {
            "name": "Numbers, Constants and Units",
            "scope": [
                "constant.numeric",
                "constant.language",
                "support.constant",
                "constant.character",
                "constant.escape",
                "keyword.other.unit",
                "constant.other.color",
                "constant.other.symbol",
                "constant.other.key",
                "support.constant.property-value",
                "constant.numeric.decimal",
                "constant.numeric.integer"
            ],
            "settings": { "foreground": "#FF9C7C" }
        },
        {
            "name": "Strings and Text",
            "scope": [
                "string",
                "string.quoted.single",
                "string.quoted.double",
                "string.template",
                "string.interpolated",
                "string.regexp",
                "string.other.link",
                "string.quoted.backtick",
                "string.unquoted.heredoc",
                "string.quoted.triple",
                "string.quoted.docstring.multi.python"
            ],
            "settings": { "foreground": "#9DD8A1" }
        },
        {
            "name": "Classes, Types and Interfaces",
            "scope": [
                "entity.name.type",
                "support.type",
                "support.class",
                "storage.type.generic",
                "storage.type.primitive",
                "entity.name.class",
                "entity.other.inherited-class",
                "entity.name.struct",
                "entity.name.enum",
                "entity.name.interface",
                "support.type.builtin",
                "storage.type.builtin",
                "entity.name.type.class"
            ],
            "settings": { "foreground": "#FFC87C" }
        },
        {
            "name": "HTML/JSX Attributes and Decorators",
            "scope": [
                "entity.other.attribute-name",
                "entity.other.attribute-name.html",
                "entity.other.attribute-name.jsx",
                "entity.other.attribute-name.tsx",
                "entity.other.attribute-name.class.css",
                "meta.decorator",
                "meta.decorator entity.name.function",
                "meta.decorator variable.other.readwrite",
                "meta.decorator punctuation.decorator"
            ],
            "settings": { "foreground": "#FFB7D4" }
        },
        {
            "name": "CSS Properties and Values",
            "scope": [
                "support.type.property-name.css",
                "support.type.property-name.scss",
                "support.type.property-name.less",
                "support.type.property-name.sass",
                "support.constant.property-value.css",
                "support.constant.font-name",
                "meta.property-value.css",
                "meta.property-list.css"
            ],
            "settings": { "foreground": "#76DFEB" }
        },
        {
            "name": "Markup and Markdown",
            "scope": [
                "markup.heading",
                "markup.bold",
                "markup.italic",
                "markup.inline.raw",
                "markup.quote",
                "markup.list",
                "markup.link",
                "markup.underline",
                "markup.raw.block"
            ],
            "settings": { "foreground": "#92BAFF" }
        },
        {
            "name": "Special Language Variables",
            "scope": [
                "variable.language.self",
                "variable.language.this",
                "variable.language.super",
                "variable.language.special.self.python",
                "variable.language.this.php",
                "variable.language.this.ts",
                "variable.language.arguments"
            ],
            "settings": { "foreground": "#D7A2FA", "fontStyle": "italic" }
        },
        {
            "name": "Template Expressions",
            "scope": [
                "punctuation.definition.template-expression",
                "punctuation.section.embedded",
                "meta.embedded.line",
                "meta.template.expression",
                "meta.embedded.expression"
            ],
            "settings": { "foreground": "#76DFEB" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
