{
    "name": "Cosmic Night",
    "type": "dark",
    "colors": {
        "editor.background": "#0B1015",
        "editor.foreground": "#D8E3F0",
        "activityBar.background": "#090D12",
        "activityBar.foreground": "#66CFDB",
        "sideBar.background": "#0B1015",
        "sideBar.foreground": "#A7B8CC",
        "titleBar.activeBackground": "#090D12",
        "statusBar.background": "#090D12",
        "statusBar.foreground": "#66CFDB",
        "tab.activeBackground": "#0B1015",
        "tab.inactiveBackground": "#090D12",
        "editorGroupHeader.tabsBackground": "#090D12",
        "editor.selectionBackground": "#1C2C3B",
        "editor.wordHighlightBackground": "#1C2C3B",
        "editor.lineHighlightBackground": "#0F1419"
    },
    "tokenColors": [
        {
            "name": "Comments and Documentation",
            "scope": [
                "comment",
                "punctuation.definition.comment",
                "comment.block.documentation",
                "comment.block.javadoc",
                "comment.line.double-slash",
                "comment.line.number-sign.python",
                "comment.line.hash.ruby",
                "comment.block.documentation.rust",
                "comment.line.documentation.rust",
                "comment.block.documentation.ts",
                "comment.block.html",
                "comment.block.documentation.php"
            ],
            "settings": { "foreground": "#526175", "fontStyle": "italic" }
        },
        {
            "name": "Variables and Parameters",
            "scope": [
                "variable",
                "string constant.other.placeholder",
                "variable.other.readwrite",
                "variable.parameter",
                "variable.other.object",
                "variable.language",
                "variable.other.property",
                "variable.other.member",
                "variable.scss",
                "variable.other.php",
                "variable.other.normal.shell",
                "variable.other.special.rust",
                "variable.other.readwrite.global"
            ],
            "settings": { "foreground": "#C8D6E5" }
        },
        {
            "name": "Keywords and Control",
            "scope": [
                "keyword",
                "storage.type",
                "storage.modifier",
                "keyword.control",
                "keyword.operator.new",
                "keyword.operator.expression",
                "keyword.control.flow",
                "storage.type.class.python",
                "storage.type.function.python",
                "keyword.other.fn.rust",
                "storage.type.cs",
                "keyword.package.go",
                "storage.type.kotlin",
                "keyword.control.import",
                "keyword.control.export",
                "keyword.control.default",
                "storage.type.class.ts"
            ],
            "settings": { "foreground": "#C792EA" }
        },
        {
            "name": "Operators and Delimiters",
            "scope": [
                "keyword.operator",
                "punctuation",
                "meta.brace",
                "meta.delimiter",
                "punctuation.definition.parameters",
                "punctuation.separator",
                "punctuation.terminator",
                "punctuation.accessor",
                "keyword.operator.arithmetic",
                "keyword.operator.comparison",
                "keyword.operator.assignment",
                "keyword.operator.type.annotation",
                "keyword.operator.optional"
            ],
            "settings": { "foreground": "#66CFDB" }
        },
        {
            "name": "Tags and Components",
            "scope": [
                "entity.name.tag",
                "support.class.component",
                "entity.name.tag.html",
                "entity.name.tag.xml",
                "entity.name.tag.jsx",
                "entity.name.tag.tsx",
                "punctuation.definition.tag",
                "meta.tag.sgml",
                "meta.tag.html",
                "meta.tag.xml"
            ],
            "settings": { "foreground": "#66CFDB" }
        },
        {
            "name": "Function calls",
            "scope": [
                "entity.name.function",
                "meta.function-call",
                "variable.function",
                "support.function",
                "keyword.other.special-method",
                "meta.method-call",
                "meta.function",
                "support.function.builtin",
                "support.function.core",
                "meta.function.python",
                "entity.name.function.go",
                "entity.name.function.rust",
                "entity.name.function.php",
                "support.function.magic"
            ],
            "settings": { "foreground": "#82AAFF" }
        },
        {
            "name": "Numbers and Constants",
            "scope": [
                "constant.numeric",
                "constant.language",
                "support.constant",
                "constant.character",
                "constant.escape",
                "keyword.other.unit",
                "constant.other.color",
                "constant.other.symbol",
                "constant.other.key",
                "support.constant.property-value",
                "constant.numeric.decimal",
                "constant.numeric.integer",
                "constant.numeric.hex"
            ],
            "settings": { "foreground": "#F78C6C" }
        },
        {
            "name": "Strings",
            "scope": [
                "string",
                "string.quoted.single",
                "string.quoted.double",
                "string.template",
                "string.interpolated",
                "string.regexp",
                "string.other.link",
                "string.quoted.backtick",
                "string.unquoted.heredoc",
                "string.quoted.triple",
                "string.quoted.docstring.multi.python"
            ],
            "settings": { "foreground": "#8DC891" }
        },
        {
            "name": "Classes and Types",
            "scope": [
                "entity.name.type",
                "support.type",
                "support.class",
                "storage.type.generic",
                "storage.type.primitive",
                "entity.name.class",
                "entity.other.inherited-class",
                "entity.name.struct",
                "entity.name.enum",
                "entity.name.interface",
                "support.type.builtin",
                "storage.type.builtin",
                "entity.name.type.class",
                "entity.name.type.module"
            ],
            "settings": { "foreground": "#FFB86C" }
        },
        {
            "name": "CSS Properties",
            "scope": [
                "support.type.property-name.css",
                "support.type.property-name.scss",
                "support.type.property-name.less",
                "support.type.property-name.sass",
                "support.type.vendored.property-name"
            ],
            "settings": { "foreground": "#66CFDB" }
        },
        {
            "name": "CSS Values",
            "scope": [
                "support.constant.property-value",
                "support.constant.font-name",
                "support.constant.color",
                "support.constant.media",
                "constant.other.color.rgb-value",
                "constant.other.rgb-value"
            ],
            "settings": { "foreground": "#8DC891" }
        },
        {
            "name": "HTML/JSX Attributes",
            "scope": [
                "entity.other.attribute-name",
                "entity.other.attribute-name.html",
                "entity.other.attribute-name.jsx",
                "entity.other.attribute-name.tsx",
                "entity.other.attribute-name.class.css",
                "meta.decorator",
                "meta.decorator entity.name.function",
                "meta.decorator variable.other.readwrite",
                "meta.decorator punctuation.decorator"
            ],
            "settings": { "foreground": "#FFA7C4" }
        },
        {
            "name": "Markdown and Documentation",
            "scope": [
                "markup.heading",
                "markup.bold",
                "markup.italic",
                "markup.inline.raw",
                "markup.quote",
                "markup.list",
                "markup.link",
                "markup.underline",
                "markup.raw.block"
            ],
            "settings": { "foreground": "#66CFDB", "fontStyle": "bold" }
        },
        {
            "name": "Git Changes",
            "scope": ["markup.changed", "markup.deleted", "markup.inserted"],
            "settings": { "foreground": "#FFB86C" }
        },
        {
            "name": "Special Language Features",
            "scope": [
                "variable.language.self",
                "variable.language.this",
                "variable.language.super",
                "variable.language.special.self.python",
                "variable.language.this.php",
                "variable.language.this.ts",
                "variable.language.arguments"
            ],
            "settings": { "foreground": "#C792EA", "fontStyle": "italic" }
        },
        {
            "name": "Template Expressions",
            "scope": [
                "punctuation.definition.template-expression",
                "punctuation.section.embedded",
                "meta.embedded.line",
                "meta.template.expression"
            ],
            "settings": { "foreground": "#66CFDB" }
        },
        {
            "name": "JSON Structure",
            "scope": [
                "support.type.property-name.json",
                "punctuation.support.type.property-name.begin.json",
                "punctuation.support.type.property-name.end.json"
            ],
            "settings": { "foreground": "#66CFDB" }
        },
        {
            "name": "JavaScript/TypeScript Properties",
            "scope": [
                "variable.other.property.js",
                "variable.other.object.property",
                "variable.other.property.ts",
                "variable.other.property.tsx"
            ],
            "settings": { "foreground": "#82AAFF" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
