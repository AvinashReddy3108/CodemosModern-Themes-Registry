{
    "name": "Cosmic Night Aurora",
    "type": "dark",
    "colors": {
        "editor.background": "#13111B",
        "editor.foreground": "#E8E2F3",
        "activityBar.background": "#110F17",
        "activityBar.foreground": "#B78AFF",
        "sideBar.background": "#13111B",
        "sideBar.foreground": "#C4B8E2",
        "titleBar.activeBackground": "#110F17",
        "statusBar.background": "#110F17",
        "statusBar.foreground": "#B78AFF",
        "tab.activeBackground": "#13111B",
        "tab.inactiveBackground": "#110F17",
        "editorGroupHeader.tabsBackground": "#110F17",
        "editor.selectionBackground": "#2D1F4F",
        "editor.wordHighlightBackground": "#2D1F4F",
        "editor.lineHighlightBackground": "#171422"
    },
    "tokenColors": [
        {
            "name": "Comments and Documentation",
            "scope": [
                "comment",
                "punctuation.definition.comment",
                "comment.block.documentation",
                "comment.block.javadoc",
                "comment.line.double-slash",
                "comment.line.number-sign.python",
                "comment.line.hash.ruby",
                "comment.block.documentation.rust",
                "comment.block.documentation.ts"
            ],
            "settings": { "foreground": "#6B617F", "fontStyle": "italic" }
        },
        {
            "name": "Variables and Parameters",
            "scope": [
                "variable",
                "string constant.other.placeholder",
                "variable.other.readwrite",
                "variable.parameter",
                "variable.other.object",
                "variable.language",
                "variable.other.property",
                "variable.other.member",
                "variable.scss",
                "variable.other.php"
            ],
            "settings": { "foreground": "#E8E2F3" }
        },
        {
            "name": "Keywords and Control",
            "scope": [
                "keyword",
                "storage.type",
                "storage.modifier",
                "keyword.control",
                "keyword.operator.new",
                "keyword.operator.expression",
                "keyword.control.flow",
                "storage.type.class.python",
                "storage.type.function.python",
                "keyword.other.fn.rust",
                "storage.type.cs",
                "keyword.package.go",
                "storage.type.kotlin"
            ],
            "settings": { "foreground": "#FF8FD6" }
        },
        {
            "name": "Operators and Delimiters",
            "scope": [
                "keyword.operator",
                "punctuation",
                "meta.brace",
                "meta.delimiter",
                "punctuation.definition.parameters",
                "punctuation.separator",
                "punctuation.terminator",
                "punctuation.accessor",
                "keyword.operator.arithmetic",
                "keyword.operator.comparison"
            ],
            "settings": { "foreground": "#B78AFF" }
        },
        {
            "name": "Tags and Components",
            "scope": [
                "entity.name.tag",
                "support.class.component",
                "entity.name.tag.html",
                "entity.name.tag.xml",
                "entity.name.tag.jsx",
                "entity.name.tag.tsx",
                "punctuation.definition.tag",
                "meta.tag.sgml",
                "meta.tag.html"
            ],
            "settings": { "foreground": "#C79BFF" }
        },
        {
            "name": "Functions and Methods",
            "scope": [
                "entity.name.function",
                "meta.function-call",
                "variable.function",
                "support.function",
                "keyword.other.special-method",
                "meta.method-call",
                "meta.function",
                "support.function.builtin",
                "support.function.core",
                "meta.function.python",
                "entity.name.function.go"
            ],
            "settings": { "foreground": "#FF9FB8" }
        },
        {
            "name": "Numbers, Constants and Units",
            "scope": [
                "constant.numeric",
                "constant.language",
                "support.constant",
                "constant.character",
                "constant.escape",
                "keyword.other.unit",
                "constant.other.color",
                "constant.other.symbol",
                "constant.other.key",
                "support.constant.property-value"
            ],
            "settings": { "foreground": "#FFB67F" }
        },
        {
            "name": "Strings and Text",
            "scope": [
                "string",
                "string.quoted.single",
                "string.quoted.double",
                "string.template",
                "string.interpolated",
                "string.regexp",
                "string.other.link",
                "string.quoted.backtick",
                "string.unquoted.heredoc",
                "string.quoted.triple"
            ],
            "settings": { "foreground": "#9DFFB3" }
        },
        {
            "name": "Classes, Types and Interfaces",
            "scope": [
                "entity.name.type",
                "support.type",
                "support.class",
                "storage.type.generic",
                "storage.type.primitive",
                "entity.name.class",
                "entity.other.inherited-class",
                "entity.name.struct",
                "entity.name.enum",
                "entity.name.interface",
                "support.type.builtin"
            ],
            "settings": { "foreground": "#FFE5A3" }
        },
        {
            "name": "Attributes and Decorators",
            "scope": [
                "entity.other.attribute-name",
                "entity.other.attribute-name.html",
                "entity.other.attribute-name.jsx",
                "entity.other.attribute-name.tsx",
                "entity.other.attribute-name.class.css",
                "meta.decorator",
                "meta.decorator entity.name.function",
                "meta.decorator variable.other.readwrite"
            ],
            "settings": { "foreground": "#FF9FB8" }
        },
        {
            "name": "CSS Properties and Values",
            "scope": [
                "support.type.property-name.css",
                "support.type.property-name.scss",
                "support.type.property-name.less",
                "support.type.property-name.sass",
                "support.constant.property-value.css",
                "support.constant.font-name",
                "meta.property-value.css"
            ],
            "settings": { "foreground": "#C79BFF" }
        },
        {
            "name": "Markup and Markdown",
            "scope": [
                "markup.heading",
                "markup.bold",
                "markup.italic",
                "markup.inline.raw",
                "markup.quote",
                "markup.list",
                "markup.link",
                "markup.underline"
            ],
            "settings": { "foreground": "#B78AFF" }
        },
        {
            "name": "Special Language Variables",
            "scope": [
                "variable.language.self",
                "variable.language.this",
                "variable.language.super",
                "variable.language.special.self.python",
                "variable.language.this.php",
                "variable.language.this.ts"
            ],
            "settings": { "foreground": "#FF8FD6", "fontStyle": "italic" }
        },
        {
            "name": "Template Expressions",
            "scope": [
                "punctuation.definition.template-expression",
                "punctuation.section.embedded",
                "meta.embedded.line",
                "meta.template.expression"
            ],
            "settings": { "foreground": "#B78AFF" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
