        "editor.findMatchHighlightBackground": "#FFD60A22",
        "editor.wordHighlightBackground": "#4D21FC30",
        "editor.wordHighlightStrongBackground": "#4D21FC50",
        "editorCursor.foreground": "#FFD600",
        "editorWhitespace.foreground": "#4B4775",
