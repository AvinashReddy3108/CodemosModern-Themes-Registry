        "scrollbar.shadow": "#00000050",
        "scrollbarSlider.background": "#4D21FC40",
        "scrollbarSlider.hoverBackground": "#4D21FC80",
        "scrollbarSlider.activeBackground": "#4D21FCA0",
        "minimap.selectionHighlight": "#FFD60050",
        "peekView.border": "#4D21FC",
        "peekViewEditor.background": "#1E1E3A",
        "peekViewResult.background": "#1E1E3A",
        "peekViewTitle.background": "#1E1E3A",
        "peekViewTitleLabel.foreground": "#FFD600",
        "badge.background": "#FFD600",
        "badge.foreground": "#1E1E3A",
        "breadcrumb.foreground": "#7E74B8",
        "breadcrumb.focusForeground": "#FFD600",
        "breadcrumb.activeSelectionForeground": "#FFE082",
        "panel.background": "#1E1E3A",
        "panel.border": "#2D2B55",
        "panelTitle.activeBorder": "#FFD600",
        "panelTitle.activeForeground": "#FFD600",
        "panelTitle.inactiveForeground": "#7E74B8",
        "notificationCenter.border": "#4D21FC",
        "notifications.background": "#1E1E3A",
        "notifications.foreground": "#FFE082",
        "gitDecoration.addedResourceForeground": "#ADFF2F",
        "gitDecoration.modifiedResourceForeground": "#E2B93D",
        "gitDecoration.deletedResourceForeground": "#EF5350",
        "gitDecoration.untrackedResourceForeground": "#ADFF2F",
        "gitDecoration.conflictingResourceForeground": "#FF8A80",
        "gitDecoration.ignoredResourceForeground": "#4B4775",
        "editorBracketHighlight.foreground1": "#FFD600",
        "editorBracketHighlight.foreground2": "#C792EA",
        "editorBracketHighlight.foreground3": "#80CBC4",
        "editorBracketHighlight.foreground4": "#FF9E64",
        "editorBracketHighlight.foreground5": "#ADFF2F",
        "editorBracketHighlight.foreground6": "#B388FF"
    },
    "tokenColors": [
        {
            "name": "Default text",
            "scope": ["source", "text"],
            "settings": { "foreground": "#FFE082" }
        },
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#7E74B8", "fontStyle": "italic" }
        },
        {
            "name": "Strings",
            "scope": [
                "string",
                "string.quoted",
                "string.template",
                "punctuation.definition.string"
            ],
            "settings": { "foreground": "#ADFF2F" }
        },
        {
            "name": "Numbers",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#FF9E64" }
        },
        {
            "name": "Built-in constants",
            "scope": ["constant.language"],
            "settings": { "foreground": "#FF9E64", "fontStyle": "italic" }
        },
        {
            "name": "User constants",
            "scope": ["constant.character", "constant.other"],
            "settings": { "foreground": "#FF9E64" }
        },
        {
            "name": "Keywords",
            "scope": ["keyword", "keyword.control", "keyword.operator.new"],
            "settings": { "foreground": "#FFD600", "fontStyle": "bold" }
        },
        {
            "name": "Operators",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#FFE082" }
        },
        {
            "name": "Storage types",
            "scope": ["storage", "storage.type"],
            "settings": { "foreground": "#FFD600", "fontStyle": "italic" }
        },
        {
            "name": "Storage modifiers",
            "scope": ["storage.modifier"],
            "settings": { "foreground": "#FFD600", "fontStyle": "italic" }
        },
        {
            "name": "Class names",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.class",
                "entity.other.inherited-class"
            ],
            "settings": { "foreground": "#FFF176", "fontStyle": "underline" }
        },
        {
            "name": "Function names",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call"
            ],
            "settings": { "foreground": "#FFEB3B" }
        },
        {
            "name": "Function parameters",
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#FF9E64", "fontStyle": "italic" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "variable.other"],
            "settings": { "foreground": "#FFE082" }
        },
        {
            "name": "Variable - this/self",
            "scope": ["variable.language"],
            "settings": { "foreground": "#FFD600", "fontStyle": "italic" }
        },
        {
            "name": "Object properties",
            "scope": [
                "variable.other.property",
                "variable.other.object.property",
                "support.variable.property",
                "meta.object-literal.key"
            ],
            "settings": { "foreground": "#FFF9C4" }
        },
        {
            "name": "Tag names",
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#FFD600" }
        },
        {
            "name": "Tag attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#FFEB3B", "fontStyle": "italic" }
        },
        {
            "name": "CSS selectors",
            "scope": [
                "entity.name.tag.css",
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css"
            ],
            "settings": { "foreground": "#FFD600" }
        },
        {
            "name": "CSS properties",
            "scope": ["support.type.property-name.css"],
            "settings": { "foreground": "#FFE082" }
        },
        {
            "name": "CSS values",
            "scope": ["support.constant.property-value.css"],
            "settings": { "foreground": "#FFF176" }
        },
        {
            "name": "CSS units",
            "scope": ["keyword.other.unit.css"],
            "settings": { "foreground": "#FF9E64" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation.separator",
                "punctuation.terminator",
                "punctuation.accessor"
            ],
            "settings": { "foreground": "#C5BFF3" }
        },
        {
            "name": "Brackets",
            "scope": [
                "punctuation.section",
                "punctuation.definition.block",
                "meta.brace"
            ],
            "settings": { "foreground": "#C5BFF3" }
        },
        {
            "name": "Markdown headings",
            "scope": ["markup.heading", "entity.name.section.markdown"],
            "settings": { "foreground": "#FFD600", "fontStyle": "bold" }
        },
        {
            "name": "Markdown bold",
            "scope": ["markup.bold"],
            "settings": { "foreground": "#FFEB3B", "fontStyle": "bold" }
        },
        {
            "name": "Markdown italic",
            "scope": ["markup.italic"],
            "settings": { "foreground": "#FFF176", "fontStyle": "italic" }
        },
        {
            "name": "Markdown link",
            "scope": ["markup.underline.link"],
            "settings": { "foreground": "#80CBC4" }
        },
        {
            "name": "Markdown code",
            "scope": ["markup.inline.raw", "markup.fenced_code"],
            "settings": { "foreground": "#ADFF2F" }
        },
        {
            "name": "JSON keys",
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#FFD600" }
        },
        {
            "name": "JSON values",
            "scope": ["string.quoted.double.json"],
            "settings": { "foreground": "#ADFF2F" }
        },
        {
            "name": "YAML keys",
            "scope": ["entity.name.tag.yaml"],
            "settings": { "foreground": "#FFD600" }
        },
        {
            "name": "Decorators",
            "scope": ["meta.decorator", "punctuation.decorator"],
            "settings": { "foreground": "#C792EA", "fontStyle": "italic" }
        },
        {
            "name": "Regex",
            "scope": ["string.regexp"],
            "settings": { "foreground": "#80CBC4" }
        },
        {
            "name": "Escape characters",
            "scope": ["constant.character.escape"],
            "settings": { "foreground": "#80CBC4" }
        },
        {
            "name": "Library types",
            "scope": ["support.type", "support.class"],
            "settings": { "foreground": "#FFF176" }
        },
        {
            "name": "Library constants",
            "scope": ["support.constant"],
            "settings": { "foreground": "#FF9E64" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid"],
            "settings": { "foreground": "#FFFFFF", "background": "#EF5350" }
        },
        {
            "name": "Invalid deprecated",
            "scope": ["invalid.deprecated"],
            "settings": { "foreground": "#FFFFFF", "background": "#7E74B8" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
