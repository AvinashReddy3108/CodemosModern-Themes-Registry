{
    "type": "dark",
    "name": "Zenbones Tokyobones Dark",
    "tokenColors": [
        {
            "scope": ["comment"],
            "name": "Comment",
            "settings": { "foreground": "#65677D", "fontStyle": "italic" }
        },
        {
            "scope": ["variable.other.constant", "constant", "string"],
            "name": "Constant",
            "settings": { "foreground": "#7592EA", "fontStyle": "italic" }
        },
        {
            "scope": ["constant.numeric"],
            "name": "Number",
            "settings": { "foreground": "#2BC4DE", "fontStyle": "" }
        },
        {
            "scope": ["constant.language.boolean"],
            "name": "Boolean",
            "settings": { "foreground": "#C0CAF5", "fontStyle": "italic" }
        },
        {
            "scope": ["variable.other"],
            "name": "Identifier",
            "settings": { "foreground": "#98ABEF", "fontStyle": "" }
        },
        {
            "scope": ["entity.name.function"],
            "name": "Function",
            "settings": { "foreground": "#C0CAF5", "fontStyle": "" }
        },
        {
            "scope": ["keyword"],
            "name": "Statement",
            "settings": { "foreground": "#BB9BF7", "fontStyle": "bold" }
        },
        {
            "scope": ["keyword.control.directive"],
            "name": "PreProc",
            "settings": { "foreground": "#BB9BF7", "fontStyle": "" }
        },
        {
            "scope": [
                "storage.type",
                "storage.modifier",
                "keyword.other.typedef"
            ],
            "name": "Type",
            "settings": { "foreground": "#9394AA", "fontStyle": "" }
        },
        {
            "scope": ["punctuation.definition.template-expression"],
            "name": "Special",
            "settings": { "foreground": "#7BA2F7", "fontStyle": "" }
        },
        {
            "scope": ["entity.name.tag"],
            "name": "Tag",
            "settings": { "foreground": "#7BA2F7", "fontStyle": "" }
        },
        {
            "scope": ["support.type.property-name"],
            "name": "PropertyName",
            "settings": { "foreground": "#2BC4DE", "fontStyle": "" }
        }
    ],
    "colors": {
        "activityBar.background": "#303142",
