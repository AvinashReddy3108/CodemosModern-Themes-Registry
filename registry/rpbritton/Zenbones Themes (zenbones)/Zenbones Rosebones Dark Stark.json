{
    "type": "dark",
    "name": "Zenbones Rosebones Dark Stark",
    "tokenColors": [
        {
            "scope": ["comment"],
            "name": "Comment",
            "settings": { "foreground": "#645F81", "fontStyle": "italic" }
        },
        {
            "scope": ["variable.other.constant", "constant", "string"],
            "name": "Constant",
            "settings": { "foreground": "#BC9493", "fontStyle": "italic" }
        },
        {
            "scope": ["constant.numeric"],
            "name": "Number",
            "settings": { "foreground": "#E1D4D4", "fontStyle": "italic" }
        },
        {
            "scope": ["constant.language.boolean"],
            "name": "Boolean",
            "settings": { "foreground": "#E1D4D4", "fontStyle": "italic" }
        },
        {
            "scope": ["variable.other"],
            "name": "Identifier",
            "settings": { "foreground": "#CAB0AF", "fontStyle": "" }
        },
        {
            "scope": ["entity.name.function"],
            "name": "Function",
            "settings": { "foreground": "#E1D4D4", "fontStyle": "" }
        },
        {
            "scope": ["keyword"],
            "name": "Statement",
            "settings": { "foreground": "#317490", "fontStyle": "" }
        },
        {
            "scope": ["keyword.control.directive"],
            "name": "PreProc",
            "settings": { "foreground": "#E1D4D4", "fontStyle": "bold" }
        },
        {
            "scope": [
                "storage.type",
                "storage.modifier",
                "keyword.other.typedef"
            ],
            "name": "Type",
            "settings": { "foreground": "#DFDEF1", "fontStyle": "" }
        },
        {
            "scope": ["punctuation.definition.template-expression"],
            "name": "Special",
            "settings": { "foreground": "#9CCFD8", "fontStyle": "" }
        },
        {
            "scope": ["entity.name.tag"],
            "name": "Tag",
            "settings": { "foreground": "#9CCFD8", "fontStyle": "" }
        },
        {
            "scope": ["support.type.property-name"],
            "name": "PropertyName",
            "settings": { "foreground": "#E1D4D4", "fontStyle": "italic" }
        }
    ],
    "colors": {
