{
    "type": "dark",
    "name": "Zenbones Nordbones Dark",
    "tokenColors": [
        {
            "scope": ["comment"],
            "name": "Comment",
            "settings": { "foreground": "#737C90", "fontStyle": "italic" }
        },
        {
            "scope": ["variable.other.constant", "constant", "string"],
            "name": "Constant",
            "settings": { "foreground": "#9EAFC9", "fontStyle": "italic" }
        },
        {
            "scope": ["constant.numeric"],
            "name": "Number",
            "settings": { "foreground": "#8FBCBA", "fontStyle": "italic" }
        },
        {
            "scope": ["constant.language.boolean"],
            "name": "Boolean",
            "settings": { "foreground": "#EBEEF3", "fontStyle": "italic" }
        },
        {
            "scope": ["variable.other"],
            "name": "Identifier",
            "settings": { "foreground": "#EBEEF3", "fontStyle": "" }
        },
        {
            "scope": ["entity.name.function"],
            "name": "Function",
            "settings": { "foreground": "#87BFCE", "fontStyle": "" }
        },
        {
            "scope": ["keyword"],
            "name": "Statement",
            "settings": { "foreground": "#81A1C1", "fontStyle": "" }
        },
        {
            "scope": ["keyword.control.directive"],
            "name": "PreProc",
            "settings": { "foreground": "#EBEEF3", "fontStyle": "bold" }
        },
        {
            "scope": [
                "storage.type",
                "storage.modifier",
                "keyword.other.typedef"
            ],
            "name": "Type",
            "settings": { "foreground": "#5E81AB", "fontStyle": "" }
        },
        {
            "scope": ["punctuation.definition.template-expression"],
            "name": "Special",
            "settings": { "foreground": "#ABBAD0", "fontStyle": "bold" }
        },
        {
            "scope": ["entity.name.tag"],
            "name": "Tag",
            "settings": { "foreground": "#ABBAD0", "fontStyle": "bold" }
        },
        {
            "scope": ["support.type.property-name"],
            "name": "PropertyName",
            "settings": { "foreground": "#8FBCBA", "fontStyle": "italic" }
        }
    ],
    "colors": {
