{
    "type": "light",
    "name": "Zenbones Tokyobones Light Dim",
    "tokenColors": [
        {
            "scope": ["comment"],
            "name": "Comment",
            "settings": { "foreground": "#777983", "fontStyle": "italic" }
        },
        {
            "scope": ["variable.other.constant", "constant", "string"],
            "name": "Constant",
            "settings": { "foreground": "#5B6694", "fontStyle": "italic" }
        },
        {
            "scope": ["constant.numeric"],
            "name": "Number",
            "settings": { "foreground": "#176775", "fontStyle": "" }
        },
        {
            "scope": ["constant.language.boolean"],
            "name": "Boolean",
            "settings": { "foreground": "#333A57", "fontStyle": "italic" }
        },
        {
            "scope": ["variable.other"],
            "name": "Identifier",
            "settings": { "foreground": "#4A537A", "fontStyle": "" }
        },
        {
            "scope": ["entity.name.function"],
            "name": "Function",
            "settings": { "foreground": "#333A57", "fontStyle": "" }
        },
        {
            "scope": ["keyword"],
            "name": "Statement",
            "settings": { "foreground": "#5A4A79", "fontStyle": "bold" }
        },
        {
            "scope": ["keyword.control.directive"],
            "name": "PreProc",
            "settings": { "foreground": "#5A4A79", "fontStyle": "" }
        },
        {
            "scope": [
                "storage.type",
                "storage.modifier",
                "keyword.other.typedef"
            ],
            "name": "Type",
            "settings": { "foreground": "#464D67", "fontStyle": "" }
        },
        {
            "scope": ["punctuation.definition.template-expression"],
            "name": "Special",
            "settings": { "foreground": "#34548C", "fontStyle": "" }
        },
        {
            "scope": ["entity.name.tag"],
            "name": "Tag",
            "settings": { "foreground": "#34548C", "fontStyle": "" }
        },
        {
            "scope": ["support.type.property-name"],
            "name": "PropertyName",
            "settings": { "foreground": "#176775", "fontStyle": "" }
        }
    ],
    "colors": {
