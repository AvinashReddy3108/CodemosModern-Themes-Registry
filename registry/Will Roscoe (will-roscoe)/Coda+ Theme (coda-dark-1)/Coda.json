    "tokenColors": [
        {
            "name": "PYTHON base",
            "scope": ["source.python"],
            "settings": { "foreground": "#989898" }
        },
        {
            "name": "PYTHON conditionals",
            "scope": [
                "keyword.control.conditional.python",
                "keyword.control.repeat.python"
            ],
            "settings": { "foreground": "#fad749", "fontStyle": "italic" }
        },
        {
            "name": "PYTHON try/finallys",
            "scope": "keyword.control.exception.python",
            "settings": { "foreground": "#ffd000", "fontStyle": "italic" }
        },
        {
            "name": "PYTHON boolean operators",
            "scope": "keyword.operator.logical.python",
            "settings": { "foreground": "#ffffff" }
        },
        {
            "name": "PYTHON import statements",
            "scope": [
                "keyword.control.import.python",
                "keyword.control.context.python"
            ],
            "settings": { "foreground": "#71c4c0", "fontStyle": "italic" }
        },
        {
            "name": "PYTHON unpacking",
            "scope": ", keyword.operator.unpacking.parameter.python",
            "settings": { "foreground": "#fff200" }
        },
        {
            "name": "PYTHON flow",
            "scope": "keyword.control.flowcont.python",
            "settings": { "foreground": "#ff0000" }
        },
        {
            "name": "PYTHON other keywords",
            "scope": "keyword.other.python",
            "settings": { "foreground": "#ff0000" }
        },
        {
            "name": "PYTHON secondary other keywords",
            "scope": "keyword.control.secondary.python",
            "settings": { "foreground": "#a4a4a4", "fontStyle": "italic" }
        },
        {
            "name": "PYTHON False",
            "scope": "constant.language.false.python",
            "settings": { "foreground": "#ff6e6e", "fontStyle": "italic bold" }
        },
        {
            "name": "PYTHON True",
            "scope": "constant.language.true.python",
            "settings": { "foreground": "#8cde82", "fontStyle": "italic bold" }
        },
        {
            "name": "PYTHON Nulls",
            "scope": "constant.language.none.python",
            "settings": { "foreground": "#4b4b4b", "fontStyle": "italic bold" }
        },
        {
            "name": "PYTHON Exceptions",
            "scope": "support.type.exception.python",
            "settings": { "foreground": "#ff3300", "fontStyle": "italic bold" }
        },
        {
            "name": "PYTHON storage modifiers",
            "scope": "storage.modifier.python",
            "settings": { "foreground": "#00ffea", "fontStyle": "italic bold" }
        },
        {
            "name": "PYTHON capitalized vars",
            "scope": ["constant.other.caps.python"],
            "settings": { "foreground": "#ffffff", "fontStyle": "italic bold" }
        },
        {
            "name": "PYTHON self,cls params",
            "scope": [
                "variable.parameter.function.language.python variable.parameter.function.language.special.cls.python",
                "variable.parameter.function.language.python variable.parameter.function.language.special.self.python",
                "support.function.magic.python",
                "support.variable.magic.python",
                "variable.language.special.cls.python",
                "variable.language.special.self.python"
            ],
            "settings": { "foreground": "#58bcff", "fontStyle": "italic bold" }
        },
        {
            "name": "PYTHON class attributes",
            "scope": ["meta.attribute.python"],
            "settings": { "foreground": "#f5f5f5" }
        },
        {
            "name": "PYTHON func def and class def",
            "scope": [
                "storage.type.function.python",
                "punctuation.section.function.begin.python",
                "storage.type.class.python",
                "punctuation.section.class.begin.python",
                "keyword.control.out.python",
                "punctuation.definition.parameters.begin.python",
                "punctuation.definition.parameters.end.python",
                "punctuation.separator.parameters.python"
            ],
            "settings": { "foreground": "#ff7214", "fontStyle": "italic" }
        },
        {
            "name": "PYTHON func/class const Name ",
            "scope": [
                "meta.function.python entity.name.function.python",
                "entity.name.type.class.python"
            ],
            "settings": { "foreground": "#ffffff" }
        },
        {
            "name": "function definition  typehinting",
            "scope": [
                "punctuation.separator.annotation.python",
                "punctuation.separator.annotation.result.python"
            ],
            "settings": { "foreground": "#89ff76" }
        },
        {
            "name": "PYTHON func + class calls ",
            "scope": ["meta.function-call.python"],
            "settings": { "foreground": "#dcdcdc" }
        },
        {
            "name": "PYTHON builtin func + class calls ",
            "scope": ["support.function.builtin.python"],
            "settings": { "foreground": "#eeca94" }
        },
        {
            "name": "PYTHON math operators",
            "scope": "keyword.operator.arithmetic.python",
            "settings": { "foreground": "#00c8ff" }
        },
        {
            "name": "PYTHON comparison",
            "scope": "  keyword.operator.comparison.python",
            "settings": { "foreground": "#e9e9e9" }
        },
        {
            "name": "PYTHON variable def",
            "scope": "keyword.operator.assignment.python",
            "settings": { "foreground": "#ffffff" }
        },
        {
            "name": "PYTHON docstring",
            "scope": "string.quoted.docstring.multi.python",
            "settings": { "foreground": "#d1d1d1" }
        },
        {
            "name": "PYTHON line comment",
            "scope": "comment.line.number-sign.python",
            "settings": { "foreground": "#24a936" }
        },
        {
            "name": "PYTHON codetag",
            "scope": "keyword.codetag.notation.python",
            "settings": { "foreground": "#ffe600" }
        },
        {
            "name": "PYTHON linecomment hasthag",
            "scope": "punctuation.definition.comment.python",
            "settings": { "foreground": "#225500" }
        },
        {
            "name": "PYTHON docstring quotes",
            "scope": [
                "punctuation.definition.docstring.begin.python",
                "punctuation.definition.docstring.end.python"
            ],
            "settings": { "foreground": "#444444" }
        },
        {
            "name": "PYTHON string",
            "scope": [
                "string.quoted.single.python",
                "string.quoted.multi.python",
                "support.type.str.python",
                "punctuation.definition.string.begin.python",
                "punctuation.definition.string.end.python"
            ],
            "settings": { "foreground": "#3e9a58" }
        },
        {
            "name": "PYTHON numbers",
            "scope": [
                "support.type.num.python",
                "constant.numeric.float.python",
                "constant.numeric.hex.python",
                "constant.numeric.oct.python"
            ],
            "settings": { "foreground": "#aee0ff" }
        },
        {
            "name": "PYTHON list",
            "scope": [
                "support.type.list.python",
                "punctuation.definition.list.begin.python",
                "punctuation.definition.list.end.python"
            ],
            "settings": { "foreground": "#49a6a0" }
        },
        {
            "name": "PYTHON dict",
            "scope": [
                "support.type.dict.python",
                "punctuation.definition.dict.begin.python",
                "punctuation.definition.dict.end.python",
                "punctuation.separator.dict.python"
            ],
            "settings": { "foreground": "#b383f2" }
        },
        {
            "name": "PYTHON tuple type",
            "scope": [
                "support.type.tup.python",
                "punctuation.parenthesis.end.python",
                "punctuation.parenthesis.begin.python"
            ],
            "settings": { "foreground": "#fff712" }
        },
        {
            "name": "PYTHON object and bytes types",
            "scope": ["support.type.bytes.python", "support.type.obj.python"],
            "settings": { "foreground": "#ffffff" }
        },
        {
            "name": "PYTHON bool str and type types, and int numbers and type",
            "scope": [
                "support.type.alt.python",
                "constant.numeric.dec.python",
                "constant.numeric.python",
                "constant.numeric.bin.python"
            ],
            "settings": { "foreground": "#cccccc" }
        },
        {
            "name": "PYTHON stringmodifier",
            "scope": [
                "constant.character.format.placeholder.other.python, meta.fstring.python,meta.format.brace.python",
                "string.interpolated.python"
            ],
            "settings": { "foreground": "#ffffff" }
        },
        {
            "name": "PYTHON stringmodifier",
            "scope": [
                "meta.function.python meta.function.parameters.python variable.parameter.function.language.python",
                "variable.parameter.function-call.python"
            ],
            "settings": { "foreground": "#bcdcf5" }
        },
        {
            "scope": "text.html.markdown",
            "settings": { "foreground": "#818181" }
        },
        {
            "scope": [
                "punctuation.definition.heading.markdown",
                "markup.heading.markdown"
