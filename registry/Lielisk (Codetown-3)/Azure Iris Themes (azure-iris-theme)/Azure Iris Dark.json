    "tokenColors": [
        {
            "name": "Comments",
            "scope": [
                "comment",
                "punctuation.definition.comment",
                "string.comment"
            ],
            "settings": { "fontStyle": "italic", "foreground": "#7a869a" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "string constant.other.placeholder"],
            "settings": { "foreground": "#f5f7fa" }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "storage.type",
                "storage.modifier",
                "keyword.control",
                "constant.language",
                "support.type.primitive"
            ],
            "settings": { "foreground": "#cba6f7" }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "meta.function-call",
                "support.function",
                "variable.function"
            ],
            "settings": { "foreground": "#89b4fa" }
        },
        {
            "name": "Function Parameters",
            "scope": [
                "variable.parameter",
                "meta.parameter",
                "meta.function.parameters.js",
                "meta.parameters.js",
                "variable.other.readwrite"
            ],
            "settings": { "foreground": "#e0e0e0" }
        },
        {
            "name": "Classes",
            "scope": [
                "entity.name.class",
                "entity.name.type.class",
                "support.class"
            ],
            "settings": { "foreground": "#89b4fa" }
        },
        {
            "name": "Strings",
            "scope": [
                "string",
                "string.quoted",
                "string.quoted.single",
                "string.quoted.double",
                "string.quoted.triple"
            ],
            "settings": { "foreground": "#a6e3a1" }
        },
        {
            "name": "Numbers",
            "scope": [
                "constant.numeric",
                "constant.numeric.integer",
                "constant.numeric.float",
                "constant.numeric.hex",
                "constant.numeric.binary",
                "constant.numeric.octal"
            ],
            "settings": { "foreground": "#cba6f7" }
        },
        {
            "name": "Constants",
            "scope": [
                "constant",
                "constant.character",
                "constant.character.escape",
                "constant.other"
            ],
            "settings": { "foreground": "#cba6f7" }
        },
        {
            "name": "Operators",
            "scope": [
                "keyword.operator",
                "keyword.operator.assignment",
                "keyword.operator.arithmetic",
                "keyword.operator.logical"
            ],
            "settings": { "foreground": "#bfc7d5" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation.definition",
                "punctuation.separator",
                "punctuation.terminator"
            ],
            "settings": { "foreground": "#bfc7d5" }
        },
        {
            "name": "HTML Tags",
            "scope": [
                "entity.name.tag.html",
                "entity.name.tag.xml",
                "punctuation.definition.tag.html",
                "punctuation.definition.tag.xml"
            ],
            "settings": { "foreground": "#f38ba8" }
        },
        {
            "name": "HTML Attributes",
            "scope": [
                "entity.other.attribute-name.html",
                "entity.other.attribute-name.xml"
            ],
            "settings": { "foreground": "#f9e2af" }
        },
        {
            "name": "CSS Properties",
            "scope": [
                "support.type.property-name.css",
                "support.type.property-name.scss",
                "support.type.property-name.less"
            ],
            "settings": { "foreground": "#89b4fa" }
        },
        {
            "name": "CSS Values",
            "scope": [
                "support.constant.property-value.css",
                "support.constant.property-value.scss",
                "support.constant.property-value.less"
            ],
            "settings": { "foreground": "#a6e3a1" }
        },
        {
            "name": "JSON Keys",
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#f9e2af" }
        },
        {
            "name": "JSON Values",
            "scope": ["string.quoted.double.json"],
            "settings": { "foreground": "#a6e3a1" }
        },
        {
            "name": "Markdown Headers",
            "scope": ["markup.heading"],
            "settings": { "foreground": "#89b4fa" }
        },
        {
            "name": "Markdown Links",
            "scope": ["markup.underline.link"],
            "settings": { "foreground": "#89b4fa" }
        },
        {
            "name": "Markdown Bold",
            "scope": ["markup.bold"],
            "settings": { "fontStyle": "bold", "foreground": "#89b4fa" }
        },
        {
            "name": "Markdown Italic",
            "scope": ["markup.italic"],
            "settings": { "fontStyle": "italic", "foreground": "#fab387" }
        },
        {
            "name": "Object Keys",
            "scope": [
                "meta.object-literal.key",
                "meta.object-literal.key.js",
                "meta.object-literal.key.ts",
                "meta.object-literal.key.json",
                "support.type.property-name.json",
                "support.type.property-name.object",
                "variable.object.property"
            ],
            "settings": { "foreground": "#f9e2af" }
        },
        {
            "name": "Assigned Variables",
            "scope": [
                "variable.other.readwrite",
                "variable.other",
                "meta.definition.variable.name"
            ],
            "settings": { "foreground": "#e0e0e0" }
        },
        {
            "name": "Renderer and Main Functions",
            "scope": [
                "entity.name.function",
                "entity.name.type.class",
                "support.class",
                "support.function.renderer"
            ],
            "settings": { "foreground": "#89b4fa" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
