{
    "name": "TUI Light Blue",
    "colors": {
        "editor.background": "#ffffff",
        "editor.foreground": "#366287",
        "editorError.foreground": "#fe6f28",
        "editor.lineHighlightBorder": "#00000014",
        "editorLineNumber.foreground": "#A0A7BD",
        "editorBracketHighlight.foreground1": "#007BE4",
        "editorBracketHighlight.foreground2": "#259663",
        "editorBracketHighlight.foreground3": "#B022F7",
        "editorBracketHighlight.foreground4": "#E75800",
        "titleBar.activeBackground": "#006FD8",
        "titleBar.inactiveBackground": "#006FD8",
        "titleBar.activeForeground": "#ffffff",
        "icon.foreground": "#838A9E",
        "sideBar.background": "#F0F3FA",
        "sideBarSectionHeader.background": "#ffffff00",
        "list.activeSelectionBackground": "#0061C2",
        "list.inactiveSelectionBackground": "#DFE4F2",
        "activityBar.background": "#DFE4F2",
        "activityBar.foreground": "#068CFF",
        "activityBar.inactiveForeground": "#838A9E",
        "activityBar.activeBorder": "#ffffff00",
        "activityBar.activeFocusBorder": "#ffffff00",
        "activityBarBadge.background": "#068CFF",
        "tab.inactiveBackground": "#F0F3FA",
        "editorGroupHeader.tabsBackground": "#F0F3FA",
        "statusBar.background": "#DFE4F2",
        "statusBar.foreground": "#838A9E",
        "statusBarItem.remoteBackground": "#DFE4F2",
        "statusBarItem.remoteForeground": "#838A9E",
        "statusBar.noFolderBackground": "#DFE4F2"
    },
    "tokenColors": [
        {
            "name": "keywords",
            "scope": [
                "keyword",
                "storage.type.js",
                "storage.modifier.ts",
                "meta.function.js",
                "storage.type.class.ts"
            ],
            "settings": { "foreground": "#802FDC" }
        },
        {
            "name": "variables",
            "scope": [
                "variable",
                "support.type.property-name.json",
                "support.type.property-name.json.comments",
                "support.variable.property.ts",
                "meta.object-literal.key.ts"
            ],
            "settings": { "foreground": "#0792B9" }
        },
        {
            "name": "strings",
            "scope": "string",
            "settings": { "foreground": "#E75800" }
        },
        {
            "name": "functions",
            "scope": [
                "entity.name.function",
                "meta.function",
                "meta.function-call",
                "support.function",
                "entity.name.type.class.ts",
                "meta.class.ts",
                "meta.method.declaration.ts"
            ],
            "settings": { "foreground": "#275BE2" }
        },
        {
            "name": "numbers",
            "scope": "constant.numeric.decimal.js",
            "settings": { "foreground": "#BBA200" }
        },
        {
            "name": "types",
            "scope": [
                "entity.name.type.ts",
                "meta.type.parameters.ts",
                "meta.return.type.ts"
            ],
            "settings": { "foreground": "#CA0A8A" }
        },
        {
            "name": "Comments",
            "scope": "comment",
            "settings": { "fontStyle": "italic", "foreground": "#8B9598" }
        },
        {
            "name": "HTML: Tags",
            "scope": [
                "meta.tag",
                "punctuation.definition.tag.html",
                "punctuation.definition.tag.begin.html",
                "punctuation.definition.tag.end.html"
            ],
            "settings": { "foreground": "#AD5C5C" }
        },
        {
            "name": "HTML: Tag Names",
            "scope": "entity.name.tag",
            "settings": { "foreground": "#AD5C5C" }
        },
        {
            "name": "HTML: Attribute Names",
            "scope": [
                "meta.tag entity.other.attribute-name",
                "entity.other.attribute-name.html"
            ],
            "settings": { "foreground": "#2476e0" }
        },
        {
            "name": "HTML: Entities",
            "scope": [
                "constant.character.entity",
                "punctuation.definition.entity"
            ],
            "settings": { "foreground": "#AB6526" }
        },
        {
            "name": "CSS: Selectors",
            "scope": [
                "meta.selector",
                "meta.selector entity",
                "meta.selector entity punctuation",
                "entity.name.tag.css"
            ],
            "settings": { "foreground": "#7b1db2" }
        },
        {
            "name": "CSS: Property Names",
            "scope": ["meta.property-name", "support.type.property-name"],
            "settings": { "foreground": "#c66714" }
        },
        {
            "name": "CSS: Property Values",
            "scope": [
                "meta.property-value",
                "meta.property-value constant.other",
                "support.constant.property-value"
            ],
            "settings": { "foreground": "#448C27" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
