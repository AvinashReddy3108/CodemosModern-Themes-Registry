{
    "name": "TUI Dark Blue",
    "colors": {
        "editor.background": "#07214F",
        "editor.foreground": "#c6c6c6",
        "editorError.foreground": "#fe6f28",
        "editor.lineHighlightBorder": "#ffffff14",
        "editorBracketHighlight.foreground1": "#007BE4",
        "editorBracketHighlight.foreground2": "#259663",
        "editorBracketHighlight.foreground3": "#B022F7",
        "editorBracketHighlight.foreground4": "#E75800",
        "titleBar.activeBackground": "#0a347c",
        "titleBar.inactiveBackground": "#0A347C",
        "sideBar.background": "#071E46",
        "activityBar.background": "#051735",
        "tab.inactiveBackground": "#061C40",
        "editorGroupHeader.tabsBackground": "#061C40",
        "statusBar.background": "#0A347C",
        "statusBarItem.remoteBackground": "#0A347C"
    },
    "tokenColors": [
        {
            "name": "keywords",
            "scope": [
                "keyword",
                "storage.type.js",
                "storage.modifier.ts",
                "meta.function.js",
                "storage.type.class.ts"
            ],
            "settings": { "foreground": "#B879FF" }
        },
        {
            "name": "variables",
            "scope": [
                "variable",
                "support.type.property-name.json",
                "support.type.property-name.json.comments",
                "support.variable.property.ts",
                "meta.object-literal.key.ts"
            ],
            "settings": { "foreground": "#1ABBB0" }
        },
        {
            "name": "strings",
            "scope": "string",
            "settings": { "foreground": "#FF690C" }
        },
        {
            "name": "functions",
            "scope": [
                "entity.name.function",
                "meta.function",
                "meta.function-call",
                "support.function",
                "entity.name.type.class.ts",
                "meta.class.ts",
                "meta.method.declaration.ts"
            ],
            "settings": { "foreground": "#039EF1" }
        },
        {
            "name": "numbers",
            "scope": "constant.numeric.decimal.js",
            "settings": { "foreground": "#E7CA11" }
        },
        {
            "name": "types",
            "scope": [
                "entity.name.type.ts",
                "meta.type.parameters.ts",
                "meta.return.type.ts"
            ],
            "settings": { "foreground": "#DF36A7" }
        },
        {
            "name": "Comments",
            "scope": "comment",
            "settings": { "fontStyle": "italic", "foreground": "#5C6B6F" }
        },
        {
            "name": "HTML: Tags",
            "scope": [
                "meta.tag",
                "punctuation.definition.tag.html",
                "punctuation.definition.tag.begin.html",
                "punctuation.definition.tag.end.html"
            ],
            "settings": { "foreground": "#D14242" }
        },
        {
            "name": "HTML: Tag Names",
            "scope": "entity.name.tag",
            "settings": { "foreground": "#D14242" }
        },
        {
            "name": "HTML: Attribute Names",
            "scope": [
                "meta.tag entity.other.attribute-name",
                "entity.other.attribute-name.html"
            ],
            "settings": { "foreground": "#23CFFF" }
        },
        {
            "name": "HTML: Entities",
            "scope": [
                "constant.character.entity",
                "punctuation.definition.entity"
            ],
            "settings": { "foreground": "#AB6526" }
        },
        {
            "name": "CSS: Selectors",
            "scope": [
                "meta.selector",
                "meta.selector entity",
                "meta.selector entity punctuation",
                "entity.name.tag.css"
            ],
            "settings": { "foreground": "#7b1db2" }
        },
        {
            "name": "CSS: Property Names",
            "scope": ["meta.property-name", "support.type.property-name"],
            "settings": { "foreground": "#c66714" }
        },
        {
            "name": "CSS: Property Values",
            "scope": [
                "meta.property-value",
                "meta.property-value constant.other",
                "support.constant.property-value"
            ],
            "settings": { "foreground": "#448C27" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
