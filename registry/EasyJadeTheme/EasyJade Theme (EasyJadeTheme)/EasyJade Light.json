{
    "name": "EasyJade Light",
    "$schema": "vscode://schemas/color-theme",
    "type": "light",
    "colors": {
        "actionBar.toggledBackground": "#bcceaaff",
        "activityBarBadge.background": "#8b9944ff",
        "checkbox.border": "#6c835cff",
        "diffEditor.unchangedRegionBackground": "#ccd6bcff",
        "editor.background": "#cfdcc3ff",
        "editor.foreground": "#253f17ff",
        "editor.inactiveSelectionBackground": "#c0cbb4cc",
        "editor.selectionHighlightBackground": "#9fc087cc",
        "editorIndentGuide.activeBackground1": "#7b966aff",
        "editorIndentGuide.background1": "#b1c2a5ff",
        "editorSuggestWidget.background": "#c8d4bcff",
        "input.placeholderForeground": "#4a5a3aff",
        "list.activeSelectionIconForeground": "#d4d9d0ff",
        "list.focusAndSelectionOutline": "#a59a4aff",
        "list.hoverBackground": "#b8c8a6ff",
        "menu.border": "#adb89fff",
        "notebook.cellBorderColor": "#c1d3a9ff",
        "notebook.selectedCellBackground": "#b8ccb150",
        "ports.iconRunningProcessForeground": "#8ca53dff",
        "searchEditor.textInputBorder": "#a8b89bff",
        "settings.numberInputBorder": "#a8b89bff",
        "settings.textInputBorder": "#a8b89bff",
        "sideBarSectionHeader.background": "#00000000",
        "sideBarSectionHeader.border": "#51515130",
        "sideBarTitle.foreground": "#3a4a2aff",
        "statusBarItem.errorBackground": "#b72e0fff",
        "statusBarItem.remoteBackground": "#7ba53dff",
        "statusBarItem.remoteForeground": "#e0e0e0ff",
        "tab.lastPinnedBorder": "#51515130",
        "tab.selectedBackground": "#d0d7c5a5",
        "tab.selectedForeground": "#253f17b3",
        "terminal.inactiveSelectionBackground": "#c0cbb4ff",
        "widget.border": "#adb89fff",
        "activityBar.activeBorder": "#a59a4aff",
        "activityBar.background": "#bfcdb3ff",
        "activityBar.dropBorder": "#a59a4aff",
        "activityBar.foreground": "#253f17ff",
        "activityBar.inactiveForeground": "#3a4a2a66",
        "activityBarBadge.foreground": "#d4d9d0ff",
        "button.background": "#8b9b28ff",
        "button.foreground": "#d4d9d0ff",
        "button.hoverBackground": "#9aa030ff",
        "button.secondaryBackground": "#6b8678ff",
        "button.secondaryForeground": "#d4d9d0ff",
        "button.secondaryHoverBackground": "#7b9280ff",
        "commandCenter.activeBackground": "#5b854314",
        "commandCenter.activeBorder": "#3a4a2a4d",
        "commandCenter.activeForeground": "#253f17ff",
        "commandCenter.background": "#7fa8680d",
        "commandCenter.border": "#3a4a2a33",
        "commandCenter.foreground": "#253f17ff",
        "commandCenter.inactiveBorder": "#3a4a2a26",
        "commandCenter.inactiveForeground": "#3a4a2a99",
        "editor.findMatchBackground": "#e8ecdf9e",
        "editor.findMatchHighlightBackground": "#ca4c0044",
        "editor.lineHighlightBorder": "#b1c2a5ff",
        "editor.selectionBackground": "#c0a0708a",
        "editor.wordHighlightBackground": "#dfbdbd80",
        "editor.wordHighlightStrongBackground": "#dfbdbd80",
        "editor.wordHighlightTextBackground": "#dfbdbd80",
        "editorBracketHighlight.foreground1": "#5a6a9aff",
        "editorBracketHighlight.foreground2": "#8f7d00ff",
        "editorBracketHighlight.foreground3": "#9a7866ff",
        "editorBracketMatch.background": "#90b8351a",
        "editorBracketMatch.border": "#95aa95ff",
        "editorGroupHeader.noTabsBackground": "#cfdcc3ff",
        "editorGroupHeader.tabsBackground": "#c7d4c0ff",
        "editorGutter.addedBackground": "#44914bff",
        "editorGutter.background": "#cfdcc3ff",
        "editorGutter.deletedBackground": "#b56a2aff",
        "editorGutter.modifiedBackground": "#a59a4aff",
        "editorLink.activeForeground": "#00b58ac6",
        "editorWidget.background": "#c4dbbaff",
        "editorWidget.border": "#a8b89bff",
        "editorWidget.foreground": "#3a4a2aff",
        "input.background": "#dfe5d8ff",
        "input.foreground": "#153a0aff",
        "input.border": "#5a7a47ff",
        "list.activeSelectionBackground": "#9aa030ff",
        "list.activeSelectionForeground": "#d4d9d0ff",
        "list.inactiveSelectionBackground": "#b1c2a5ff",
        "quickInput.background": "#c7d4c0ff",
        "quickInput.foreground": "#253f17ff",
        "quickInputList.focusBackground": "#9aa030ff",
        "quickInputList.focusForeground": "#e0e0e0ff",
        "quickInputTitle.background": "#b1c2a520",
        "sideBar.background": "#c7d4c0ff",
        "sideBar.dropBackground": "#5b85432e",
        "sideBarActivityBarTop.border": "#4a5a3a30",
        "sideBarStickyScroll.background": "#c7d4c0ff",
        "sideBarStickyScroll.shadow": "#b5c9a3ff",
        "sideBarTitle.background": "#c7d4c0ff",
        "statusBar.background": "#6b8678ff",
        "statusBar.debuggingBackground": "#9a8a4aff",
        "statusBar.foreground": "#d4d9d0ff",
        "statusBar.noFolderBackground": "#7a8a5aff",
        "tab.activeBackground": "#eff5e8",
        "tab.activeForeground": "#2a4a1a",
        "tab.activeModifiedBorder": "#b5a85a",
        "tab.border": "#dbe8d0",
        "tab.inactiveBackground": "#dbe8d0",
        "tab.inactiveForeground": "#4a5a3ab3",
        "tab.inactiveModifiedBorder": "#b5a85a80",
        "tab.unfocusedActiveBackground": "#eff5e8",
        "tab.unfocusedActiveForeground": "#2a4a1ab3",
        "titleBar.activeBackground": "#dbe8d0",
        "titleBar.activeForeground": "#2a4a1a",
        "titleBar.inactiveBackground": "#dbe8d099",
        "titleBar.inactiveForeground": "#2a4a1a99",
        "editor.lineHighlightBackground": "#f0f7e520"
    },
    "tokenColors": [
        {
            "scope": [
                "meta.embedded",
                "source.groovy.embedded",
                "string meta.image.inline.markdown",
                "variable.legacy.builtin.python"
            ],
            "settings": { "foreground": "#3a3a3a" }
        },
        { "scope": "emphasis", "settings": { "fontStyle": "italic" } },
        { "scope": "strong", "settings": { "fontStyle": "bold" } },
        {
            "scope": "meta.diff.header",
            "settings": { "foreground": "#4a5a7a" }
        },
        { "scope": "comment", "settings": { "foreground": "#7a8471" } },
        {
            "scope": "constant.language",
            "settings": { "foreground": "#4a6aaa" }
        },
        {
            "scope": [
                "constant.numeric",
                "variable.other.enummember",
                "keyword.operator.plus.exponent",
                "keyword.operator.minus.exponent"
            ],
            "settings": { "foreground": "#aa6a45" }
        },
        { "scope": "constant.regexp", "settings": { "foreground": "#811F3F" } },
        { "scope": "entity.name.tag", "settings": { "foreground": "#8a4a2a" } },
        {
            "scope": "entity.name.selector",
            "settings": { "foreground": "#8a4a2a" }
        },
        {
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#c57a3a" }
        },
        {
            "scope": [
                "entity.other.attribute-name.class.css",
                "source.css entity.other.attribute-name.class",
                "entity.other.attribute-name.id.css",
                "entity.other.attribute-name.parent-selector.css",
                "entity.other.attribute-name.parent.less",
                "source.css entity.other.attribute-name.pseudo-class",
                "entity.other.attribute-name.pseudo-element.css",
                "source.css.less entity.other.attribute-name.id",
                "entity.other.attribute-name.scss"
            ],
            "settings": { "foreground": "#8a4a2a" }
        },
        { "scope": "invalid", "settings": { "foreground": "#aa6666" } },
        {
            "scope": "markup.underline",
            "settings": { "fontStyle": "underline" }
        },
        {
            "scope": "markup.bold",
            "settings": { "foreground": "#4a5a7a", "fontStyle": "bold" }
        },
        {
            "scope": "markup.heading",
            "settings": { "foreground": "#8a4a2a", "fontStyle": "bold" }
        },
        { "scope": "markup.italic", "settings": { "fontStyle": "italic" } },
        {
            "scope": "markup.strikethrough",
            "settings": { "fontStyle": "strikethrough" }
        },
        { "scope": "markup.inserted", "settings": { "foreground": "#6f8e22" } },
        { "scope": "markup.deleted", "settings": { "foreground": "#6e8932" } },
        { "scope": "markup.changed", "settings": { "foreground": "#5a7aaa" } },
        {
            "scope": [
                "punctuation.definition.quote.begin.markdown",
                "punctuation.definition.list.begin.markdown"
            ],
            "settings": { "foreground": "#5a7aaa" }
        },
        {
            "scope": "markup.inline.raw",
            "settings": { "foreground": "#8a4a2a" }
        },
        {
            "scope": "punctuation.definition.tag",
            "settings": { "foreground": "#8a4a2a" }
        },
        {
            "scope": ["meta.preprocessor", "entity.name.function.preprocessor"],
            "settings": { "foreground": "#4a6aaa" }
        },
        {
            "scope": "meta.preprocessor.string",
            "settings": { "foreground": "#6e8932" }
        },
        {
            "scope": "meta.preprocessor.numeric",
            "settings": { "foreground": "#aa6a45" }
        },
        {
            "scope": "meta.structure.dictionary.key.python",
            "settings": { "foreground": "#5a7aaa" }
        },
        { "scope": "storage", "settings": { "foreground": "#778723" } },
        { "scope": "storage.type", "settings": { "foreground": "#778723" } },
        {
            "scope": ["storage.modifier", "keyword.operator.noexcept"],
            "settings": { "foreground": "#899832" }
        },
        {
            "scope": ["string", "meta.embedded.assembly"],
            "settings": { "foreground": "#6e8932" }
        },
        {
            "scope": [
                "string.comment.buffered.block.pug",
                "string.quoted.pug",
                "string.interpolated.pug",
                "string.unquoted.plain.in.yaml",
                "string.unquoted.plain.out.yaml",
                "string.unquoted.block.yaml",
                "string.quoted.single.yaml",
                "string.quoted.double.xml",
                "string.quoted.single.xml",
                "string.unquoted.cdata.xml",
                "string.quoted.double.html",
                "string.quoted.single.html",
                "string.unquoted.html",
                "string.quoted.single.handlebars",
                "string.quoted.double.handlebars"
            ],
            "settings": { "foreground": "#4a6aaa" }
        },
        { "scope": "string.regexp", "settings": { "foreground": "#811F3F" } },
        {
            "scope": [
                "punctuation.definition.template-expression.begin",
                "punctuation.definition.template-expression.end",
                "punctuation.section.embedded"
            ],
            "settings": { "foreground": "#4a6aaa" }
        },
        {
            "scope": ["meta.template.expression"],
            "settings": { "foreground": "#5a7aaa" }
        },
        {
            "scope": [
                "support.constant.property-value",
                "support.constant.font-name",
                "support.constant.media-type",
                "support.constant.media",
                "constant.other.color.rgb-value",
                "constant.other.rgb-value",
                "support.constant.color"
            ],
            "settings": { "foreground": "#5a7aaa" }
        },
        {
            "scope": [
                "support.type.vendored.property-name",
                "support.type.property-name",
                "source.css variable",
                "source.coffee.embedded"
            ],
            "settings": { "foreground": "#c57a3a" }
        },
        {
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#5a7aaa" }
        },
        { "scope": "keyword", "settings": { "foreground": "#4a6aaa" } },
        { "scope": "keyword.control", "settings": { "foreground": "#4a6aaa" } },
        {
            "scope": "keyword.operator",
            "settings": { "foreground": "#0f5f0f" }
        },
        {
            "scope": [
                "punctuation.accessor",
                "punctuation.separator.period",
                "meta.property-access punctuation"
            ],
            "settings": { "foreground": "#0f5f0f" }
        },
        {
            "scope": [
                "keyword.operator.new",
                "keyword.operator.expression",
                "keyword.operator.cast",
                "keyword.operator.sizeof",
                "keyword.operator.alignof",
                "keyword.operator.typeid",
                "keyword.operator.alignas",
                "keyword.operator.instanceof",
                "keyword.operator.logical.python",
                "keyword.operator.wordlike"
            ],
            "settings": { "foreground": "#4a6aaa" }
        },
        {
            "scope": "keyword.other.unit",
            "settings": { "foreground": "#aa6a45" }
        },
        {
            "scope": [
                "punctuation.section.embedded.begin.php",
                "punctuation.section.embedded.end.php"
            ],
            "settings": { "foreground": "#8a4a2a" }
        },
        {
            "scope": "support.function.git-rebase",
            "settings": { "foreground": "#5a7aaa" }
        },
        {
            "scope": "constant.sha.git-rebase",
            "settings": { "foreground": "#b5a85a" }
        },
        {
            "scope": [
                "storage.modifier.import.java",
                "variable.language.wildcard.java",
                "storage.modifier.package.java"
            ],
            "settings": { "foreground": "#5a7aaa" }
        },
        {
            "scope": "variable.language",
            "settings": { "foreground": "#4a6aaa" }
        },
        {
            "scope": "token.info-token",
            "settings": { "foreground": "#316BCD" }
        },
        {
            "scope": "token.warn-token",
            "settings": { "foreground": "#CD9731" }
        },
        {
            "scope": "token.error-token",
            "settings": { "foreground": "#aa6666" }
        },
        {
            "scope": "token.debug-token",
            "settings": { "foreground": "#800080" }
        },
        {
            "scope": [
                "entity.name.function",
                "meta.function-call",
                "support.function"
            ],
            "settings": { "foreground": "#899832" }
        },
        {
            "scope": [
                "entity.name.class",
                "entity.name.type.class",
                "support.class"
            ],
            "settings": { "foreground": "#779688" }
        },
        {
            "scope": ["variable.parameter", "meta.parameters variable"],
            "settings": { "foreground": "#5f7e3c" }
        },
        {
            "scope": [
                "entity.name.variable",
                "variable.other.readwrite",
                "variable.other.property"
            ],
            "settings": { "foreground": "#39a91e" }
        },
        {
            "scope": [
                "variable.other.object",
                "meta.function-call.generic variable"
            ],
            "settings": { "foreground": "#52b488" }
        },
        {
            "scope": [
                "entity.name.type",
                "support.type",
                "storage.type.primitive"
            ],
            "settings": { "foreground": "#59b2d0" }
        },
        {
            "scope": [
                "punctuation.definition.string.begin",
                "punctuation.definition.string.end"
            ],
            "settings": { "foreground": "#aa8a6a" }
        },
        {
            "scope": ["support.function.builtin.python", "support.type.python"],
            "settings": { "foreground": "#54b15b" }
        },
        {
            "scope": [
                "string.quoted.docstring.multi.python",
                "string.quoted.docstring.single.python"
            ],
            "settings": { "foreground": "#7a8471", "fontStyle": "italic" }
        },
        {
            "scope": [
                "support.type.property-name.css",
                "meta.property-name.css"
            ],
            "settings": { "foreground": "#899832" }
        },
        {
            "scope": [
                "support.constant.property-value.css",
                "meta.property-value.css"
            ],
            "settings": { "foreground": "#6e8932" }
        },
        {
            "scope": [
                "entity.name.section.markdown",
                "markup.heading.markdown"
            ],
            "settings": { "foreground": "#779688", "fontStyle": "bold" }
        },
        {
            "scope": [
                "markup.inline.raw.markdown",
                "fenced_code.block.language.markdown"
            ],
            "settings": { "foreground": "#adc045" }
        },
        {
            "scope": ["entity.name.tag.yaml", "entity.name.tag.local.yaml"],
            "settings": { "foreground": "#54b15b" }
        }
    ]
}
