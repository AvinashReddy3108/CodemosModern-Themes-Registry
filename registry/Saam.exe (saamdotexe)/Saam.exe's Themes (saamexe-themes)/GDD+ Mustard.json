    "semanticHighlighting": true,
    "tokenColors": [
        { "scope": ["comment"], "settings": { "foreground": "#ffffff2a" } },
        {
            "scope": ["keyword.local", "keyword.operator", "keyword.control"],
            "settings": { "foreground": "#7c7c7c" }
        },
        {
            "scope": ["variable.declaration", "variable.other.lua"],
            "settings": { "foreground": "#88d0e6" }
        },
        {
            "scope": ["variable.global"],
            "settings": { "foreground": "#e5534b" }
        },
        {
            "scope": ["string", "constant.language.boolean"],
            "settings": { "foreground": "#dfdfdf" }
        },
        {
            "scope": [
                "constant",
                "variable.other.object",
                "meta.definition.variable",
                "entity.other.attribute-name.tsx"
            ],
            "settings": { "foreground": "#e2ad4a" }
        },
        {
            "scope": ["constant.language.lua"],
            "settings": { "foreground": "#cb8ddf" }
        },
        {
            "scope": ["support.type", "entity.name.type"],
            "settings": { "foreground": "#f08383" }
        },
        { "scope": ["storage.type"], "settings": { "foreground": "#e5534b" } },
        {
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#e5534b" }
        },
        {
            "scope": [
                "support.type.property-name.css",
                "entity.other.attribute-name.css"
            ],
            "settings": { "foreground": "#88d0e6" }
        },
        {
            "scope": ["entity.name.type.rust", "support.type.rust"],
            "settings": { "foreground": "#f08383" }
        },
        {
            "scope": ["storage.type.rust"],
            "settings": { "foreground": "#7c7c7c" }
        },
        {
            "scope": ["support.type.python", "entity.name.type.class.python"],
            "settings": { "foreground": "#f08383" }
        }
    ],
    "semanticTokenColors": {
        "function": { "foreground": "#ffc400" },
        "method": { "foreground": "#ffc400" },
        "property": { "foreground": "#88d0e6" },
        "parameter": { "foreground": "#ff7300" }
    },
    "$schema": "vscode://schemas/color-theme"
}
