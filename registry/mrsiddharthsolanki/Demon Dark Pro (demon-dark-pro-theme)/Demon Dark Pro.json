        "editor.wordHighlightBackground": "#3d3d3d80",
        "editor.wordHighlightStrongBackground": "#4d4d4d80",
        "editorLineNumber.foreground": "#666666",
        "editorLineNumber.activeForeground": "#ff6b5b",
        "editorIndentGuide.background1": "#333333",
