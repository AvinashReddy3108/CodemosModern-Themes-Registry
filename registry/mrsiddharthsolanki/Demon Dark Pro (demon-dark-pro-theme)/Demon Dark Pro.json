        "editorError.foreground": "#ff6b7d",
        "editorWarning.foreground": "#c9a87c",
        "editorInfo.foreground": "#26d0ce",
        "editorHint.foreground": "#d9a8ff",
        "activityBar.background": "#0f0f0f",
        "activityBar.foreground": "#e8e8e8",
        "activityBar.inactiveForeground": "#666666",
        "activityBar.border": "#1a1a1a",
        "activityBarBadge.background": "#ff4757",
        "activityBarBadge.foreground": "#ffffff",
        "sideBar.background": "#111111",
        "sideBar.foreground": "#cccccc",
        "sideBar.border": "#1a1a1a",
        "sideBarTitle.foreground": "#e8e8e8",
        "sideBarSectionHeader.background": "#1a1a1a",
        "sideBarSectionHeader.foreground": "#e8e8e8",
        "statusBar.background": "#0f0f0f",
        "statusBar.foreground": "#cccccc",
        "statusBar.border": "#1a1a1a",
        "statusBar.debuggingBackground": "#ff4757",
        "statusBar.debuggingForeground": "#ffffff",
        "statusBar.noFolderBackground": "#0f0f0f",
        "statusBarItem.hoverBackground": "#3d3d3d",
        "statusBarItem.activeBackground": "#4d4d4d",
        "tab.activeBackground": "#1a1a1a",
        "tab.activeForeground": "#e8e8e8",
        "tab.activeBorder": "#ff6b5b",
        "tab.inactiveBackground": "#111111",
        "tab.inactiveForeground": "#888888",
        "tab.border": "#1a1a1a",
        "tab.hoverBackground": "#1a1a1a",
        "tab.unfocusedActiveBackground": "#1a1a1a",
        "tab.unfocusedActiveForeground": "#cccccc",
        "titleBar.activeBackground": "#0a0a0a",
        "titleBar.activeForeground": "#e8e8e8",
        "titleBar.inactiveBackground": "#0a0a0a",
        "titleBar.inactiveForeground": "#666666",
        "titleBar.border": "#1a1a1a",
        "menubar.selectionBackground": "#3d3d3d",
        "menubar.selectionForeground": "#e8e8e8",
        "menu.background": "#111111",
        "menu.foreground": "#e8e8e8",
        "menu.selectionBackground": "#3d3d3d",
        "menu.selectionForeground": "#ffffff",
        "input.background": "#1a1a1a",
        "input.foreground": "#e8e8e8",
        "input.border": "#333333",
        "input.placeholderForeground": "#666666",
        "inputOption.activeBackground": "#c9a87c40",
        "inputOption.activeBorder": "#c9a87c",
        "settings.headerForeground": "#ff4757",
        "settings.modifiedItemIndicator": "#ff4757",
        "settings.focusedRowBackground": "#ff475740",
        "settings.rowHoverBackground": "#ff475730",
        "settings.textInputBorder": "#ff4757",
        "settings.textInputForeground": "#ffffff",
        "dropdown.background": "#1a1a1a",
        "dropdown.foreground": "#e8e8e8",
        "dropdown.border": "#333333",
        "button.background": "#d4845c",
        "button.foreground": "#ffffff",
        "button.hoverBackground": "#c97650",
        "list.activeSelectionBackground": "#3d3d3d",
        "list.activeSelectionForeground": "#ffffff",
        "list.inactiveSelectionBackground": "#2d2d2d",
        "list.inactiveSelectionForeground": "#e8e8e8",
        "list.hoverBackground": "#1a1a1a",
        "list.focusBackground": "#3d3d3d",
        "list.highlightForeground": "#ff6b5b",
        "list.errorForeground": "#ff6b7d",
        "list.warningForeground": "#c9a87c",
        "terminal.background": "#0a0a0a",
        "terminal.foreground": "#e8e8e8",
        "terminalCursor.background": "#0a0a0a",
        "terminalCursor.foreground": "#ff4757",
        "terminal.ansiBlack": "#0a0a0a",
        "terminal.ansiRed": "#ff4757",
        "terminal.ansiGreen": "#2ed573",
        "terminal.ansiYellow": "#c9a87c",
        "terminal.ansiBlue": "#3742fa",
        "terminal.ansiMagenta": "#d9a8ff",
        "terminal.ansiCyan": "#26d0ce",
        "terminal.ansiWhite": "#e8e8e8",
        "terminal.ansiBrightBlack": "#666666",
        "terminal.ansiBrightRed": "#ff6b7d",
        "terminal.ansiBrightGreen": "#7bed9f",
        "terminal.ansiBrightYellow": "#c9a87c",
        "terminal.ansiBrightBlue": "#5352ed",
        "terminal.ansiBrightMagenta": "#c44569",
        "terminal.ansiBrightCyan": "#40c8c6",
        "terminal.ansiBrightWhite": "#ffffff",
        "terminal.selectionBackground": "#4d4d4d",
        "terminal.selectionForeground": "#ffffff",
        "panel.background": "#111111",
        "panel.border": "#1a1a1a",
        "panelTitle.activeForeground": "#e8e8e8",
        "panelTitle.inactiveForeground": "#888888",
        "panelTitle.activeBorder": "#ff6b5b",
        "notifications.background": "#1a1a1a",
        "notifications.foreground": "#e8e8e8",
        "notifications.border": "#333333",
        "notificationCenterHeader.background": "#2d1b1b",
        "notificationsErrorIcon.foreground": "#ff4757",
        "notificationsWarningIcon.foreground": "#c9a87c",
        "notificationsInfoIcon.foreground": "#26d0ce",
        "errorForeground": "#ff6b7d",
        "peekViewEditor.background": "#111111",
        "peekViewResult.background": "#0f0f0f",
        "peekViewTitle.background": "#3d3d3d",
        "scrollbar.shadow": "#000000",
        "scrollbarSlider.background": "#33333350",
        "scrollbarSlider.hoverBackground": "#55555570",
        "scrollbarSlider.activeBackground": "#666666",
        "progressBar.background": "#d4845c",
        "minimap.background": "#0f0f0f",
        "minimap.selectionHighlight": "#3d3d3d80",
        "minimap.findMatchHighlight": "#ff475750",
        "gitDecoration.modifiedResourceForeground": "#c9a87c",
        "gitDecoration.deletedResourceForeground": "#ff4757",
        "gitDecoration.untrackedResourceForeground": "#2ed573",
        "gitDecoration.ignoredResourceForeground": "#666666",
        "gitDecoration.conflictingResourceForeground": "#d9a8ff",
        "diffEditor.insertedTextBackground": "#2ed57330",
        "diffEditor.removedTextBackground": "#ff475730",
        "diffEditor.border": "#1a1a1a"
    },
    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#888888" }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "storage.type",
                "storage.modifier",
                "keyword.control",
                "keyword.operator.new",
                "keyword.other.important"
            ],
            "settings": { "foreground": "#ff6b5b" }
        },
        {
            "name": "Variable Declaration Keywords (JS - Dark)",
            "scope": [
                "storage.type.js",
                "storage.type.ts",
                "storage.type.tsx",
                "storage.modifier.ts",
                "keyword.declaration"
            ],
            "settings": { "foreground": "#ff6b5b" }
        },
        {
            "name": "Access Modifiers",
            "scope": [
                "storage.modifier.access",
                "keyword.other.visibility",
                "keyword.other.access-modifier"
            ],
            "settings": { "foreground": "#a0a0a0" }
        },
        {
            "name": "Operators",
            "scope": [
                "keyword.operator",
                "punctuation.separator",
                "punctuation.terminator"
            ],
            "settings": { "foreground": "#ff6b7d" }
        },
        {
            "name": "Strings",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#2ed573" }
        },
        {
            "name": "String Escape Characters",
            "scope": ["constant.character.escape", "string.regexp"],
            "settings": { "foreground": "#7bed9f" }
        },
        {
            "name": "Numbers & Constants",
            "scope": [
                "constant.numeric",
                "constant.language.boolean",
                "constant.language.null",
                "constant.language.undefined",
                "constant.other",
                "constant.character.escape"
            ],
            "settings": { "foreground": "#d9a8ff" }
        },
        {
            "name": "Variables (Light for JS)",
            "scope": ["variable", "variable.other", "meta.definition.variable"],
            "settings": { "foreground": "#e0e0e0" }
        },
        {
            "name": "Variable Parameters (Lighter)",
            "scope": [
                "variable.parameter",
                "meta.parameter variable",
                "variable.other.js"
            ],
            "settings": { "foreground": "#f0f0f0" }
        },
        {
            "name": "Functions (Dark for JS)",
            "scope": [
                "entity.name.function",
                "meta.function-call",
                "support.function",
                "keyword.other.special-method"
            ],
            "settings": { "foreground": "#d4845c", "fontStyle": "bold" }
        },
        {
            "name": "Classes",
            "scope": [
                "entity.name.class",
                "entity.name.type.class",
                "support.class",
                "entity.name.type"
            ],
            "settings": { "foreground": "#26d0ce" }
        },
        {
            "name": "Methods",
            "scope": [
                "entity.name.function.member",
                "meta.method-call",
                "meta.method"
            ],
            "settings": { "foreground": "#5ac2dc" }
        },
        {
            "name": "Properties",
            "scope": [
                "variable.other.property",
                "variable.other.object.property",
                "meta.property-name"
            ],
            "settings": { "foreground": "#40c8c6" }
        },
        {
            "name": "Types",
            "scope": [
                "storage.type",
                "entity.name.type",
                "support.type",
                "keyword.type"
            ],
            "settings": { "foreground": "#5352ed" }
        },
        {
            "name": "HTML Tags",
            "scope": ["entity.name.tag", "punctuation.definition.tag"],
            "settings": { "foreground": "#d4845c" }
        },
        {
            "name": "HTML Attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#c9a87c" }
        },
        {
            "name": "CSS Classes",
            "scope": ["entity.other.attribute-name.class.css"],
            "settings": { "foreground": "#26d0ce" }
        },
        {
            "name": "CSS IDs",
            "scope": ["entity.other.attribute-name.id.css"],
            "settings": { "foreground": "#d9a8ff" }
        },
        {
            "name": "CSS Properties",
            "scope": ["support.type.property-name.css"],
            "settings": { "foreground": "#40c8c6" }
        },
        {
            "name": "JSON Keys",
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#40c8c6" }
        },
        {
            "name": "Markdown Headings",
            "scope": ["markup.heading", "entity.name.section.markdown"],
            "settings": { "foreground": "#d4845c", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Bold",
            "scope": ["markup.bold"],
            "settings": { "foreground": "#ff4757", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Italic",
            "scope": ["markup.italic"],
            "settings": { "foreground": "#d9a8ff", "fontStyle": "italic" }
        },
        {
            "name": "Markdown Code",
            "scope": ["markup.inline.raw", "markup.fenced_code"],
            "settings": { "foreground": "#2ed573" }
        },
        {
            "name": "Markdown Links",
            "scope": ["markup.underline.link", "string.other.link"],
            "settings": { "foreground": "#26d0ce" }
        },
        {
            "name": "Invalid/Error",
            "scope": ["invalid", "invalid.illegal"],
            "settings": {
                "foreground": "#ff6b7d",
                "fontStyle": "bold underline"
            }
        },
        {
            "name": "Deprecated",
            "scope": ["invalid.deprecated"],
            "settings": {
                "foreground": "#c9a87c",
                "fontStyle": "strikethrough"
            }
        },
        {
            "name": "JavaScript/TypeScript Import/Export",
            "scope": [
                "keyword.control.import",
                "keyword.control.export",
                "keyword.control.from"
            ],
            "settings": { "foreground": "#ff6b7d", "fontStyle": "bold" }
        },
        {
            "name": "JavaScript/TypeScript This",
            "scope": ["variable.language.this", "variable.language.super"],
            "settings": { "foreground": "#c78dff", "fontStyle": "italic" }
        },
        {
            "name": "Decorators",
            "scope": ["meta.decorator", "entity.name.function.decorator"],
            "settings": { "foreground": "#ff6b5b" }
        },
        {
            "name": "Python Decorators",
            "scope": [
                "entity.name.function.decorator.python",
                "punctuation.definition.decorator.python"
            ],
            "settings": { "foreground": "#ff6b7d" }
        },
        {
            "name": "Python Self/Cls",
            "scope": [
                "variable.language.special.self.python",
                "variable.parameter.function.language.special.self.python"
            ],
            "settings": { "foreground": "#c78dff", "fontStyle": "italic" }
        },
        {
            "name": "Python Magic Methods",
            "scope": ["support.function.magic.python"],
            "settings": { "foreground": "#d4a5ff", "fontStyle": "bold italic" }
        },
        {
            "name": "Constants",
            "scope": [
                "constant.other",
                "constant.language",
                "variable.other.constant"
            ],
            "settings": { "foreground": "#d4a5ff" }
        },
        {
            "name": "Object Keys",
            "scope": ["meta.object-literal.key", "string.unquoted.label"],
            "settings": { "foreground": "#40c8c6" }
        },
        {
            "name": "Support Functions",
            "scope": ["support.function.builtin", "support.function.console"],
            "settings": { "foreground": "#c9a87c" }
        },
        {
            "name": "Template Expressions",
            "scope": [
                "punctuation.definition.template-expression.begin",
                "punctuation.definition.template-expression.end"
            ],
            "settings": { "foreground": "#ff6b7d" }
        },
        {
            "name": "Regular Expressions",
            "scope": ["string.regexp", "string.regexp keyword.operator"],
            "settings": { "foreground": "#7bed9f", "fontStyle": "italic" }
        },
        {
            "name": "JSX Component Names",
            "scope": ["entity.name.tag.jsx", "support.class.component.jsx"],
            "settings": { "foreground": "#26d0ce" }
        },
        {
            "name": "JSX Attributes",
            "scope": ["entity.other.attribute-name.jsx"],
            "settings": { "foreground": "#ffa502", "fontStyle": "italic" }
        },
        {
            "name": "TypeScript Interfaces",
            "scope": ["entity.name.type.interface"],
            "settings": { "foreground": "#5352ed", "fontStyle": "bold italic" }
        },
        {
            "name": "TypeScript Type Aliases",
            "scope": ["entity.name.type.alias"],
            "settings": { "foreground": "#5352ed", "fontStyle": "italic" }
        },
        {
            "name": "TypeScript Generics",
            "scope": ["entity.name.type.parameter"],
            "settings": { "foreground": "#a0c4ff", "fontStyle": "italic" }
        },
        {
            "name": "SQL Keywords",
            "scope": ["keyword.other.sql", "keyword.other.DML.sql"],
            "settings": { "foreground": "#d4845c", "fontStyle": "bold" }
        },
        {
            "name": "YAML Keys",
            "scope": ["entity.name.tag.yaml"],
            "settings": { "foreground": "#40c8c6" }
        },
        {
            "name": "INI Section Names",
            "scope": ["entity.name.section.group-title.ini"],
            "settings": { "foreground": "#d4845c", "fontStyle": "bold" }
        },
        {
            "name": "XML/HTML Tag Brackets",
            "scope": [
                "punctuation.definition.tag.begin",
                "punctuation.definition.tag.end"
            ],
            "settings": { "foreground": "#ff6b7d" }
        },
        {
            "name": "Embedded Punctuation",
            "scope": ["punctuation.section.embedded"],
            "settings": { "foreground": "#ff6b7d" }
        },
        {
            "name": "Function Parameters",
            "scope": [
                "variable.parameter",
                "meta.function.parameters",
                "variable.parameter.function"
            ],
            "settings": { "foreground": "#d9a8ff", "fontStyle": "italic" }
        },
        {
            "name": "Enum Members",
            "scope": ["variable.other.enummember"],
            "settings": { "foreground": "#d9a8ff" }
        },
        {
            "name": "Type Keywords",
            "scope": [
                "keyword.type.ts",
                "storage.type.ts",
                "keyword.type.java",
                "keyword.type.cpp"
            ],
            "settings": { "foreground": "#d9a8ff", "fontStyle": "bold italic" }
        },
        {
            "name": "Array/Collection Brackets",
            "scope": [
                "punctuation.definition.array",
                "punctuation.definition.collection"
            ],
            "settings": { "foreground": "#c9a87c" }
        },
        {
            "name": "Constructor",
            "scope": [
                "entity.name.function.constructor",
                "meta.function.constructor"
            ],
            "settings": { "foreground": "#d4845c", "fontStyle": "bold" }
        },
        {
            "name": "Built-in Functions (map, filter, reduce)",
            "scope": [
                "support.function.builtin.js",
                "support.function.builtin.ts"
            ],
            "settings": { "foreground": "#26d0ce", "fontStyle": "bold italic" }
        },
        {
            "name": "Variable Names",
            "scope": [
                "variable.other.readwrite",
                "variable.other.object",
                "meta.variable-binding"
            ],
            "settings": { "foreground": "#c0c0c0" }
        },
        {
            "name": "Arrow Functions",
            "scope": ["storage.type.arrow.js", "keyword.operator.arrow"],
            "settings": { "foreground": "#ff6b7d", "fontStyle": "bold" }
        },
        {
            "name": "Async/Await Keywords (Dark for JS)",
            "scope": ["keyword.control.async", "keyword.control.await"],
            "settings": { "foreground": "#ff4757", "fontStyle": "bold" }
        },
        {
            "name": "Async Function Parameters",
            "scope": [
                "meta.function.async meta.function.parameters variable.parameter"
            ],
            "settings": { "foreground": "#b0d0ff", "fontStyle": "italic" }
        },
        {
            "name": "ENUM Declarations",
            "scope": ["storage.type.enum", "keyword.declaration.enum"],
            "settings": { "foreground": "#d9a8ff", "fontStyle": "bold" }
        },
        {
            "name": "Object Literal Keys",
            "scope": ["meta.object.member meta.object-literal.key"],
            "settings": { "foreground": "#5ac2dc" }
        },
        {
            "name": "Destructuring Pattern",
            "scope": ["variable.other.destructuring", "meta.destructuring"],
            "settings": { "foreground": "#a0c4ff" }
        },
        {
            "name": "Environment Variable Names",
            "scope": ["variable.other.env", "string.other.identifier.env"],
            "settings": { "foreground": "#ff4757", "fontStyle": "bold" }
        },
        {
            "name": "Environment Variable Values",
            "scope": ["string.unquoted.env"],
            "settings": { "foreground": "#ffffff", "fontStyle": "bold" }
        },
        {
            "name": "Database Schema Types",
            "scope": ["support.type.primitive.schema", "keyword.other.schema"],
            "settings": { "foreground": "#a0c4ff" }
        },
        {
            "name": "Database Schema Modifiers",
            "scope": ["keyword.other.modifier.schema"],
            "settings": { "foreground": "#c9a87c" }
        },
        {
            "name": "Comment Parameters",
            "scope": [
                "comment.block.documentation variable",
                "punctuation.definition.comment variable"
            ],
            "settings": { "foreground": "#ffa502", "fontStyle": "italic" }
        },
        {
            "name": "Namespace/Module",
            "scope": ["entity.name.namespace", "entity.name.scope-resolution"],
            "settings": { "foreground": "#26d0ce", "fontStyle": "italic" }
        },
        {
            "name": "Async/Await",
            "scope": ["keyword.control.async", "keyword.control.await"],
            "settings": { "foreground": "#ff6b7d", "fontStyle": "bold italic" }
        },
        {
            "name": "Arrow Functions",
            "scope": ["storage.type.function.arrow"],
            "settings": { "foreground": "#ff6b7d" }
        },
        {
            "name": "Control Flow",
            "scope": [
                "keyword.control.flow",
                "keyword.control.loop",
                "keyword.control.conditional"
            ],
            "settings": { "foreground": "#ff6b5b" }
        },
        {
            "name": "Getter/Setter",
            "scope": ["keyword.getter", "keyword.setter"],
            "settings": { "foreground": "#c9a87c" }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "variable": "#e0e0e0",
        "variable.declaration": "#ff4757",
        "parameter": "#f0f0f0",
        "parameter.readonly": "#a0c4ff",
        "function": "#d4845c",
        "function.defaultLibrary": "#26d0ce",
        "method": "#5ac2dc",
        "method.declaration": "#5ac2dc",
        "class": "#26d0ce",
        "interface": "#5352ed",
        "enum": "#d9a8ff",
        "enumMember": "#b8d4ff",
        "namespace": "#40c8c6",
        "property": "#40c8c6",
        "property.declaration": "#e0e0e0",
        "macro": "#ff6b7d",
        "keyword": "#ff4757",
        "keyword.declaration": "#ff4757",
        "comment": "#666666",
        "type": "#5352ed",
        "struct": "#26d0ce",
        "typeParameter": "#a0c4ff",
        "decorator": "#ff6b7d",
        "event": "#d4845c",
        "modifier": "#ff4757",
        "modifier.readonly": "#9090ff",
        "modifier.static": "#ff4757",
        "regexp": "#7bed9f",
        "string": "#2ed573",
        "variable.readonly": "#a0c4ff",
        "variable.readonly.static": "#d9a8ff",
        "function.readonly": "#d4845c",
        "class.readonly": "#26d0ce",
        "variable.defaultLibrary": "#26d0ce",
        "function.constructor": "#d4845c",
        "method.async": "#ff4757",
        "parameter.label": "#ff4757"
    },
    "$schema": "vscode://schemas/color-theme"
}
