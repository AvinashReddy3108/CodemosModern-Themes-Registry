        "statusBarItem.remoteBackground": "#eaeef2",
        "statusBarItem.hoverBackground": "#1f232814",
        "statusBarItem.activeBackground": "#1f23281f",
        "statusBarItem.focusBorder": "#0969da",
        "editorGroupHeader.tabsBackground": "#ffffff",
