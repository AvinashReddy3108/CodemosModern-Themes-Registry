    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "fontStyle": "italic", "foreground": "#6b7382" }
        },
        {
            "name": "Keyword",
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#8ab4f8" }
        },
        {
            "name": "Operator",
            "scope": ["keyword.operator", "punctuation"],
            "settings": { "foreground": "#a2b0c7" }
        },
        {
            "name": "String",
            "scope": ["string", "constant.other.symbol"],
            "settings": { "foreground": "#98c379" }
        },
        {
            "name": "Number and Constant",
            "scope": [
                "constant.numeric",
                "constant.language",
                "constant.character"
            ],
            "settings": { "foreground": "#e5c07b" }
        },
        {
            "name": "Function",
            "scope": [
                "entity.name.function",
                "support.function",
                "variable.function"
            ],
            "settings": { "foreground": "#7dcfff" }
        },
        {
            "name": "Type and Class",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.type",
                "support.class"
            ],
            "settings": { "foreground": "#e5c07b" }
        },
        {
            "name": "Variable",
            "scope": ["variable", "variable.other", "variable.parameter"],
            "settings": { "foreground": "#f2c97d" }
        },
        {
            "name": "Property",
            "scope": ["variable.other.property", "support.type.property-name"],
            "settings": { "foreground": "#cfd6e4" }
        },
        {
            "name": "Tag",
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#f7768e" }
        },
        {
            "name": "Attribute",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#c792ea" }
        },
        {
            "name": "Markup Heading",
            "scope": ["markup.heading"],
            "settings": { "foreground": "#8ab4f8", "fontStyle": "bold" }
        },
        {
            "name": "Markup Bold",
            "scope": ["markup.bold"],
            "settings": { "fontStyle": "bold", "foreground": "#e5c07b" }
        },
        {
            "name": "Markup Italic",
            "scope": ["markup.italic"],
            "settings": { "fontStyle": "italic", "foreground": "#c792ea" }
        },
        {
            "name": "Markup Quote",
            "scope": ["markup.quote"],
            "settings": { "foreground": "#7a8496", "fontStyle": "italic" }
        },
        {
            "name": "Diff Deleted",
            "scope": ["markup.deleted"],
            "settings": { "foreground": "#f7768e" }
        },
        {
            "name": "Diff Inserted",
            "scope": ["markup.inserted"],
            "settings": { "foreground": "#98c379" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#f7768e" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
