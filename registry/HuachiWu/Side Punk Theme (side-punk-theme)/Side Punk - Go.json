{
    "name": "Side Punk - GoLang",
    "type": "dark",
    "colors": {
        "editor.foreground": "#FFFFFF",
        "editor.background": "#111111",
        "editor.selectionBackground": "#FFE792",
        "editor.lineHighlightBackground": "#1B1B1B",
        "editorCursor.foreground": "#FFFFFF",
        "editorWhitespace.foreground": "#FFFFFF20"
    },
    "tokenColors": [
        { "scope": "comment", "settings": { "foreground": "#FFB67B" } },
        {
            "scope": ["keyword", "storage.type"],
            "settings": { "foreground": "#ED88A1" }
        },
        {
            "scope": ["string", "meta.string"],
            "settings": { "foreground": "#A6E22E" }
        },
        {
            "scope": ["variable", "constant.numeric"],
            "settings": { "foreground": "#F92672" }
        },
        {
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#66D9EF" }
        },
        {
            "scope": ["punctuation.definition.comment"],
            "settings": { "foreground": "#F8F8F8" }
        },
        { "scope": ["invalid"], "settings": { "foreground": "#FD971F" } }
    ],
    "$schema": "vscode://schemas/color-theme"
}
