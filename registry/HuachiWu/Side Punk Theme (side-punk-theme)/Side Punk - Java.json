{
    "name": "Side Punk - Java",
    "type": "dark",
    "colors": {
        "editor.foreground": "#FFFFFF",
        "editor.background": "#0E0E10",
        "editor.selectionBackground": "#FFE792",
        "editor.lineHighlightBackground": "#1C1C1E",
        "editorCursor.foreground": "#FFFFFF",
        "editorWhitespace.foreground": "#FFFFFF20"
    },
    "tokenColors": [
        { "scope": "comment", "settings": { "foreground": "#757575" } },
        {
            "scope": ["keyword", "storage.type"],
            "settings": { "foreground": "#CB86E2" }
        },
        {
            "scope": ["string", "meta.string"],
            "settings": { "foreground": "#A5E22E" }
        },
        {
            "scope": ["variable", "constant.numeric"],
            "settings": { "foreground": "#FF5874" }
        },
        {
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#FFA19E" }
        },
        {
            "scope": ["punctuation.definition.comment"],
            "settings": { "foreground": "#B2B2B2" }
        },
        { "scope": ["invalid"], "settings": { "foreground": "#FF5370" } }
    ],
    "$schema": "vscode://schemas/color-theme"
}
