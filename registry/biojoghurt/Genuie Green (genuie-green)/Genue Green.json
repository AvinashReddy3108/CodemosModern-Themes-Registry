        "terminal.ansiBlue": "#00C800",
        "terminal.ansiBrightBlack": "#004900",
        "terminal.ansiBrightBlue": "#00C800",
        "terminal.ansiBrightCyan": "#00FF00",
        "terminal.ansiBrightGreen": "#004B23",
        "terminal.ansiBrightMagenta": "#006400",
        "terminal.ansiBrightRed": "#007200",
        "terminal.ansiBrightWhite": "#00FF00",
        "terminal.ansiBrightYellow": "#006400",
        "terminal.ansiCyan": "#00FF00",
        "terminal.ansiGreen": "#004B23",
        "terminal.ansiMagenta": "#006400",
        "terminal.ansiRed": "#007200",
        "terminal.ansiWhite": "#00FF00",
        "terminal.ansiYellow": "#006400",
        "terminalCursor.background": "#000000",
        "terminalCursor.foreground": "#006400",
        "textLink.activeForeground": "#00FF00",
        "textLink.foreground": "#004900",
        "titleBar.activeBackground": "#000000",
        "titleBar.activeForeground": "#00FF00",
        "titleBar.border": "#00ff0050",
        "titleBar.inactiveBackground": "#000000",
        "titleBar.inactiveForeground": "#004900",
        "tree.indentGuidesStroke": "#414141",
        "widget.shadow": "#00ff00"
