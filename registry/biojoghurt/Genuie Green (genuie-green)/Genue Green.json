        "tab.border": "#00ff0050",
        "tab.inactiveBackground": "#00490020",
        "tab.inactiveForeground": "#00FF00af",
        "tab.unfocusedActiveBorder": "#00ff0050",
        "tab.unfocusedActiveBackground": "#00490040",
        "tab.unfocusedActiveForeground": "#00FF00",
        "tab.unfocusedInactiveBackground": "#00490010",
        "tab.unfocusedInactiveForeground": "#00FF007f",
