        "settings.numberInputBackground": "#000000",
        "settings.numberInputForeground": "#FF0000",
        "settings.textInputBackground": "#000000",
        "settings.textInputForeground": "#FF0000",
        "sideBar.background": "#200909",
        "sideBar.border": "#ffff00",
        "sideBar.foreground": "#ff9d00",
        "sideBarSectionHeader.background": "#140404",
