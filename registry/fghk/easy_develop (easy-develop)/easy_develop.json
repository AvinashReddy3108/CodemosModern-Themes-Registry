{
    "type": "dark",
    "name": "fghk_theme",
    "colors": {
        "diffEditor.insertedTextBackground": "#66f0c213",
        "dropdown.background": "#141820",
        "scrollbar.shadow": "#11141a11",
        "scrollbarSlider.activeBackground": "#ffffff22",
        "scrollbarSlider.background": "#ffffff11",
        "scrollbarSlider.hoverBackground": "#ffffff22",
        "editor.background": "#141e1b",
        "editor.foreground": "#b7d07a",
        "editor.lineHighlightBackground": "#99bbff0a",
        "editorBracketMatch.background": "#68b88e33",
        "editorBracketHighlight.foreground6": "#619ac3",
        "editorBracketHighlight.foreground5": "#63bbd0",
        "editorBracketHighlight.foreground4": "#57c3c2",
        "editorBracketHighlight.foreground3": "#83cbac",
        "editorBracketHighlight.foreground2": "#579572",
        "editorBracketHighlight.foreground1": "#20894d",
        "editorBracketHighlight.unexpectedBracket.foreground": "#b7d07a",
        "editor.selectionBackground": "#314a43",
        "editor.wordHighlightBackground": "#343F56",
        "editorCursor.foreground": "#b7d07a",
        "editorGroup.border": "#68b88e26",
        "editorGroupHeader.tabsBackground": "#141e1b",
        "editorLineNumber.activeForeground": "#68b88e",
        "editorLineNumber.foreground": "#c6dfc8",
        "editorIndentGuide.background": "#68b88e26",
        "editorSuggestWidget.background": "#141e1bdd",
        "editorWhitespace.foreground": "#68b88e26",
        "editorWidget.background": "#141820",
        "tab.activeBackground": "#141e1b",
        "tab.activeForeground": "#68b88e",
        "tab.activeBorder": "#68b88e",
        "tab.inactiveBackground": "#141e1b",
        "tab.inactiveForeground": "#68b88e",
        "activityBar.background": "#141e1b",
        "activityBarBadge.background": "#141e1b",
        "activityBarBadge.foreground": "#68b88e",
        "activityBar.foreground": "#68b88e",
        "activityBar.inactiveForeground": "#c6dfc8",
        "sideBar.background": "#15231b",
        "sideBarSectionHeader.background": "#141e1b",
        "sideBarTitle.foreground": "#c6dfc8",
        "list.activeSelectionBackground": "#141e1b",
        "list.activeSelectionForeground": "#c6dfc8",
        "list.focusBackground": "#141e1b",
        "list.focusForeground": "#c6dfc8",
        "list.inactiveSelectionBackground": "#141e1b",
        "list.inactiveSelectionForeground": "#c6dfc8",
        "list.hoverBackground": "#141e1b",
        "list.hoverForeground": "#c6dfc8",
        "list.inactiveFocusOutline": "#c6dfc8",
        "list.warningForeground": "#fbb957",
        "list.errorForeground": "#d11a2d",
        "menu.foreground": "#68b88e",
        "menu.background": "#141e1b",
        "menubar.selectionForeground": "#68b88e",
        "menubar.selectionBackground": "#141e1b",
        "foreground": "#68b88e",
        "button.background": "#68b88e99",
        "button.foreground": "#141e1b",
        "button.hoverBackground": "#68b88edd",
        "titleBar.activeBackground": "#141e1b",
        "titleBar.activeForeground": "#68b88e",
        "titleBar.inactiveBackground": "#141e1b",
        "titleBar.inactiveForeground": "#68b88e",
        "titleBar.border": "#141e1b",
        "statusBar.background": "#15231b",
        "statusBar.foreground": "#68b88e",
        "input.background": "#141e1b",
        "input.border": "#68b88e",
        "input.foreground": "#68b88e",
        "input.placeholderForeground": "#68b88e",
        "panel.background": "#141e1b",
        "panelTitle.activeForeground": "#68b88e"
    },
    "tokenColors": [
        {
            "name": "Comment",
            "scope": "comment",
            "settings": { "foreground": "#acacac", "fontStyle": "bold" }
        },
        {
            "name": "String",
            "scope": [
                "string.quoted",
                "string.template",
                "punctuation.definition.string",
                "punctuation.definition.block",
                "source"
            ],
            "settings": { "foreground": "#d4ffc7b8", "fontStyle": "bold" }
        },
        {
            "name": "Punctuation within templates",
            "scope": "string.template meta.embedded.line",
            "settings": { "foreground": "#f3f3f3" }
        },
        {
            "name": "Variable",
            "scope": ["variable", "entity.name.variable"],
            "settings": { "foreground": "#85EEA7" }
        },
        {
            "name": "Language variable",
            "scope": ["variable.language", "variable.other.object.js"],
            "settings": { "foreground": "#85EEA7" }
        },
        {
            "name": "Parameter",
            "scope": "variable.parameter",
            "settings": { "foreground": "#68d88e", "fontStyle": "bold" }
        },
        {
            "name": "Storage (declaration or modifier keyword)",
            "scope": ["storage.type", "storage.modifier"],
            "settings": {
                "foreground": "#12a182",
                "fontStyle": "italic underline"
            }
        },
        {
            "name": "Constant",
            "scope": "constant",
            "settings": { "foreground": "#85EEA7" }
        },
        {
            "name": "Regex",
            "scope": "string.regexp",
            "settings": { "foreground": "#85EEA7" }
        },
        {
            "name": "Number",
            "scope": "constant.numeric",
            "settings": { "foreground": "#b9dec9", "fontStyle": "bold" }
        },
        {
            "name": "Language constant (boolean, null)",
            "scope": "constant.language",
            "settings": { "foreground": "#b9dec9" }
        },
        {
            "name": "Character escape",
            "scope": "constant.character.escape",
            "settings": { "foreground": "#b2cf87" }
        },
        {
            "name": "Entity",
            "scope": "entity.name",
            "settings": { "foreground": "#87d9a2" }
        },
        {
            "name": "HTML or XML tag",
            "scope": "entity.name.tag",
            "settings": { "foreground": "#68d88e", "fontStyle": "italic bold" }
        },
        {
            "name": "HTML or XML tag brackets",
            "scope": ["punctuation.definition.tag"],
            "settings": { "foreground": "#6ab58362" }
        },
        {
            "name": "Tag atttribute",
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#8cffd5bb" }
        },
        {
            "name": "Class",
            "scope": "entity.name.type",
            "settings": { "foreground": "#77ffa4", "fontStyle": "italic bold" }
        },
        {
            "name": "Inherited class",
            "scope": "entity.other.inherited-class",
            "settings": { "foreground": "#b2cf87" }
        },
        {
            "name": "Function",
            "scope": ["entity.name.function", "variable.function"],
            "settings": { "foreground": "#d6ffb0", "fontStyle": "italic" }
        },
        {
            "name": "Keyword",
            "scope": "keyword",
            "settings": { "foreground": "#5f7f78", "fontStyle": "italic bold" }
        },
        {
            "name": "Control keyword (if, try, while, etc.)",
            "scope": "keyword.control",
            "settings": { "foreground": "#d6ffc4", "fontStyle": "italic bold" }
        },
        {
            "name": "Operator",
            "scope": "keyword.operator",
            "settings": { "foreground": "#b9dec9", "fontStyle": "bold" }
        },
        {
            "name": "Special operator",
            "scope": [
                "keyword.operator.new",
                "keyword.operator.expression",
                "keyword.operator.logical"
            ],
            "settings": { "foreground": "#12a182", "fontStyle": "italic bold" }
        },
        {
            "name": "Unit",
            "scope": "keyword.other.unit",
            "settings": { "foreground": "#85EEA7" }
        },
        {
            "name": "Support",
            "scope": "support",
            "settings": { "foreground": "#68d88e", "fontStyle": "italic" }
        },
        {
            "name": "Support function",
            "scope": "support.function",
            "settings": {
                "foreground": "#d6ffb0",
                "fontStyle": "italic underline"
            }
        },
        {
            "name": "Support variable",
            "scope": "support.variable",
            "settings": { "foreground": "#d6ffb0", "fontStyle": "bold" }
        },
        {
            "name": "Object literal key / property",
            "scope": ["meta.object-literal.key", "support.type.property-name"],
            "settings": { "foreground": "#68d88e" }
        },
        {
            "name": "JS Variable Property",
            "scope": "variable.other.property.js",
            "settings": { "foreground": "#d6ffb0", "fontStyle": "italic" }
        },
        {
            "name": "Key-value separator",
            "scope": "punctuation.separator.key-value",
            "settings": { "foreground": "#b9dec9", "fontStyle": "bold" }
        },
        {
            "name": "Puncuation Definition block",
            "scope": "punctuation.section.embedded",
            "settings": { "foreground": "#b2cf87" }
        },
        {
            "name": "Template expression",
            "scope": [
                "punctuation.definition.template-expression.begin",
                "punctuation.definition.template-expression.end"
            ],
            "settings": { "foreground": "#b9dec9" }
        },
        {
            "name": "CSS property",
            "scope": [
                "support.type.property-name.css",
                "support.type.vendored.property-name.css"
            ],
            "settings": { "foreground": "#b2cf87", "fontStyle": "" }
        },
        {
            "name": "Color",
            "scope": "constant.other.color",
            "settings": { "foreground": "#b9dec9", "fontStyle": "bold" }
        },
        {
            "name": "Font names",
            "scope": "support.constant.font-name",
            "settings": { "foreground": "#85EEA7" }
        },
        {
            "name": "CSS #id",
            "scope": "entity.other.attribute-name.id",
            "settings": { "foreground": "#b9dec9", "fontStyle": "italic bold" }
        },
        {
            "name": "CSS .class",
            "scope": "entity.other.attribute-name.class",
            "settings": { "foreground": "#b9dec9", "fontStyle": "italic" }
        },
        {
            "name": "Pseudo CSS",
            "scope": [
                "entity.other.attribute-name.pseudo-element",
                "entity.other.attribute-name.pseudo-class"
            ],
            "settings": { "foreground": "#b2cf87" }
        },
        {
            "name": "CSS support functions (rgb)",
            "scope": "support.function.misc.css",
            "settings": { "foreground": "#b9dec9", "fontStyle": "bold" }
        },
        {
            "name": "Markup heading",
            "scope": ["markup.heading", "entity.name.section"],
            "settings": { "foreground": "#85EEA7" }
        },
        {
            "name": "Markup quote",
            "scope": "markup.quote",
            "settings": { "foreground": "#FF407B", "fontStyle": "bold" }
        },
        {
            "name": "Markup list",
            "scope": "beginning.punctuation.definition.list",
            "settings": { "foreground": "#85EEA7" }
        },
        {
            "name": "Markup link",
            "scope": "markup.underline.link",
            "settings": { "foreground": "#b2cf87" }
        },
        {
            "name": "Markup link description",
            "scope": "string.other.link.description",
            "settings": { "foreground": "#85EEA7" }
        },
        {
            "name": "Python function call",
            "scope": "meta.function-call.generic.python",
            "settings": { "foreground": "#fcfcfc" }
        },
        {
            "name": "C# storage type",
            "scope": "storage.type.cs",
            "settings": { "foreground": "#b9dec9", "fontStyle": "bold" }
        },
        {
            "name": "C# local variable",
            "scope": "entity.name.variable.local.cs",
            "settings": { "foreground": "#85EEA7" }
        },
        {
            "name": "C# properties and fields",
            "scope": [
                "entity.name.variable.field.cs",
                "entity.name.variable.property.cs"
            ],
            "settings": { "foreground": "#85EEA7" }
        },
        {
            "name": "C++ operators",
            "scope": "source.cpp keyword.operator",
            "settings": { "foreground": "#b9dec9", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Punctuation heading",
            "scope": "punctuation.definition.heading.markdown",
            "settings": { "foreground": "#b9dec9" }
        },
        {
            "name": "Markdown Bold Punctuation",
            "scope": "punctuation.definition.bold.markdown",
            "settings": { "foreground": "#85EEA7" }
        },
        {
            "name": "Markdown Italic Punctuation",
            "scope": "punctuation.definition.italic.markdown",
            "settings": { "foreground": "#ffffff7e" }
        },
        {
            "name": "Markdown Bold",
            "scope": "markup.bold.markdown",
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Markdown Italic",
            "scope": "markup.italic.markdown",
            "settings": { "fontStyle": "italic" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
