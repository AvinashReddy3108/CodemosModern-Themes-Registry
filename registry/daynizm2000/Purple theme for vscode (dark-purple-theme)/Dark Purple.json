    "semanticTokenColors": {
        "enabled": true,
        "rules": {
            "comment": "#4C3AD6",
            "string": "#6C57FF",
            "string.escape": "#563FE6",
            "string.format": "#563FE6",
            "number": "#6048E6",
            "keyword": "#5A2EFF",
            "operator": "#5A2EFF",
            "function": "#7159FF",
            "variable": "#6450E6",
            "parameter": "#5746D9",
            "type": "#4B3ABF",
            "class": "#4B3ABF",
            "interface": "#5346D1",
            "namespace": "#594DE0",
            "preprocessor": "#4D3FCB",
            "macro": "#4D3FCB",
            "property": "#6355E6",
            "enumMember": "#5348D1",
            "label": "#5348D1",
            "typeParameter": "#4C3ED1",
            "decorator": "#4B3ABF",
            "typeAlias": "#4C3ED1",
            "struct": "#4B3ABF",
            "enum": "#4C3ED1",
            "typedef": "#4C3ED1"
        }
    },
    "tokenColors": [
        {
            "scope": [
                "keyword",
                "storage.type",
                "storage.modifier",
                "keyword.control",
                "keyword.other"
            ],
            "settings": { "foreground": "#5A2EFF" }
        },
        {
            "scope": [
                "constant.character.escape",
                "string.escape",
                "constant.other.placeholder",
                "string.format.placeholder"
            ],
            "settings": { "foreground": "#563FE6" }
        },
        {
            "scope": [
                "string",
                "string.quoted.double",
                "string.quoted.single",
                "string.quoted.other",
                "string.interpolated"
            ],
            "settings": { "foreground": "#6C57FF" }
        },
        {
            "scope": [
                "entity.name.type",
                "entity.name.type.enum",
                "entity.name.type.class",
                "entity.name.type.struct",
                "entity.name.type.interface",
                "entity.name.type.alias",
                "entity.name.type.typedef",
                "support.type"
            ],
            "settings": { "foreground": "#4B3ABF", "fontStyle": "italic" }
        },
        {
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#7159FF" }
        },
        {
            "scope": ["entity.name.type.struct", "entity.name.type.typedef"],
            "settings": { "foreground": "#4B3ABF", "fontStyle": "italic" }
        },
        {
            "scope": ["variable", "variable.other", "variable.other.member"],
            "settings": { "foreground": "#6450E6" }
        },
        {
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#5746D9" }
        },
        {
            "scope": [
                "number",
                "constant.numeric",
                "constant.language.boolean",
                "constant.language"
            ],
            "settings": { "foreground": "#6048E6" }
        },
        {
            "scope": [
                "comment",
                "comment.block",
                "comment.line",
                "punctuation.definition.comment"
            ],
            "settings": { "foreground": "#4C3AD6", "fontStyle": "italic" }
        },
        {
            "scope": [
                "keyword.operator",
                "punctuation.section.block",
                "punctuation.definition.block"
            ],
            "settings": { "foreground": "#5A2EFF" }
        },
        {
            "scope": ["entity.name.function.macro", "support.function.macro"],
            "settings": { "foreground": "#4D3FCB" }
        },
        {
            "scope": [
                "entity.name.function.decorator",
                "support.function.decorator"
            ],
            "settings": { "foreground": "#4B3ABF" }
        },
        {
            "scope": [
                "variable.object.property",
                "support.type.property-name",
                "entity.other.attribute-name"
            ],
            "settings": { "foreground": "#6355E6" }
        },
        {
            "scope": [
                "constant.language.enum",
                "variable.other.enummember",
                "entity.name.enum"
            ],
            "settings": { "foreground": "#4C3ED1" }
        },
        {
            "scope": [
                "punctuation.definition.bracket",
                "punctuation.section.brackets",
                "meta.brace"
            ],
            "settings": { "foreground": "#5046E0" }
        },
        {
            "scope": ["meta.template.expression", "meta.generic"],
            "settings": { "foreground": "#4C3ED1" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
