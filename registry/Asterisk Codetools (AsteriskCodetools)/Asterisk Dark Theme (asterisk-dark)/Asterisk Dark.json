{
    "name": "Asterisk Dark",
    "colors": {
        "editor.background": "#1a1a1a",
        "editor.foreground": "#F2F2F2",
        "statusBar.background": "#555555",
        "statusBar.noFolderBackground": "#555555",
        "statusBar.debuggingBackground": "#FF8308",
        "activityBarBadge.background": "#007acc",
        "sideBarTitle.foreground": "#bbbbbb",
        "editorBracketHighlight.foreground1": "#00D4AA",
        "editorBracketHighlight.foreground2": "#0094FF",
        "editorBracketHighlight.foreground3": "#fbff2b",
        "editorBracketHighlight.foreground4": "#FFAA00",
        "editorBracketHighlight.foreground5": "#C7FF00",
        "editorBracketHighlight.foreground6": "#FF00A6"
    },
    "tokenColors": [
        {
            "scope": [
                "comment",
                "comment.block",
                "comment.documentation",
                "comment.block.documentation"
            ],
            "settings": { "foreground": "#BEBEBE" }
        },
        { "scope": ["keyword"], "settings": { "foreground": "#FF0883" } },
        {
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#ffcd71" }
        },
        {
            "scope": ["entity.name.type.class", "entity.other.inherited-class"],
            "settings": { "foreground": "#A265E0", "fontStyle": "bold" }
        },
        {
            "scope": ["support.type.property-name"],
            "settings": { "foreground": "#A265E0" }
        },
        {
            "scope": [
                "support.type.property-name.scss",
                "support.type.property-name.less",
                "support.type.property-name.css"
            ],
            "settings": { "foreground": "#FFC608" }
        },
        {
            "scope": ["meta.function", "meta.method", "meta.function-call"],
            "settings": { "foreground": "#beb4ee" }
        },
        {
            "scope": ["meta.at-rule.import.css"],
            "settings": { "foreground": "#8ae436" }
        },
        {
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#ffe02f" }
        },
        { "scope": "string", "settings": { "foreground": "#08FF83" } },
        {
            "scope": [
                "variable",
                "variable.other.php",
                "punctuation.definition.variable.php"
            ],
            "settings": { "foreground": "#08A3FF" }
        },
        {
            "scope": ["meta.class.php"],
            "settings": { "foreground": "#A265E0" }
        },
        {
            "scope": ["meta.method-call.static.php"],
            "settings": { "foreground": "#beb4ee" }
        },
        { "scope": "function", "settings": { "foreground": "#1E8EFF" } },
        {
            "scope": ["constant", "support.constant"],
            "settings": { "foreground": "#FF8E1E" }
        },
        { "scope": "number", "settings": { "foreground": "#8EFF1E" } },
        { "scope": ["type"], "settings": { "foreground": "#8E1EFF" } },
        { "scope": "storage", "settings": { "foreground": "#FF8308" } },
        { "scope": "operator", "settings": { "foreground": "#0883FF" } },
        { "scope": "punctuation", "settings": { "foreground": "#BEBEBE" } },
        {
            "scope": [
                "punctuation.section",
                "punctuation.section.parens",
                "punctuation.section.group",
                "punctuation.definition.begin.bracket",
                "punctuation.definition.end.bracket",
                "punctuation.definition.arguments.begin.bracket",
                "punctuation.definition.arguments.end.bracket",
                "punctuation.definition.parameters.begin.bracket",
                "punctuation.definition.parameters.end.bracket"
            ],
            "settings": { "foreground": "#FF8E1E" }
        },
        {
            "scope": "invalid",
            "settings": {
                "foreground": "#FF1E8E",
                "fontStyle": "italic underline"
            }
        },
        {
            "scope": ["entity.name.tag.yaml"],
            "settings": { "foreground": "#08A3FF" }
        },
        {
            "scope": ["meta.block.sequence.yaml"],
            "settings": { "foreground": "#FF8E1E" }
        },
        {
            "name": "Less - ID selector",
            "scope": "entity.other.attribute-name.id",
            "settings": { "foreground": "#08A3FF" }
        },
        {
            "name": "CSS - Class selector",
            "scope": "entity.other.attribute-name.class",
            "settings": { "foreground": "#a5f523" }
        },
        {
            "name": "CSS - Pseudo class selector",
            "scope": "entity.other.attribute-name.pseudo-class",
            "settings": { "foreground": "#22CEF5" }
        },
        {
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#08A3FF" }
        },
        {
            "scope": ["string.quoted.double.json"],
            "settings": { "foreground": "#a5f523" }
        },
        {
            "scope": ["entity.name.tag.tsx"],
            "settings": { "foreground": "#5E84FF" }
        },
        {
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#FF8308" }
        },
        {
            "scope": [
                "punctuation.definition.tag.begin.tsx",
                "punctuation.definition.tag.end.tsx"
            ],
            "settings": { "foreground": "#9F5CFF" }
        },
        { "scope": ["meta.jsx.children"], "settings": { "foreground": "#ddd" } }
    ],
    "$schema": "vscode://schemas/color-theme"
}
