{
    "name": "Dark Clean",
    "semanticHighlighting": true,
    "colors": {
        "editor.background": "#1e1e1e",
        "editor.foreground": "#d4d4d4",
        "editor.lineHighlightBackground": "#282828",
        "editorLineNumber.foreground": "#858585",
        "editorLineNumber.activeForeground": "#c6c6c6",
        "activityBar.background": "#181818",
        "activityBar.foreground": "#d7d7d7",
        "sideBar.background": "#1e1e1e",
        "sideBar.foreground": "#cccccc",
        "statusBar.background": "#181818",
        "statusBar.foreground": "#cccccc",
        "titleBar.activeBackground": "#181818",
        "titleBar.activeForeground": "#cccccc",
        "tab.activeBackground": "#1e1e1e",
        "tab.inactiveBackground": "#2d2d2d"
    },
    "semanticTokenColors": {
        "method": "#ffc66d",
        "function": "#ffc66d",
        "variable": "#74b987",
        "parameter": "#74b987",
        "class": "#ffc66d",
        "type": "#ffc66d",
        "property": "#74b987"
    },
    "tokenColors": [
        {
            "scope": ["keyword", "storage.modifier"],
            "settings": { "foreground": "#cc7832" }
        },
        {
            "scope": [
                "storage.type.primitive",
                "storage.type.built-in.primitive"
            ],
            "settings": { "foreground": "#cc7832" }
        },
        {
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "entity.other.inherited-class",
                "support.class",
                "storage.type",
                "support.type"
            ],
            "settings": { "foreground": "#ffc66d" }
        },
        {
            "scope": [
                "entity.name.function",
                "entity.name.method",
                "meta.function-call",
                "meta.method-call"
            ],
            "settings": { "foreground": "#ffc66d" }
        },
        {
            "scope": [
                "variable",
                "variable.other",
                "variable.other.property",
                "variable.other.constant",
                "variable.other.readwrite",
                "meta.definition.variable"
            ],
            "settings": { "foreground": "#529552" }
        },
        {
            "scope": ["constant.numeric", "constant.language"],
            "settings": { "foreground": "#6897bb" }
        },
        {
            "scope": ["string", "string.quoted"],
            "settings": { "foreground": "#6a8759" }
        },
        {
            "scope": ["comment", "comment.line", "comment.block"],
            "settings": { "foreground": "#808080", "fontStyle": "italic" }
        },
        {
            "scope": [
                "keyword.operator",
                "punctuation.separator",
                "punctuation.terminator",
                "meta.brace",
                "punctuation.definition.parameters"
            ],
            "settings": { "foreground": "#a9b7c6" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
