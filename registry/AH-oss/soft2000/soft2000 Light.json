{
    "name": "Solarized Custom (Light)",
    "type": "light",
    "tokenColors": [
        { "settings": { "foreground": "#7e7ea0" } },
        {
            "scope": [
                "meta.embedded",
                "source.groovy.embedded",
                "string meta.image.inline.markdown",
                "variable.legacy.builtin.python"
            ],
            "settings": { "foreground": "#7e7ea0" }
        },
        {
            "name": "Comment",
            "scope": "comment",
            "settings": { "fontStyle": "italic", "foreground": "#adadc1" }
        },
        {
            "name": "String",
            "scope": "string",
            "settings": { "foreground": "#2d9f96" }
        },
        {
            "name": "Regexp",
            "scope": "string.regexp",
            "settings": { "foreground": "#f35e5e" }
        },
        {
            "name": "Number",
            "scope": "constant.numeric",
            "settings": { "foreground": "#ce78a2" }
        },
        {
            "name": "Variable",
            "scope": ["variable.language", "variable.other"],
            "settings": { "foreground": "#276cd3" }
        },
        {
            "name": "Keyword",
            "scope": "keyword",
            "settings": { "foreground": "#899e00" }
        },
        {
            "name": "Storage",
            "scope": "storage",
            "settings": { "fontStyle": "bold", "foreground": "#646487" }
        },
        {
            "name": "Class name",
            "scope": [
                "entity.name.class",
                "entity.name.type",
                "entity.name.namespace",
                "entity.name.scope-resolution"
            ],
            "settings": { "fontStyle": "", "foreground": "#d37312" }
        },
        {
            "name": "Function name",
            "scope": "entity.name.function",
            "settings": { "foreground": "#276cd3" }
        },
        {
            "name": "Variable start",
            "scope": "punctuation.definition.variable",
            "settings": { "foreground": "#899e00" }
        },
        {
            "name": "Embedded code markers",
            "scope": [
                "punctuation.section.embedded.begin",
                "punctuation.section.embedded.end"
            ],
            "settings": { "foreground": "#f35e5e" }
        },
        {
            "name": "Built-in constant",
            "scope": ["constant.language", "meta.preprocessor"],
            "settings": { "foreground": "#b58900" }
        },
        {
            "name": "Support.construct",
            "scope": ["support.function.construct", "keyword.other.new"],
            "settings": { "foreground": "#d37312" }
        },
        {
            "name": "User-defined constant",
            "scope": ["constant.character", "constant.other"],
            "settings": { "foreground": "#d37312" }
        },
        {
            "name": "Inherited class",
            "scope": [
                "entity.other.inherited-class",
                "punctuation.separator.namespace.ruby"
            ],
            "settings": { "foreground": "#5b78d7" }
        },
        {
            "name": "Function argument",
            "scope": "variable.parameter",
            "settings": {}
        },
        {
            "name": "Tag name",
            "scope": "entity.name.tag",
            "settings": { "foreground": "#276cd3" }
        },
        {
            "name": "Tag start/end",
            "scope": "punctuation.definition.tag",
            "settings": { "foreground": "#adadc1" }
        },
        {
            "name": "Tag attribute",
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#646487" }
        },
        {
            "name": "Library function",
            "scope": "support.function",
            "settings": { "foreground": "#276cd3" }
        },
        {
            "name": "Continuation",
            "scope": "punctuation.separator.continuation",
            "settings": { "foreground": "#f35e5e" }
        },
        {
            "name": "Library constant",
            "scope": ["support.constant", "support.variable"],
            "settings": {}
        },
        {
            "name": "Library class/type",
            "scope": ["support.type", "support.class"],
            "settings": { "foreground": "#899e00" }
        },
        {
            "name": "Library Exception",
            "scope": "support.type.exception",
            "settings": { "foreground": "#d37312" }
        },
        {
            "name": "Library variable",
            "scope": "support.other.variable",
            "settings": {}
        },
        {
            "name": "Invalid",
            "scope": "invalid",
            "settings": { "foreground": "#f35e5e" }
        },
        {
            "name": "diff: header",
            "scope": ["meta.diff", "meta.diff.header"],
            "settings": { "fontStyle": "italic", "foreground": "#276cd3" }
        },
        {
            "name": "diff: deleted",
            "scope": "markup.deleted",
            "settings": { "fontStyle": "", "foreground": "#f35e5e" }
        },
        {
            "name": "diff: changed",
            "scope": "markup.changed",
            "settings": { "fontStyle": "", "foreground": "#d37312" }
        },
        {
            "name": "diff: inserted",
            "scope": "markup.inserted",
            "settings": { "foreground": "#899e00" }
        },
        {
            "name": "Markup Quote",
            "scope": "markup.quote",
            "settings": { "foreground": "#899e00" }
        },
        {
            "name": "Markup Lists",
            "scope": "markup.list",
            "settings": { "foreground": "#b58900" }
        },
        {
            "name": "Markup Styling",
            "scope": ["markup.bold", "markup.italic"],
            "settings": { "foreground": "#ce78a2" }
        },
        {
            "name": "Markup: Strong",
            "scope": "markup.bold",
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Markup: Emphasis",
            "scope": "markup.italic",
            "settings": { "fontStyle": "italic" }
        },
        {
            "scope": "markup.strikethrough",
            "settings": { "fontStyle": "strikethrough" }
        },
        {
            "name": "Markup Inline",
            "scope": "markup.inline.raw",
            "settings": { "fontStyle": "", "foreground": "#2d9f96" }
        },
        {
            "name": "Markup Headings",
            "scope": "markup.heading",
            "settings": { "fontStyle": "bold", "foreground": "#276cd3" }
        },
        {
            "name": "Markup Setext Header",
            "scope": "markup.heading.setext",
            "settings": { "fontStyle": "", "foreground": "#276cd3" }
        }
    ],
    "colors": {
