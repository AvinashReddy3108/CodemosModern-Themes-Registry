{
    "name": "Aethero Dark Soft",
    "type": "dark",
    "colors": {
        "editor.background": "#12141e",
        "editor.foreground": "#c0c0c0",
        "editor.lineHighlightBackground": "#191b25",
        "editorCursor.foreground": "#c792ea",
        "editor.selectionBackground": "#2a2e3d99",
        "editorLineNumber.foreground": "#5b6078",
        "editorLineNumber.activeForeground": "#c792ea"
    },
    "tokenColors": [
        {
            "scope": ["comment"],
            "settings": { "foreground": "#5b6078", "fontStyle": "italic" }
        },
        { "scope": ["keyword"], "settings": { "foreground": "#c792ea" } },
        { "scope": ["string"], "settings": { "foreground": "#c3e88d" } },
        { "scope": ["variable"], "settings": { "foreground": "#c0c0c0" } },
        {
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#a9a1e1" }
        },
        {
            "scope": ["entity.name.function"],
            "settings": { "foreground": "#82aaff" }
        },
        {
            "scope": ["entity.name.class"],
            "settings": { "foreground": "#89ddff" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
