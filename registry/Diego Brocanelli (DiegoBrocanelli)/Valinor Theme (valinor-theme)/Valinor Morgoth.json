{
    "$schema": "vscode://schemas/color-theme",
    "name": "Valinor Morgoth",
    "author": "Diego Brocanelli",
    "maintainers": ["Diego Brocanelli <diegod2@msn.com>"],
    "semanticClass": "theme.valinor.morgoth",
    "type": "dark",
    "semanticHighlighting": true,
    "colors": {
        "panel.background": "#0a0a0a",
        "titleBar.activeBackground": "#0a0a0a",
        "editorGroupHeader.tabsBackground": "#0a0a0a",
        "quickInput.background": "#0a0a0a",
        "quickInput.foreground": "#CCCCCC",
        "widget.border": "#333333",
        "input.background": "#333333",
        "editorWidget.background": "#0a0a0a",
        "editor.background": "#0a0a0a",
        "editor.foreground": "#c8c8c8",
        "editorCursor.foreground": "#c8c8c8",
        "editor.lineHighlightBackground": "#141414",
        "editor.selectionBackground": "#2a2a2a",
        "editor.selectionHighlightBackground": "#2a2a2a88",
        "editor.wordHighlightBackground": "#2a2a2a66",
        "editorWhitespace.foreground": "#2a2a2a",
        "editorIndentGuide.background1": "#2a2a2a",
        "editorRuler.foreground": "#2a2a2a",
        "editorLineNumber.foreground": "#2a2a2a",
        "editorLineNumber.activeForeground": "#c8c8c8",
        "sideBar.background": "#080808",
        "sideBar.foreground": "#a0a0a0",
        "sideBarTitle.foreground": "#6a6a8a",
        "sideBarSectionHeader.background": "#141414",
        "sideBarSectionHeader.foreground": "#6a6a8a",
        "statusBar.background": "#1a1a1a",
        "statusBar.foreground": "#a0a0a0",
        "activityBar.background": "#080808",
        "activityBar.foreground": "#c8c8c8",
        "activityBarBadge.background": "#6a6a8a",
        "activityBarBadge.foreground": "#0a0a0a",
        "terminal.background": "#0a0a0a",
        "terminal.foreground": "#c8c8c8",
        "terminalCursor.foreground": "#c8c8c8",
        "button.background": "#6a6a8a",
        "button.foreground": "#0a0a0a",
        "editorLink.activeForeground": "#6a6a8a",
        "list.activeSelectionBackground": "#6a6a8a",
        "list.activeSelectionForeground": "#0a0a0a",
        "list.hoverBackground": "#2a2a2a",
        "list.focusHighlightForeground": "#f0f0f0",
        "list.highlightForeground": "#f0f0f0",
        "tab.activeBackground": "#0a0a0a",
        "tab.activeForeground": "#c8c8c8",
        "tab.inactiveBackground": "#080808",
        "tab.inactiveForeground": "#a0a0a0"
    },
    "tokenColors": [
        {
            "name": "Keywords & Storage – italic (valinor-patch)",
            "scope": [
                "keyword.control",
                "keyword.operator.expression",
                "keyword.operator.new",
                "keyword.control.new",
                "storage.type",
                "storage.modifier",
                "keyword.other.use",
                "keyword.other.namespace",
                "storage.modifier.extends",
                "entity.other.inherited-class",
                "variable.language",
                "variable.language.this",
                "variable.language.self",
                "variable.language.super",
                "variable.language.parent",
                "variable.language punctuation.definition.variable.php",
                "punctuation.definition.variable.php",
                "keyword.control.php",
                "keyword.control.flow",
                "keyword.control.async-modifier",
                "keyword.control.import",
                "keyword.control.export",
                "keyword.control.from",
                "keyword.control.return"
            ],
            "settings": { "fontStyle": "italic" }
        },
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#505050", "fontStyle": "italic" }
        },
        {
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.expression"
            ],
            "settings": { "foreground": "#8888aa" }
        },
        {
            "scope": ["storage", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#7070a0" }
        },
        { "scope": ["variable"], "settings": { "foreground": "#c8c8c8" } },
        {
            "scope": ["variable.language"],
            "settings": { "foreground": "#aaaacc", "fontStyle": "italic" }
        },
        {
            "scope": [
                "string",
                "string.quoted",
                "punctuation.definition.string"
            ],
            "settings": { "foreground": "#7a9a7a" }
        },
        {
            "scope": ["constant", "constant.numeric", "constant.language"],
            "settings": { "foreground": "#9a8a6a" }
        },
        {
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#7a7aaa" }
        },
        {
            "scope": [
                "entity.name.type.class",
                "entity.name.class",
                "support.class"
            ],
            "settings": { "foreground": "#7a9090" }
        },
        {
            "scope": ["entity.other.inherited-class"],
            "settings": { "foreground": "#7a9090", "fontStyle": "italic" }
        },
        {
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#8a6a6a" }
        },
        {
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#6a9a8a", "fontStyle": "italic" }
        },
        {
            "scope": ["support.type", "support.class"],
            "settings": { "foreground": "#7a9090" }
        },
        {
            "name": "Function parameters",
            "scope": ["variable.parameter", "entity.name.variable.parameter"],
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "Keyword new",
            "scope": ["keyword.control.new", "keyword.operator.new"],
            "settings": { "fontStyle": "bold italic" }
        },
        {
            "name": "Markup italic",
            "scope": ["markup.italic"],
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "Markup bold",
            "scope": ["markup.bold"],
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Markup heading",
            "scope": ["markup.heading"],
            "settings": { "foreground": "#7a7aaa", "fontStyle": "bold" }
        }
    ]
}
