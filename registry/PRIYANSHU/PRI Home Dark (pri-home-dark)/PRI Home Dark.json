        "tab.inactiveBackground": "#F0980020",
        "tab.inactiveForeground": "#CFDBD5af",
        "tab.unfocusedActiveBorder": "#F09800",
        "tab.unfocusedActiveBackground": "#F0980040",
        "tab.unfocusedActiveForeground": "#CFDBD5",
        "tab.unfocusedInactiveBackground": "#F0980010",
        "tab.unfocusedInactiveForeground": "#CFDBD57f",
        "terminal.ansiBlack": "#000000",
        "terminal.ansiBlue": "#84D2F6",
        "terminal.ansiBrightBlack": "#F09800",
        "terminal.ansiBrightBlue": "#84D2F6",
        "terminal.ansiBrightCyan": "#BEE1E6",
        "terminal.ansiBrightGreen": "#C8E1F4",
        "terminal.ansiBrightMagenta": "#91B7D6",
        "terminal.ansiBrightRed": "#FFAF5F",
        "terminal.ansiBrightWhite": "#E8EDDF",
        "terminal.ansiBrightYellow": "#91B7D6",
        "terminal.ansiCyan": "#BEE1E6",
        "terminal.ansiGreen": "#C8E1F4",
        "terminal.ansiMagenta": "#91B7D6",
        "terminal.ansiRed": "#FFAF5F",
        "terminal.ansiWhite": "#E8EDDF",
        "terminal.ansiYellow": "#91B7D6",
