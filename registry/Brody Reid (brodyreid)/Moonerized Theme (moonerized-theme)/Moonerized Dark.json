    "semanticHighlighting": true,
    "tokenColors": [
        {
            "scope": [
                "keyword.operator",
                "variable",
                "punctuation",
                "meta",
                "variable.object.property",
                "punctuation.support.type.property-name",
                "support.type.property-name",
                "support.type.vendored.property-name"
            ],
            "settings": { "foreground": "#dbdbdd", "fontStyle": "" }
        },
        {
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#dbdbdd", "fontStyle": "italic" }
        },
        {
            "scope": [
                "support",
                "constant",
                "punctuation.definition.tag",
                "punctuation.definition.constant",
                "support.type.builtin"
            ],
            "settings": { "foreground": "#bababd", "fontStyle": "" }
        },
        {
            "scope": ["keyword", "storage.type"],
            "settings": { "foreground": "#bababd", "fontStyle": "bold" }
        },
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#888892", "fontStyle": "italic" }
        },
        {
            "scope": ["entity.name", "meta.function-call", "function"],
            "settings": { "foreground": "#89b0de", "fontStyle": "" }
        },
        {
            "scope": [
                "keyword.control.loop",
                "keyword.control.conditional",
                "keyword.control.switch"
            ],
            "settings": { "foreground": "#a492d6", "fontStyle": "" }
        },
        {
            "scope": [
                "string",
                "punctuation.definition.string",
                "entity.name.import.go"
            ],
            "settings": { "foreground": "#9fb993" }
        },
        {
            "scope": [
                "entity.name.class",
                "entity.name.type",
                "punctuation.section.embedded"
            ],
            "settings": { "foreground": "#c99975" }
        },
        {
            "scope": ["entity.name.function", "support.class"],
            "settings": { "foreground": "#c3656f" }
        },
        {
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#cfc084" }
        }
    ],
    "semanticTokenColors": {
        "variable": { "foreground": "#dbdbdd" },
        "parameter": { "foreground": "#dbdbdd", "fontStyle": "italic" },
        "method": { "foreground": "#89b0de" },
        "interface": { "foreground": "#c99975" },
        "class": { "foreground": "#c3656f" },
        "function": { "foreground": "#89b0de" }
    },
    "$schema": "vscode://schemas/color-theme"
}
