    "tokenColors": [
        {
            "scope": "constant.language",
            "settings": { "foreground": "#74ade8" }
        },
        {
            "scope": [
                "constant.numeric",
                "variable.other.enummember",
                "keyword.operator.plus.exponent",
                "keyword.operator.minus.exponent"
            ],
            "settings": { "foreground": "#a1c181" }
        },
        {
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#6eb4bf" }
        },
        {
            "scope": ["punctuation.terminator.statement"],
            "settings": { "foreground": "#999999" }
        },
        {
            "scope": ["storage.modifier", "keyword.operator.noexcept"],
            "settings": { "foreground": "#74ade8" }
        },
        { "scope": "string.regexp", "settings": { "foreground": "#d07277" } },
        {
            "scope": [
                "keyword.operator.new",
                "keyword.operator.expression",
                "keyword.operator.cast",
                "keyword.operator.sizeof",
                "keyword.operator.alignof",
                "keyword.operator.typeid",
                "keyword.operator.alignas",
                "keyword.operator.instanceof",
                "keyword.operator.logical.python",
                "keyword.operator.wordlike"
            ],
            "settings": { "foreground": "#74ade8" }
        },
        {
            "scope": "keyword.other.unit",
            "settings": { "foreground": "#a1c181" }
        },
        {
            "name": "this.self",
            "scope": "variable.language",
            "settings": { "foreground": "#74ade8" }
        },
        {
            "name": "Control flow / Special keywords",
            "scope": [
                "keyword.control",
                "source.cpp keyword.operator.new",
                "keyword.operator.delete",
                "keyword.other.using",
                "keyword.other.directive.using",
                "keyword.other.operator",
                "entity.name.operator"
            ],
            "settings": { "foreground": "#696969" }
        },
        {
            "name": "Constants and enums",
            "scope": ["variable.other.constant", "variable.other.enummember"],
            "settings": { "foreground": "#77AAE0" }
        },
        {
            "scope": [
                "constant.character.character-class.regexp",
                "constant.other.character-class.set.regexp",
                "constant.other.character-class.regexp",
                "constant.character.set.regexp"
            ],
            "settings": { "foreground": "#d07277" }
        },
        {
            "scope": "constant.character.escape",
            "settings": { "foreground": "#ADD1F7" }
        },
        {
            "scope": "entity.name.label",
            "settings": { "foreground": "#dce0e5" }
        },
        {
            "scope": [
                "meta.embedded",
                "source.groovy.embedded",
                "string meta.image.inline.markdown",
                "variable.legacy.builtin.python"
            ],
            "settings": { "foreground": "#dce0e5" }
        },
        {
            "scope": ["meta.preprocessor", "entity.name.function.preprocessor"],
            "settings": { "foreground": "#74ade8" }
        },
        {
            "scope": "meta.preprocessor.string",
            "settings": { "foreground": "#BBD4A5" }
        },
        {
            "scope": "meta.preprocessor.numeric",
            "settings": { "foreground": "#a1c181" }
        },
        {
            "scope": ["string", "meta.embedded.assembly"],
            "settings": { "foreground": "#BBD4A5" }
        },
        {
            "name": "String interpolation",
            "scope": [
                "punctuation.definition.template-expression.begin",
                "punctuation.definition.template-expression.end",
                "punctuation.section.embedded"
            ],
            "settings": { "foreground": "#74ade8" }
        },
        {
            "name": "Reset JavaScript string interpolation expression",
            "scope": ["meta.template.expression"],
            "settings": { "foreground": "#dce0e5" }
        },
        {
            "scope": [
                "punctuation.section.embedded.begin.php",
                "punctuation.section.embedded.end.php"
            ],
            "settings": { "foreground": "#74ade8" }
        },
        {
            "scope": "support.function.git-rebase",
            "settings": { "foreground": "#6eb4bf" }
        },
        {
            "scope": "constant.sha.git-rebase",
            "settings": { "foreground": "#a1c181" }
        },
        {
            "scope": [
                "markup.deleted",
                "meta.diff.header.from-file",
                "punctuation.definition.deleted"
            ],
            "settings": { "foreground": "#e06c75", "background": "#5D0F12" }
        },
        {
            "scope": [
                "markup.inserted",
                "meta.diff.header.to-file",
                "punctuation.definition.inserted"
            ],
            "settings": { "foreground": "#91E874", "background": "#113417" }
        },
        {
            "scope": ["markup.changed", "punctuation.definition.changed"],
            "settings": { "foreground": "#bf956a", "background": "#682D0F" }
        },
        {
            "scope": ["markup.ignored", "markup.untracked"],
            "settings": { "foreground": "#2D333B", "background": "#6CB6FF" }
        },
        {
            "scope": "meta.diff.range",
            "settings": { "foreground": "#DCBDFB", "fontStyle": "bold" }
        },
        {
            "scope": "meta.diff.header",
            "settings": { "foreground": "#77AAE0" }
        },
        {
            "scope": "meta.separator",
            "settings": { "foreground": "#77AAE0", "fontStyle": "bold" }
        },
        { "scope": "meta.output", "settings": { "foreground": "#77AAE0" } },
        { "scope": "constant.regexp", "settings": { "foreground": "#646695" } },
        {
            "name": "Regular expression groups",
            "scope": [
                "punctuation.definition.group.regexp",
                "punctuation.definition.group.assertion.regexp",
                "punctuation.definition.character-class.regexp",
                "punctuation.character.set.begin.regexp",
                "punctuation.character.set.end.regexp",
                "keyword.operator.negation.regexp",
                "support.other.parenthesis.regexp"
            ],
            "settings": { "foreground": "#BBD4A5" }
        },
        {
            "scope": [
                "constant.character.character-class.regexp",
                "constant.other.character-class.set.regexp",
                "constant.other.character-class.regexp",
                "constant.character.set.regexp"
            ],
            "settings": { "foreground": "#d07277" }
        },
        {
            "scope": [
                "keyword.operator.or.regexp",
                "keyword.control.anchor.regexp"
            ],
            "settings": { "foreground": "#DCDCAA" }
        },
        {
            "scope": "keyword.operator.quantifier.regexp",
            "settings": { "foreground": "#ADD1F7" }
        },
        {
            "scope": ["constant.character", "constant.other.option"],
            "settings": { "foreground": "#74ade8" }
        },
        {
            "scope": ["source.regexp", "string.regexp"],
            "settings": { "foreground": "#87ACAD" }
        },
        {
            "scope": [
                "string.regexp.character-class",
                "string.regexp constant.character.escape",
                "string.regexp source.ruby.embedded",
                "string.regexp string.regexp.arbitrary-repitition"
            ],
            "settings": { "foreground": "#87ACAD" }
        },
        {
            "scope": "string.regexp constant.character.escape",
            "settings": { "foreground": "#91E874", "fontStyle": "bold" }
        },
