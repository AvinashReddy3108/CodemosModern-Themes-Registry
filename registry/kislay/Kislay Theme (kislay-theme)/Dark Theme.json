{
    "name": "Dark Theme",
    "type": "dark",
    "colors": {
        "editor.background": "#282C34",
        "editor.foreground": "#ABB2BF",
        "activityBar.background": "#21252B",
        "sideBar.background": "#21252B",
        "statusBar.background": "#21252B",
        "statusBar.foreground": "#ABB2BF",
        "editorLineNumber.foreground": "#636D83",
        "editorLineNumber.activeForeground": "#ABB2BF",
        "editor.selectionBackground": "#3E4451",
        "editor.inactiveSelectionBackground": "#2C313A",
        "editor.findMatchBackground": "#528BFF",
        "editor.findMatchHighlightBackground": "#528BFF80",
        "editorGutter.background": "#282C34",
        "sideBarTitle.foreground": "#ABB2BF",
        "list.activeSelectionBackground": "#528BFF",
        "list.activeSelectionForeground": "#FFFFFF",
        "list.inactiveSelectionBackground": "#3E4451",
        "list.hoverBackground": "#2C313A",
        "tab.activeBackground": "#282C34",
        "tab.inactiveBackground": "#21252B",
        "tab.activeForeground": "#ABB2BF",
        "tab.inactiveForeground": "#636D83"
    },
    "tokenColors": [
        { "scope": "keyword", "settings": { "foreground": "#C678DD" } },
        { "scope": "keyword.control", "settings": { "foreground": "#C678DD" } },
        { "scope": "storage", "settings": { "foreground": "#C678DD" } },
        { "scope": "storage.type", "settings": { "foreground": "#C678DD" } },
        {
            "scope": "storage.modifier",
            "settings": { "foreground": "#C678DD" }
        },
        { "scope": "string", "settings": { "foreground": "#98C379" } },
        { "scope": "string.quoted", "settings": { "foreground": "#98C379" } },
        {
            "scope": "string.quoted.single",
            "settings": { "foreground": "#98C379" }
        },
        {
            "scope": "string.quoted.double",
            "settings": { "foreground": "#98C379" }
        },
        {
            "scope": "string.quoted.triple",
            "settings": { "foreground": "#98C379" }
        },
        { "scope": "string.template", "settings": { "foreground": "#98C379" } },
        {
            "scope": "comment",
            "settings": { "foreground": "#5C6370", "fontStyle": "italic" }
        },
        { "scope": "comment.line", "settings": { "foreground": "#5C6370" } },
        { "scope": "comment.block", "settings": { "foreground": "#5C6370" } },
        {
            "scope": "comment.line.double-slash",
            "settings": { "foreground": "#5C6370" }
        },
        {
            "scope": "comment.line.double-dash",
            "settings": { "foreground": "#5C6370" }
        },
        {
            "scope": "comment.line.number-sign",
            "settings": { "foreground": "#5C6370" }
        },
        {
            "scope": "comment.line.percentage",
            "settings": { "foreground": "#5C6370" }
        },
        { "scope": "constant", "settings": { "foreground": "#56B6C2" } },
        {
            "scope": "constant.numeric",
            "settings": { "foreground": "#D19A66" }
        },
        {
            "scope": "constant.numeric.integer",
            "settings": { "foreground": "#D19A66" }
        },
        {
            "scope": "constant.numeric.float",
            "settings": { "foreground": "#D19A66" }
        },
        {
            "scope": "constant.numeric.hex",
            "settings": { "foreground": "#D19A66" }
        },
        {
            "scope": "constant.numeric.binary",
            "settings": { "foreground": "#D19A66" }
        },
        {
            "scope": "constant.numeric.octal",
            "settings": { "foreground": "#D19A66" }
        },
        {
            "scope": "constant.language",
            "settings": { "foreground": "#56B6C2" }
        },
        {
            "scope": "constant.character",
            "settings": { "foreground": "#56B6C2" }
        },
        {
            "scope": "constant.character.escape",
            "settings": { "foreground": "#56B6C2" }
        },
        { "scope": "constant.other", "settings": { "foreground": "#56B6C2" } },
        { "scope": "variable", "settings": { "foreground": "#E06C75" } },
        { "scope": "variable.other", "settings": { "foreground": "#E06C75" } },
        {
            "scope": "variable.parameter",
            "settings": { "foreground": "#E06C75" }
        },
        {
            "scope": "variable.language",
            "settings": { "foreground": "#C678DD" }
        },
        { "scope": "entity.name", "settings": { "foreground": "#E5C07B" } },
        {
            "scope": "entity.name.function",
            "settings": { "foreground": "#61AFEF" }
        },
        {
            "scope": "entity.name.class",
            "settings": { "foreground": "#E5C07B" }
        },
        {
            "scope": "entity.name.type",
            "settings": { "foreground": "#E5C07B" }
        },
        { "scope": "entity.name.tag", "settings": { "foreground": "#E06C75" } },
        {
            "scope": "entity.name.section",
            "settings": { "foreground": "#E5C07B" }
        },
        { "scope": "entity.other", "settings": { "foreground": "#E5C07B" } },
        {
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#D19A66" }
        },
        { "scope": "support", "settings": { "foreground": "#61AFEF" } },
        {
            "scope": "support.function",
            "settings": { "foreground": "#61AFEF" }
        },
        { "scope": "support.type", "settings": { "foreground": "#E5C07B" } },
        { "scope": "support.class", "settings": { "foreground": "#E5C07B" } },
        {
            "scope": "support.constant",
            "settings": { "foreground": "#56B6C2" }
        },
        {
            "scope": "support.variable",
            "settings": { "foreground": "#E06C75" }
        },
        { "scope": "punctuation", "settings": { "foreground": "#ABB2BF" } },
        {
            "scope": "punctuation.definition",
            "settings": { "foreground": "#ABB2BF" }
        },
        {
            "scope": "punctuation.section",
            "settings": { "foreground": "#ABB2BF" }
        },
        {
            "scope": "punctuation.separator",
            "settings": { "foreground": "#ABB2BF" }
        },
        {
            "scope": "punctuation.terminator",
            "settings": { "foreground": "#ABB2BF" }
        },
        { "scope": "meta", "settings": { "foreground": "#ABB2BF" } },
        {
            "scope": "meta.preprocessor",
            "settings": { "foreground": "#C678DD" }
        },
        { "scope": "meta.import", "settings": { "foreground": "#C678DD" } },
        { "scope": "meta.export", "settings": { "foreground": "#C678DD" } },
        { "scope": "meta.class", "settings": { "foreground": "#E5C07B" } },
        { "scope": "meta.function", "settings": { "foreground": "#61AFEF" } },
        { "scope": "meta.tag", "settings": { "foreground": "#E06C75" } },
        { "scope": "invalid", "settings": { "foreground": "#F44747" } },
        {
            "scope": "invalid.deprecated",
            "settings": { "foreground": "#F44747" }
        },
        { "scope": "invalid.illegal", "settings": { "foreground": "#F44747" } }
    ],
    "$schema": "vscode://schemas/color-theme"
}
