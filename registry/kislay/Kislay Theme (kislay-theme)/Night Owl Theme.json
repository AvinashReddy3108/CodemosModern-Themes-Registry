{
    "name": "Night Owl Theme",
    "type": "dark",
    "colors": {
        "editor.background": "#011627",
        "editor.foreground": "#D6DEEB",
        "activityBar.background": "#011627",
        "sideBar.background": "#1D2A35",
        "statusBar.background": "#1D2A35",
        "statusBar.foreground": "#D6DEEB",
        "editorLineNumber.foreground": "#637777",
        "editorLineNumber.activeForeground": "#D6DEEB",
        "editor.selectionBackground": "#1D3B53",
        "editor.inactiveSelectionBackground": "#1D3B5380",
        "editor.findMatchBackground": "#C792EA",
        "editor.findMatchHighlightBackground": "#C792EA80",
        "editorGutter.background": "#011627",
        "sideBarTitle.foreground": "#D6DEEB",
        "list.activeSelectionBackground": "#1D3B53",
        "list.activeSelectionForeground": "#D6DEEB",
        "list.inactiveSelectionBackground": "#1D3B53",
        "list.hoverBackground": "#1D3B53",
        "tab.activeBackground": "#011627",
        "tab.inactiveBackground": "#1D2A35",
        "tab.activeForeground": "#D6DEEB",
        "tab.inactiveForeground": "#637777"
    },
    "tokenColors": [
        { "scope": "keyword", "settings": { "foreground": "#C792EA" } },
        { "scope": "keyword.control", "settings": { "foreground": "#C792EA" } },
        { "scope": "storage", "settings": { "foreground": "#C792EA" } },
        { "scope": "string", "settings": { "foreground": "#ADD1B8" } },
        { "scope": "string.quoted", "settings": { "foreground": "#ADD1B8" } },
        {
            "scope": "comment",
            "settings": { "foreground": "#637777", "fontStyle": "italic" }
        },
        { "scope": "comment.line", "settings": { "foreground": "#637777" } },
        { "scope": "comment.block", "settings": { "foreground": "#637777" } },
        {
            "scope": "constant.numeric",
            "settings": { "foreground": "#F78C6C" }
        },
        {
            "scope": "constant.language",
            "settings": { "foreground": "#5CA7E4" }
        },
        { "scope": "variable", "settings": { "foreground": "#82AAFF" } },
        { "scope": "variable.other", "settings": { "foreground": "#82AAFF" } },
        {
            "scope": "entity.name.function",
            "settings": { "foreground": "#82AAFF" }
        },
        {
            "scope": "entity.name.class",
            "settings": { "foreground": "#FFCB8B" }
        },
        {
            "scope": "entity.name.type",
            "settings": { "foreground": "#FFCB8B" }
        },
        {
            "scope": "support.function",
            "settings": { "foreground": "#82AAFF" }
        },
        { "scope": "support.type", "settings": { "foreground": "#FFCB8B" } }
    ],
    "$schema": "vscode://schemas/color-theme"
}
