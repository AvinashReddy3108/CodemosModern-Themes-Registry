{
    "name": "Git Dark Theme",
    "type": "dark",
    "colors": {
        "editor.background": "#0D1117",
        "editor.foreground": "#C9D1D9",
        "activityBar.background": "#0D1117",
        "sideBar.background": "#161B22",
        "statusBar.background": "#0D1117",
        "statusBar.foreground": "#C9D1D9",
        "editorLineNumber.foreground": "#8B949E",
        "editorLineNumber.activeForeground": "#C9D1D9",
        "editor.selectionBackground": "#21262D",
        "editor.inactiveSelectionBackground": "#21262D80",
        "editor.findMatchBackground": "#FF7B72",
        "editor.findMatchHighlightBackground": "#FF7B7280",
        "editorGutter.background": "#0D1117",
        "sideBarTitle.foreground": "#C9D1D9",
        "list.activeSelectionBackground": "#21262D",
        "list.activeSelectionForeground": "#C9D1D9",
        "list.inactiveSelectionBackground": "#21262D",
        "list.hoverBackground": "#21262D",
        "tab.activeBackground": "#0D1117",
        "tab.inactiveBackground": "#161B22",
        "tab.activeForeground": "#C9D1D9",
        "tab.inactiveForeground": "#8B949E"
    },
    "tokenColors": [
        { "scope": "keyword", "settings": { "foreground": "#FF7B72" } },
        { "scope": "keyword.control", "settings": { "foreground": "#FF7B72" } },
        { "scope": "storage", "settings": { "foreground": "#FF7B72" } },
        { "scope": "string", "settings": { "foreground": "#A5D6FF" } },
        { "scope": "string.quoted", "settings": { "foreground": "#A5D6FF" } },
        {
            "scope": "comment",
            "settings": { "foreground": "#8B949E", "fontStyle": "italic" }
        },
        { "scope": "comment.line", "settings": { "foreground": "#8B949E" } },
        { "scope": "comment.block", "settings": { "foreground": "#8B949E" } },
        {
            "scope": "constant.numeric",
            "settings": { "foreground": "#79C0FF" }
        },
        {
            "scope": "constant.language",
            "settings": { "foreground": "#79C0FF" }
        },
        { "scope": "variable", "settings": { "foreground": "#FFA657" } },
        { "scope": "variable.other", "settings": { "foreground": "#FFA657" } },
        {
            "scope": "entity.name.function",
            "settings": { "foreground": "#D2A8FF" }
        },
        {
            "scope": "entity.name.class",
            "settings": { "foreground": "#FFA198" }
        },
        {
            "scope": "entity.name.type",
            "settings": { "foreground": "#FFA198" }
        },
        {
            "scope": "support.function",
            "settings": { "foreground": "#D2A8FF" }
        },
        { "scope": "support.type", "settings": { "foreground": "#FFA198" } }
    ],
    "$schema": "vscode://schemas/color-theme"
}
