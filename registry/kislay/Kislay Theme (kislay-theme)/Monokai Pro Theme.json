{
    "name": "Monokai Pro Theme",
    "type": "dark",
    "colors": {
        "editor.background": "#2D2A2E",
        "editor.foreground": "#F8F8F2",
        "activityBar.background": "#2D2A2E",
        "sideBar.background": "#2D2A2E",
        "statusBar.background": "#4A4545",
        "statusBar.foreground": "#F8F8F2",
        "editorLineNumber.foreground": "#75715E",
        "editorLineNumber.activeForeground": "#F8F8F2",
        "editor.selectionBackground": "#49483E",
        "editor.inactiveSelectionBackground": "#49483E80",
        "editor.findMatchBackground": "#F92672",
        "editor.findMatchHighlightBackground": "#F9267280",
        "editorGutter.background": "#2D2A2E",
        "sideBarTitle.foreground": "#F8F8F2",
        "list.activeSelectionBackground": "#49483E",
        "list.activeSelectionForeground": "#F8F8F2",
        "list.inactiveSelectionBackground": "#49483E",
        "list.hoverBackground": "#49483E",
        "tab.activeBackground": "#2D2A2E",
        "tab.inactiveBackground": "#2D2A2E",
        "tab.activeForeground": "#F8F8F2",
        "tab.inactiveForeground": "#75715E"
    },
    "tokenColors": [
        { "scope": "keyword", "settings": { "foreground": "#F92672" } },
        { "scope": "keyword.control", "settings": { "foreground": "#F92672" } },
        { "scope": "storage", "settings": { "foreground": "#F92672" } },
        { "scope": "string", "settings": { "foreground": "#E6DB74" } },
        { "scope": "string.quoted", "settings": { "foreground": "#E6DB74" } },
        {
            "scope": "comment",
            "settings": { "foreground": "#75715E", "fontStyle": "italic" }
        },
        { "scope": "comment.line", "settings": { "foreground": "#75715E" } },
        { "scope": "comment.block", "settings": { "foreground": "#75715E" } },
        {
            "scope": "constant.numeric",
            "settings": { "foreground": "#AE81FF" }
        },
        {
            "scope": "constant.language",
            "settings": { "foreground": "#66D9EF" }
        },
        { "scope": "variable", "settings": { "foreground": "#F8F8F2" } },
        { "scope": "variable.other", "settings": { "foreground": "#F8F8F2" } },
        {
            "scope": "entity.name.function",
            "settings": { "foreground": "#A6E22E" }
        },
        {
            "scope": "entity.name.class",
            "settings": { "foreground": "#A6E22E" }
        },
        {
            "scope": "entity.name.type",
            "settings": { "foreground": "#A6E22E" }
        },
        {
            "scope": "support.function",
            "settings": { "foreground": "#A6E22E" }
        },
        { "scope": "support.type", "settings": { "foreground": "#A6E22E" } }
    ],
    "$schema": "vscode://schemas/color-theme"
}
