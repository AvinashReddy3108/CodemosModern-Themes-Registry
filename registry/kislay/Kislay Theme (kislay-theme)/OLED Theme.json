{
    "name": "OLED Theme",
    "type": "dark",
    "colors": {
        "editor.background": "#000000",
        "editor.foreground": "#E8E8E8",
        "activityBar.background": "#000000",
        "sideBar.background": "#000000",
        "statusBar.background": "#000000",
        "statusBar.foreground": "#E8E8E8",
        "editorLineNumber.foreground": "#404040",
        "editorLineNumber.activeForeground": "#E8E8E8",
        "editor.selectionBackground": "#1A1A1A",
        "editor.inactiveSelectionBackground": "#0D0D0D",
        "editor.findMatchBackground": "#FF6B6B",
        "editor.findMatchHighlightBackground": "#FF6B6B40",
        "editorGutter.background": "#000000",
        "sideBarTitle.foreground": "#E8E8E8",
        "list.activeSelectionBackground": "#FF6B6B",
        "list.activeSelectionForeground": "#000000",
        "list.inactiveSelectionBackground": "#1A1A1A",
        "list.hoverBackground": "#0D0D0D",
        "tab.activeBackground": "#000000",
        "tab.inactiveBackground": "#000000",
        "tab.activeForeground": "#E8E8E8",
        "tab.inactiveForeground": "#404040",
        "panel.background": "#000000",
        "panel.border": "#1A1A1A",
        "terminal.background": "#000000",
        "terminal.foreground": "#E8E8E8",
        "widget.shadow": "#000000",
        "scrollbar.shadow": "#000000",
        "scrollbarSlider.background": "#1A1A1A",
        "scrollbarSlider.hoverBackground": "#2A2A2A",
        "scrollbarSlider.activeBackground": "#3A3A3A"
    },
    "tokenColors": [
        { "scope": "keyword", "settings": { "foreground": "#FF6B6B" } },
        { "scope": "keyword.control", "settings": { "foreground": "#FF6B6B" } },
        { "scope": "storage", "settings": { "foreground": "#FF6B6B" } },
        { "scope": "storage.type", "settings": { "foreground": "#FF6B6B" } },
        {
            "scope": "storage.modifier",
            "settings": { "foreground": "#FF6B6B" }
        },
        { "scope": "string", "settings": { "foreground": "#4ECDC4" } },
        { "scope": "string.quoted", "settings": { "foreground": "#4ECDC4" } },
        {
            "scope": "string.quoted.single",
            "settings": { "foreground": "#4ECDC4" }
        },
        {
            "scope": "string.quoted.double",
            "settings": { "foreground": "#4ECDC4" }
        },
        {
            "scope": "string.quoted.triple",
            "settings": { "foreground": "#4ECDC4" }
        },
        { "scope": "string.template", "settings": { "foreground": "#4ECDC4" } },
        {
            "scope": "comment",
            "settings": { "foreground": "#666666", "fontStyle": "italic" }
        },
        { "scope": "comment.line", "settings": { "foreground": "#666666" } },
        { "scope": "comment.block", "settings": { "foreground": "#666666" } },
        {
            "scope": "comment.line.double-slash",
            "settings": { "foreground": "#666666" }
        },
        {
            "scope": "comment.line.double-dash",
            "settings": { "foreground": "#666666" }
        },
        {
            "scope": "comment.line.number-sign",
            "settings": { "foreground": "#666666" }
        },
        {
            "scope": "comment.line.percentage",
            "settings": { "foreground": "#666666" }
        },
        { "scope": "constant", "settings": { "foreground": "#95E1D3" } },
        {
            "scope": "constant.numeric",
            "settings": { "foreground": "#FFE66D" }
        },
        {
            "scope": "constant.numeric.integer",
            "settings": { "foreground": "#FFE66D" }
        },
        {
            "scope": "constant.numeric.float",
            "settings": { "foreground": "#FFE66D" }
        },
        {
            "scope": "constant.numeric.hex",
            "settings": { "foreground": "#FFE66D" }
        },
        {
            "scope": "constant.numeric.binary",
            "settings": { "foreground": "#FFE66D" }
        },
        {
            "scope": "constant.numeric.octal",
            "settings": { "foreground": "#FFE66D" }
        },
        {
            "scope": "constant.language",
            "settings": { "foreground": "#95E1D3" }
        },
        {
            "scope": "constant.character",
            "settings": { "foreground": "#95E1D3" }
        },
        {
            "scope": "constant.character.escape",
            "settings": { "foreground": "#95E1D3" }
        },
        { "scope": "constant.other", "settings": { "foreground": "#95E1D3" } },
        { "scope": "variable", "settings": { "foreground": "#F7F1E3" } },
        { "scope": "variable.other", "settings": { "foreground": "#F7F1E3" } },
        {
            "scope": "variable.parameter",
            "settings": { "foreground": "#F7F1E3" }
        },
        {
            "scope": "variable.language",
            "settings": { "foreground": "#FF6B6B" }
        },
        { "scope": "entity.name", "settings": { "foreground": "#FFB6B9" } },
        {
            "scope": "entity.name.function",
            "settings": { "foreground": "#A8E6CF" }
        },
        {
            "scope": "entity.name.class",
            "settings": { "foreground": "#FFB6B9" }
        },
        {
            "scope": "entity.name.type",
            "settings": { "foreground": "#FFB6B9" }
        },
        { "scope": "entity.name.tag", "settings": { "foreground": "#FF6B6B" } },
        {
            "scope": "entity.name.section",
            "settings": { "foreground": "#FFB6B9" }
        },
        { "scope": "entity.other", "settings": { "foreground": "#FFB6B9" } },
        {
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#FFE66D" }
        },
        { "scope": "support", "settings": { "foreground": "#A8E6CF" } },
        {
            "scope": "support.function",
            "settings": { "foreground": "#A8E6CF" }
        },
        { "scope": "support.type", "settings": { "foreground": "#FFB6B9" } },
        { "scope": "support.class", "settings": { "foreground": "#FFB6B9" } },
        {
            "scope": "support.constant",
            "settings": { "foreground": "#95E1D3" }
        },
        {
            "scope": "support.variable",
            "settings": { "foreground": "#F7F1E3" }
        },
        { "scope": "punctuation", "settings": { "foreground": "#E8E8E8" } },
        {
            "scope": "punctuation.definition",
            "settings": { "foreground": "#E8E8E8" }
        },
        {
            "scope": "punctuation.section",
            "settings": { "foreground": "#E8E8E8" }
        },
        {
            "scope": "punctuation.separator",
            "settings": { "foreground": "#E8E8E8" }
        },
        {
            "scope": "punctuation.terminator",
            "settings": { "foreground": "#E8E8E8" }
        },
        { "scope": "meta", "settings": { "foreground": "#E8E8E8" } },
        {
            "scope": "meta.preprocessor",
            "settings": { "foreground": "#FF6B6B" }
        },
        { "scope": "meta.import", "settings": { "foreground": "#FF6B6B" } },
        { "scope": "meta.export", "settings": { "foreground": "#FF6B6B" } },
        { "scope": "meta.class", "settings": { "foreground": "#FFB6B9" } },
        { "scope": "meta.function", "settings": { "foreground": "#A8E6CF" } },
        { "scope": "meta.tag", "settings": { "foreground": "#FF6B6B" } },
        { "scope": "invalid", "settings": { "foreground": "#FF6B6B" } },
        {
            "scope": "invalid.deprecated",
            "settings": { "foreground": "#FF6B6B" }
        },
        { "scope": "invalid.illegal", "settings": { "foreground": "#FF6B6B" } }
    ],
    "$schema": "vscode://schemas/color-theme"
}
