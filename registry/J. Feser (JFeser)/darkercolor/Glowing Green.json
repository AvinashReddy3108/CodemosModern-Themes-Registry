    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#6b7280", "fontStyle": "italic" }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "storage.type",
                "storage.modifier",
                "keyword.control",
                "keyword.operator.new",
                "keyword.operator.sizeof",
                "keyword.operator.delete",
                "keyword.operator.typeof"
            ],
            "settings": { "foreground": "#ff6600", "fontStyle": "bold" }
        },
        {
            "name": "Strings",
            "scope": [
                "string",
                "string.quoted",
                "string.template",
                "string.interpolated"
            ],
            "settings": { "foreground": "#22c55e" }
        },
        {
            "name": "String escape sequences",
            "scope": ["constant.character.escape", "string.regexp"],
            "settings": { "foreground": "#34d399" }
        },
        {
            "name": "Numbers",
            "scope": [
                "constant.numeric",
                "constant.language.boolean",
                "constant.language.null",
                "constant.language.undefined"
            ],
            "settings": { "foreground": "#06b6d4" }
        },
        {
            "name": "Class names - Warm Orange",
            "scope": [
                "entity.name.class",
                "entity.name.type.class",
                "support.class",
                "entity.other.inherited-class",
                "meta.cast entity.name.type",
                "storage.type.cs",
                "storage.type.java",
                "storage.type.cpp",
                "entity.name.type",
                "entity.name.type.template",
                "support.type",
                "variable.other.readwrite.member.cpp",
                "entity.name.scope-resolution"
            ],
            "settings": { "foreground": "#f59e0b", "fontStyle": "bold" }
        },
        {
            "name": "Function names - Cool Blue",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call",
                "meta.method-call",
                "variable.function"
            ],
            "settings": { "foreground": "#3b82f6" }
        },
        {
            "name": "Method names - Cool Blue",
            "scope": [
                "entity.name.function.member",
                "meta.method.java",
                "meta.method.cpp",
                "entity.name.function.method"
            ],
            "settings": { "foreground": "#60a5fa" }
        },
        {
            "name": "Variable names",
            "scope": [
                "variable",
                "variable.other.readwrite",
                "variable.parameter",
                "meta.definition.variable"
            ],
            "settings": { "foreground": "#e5e7eb" }
        },
        {
            "name": "Member variables and properties - Balanced Red",
            "scope": [
                "variable.other.property",
                "variable.other.member",
                "entity.name.variable.field"
            ],
            "settings": { "foreground": "#ef4444" }
        },
        {
            "name": "Constants and enums",
            "scope": [
                "constant.language",
                "constant.other",
                "variable.other.constant",
                "entity.name.constant",
                "variable.other.enummember"
            ],
            "settings": { "foreground": "#059669", "fontStyle": "italic" }
        },
        {
            "name": "Operators",
            "scope": [
                "keyword.operator",
                "punctuation.operator",
                "keyword.operator.arithmetic",
                "keyword.operator.assignment",
                "keyword.operator.comparison",
                "keyword.operator.logical"
            ],
            "settings": { "foreground": "#ff8533" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation",
                "punctuation.separator",
                "punctuation.terminator",
                "punctuation.definition"
            ],
            "settings": { "foreground": "#9ca3af" }
        },
        {
            "name": "Brackets and braces",
            "scope": [
                "punctuation.section.brackets",
                "punctuation.section.braces",
                "punctuation.section.parens",
                "meta.brace.round",
                "meta.brace.square",
                "meta.brace.curly"
            ],
            "settings": { "foreground": "#84fc84" }
        },
        {
            "name": "Java/C++ specific types - Warm Orange (consistent with class names)",
            "scope": [
                "storage.type.primitive.java",
                "storage.type.built-in.primitive.cpp",
                "storage.type.primitive.cpp",
                "keyword.type.cs",
                "support.type.primitive",
                "storage.type.void",
                "keyword.type.void"
            ],
            "settings": { "foreground": "#f59e0b", "fontStyle": "bold" }
        },
        {
            "name": "Namespaces and packages",
            "scope": [
                "entity.name.namespace",
                "entity.name.package",
                "storage.modifier.package.java",
                "storage.modifier.import.java"
            ],
            "settings": { "foreground": "#77ff7d" }
        },
        {
            "name": "Imports and includes",
            "scope": [
                "keyword.control.import",
                "keyword.control.include",
                "meta.import",
                "meta.include"
            ],
            "settings": { "foreground": "#14ff14" }
        },
        {
            "name": "Annotations and decorators",
            "scope": [
                "entity.name.function.decorator",
                "punctuation.decorator",
                "storage.type.annotation.java"
            ],
            "settings": { "foreground": "#ffd700" }
        },
        {
            "name": "Labels",
            "scope": ["entity.name.label"],
            "settings": { "foreground": "#00ff00", "fontStyle": "italic" }
        },
        {
            "name": "Preprocessor directives",
            "scope": [
                "meta.preprocessor",
                "keyword.control.directive",
                "entity.name.function.preprocessor"
            ],
            "settings": { "foreground": "#ffd700" }
        },
        {
            "name": "Template parameters",
            "scope": [
                "entity.name.type.template",
                "storage.type.template",
                "punctuation.definition.template-expression"
            ],
            "settings": { "foreground": "#ff9800" }
        },
        {
            "name": "Generic types - BRIGHT GOLD (consistent with class names)",
            "scope": [
                "entity.name.type.parameter",
                "storage.type.generic",
                "punctuation.definition.typeparameters"
            ],
            "settings": { "foreground": "#ff9800", "fontStyle": "italic" }
        },
        {
            "name": "This/self keywords",
            "scope": [
                "variable.language.this",
                "keyword.other.this",
                "variable.language.self"
            ],
            "settings": { "foreground": "#14ff14", "fontStyle": "italic" }
        },
        {
            "name": "Access modifiers - GLOWING GREEN (same as line numbers)",
            "scope": [
                "storage.modifier.access",
                "storage.modifier.java",
                "storage.modifier.cpp"
            ],
            "settings": { "foreground": "#66ff66" }
        },
        {
            "name": "Exception handling",
            "scope": [
                "keyword.control.trycatch",
                "storage.type.java.exception"
            ],
            "settings": { "foreground": "#ff3333" }
        },
        {
            "name": "Lambda expressions",
            "scope": [
                "storage.type.function.lambda",
                "keyword.operator.lambda"
            ],
            "settings": { "foreground": "#ffa726" }
        },
        {
            "name": "Markdown - Headings",
            "scope": [
                "markup.heading",
                "markup.heading.1",
                "markup.heading.2",
                "markup.heading.3",
                "markup.heading.4",
                "markup.heading.5",
                "markup.heading.6",
                "entity.name.section.markdown"
            ],
            "settings": { "foreground": "#66ff66", "fontStyle": "bold" }
        },
        {
            "name": "Markdown - Bold",
            "scope": ["markup.bold", "punctuation.definition.bold.markdown"],
            "settings": { "foreground": "#f59e0b", "fontStyle": "bold" }
        },
        {
            "name": "Markdown - Italic",
            "scope": [
                "markup.italic",
                "punctuation.definition.italic.markdown"
            ],
            "settings": { "foreground": "#3b82f6", "fontStyle": "italic" }
        },
        {
            "name": "Markdown - Strikethrough",
            "scope": [
                "markup.strikethrough",
                "punctuation.definition.strikethrough.markdown"
            ],
            "settings": {
                "foreground": "#9ca3af",
                "fontStyle": "strikethrough"
            }
        },
        {
            "name": "Markdown - Code",
            "scope": ["markup.inline.raw", "markup.raw.inline.markdown"],
            "settings": { "foreground": "#ff6600", "fontStyle": "" }
        },
        {
            "name": "Markdown - Code Block",
            "scope": [
                "markup.fenced_code.block.markdown",
                "markup.raw.block.markdown"
            ],
            "settings": { "foreground": "#22c55e" }
        },
        {
            "name": "Markdown - Code Block Language",
            "scope": [
                "fenced_code.block.language.markdown",
                "markup.fenced_code.block.markdown punctuation.definition.markdown"
            ],
            "settings": { "foreground": "#66ff66" }
        },
        {
            "name": "Markdown - Links",
            "scope": [
                "markup.underline.link.markdown",
                "markup.underline.link.image.markdown"
            ],
            "settings": { "foreground": "#06b6d4", "fontStyle": "underline" }
        },
        {
            "name": "Markdown - Link Text",
            "scope": [
                "string.other.link.title.markdown",
                "string.other.link.description.markdown"
            ],
            "settings": { "foreground": "#60a5fa" }
        },
        {
            "name": "Markdown - Link URL",
            "scope": [
                "markup.underline.link.markdown",
                "markup.underline.link.image.markdown"
            ],
            "settings": { "foreground": "#06b6d4" }
        },
        {
            "name": "Markdown - Lists",
            "scope": [
                "markup.list.unnumbered.markdown",
                "markup.list.numbered.markdown",
                "punctuation.definition.list.markdown"
            ],
            "settings": { "foreground": "#ff8533" }
        },
        {
            "name": "Markdown - Quote",
            "scope": [
                "markup.quote.markdown",
                "punctuation.definition.quote.markdown"
            ],
            "settings": { "foreground": "#a855f7", "fontStyle": "italic" }
        },
        {
            "name": "Markdown - Separator",
            "scope": ["meta.separator.markdown"],
            "settings": { "foreground": "#66ff66", "fontStyle": "bold" }
        },
        {
            "name": "Markdown - Table",
            "scope": [
                "markup.table.markdown",
                "punctuation.separator.table-cell.markdown",
                "punctuation.section.table-header.markdown"
            ],
            "settings": { "foreground": "#34d399" }
        },
        {
            "name": "Markdown - HTML Tags",
            "scope": [
                "text.html.markdown entity.name.tag",
                "text.html.markdown punctuation.definition.tag"
            ],
            "settings": { "foreground": "#ef4444" }
        },
        {
            "name": "Markdown - HTML Attributes",
            "scope": ["text.html.markdown entity.other.attribute-name"],
            "settings": { "foreground": "#fbbf24" }
        }
    ],
    "semanticTokenColors": {
        "class": "#f59e0b",
