{
    "$schema": "vscode://schemas/color-theme",
    "name": "White Devil",
    "type": "light",
    "colors": {
        "activityBar.background": "#E6E8F0",
        "activityBar.foreground": "#2C3E50",
        "sideBar.background": "#F2F3F7",
        "sideBar.foreground": "#2C3E50",
        "icon.foreground": "#2C3E50",
        "list.activeSelectionForeground": "#1A1A1A",
        "list.inactiveSelectionForeground": "#4A4A4A",
        "list.hoverForeground": "#1A1A1A",
        "menu.foreground": "#1A1A1A",
        "menu.selectionForeground": "#000000",
        "editor.background": "#FAFAFA",
        "editor.foreground": "#1A1A1A",
        "editor.lineHighlightBackground": "#E5E8EF",
        "editor.selectionBackground": "#C0C6D6",
        "editorCursor.foreground": "#CC9900",
        "editorIndentGuide.activeBackground1": "#B0B5C0",
        "editorIndentGuide.background1": "#D6D9E0",
        "editorLineNumber.foreground": "#7A7E8A",
        "statusBar.background": "#E6E8F0",
        "tab.activeBackground": "#FFFFFF",
        "tab.inactiveBackground": "#E6E8F0",
        "tab.activeForeground": "#1A1A1A",
        "tab.inactiveForeground": "#4A4A4A",
        "terminal.background": "#FAFAFA",
        "terminal.foreground": "#1A1A1A",
        "titleBar.activeBackground": "#E6E8F0",
        "titleBar.inactiveBackground": "#E6E8F0"
    },
    "tokenColors": [
        {
            "scope": [
                "meta.tag",
                "entity.name.tag",
                "support.class.component.html",
                "entity.name.tag.custom",
                "punctuation.definition.tag"
            ],
            "settings": { "foreground": "#0451A5" }
        },
        {
            "scope": [
                "meta.tag.attributes",
                "entity.other.attribute-name",
                "variable.other.attribute-name.html",
                "meta.attribute",
                "entity.other.attribute-name.custom"
            ],
            "settings": { "foreground": "#0C7D9D" }
        },
        {
            "scope": [
                "string",
                "string.quoted",
                "string.quoted.double",
                "string.quoted.single",
                "string.template",
                "string.quoted.double.html",
                "string.quoted.single.html",
                "string.quoted.double.css",
                "string.quoted.single.css",
                "string.interpolated",
                "meta.template.expression"
            ],
            "settings": { "foreground": "#A31515" }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.language.boolean",
                "constant.language",
                "constant.character",
                "constant.other",
                "constant.numeric.float.decimal",
                "constant.numeric.integer"
            ],
            "settings": { "foreground": "#098658" }
        },
        {
            "scope": [
                "storage",
                "storage.type",
                "keyword.control",
                "keyword.operator",
                "keyword.control.import",
                "keyword.control.flow",
                "keyword.control.conditional",
                "keyword.operator.new",
                "keyword.other.unit"
            ],
            "settings": { "foreground": "#AF00DB" }
        },
        {
            "scope": [
                "variable",
                "variable.other",
                "variable.other.readwrite",
                "variable.parameter",
                "variable.language",
                "variable.parameter.function",
                "variable.object.property"
            ],
            "settings": { "foreground": "#001080" }
        },
        {
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call",
                "meta.function",
                "entity.name.function.python",
                "meta.function.definition.c",
                "entity.name.function.constructor"
            ],
            "settings": { "foreground": "#795E26" }
        },
        {
            "scope": [
                "entity.name.type",
                "support.class",
                "support.type",
                "entity.name.class",
                "entity.other.inherited-class",
                "entity.name.namespace",
                "entity.name.struct",
                "entity.name.enum"
            ],
            "settings": { "foreground": "#267f99" }
        },
        {
            "scope": [
                "support.constant.json",
                "meta.structure.dictionary.json string.quoted.double.json",
                "constant.language.json"
            ],
            "settings": { "foreground": "#A31515" }
        },
        {
            "scope": [
                "comment",
                "punctuation.definition.comment",
                "comment.block.documentation",
                "comment.line",
                "comment.block",
                "comment.documentation",
                "comment.block.documentation.python"
            ],
            "settings": { "fontStyle": "italic", "foreground": "#6A9955" }
        },
        {
            "scope": [
                "punctuation.separator.key-value",
                "punctuation.terminator.statement",
                "punctuation.definition.string",
                "punctuation.definition.parameters.begin",
                "punctuation.definition.parameters.end",
                "punctuation.separator",
                "punctuation.definition.block",
                "punctuation.definition.generic"
            ],
            "settings": { "foreground": "#1A1A1A" }
        },
        {
            "scope": [
                "punctuation.bracket",
                "punctuation.section",
                "punctuation.section.embedded",
                "punctuation.definition.array.begin",
                "punctuation.definition.array.end"
            ],
            "settings": { "foreground": "#1A1A1A" }
        },
        {
            "scope": [
                "invalid",
                "invalid.illegal",
                "invalid.broken",
                "invalid.deprecated",
                "invalid.unimplemented"
            ],
            "settings": { "foreground": "#E51400" }
        },
        {
            "scope": [
                "source.ts",
                "source.tsx",
                "support.type.primitive.ts",
                "support.type.builtin.ts"
            ],
            "settings": { "foreground": "#267f99" }
        },
        {
            "scope": [
                "source.jsx",
                "source.js.jsx",
                "entity.name.tag.jsx",
                "meta.tag.js"
            ],
            "settings": { "foreground": "#0451A5" }
        },
        {
            "scope": [
                "variable.parameter.ts",
                "variable.parameter.tsx",
                "variable.parameter.function.ts"
            ],
            "settings": { "foreground": "#001080" }
        },
        {
            "scope": [
                "source.vue",
                "meta.tag.template.vue",
                "meta.tag.script.vue",
                "meta.tag.style.vue",
                "entity.name.tag.vue"
            ],
            "settings": { "foreground": "#AF00DB" }
        },
        {
            "scope": [
                "entity.name.tag.angular",
                "source.ts.angular",
                "meta.directive.angular",
                "support.class.component.ts.angular"
            ],
            "settings": { "foreground": "#AF00DB" }
        },
        {
            "scope": [
                "source.sql",
                "keyword.other.DML.sql",
                "keyword.other.DDL.sql"
            ],
            "settings": { "foreground": "#098658" }
        },
        {
            "scope": [
                "source.mongodb",
                "keyword.operator.assignment.mongodb",
                "meta.object-literal.key.mongodb"
            ],
            "settings": { "foreground": "#0C7D9D" }
        },
        {
            "scope": [
                "source.python.django",
                "support.function.builtin.python",
                "entity.name.function.django"
            ],
            "settings": { "foreground": "#795E26" }
        },
        {
            "scope": ["source.python.flask", "entity.name.function.flask"],
            "settings": { "foreground": "#795E26" }
        },
        {
            "scope": ["source.cs", "entity.name.type.cs", "keyword.other.cs"],
            "settings": { "foreground": "#267f99" }
        },
        {
            "scope": [
                "support.class.component.nextjs",
                "entity.name.function.nextjs",
                "meta.import.nextjs"
            ],
            "settings": { "foreground": "#AF00DB" }
        },
        {
            "scope": [
                "source.ruby",
                "keyword.control.ruby",
                "variable.other.readwrite.ruby"
            ],
            "settings": { "foreground": "#AF00DB" }
        },
        {
            "scope": [
                "source.json",
                "source.yaml",
                "source.toml",
                "punctuation.separator.key-value.json"
            ],
            "settings": { "foreground": "#A31515" }
        },
        {
            "scope": [
                "markup.heading.markdown",
                "markup.bold.markdown",
                "markup.italic.markdown",
                "markup.inline.raw.markdown"
            ],
            "settings": { "foreground": "#AF00DB", "fontStyle": "bold" }
        },
        {
            "scope": [
                "source.shell",
                "keyword.other.shell",
                "variable.other.readwrite.shell"
            ],
            "settings": { "foreground": "#0451A5" }
        }
    ]
}
