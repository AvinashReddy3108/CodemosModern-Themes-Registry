    "tokenColors": [
        {
            "scope": ["text.html.derivative"],
            "settings": { "foreground": "#ffffff", "fontStyle": "" }
        },
        {
            "scope": ["comment.block.html"],
            "settings": {
                "foreground": "#00ffff65",
                "fontStyle": "italic strikethrough"
            }
        },
        {
            "scope": [
                "entity.other.attribute-name.html",
                "punctuation.separator.key-value.html",
                "punctuation.definition.string.begin.html",
                "punctuation.definition.string.end.html"
            ],
            "settings": { "foreground": "#00ffff", "fontStyle": "" }
        },
        {
            "scope": ["string.quoted.double.html"],
            "settings": { "foreground": "#F0D43A", "fontStyle": "italic" }
        },
        {
            "scope": [
                "entity.name.tag.html",
                "punctuation.definition.tag.end.html",
                "punctuation.definition.tag.begin.html"
            ],
            "settings": { "foreground": "#F23557", "fontStyle": "bold" }
        },
        {
            "scope": [
                "support.constant.property-value.css",
                "constant.numeric.css",
                "constant.other.color.rgb-value.hex.css",
                "keyword",
                "meta.property-value.css",
                "support.constant.color.w3c-standard-color-name.css"
            ],
            "settings": { "foreground": "#ffffff", "fontStyle": "" }
        },
        {
            "scope": [
                "support.function.url.css",
                "support.function.misc.css",
                "support.function.transform.css",
                "variable.parameter.keyframe-list.css",
                "variable.css",
                "support.function.calc.css",
                "support.function.gradient.css",
                "variable.argument.css",
                "string.quoted.single.css",
                "invalid.deprecated.color.system.css"
            ],
            "settings": { "foreground": "#645CBB", "fontStyle": "italic bold" }
        },
        {
            "scope": ["meta.property-list.css"],
            "settings": { "foreground": "#F0D43A", "fontStyle": "" }
        },
        {
            "scope": [
                "support.type.property-name.css",
                "string.unquoted.attribute-value.css"
            ],
            "settings": { "foreground": "#F0D43A", "fontStyle": "italic" }
        },
        {
            "scope": ["comment.block.css"],
            "settings": { "foreground": "#00ffff65", "fontStyle": "italic" }
        },
        {
            "scope": [
                "entity.other.attribute-name.pseudo-element.css",
                "punctuation.separator.list.comma.css",
                "entity.other.attribute-name.pseudo-class.css",
                "meta.attribute-selector.css",
                "entity.other.attribute-name"
            ],
            "settings": { "foreground": "#00ffff", "fontStyle": "" }
        },
        {
            "scope": [
                "keyword.control.at-rule.font-face.css",
                "keyword.control.at-rule.keyframes.css",
                "entity.name.tag.css",
                "entity.name.tag.wildcard.css",
                "entity.other.attribute-name.class.css",
                "keyword.control.at-rule.media.css",
                "entity.other.attribute-name.id.css"
            ],
            "settings": { "foreground": "#F23557", "fontStyle": "" }
        },
        {
            "scope": ["support.constant.font-name.css"],
            "settings": { "foreground": "#645CBB", "fontStyle": "" }
        },
        {
            "scope": ["comment.line.double-slash.js"],
            "settings": { "foreground": "#00ffff65", "fontStyle": "italic" }
        },
        {
            "scope": [
                "string.quoted.double.js",
                "string.quoted.single.js",
                "string.quoted.double.json.comments",
                "constant.language.json.comments",
                "constant.numeric.json.comments"
            ],
            "settings": { "foreground": "#00ffff", "fontStyle": "italic" }
        },
        {
            "scope": [
                "string.quoted.double.js",
                "string.quoted.single.js",
                "variable.other.readwrite.js",
                "variable.other.constant",
                "variable"
            ],
            "settings": { "foreground": "#645CBB", "fontStyle": "italic bold" }
        },
        {
            "scope": [
                "support.type.property-name.json.comments",
                "meta.definition.variable.js",
                "variable.other.constant.js",
                "storage.type.function.js"
            ],
            "settings": { "foreground": "#F23557", "fontStyle": "italic bold" }
        },
        {
            "scope": [
                "storage.type.js",
                "variable.other.object.js",
                "entity.name.function",
                "meta.object.member.js"
            ],
            "settings": { "foreground": "#F0D43A", "fontStyle": "italic" }
        },
        {
            "scope": ["support.constant.property"],
            "settings": { "foreground": "#00ffff", "fontStyle": "italic bold" }
        },
        {
            "scope": [
                "constant.numeric.decimal.js",
                "keyword.operator.arithmetic.js",
                "keyword.operator.increment.js",
                "keyword.operator.decrement.js",
                "keyword.operator.relational.js",
                "keyword.operator.comparison.js",
                "variable.parameter"
            ],
            "settings": { "foreground": "#00ffff", "fontStyle": "italic" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
