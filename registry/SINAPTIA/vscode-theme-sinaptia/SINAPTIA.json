{
    "name": "SINAPTIA",
    "$schema": "vscode://schemas/color-theme",
    "type": "dark",
    "colors": {
        "editor.background": "#161717",
        "editorInlayHint.background": "#161717",
        "editorInlayHint.parameterBackground": "#161717",
        "editorInlayHint.typeBackground": "#161717",
        "editor.foreground": "#fbfbfb",
        "foreground": "#fbfbfb",
        "editor.lineHighlightBackground": "#222222",
        "editor.selectionBackground": "#424242",
        "editorCursor.foreground": "#fbfbfb",
        "terminalCursor.foreground": "#fbfbfb",
        "editorCursor.background": "#161717",
        "terminalCursor.background": "#161717",
        "activityBar.background": "#161717",
        "sideBar.background": "#161717",
        "activityBar.foreground": "#fbfbfb",
        "activityBar.inactiveForeground": "#999e9d",
        "statusBar.foreground": "#999e9d",
        "statusBar.background": "#161717",
        "statusBar.debuggingBackground": "#161717",
        "statusBar.noFolderBackground": "#161717",
        "editorLineNumber.foreground": "#999e9d",
        "editorLineNumber.activeForeground": "#fbfbfb",
        "editorWidget.background": "#222222",
        "list.highlightForeground": "#55adff",
        "list.focusBackground": "#424242",
        "list.activeSelectionBackground": "#424242",
        "editorGroupHeader.tabsBackground": "#161717",
        "tab.inactiveBackground": "#161717",
        "tab.activeBackground": "#222222",
        "tab.inactiveForeground": "#b2b6b5",
        "tab.activeForeground": "#fbfbfb",
        "titleBar.activeBackground": "#161717",
        "titleBar.inactiveBackground": "#161717",
        "titleBar.activeForeground": "#fbfbfb",
        "titleBar.inactiveForeground": "#999e9d",
        "breadcrumb.foreground": "#b2b6b5",
        "breadcrumb.focusForeground": "#fbfbfb",
        "terminal.foreground": "#fbfbfb",
        "terminal.ansiBlack": "#222222",
        "terminal.ansiBrightBlack": "#949494",
        "terminal.ansiRed": "#ff6b6b",
        "terminal.ansiBrightRed": "#ff6b6b",
        "terminal.ansiGreen": "#7FE2C5",
        "terminal.ansiBrightGreen": "#C0EADF",
        "terminal.ansiYellow": "#E1E0C8",
        "terminal.ansiBrightYellow": "#E1E0C8",
        "terminal.ansiBlue": "#55ADFF",
        "terminal.ansiBrightBlue": "#B0C9F0",
        "terminal.ansiMagenta": "#F1D6DD",
        "terminal.ansiBrightMagenta": "#F1D6DD",
        "terminal.ansiCyan": "#DCDFF1",
        "terminal.ansiBrightCyan": "#DCDFF1",
        "terminal.ansiWhite": "#fbfbfb",
        "terminal.ansiBrightWhite": "#fbfbfb",
        "focusBorder": "#55adff",
        "editorInlayHint.foreground": "#b2b6b5",
        "editorInlayHint.parameterForeground": "#b2b6b5",
        "editorInlayHint.typeForeground": "#b2b6b5"
    },
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "keyword": { "foreground": "#448acc", "fontStyle": "" },
        "*.controlFlow": { "foreground": "#55ADFF", "fontStyle": "" },
        "function.trait": { "foreground": "#55ADFF", "fontStyle": "" },
        "method.trait": { "foreground": "#55ADFF", "fontStyle": "" },
        "type": { "foreground": "#E1E0C8", "fontStyle": "" },
        "class": { "foreground": "#E1E0C8", "fontStyle": "" },
        "struct": { "foreground": "#E1E0C8", "fontStyle": "" },
        "enum": { "foreground": "#E1E0C8", "fontStyle": "" },
        "union": { "foreground": "#E1E0C8", "fontStyle": "" },
        "typeAlias": { "foreground": "#E1E0C8", "fontStyle": "" },
        "builtinType": { "foreground": "#E1E0C8", "fontStyle": "" },
        "interface": { "foreground": "#55ADFF", "fontStyle": "" },
        "typeAlias.trait": { "foreground": "#55ADFF", "fontStyle": "" },
        "typeParameter": { "foreground": "#55ADFF", "fontStyle": "" },
        "variable.constant": { "foreground": "#F1D6DD", "fontStyle": "" },
        "variable.static": { "foreground": "#F1D6DD", "fontStyle": "" },
        "variable.constant.trait": { "foreground": "#55ADFF", "fontStyle": "" },
        "number": { "foreground": "#E3A6DC", "fontStyle": "" },
        "string": { "foreground": "#7FE2C5", "fontStyle": "" },
        "characterLiteral": { "foreground": "#7FE2C5", "fontStyle": "" },
        "property": { "foreground": "#DCDFF1", "fontStyle": "" },
        "enumMember": { "foreground": "#DCDFF1", "fontStyle": "" },
        "boolean": { "foreground": "#DCDFF1", "fontStyle": "" },
        "macro": { "foreground": "#C0EADF", "fontStyle": "" },
        "formatSpecifier": { "foreground": "#DCDFF1", "fontStyle": "" },
        "escapeSequence": { "foreground": "#DCDFF1", "fontStyle": "" },
        "lifetime": { "foreground": "#55ADFF", "fontStyle": "" },
        "comment": { "foreground": "#a8acad", "italic": true },
        "comment.documentation": { "foreground": "#a8acad", "fontStyle": "" },
        "*.attribute": { "foreground": "#b2b6b5", "fontStyle": "" },
        "unresolvedReference": { "foreground": "#ff6b6b", "fontStyle": "" },
        "magit-ref-name": { "foreground": "#E1E0C8", "fontStyle": "" },
        "magit-remote-ref-name": { "foreground": "#E1E0C8", "fontStyle": "" },
        "magit-tag-name": { "foreground": "#E3A6DC", "fontStyle": "" },
        "*.unsafe": { "foreground": "#ff6b6b", "bold": true },
        "*.mutable": { "underline": true },
        "*.consuming": { "italic": true },
        "*.public.declaration": { "foreground": "#E3A6DC", "fontStyle": "" }
    },
    "tokenColors": [
        {
            "scope": "keyword",
            "settings": { "foreground": "#448acc", "fontStyle": "" }
        },
        {
            "scope": "storage",
            "settings": { "foreground": "#448acc", "fontStyle": "" }
        },
        {
            "scope": "variable.language.self",
            "settings": { "foreground": "#448acc", "fontStyle": "" }
        },
        {
            "scope": "variable.language.this",
            "settings": { "foreground": "#448acc", "fontStyle": "" }
        },
        {
            "scope": "keyword.type.go",
            "settings": { "foreground": "#448acc", "fontStyle": "" }
        },
        {
            "scope": "keyword.control",
            "settings": { "foreground": "#55ADFF", "fontStyle": "" }
        },
        {
            "scope": "entity.name.type",
            "settings": { "foreground": "#E1E0C8", "fontStyle": "" }
        },
        {
            "scope": "keyword.type",
            "settings": { "foreground": "#E1E0C8", "fontStyle": "" }
        },
        {
            "scope": "storage.type.cs",
            "settings": { "foreground": "#E1E0C8", "fontStyle": "" }
        },
        {
            "scope": "storage.type.java",
            "settings": { "foreground": "#E1E0C8", "fontStyle": "" }
        },
        {
            "scope": "storage.type.boolean.go",
            "settings": { "foreground": "#E1E0C8", "fontStyle": "" }
        },
        {
            "scope": "storage.type.byte.go",
            "settings": { "foreground": "#E1E0C8", "fontStyle": "" }
        },
        {
            "scope": "storage.type.error.go",
            "settings": { "foreground": "#E1E0C8", "fontStyle": "" }
        },
        {
            "scope": "storage.type.numeric.go",
            "settings": { "foreground": "#E1E0C8", "fontStyle": "" }
        },
        {
            "scope": "storage.type.rune.go",
            "settings": { "foreground": "#E1E0C8", "fontStyle": "" }
        },
        {
            "scope": "storage.type.string.go",
            "settings": { "foreground": "#E1E0C8", "fontStyle": "" }
        },
        {
            "scope": "storage.type.uintptr.go",
            "settings": { "foreground": "#E1E0C8", "fontStyle": "" }
        },
        {
            "scope": "entity.name.type.interface",
            "settings": { "foreground": "#55ADFF", "fontStyle": "" }
        },
        {
            "scope": "entity.name.type.type-parameter",
            "settings": { "foreground": "#55ADFF", "fontStyle": "" }
        },
        {
            "scope": "constant",
            "settings": { "foreground": "#F1D6DD", "fontStyle": "" }
        },
        {
            "scope": "constant.numeric",
            "settings": { "foreground": "#E3A6DC", "fontStyle": "" }
        },
        {
            "scope": "string",
            "settings": { "foreground": "#7FE2C5", "fontStyle": "" }
        },
        {
            "scope": "entity.name.variable.field",
            "settings": { "foreground": "#DCDFF1", "fontStyle": "" }
        },
        {
            "scope": "entity.name.variable.property",
            "settings": { "foreground": "#DCDFF1", "fontStyle": "" }
        },
        {
            "scope": "variable.other.member",
            "settings": { "foreground": "#DCDFF1", "fontStyle": "" }
        },
        {
            "scope": "variable.other.object.property",
            "settings": { "foreground": "#DCDFF1", "fontStyle": "" }
        },
        {
            "scope": "variable.other.readwrite.instance",
            "settings": { "foreground": "#DCDFF1", "fontStyle": "" }
        },
        {
            "scope": "support.type.property-name",
            "settings": { "foreground": "#DCDFF1", "fontStyle": "" }
        },
        {
            "scope": "entity.name.variable.enum-member",
            "settings": { "foreground": "#DCDFF1", "fontStyle": "" }
        },
        {
            "scope": "constant.other.enum",
            "settings": { "foreground": "#DCDFF1", "fontStyle": "" }
        },
        {
            "scope": "variable.other.enummember",
            "settings": { "foreground": "#DCDFF1", "fontStyle": "" }
        },
        {
            "scope": "entity.name.type.option",
            "settings": { "foreground": "#DCDFF1", "fontStyle": "" }
        },
        {
            "scope": "entity.name.type.result",
            "settings": { "foreground": "#DCDFF1", "fontStyle": "" }
        },
        {
            "scope": "entity.name.function.macro",
            "settings": { "foreground": "#C0EADF", "fontStyle": "" }
        },
        {
            "scope": "entity.name.function.preprocessor",
            "settings": { "foreground": "#C0EADF", "fontStyle": "" }
        },
        {
            "scope": "constant.other.placeholder",
            "settings": { "foreground": "#DCDFF1", "fontStyle": "" }
        },
        {
            "scope": "punctuation.definition.interpolation",
            "settings": { "foreground": "#DCDFF1", "fontStyle": "" }
        },
        {
            "scope": "punctuation.section.embedded",
            "settings": { "foreground": "#DCDFF1", "fontStyle": "" }
        },
        {
            "scope": "constant.character.escape",
            "settings": { "foreground": "#DCDFF1", "fontStyle": "" }
        },
        {
            "scope": "comment",
            "settings": { "foreground": "#a8acad", "fontStyle": "italic" }
        },
        {
            "scope": "comment.line.documentation",
            "settings": { "foreground": "#a8acad", "fontStyle": "" }
        },
        {
            "scope": "comment.block.documentation",
            "settings": { "foreground": "#a8acad", "fontStyle": "" }
        },
        {
            "scope": "comment.block.javadoc",
            "settings": { "foreground": "#a8acad", "fontStyle": "" }
        },
        {
            "scope": "entity.name.function.decorator",
            "settings": { "foreground": "#b2b6b5", "fontStyle": "" }
        },
        {
            "scope": "storage.type.annotation",
            "settings": { "foreground": "#b2b6b5", "fontStyle": "" }
        },
        {
            "scope": "punctuation.definition.annotation",
            "settings": { "foreground": "#b2b6b5", "fontStyle": "" }
        },
        {
            "scope": "keyword.operator",
            "settings": { "foreground": "#D6D6D6", "fontStyle": "" }
        },
        {
            "scope": "markup.deleted",
            "settings": { "foreground": "#ff6b6b", "fontStyle": "" }
        },
        {
            "scope": "markup.inserted",
            "settings": { "foreground": "#7FE2C5", "fontStyle": "" }
        },
        {
            "scope": "markup.changed",
            "settings": { "foreground": "#55ADFF", "fontStyle": "" }
        },
        {
            "scope": "meta.diff",
            "settings": { "foreground": "#999e9d", "fontStyle": "" }
        },
        {
            "scope": "comment.line.number-sign.git-commit",
            "settings": { "foreground": "#b2b6b5", "fontStyle": "" }
        },
        {
            "scope": "invalid.deprecated.line-too-long.git-commit",
            "settings": { "foreground": "#F1D6DD", "fontStyle": "" }
        },
        {
            "scope": "invalid.illegal.line-too-long.git-commit",
            "settings": { "foreground": "#ff6b6b", "fontStyle": "" }
        },
        {
            "scope": "magit.entity",
            "settings": { "foreground": "#7FE2C5", "fontStyle": "" }
        },
        {
            "scope": "magit.header",
            "settings": { "foreground": "#448acc", "fontStyle": "" }
        },
        {
            "scope": "magit.subheader",
            "settings": { "foreground": "#55ADFF", "fontStyle": "" }
        }
    ]
}
