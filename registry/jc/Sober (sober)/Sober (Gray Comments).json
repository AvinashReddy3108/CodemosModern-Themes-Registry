{
    "type": "light",
    "tokenColors": [
        {
            "settings": { "foreground": "#070707FF", "background": "#FFFFFFFF" }
        },
        {
            "scope": "keyword.control.directive",
            "settings": { "foreground": "#009999", "fontStyle": "" }
        },
        { "scope": "comment", "settings": { "foreground": "#808080" } },
        {
            "scope": ["keyword", "storage.type", "entity.name.tag"],
            "settings": { "fontStyle": "bold" }
        },
        {
            "scope": "constant.numeric",
            "settings": { "foreground": "#B600FF" }
        },
        { "scope": "string", "settings": { "foreground": "#A00" } },
        {
            "scope": "constant.character.escape",
            "settings": { "foreground": "#009200" }
        },
        {
            "scope": "constant.language",
            "settings": { "fontStyle": "underline" }
        },
        { "scope": "constant.regexp", "settings": { "foreground": "#B600AA" } },
        {
            "scope": "constant.character.entity",
            "settings": { "foreground": "#009200" }
        },
        {
            "scope": ["markup.heading", "support.type.property-name"],
            "settings": { "foreground": "#D0D" }
        },
        {
            "scope": "markup.bold",
            "settings": { "fontStyle": "bold", "foreground": "#294" }
        },
        {
            "scope": "markup.italic",
            "settings": { "fontStyle": "underline", "foreground": "#294" }
        },
        {
            "scope": "markup.list.unnumbered",
            "settings": { "foreground": "#6F618C" }
        },
        {
            "scope": "markup.list.numbered",
            "settings": { "foreground": "#618C85" }
        }
    ],
    "colors": {
        "activityBar.activeBackground": "#2F68B0",
        "activityBar.activeBorder": "#3EA4FF",
        "activityBar.background": "#46484B",
        "activityBar.foreground": "#F3F8FF",
        "activityBar.inactiveForeground": "#AAA",
        "activityBarBadge.background": "#FFF",
        "activityBarBadge.foreground": "#000",
        "badge.background": "#3EA4ff",
        "badge.foreground": "#FFF",
        "button.background": "#2F68B0",
        "button.hoverBackground": "#3EA4FF",
        "checkbox.border": "#AAA",
        "dropdown.border": "#AAA",
        "editor.background": "#FCFCFC",
        "editor.foreground": "#000",
        "editor.lineHighlightBackground": "#0001",
        "editor.selectionBackground": "#00CCCC44",
        "editorGroup.border": "#888",
        "editorGroupHeader.tabsBackground": "#AAA",
        "editorLineNumber.activeForeground": "#009664",
        "editorLineNumber.foreground": "#AAA",
        "input.border": "#AAA",
        "list.activeSelectionBackground": "#C1E2FF",
        "list.activeSelectionForeground": "#2F68B0",
        "list.focusHighlightForeground": "#186DE0",
        "list.highlightForeground": "#72C4E1",
        "list.hoverBackground": "#0001",
        "menu.selectionBackground": "#C1E2FF",
        "menu.selectionForeground": "#000",
        "menubar.selectionBackground": "#0008",
        "sideBar.background": "#F0F0F0",
        "sideBar.border": "#BBB",
        "sideBarTitle.foreground": "#111",
        "statusBar.background": "#1A1A1A",
        "statusBar.border": "#1A1A1A",
        "statusBar.debuggingBackground": "#C51D23",
        "statusBar.debuggingBorder": "#C51D23",
        "statusBar.debuggingForeground": "#FFF",
        "statusBar.foreground": "#EEE",
        "statusBar.noFolderBackground": "#CCC",
        "statusBar.noFolderBorder": "#CCC",
        "statusBar.noFolderForeground": "#111",
        "statusBarItem.remoteBackground": "#2F68B0",
        "statusBarItem.remoteForeground": "#FFF",
        "tab.activeBackground": "#FCFCFC",
        "tab.activeForeground": "#000",
        "tab.border": "#AAA",
        "tab.inactiveBackground": "#CCC",
        "tab.inactiveForeground": "#111",
        "titleBar.activeBackground": "#004096",
        "titleBar.activeForeground": "#FFF",
        "titleBar.border": "#000",
        "titleBar.inactiveBackground": "#EEE",
        "titleBar.inactiveForeground": "#666"
    },
    "$schema": "vscode://schemas/color-theme"
}
