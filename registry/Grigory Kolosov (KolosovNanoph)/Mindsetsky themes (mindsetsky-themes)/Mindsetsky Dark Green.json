    "tokenColors": [
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#ffffff", "fontStyle": "italic" }
        },
        {
            "scope": ["keyword", "storage", "keyword.control"],
            "settings": { "foreground": "#5ca594", "fontstyle": "bold" }
        },
        {
            "scope": ["string", "string.quoted"],
            "settings": { "foreground": "#4da4aa" }
        },
        {
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#4cdfb1" }
        },
        {
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#5ca594" }
        },
        {
            "scope": ["entity.name.type", "support.type", "storage.type"],
            "settings": { "foreground": "#2ab09a", "fontstyle": "bold" }
        },
        {
            "scope": ["variable", "identifier"],
            "settings": { "foreground": "#cefff3" }
        },
        {
            "scope": ["punctuation", "operator"],
            "settings": { "foreground": "#2ab09a" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
