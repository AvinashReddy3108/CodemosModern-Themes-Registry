    "tokenColors": [
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#ffffff", "fontStyle": "italic" }
        },
        {
            "scope": ["keyword", "storage", "keyword.control"],
            "settings": { "foreground": "#a55c93", "fontstyle": "bold" }
        },
        {
            "scope": ["string", "string.quoted"],
            "settings": { "foreground": "#aa4d84" }
        },
        {
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#df4c89" }
        },
        {
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#a55c93" }
        },
        {
            "scope": ["entity.name.type", "support.type", "storage.type"],
            "settings": { "foreground": "#b02a81", "fontstyle": "bold" }
        },
        {
            "scope": ["variable", "identifier"],
            "settings": { "foreground": "#ffcef9" }
        },
        {
            "scope": ["punctuation", "operator"],
            "settings": { "foreground": "#b02a81" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
