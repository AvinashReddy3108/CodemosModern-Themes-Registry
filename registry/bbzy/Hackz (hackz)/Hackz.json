    "tokenColors": [
        {
            "name": "Source",
            "scope": "source, meta",
            "settings": { "foreground": "#5eff00" }
        },
        {
            "name": "HTML Tag and Key",
            "scope": "entity.name.tag.html, punctuation.separator.key-value.html, meta.tag.block.any.html",
            "settings": { "foreground": "#f3ff6eff" }
        },
        {
            "name": "HTML Text",
            "scope": "text.html.derivative, string.quoted.double.html, text.html.vue-html",
            "settings": { "foreground": "#c8f8b6" }
        },
        {
            "name": "HTML Attribute",
            "scope": "entity.other.attribute-name.html, constant.character.entity.html, punctuation.definition.entity.html",
            "settings": { "foreground": "#5eff00" }
        },
        {
            "name": "Html Vue Tag and Key",
            "scope": "entity.name.tag.template.html, entity.name.tag.inline.any.html, entity.name.tag.script.html, entity.name.tag.style.html, entity.name.tag.block.any.html, entity.name.tag.other.html, punctuation.definition.tag.begin.html, punctuation.definition.tag.end.html, meta.tag.other.html",
            "settings": { "foreground": "#f3ff6eff" }
        },
        {
            "name": "Comment",
            "scope": "comment, punctuation.definition.comment",
            "settings": { "foreground": "#666666", "fontStyle": "italic" }
        },
        {
            "name": "String Literial",
            "scope": "string, punctuation.definition.string.begin, punctuation.definition.string.end",
            "settings": { "foreground": "#ffffff" }
        },
        {
            "name": "Number Literial",
            "scope": "constant.numeric",
            "settings": { "foreground": "#c8f8b6" }
        },
        {
            "name": "Variable",
            "scope": "variable",
            "settings": { "foreground": "#5eff00" }
        },
        {
            "name": "Keyword",
            "scope": "keyword, punctuation.terminator.statement, punctuation.curlybrace.open, punctuation.curlybrace.close",
            "settings": { "foreground": "#f3ff6e" }
        },
        {
            "name": "Punctuation block",
            "scope": "punctuation",
            "settings": { "foreground": "#5eff00", "fontStyle": "" }
        },
        {
            "name": "Regexp",
            "scope": "string.regexp",
            "settings": { "foreground": "#86ffd1" }
        },
        {
            "name": "Storage",
            "scope": "storage",
            "settings": { "foreground": "#f3ff6e", "fontStyle": "" }
        },
        {
            "name": "Class name",
            "scope": "entity",
            "settings": { "foreground": "#5eff00" }
        },
        {
            "name": "Function Related Colors",
            "scope": "entity.name.function, punctuation.parenthesis.open, punctuation.parenthesis.close, punctuation.separator.comma, meta.function-call, punctuation.section.function.begin, punctuation.definition.arguments.begin, punctuation.definition.arguments.end, punctuation.definition.parameters.begin, punctuation.definition.parameters.end, punctuation.separator.parameters, meta.brace.round",
            "settings": { "foreground": "#c8f8b6" }
        },
        {
            "name": "Function Sector",
            "scope": "meta.function-call.arguments",
            "settings": { "foreground": "#5eff00" }
        },
        {
            "name": "User-defined constant",
            "scope": "constant",
            "settings": { "foreground": "#c8f8b6" }
        },
        {
            "name": "Support Others",
            "scope": "support",
            "settings": { "foreground": "#c8f8b6" }
        },
        {
            "name": "Language Var",
            "scope": "variable.language",
            "settings": { "foreground": "#c8f8b6" }
        },
        {
            "name": "Support Var",
            "scope": "support.variable.property, support.variable.dom.",
            "settings": { "foreground": "#5eff00" }
        },
        {
            "name": "This Var",
            "scope": "variable.language.this",
            "settings": { "foreground": "#5eff00" }
        },
        {
            "scope": "token.info-token, token.debug-token",
            "settings": { "foreground": "#5eff00" }
        },
        {
            "scope": "token.warn-token",
            "settings": { "foreground": "#cd9731" }
        },
        {
            "scope": "token.error-token",
            "settings": { "foreground": "#f44747" }
        }
    ]
}
