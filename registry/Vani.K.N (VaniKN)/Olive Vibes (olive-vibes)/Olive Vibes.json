        "tab.unfocusedActiveBorder": "#2AD4CD",
        "tab.unfocusedActiveBackground": "#2AD4CD40",
        "tab.unfocusedActiveForeground": "#FFFFFF",
        "tab.unfocusedInactiveBackground": "#2AD4CD10",
        "tab.unfocusedInactiveForeground": "#FFFFFF7f",
        "terminal.foreground": "#FFFFFF",
        "terminal.background": "#000000",
        "terminal.ansiBlack": "#000000",
        "terminal.ansiBlue": "#FFFFFF",
        "terminal.ansiBrightBlack": "#2AD4CD",
        "terminal.ansiBrightBlue": "#FFFFFF",
        "terminal.ansiBrightCyan": "#7F96FF",
        "terminal.ansiBrightGreen": "#DFFF00",
        "terminal.ansiBrightMagenta": "#2AD4CD",
        "terminal.ansiBrightRed": "#E0479E",
        "terminal.ansiBrightWhite": "#2AD4CD",
        "terminal.ansiBrightYellow": "#2AD4CD",
        "terminal.ansiCyan": "#7F96FF",
        "terminal.ansiGreen": "#DFFF00",
        "terminal.ansiMagenta": "#2AD4CD",
        "terminal.ansiRed": "#E0479E",
        "terminal.ansiWhite": "#2AD4CD",
        "terminal.ansiYellow": "#2AD4CD",
        "terminalCursor.background": "#000000",
        "terminalCursor.foreground": "#2AD4CD",
        "textLink.activeForeground": "#FFFFFF",
        "textLink.foreground": "#2AD4CD",
        "titleBar.activeBackground": "#000000",
        "titleBar.activeForeground": "#FFFFFF",
        "titleBar.border": "#00000060",
        "titleBar.inactiveBackground": "#000000",
        "titleBar.inactiveForeground": "#2AD4CD",
        "tree.indentGuidesStroke": "#000000",
        "widget.shadow": "#00000030"
