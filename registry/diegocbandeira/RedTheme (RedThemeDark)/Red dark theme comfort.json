            },
            {
                "scope": "support.constant",
                "settings": { "foreground": "#FF0000" }
            },
            {
                "scope": "support.other",
                "settings": { "foreground": "#00f0dc" }
            },
            {
                "scope": "support.function",
                "settings": { "foreground": "#00dc1a" }
            },
            {
                "scope": "support.type",
                "settings": { "foreground": "#00f31c", "fontStyle": "bold" }
            },
            {
                "scope": "entity.name.function",
                "settings": { "foreground": "#ff1900", "fontStyle": "italic" }
            }
