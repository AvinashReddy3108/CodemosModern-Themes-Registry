    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#F5F5F545" }
        },
        {
            "name": "Comment Annotations",
            "scope": [
                "keyword.other.documentation.javadoc",
                "comment punctuation.definition.block.tag"
            ],
            "settings": { "foreground": "#836781" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "string constant.other.placeholder"],
            "settings": { "foreground": "#F5F5F5" }
        },
        {
            "name": "Colors",
            "scope": ["constant.other.color"],
            "settings": { "foreground": "#F5F5F5" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#AB6369" }
        },
        {
            "name": "Keyword, Storage",
            "scope": ["keyword", "storage.modifier"],
            "settings": { "foreground": "#b19db4" }
        },
        {
            "name": "Keyword - New",
            "scope": ["keyword.operator.new"],
            "settings": { "foreground": "#836781" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation",
                "meta.brace.square",
                "punctuation.definition.block"
            ],
            "settings": { "foreground": "#F5F5F5" }
        },
        {
            "name": "Operator, Misc",
            "scope": [
                "keyword.control",
                "constant.other.color",
                "meta.tag",
                "punctuation.definition.tag",
                "punctuation.separator.inheritance.php",
                "punctuation.section.embedded",
                "keyword.other.template",
                "keyword.other.substitution"
            ],
            "settings": { "foreground": "#6F98B3" }
        },
        {
            "name": "Tag",
            "scope": [
                "entity.name.tag",
                "meta.tag.sgml",
                "markup.deleted.git_gutter"
            ],
            "settings": { "foreground": "#AB6369" }
        },
        {
            "name": "Function, Special Method",
            "scope": [
                "entity.name.function",
                "meta.function-call",
                "variable.function",
                "support.function",
                "keyword.other.special-method",
                "entity.name.operator.custom-literal"
            ],
            "settings": { "foreground": "#b19db4" }
        },
        {
            "name": "Number, Constant, Function Argument, Tag Attribute, Embedded",
            "scope": [
                "constant.numeric",
                "constant.language",
                "support.constant",
                "constant.character",
                "constant.escape",
                "variable.parameter",
                "keyword.other.unit",
                "keyword.other"
            ],
            "settings": { "foreground": "#AB6369" }
        },
        {
            "name": "String, Symbols, Inherited Class, Markup Heading",
            "scope": [
                "constant.other.symbol",
                "constant.other.key",
                "support.class.builtin",
                "entity.other.inherited-class",
                "markup.heading",
                "markup.inserted.git_gutter",
                "meta.group.braces.curly constant.other.object.key.js string.unquoted.label.js"
            ],
            "settings": { "foreground": "#81B19B" }
        },
        {
            "name": "Class, Support",
            "scope": [
                "entity.name",
                "support.type",
                "support.class",
                "support.other.namespace.use.php",
                "meta.use.php",
                "support.other.namespace.php",
                "markup.changed.git_gutter",
                "support.type.sys-types"
            ],
            "settings": { "foreground": "#CAAB6D" }
        },
        {
            "name": "Entity Types",
            "scope": ["support.type"],
            "settings": { "foreground": "#81B19B" }
        },
        {
            "name": "Language methods",
            "scope": ["variable.language"],
            "settings": { "fontStyle": "italic", "foreground": "#AB6369" }
        },
        {
            "name": "Attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#b19db4" }
        },
        {
            "name": "HTML Attributes",
            "scope": [
                "text.html.basic entity.other.attribute-name.html",
                "text.html.basic entity.other.attribute-name"
            ],
            "settings": { "fontStyle": "italic", "foreground": "#CAAB6D" }
        },
        {
            "name": "CSS Classes, IDs and Tags",
            "scope": [
                "entity.other.attribute-name.class",
                "entity.other.attribute-name.class",
                "source.css entity.name.tag",
                "source.html entity.name.tag.css",
                "source.css punctuation.definition.entity",
                "source.html punctuation.definition.entity"
            ],
            "settings": { "foreground": "#b19db4" }
        },
        {
            "name": "CSS Property Names",
            "scope": ["support.type.property-name"],
            "settings": { "foreground": "#F5F5F5" }
        },
        {
            "name": "CSS Property Values and Functions",
            "scope": [
                "source.css support.constant.property-value",
                "source.css support.function.misc",
                "source.html support.function.misc"
            ],
            "settings": { "foreground": "#836781" }
        },
        {
            "name": "CSS @-Rules and Interpolation",
            "scope": [
                "keyword.control.at-rule",
                "keyword.control.at-rule punctuation",
                "source.css punctuation.definition.interpolation.begin.bracket.curly",
                "source.css punctuation.definition.interpolation.end.bracket.curly",
                "source.html punctuation.definition.interpolation.begin.bracket.curly",
                "source.html punctuation.definition.interpolation.end.bracket.curly",
                "source.css variable.other.less",
                "source.css punctuation.definition.variable.less"
            ],
            "settings": { "foreground": "#81B19B" }
        },
        {
            "name": "CSS Variables",
            "scope": [
                "source.css variable",
                "source.css variable.other.less",
                "source.css punctuation.definition.variable.less"
            ],
            "settings": { "foreground": "#6F98B3" }
        },
        {
            "name": "CSS Colors",
            "scope": [
                "source.css constant.other.color",
                "source.css punctuation.definition.constant"
            ],
            "settings": { "foreground": "#B89784" }
        },
        {
            "name": "CSS Functions",
            "scope": ["source.css entity.name.function"],
            "settings": { "foreground": "#836781" }
        },
        {
            "name": "CSS Units",
            "scope": ["source.css keyword.other.unit"],
            "settings": { "foreground": "#B89784" }
        },
        {
            "name": "Inserted",
            "scope": ["markup.inserted"],
            "settings": { "foreground": "#81B19B" }
        },
        {
            "name": "Deleted",
            "scope": ["markup.deleted"],
            "settings": { "foreground": "#AB6369" }
        },
        {
            "name": "Changed",
            "scope": ["markup.changed"],
            "settings": { "foreground": "#CAAB6D" }
        },
        {
            "name": "Regular Expressions",
            "scope": ["string.regexp"],
            "settings": { "foreground": "#6F98B3" }
        },
        {
            "name": "Escape Characters",
            "scope": ["constant.character.escape"],
            "settings": { "foreground": "#6F98B3" }
        },
        {
            "name": "URL",
            "scope": [
                "*url*",
                "*link*",
                "*uri*",
                "variable.other.link.underline"
            ],
            "settings": {
                "foreground": "#F5F5F560",
                "fontStyle": "italic underline"
            }
        },
        {
            "name": "JSON Key - Level 0",
            "scope": [
