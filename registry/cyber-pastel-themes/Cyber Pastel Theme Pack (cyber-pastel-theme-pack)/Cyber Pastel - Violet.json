        "sideBarSectionHeader.border": "#e5e7eb",
        "tree.indentGuidesStroke": "#e5e7eb",
        "tree.tableColumnsBorder": "#e5e7eb",
        "tree.tableOddRowsBackground": "#f9fafb",
        "explorer.decorations.colors": "#8b5cf6",
