{
    "name": "Cyber Pastel - Violet",
    "type": "light",
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "variable": "#374151",
        "variable.readonly": "#8b5cf6",
        "parameter": "#374151",
        "function": "#3b82f6",
        "method": "#3b82f6",
        "class": "#ec4899",
        "interface": "#ec4899",
        "type": "#ec4899",
        "enum": "#8b5cf6",
        "decorator": "#f59e0b",
        "macro": "#10b981"
    },
    "colors": {
        "editor.background": "#fefeff",
        "editor.foreground": "#374151",
        "editorLineNumber.foreground": "#a78bfa",
        "editorLineNumber.activeForeground": "#8b5cf6",
        "editorCursor.foreground": "#8b5cf6",
