    "tokenColors": [
        {
            "name": "Comment",
            "scope": [
                "comment",
                "punctuation.definition.comment",
                "comment.line",
                "comment.block"
            ],
            "settings": { "fontStyle": "italic", "foreground": "#8e24aa" }
        },
        {
            "name": "Comment Documentation",
            "scope": [
                "comment.block.documentation",
                "comment.line.documentation"
            ],
            "settings": { "fontStyle": "italic", "foreground": "#9c27b0" }
        },
        {
            "name": "Keyword",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.new",
                "keyword.other.using",
                "keyword.other.import"
            ],
            "settings": { "foreground": "#6a1b9a", "fontStyle": "bold" }
        },
        {
            "name": "Control Flow Keywords",
            "scope": [
                "keyword.control.flow",
                "keyword.control.conditional",
                "keyword.control.loop",
                "keyword.control.exception",
                "keyword.control.trycatch"
            ],
            "settings": { "foreground": "#c2185b", "fontStyle": "bold" }
        },
        {
            "name": "Storage Type",
            "scope": [
                "storage.type",
                "storage.modifier",
                "storage.type.class",
                "storage.type.function",
                "storage.type.interface"
            ],
            "settings": { "foreground": "#1976d2", "fontStyle": "bold" }
        },
        {
            "name": "Operator",
            "scope": [
                "keyword.operator",
                "keyword.operator.arithmetic",
                "keyword.operator.comparison",
                "keyword.operator.logical",
                "keyword.operator.assignment"
            ],
            "settings": { "foreground": "#388e3c" }
        },
        {
            "name": "Operator Word",
            "scope": [
                "keyword.operator.word",
                "keyword.operator.typeof",
                "keyword.operator.instanceof"
            ],
            "settings": { "foreground": "#c2185b" }
        },
        {
            "name": "Variable",
            "scope": [
                "variable",
                "variable.other",
                "variable.language.this",
                "variable.language.super"
            ],
            "settings": { "foreground": "#1a0d1a" }
        },
        {
            "name": "Variable Property",
            "scope": [
                "variable.other.property",
                "variable.other.object.property",
                "variable.other.member"
            ],
            "settings": { "foreground": "#388e3c" }
        },
        {
            "name": "Variable Parameter",
            "scope": ["variable.parameter", "variable.parameter.function"],
            "settings": { "foreground": "#f57c00", "fontStyle": "italic" }
        },
        {
            "name": "Function Name",
            "scope": [
                "entity.name.function",
                "entity.name.method",
                "meta.function-call entity.name.function",
                "support.function"
            ],
            "settings": { "foreground": "#6a1b9a" }
        },
        {
            "name": "Function Declaration",
            "scope": [
                "meta.function entity.name.function",
                "meta.method entity.name.function"
            ],
            "settings": { "foreground": "#7b1fa2", "fontStyle": "bold" }
        },
        {
            "name": "Built-in Functions",
            "scope": ["support.function.builtin", "support.function.magic"],
            "settings": { "foreground": "#00796b" }
        },
        {
            "name": "Class Name",
            "scope": [
                "entity.name.class",
                "entity.name.type.class",
                "entity.other.inherited-class"
            ],
            "settings": { "foreground": "#f57c00", "fontStyle": "bold" }
        },
        {
            "name": "Interface Name",
            "scope": ["entity.name.interface", "entity.name.type.interface"],
            "settings": { "foreground": "#1976d2", "fontStyle": "bold" }
        },
        {
            "name": "Type Annotation",
            "scope": [
                "entity.name.type",
                "support.type",
                "meta.type.annotation"
            ],
            "settings": { "foreground": "#388e3c" }
        },
        {
            "name": "String",
            "scope": [
                "string",
                "string.quoted",
                "string.quoted.single",
                "string.quoted.double"
            ],
            "settings": { "foreground": "#388e3c" }
        },
        {
            "name": "Template String",
            "scope": ["string.template", "string.quoted.template"],
            "settings": { "foreground": "#66bb6a" }
        },
        {
            "name": "String Interpolation",
            "scope": ["string.interpolated", "meta.template.expression"],
            "settings": { "foreground": "#1976d2" }
        },
        {
            "name": "Regex",
            "scope": ["string.regexp", "string.regex"],
            "settings": { "foreground": "#f57c00" }
        },
        {
            "name": "Number",
            "scope": [
                "constant.numeric",
                "constant.numeric.integer",
                "constant.numeric.float",
                "constant.numeric.decimal",
                "constant.numeric.hex",
                "constant.numeric.binary",
                "constant.numeric.octal"
            ],
            "settings": { "foreground": "#f57c00" }
        },
        {
            "name": "Boolean",
            "scope": [
                "constant.language.boolean",
                "constant.language.true",
                "constant.language.false"
            ],
            "settings": { "foreground": "#c2185b", "fontStyle": "bold" }
        },
        {
            "name": "Null/Undefined",
            "scope": [
                "constant.language.null",
                "constant.language.undefined",
                "constant.language.none"
            ],
            "settings": { "foreground": "#f44336", "fontStyle": "bold" }
        },
        {
            "name": "Constant",
            "scope": ["constant.other", "variable.other.constant"],
            "settings": { "foreground": "#f57c00", "fontStyle": "italic" }
        },
        {
            "name": "JS/TS - Import/Export",
            "scope": [
                "keyword.control.import",
                "keyword.control.export",
                "keyword.control.from",
                "keyword.control.as"
            ],
            "settings": { "foreground": "#1976d2" }
        },
        {
            "name": "JS/TS - Async/Await",
            "scope": [
                "keyword.control.flow.async",
                "keyword.control.flow.await"
            ],
            "settings": { "foreground": "#c2185b", "fontStyle": "italic" }
        },
        {
            "name": "JS/TS - Destructuring",
            "scope": [
                "meta.object-binding-pattern-variable entity.name.binding",
                "meta.array-binding-pattern-variable entity.name.binding"
            ],
            "settings": { "foreground": "#388e3c" }
        },
        {
            "name": "Python - Self/Cls",
            "scope": [
                "variable.language.special.self.python",
                "variable.language.special.cls.python"
            ],
            "settings": { "foreground": "#1976d2", "fontStyle": "italic" }
        },
        {
            "name": "Python - Magic Methods",
            "scope": ["support.function.magic.python"],
            "settings": { "foreground": "#f57c00" }
        },
        {
            "name": "Python - Decorators",
            "scope": [
                "entity.name.function.decorator.python",
                "punctuation.definition.decorator.python"
            ],
            "settings": { "foreground": "#f57c00" }
        },
        {
            "name": "Java/C# - Annotations",
            "scope": [
                "punctuation.definition.annotation",
                "storage.type.annotation"
            ],
            "settings": { "foreground": "#f57c00" }
        },
        {
            "name": "Java/C# - Generics",
            "scope": [
                "punctuation.definition.typeparameters",
                "entity.name.type.parameter"
            ],
            "settings": { "foreground": "#1976d2" }
        },
        {
            "name": "C/C++ - Preprocessor",
            "scope": ["keyword.control.directive", "meta.preprocessor"],
            "settings": { "foreground": "#1976d2" }
        },
        {
            "name": "C/C++ - Pointer",
            "scope": ["keyword.operator.pointer", "keyword.operator.address"],
            "settings": { "foreground": "#c2185b" }
        },
        {
            "name": "Rust - Lifetime",
            "scope": [
                "entity.name.type.lifetime.rust",
                "punctuation.definition.lifetime.rust"
            ],
            "settings": { "foreground": "#f57c00" }
        },
        {
            "name": "Rust - Macro",
            "scope": [
                "entity.name.function.macro.rust",
                "punctuation.definition.macro.rust"
            ],
            "settings": { "foreground": "#1976d2" }
        },
        {
            "name": "Go - Package",
            "scope": ["entity.name.package.go"],
            "settings": { "foreground": "#388e3c" }
        },
        {
            "name": "PHP - Variable",
            "scope": [
                "punctuation.definition.variable.php",
                "variable.other.php"
            ],
            "settings": { "foreground": "#1a0d1a" }
        },
        {
            "name": "PHP - Namespace",
            "scope": ["entity.name.type.namespace.php"],
            "settings": { "foreground": "#388e3c" }
        },
        {
            "name": "HTML - Tag",
            "scope": ["entity.name.tag.html", "punctuation.definition.tag"],
            "settings": { "foreground": "#6a1b9a" }
        },
        {
            "name": "HTML - Attribute",
            "scope": ["entity.other.attribute-name.html"],
            "settings": { "foreground": "#f57c00" }
        },
        {
            "name": "HTML - Attribute Value",
            "scope": ["string.quoted.double.html", "string.quoted.single.html"],
            "settings": { "foreground": "#388e3c" }
        },
        {
            "name": "CSS - Property",
            "scope": ["support.type.property-name.css"],
            "settings": { "foreground": "#1976d2" }
        },
        {
            "name": "CSS - Value",
            "scope": [
                "support.constant.property-value.css",
                "constant.numeric.css"
            ],
            "settings": { "foreground": "#388e3c" }
        },
        {
            "name": "CSS - Selector",
            "scope": [
                "entity.name.tag.css",
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css"
            ],
            "settings": { "foreground": "#f57c00" }
        },
        {
            "name": "CSS - Units",
            "scope": ["keyword.other.unit.css"],
            "settings": { "foreground": "#f57c00" }
        },
        {
            "name": "JSON - Key Level 0",
            "scope": [
                "source.json meta.structure.dictionary.json support.type.property-name.json"
            ],
            "settings": { "foreground": "#6a1b9a", "fontStyle": "bold" }
        },
        {
            "name": "JSON - Key Level 1",
            "scope": [
                "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
            ],
            "settings": { "foreground": "#8e24aa", "fontStyle": "bold" }
        },
        {
            "name": "JSON - Key Level 2",
            "scope": [
                "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
            ],
            "settings": { "foreground": "#9575cd", "fontStyle": "bold" }
        },
        {
            "name": "JSON - Punctuation",
            "scope": [
                "punctuation.support.type.property-name.begin.json",
                "punctuation.support.type.property-name.end.json",
                "punctuation.separator.dictionary.key-value.json",
                "punctuation.separator.array.json"
            ],
            "settings": { "foreground": "#9575cd" }
        },
        {
            "name": "JSON - String Value",
            "scope": ["string.quoted.double.json", "string.quoted.single.json"],
            "settings": { "foreground": "#388e3c" }
        },
        {
            "name": "JSON - Number Value",
            "scope": ["constant.numeric.json"],
            "settings": { "foreground": "#f57c00" }
        },
        {
            "name": "JSON - Boolean Value",
            "scope": ["constant.language.json"],
            "settings": { "foreground": "#c2185b", "fontStyle": "bold" }
        },
        {
            "name": "JSON - Null Value",
            "scope": ["constant.language.null.json"],
            "settings": { "foreground": "#f44336", "fontStyle": "bold" }
        },
        {
            "name": "YAML - Key",
            "scope": ["entity.name.tag.yaml"],
            "settings": { "foreground": "#6a1b9a" }
        },
        {
            "name": "YAML - Value",
            "scope": ["string.unquoted.plain.out.yaml"],
            "settings": { "foreground": "#388e3c" }
        },
        {
            "name": "Markdown - Heading",
            "scope": [
                "markup.heading",
                "punctuation.definition.heading.markdown"
            ],
            "settings": { "foreground": "#6a1b9a", "fontStyle": "bold" }
        },
        {
            "name": "Markdown - Bold",
            "scope": ["markup.bold"],
            "settings": { "foreground": "#f57c00", "fontStyle": "bold" }
        },
        {
            "name": "Markdown - Italic",
            "scope": ["markup.italic"],
            "settings": { "foreground": "#1976d2", "fontStyle": "italic" }
        },
        {
            "name": "Markdown - Code",
            "scope": [
