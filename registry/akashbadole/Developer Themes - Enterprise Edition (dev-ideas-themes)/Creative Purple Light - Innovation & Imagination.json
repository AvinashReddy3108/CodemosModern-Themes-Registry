            "settings": { "foreground": "#388e3c" }
        },
        {
            "name": "Markdown - Quote",
            "scope": ["markup.quote.markdown"],
            "settings": { "foreground": "#388e3c", "fontStyle": "italic" }
        },
        {
            "name": "SQL - Keyword",
            "scope": ["keyword.other.sql"],
            "settings": { "foreground": "#6a1b9a", "fontStyle": "bold" }
        },
        {
            "name": "SQL - Function",
            "scope": ["support.function.sql"],
            "settings": { "foreground": "#6a1b9a" }
