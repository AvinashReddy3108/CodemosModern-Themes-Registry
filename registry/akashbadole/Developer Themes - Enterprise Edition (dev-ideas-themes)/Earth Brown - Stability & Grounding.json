{
    "name": "Earth Brown - Stability & Grounding",
    "type": "dark",
    "colors": {
        "editor.background": "#1a1410",
        "editor.foreground": "#efebe9",
        "editorCursor.foreground": "#8d6e63",
        "editor.lineHighlightBackground": "#3e27230A",
        "editor.selectionBackground": "#5d4e4160",
        "editor.selectionHighlightBackground": "#5d4e4120",
        "editor.findMatchBackground": "#ffeb3b40",
        "editor.findMatchHighlightBackground": "#ffeb3b20",
        "editor.wordHighlightBackground": "#79554830",
        "editor.wordHighlightStrongBackground": "#79554850",
        "editorIndentGuide.background": "#3e272330",
        "editorIndentGuide.activeBackground": "#a1887f",
        "editorLineNumber.foreground": "#5d4e41",
        "editorLineNumber.activeForeground": "#d7ccc8",
        "editorGutter.background": "#1a1410",
        "editorGutter.modifiedBackground": "#ffeb3b",
        "editorGutter.addedBackground": "#4caf50",
        "editorGutter.deletedBackground": "#f44336",
        "editorBracketMatch.background": "#5d4e4140",
        "editorBracketMatch.border": "#a1887f",
        "editorBracketHighlight.foreground1": "#ff6b9d",
        "editorBracketHighlight.foreground2": "#4fc3f7",
        "editorBracketHighlight.foreground3": "#81c784",
        "editorBracketHighlight.foreground4": "#ffb74d",
        "editorBracketHighlight.foreground5": "#ba68c8",
        "editorBracketHighlight.foreground6": "#26a69a",
        "activityBar.background": "#2e1e14",
        "activityBar.foreground": "#d7ccc8",
        "activityBarBadge.background": "#795548",
        "activityBarBadge.foreground": "#eeeeee",
        "sideBar.background": "#332218",
        "sideBar.foreground": "#d7ccc8",
        "sideBarTitle.foreground": "#a1887f",
        "statusBar.background": "#5d4e41",
        "statusBar.foreground": "#eeeeee",
        "statusBar.debuggingBackground": "#f44336",
        "tab.activeBackground": "#1a1410",
        "tab.activeForeground": "#efebe9",
        "tab.inactiveBackground": "#332218",
        "tab.activeBorder": "#a1887f",
        "terminal.background": "#2a2420",
        "terminal.foreground": "#f5f1ee",
        "terminal.ansiBlack": "#263238",
        "terminal.ansiRed": "#f44336",
        "terminal.ansiGreen": "#4caf50",
        "terminal.ansiYellow": "#ffeb3b",
        "terminal.ansiBlue": "#2196f3",
        "terminal.ansiMagenta": "#e91e63",
        "terminal.ansiCyan": "#00bcd4",
        "terminal.ansiWhite": "#eceff1",
        "terminal.ansiBrightBlack": "#37474f",
        "terminal.ansiBrightRed": "#ff5252",
        "terminal.ansiBrightGreen": "#69f0ae",
        "terminal.ansiBrightYellow": "#ffff00",
        "terminal.ansiBrightBlue": "#448aff",
        "terminal.ansiBrightMagenta": "#ff4081",
        "terminal.ansiBrightCyan": "#18ffff",
        "terminal.ansiBrightWhite": "#ffffff"
    },
    "tokenColors": [
        {
            "name": "Comment",
            "scope": [
                "comment",
                "punctuation.definition.comment",
                "comment.line",
                "comment.block"
            ],
            "settings": { "fontStyle": "italic", "foreground": "#5d4e41" }
        },
        {
            "name": "Comment Documentation",
            "scope": [
                "comment.block.documentation",
                "comment.line.documentation"
            ],
            "settings": { "fontStyle": "italic", "foreground": "#81c784" }
        },
        {
            "name": "Keyword",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.new",
                "keyword.other.using",
                "keyword.other.import"
            ],
            "settings": { "foreground": "#a1887f", "fontStyle": "bold" }
        },
        {
            "name": "Control Flow Keywords",
            "scope": [
                "keyword.control.flow",
                "keyword.control.conditional",
                "keyword.control.loop",
                "keyword.control.exception",
                "keyword.control.trycatch"
            ],
            "settings": { "foreground": "#ff6b9d", "fontStyle": "bold" }
        },
        {
            "name": "Storage Type",
            "scope": [
                "storage.type",
                "storage.modifier",
                "storage.type.class",
                "storage.type.function",
                "storage.type.interface"
            ],
            "settings": { "foreground": "#4fc3f7", "fontStyle": "bold" }
        },
        {
            "name": "Operator",
            "scope": [
                "keyword.operator",
                "keyword.operator.arithmetic",
                "keyword.operator.comparison",
                "keyword.operator.logical",
                "keyword.operator.assignment"
            ],
            "settings": { "foreground": "#bcaaa4" }
        },
        {
            "name": "Operator Word",
            "scope": [
                "keyword.operator.word",
                "keyword.operator.typeof",
                "keyword.operator.instanceof"
            ],
            "settings": { "foreground": "#ff6b9d" }
        },
        {
            "name": "Variable",
            "scope": [
                "variable",
                "variable.other",
                "variable.language.this",
                "variable.language.super"
            ],
            "settings": { "foreground": "#efebe9" }
        },
        {
            "name": "Variable Property",
            "scope": [
                "variable.other.property",
                "variable.other.object.property",
                "variable.other.member"
            ],
            "settings": { "foreground": "#81c784" }
        },
        {
            "name": "Variable Parameter",
            "scope": ["variable.parameter", "variable.parameter.function"],
            "settings": { "foreground": "#ffb74d", "fontStyle": "italic" }
        },
        {
            "name": "Function Name",
            "scope": [
                "entity.name.function",
                "entity.name.method",
                "meta.function-call entity.name.function",
                "support.function"
            ],
            "settings": { "foreground": "#bcaaa4" }
        },
        {
            "name": "Function Declaration",
            "scope": [
                "meta.function entity.name.function",
                "meta.method entity.name.function"
            ],
            "settings": { "foreground": "#8d6e63", "fontStyle": "bold" }
        },
        {
            "name": "Built-in Functions",
            "scope": ["support.function.builtin", "support.function.magic"],
            "settings": { "foreground": "#26a69a" }
        },
        {
            "name": "Class Name",
            "scope": [
                "entity.name.class",
                "entity.name.type.class",
                "entity.other.inherited-class"
            ],
            "settings": { "foreground": "#ffb74d", "fontStyle": "bold" }
        },
        {
            "name": "Interface Name",
            "scope": ["entity.name.interface", "entity.name.type.interface"],
            "settings": { "foreground": "#4fc3f7", "fontStyle": "bold" }
        },
        {
            "name": "Type Annotation",
            "scope": [
                "entity.name.type",
                "support.type",
                "meta.type.annotation"
            ],
            "settings": { "foreground": "#bcaaa4" }
        },
        {
            "name": "String",
            "scope": [
                "string",
                "string.quoted",
                "string.quoted.single",
                "string.quoted.double"
            ],
            "settings": { "foreground": "#81c784" }
        },
        {
            "name": "Template String",
            "scope": ["string.template", "string.quoted.template"],
            "settings": { "foreground": "#a5d6a7" }
        },
        {
            "name": "String Interpolation",
            "scope": ["string.interpolated", "meta.template.expression"],
            "settings": { "foreground": "#4fc3f7" }
        },
        {
            "name": "Regex",
            "scope": ["string.regexp", "string.regex"],
            "settings": { "foreground": "#ff9800" }
        },
        {
            "name": "Number",
            "scope": [
                "constant.numeric",
                "constant.numeric.integer",
                "constant.numeric.float",
                "constant.numeric.decimal",
                "constant.numeric.hex",
                "constant.numeric.binary",
                "constant.numeric.octal"
            ],
            "settings": { "foreground": "#ffb74d" }
        },
        {
            "name": "Boolean",
            "scope": [
                "constant.language.boolean",
                "constant.language.true",
                "constant.language.false"
            ],
            "settings": { "foreground": "#ff6b9d", "fontStyle": "bold" }
        },
        {
            "name": "Null/Undefined",
            "scope": [
                "constant.language.null",
                "constant.language.undefined",
                "constant.language.none"
            ],
            "settings": { "foreground": "#f44336", "fontStyle": "bold" }
        },
        {
            "name": "Constant",
            "scope": ["constant.other", "variable.other.constant"],
            "settings": { "foreground": "#ffb74d", "fontStyle": "italic" }
        },
        {
            "name": "JS/TS - Import/Export",
            "scope": [
                "keyword.control.import",
                "keyword.control.export",
                "keyword.control.from",
                "keyword.control.as"
            ],
            "settings": { "foreground": "#4fc3f7" }
        },
        {
            "name": "JS/TS - Async/Await",
            "scope": [
                "keyword.control.flow.async",
                "keyword.control.flow.await"
            ],
            "settings": { "foreground": "#ff6b9d", "fontStyle": "italic" }
        },
        {
            "name": "JS/TS - Destructuring",
            "scope": [
                "meta.object-binding-pattern-variable entity.name.binding",
                "meta.array-binding-pattern-variable entity.name.binding"
            ],
            "settings": { "foreground": "#81c784" }
        },
        {
            "name": "Python - Self/Cls",
            "scope": [
                "variable.language.special.self.python",
                "variable.language.special.cls.python"
            ],
            "settings": { "foreground": "#4fc3f7", "fontStyle": "italic" }
        },
        {
            "name": "Python - Magic Methods",
            "scope": ["support.function.magic.python"],
            "settings": { "foreground": "#ff9800" }
        },
        {
            "name": "Python - Decorators",
            "scope": [
                "entity.name.function.decorator.python",
                "punctuation.definition.decorator.python"
            ],
            "settings": { "foreground": "#ffb74d" }
        },
        {
            "name": "Java/C# - Annotations",
            "scope": [
                "punctuation.definition.annotation",
                "storage.type.annotation"
            ],
            "settings": { "foreground": "#ffb74d" }
        },
        {
            "name": "Java/C# - Generics",
            "scope": [
                "punctuation.definition.typeparameters",
                "entity.name.type.parameter"
            ],
            "settings": { "foreground": "#4fc3f7" }
        },
        {
            "name": "C/C++ - Preprocessor",
            "scope": ["keyword.control.directive", "meta.preprocessor"],
            "settings": { "foreground": "#4fc3f7" }
        },
        {
            "name": "C/C++ - Pointer",
            "scope": ["keyword.operator.pointer", "keyword.operator.address"],
            "settings": { "foreground": "#ff6b9d" }
        },
        {
            "name": "Rust - Lifetime",
            "scope": [
                "entity.name.type.lifetime.rust",
                "punctuation.definition.lifetime.rust"
            ],
            "settings": { "foreground": "#ff9800" }
        },
        {
            "name": "Rust - Macro",
            "scope": [
                "entity.name.function.macro.rust",
                "punctuation.definition.macro.rust"
            ],
            "settings": { "foreground": "#4fc3f7" }
        },
        {
            "name": "Go - Package",
            "scope": ["entity.name.package.go"],
            "settings": { "foreground": "#81c784" }
        },
        {
            "name": "PHP - Variable",
            "scope": [
                "punctuation.definition.variable.php",
                "variable.other.php"
            ],
            "settings": { "foreground": "#efebe9" }
        },
        {
            "name": "PHP - Namespace",
            "scope": ["entity.name.type.namespace.php"],
            "settings": { "foreground": "#81c784" }
        },
        {
            "name": "HTML - Tag",
            "scope": ["entity.name.tag.html", "punctuation.definition.tag"],
            "settings": { "foreground": "#a1887f" }
        },
        {
            "name": "HTML - Attribute",
            "scope": ["entity.other.attribute-name.html"],
            "settings": { "foreground": "#ffb74d" }
        },
        {
            "name": "HTML - Attribute Value",
            "scope": ["string.quoted.double.html", "string.quoted.single.html"],
            "settings": { "foreground": "#81c784" }
        },
        {
            "name": "CSS - Property",
            "scope": ["support.type.property-name.css"],
            "settings": { "foreground": "#4fc3f7" }
        },
        {
            "name": "CSS - Value",
            "scope": [
                "support.constant.property-value.css",
                "constant.numeric.css"
            ],
            "settings": { "foreground": "#81c784" }
        },
        {
            "name": "CSS - Selector",
            "scope": [
                "entity.name.tag.css",
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css"
            ],
            "settings": { "foreground": "#ffb74d" }
        },
        {
            "name": "CSS - Units",
            "scope": ["keyword.other.unit.css"],
            "settings": { "foreground": "#ff9800" }
        },
        {
            "name": "JSON - Key Level 0",
            "scope": [
                "source.json meta.structure.dictionary.json support.type.property-name.json"
            ],
            "settings": { "foreground": "#eeeeee" }
        },
        {
            "name": "JSON - Key Level 1",
            "scope": [
                "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
            ],
            "settings": { "foreground": "#eeeeee" }
        },
        {
            "name": "JSON - Key Level 2",
            "scope": [
                "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
            ],
            "settings": { "foreground": "#eeeeee" }
        },
        {
            "name": "YAML - Key",
            "scope": ["entity.name.tag.yaml"],
            "settings": { "foreground": "#a1887f" }
        },
        {
            "name": "YAML - Value",
            "scope": ["string.unquoted.plain.out.yaml"],
            "settings": { "foreground": "#81c784" }
        },
        {
            "name": "Markdown - Heading",
            "scope": [
                "markup.heading",
                "punctuation.definition.heading.markdown"
            ],
            "settings": { "foreground": "#a1887f", "fontStyle": "bold" }
        },
        {
            "name": "Markdown - Bold",
            "scope": ["markup.bold"],
            "settings": { "foreground": "#ffb74d", "fontStyle": "bold" }
        },
        {
            "name": "Markdown - Italic",
            "scope": ["markup.italic"],
            "settings": { "foreground": "#eeeeee", "fontStyle": "italic" }
        },
        {
            "name": "Markdown - Code",
            "scope": [
                "markup.inline.raw.markdown",
                "markup.fenced_code.block.markdown"
            ],
            "settings": { "foreground": "#26a69a" }
        },
        {
            "name": "Markdown - Link",
            "scope": ["markup.underline.link.markdown"],
            "settings": { "foreground": "#4fc3f7" }
        },
        {
            "name": "Markdown - Quote",
            "scope": ["markup.quote.markdown"],
            "settings": { "foreground": "#81c784", "fontStyle": "italic" }
        },
        {
            "name": "SQL - Keyword",
            "scope": ["keyword.other.sql"],
            "settings": { "foreground": "#a1887f", "fontStyle": "bold" }
        },
        {
            "name": "SQL - Function",
            "scope": ["support.function.sql"],
            "settings": { "foreground": "#bcaaa4" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation",
                "punctuation.separator",
                "punctuation.terminator"
            ],
            "settings": { "foreground": "#d7ccc8" }
        },
        {
            "name": "Brackets",
            "scope": [
                "punctuation.section.brackets",
                "punctuation.section.parens",
                "punctuation.section.braces"
            ],
            "settings": { "foreground": "#a1887f" }
        },
        {
            "name": "GraphQL Operation",
            "scope": [
                "source.graphql keyword.operation",
                "source.graphql meta.type.interface"
            ],
            "settings": { "foreground": "#26c6da", "fontStyle": "bold" }
        },
        {
            "name": "GraphQL Fields",
            "scope": [
                "source.graphql variable.graphql",
                "source.graphql meta.selection-set"
            ],
            "settings": { "foreground": "#80cbc4" }
        },
        {
            "name": "Docker Keywords",
            "scope": [
                "keyword.other.special-method.dockerfile",
                "source.dockerfile keyword.operator.flag"
            ],
            "settings": { "foreground": "#f48fb1", "fontStyle": "bold" }
        },
        {
            "name": "YAML Anchors and Aliases",
            "scope": [
                "entity.name.type.anchor.yaml",
                "variable.other.alias.yaml"
            ],
            "settings": { "foreground": "#b39ddb", "fontStyle": "italic" }
        },
        {
            "name": "Shell Variables",
            "scope": [
                "variable.other.special.shell",
                "variable.other.positional.shell",
                "variable.other.normal.shell"
            ],
            "settings": { "foreground": "#ce93d8" }
        },
        {
            "name": "TypeScript Decorators",
            "scope": [
                "meta.decorator.ts entity.name.function",
                "meta.decorator.tsx entity.name.function"
            ],
            "settings": { "foreground": "#dce775", "fontStyle": "italic" }
        },
        {
            "name": "JSDoc Tags",
            "scope": [
                "comment.block.documentation storage.type.class.jsdoc",
                "comment.block.documentation punctuation.definition.block.tag.jsdoc"
            ],
            "settings": { "foreground": "#aed581", "fontStyle": "bold" }
        },
        {
            "name": "Git Modified",
            "scope": ["markup.changed", "meta.diff.header.git"],
            "settings": { "foreground": "#fff176" }
        },
        {
            "name": "Python Decorators",
            "scope": [
                "meta.decorator.python",
                "meta.decorator.identifier.python"
            ],
            "settings": { "foreground": "#ffb74d", "fontStyle": "italic" }
        },
        {
            "name": "Rust Attributes",
            "scope": ["meta.attribute.rust", "meta.attribute.identifier.rust"],
            "settings": { "foreground": "#ff9800", "fontStyle": "italic" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
