{
    "name": "Parkour!",
    "type": "dark",
    "colors": {
        "editor.background": "#171d24",
        "editor.foreground": "#e7e7e7",
        "sideBar.background": "#171d24",
        "activityBar.background": "#171d24",
        "statusBar.background": "#171d24",
        "activityBarBadge.background": "#2fa34f",
        "sideBarTitle.foreground": "#bbbbbb",
        "titleBar.activeBackground": "#171d24",
        "titleBar.inactiveBackground": "#171d24",
        "editorGroupHeader.tabsBackground": "#171d24",
        "tab.activeForeground": "#fff",
        "tab.inactiveForeground": "#fff9",
        "tab.activeBackground": "#171d24",
        "tab.inactiveBackground": "#171d24",
        "tab.border": "#0000",
        "tab.activeBorder": "#2fa34f",
        "widget.shadow": "#0002",
        "editorGroupHeader.noTabsBackground": "#171d24",
        "editorLineNumber.foreground": "#ffffff36",
        "editorLineNumber.activeForeground": "#ff0000",
        "editor.lineHighlightBackground": "#fff1",
        "editor.lineHighlightBorder": "#0000",
        "editorBracketMatch.border": "#f1f58c",
        "editorHoverWidget.background": "#171d24",
        "editorHoverWidget.border": "#fff1",
        "editorSuggestWidget.background": "#171d24",
        "editorSuggestWidget.border": "#fff1",
        "editorSuggestWidget.highlightForeground": "#f1f58c",
        "editorSuggestWidget.selectedBackground": "#fff1",
        "list.hoverBackground": "#fff1",
        "editor.selectionBackground": "#ffffff18",
        "editor.wordHighlightBackground": "#f1f58c1a"
    },
    "tokenColors": [
        {
            "scope": ["source", "variable"],
            "settings": { "foreground": "#cacaca" }
        },
        {
            "scope": [
                "punctuation.definition.block",
                "punctuation.terminator",
                "meta.brace",
                "punctuation.definition",
                "punctuation.separator",
                "punctuation.destructuring",
                "punctuation.accessor",
                "keyword.operator"
            ],
            "settings": { "foreground": "#65657c" }
        },
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#4f4f5f", "fontStyle": "italic" }
        },
        {
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#ff8080" }
        },
        {
            "scope": [
                "keyword.control",
                "storage.type",
                "keyword.operator.new",
                "storage.modifier",
                "keyword.operator.expression"
            ],
            "settings": { "foreground": "#8a7dc7", "fontStyle": "italic" }
        },
        {
            "scope": [
                "variable.parameter",
                "meta.parameters entity.name.function",
                "support.constant"
            ],
            "settings": { "foreground": "#ff67cf" }
        },
        {
            "scope": [
                "keyword.operator.arithmetic",
                "keyword.operator.assignment",
                "storage.type.function.arrow",
                "keyword.operator.comparison",
                "keyword.operator.logical",
                "keyword.operator.ternary"
            ],
            "settings": { "foreground": "#d8a1ff" }
        },
        {
            "scope": ["string", "punctuation.definition.string"],
            "settings": { "foreground": "#8cf5a9" }
        },
        {
            "scope": [
                "entity.name.function",
                "entity.name.tag",
                "support.function"
            ],
            "settings": { "foreground": "#ffb34f" }
        },
        {
            "scope": ["support.type", "entity.other.attribute-name"],
            "settings": { "foreground": "#cee450", "fontStyle": "italic" }
        },
        {
            "scope": [
                "entity.name.type",
                "entity.other.inherited-class",
                "support.class",
                "entity.other.attribute-name.id"
            ],
            "settings": { "foreground": "#40e2da" }
        },
        {
            "scope": ["variable.language", "entity.other.attribute-name.class"],
            "settings": { "foreground": "#fd4c55", "fontStyle": "italic" }
        },
        {
            "scope": ["constant.language"],
            "settings": { "foreground": "#e23cda", "fontStyle": "italic" }
        },
        {
            "scope": [
                "variable.other.property",
                "meta.object-literal.key",
                "support.variable.property"
            ],
            "settings": { "foreground": "#8599FF" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
