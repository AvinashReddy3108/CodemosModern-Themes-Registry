{
    "name": "Monokia Darker Soda",
    "type": "dark",
    "$schema": "vscode://schemas/color-theme",
    "colors": {
        "focusBorder": "#181a1f",
        "input.background": "#1d1f23",
        "dropdown.background": "#1d1f23",
        "dropdown.border": "#181a1f",
        "list.focusBackground": "#383e4a",
        "list.activeSelectionBackground": "#121212",
        "list.activeSelectionForeground": "#d7dae0",
        "list.inactiveSelectionBackground": "#121212",
        "list.inactiveSelectionForeground": "#d7dae0",
        "list.hoverBackground": "#121212",
        "list.highlightForeground": "#c5c5c5",
        "button.background": "#528bff",
        "scrollbarSlider.background": "#4e566680",
        "scrollbarSlider.hoverBackground": "#5a637580",
        "scrollbarSlider.activeBackground": "#747d9180",
        "editor.background": "#121212",
        "editor.foreground": "#f8f8f2",
        "editorWidget.background": "#181a1f",
        "editor.selectionBackground": "#3e4451",
        "editor.findMatchHighlightBackground": "#31436580",
        "editorHoverWidget.background": "#181a1f",
        "editorHoverWidget.border": "#181a1f",
        "diffEditor.insertedTextBackground": "#00809b33",
        "editor.lineHighlightBackground": "#1d1f23",
        "editorCursor.foreground": "#f8f8f0",
        "editorWhitespace.foreground": "#484a50",
        "editorIndentGuide.background1": "#3b4048",
        "editorLineNumber.foreground": "#495162",
        "editorRuler.foreground": "#484848",
        "editorError.foreground": "#704040",
        "editorWarning.foreground": "#407040",
        "editorInfo.foreground": "#707040",
        "editorSuggestWidget.background": "#181a1f",
        "editorSuggestWidget.border": "#181a1f",
        "editorSuggestWidget.selectedBackground": "#2c313a",
        "peekView.border": "#202020",
        "peekViewEditor.background": "#202020",
        "tab.activeBackground": "#121212",
        "tab.inactiveBackground": "#181a1f",
        "tab.border": "#181a1f",
        "editorGroupHeader.tabsBackground": "#181a1f",
        "editorGroup.border": "#181a1f",
        "statusBar.foreground": "#9da5b4",
        "statusBar.background": "#020202",
        "statusBar.noFolderBackground": "#020202",
        "statusBarItem.hoverBackground": "#6671826d",
        "statusBar.debuggingBackground": "#012925",
        "activityBar.background": "#1d1f23",
        "activityBar.foreground": "#d7dae0",
        "activityBarBadge.background": "#528bff",
        "activityBarBadge.foreground": "#f8fafd",
        "sideBar.background": "#181a1f",
        "sideBar.border": "#1d1f23",
        "sideBarSectionHeader.background": "#181a1f",
        "titleBar.activeForeground": "#9da5b4",
        "titleBar.inactiveForeground": "#6b717d",
        "titleBar.activeBackground": "#020202",
        "titleBar.inactiveBackground": "#020202"
    },
    "tokenColors": [
        {
            "scope": "comment, punctuation.definition.comment",
            "settings": { "foreground": "#8C8C8C", "fontStyle": "italic" }
        },
        { "scope": "string", "settings": { "foreground": "#FFEE99" } },
        {
            "scope": "constant.numeric",
            "settings": { "foreground": "#FF80F4" }
        },
        {
            "scope": "constant.language",
            "settings": { "foreground": "#FF80F4" }
        },
        {
            "scope": "constant.character, constant.other",
            "settings": { "foreground": "#FF80F4" }
        },
        { "scope": "variable", "settings": { "fontStyle": "" } },
        { "scope": "keyword", "settings": { "foreground": "#F92672" } },
        {
            "scope": "storage",
            "settings": { "foreground": "#F92672", "fontStyle": "" }
        },
        {
            "scope": "storage.type",
            "settings": { "foreground": "#66D9EF", "fontStyle": "italic" }
        },
        {
            "scope": "entity.name.class",
            "settings": { "foreground": "#A6E22E", "fontStyle": "underline" }
        },
        {
            "scope": "entity.other.inherited-class",
            "settings": {
                "foreground": "#A6E22E",
                "fontStyle": "italic underline"
            }
        },
        {
            "scope": "entity.name.function",
            "settings": { "foreground": "#A6E22E", "fontStyle": "" }
        },
        {
            "scope": "entity.name.function.operator",
            "settings": { "foreground": "#F92672" }
        },
        {
            "scope": "variable.parameter",
            "settings": { "foreground": "#FD971F", "fontStyle": "italic" }
        },
        {
            "scope": "entity.name.tag",
            "settings": { "foreground": "#F92672", "fontStyle": "" }
        },
        {
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#A6E22E", "fontStyle": "" }
        },
        {
            "scope": "support.function",
            "settings": { "foreground": "#66D9EF", "fontStyle": "" }
        },
        {
            "scope": "support.constant",
            "settings": { "foreground": "#66D9EF", "fontStyle": "" }
        },
        {
            "scope": "support.type, support.class",
            "settings": { "foreground": "#66D9EF", "fontStyle": "italic" }
        },
        { "scope": "support.other.variable", "settings": { "fontStyle": "" } },
        {
            "scope": "support.other.namespace, entity.name.type.namespace",
            "settings": { "foreground": "#FFB2F9" }
        },
        {
            "scope": "support.other.namespace.use-as.php",
            "settings": { "foreground": "#66D9EF" }
        },
        {
            "scope": "variable.language.namespace.php",
            "settings": { "foreground": "#D66990" }
        },
        {
            "scope": "punctuation.separator.inheritance.php",
            "settings": { "foreground": "#F92672" }
        },
        {
            "scope": "support.function.misc.css, support.constant.property-value.css, support.constant.font-name.css",
            "settings": { "foreground": "#FFEE99" }
        },
        {
            "scope": "meta.tag.template.value.twig, meta.tag.template.block.twig",
            "settings": { "foreground": "#CD5AC5" }
        },
        {
            "scope": "keyword.control.twig",
            "settings": { "foreground": "#E05D8C" }
        },
        {
            "scope": "variable.other.twig",
            "settings": { "foreground": "#E5A5E0" }
        },
        {
            "scope": "variable.other.property.twig",
            "settings": { "foreground": "#FFE1FC" }
        },
        {
            "scope": "constant.language.twig",
            "settings": { "foreground": "#FFD2A6" }
        },
        {
            "scope": "constant.numeric.twig",
            "settings": { "foreground": "#FFD0FB" }
        },
        {
            "scope": "support.function.twig",
            "settings": { "foreground": "#90E7F7" }
        },
        {
            "scope": "meta.function-call.other.twig",
            "settings": { "foreground": "#FAB85A" }
        },
        {
            "scope": "meta.function-call.twig",
            "settings": { "foreground": "#FAB85A" }
        },
        {
            "scope": "invalid",
            "settings": { "foreground": "#F8F8F0", "fontStyle": "" }
        },
        {
            "scope": "invalid.deprecated",
            "settings": { "foreground": "#F8F8F0" }
        },
        { "scope": "text source", "settings": {} },
        {
            "scope": "meta.diff, meta.diff.header",
            "settings": { "foreground": "#E0EDDD", "fontStyle": "bold" }
        },
        {
            "scope": "markup.deleted",
            "settings": { "foreground": "#D3201F", "fontStyle": "" }
        },
        {
            "scope": "markup.changed",
            "settings": { "foreground": "#BF3904", "fontStyle": "" }
        },
        { "scope": "markup.inserted", "settings": { "foreground": "#60CF30" } },
        {
            "scope": "meta.diff, meta.diff.range",
            "settings": { "foreground": "#3BC0F0" }
        },
        {
            "scope": "markup.heading.markdown, markup.heading.1.markdown, markup.heading.2.markdown",
            "settings": { "foreground": "#A6E22E" }
        },
        {
            "scope": "markup.bold.markdown",
            "settings": { "foreground": "#F8F8F2", "fontStyle": "bold" }
        },
        {
            "scope": "markup.italic.markdown",
            "settings": { "foreground": "#F8F8F2", "fontStyle": "italic" }
        },
        {
            "scope": "punctuation.definition.bold.markdown, punctuation.definition.italic.markdown, punctuation.definition.raw.markdown",
            "settings": { "foreground": "#D3201F" }
        },
        {
            "scope": "markup.list.unnumbered.markdown",
            "settings": { "foreground": "#FF80F4" }
        },
        {
            "scope": "markup.list.numbered.markdown",
            "settings": { "foreground": "#FF80F4" }
        },
        {
            "scope": "markup.raw.block.markdown, markup.raw.inline.markdown",
            "settings": { "foreground": "#FFEE99" }
        },
        {
            "scope": "markup.quote.markdown, punctuation.definition.blockquote.markdown",
            "settings": { "foreground": "#6C71C4" }
        },
        {
            "scope": "meta.separator.markdown",
            "settings": { "foreground": "#FF80F4" }
        },
        {
            "scope": "meta.image.inline.markdown, markup.underline.link.markdown",
            "settings": { "foreground": "#8C8C8C", "fontStyle": "italic" }
        },
        {
            "scope": "string.other.link.title.markdown, string.other.link.description.markdown",
            "settings": { "foreground": "#A6E22E" }
        },
        {
            "scope": "punctuation.definition.link.markdown",
            "settings": { "foreground": "#8C8C8C" }
        },
        {
            "scope": "punctuation.definition.metadata.markdown",
            "settings": { "foreground": "#8C8C8C" }
        },
        {
            "scope": "punctuation.definition.string.begin.markdown, punctuation.definition.string.end.markdown, punctuation.definition.constant.markdown",
            "settings": { "foreground": "#8C8C8C" }
        },
        {
            "scope": "punctuation.definition.template-expression, punctuation.section.embedded",
            "settings": { "foreground": "#F92672" }
        },
        {
            "scope": "meta.template.expression",
            "settings": { "foreground": "#F8F8F2" }
        },
        {
            "scope": "token.info-token",
            "settings": { "foreground": "#6796E6" }
        },
        {
            "scope": "token.warn-token",
            "settings": { "foreground": "#CD9731" }
        },
        {
            "scope": "token.error-token",
            "settings": { "foreground": "#F44747" }
        },
        {
            "scope": "token.debug-token",
            "settings": { "foreground": "#B267E6" }
        }
    ]
}
