    "tokenColors": [
        {
            "scope": [
                "constant.numeric",
                "variable.other.enummember",
                "keyword.operator.plus.exponent",
                "keyword.operator.minus.exponent",
                "string.json.comments"
            ],
            "settings": { "foreground": "#2682d5" }
        },
        { "scope": ["comment"], "settings": { "foreground": "#808080" } },
        {
            "scope": "string.quoted.docstring.multi",
            "settings": { "foreground": "#447919" }
        },
        {
            "scope": [
                "punctuation.definition.decorator",
                "punctuation.definition.annotation",
                "entity.name.function.decorator.python",
                "storage.type.annotation.java"
            ],
            "settings": { "foreground": "#99684c" }
        },
        {
            "scope": [
                "storage.type",
                "variable.language",
                "keyword.control",
                "keyword.operator.logical",
                "keyword.other",
                "storage.modifier",
                "support.function",
                "constant.language.python",
                "variable.parameter.function.language.special.self.python",
                "constant.language.json"
            ],
            "settings": { "foreground": "#a4258f" }
        },
        {
            "scope": "keyword.other.unit",
            "settings": { "foreground": "#99684c" }
        },
        {
            "scope": [
                "source.groovy.embedded",
                "string meta.image.inline.markdown",
                "source.python",
                "meta.function",
                "meta.funcion-call"
            ],
            "settings": { "foreground": "#000000" }
        },
        {
            "scope": [
                "string",
                "constant.other.set.regexp",
                "constant.character.set.regexp",
                "meta.fstring",
                "meta.fstring.python",
                "storage.type.string"
            ],
            "settings": { "foreground": "#ce5149" }
        },
        {
            "scope": [
                "entity.name.method",
                "support.constant.handlebars",
                "source.powershell variable.other.member",
                "entity.name.function",
                "entity.name.operator.custom-literal",
                "meta.function-call.generic",
                "meta.class.python",
                "support.function.magic.python",
                "support.function.builtin.python",
                "support.type.python"
            ],
            "settings": { "foreground": "#21767e" }
        },
        {
            "scope": [
                "entity.name.function.python",
                "support.function.magic.python",
                "entity.name.type.class.python"
            ],
            "settings": { "foreground": "#21767e", "fontStyle": "bold" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
