    "tokenColors": [
        {
            "scope": ["comment", "comment.line", "comment.block"],
            "settings": { "foreground": "#9198A1" }
        },
        {
            "scope": ["string.quoted.docstring", "comment.block.documentation"],
            "settings": { "foreground": "#A5D6FF" }
        },
        { "scope": [], "settings": { "foreground": "#CBAAF9" } },
        {
            "scope": [
                "keyword.control",
                "storage.type",
                "storage.modifier",
                "keyword.other",
                "keyword.import"
            ],
            "settings": { "foreground": "#FF7B72" }
        },
        {
            "scope": [
                "string",
                "string.quoted",
                "string.template",
                "string.regexp"
            ],
            "settings": { "foreground": "#A5D6FF" }
        },
        {
            "scope": ["support.type.property-name"],
            "settings": { "foreground": "#7EE787" }
        },
        {
            "scope": [
                "meta.decorator",
                "punctuation.decorator",
                "meta.function.decorator",
                "entity.name.function",
                "support.function",
                "meta.function-call",
                "meta.method-call",
                "support.type"
            ],
            "settings": { "foreground": "#D2A8FF" }
        },
        {
            "scope": [
                "entity.name.type.class",
                "entity.name.class",
                "entity.other.inherited-class"
            ],
            "settings": { "foreground": "#FFA657" }
        },
        {
            "scope": [
                "variable",
                "variable.other",
                "variable.parameter",
                "variable.language",
                "punctuation.definition.parameters",
                "punctuation.definition.block",
                "punctuation.definition.arguments",
                "meta.parameters",
                "meta.block",
                "source",
                "source.python",
                "punctuation.separator.period",
                "punctuation.separator.arguments"
            ],
            "settings": { "foreground": "#F0F6FC" }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.language",
                "constant.character.escape",
                "keyword.operator.assignment",
                "keyword.operator.arithmetic",
                "keyword.operator.logical",
                "variable.other.property",
                "meta.function.decorator"
            ],
            "settings": { "foreground": "#79C0FF" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
