    "tokenColors": [
        {
            "scope": [
                "comment",
                "punctuation.definition.comment",
                "string.comment"
            ],
            "settings": { "fontStyle": "italic", "foreground": "#bfc3cdcc" }
        },
        {
            "scope": ["constant.other.placeholder", "constant.character"],
            "settings": { "foreground": "#ff837a" }
        },
        {
            "scope": [
                "constant",
                "entity.name.constant",
                "variable.other.constant",
                "variable.other.enummember",
                "variable.language",
                "entity"
            ],
            "settings": { "foreground": "#80c3ff" }
        },
        {
            "scope": [
                "entity.name",
                "meta.export.default",
                "meta.definition.variable"
            ],
            "settings": { "foreground": "#ffab61" }
        },
        {
            "scope": [
                "variable.parameter.function",
                "meta.jsx.children",
                "meta.block",
                "meta.tag.attributes",
                "entity.name.constant",
                "meta.object.member",
                "meta.embedded.expression"
            ],
            "settings": { "foreground": "#bfc3cd" }
        },
        {
            "scope": "entity.name.function",
            "settings": { "foreground": "#d5adff" }
        },
        {
            "scope": ["entity.name.tag", "support.class.component"],
            "settings": { "foreground": "#6bff78" }
        },
        { "scope": "keyword", "settings": { "foreground": "#ff837a" } },
        {
            "scope": ["storage", "storage.type"],
            "settings": { "foreground": "#ff837a" }
        },
        {
            "scope": [
                "storage.modifier.package",
                "storage.modifier.import",
                "storage.type.java"
            ],
            "settings": { "foreground": "#ced1d9" }
        },
        {
            "scope": ["string", "string punctuation.section.embedded source"],
            "settings": { "foreground": "#addaee" }
        },
        { "scope": "support", "settings": { "foreground": "#80c3ff" } },
        {
            "scope": "meta.property-name",
            "settings": { "foreground": "#80c3ff" }
        },
        { "scope": "variable", "settings": { "foreground": "#ffab61" } },
        { "scope": "variable.other", "settings": { "foreground": "#ced1d9" } },
        {
            "scope": "invalid.broken",
            "settings": { "foreground": "#ffa69e", "fontStyle": "italic" }
        },
        {
            "scope": "invalid.deprecated",
            "settings": { "foreground": "#ffa69e", "fontStyle": "italic" }
        },
        {
            "scope": "invalid.illegal",
            "settings": { "foreground": "#ffa69e", "fontStyle": "italic" }
        },
        {
            "scope": "invalid.unimplemented",
            "settings": { "foreground": "#ffa69e", "fontStyle": "italic" }
        },
        {
            "scope": "carriage-return",
            "settings": {
                "foreground": "#F0F6FC",
                "fontStyle": "italic underline"
            }
        },
        { "scope": "message.error", "settings": { "foreground": "#ffa69e" } },
        { "scope": "string variable", "settings": { "foreground": "#80c3ff" } },
        {
            "scope": ["source.regexp", "string.regexp"],
            "settings": { "foreground": "#addaee" }
        },
        {
            "scope": [
                "string.regexp.character-class",
                "string.regexp constant.character.escape",
                "string.regexp source.ruby.embedded",
                "string.regexp string.regexp.arbitrary-repetition"
            ],
            "settings": { "foreground": "#addaee" }
        },
        {
            "scope": "string.regexp constant.character.escape",
            "settings": { "foreground": "#6bff78", "fontStyle": "bold" }
        },
        {
            "scope": "support.constant",
            "settings": { "foreground": "#80c3ff" }
        },
        {
            "scope": "support.variable",
            "settings": { "foreground": "#80c3ff" }
        },
        {
            "scope": "support.type.property-name.json",
            "settings": { "foreground": "#6bff78" }
        },
        {
            "scope": "meta.module-reference",
            "settings": { "foreground": "#80c3ff" }
        },
        {
            "scope": "punctuation.definition.list.begin.markdown",
            "settings": { "foreground": "#ffab61" }
        },
        {
            "scope": ["markup.heading", "markup.heading entity.name"],
            "settings": { "foreground": "#80c3ff", "fontStyle": "bold" }
        },
        { "scope": "markup.quote", "settings": { "foreground": "#6bff78" } },
        {
            "scope": "markup.italic",
            "settings": { "foreground": "#ced1d9", "fontStyle": "italic" }
        },
        {
            "scope": "markup.bold",
            "settings": { "foreground": "#ced1d9", "fontStyle": "bold" }
        },
        {
            "scope": ["markup.underline"],
            "settings": { "fontStyle": "underline" }
        },
        {
            "scope": ["markup.strikethrough"],
            "settings": { "fontStyle": "strikethrough" }
        },
        {
            "scope": "markup.inline.raw",
            "settings": { "foreground": "#80c3ff" }
        },
        {
            "scope": [
                "markup.deleted",
                "meta.diff.header.from-file",
                "punctuation.definition.deleted"
            ],
            "settings": { "foreground": "#ffa69e" }
        },
        {
            "scope": ["punctuation.section.embedded"],
            "settings": { "foreground": "#ff837a" }
        },
        {
            "scope": [
                "markup.inserted",
                "meta.diff.header.to-file",
                "punctuation.definition.inserted"
            ],
            "settings": { "foreground": "#6bff78" }
        },
        {
            "scope": ["markup.changed", "punctuation.definition.changed"],
            "settings": { "foreground": "#ffab61" }
        },
        {
            "scope": ["markup.ignored", "markup.untracked"],
            "settings": { "foreground": "#06080d" }
        },
        {
            "scope": "meta.diff.range",
            "settings": { "foreground": "#d5adff", "fontStyle": "bold" }
        },
        {
            "scope": "meta.diff.header",
            "settings": { "foreground": "#80c3ff" }
        },
        {
            "scope": "meta.separator",
            "settings": { "foreground": "#80c3ff", "fontStyle": "bold" }
        },
        { "scope": "meta.output", "settings": { "foreground": "#80c3ff" } },
        {
            "scope": [
                "brackethighlighter.tag",
                "brackethighlighter.curly",
                "brackethighlighter.round",
                "brackethighlighter.square",
                "brackethighlighter.angle",
                "brackethighlighter.quote"
            ],
            "settings": { "foreground": "#bfc3cdcc" }
        },
        {
            "scope": "brackethighlighter.unmatched",
            "settings": { "foreground": "#ffa69e" }
        },
        {
            "scope": ["constant.other.reference.link", "string.other.link"],
            "settings": { "foreground": "#addaee" }
        },
        {
            "scope": "token.info-token",
            "settings": { "foreground": "#5795ff" }
        },
        {
            "scope": "token.warn-token",
            "settings": { "foreground": "#ffaa0a" }
        },
        {
            "scope": "token.error-token",
            "settings": { "foreground": "#ff4242" }
        },
        {
            "scope": "token.debug-token",
            "settings": { "foreground": "#ba57ff" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
