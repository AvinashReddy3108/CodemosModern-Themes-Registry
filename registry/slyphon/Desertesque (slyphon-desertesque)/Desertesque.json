{
    "$schema": "vscode://schemas/color-theme",
    "type": "dark",
    "colors": {
        "editor.background": "#181717",
        "editor.foreground": "#cccccc",
        "editor.lineHighlightBackground": "#212020",
        "editor.selectionBackground": "#f0e68c4f",
        "editorCursor.foreground": "#ffff00",
        "editorError.border": "#960000",
        "editorWhitespace.foreground": "#ffffff40",
        "editorLineNumber.foreground": "#AAA127"
    },
    "tokenColors": [
        {
            "name": "Comment",
            "scope": "comment",
            "settings": { "fontStyle": "italic", "foreground": "#1ABFCF" }
        },
        {
            "name": "Constant",
            "scope": "constant",
            "settings": { "foreground": "#B781A1" }
        },
        {
            "name": "Entity",
            "scope": "entity",
            "settings": { "fontStyle": "", "foreground": "#cececbff" }
        },
        {
            "name": "Keyword",
            "scope": "keyword",
            "settings": { "foreground": "#CFD572" }
        },
        {
            "name": "Storage",
            "scope": "storage",
            "settings": { "fontStyle": "", "foreground": "#ced572e7" }
        },
        {
            "name": "String",
            "scope": "string",
            "settings": { "fontStyle": "", "foreground": "#FFA1A1" }
        },
        {
            "name": "Support",
            "scope": "support",
            "settings": { "fontStyle": "", "foreground": "#F6DDB0" }
        },
        {
            "name": "Variable",
            "scope": "variable",
            "settings": { "foreground": "#d0cccc" }
        },
        {
            "name": "Invalid – Deprecated",
            "scope": "invalid.deprecated",
            "settings": {
                "fontStyle": "italic underline",
                "foreground": "#d4a8a1ff"
            }
        },
        {
            "name": "Invalid – Illegal",
            "scope": "invalid.illegal",
            "settings": { "background": "#582c58bf", "foreground": "#fafafaff" }
        },
        {
            "name": "♦ Embedded Source",
            "scope": "text source",
            "settings": { "background": "#b0b4bc14", "foreground": "#87cfeeff" }
        },
        {
            "name": "♦ Embedded Source (Bright)",
            "scope": "text.html.ruby source",
            "settings": { "background": "#b1b4bc21" }
        },
        {
            "name": "♦ Entity inherited-class",
            "scope": "entity.other.inherited-class",
            "settings": { "fontStyle": "italic", "foreground": "#B39545" }
        },
        {
            "name": "♦ String embedded-source",
            "scope": "string source",
            "settings": { "fontStyle": "", "foreground": "#76f1c7ff" }
        },
        {
            "name": "♦ String constant",
            "scope": "string constant",
            "settings": { "foreground": "#def5a4ff" }
        },
        {
            "name": "♦ String.regexp",
            "scope": "string.regexp",
            "settings": { "fontStyle": "", "foreground": "#fd8072ff" }
        },
        {
            "name": "♦ String.regexp.«special»",
            "scope": "string.regexp constant.character.escape, string.regexp source.ruby.embedded, string.regexp string.regexp.arbitrary-repitition",
            "settings": { "foreground": "#ffa650ff" }
        },
        {
            "name": "♦ String variable",
            "scope": "string variable",
            "settings": { "foreground": "#8a9c96ff" }
        },
        {
            "name": "♦ Support.function",
            "scope": "support.function",
            "settings": { "fontStyle": "", "foreground": "#CCBE94" }
        },
        {
            "name": "♦ Support.constant",
            "scope": "support.constant",
            "settings": { "fontStyle": " italic", "foreground": "#CCBE94" }
        },
        {
            "name": "c C/C++ Preprocessor Line",
            "scope": "meta.preprocessor.c",
            "settings": { "foreground": "#8997aaff" }
        },
        {
            "name": "c C/C++ Preprocessor Directive",
            "scope": "meta.preprocessor.c keyword",
            "settings": { "foreground": "#87cfeeff" }
        },
        {
            "name": "✘ Doctype/XML Processing",
            "scope": "meta.tag.sgml.doctype, meta.tag.sgml.doctype entity, meta.tag.sgml.doctype string, meta.tag.preprocessor.xml, meta.tag.preprocessor.xml entity, meta.tag.preprocessor.xml string",
            "settings": { "foreground": "#f1dd82ff" }
        },
        {
            "name": "✘ Meta.tag.«all»",
            "scope": "declaration.tag, declaration.tag entity, meta.tag, meta.tag entity",
            "settings": { "foreground": "#87cfeeff" }
        },
        {
            "name": "✘ Meta.tag.inline",
            "scope": "declaration.tag.inline, declaration.tag.inline entity, source entity.name.tag, source entity.other.attribute-name, meta.tag.inline, meta.tag.inline entity",
            "settings": { "foreground": "#87cfeeff" }
        },
        {
            "name": "§ css tag-name",
            "scope": "meta.selector.css entity.name.tag",
            "settings": { "foreground": "#f1dd82ff" }
        },
        {
            "name": "§ css:pseudo-class",
            "scope": "meta.selector.css entity.other.attribute-name.tag.pseudo-class",
            "settings": { "foreground": "#f179a0ff" }
        },
        {
            "name": "§ css#id",
            "scope": "meta.selector.css entity.other.attribute-name.id",
            "settings": { "foreground": "#87cfeeff" }
        },
        {
            "name": "§ css.class",
            "scope": "meta.selector.css entity.other.attribute-name.class",
            "settings": { "foreground": "#87cfeeff" }
        },
        {
            "name": "§ css property-name:",
            "scope": "support.type.property-name.css",
            "settings": { "foreground": "#ffa650ff" }
        },
        {
            "name": "§ css property-value;",
            "scope": "meta.property-group support.constant.property-value.css, meta.property-value support.constant.property-value.css",
            "settings": { "foreground": "#fcf098ff" }
        },
        {
            "name": "§ css @at-rule",
            "scope": "meta.preprocessor.at-rule keyword.control.at-rule",
            "settings": { "foreground": "#8694a7ff" }
        },
        {
            "name": "§ css additional-constants",
            "scope": "meta.property-value support.constant.named-color.css, meta.property-value constant",
            "settings": { "foreground": "#fd8072ff" }
        },
        {
            "name": "§ css constructor.argument",
            "scope": "meta.constructor.argument.css",
            "settings": { "foreground": "#919f6aff" }
        },
        {
            "name": "⎇ diff.header",
            "scope": "meta.diff, meta.diff.header, meta.separator",
            "settings": {
                "background": "#0e2231ff",
                "fontStyle": "italic",
                "foreground": "#fafafaff"
            }
        },
        {
            "name": "⎇ diff.deleted",
            "scope": "markup.deleted",
            "settings": { "background": "#420e09ff", "foreground": "#fafafaff" }
        },
        {
            "name": "⎇ diff.changed",
            "scope": "markup.changed",
            "settings": { "background": "#4a410dff", "foreground": "#fafafaff" }
        },
        {
            "name": "⎇ diff.inserted",
            "scope": "markup.inserted",
            "settings": { "background": "#253b22ff", "foreground": "#fafafaff" }
        },
        {
            "name": "Markup: List",
            "scope": "markup.list",
            "settings": { "foreground": "#fcf098ff" }
        },
        {
            "name": "Markup: Heading",
            "scope": "markup.heading",
            "settings": { "foreground": "#d16a4cff" }
        },
        {
            "name": "Go built-in function",
            "scope": "support.function.built-in.go",
            "settings": { "foreground": "#f1dd82ff" }
        },
        {
            "name": "parenthesis",
            "scope": "meta.brace.round",
            "settings": { "foreground": "#A4A6A6" }
        },
        {
            "name": "curly braces",
            "scope": "punctuation.definition.block",
            "settings": { "foreground": "#A4A6A6" }
        },
        {
            "name": "comma",
            "scope": "punctuation.separator.comma",
            "settings": { "foreground": "#A4A6A6" }
        },
        {
            "name": "left angle bracket",
            "scope": "punctuation.definition.typeparameters.begin",
            "settings": { "foreground": "#A4A6A6" }
        },
        {
            "name": "right angle bracket",
            "scope": "punctuation.definition.typeparameters.end",
            "settings": { "foreground": "#A4A6A6" }
        },
        {
            "name": "params open",
            "scope": "punctuation.definition.parameters.begin",
            "settings": { "foreground": "#A4A6A6" }
        },
        {
            "name": "params close",
            "scope": "punctuation.definition.parameters.end",
            "settings": { "foreground": "#A4A6A6" }
        },
        {
            "name": "definition tag begin",
            "scope": "punctuation.definition.tag.begin",
            "settings": { "foreground": "#A4A6A6" }
        },
        {
            "name": "definition tag end",
            "scope": "punctuation.definition.tag.end",
            "settings": { "foreground": "#A4A6A6" }
        },
        {
            "name": "punctuation section embedded tag begin",
            "scope": "punctuation.section.embedded.begin",
            "settings": { "foreground": "#A4A6A6" }
        },
        {
            "name": "punctuation section embedded tag end",
            "scope": "punctuation.section.embedded",
            "settings": { "foreground": "#A4A6A6" }
        },
        {
            "name": "punctuation definition parameters begin",
            "scope": "punctuation.definition.parameters.begin",
            "settings": { "foreground": "#A4A6A6" }
        },
        {
            "name": "punctuation definition parameters end",
            "scope": "punctuation.definition.parameters.end",
            "settings": { "foreground": "#A4A6A6" }
        },
        {
            "name": "function call",
            "scope": "meta.function-call.ts",
            "settings": { "foreground": "#cececbff" }
        },
        {
            "name": "type name",
            "scope": "entity.name.class",
            "settings": { "fontStyle": "italic", "foreground": "#B39545" }
        },
        {
            "name": "go template template block",
            "scope": "punctuation.section.embedded.begin.gotemplate",
            "settings": { "foreground": "#def5a4ff" }
        },
        {
            "name": "go template template block",
            "scope": "punctuation.section.embedded.end.gotemplate",
            "settings": { "foreground": "#def5a4ff" }
        },
        {
            "name": "html attribute",
            "scope": "entity.other.attribute-name.html",
            "settings": { "foreground": "#eedd65ff" }
        },
        {
            "name": "typescript entity jsx attribute name",
            "scope": "entity.other.attribute-name.tsx",
            "settings": { "foreground": "#ccbe94" }
        },
        {
            "name": "typescript type parameters",
            "scope": "entity.name.type",
            "settings": { "foreground": "#b39545ff" }
        },
        {
            "name": "typescript type parameters",
            "scope": "entity.name.function",
            "settings": { "foreground": "#9fcb9d" }
        },
        {
            "name": "typescript type alias",
            "scope": "entity.name.type.alias",
            "settings": { "foreground": "#f6ddb0ff" }
        },
        {
            "name": "typescript type interface",
            "scope": "entity.name.type.interface",
            "settings": { "foreground": "#f6ddb0ff" }
        },
        {
            "name": "typescript other constant",
            "scope": "variable.other.constant",
            "settings": { "foreground": "#f6ddb0ff" }
        },
        {
            "name": "typescript other constant object",
            "scope": "variable.other.constant.object",
            "settings": { "foreground": "#9cb8bbff" }
        },
        {
            "name": "typescript other object",
            "scope": "variable.other.object",
            "settings": { "foreground": "#acbdbf" }
        },
        {
            "name": "typescript other object property",
            "scope": "variable.other.object.property",
            "settings": { "foreground": "#9cb8bbff" }
        },
        {
            "name": "typescript other object property",
            "scope": "meta.object-literal.key",
            "settings": { "foreground": "#d0cccc" }
        },
        {
            "name": "typescript name tag tsx",
            "scope": "entity.name.tag.tsx",
            "settings": { "foreground": "#f6ddb0ff" }
        },
        {
            "scope": "token.info-token",
            "settings": { "foreground": "#6796e6" }
        },
        {
            "scope": "token.warn-token",
            "settings": { "foreground": "#cd9731" }
        },
        {
            "scope": "token.error-token",
            "settings": { "foreground": "#f44747" }
        },
        {
            "scope": "token.debug-token",
            "settings": { "foreground": "#b267e6" }
        }
    ]
}
