        {
            "name": "Library constant",
            "scope": ["support.constant"],
            "settings": { "fontStyle": "italic", "foreground": "#d89563" }
        },
        {
            "name": "Library class/type",
            "scope": [
                "support.type",
                "support.class",
                "source.go storage.type"
            ],
            "settings": { "foreground": "#47c4e8" }
        },
        {
            "name": "Decorators/annotation",
            "scope": [
                "meta.decorator variable.other",
                "meta.decorator punctuation.decorator",
                "storage.type.annotation",
                "entity.name.function.decorator"
            ],
            "settings": { "foreground": "#ff6ea8" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid"],
            "settings": { "foreground": "#e0616f" }
        },
        {
            "name": "diff.header",
            "scope": ["meta.diff", "meta.diff.header"],
            "settings": { "foreground": "#c594c5" }
        },
        {
            "name": "Ruby class methods",
            "scope": ["source.ruby variable.other.readwrite"],
            "settings": { "foreground": "#66d6b4" }
        },
        {
            "name": "CSS tag names",
            "scope": [
                "source.css entity.name.tag",
                "source.sass entity.name.tag",
                "source.scss entity.name.tag",
                "source.less entity.name.tag",
                "source.stylus entity.name.tag"
            ],
            "settings": { "foreground": "#72b6ff" }
        },
        {
            "name": "CSS browser prefix",
            "scope": [
                "source.css support.type",
                "source.sass support.type",
                "source.scss support.type",
                "source.less support.type",
                "source.stylus support.type"
            ],
            "settings": { "foreground": "#7588a399" }
        },
        {
            "name": "CSS Properties",
            "scope": ["support.type.property-name"],
            "settings": { "fontStyle": "normal", "foreground": "#47c4e8" }
        },
        {
            "name": "Search Results Numbers",
            "scope": ["constant.numeric.line-number.find-in-files - match"],
            "settings": { "foreground": "#7588a399" }
        },
        {
            "name": "Search Results Match Numbers",
            "scope": ["constant.numeric.line-number.match"],
            "settings": { "foreground": "#8e58bb" }
        },
        {
            "name": "Search Results Lines",
            "scope": ["entity.name.filename.find-in-files"],
            "settings": { "foreground": "#98d06b" }
        },
        { "scope": ["message.error"], "settings": { "foreground": "#e0616f" } },
        {
            "name": "Markup heading",
            "scope": ["markup.heading", "markup.heading entity.name"],
            "settings": { "fontStyle": "bold", "foreground": "#98d06b" }
        },
        {
            "name": "Markup links",
            "scope": ["markup.underline.link", "string.other.link"],
            "settings": { "foreground": "#47c4e8" }
        },
        {
            "name": "Markup Italic/Emphasis",
            "scope": ["markup.italic", "emphasis"],
            "settings": { "fontStyle": "italic", "foreground": "#d97a9c" }
        },
        {
            "name": "Markup Bold",
            "scope": ["markup.bold"],
            "settings": { "fontStyle": "bold", "foreground": "#d97a9c" }
        },
        {
            "name": "Markup Underline",
            "scope": ["markup.underline"],
            "settings": { "fontStyle": "underline" }
        },
        {
            "name": "Markup Bold/italic",
            "scope": ["markup.italic markup.bold", "markup.bold markup.italic"],
            "settings": { "fontStyle": "bold italic" }
        },
        {
            "name": "Markup Code",
            "scope": ["markup.raw"],
            "settings": { "background": "#d9e2f005" }
        },
        {
            "name": "Markup Code Inline",
            "scope": ["markup.raw.inline"],
            "settings": { "background": "#d9e2f00f" }
        },
        {
            "name": "Markdown Separator",
            "scope": ["meta.separator"],
            "settings": {
                "fontStyle": "bold",
                "background": "#d9e2f00f",
                "foreground": "#7588a399"
            }
        },
        {
            "name": "Markup Blockquote",
            "scope": ["markup.quote"],
            "settings": { "foreground": "#e6b766", "fontStyle": "italic" }
        },
        {
            "name": "Markup List Bullet",
            "scope": ["markup.list punctuation.definition.list.begin"],
            "settings": { "foreground": "#66d6b4" }
        },
        {
            "name": "Markup added",
            "scope": ["markup.inserted"],
            "settings": { "foreground": "#67c18b" }
        },
        {
            "name": "Markup modified",
            "scope": ["markup.changed"],
            "settings": { "foreground": "#60b7ff" }
        },
        {
            "name": "Markup removed",
            "scope": ["markup.deleted"],
            "settings": { "foreground": "#e26a78" }
        },
        {
            "name": "Markup Strike",
            "scope": ["markup.strike"],
            "settings": { "foreground": "#ff6ea8" }
        },
        {
            "name": "Markup strong",
            "scope": ["markup.strong"],
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Markup Table",
            "scope": ["markup.table"],
            "settings": { "background": "#d9e2f00f", "foreground": "#47c4e8" }
        },
        {
            "name": "Markup Raw Inline",
            "scope": ["text.html.markdown markup.inline.raw"],
            "settings": { "foreground": "#d89563" }
        },
        {
            "name": "Markdown - Line Break",
            "scope": ["text.html.markdown meta.dummy.line-break"],
            "settings": { "background": "#7588a399", "foreground": "#7588a399" }
        },
        {
            "name": "Markdown - Raw Block Fenced",
            "scope": ["punctuation.definition.markdown"],
            "settings": { "background": "#d9e2f0", "foreground": "#7588a399" }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "class": "#72b6ff",
        "class.defaultLibrary": "#47c4e8",
        "enum": "#72b6ff",
        "enum.defaultLibrary": "#47c4e8",
        "interface": "#47c4e8",
        "interface.defaultLibrary": { "foreground": "#47c4e8", "italic": true },
        "struct": "#72b6ff",
        "struct.defaultLibrary": "#47c4e8",
        "type": "#72b6ff",
        "type.defaultLibrary": "#47c4e8",
        "enumMember": "#e6b766",
        "event": "#d89563",
        "function": "#66d6b4",
        "method": "#66d6b4",
        "macro": "#ff6ea8",
        "comment": "#7588a399",
        "string": "#98d06b",
        "keyword": "#8e58bb",
        "number": "#c897ff",
        "regexp": "#e6b766",
        "operator": "#d89563"
    },
    "$schema": "vscode://schemas/color-theme"
}
