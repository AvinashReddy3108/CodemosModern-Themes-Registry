        {
            "name": "Library constant",
            "scope": ["support.constant"],
            "settings": { "fontStyle": "italic", "foreground": "#f78e59" }
        },
        {
            "name": "Library class/type",
            "scope": [
                "support.type",
                "support.class",
                "source.go storage.type"
            ],
            "settings": { "foreground": "#00b7e1" }
        },
        {
            "name": "Decorators/annotation",
            "scope": [
                "meta.decorator variable.other",
                "meta.decorator punctuation.decorator",
                "storage.type.annotation",
                "entity.name.function.decorator"
            ],
            "settings": { "foreground": "#dfae66" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid"],
            "settings": { "foreground": "#b9473f" }
        },
        {
            "name": "diff.header",
            "scope": ["meta.diff", "meta.diff.header"],
            "settings": { "foreground": "#c594c5" }
        },
        {
            "name": "Ruby class methods",
            "scope": ["source.ruby variable.other.readwrite"],
            "settings": { "foreground": "#1cc295" }
        },
        {
            "name": "CSS tag names",
            "scope": [
                "source.css entity.name.tag",
                "source.sass entity.name.tag",
                "source.scss entity.name.tag",
                "source.less entity.name.tag",
                "source.stylus entity.name.tag"
            ],
            "settings": { "foreground": "#00a0f6" }
        },
        {
            "name": "CSS browser prefix",
            "scope": [
                "source.css support.type",
                "source.sass support.type",
                "source.scss support.type",
                "source.less support.type",
                "source.stylus support.type"
            ],
            "settings": { "foreground": "#6f7c8f99" }
        },
        {
            "name": "CSS Properties",
            "scope": ["support.type.property-name"],
            "settings": { "fontStyle": "normal", "foreground": "#00b7e1" }
        },
        {
            "name": "Search Results Numbers",
            "scope": ["constant.numeric.line-number.find-in-files - match"],
            "settings": { "foreground": "#6f7c8f99" }
        },
        {
            "name": "Search Results Match Numbers",
            "scope": ["constant.numeric.line-number.match"],
            "settings": { "foreground": "#ff7821" }
        },
        {
            "name": "Search Results Lines",
            "scope": ["entity.name.filename.find-in-files"],
            "settings": { "foreground": "#80b500" }
        },
        { "scope": ["message.error"], "settings": { "foreground": "#b9473f" } },
        {
            "name": "Markup heading",
            "scope": ["markup.heading", "markup.heading entity.name"],
            "settings": { "fontStyle": "bold", "foreground": "#80b500" }
        },
        {
            "name": "Markup links",
            "scope": ["markup.underline.link", "string.other.link"],
            "settings": { "foreground": "#00b7e1" }
        },
        {
            "name": "Markup Italic/Emphasis",
            "scope": ["markup.italic", "emphasis"],
            "settings": { "fontStyle": "italic", "foreground": "#fc676b" }
        },
        {
            "name": "Markup Bold",
            "scope": ["markup.bold"],
            "settings": { "fontStyle": "bold", "foreground": "#fc676b" }
        },
        {
            "name": "Markup Underline",
            "scope": ["markup.underline"],
            "settings": { "fontStyle": "underline" }
        },
        {
            "name": "Markup Bold/italic",
            "scope": ["markup.italic markup.bold", "markup.bold markup.italic"],
            "settings": { "fontStyle": "bold italic" }
        },
        {
            "name": "Markup Code",
            "scope": ["markup.raw"],
            "settings": { "background": "#29403905" }
        },
        {
            "name": "Markup Code Inline",
            "scope": ["markup.raw.inline"],
            "settings": { "background": "#2940390f" }
        },
        {
            "name": "Markdown Separator",
            "scope": ["meta.separator"],
            "settings": {
                "fontStyle": "bold",
                "background": "#2940390f",
                "foreground": "#6f7c8f99"
            }
        },
        {
            "name": "Markup Blockquote",
            "scope": ["markup.quote"],
            "settings": { "foreground": "#f6a100", "fontStyle": "italic" }
        },
        {
            "name": "Markup List Bullet",
            "scope": ["markup.list punctuation.definition.list.begin"],
            "settings": { "foreground": "#1cc295" }
        },
        {
            "name": "Markup added",
            "scope": ["markup.inserted"],
            "settings": { "foreground": "#4fa84b" }
        },
        {
            "name": "Markup modified",
            "scope": ["markup.changed"],
            "settings": { "foreground": "#3b79c1" }
        },
        {
            "name": "Markup removed",
            "scope": ["markup.deleted"],
            "settings": { "foreground": "#b9473f" }
        },
        {
            "name": "Markup Strike",
            "scope": ["markup.strike"],
            "settings": { "foreground": "#dfae66" }
        },
        {
            "name": "Markup strong",
            "scope": ["markup.strong"],
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Markup Table",
            "scope": ["markup.table"],
            "settings": { "background": "#2940390f", "foreground": "#00b7e1" }
        },
        {
            "name": "Markup Raw Inline",
            "scope": ["text.html.markdown markup.inline.raw"],
            "settings": { "foreground": "#f78e59" }
        },
        {
            "name": "Markdown - Line Break",
            "scope": ["text.html.markdown meta.dummy.line-break"],
            "settings": { "background": "#6f7c8f99", "foreground": "#6f7c8f99" }
        },
        {
            "name": "Markdown - Raw Block Fenced",
            "scope": ["punctuation.definition.markdown"],
            "settings": { "background": "#294039", "foreground": "#6f7c8f99" }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "class": "#00a0f6",
        "class.defaultLibrary": "#00b7e1",
        "enum": "#00a0f6",
        "enum.defaultLibrary": "#00b7e1",
        "interface": "#00b7e1",
        "interface.defaultLibrary": { "foreground": "#00b7e1", "italic": true },
        "struct": "#00a0f6",
        "struct.defaultLibrary": "#00b7e1",
        "type": "#00a0f6",
        "type.defaultLibrary": "#00b7e1",
        "enumMember": "#f6a100",
        "event": "#f78e59",
        "function": "#1cc295",
        "method": "#1cc295",
        "macro": "#dfae66",
        "comment": "#6f7c8f99",
        "string": "#80b500",
        "keyword": "#ff7821",
        "number": "#a676d8",
        "regexp": "#f6a100",
        "operator": "#f78e59"
    },
    "$schema": "vscode://schemas/color-theme"
}
