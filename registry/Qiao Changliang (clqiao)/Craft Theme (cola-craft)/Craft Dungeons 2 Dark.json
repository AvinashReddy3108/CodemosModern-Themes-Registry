            "scope": ["meta.diff", "meta.diff.header"],
            "settings": { "foreground": "#c594c5" }
        },
        {
            "name": "Ruby class methods",
            "scope": ["source.ruby variable.other.readwrite"],
            "settings": { "foreground": "#58cc9e" }
        },
        {
            "name": "CSS tag names",
            "scope": [
                "source.css entity.name.tag",
                "source.sass entity.name.tag",
                "source.scss entity.name.tag",
                "source.less entity.name.tag",
                "source.stylus entity.name.tag"
            ],
            "settings": { "foreground": "#5caadf" }
        },
        {
            "name": "CSS browser prefix",
            "scope": [
                "source.css support.type",
                "source.sass support.type",
                "source.scss support.type",
                "source.less support.type",
                "source.stylus support.type"
            ],
            "settings": { "foreground": "#9a8870a6" }
        },
        {
            "name": "CSS Properties",
            "scope": ["support.type.property-name"],
            "settings": { "fontStyle": "normal", "foreground": "#48c8e8" }
        },
        {
            "name": "Search Results Numbers",
            "scope": ["constant.numeric.line-number.find-in-files - match"],
            "settings": { "foreground": "#9a8870a6" }
        },
        {
            "name": "Search Results Match Numbers",
            "scope": ["constant.numeric.line-number.match"],
            "settings": { "foreground": "#f09454" }
        },
        {
            "name": "Search Results Lines",
            "scope": ["entity.name.filename.find-in-files"],
            "settings": { "foreground": "#9ec855" }
        },
        { "scope": ["message.error"], "settings": { "foreground": "#ff7070" } },
        {
            "name": "Markup heading",
            "scope": ["markup.heading", "markup.heading entity.name"],
            "settings": { "fontStyle": "bold", "foreground": "#9ec855" }
        },
        {
            "name": "Markup links",
            "scope": ["markup.underline.link", "string.other.link"],
            "settings": { "foreground": "#48c8e8" }
        },
        {
            "name": "Markup Italic/Emphasis",
            "scope": ["markup.italic", "emphasis"],
            "settings": { "fontStyle": "italic", "foreground": "#e07e72" }
        },
        {
            "name": "Markup Bold",
            "scope": ["markup.bold"],
            "settings": { "fontStyle": "bold", "foreground": "#e07e72" }
        },
        {
            "name": "Markup Underline",
            "scope": ["markup.underline"],
            "settings": { "fontStyle": "underline" }
        },
        {
            "name": "Markup Bold/italic",
            "scope": ["markup.italic markup.bold", "markup.bold markup.italic"],
            "settings": { "fontStyle": "bold italic" }
        },
        {
            "name": "Markup Code",
            "scope": ["markup.raw"],
            "settings": { "background": "#ecd9c605" }
        },
        {
            "name": "Markup Code Inline",
            "scope": ["markup.raw.inline"],
            "settings": { "background": "#ecd9c60f" }
        },
        {
            "name": "Markdown Separator",
            "scope": ["meta.separator"],
            "settings": {
                "fontStyle": "bold",
                "background": "#ecd9c60f",
                "foreground": "#9a8870a6"
            }
        },
        {
            "name": "Markup Blockquote",
            "scope": ["markup.quote"],
            "settings": { "foreground": "#e8bc50", "fontStyle": "italic" }
        },
        {
            "name": "Markup List Bullet",
            "scope": ["markup.list punctuation.definition.list.begin"],
            "settings": { "foreground": "#58cc9e" }
        },
        {
            "name": "Markup added",
            "scope": ["markup.inserted"],
            "settings": { "foreground": "#7fc964" }
        },
        {
            "name": "Markup modified",
            "scope": ["markup.changed"],
            "settings": { "foreground": "#ffb84d" }
        },
        {
            "name": "Markup removed",
            "scope": ["markup.deleted"],
            "settings": { "foreground": "#ff6b6b" }
        },
        {
            "name": "Markup Strike",
            "scope": ["markup.strike"],
            "settings": { "foreground": "#dec060" }
        },
        {
            "name": "Markup strong",
            "scope": ["markup.strong"],
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Markup Table",
            "scope": ["markup.table"],
            "settings": { "background": "#ecd9c60f", "foreground": "#48c8e8" }
        },
        {
            "name": "Markup Raw Inline",
            "scope": ["text.html.markdown markup.inline.raw"],
            "settings": { "foreground": "#f0a870" }
        },
        {
            "name": "Markdown - Line Break",
            "scope": ["text.html.markdown meta.dummy.line-break"],
            "settings": { "background": "#9a8870a6", "foreground": "#9a8870a6" }
        },
        {
            "name": "Markdown - Raw Block Fenced",
            "scope": ["punctuation.definition.markdown"],
            "settings": { "background": "#ecd9c6", "foreground": "#9a8870a6" }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "class": "#5caadf",
        "class.defaultLibrary": "#48c8e8",
        "enum": "#5caadf",
        "enum.defaultLibrary": "#48c8e8",
        "interface": "#48c8e8",
        "interface.defaultLibrary": { "foreground": "#48c8e8", "italic": true },
        "struct": "#5caadf",
        "struct.defaultLibrary": "#48c8e8",
        "type": "#5caadf",
        "type.defaultLibrary": "#48c8e8",
        "enumMember": "#e8bc50",
        "event": "#f0a870",
        "function": "#58cc9e",
        "method": "#58cc9e",
        "macro": "#dec060",
        "comment": "#9a8870a6",
        "string": "#9ec855",
        "keyword": "#f09454",
        "number": "#b090ea",
        "regexp": "#e8bc50",
        "operator": "#f0a870"
    },
    "$schema": "vscode://schemas/color-theme"
}
