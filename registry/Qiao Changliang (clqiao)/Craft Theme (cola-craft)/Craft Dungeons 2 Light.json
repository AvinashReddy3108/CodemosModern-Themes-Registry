            ],
            "settings": { "foreground": "#1ba8d9" }
        },
        {
            "name": "Decorators/annotation",
            "scope": [
                "meta.decorator variable.other",
                "meta.decorator punctuation.decorator",
                "storage.type.annotation",
                "entity.name.function.decorator"
            ],
            "settings": { "foreground": "#d7aa59" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid"],
            "settings": { "foreground": "#c94b45" }
        },
        {
            "name": "diff.header",
            "scope": ["meta.diff", "meta.diff.header"],
            "settings": { "foreground": "#c594c5" }
        },
        {
            "name": "Ruby class methods",
            "scope": ["source.ruby variable.other.readwrite"],
            "settings": { "foreground": "#2dae87" }
        },
        {
            "name": "CSS tag names",
            "scope": [
                "source.css entity.name.tag",
                "source.sass entity.name.tag",
                "source.scss entity.name.tag",
                "source.less entity.name.tag",
                "source.stylus entity.name.tag"
            ],
            "settings": { "foreground": "#2e88c7" }
        },
        {
            "name": "CSS browser prefix",
            "scope": [
                "source.css support.type",
                "source.sass support.type",
                "source.scss support.type",
                "source.less support.type",
                "source.stylus support.type"
            ],
            "settings": { "foreground": "#7a85909e" }
        },
        {
            "name": "CSS Properties",
            "scope": ["support.type.property-name"],
            "settings": { "fontStyle": "normal", "foreground": "#1ba8d9" }
        },
        {
            "name": "Search Results Numbers",
            "scope": ["constant.numeric.line-number.find-in-files - match"],
            "settings": { "foreground": "#7a85909e" }
        },
        {
            "name": "Search Results Match Numbers",
            "scope": ["constant.numeric.line-number.match"],
            "settings": { "foreground": "#e07a3a" }
        },
        {
            "name": "Search Results Lines",
            "scope": ["entity.name.filename.find-in-files"],
            "settings": { "foreground": "#7ea33a" }
        },
        { "scope": ["message.error"], "settings": { "foreground": "#c94b45" } },
        {
            "name": "Markup heading",
            "scope": ["markup.heading", "markup.heading entity.name"],
            "settings": { "fontStyle": "bold", "foreground": "#7ea33a" }
        },
        {
            "name": "Markup links",
            "scope": ["markup.underline.link", "string.other.link"],
            "settings": { "foreground": "#1ba8d9" }
        },
        {
            "name": "Markup Italic/Emphasis",
            "scope": ["markup.italic", "emphasis"],
            "settings": { "fontStyle": "italic", "foreground": "#c96557" }
        },
        {
            "name": "Markup Bold",
            "scope": ["markup.bold"],
            "settings": { "fontStyle": "bold", "foreground": "#c96557" }
        },
        {
            "name": "Markup Underline",
            "scope": ["markup.underline"],
            "settings": { "fontStyle": "underline" }
        },
        {
            "name": "Markup Bold/italic",
            "scope": ["markup.italic markup.bold", "markup.bold markup.italic"],
            "settings": { "fontStyle": "bold italic" }
        },
        {
            "name": "Markup Code",
            "scope": ["markup.raw"],
            "settings": { "background": "#3d495605" }
        },
        {
            "name": "Markup Code Inline",
            "scope": ["markup.raw.inline"],
            "settings": { "background": "#3d49560f" }
        },
        {
            "name": "Markdown Separator",
            "scope": ["meta.separator"],
            "settings": {
                "fontStyle": "bold",
                "background": "#3d49560f",
                "foreground": "#7a85909e"
            }
        },
        {
            "name": "Markup Blockquote",
            "scope": ["markup.quote"],
            "settings": { "foreground": "#d59a32", "fontStyle": "italic" }
        },
        {
            "name": "Markup List Bullet",
            "scope": ["markup.list punctuation.definition.list.begin"],
            "settings": { "foreground": "#2dae87" }
        },
        {
            "name": "Markup added",
            "scope": ["markup.inserted"],
            "settings": { "foreground": "#4fa84b" }
        },
        {
            "name": "Markup modified",
            "scope": ["markup.changed"],
            "settings": { "foreground": "#27c4e8" }
        },
        {
            "name": "Markup removed",
            "scope": ["markup.deleted"],
            "settings": { "foreground": "#b9473f" }
        },
        {
            "name": "Markup Strike",
            "scope": ["markup.strike"],
            "settings": { "foreground": "#d7aa59" }
        },
        {
            "name": "Markup strong",
            "scope": ["markup.strong"],
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Markup Table",
            "scope": ["markup.table"],
            "settings": { "background": "#3d49560f", "foreground": "#1ba8d9" }
        },
        {
            "name": "Markup Raw Inline",
            "scope": ["text.html.markdown markup.inline.raw"],
            "settings": { "foreground": "#e58c55" }
        },
        {
            "name": "Markdown - Line Break",
            "scope": ["text.html.markdown meta.dummy.line-break"],
            "settings": { "background": "#7a85909e", "foreground": "#7a85909e" }
        },
        {
            "name": "Markdown - Raw Block Fenced",
            "scope": ["punctuation.definition.markdown"],
            "settings": { "background": "#3d4956", "foreground": "#7a85909e" }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "class": "#2e88c7",
        "class.defaultLibrary": "#1ba8d9",
        "enum": "#2e88c7",
        "enum.defaultLibrary": "#1ba8d9",
        "interface": "#1ba8d9",
        "interface.defaultLibrary": { "foreground": "#1ba8d9", "italic": true },
        "struct": "#2e88c7",
        "struct.defaultLibrary": "#1ba8d9",
        "type": "#2e88c7",
        "type.defaultLibrary": "#1ba8d9",
        "enumMember": "#d59a32",
        "event": "#e58c55",
        "function": "#2dae87",
        "method": "#2dae87",
        "macro": "#d7aa59",
        "comment": "#7a85909e",
        "string": "#7ea33a",
        "keyword": "#e07a3a",
        "number": "#8e68c7",
        "regexp": "#d59a32",
        "operator": "#e58c55"
    },
    "$schema": "vscode://schemas/color-theme"
}
