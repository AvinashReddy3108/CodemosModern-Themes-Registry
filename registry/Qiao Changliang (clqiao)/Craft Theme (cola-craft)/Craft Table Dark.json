    "tokenColors": [
        { "settings": { "background": "#2a2018", "foreground": "#f0e0d0" } },
        {
            "name": "Comment",
            "scope": ["comment"],
            "settings": { "fontStyle": "italic", "foreground": "#8aa6b88c" }
        },
        {
            "name": "String",
            "scope": ["string", "constant.other.symbol"],
            "settings": { "foreground": "#a6c66b" }
        },
        {
            "name": "Regular Expressions and Escape Characters",
            "scope": ["string.regexp", "constant.character", "constant.other"],
            "settings": { "foreground": "#d8a54f" }
        },
        {
            "name": "Number",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#b99ae0" }
        },
        {
            "name": "Built-in constants",
            "scope": ["constant.language"],
            "settings": { "foreground": "#b99ae0" }
        },
        {
            "name": "Variable",
            "scope": ["variable", "variable.parameter.function-call"],
            "settings": { "foreground": "#f0e0d0" }
        },
        {
            "name": "Member Variable",
            "scope": ["variable.member"],
            "settings": { "foreground": "#d86b76" }
        },
        {
            "name": "Language variable",
            "scope": ["variable.language"],
            "settings": { "fontStyle": "italic", "foreground": "#4db6d7" }
        },
        {
            "name": "Storage",
            "scope": ["storage"],
            "settings": { "foreground": "#d28b4b" }
        },
        {
            "name": "Keyword",
            "scope": ["keyword"],
            "settings": { "foreground": "#d28b4b" }
        },
        {
            "name": "Operators",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#d98b64" }
        },
        {
            "name": "Separators like ; or ,",
            "scope": ["punctuation.separator", "punctuation.terminator"],
            "settings": { "foreground": "#f0e0d0b3" }
        },
        {
            "name": "Punctuation",
            "scope": ["punctuation.section"],
            "settings": { "foreground": "#f0e0d0" }
        },
        {
            "name": "Accessor",
            "scope": ["punctuation.accessor"],
            "settings": { "foreground": "#d98b64" }
        },
        {
            "name": "JavaScript/TypeScript interpolation punctuation",
