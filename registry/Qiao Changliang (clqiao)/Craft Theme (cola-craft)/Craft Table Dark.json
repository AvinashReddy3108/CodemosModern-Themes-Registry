            "scope": [
                "support.type",
                "support.class",
                "source.go storage.type"
            ],
            "settings": { "foreground": "#4db6d7" }
        },
        {
            "name": "Decorators/annotation",
            "scope": [
                "meta.decorator variable.other",
                "meta.decorator punctuation.decorator",
                "storage.type.annotation",
                "entity.name.function.decorator"
            ],
            "settings": { "foreground": "#c8a46a" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid"],
            "settings": { "foreground": "#d95757" }
        },
        {
            "name": "diff.header",
            "scope": ["meta.diff", "meta.diff.header"],
            "settings": { "foreground": "#c594c5" }
        },
        {
            "name": "Ruby class methods",
            "scope": ["source.ruby variable.other.readwrite"],
            "settings": { "foreground": "#79c9b5" }
        },
        {
            "name": "CSS tag names",
            "scope": [
                "source.css entity.name.tag",
                "source.sass entity.name.tag",
                "source.scss entity.name.tag",
                "source.less entity.name.tag",
                "source.stylus entity.name.tag"
            ],
            "settings": { "foreground": "#5bbed6" }
        },
        {
            "name": "CSS browser prefix",
            "scope": [
                "source.css support.type",
                "source.sass support.type",
                "source.scss support.type",
                "source.less support.type",
                "source.stylus support.type"
            ],
            "settings": { "foreground": "#8aa6b88c" }
        },
        {
            "name": "CSS Properties",
            "scope": ["support.type.property-name"],
            "settings": { "fontStyle": "normal", "foreground": "#4db6d7" }
        },
        {
            "name": "Search Results Numbers",
            "scope": ["constant.numeric.line-number.find-in-files - match"],
            "settings": { "foreground": "#8aa6b88c" }
        },
        {
            "name": "Search Results Match Numbers",
            "scope": ["constant.numeric.line-number.match"],
            "settings": { "foreground": "#d28b4b" }
        },
        {
            "name": "Search Results Lines",
            "scope": ["entity.name.filename.find-in-files"],
            "settings": { "foreground": "#a6c66b" }
        },
        { "scope": ["message.error"], "settings": { "foreground": "#d95757" } },
        {
            "name": "Markup heading",
            "scope": ["markup.heading", "markup.heading entity.name"],
            "settings": { "fontStyle": "bold", "foreground": "#a6c66b" }
        },
        {
            "name": "Markup links",
            "scope": ["markup.underline.link", "string.other.link"],
            "settings": { "foreground": "#4db6d7" }
        },
        {
            "name": "Markup Italic/Emphasis",
            "scope": ["markup.italic", "emphasis"],
            "settings": { "fontStyle": "italic", "foreground": "#d86b76" }
        },
        {
            "name": "Markup Bold",
            "scope": ["markup.bold"],
            "settings": { "fontStyle": "bold", "foreground": "#d86b76" }
        },
        {
            "name": "Markup Underline",
            "scope": ["markup.underline"],
            "settings": { "fontStyle": "underline" }
        },
        {
            "name": "Markup Bold/italic",
            "scope": ["markup.italic markup.bold", "markup.bold markup.italic"],
            "settings": { "fontStyle": "bold italic" }
        },
        {
            "name": "Markup Code",
            "scope": ["markup.raw"],
            "settings": { "background": "#f0e0d005" }
        },
        {
            "name": "Markup Code Inline",
            "scope": ["markup.raw.inline"],
            "settings": { "background": "#f0e0d00f" }
        },
        {
            "name": "Markdown Separator",
            "scope": ["meta.separator"],
            "settings": {
                "fontStyle": "bold",
                "background": "#f0e0d00f",
                "foreground": "#8aa6b88c"
            }
        },
        {
            "name": "Markup Blockquote",
            "scope": ["markup.quote"],
            "settings": { "foreground": "#d8a54f", "fontStyle": "italic" }
        },
        {
            "name": "Markup List Bullet",
            "scope": ["markup.list punctuation.definition.list.begin"],
            "settings": { "foreground": "#79c9b5" }
        },
        {
            "name": "Markup added",
            "scope": ["markup.inserted"],
            "settings": { "foreground": "#70bf56" }
        },
        {
            "name": "Markup modified",
            "scope": ["markup.changed"],
            "settings": { "foreground": "#73b8ff" }
        },
        {
            "name": "Markup removed",
            "scope": ["markup.deleted"],
            "settings": { "foreground": "#f26d78" }
        },
        {
            "name": "Markup Strike",
            "scope": ["markup.strike"],
            "settings": { "foreground": "#c8a46a" }
        },
        {
            "name": "Markup strong",
            "scope": ["markup.strong"],
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Markup Table",
            "scope": ["markup.table"],
            "settings": { "background": "#f0e0d00f", "foreground": "#4db6d7" }
        },
        {
            "name": "Markup Raw Inline",
            "scope": ["text.html.markdown markup.inline.raw"],
            "settings": { "foreground": "#d98b64" }
        },
        {
            "name": "Markdown - Line Break",
            "scope": ["text.html.markdown meta.dummy.line-break"],
            "settings": { "background": "#8aa6b88c", "foreground": "#8aa6b88c" }
        },
        {
            "name": "Markdown - Raw Block Fenced",
            "scope": ["punctuation.definition.markdown"],
            "settings": { "background": "#f0e0d0", "foreground": "#8aa6b88c" }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "class": "#5bbed6",
        "class.defaultLibrary": "#4db6d7",
        "enum": "#5bbed6",
        "enum.defaultLibrary": "#4db6d7",
        "interface": "#4db6d7",
        "interface.defaultLibrary": { "foreground": "#4db6d7", "italic": true },
        "struct": "#5bbed6",
        "struct.defaultLibrary": "#4db6d7",
        "type": "#5bbed6",
        "type.defaultLibrary": "#4db6d7",
        "enumMember": "#d8a54f",
        "event": "#d98b64",
        "function": "#79c9b5",
        "method": "#79c9b5",
        "macro": "#c8a46a",
        "comment": "#8aa6b88c",
        "string": "#a6c66b",
        "keyword": "#d28b4b",
        "number": "#b99ae0",
        "regexp": "#d8a54f",
        "operator": "#d98b64"
    },
    "$schema": "vscode://schemas/color-theme"
}
