    "tokenColors": [
        {
            "name": "Text between tags",
            "scope": ["text.html"],
            "settings": { "foreground": "#ffffff" }
        },
        {
            "name": "Default code color",
            "scope": ["meta.embedded"],
            "settings": { "foreground": "#cfe8eb" }
        },
        {
            "name": "Comment",
            "scope": ["comment"],
            "settings": { "foreground": "#8ecc76" }
        },
        {
            "name": "Built-in constant",
            "scope": "constant.language",
            "settings": { "foreground": "#60aef0" }
        },
        {
            "name": "Number",
            "scope": "constant.numeric",
            "settings": { "foreground": "#ff9a75" }
        },
        {
            "name": "Keyword",
            "scope": [
                "keyword.control",
                "keyword.operator.logical",
                "keyword.other"
            ],
            "settings": { "fontStyle": "italic", "foreground": "#87c1f3" }
        },
        {
            "name": "Storage",
            "scope": ["storage"],
            "settings": { "fontStyle": "italic", "foreground": "#87c1f3" }
        },
        {
            "name": "String",
            "scope": "string",
            "settings": { "foreground": "#9fa9ad" }
        },
        {
            "name": "Variable",
            "scope": "variable",
            "settings": { "foreground": "#ecdfa2" }
        },
        {
            "name": "Variable property",
            "scope": "variable.other.property",
            "settings": { "foreground": "#cfe8eb" }
        },
        {
            "name": "[PHP] embedded",
            "scope": [
                "punctuation.section.embedded.begin.php",
                "punctuation.section.embedded.end.php"
            ],
            "settings": { "foreground": "#eb8e42" }
        },
        {
            "name": "[PHP] namespace",
            "scope": ["support.class.php", "support.other.namespace.php"],
            "settings": { "foreground": "#bca0f0" }
        },
        {
            "name": "[PHP] namespace separator",
            "scope": ["punctuation.separator.inheritance.php"],
            "settings": { "foreground": "#cfe8eb" }
        },
        {
            "name": "[JSON] property",
            "scope": "string.quoted.double.json",
            "settings": { "foreground": "#87c1f3" }
        },
        {
            "name": "[HTML] Tag",
            "scope": ["entity.name.tag", "punctuation.definition.tag"],
            "settings": { "foreground": "#9fa9ad" }
        },
        {
            "name": "[HTML] attribute",
            "scope": [
                "entity.other.attribute-name",
                "punctuation.separator.key-value.html",
                "meta.tag"
            ],
            "settings": { "foreground": "#cfe8eb" }
        },
        {
            "name": "[HTML] property",
            "scope": ["string.quoted.single.html", "string.quoted.double.html"],
            "settings": { "foreground": "#add5f7" }
        },
        {
            "name": "[HTML] symbol code",
            "scope": "constant.character.entity",
            "settings": { "foreground": "#ffefbe", "fontStyle": "italic" }
        },
        {
            "name": "[Smarty] code",
            "scope": [
                "source.smarty",
                "keyword.control.smarty",
                "keyword.operator.logical.smarty"
            ],
            "settings": { "foreground": "#87c1f3" }
        },
        {
            "name": "[Smarty] function",
            "scope": ["support.function.built-in.smarty"],
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "[Smarty] variable property",
            "scope": [
                "variable.other.property.smarty",
                "keyword.operator.class.smarty"
            ],
            "settings": { "foreground": "#cfe8eb" }
        },
        {
            "name": "[Twig] tag",
            "scope": ["punctuation.section.tag.twig", "keyword.control.twig"],
            "settings": { "foreground": "#87c1f3" }
        },
        {
            "name": "[CSS] tag selector",
            "scope": "entity.name.tag.css",
            "settings": { "foreground": "#60aef0" }
        },
        {
            "name": "[CSS] id selector",
            "scope": "entity.other.attribute-name.id.css",
            "settings": { "foreground": "#bca0f0" }
        },
        {
            "name": "[CSS] property name",
            "scope": "support.type.property-name.css",
            "settings": { "foreground": "#9fa9ad" }
        },
        {
            "name": "[CSS] value",
            "scope": [
                "meta.property-value.css",
                "source.css keyword.other.unit"
            ],
            "settings": { "fontStyle": "", "foreground": "#8ec5ef" }
        },
        {
            "name": "[CSS] vendored",
            "scope": [
                "support.type.vendored.property-name.css",
                "support.constant.vendored.property-value.css"
            ],
            "settings": { "foreground": "#ffffff" }
        },
        {
            "name": "[CSS] pseudo element and media",
            "scope": [
                "entity.other.attribute-name.pseudo-element.css",
                "entity.other.attribute-name.pseudo-class.css",
                "keyword.control.at-rule.media.css",
                "meta.at-rule.media.header.css",
                "punctuation.section.media.begin.bracket.curly.css",
                "punctuation.section.media.end.bracket.curly.css"
            ],
            "settings": { "foreground": "#ecdfa2" }
        },
        {
            "name": "[CSS] important",
            "scope": "keyword.other.important.css",
            "settings": { "foreground": "#fb91ac" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
