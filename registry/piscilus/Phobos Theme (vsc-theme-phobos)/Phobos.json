    "tokenColors": [
        {
            "name": "Dim Grey",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#696969" }
        },
        {
            "name": "Silver",
            "scope": [
                "markup.italic.markdown",
                "punctuation.definition.italic"
            ],
            "settings": { "foreground": "#808080" }
        },
        {
            "name": "Silver Bold",
            "scope": [
                "keyword",
                "markup.bold.markdown",
                "punctuation.definition.bold"
            ],
            "settings": { "foreground": "#808080", "fontStyle": "bold" }
        },
        {
            "name": "Grey",
            "scope": [
                "keyword.control.directive",
                "keyword.operator.sizeof",
                "punctuation.definition.directive",
                "storage",
                "support.type"
            ],
            "settings": { "foreground": "#D4D4D4" }
        },
        {
            "name": "Light Grey",
            "scope": ["variable", "markup.fenced_code"],
            "settings": { "foreground": "#C0C0C0" }
        },
        {
            "name": "White",
            "scope": [
                "entity.name.function",
                "entity.name.function.preprocessor",
                "keyword.operator"
            ],
            "settings": { "foreground": "#FFFFFF" }
        },
        {
            "name": "Yellow",
            "scope": [
                "entity.name.tag",
                "entity.name.section",
                "punctuation.brackets",
                "punctuation.definition",
                "punctuation.section",
                "punctuation.separator",
                "punctuation.terminator",
                "fenced_code.block.language",
                "storage.modifier.array.bracket.square"
            ],
            "settings": { "foreground": "#FACA30" }
        },
        {
            "name": "Light Yellow",
            "scope": ["constant.numeric", "keyword.other.unit"],
            "settings": { "foreground": "#FFEDBE" }
        },
        {
            "name": "Green",
            "scope": [
                "punctuation.definition.string",
                "constant.character",
                "string"
            ],
            "settings": { "foreground": "#7DC734" }
        },
        {
            "name": "Blue",
            "scope": ["meta.link"],
            "settings": { "foreground": "#4973FB" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
