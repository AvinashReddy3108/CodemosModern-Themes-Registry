            "settings": { "foreground": "#e89ac7" }
        },
        {
            "name": "JSX Attribute Names",
            "scope": "entity.other.attribute-name.jsx, entity.other.attribute-name.tsx",
            "settings": { "foreground": "#c9b7e8" }
        },
        {
            "name": "C-related Block Level Variables",
