            "settings": { "foreground": "#d4d9e8" }
        },
        {
            "name": "Member Access Meta",
            "scope": "source.python meta.member.access.python",
            "settings": { "foreground": "#c9b7e8" }
        },
        {
            "name": "Function Call",
