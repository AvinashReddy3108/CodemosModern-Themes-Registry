{
    "name": "Daft Grid Legacy",
    "type": "dark",
    "colors": {
        "editor.background": "#0A0A12",
        "editor.foreground": "#bef6ea",
        "editorCursor.foreground": "#00F6FF",
        "editor.lineHighlightBackground": "#10101A80",
        "activityBar.background": "#000000",
        "activityBar.foreground": "#FFD700",
        "statusBar.background": "#000000",
        "statusBar.foreground": "#FFD700",
        "tab.activeBorder": "#00F6FF",
        "button.background": "#c4ab1b",
        "button.foreground": "#000000",
        "input.border": "#00B4FF",
        "focusBorder": "#FFD700",
        "editorLineNumber.foreground": "#00B4FF",
        "editor.selectionBackground": "#00336680"
    },
    "tokenColors": [
        {
            "scope": ["keyword", "storage"],
            "settings": { "foreground": "#00F6FF", "fontStyle": "bold" }
        },
        { "scope": ["string"], "settings": { "foreground": "#FFD700" } },
        {
            "scope": ["number", "constant"],
            "settings": { "foreground": "#BB86FC" }
        },
        {
            "scope": ["comment"],
            "settings": { "foreground": "#555588", "fontStyle": "italic" }
        },
        {
            "scope": ["function", "method"],
            "settings": { "foreground": "#00FFC2" }
        },
        { "scope": ["type", "class"], "settings": { "foreground": "#FFD700" } },
        { "scope": ["operator"], "settings": { "foreground": "#00B4FF" } }
    ],
    "$schema": "vscode://schemas/color-theme"
}
