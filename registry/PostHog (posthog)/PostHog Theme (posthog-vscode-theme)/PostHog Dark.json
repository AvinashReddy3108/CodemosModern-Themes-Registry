    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "fontStyle": "italic", "foreground": "#6B6B66" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "string constant.other.placeholder"],
            "settings": { "foreground": "#E2E2DD" }
        },
        {
            "name": "Variable Property",
            "scope": [
                "variable.other.property",
                "variable.other.object.property"
            ],
            "settings": { "foreground": "#9CDCFE" }
        },
        {
            "name": "Variable Parameter",
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#F87A4C" }
        },
        {
            "name": "Language Variable (this/self)",
            "scope": ["variable.language"],
            "settings": { "fontStyle": "italic", "foreground": "#F54E00" }
        },
        {
            "name": "Constants",
            "scope": [
                "constant.numeric",
                "constant.language",
                "support.constant",
                "constant.character",
                "constant.escape"
            ],
            "settings": { "foreground": "#FFBA53" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#F35454" }
        },
        {
            "name": "Keyword",
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#B62AD9" }
        },
        {
            "name": "Keyword Control",
            "scope": ["keyword.control"],
            "settings": { "foreground": "#A56EFF" }
        },
        {
            "name": "Keyword Operator",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#E2E2DD" }
        },
        {
            "name": "Keyword Unit",
            "scope": ["keyword.other.unit"],
            "settings": { "foreground": "#FFBA53" }
        },
        {
            "name": "Operator",
            "scope": [
                "keyword.operator.assignment",
                "keyword.operator.arithmetic",
                "keyword.operator.logical",
                "keyword.operator.comparison",
                "keyword.operator.ternary"
            ],
            "settings": { "foreground": "#30ABC6" }
        },
        {
            "name": "Punctuation",
            "scope": ["punctuation", "meta.brace", "meta.delimiter"],
            "settings": { "foreground": "#C8CAC1" }
        },
        {
            "name": "Function Declaration",
            "scope": [
                "entity.name.function",
                "meta.function-call",
                "variable.function",
                "support.function",
                "keyword.other.special-method"
            ],
            "settings": { "foreground": "#2F80FA" }
        },
        {
            "name": "Function Parameter",
            "scope": ["meta.function.parameters variable.parameter"],
            "settings": { "foreground": "#F87A4C" }
        },
        {
            "name": "String",
            "scope": ["string", "constant.other.symbol", "constant.other.key"],
            "settings": { "foreground": "#5F9D32" }
        },
        {
            "name": "String Template",
            "scope": [
                "string.template",
                "punctuation.definition.template-expression"
            ],
            "settings": { "foreground": "#5F9D32" }
        },
        {
            "name": "String Template Expression",
            "scope": ["meta.template.expression"],
            "settings": { "foreground": "#E2E2DD" }
        },
        {
            "name": "Regular Expression",
            "scope": ["string.regexp"],
            "settings": { "foreground": "#29DBBB" }
        },
        {
            "name": "Escape Character",
            "scope": ["constant.character.escape"],
            "settings": { "foreground": "#30ABC6" }
        },
        {
            "name": "Type",
            "scope": [
                "support.type",
                "support.class",
                "entity.name.type",
                "entity.name.class",
                "entity.other.inherited-class"
            ],
            "settings": { "foreground": "#29DBBB" }
        },
        {
            "name": "Type Parameter",
            "scope": ["entity.name.type.parameter"],
            "settings": { "foreground": "#30ABC6" }
        },
        {
            "name": "Interface",
            "scope": ["entity.name.type.interface"],
            "settings": { "foreground": "#29DBBB" }
        },
        {
            "name": "Enum",
            "scope": ["entity.name.type.enum"],
            "settings": { "foreground": "#29DBBB" }
        },
        {
            "name": "Enum Member",
            "scope": ["variable.other.enummember"],
            "settings": { "foreground": "#FFBA53" }
        },
        {
            "name": "Namespace",
            "scope": ["entity.name.namespace", "entity.name.module"],
            "settings": { "foreground": "#E2E2DD" }
        },
        {
            "name": "Decorator",
            "scope": ["meta.decorator", "meta.decorator entity.name.function"],
            "settings": { "fontStyle": "italic", "foreground": "#F7A501" }
        },
        {
            "name": "Tag",
            "scope": ["entity.name.tag", "meta.tag.sgml"],
            "settings": { "foreground": "#F54E00" }
        },
        {
            "name": "Tag Punctuation",
            "scope": [
                "punctuation.definition.tag",
                "punctuation.definition.tag.html",
                "punctuation.definition.tag.begin.html",
                "punctuation.definition.tag.end.html"
            ],
            "settings": { "foreground": "#8F8F8A" }
        },
        {
            "name": "Attribute Name",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#F7A501" }
        },
        {
            "name": "Attribute Value",
            "scope": ["meta.tag string.quoted"],
            "settings": { "foreground": "#5F9D32" }
        },
        {
            "name": "Component (JSX/TSX)",
            "scope": ["support.class.component"],
            "settings": { "foreground": "#29DBBB" }
        },
        {
            "name": "CSS Property",
            "scope": [
                "support.type.property-name.css",
                "support.type.property-name.scss",
                "support.type.property-name.less",
                "support.type.property-name.sass"
            ],
            "settings": { "foreground": "#9CDCFE" }
        },
        {
            "name": "CSS Value",
            "scope": [
                "support.constant.property-value.css",
                "support.constant.css"
            ],
            "settings": { "foreground": "#FFBA53" }
        },
        {
            "name": "CSS Class",
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.class.scss"
            ],
            "settings": { "foreground": "#F7A501" }
        },
        {
            "name": "CSS ID",
            "scope": [
                "entity.other.attribute-name.id.css",
                "entity.other.attribute-name.id.scss"
            ],
            "settings": { "foreground": "#2F80FA" }
        },
        {
            "name": "CSS Pseudo-class/element",
            "scope": [
                "entity.other.attribute-name.pseudo-class.css",
                "entity.other.attribute-name.pseudo-element.css"
            ],
            "settings": { "foreground": "#30ABC6" }
        },
        {
            "name": "JSON Key - Level 0",
            "scope": [
                "source.json meta.structure.dictionary.json support.type.property-name.json"
            ],
            "settings": { "foreground": "#2F80FA" }
        },
        {
            "name": "JSON Key - Level 1",
            "scope": [
                "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
            ],
            "settings": { "foreground": "#F7A501" }
        },
        {
            "name": "JSON Key - Level 2",
            "scope": [
                "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
            ],
            "settings": { "foreground": "#29DBBB" }
        },
        {
            "name": "JSON Key - Level 3",
            "scope": [
                "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
            ],
            "settings": { "foreground": "#B62AD9" }
        },
        {
            "name": "JSON Key - Level 4",
            "scope": [
                "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
            ],
            "settings": { "foreground": "#F54E00" }
        },
        {
            "name": "JSON Key - Level 5",
            "scope": [
                "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
            ],
            "settings": { "foreground": "#30ABC6" }
        },
        {
            "name": "Markdown Plain",
            "scope": [
                "text.html.markdown",
                "punctuation.definition.list_item.markdown"
            ],
            "settings": { "foreground": "#E2E2DD" }
        },
        {
            "name": "Markdown Heading",
            "scope": [
                "markdown.heading",
                "markup.heading | markup.heading entity.name",
                "markup.heading.markdown punctuation.definition.heading.markdown"
            ],
            "settings": { "fontStyle": "bold", "foreground": "#F7A501" }
        },
        {
            "name": "Markdown Bold",
            "scope": ["markup.bold", "markup.bold string"],
            "settings": { "fontStyle": "bold", "foreground": "#F54E00" }
        },
        {
            "name": "Markdown Italic",
            "scope": ["markup.italic"],
            "settings": { "fontStyle": "italic", "foreground": "#A56EFF" }
        },
        {
            "name": "Markdown Link",
            "scope": [
                "string.other.link.title.markdown",
                "string.other.link.description.markdown"
            ],
            "settings": { "foreground": "#2F80FA" }
        },
        {
            "name": "Markdown Link URL",
            "scope": ["markup.underline.link.markdown"],
            "settings": { "fontStyle": "underline", "foreground": "#8F8F8A" }
        },
        {
            "name": "Markdown Code",
            "scope": [
                "markup.inline.raw.markdown",
                "markup.fenced_code.block.markdown"
            ],
            "settings": { "foreground": "#29DBBB" }
        },
        {
            "name": "Markdown Blockquote",
            "scope": [
                "markup.quote",
                "markup.quote punctuation.definition.blockquote.markdown"
            ],
            "settings": { "fontStyle": "italic", "foreground": "#6B6B66" }
        },
        {
            "name": "Markdown Separator",
            "scope": ["meta.separator"],
            "settings": { "fontStyle": "bold", "foreground": "#3A3B40" }
        },
        {
            "name": "Inserted",
            "scope": ["markup.inserted"],
            "settings": { "foreground": "#5F9D32" }
        },
        {
            "name": "Deleted",
            "scope": ["markup.deleted"],
            "settings": { "foreground": "#F35454" }
        },
        {
            "name": "Changed",
            "scope": ["markup.changed"],
            "settings": { "foreground": "#F7A501" }
        },
        {
            "name": "URL",
            "scope": ["*url*", "*link*", "*uri*"],
            "settings": { "fontStyle": "underline" }
        },
        {
            "name": "Python Self",
            "scope": [
