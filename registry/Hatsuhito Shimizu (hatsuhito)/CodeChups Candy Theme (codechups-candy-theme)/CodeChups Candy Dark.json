{"name":"CodeChups Candy Dark","type":"dark","semanticHighlighting":true,"colors":{"editor.background":"#282C34","editor.foreground":"#ABB2BF","editor.selectionBackground":"#F371A04D","editor.lineHighlightBackground":"#383E4A","editorCursor.foreground":"#F8F8F0","sideBar.background":"#21252B","sideBar.foreground":"#D7DAE0","statusBar.background":"#21252B","statusBar.foreground":"#9DA5B4"},"tokenColors":[{"name":"Comments","scope":"comment, punctuation.definition.comment","settings":{"foreground":"#6C737E","fontStyle":"italic"}},{"name":"Keywords","scope":"keyword","settings":{"foreground":"#F371A0"}},{"name":"Strings","scope":"string, entity.other.inherited-class","settings":{"foreground":"#A6E830"}},{"name":"Functions","scope":"entity.name.function, meta.require, support.function.any-method","settings":{"foreground":"#3D98F4"}},{"name":"Variables","scope":"variable","settings":{"foreground":"#E06C75"}},{"name":"Classes/Types","scope":"entity.name.type, entity.name.class, entity.name.namespace, support.class, entity.other.inherited-class","settings":{"foreground":"#FFDD33"}},{"name":"Numbers","scope":"constant.numeric, constant.language.boolean, constant.language.json","settings":{"foreground":"#FF9932"}},{"name":"Object Properties","scope":"support.type.property-name, support.variable.property","settings":{"foreground":"#E06C75"}},{"name":"HTML Tags","scope":["entity.name.tag","meta.tag"],"settings":{"foreground":"#F371A0"}},{"name":"HTML Attribute Names","scope":["entity.other.attribute-name.html","meta.attribute"],"settings":{"foreground":"#FFD84A"}},{"name":"HTML Attribute Values","scope":["string.quoted.double.html","string.quoted.single.html"],"settings":{"foreground":"#A6E830"}},{"name":"HTML Text Content","scope":["text.html.basic"],"settings":{"foreground":"#CFCFD1"}}],"$schema":"vscode://schemas/color-theme"}