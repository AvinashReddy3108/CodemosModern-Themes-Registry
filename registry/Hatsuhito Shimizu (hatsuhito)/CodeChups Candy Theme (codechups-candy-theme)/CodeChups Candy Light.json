{
    "name": "CodeChups Candy Light",
    "type": "light",
    "colors": {
        "editor.background": "#ffffff",
        "editor.foreground": "#383A42",
        "editor.selectionBackground": "#F9CFE04D",
        "editor.lineHighlightBackground": "#f5f5f5",
        "editorCursor.foreground": "#202020",
        "sideBar.background": "#F9F9F9",
        "sideBar.foreground": "#333333",
        "statusBar.background": "#F9F9F9",
        "statusBar.foreground": "#555555"
    },
    "tokenColors": [
        {
            "name": "Comment / Doc",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#999999", "fontStyle": "italic" }
        },
        {
            "name": "Core Keywords",
            "scope": ["keyword", "storage"],
            "settings": { "foreground": "#D81B60", "fontStyle": "bold" }
        },
        {
            "name": "Strings / Characters",
            "scope": ["string", "constant.character"],
            "settings": { "foreground": "#58840A" }
        },
        {
            "name": "Function Names",
            "scope": ["entity.name.function", "meta.function-call"],
            "settings": { "foreground": "#0A65C1" }
        },
        {
            "name": "Variables / Params",
            "scope": ["variable", "variable.parameter"],
            "settings": { "foreground": "#C3222E" }
        },
        {
            "name": "Types / Classes",
            "scope": [
                "entity.name.class",
                "support.class",
                "storage.type.class"
            ],
            "settings": { "foreground": "#89750F" }
        },
        {
            "name": "Constants / Numbers",
            "scope": ["constant.numeric", "constant.language.boolean"],
            "settings": { "foreground": "#B25900" }
        },
        {
            "name": "Properties / Attributes",
            "scope": ["support.variable.property", "meta.object-literal.key"],
            "settings": { "foreground": "#C3222E" }
        },
        {
            "name": "HTML Tags",
            "scope": ["entity.name.tag", "meta.tag"],
            "settings": { "foreground": "#D81B60" }
        },
        {
            "name": "HTML Attribute Names",
            "scope": ["entity.other.attribute-name.html", "meta.attribute"],
            "settings": { "foreground": "#89750F" }
        },
        {
            "name": "HTML Attribute Values",
            "scope": ["string.quoted.double.html", "string.quoted.single.html"],
            "settings": { "foreground": "#58840A" }
        },
        {
            "name": "HTML Text Content",
            "scope": ["text.html.basic"],
            "settings": { "foreground": "#383A42" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
