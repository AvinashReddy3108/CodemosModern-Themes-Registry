    "tokenColors": [
        {
            "scope": ["comment", "comment.block", "comment.line"],
            "settings": { "foreground": "#75715E" }
        },
        {
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#F92672" }
        },
        {
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#F8F8F2" }
        },
        {
            "scope": ["string", "constant.character", "constant.other"],
            "settings": { "foreground": "#E6DB74" }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.language",
                "constant.character.escape"
            ],
            "settings": { "foreground": "#AE81FF" }
        },
        {
            "scope": ["variable", "variable.other"],
            "settings": { "foreground": "#FFFFFF" }
        },
        {
            "scope": ["variable.language"],
            "settings": { "foreground": "#F92672" }
        },
        {
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#FD971F" }
        },
        {
            "scope": ["function", "entity.name.function", "support.function"],
            "settings": { "foreground": "#A6E22E" }
        },
        {
            "scope": ["entity.name.class", "entity.name.type", "support.class"],
            "settings": { "foreground": "#66D9EF" }
        },
        {
            "scope": ["entity.name.tag", "meta.tag.sgml"],
            "settings": { "foreground": "#F92672" }
        },
        {
            "scope": [
                "entity.other.attribute-name",
                "entity.other.attribute-name.html",
                "entity.other.attribute-name.class",
                "entity.other.attribute-name.id"
            ],
            "settings": { "foreground": "#66D9EF" }
        },
        {
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#66D9EF" }
        },
        { "scope": ["string.json"], "settings": { "foreground": "#E6DB74" } },
        {
            "scope": [
                "source.css support.type.property-name",
                "source.css support.type.vendored.property-name"
            ],
            "settings": { "foreground": "#66D9EF" }
        },
        {
            "scope": ["source.css entity.name.tag"],
            "settings": { "foreground": "#A6E22E" }
        },
        {
            "scope": ["source.css entity.other.attribute-name"],
            "settings": { "foreground": "#66D9EF" }
        },
        {
            "scope": [
                "source.css support.constant",
                "source.css constant.other.color"
            ],
            "settings": { "foreground": "#AE81FF" }
        },
        {
            "scope": [
                "meta.decorator",
                "punctuation.decorator",
                "storage.type.annotation"
            ],
            "settings": { "foreground": "#A6E22E" }
        },
        {
            "scope": ["entity.name.namespace", "entity.name.type.namespace"],
            "settings": { "foreground": "#66D9EF" }
        },
        {
            "scope": ["markup.heading", "punctuation.definition.heading"],
            "settings": { "foreground": "#FF69B4", "fontStyle": "bold" }
        },
        {
            "scope": ["markup.bold"],
            "settings": { "foreground": "#FFFFFF", "fontStyle": "bold" }
        },
        {
            "scope": ["markup.italic"],
            "settings": { "foreground": "#FFFFFF", "fontStyle": "italic" }
        },
        {
            "scope": ["markup.inline.raw", "markup.fenced_code.block"],
            "settings": { "foreground": "#E6DB74" }
        },
        {
            "scope": ["markup.underline.link"],
            "settings": { "foreground": "#66D9EF" }
        },
        {
            "scope": [
                "support.type.property-name.yaml",
                "entity.name.tag.yaml"
            ],
            "settings": { "foreground": "#66D9EF" }
        },
        {
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#F92672", "fontStyle": "underline" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
