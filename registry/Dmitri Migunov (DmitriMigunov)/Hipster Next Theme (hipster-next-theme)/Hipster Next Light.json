{
    "name": "Hipster Next Light",
    "type": "light",
    "semanticHighlighting": true,
    "colors": {
        "editor.background": "#FFFFFF",
        "editor.foreground": "#24292E",
        "editorGroupHeader.tabsBackground": "#F0F0F0",
        "editorGroupHeader.border": "#D0D0D0",
        "dropdown.background": "#FFFFFF",
        "input.background": "#FFFFFF",
        "sideBar.background": "#FAF8F5",
        "sideBar.foreground": "#495057",
        "sideBar.border": "#CED4DA",
        "activityBar.background": "#E9E7E4",
        "activityBar.foreground": "#6C757D",
        "activityBar.inactiveForeground": "#ADB5BD",
        "activityBar.activeBorder": "#000000",
        "activityBar.border": "#DEE2E6",
        "activityBarBadge.background": "#2E5E4E",
        "activityBarBadge.foreground": "#FFFFFF",
        "tab.activeBackground": "#C8D8C8",
        "tab.activeForeground": "#212529",
        "tab.inactiveBackground": "#E8E8E8",
        "tab.inactiveForeground": "#495057",
        "tab.border": "#CED4DA",
        "tab.activeBorderTop": "#000000",
        "tab.hoverBackground": "#E9E7E4",
        "statusBar.background": "#E9E7E4",
        "statusBar.foreground": "#2E5E4E",
        "statusBar.noFolderBackground": "#E9E7E4",
        "statusBar.noFolderForeground": "#2E5E4E",
        "statusBar.debuggingBackground": "#FFECF0",
        "statusBar.debuggingForeground": "#D81B60",
        "breadcrumb.background": "#FAF8F5",
        "breadcrumb.foreground": "#495057",
        "breadcrumb.focusForeground": "#2E5E4E",
        "breadcrumb.activeSelectionForeground": "#2E5E4E",
        "breadcrumbPicker.background": "#FFFFFF",
        "editorGutter.background": "#F8F5F0",
        "editorLineNumber.foreground": "#ADB5BD",
        "editorLineNumber.activeForeground": "#2E5E4E",
        "editorCursor.foreground": "#2E5E4E",
        "editor.selectionBackground": "#E9ECEF",
        "editor.selectionHighlightBackground": "#82B7FF40",
        "editor.inactiveSelectionBackground": "#B6D7FF40",
        "editor.lineHighlightBackground": "#F8F9FA",
        "editorWhitespace.foreground": "#E9ECEF",
        "editor.wordHighlightBackground": "#B6D7FF30",
        "editor.wordHighlightStrongBackground": "#82B7FF30",
        "editorSuggestWidget.selectedBackground": "#B6D7FF80",
        "editorIndentGuide.background1": "#F0F0F0",
        "editorIndentGuide.activeBackground1": "#DEE2E6",
        "list.activeSelectionBackground": "#F8F9FA",
        "list.activeSelectionForeground": "#212529",
        "list.hoverBackground": "#F8F9FA",
        "sideBarSectionHeader.background": "#FFFFFF",
        "sideBarTitle.foreground": "#2E5E4E",
        "editorError.foreground": "#D32F2F",
        "problemsErrorIcon.foreground": "#D32F2F",
        "list.errorForeground": "#D32F2F",
        "editorWarning.foreground": "#F57C00",
        "problemsWarningIcon.foreground": "#F57C00",
        "list.warningForeground": "#F57C00",
        "editorInfo.foreground": "#2E5E4E",
        "problemsInfoIcon.foreground": "#2E5E4E",
        "gitDecoration.addedResourceForeground": "#2E7D32",
        "gitDecoration.modifiedResourceForeground": "#F57C00",
        "gitDecoration.deletedResourceForeground": "#D32F2F",
        "gitDecoration.ignoredResourceForeground": "#ADB5BD"
    },
    "tokenColors": [
        {
            "name": "Keywords",
            "scope": "keyword.control, keyword.operator",
            "settings": { "foreground": "#4e342e", "fontStyle": "bold" }
        },
        {
            "name": "KeywordsOther",
            "scope": "keyword, keyword.other, keyword.type",
            "settings": { "foreground": "#4e342e", "fontStyle": "bold" }
        },
        {
            "name": "Variables",
            "scope": "variable, variable.other, variable.parameter, variable.other.readwrite",
            "settings": { "foreground": "#2c3e50" }
        },
        {
            "name": "Properties",
            "scope": "variable.other.property, variable.other.object.property",
            "settings": { "foreground": "#1a5276" }
        },
        {
            "name": "Function parameters",
            "scope": "variable.parameter.function",
            "settings": { "foreground": "#8e44ad" }
        },
        {
            "name": "Functions",
            "scope": "entity.name.function, entity.name.method, support.function",
            "settings": { "foreground": "#e74c3c", "fontStyle": "bold" }
        },
        {
            "name": "Types",
            "scope": "entity.name.type, entity.name.class, entity.name.interface, entity.name.enum, support.class, support.type",
            "settings": { "foreground": "#9b59b6" }
        },
        {
            "name": "Strings",
            "scope": "string, string.quoted, string.unquoted",
            "settings": { "foreground": "#1e8449" }
        },
        {
            "name": "Numbers",
            "scope": "constant.numeric, constant.language, constant.boolean",
            "settings": { "foreground": "#f39c12", "fontStyle": "bold" }
        },
        {
            "name": "Comments",
            "scope": "comment, comment.block, comment.line",
            "settings": { "foreground": "#8e44ad", "fontStyle": "italic" }
        },
        {
            "name": "Tags",
            "scope": "entity.name.tag, meta.tag, punctuation.definition.tag",
            "settings": { "foreground": "#e74c3c" }
        },
        {
            "name": "HTML tag names",
            "scope": "entity.name.tag.html",
            "settings": { "foreground": "#e74c3c", "fontStyle": "bold" }
        },
        {
            "name": "HTML attributes",
            "scope": "meta.tag.attribute-with-value.html entity.other.attribute-name.html",
            "settings": { "foreground": "#2c3e50" }
        },
        {
            "name": "HTML strings",
            "scope": "string.quoted.double.html, string.quoted.single.html",
            "settings": { "foreground": "#1e8449" }
        },
        {
            "name": "HTML numbers",
            "scope": "constant.numeric.html",
            "settings": { "foreground": "#f39c12" }
        },
        {
            "name": "PHP keywords",
            "scope": "keyword.control.php, keyword.operator.php",
            "settings": { "foreground": "#4e342e", "fontStyle": "bold" }
        },
        {
            "name": "PHP variables",
            "scope": "variable.other.php",
            "settings": { "foreground": "#2c3e50" }
        },
        {
            "name": "PHP variable assignments",
            "scope": "variable.other.readwrite.php",
            "settings": { "foreground": "#1e8449" }
        },
        {
            "name": "PHP functions",
            "scope": "support.function.php",
            "settings": { "foreground": "#e74c3c" }
        },
        {
            "name": "PHP strings",
            "scope": "string.quoted.double.php, string.quoted.single.php",
            "settings": { "foreground": "#1e8449" }
        },
        {
            "name": "PHP numbers",
            "scope": "constant.numeric.php",
            "settings": { "foreground": "#f39c12" }
        },
        {
            "name": "JS/TS keywords",
            "scope": "keyword.control.js, keyword.control.ts, keyword.operator.js, keyword.operator.ts",
            "settings": { "foreground": "#4e342e", "fontStyle": "bold" }
        },
        {
            "name": "JS/TS variables",
            "scope": "variable.other.readwrite.js, variable.other.readwrite.ts",
            "settings": { "foreground": "#2c3e50" }
        },
        {
            "name": "JS/TS constants",
            "scope": "variable.other.constant.js, variable.other.constant.ts",
            "settings": { "foreground": "#1e8449" }
        },
        {
            "name": "JS/TS functions",
            "scope": "support.function.js, support.function.ts, entity.name.function.js, entity.name.function.ts",
            "settings": { "foreground": "#e74c3c" }
        },
        {
            "name": "JS/TS strings",
            "scope": "string.quoted.double.js, string.quoted.single.js, string.quoted.double.ts, string.quoted.single.ts",
            "settings": { "foreground": "#1e8449" }
        },
        {
            "name": "JS/TS numbers",
            "scope": "constant.numeric.js, constant.numeric.ts",
            "settings": { "foreground": "#f39c12" }
        },
        {
            "name": "JS/TS classes",
            "scope": "entity.name.type.class.js, entity.name.type.class.ts",
            "settings": { "foreground": "#9b59b6" }
        },
        {
            "name": "JS/TS this",
            "scope": "variable.language.this.js, variable.language.this.ts",
            "settings": { "foreground": "#3498db", "fontStyle": "italic" }
        },
        {
            "name": "TSX tags",
            "scope": "meta.tag.js, meta.tag.tsx, meta.tag.jsx",
            "settings": { "foreground": "#2c3e50" }
        },
        {
            "name": "TSX tag names",
            "scope": "entity.name.tag.js, entity.name.tag.tsx, entity.name.tag.jsx",
            "settings": { "foreground": "#e74c3c", "fontStyle": "bold" }
        },
        {
            "name": "TSX attributes",
            "scope": "entity.other.attribute-name.js, entity.other.attribute-name.tsx, entity.other.attribute-name.jsx",
            "settings": { "foreground": "#9b59b6" }
        },
        {
            "name": "TSX strings",
            "scope": "string.quoted.single.js, string.quoted.single.tsx, string.quoted.double.js, string.quoted.double.tsx, string.quoted.single.jsx, string.quoted.double.jsx",
            "settings": { "foreground": "#1e8449" }
        },
        {
            "name": "TSX tag punctuation",
            "scope": "punctuation.definition.tag.js, punctuation.definition.tag.tsx, punctuation.definition.tag.jsx",
            "settings": { "foreground": "#4e342e" }
        },
        {
            "name": "TSX children",
            "scope": "meta.jsx.children, meta.jsx.children.js, meta.jsx.children.tsx",
            "settings": { "foreground": "#2c3e50" }
        },
        {
            "name": "TSX embedded expressions",
            "scope": "punctuation.section.embedded.begin.tsx, punctuation.section.embedded.end.tsx, punctuation.section.embedded.begin.jsx, punctuation.section.embedded.end.jsx",
            "settings": { "foreground": "#4e342e" }
        },
        {
            "name": "Go keywords",
            "scope": "keyword.control.go, keyword.operator.go",
            "settings": { "foreground": "#4e342e", "fontStyle": "bold" }
        },
        {
            "name": "Go variables",
            "scope": "variable.other.go",
            "settings": { "foreground": "#2c3e50" }
        },
        {
            "name": "Go constants",
            "scope": "variable.other.constant.go",
            "settings": { "foreground": "#1e8449" }
        },
        {
            "name": "Go functions",
            "scope": "support.function.go, entity.name.function.go",
            "settings": { "foreground": "#e74c3c" }
        },
        {
            "name": "Go types",
            "scope": "entity.name.type.go",
            "settings": { "foreground": "#9b59b6", "fontStyle": "italic" }
        },
        {
            "name": "Go strings",
            "scope": "string.quoted.double.go, string.quoted.single.go",
            "settings": { "foreground": "#1e8449" }
        },
        {
            "name": "Go numbers",
            "scope": "constant.numeric.go",
            "settings": { "foreground": "#f39c12" }
        },
        {
            "name": "Go special variables",
            "scope": "variable.language.go",
            "settings": { "foreground": "#3498db", "fontStyle": "italic" }
        },
        {
            "name": "JSON property names",
            "scope": "support.type.property-name.json",
            "settings": { "foreground": "#2c3e50" }
        },
        {
            "name": "Python keywords",
            "scope": "keyword.control.import.python, keyword.control.flow.python",
            "settings": { "foreground": "#4e342e", "fontStyle": "bold" }
        },
        {
            "name": "Python function parameters",
            "scope": "variable.parameter.function.python",
            "settings": { "foreground": "#8e44ad" }
        },
        {
            "name": "Python functions",
            "scope": "entity.name.function.python",
            "settings": { "foreground": "#e74c3c" }
        },
        {
            "name": "Python numbers",
            "scope": "constant.numeric.python",
            "settings": { "foreground": "#f39c12" }
        },
        {
            "name": "Python strings",
            "scope": "string.quoted.single.python, string.quoted.double.python",
            "settings": { "foreground": "#1e8449" }
        },
        {
            "name": "Python self",
            "scope": "variable.language.special.self.python",
            "settings": { "foreground": "#3498db", "fontStyle": "italic" }
        },
        {
            "name": "TODO comments",
            "scope": "comment.line.double-slash keyword.other.todo",
            "settings": { "foreground": "#9b59b6", "fontStyle": "bold italic" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
