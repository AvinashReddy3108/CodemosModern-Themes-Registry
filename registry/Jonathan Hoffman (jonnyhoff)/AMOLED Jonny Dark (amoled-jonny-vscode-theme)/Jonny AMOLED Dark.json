{
    "name": "Jonny AMOLED Dark",
    "type": "dark",
    "colors": {
        "focusBorder": "#6ECFE640",
        "editor.background": "#000000",
        "editor.foreground": "#D4D4D4",
        "editor.selectionBackground": "#111111",
        "editor.inactiveSelectionBackground": "#0C0C0C",
        "editor.lineHighlightBackground": "#0D0D0D",
        "editorCursor.foreground": "#F3B38C",
        "editorLineNumber.foreground": "#707070",
        "editorLineNumber.activeForeground": "#A0A0A0",
        "editorWhitespace.foreground": "#262626",
        "editorIndentGuide.background": "#262626",
        "editorIndentGuide.activeBackground": "#3A3A3A",
        "editorGutter.background": "#000000",
        "editorGutter.addedBackground": "#4BCB8A",
        "editorGutter.modifiedBackground": "#A0D6FF",
        "editorGutter.deletedBackground": "#D37A5C",
        "editorGutter.foldingControlForeground": "#7E7E7E",
        "minimap.background": "#000000",
        "sideBar.background": "#050505",
        "sideBar.foreground": "#A0A0A0",
        "sideBarSectionHeader.foreground": "#D4D4D4",
        "sideBarSectionHeader.background": "#050505",
        "sideBar.border": "#0F0F0F",
        "sideBarSectionHeader.border": "#151515",
        "list.activeSelectionBackground": "#111111",
        "list.activeSelectionForeground": "#D4D4D4",
        "list.inactiveSelectionBackground": "#0C0C0C",
        "list.inactiveSelectionForeground": "#A0A0A0",
        "list.hoverBackground": "#0D0D0D",
        "list.focusBackground": "#111111",
        "list.highlightForeground": "#6ECFE6",
        "tab.border": "#111111",
        "tab.activeBackground": "#050505",
        "tab.activeForeground": "#D4D4D4",
        "tab.inactiveBackground": "#000000",
        "tab.inactiveForeground": "#7A7A7A",
        "tab.activeBorderTop": "#6ECFE680",
        "tab.activeBorder": "#0F0F0F",
        "tab.hoverBackground": "#151515",
        "tab.unfocusedActiveBackground": "#040404",
        "tab.unfocusedInactiveBackground": "#000000",
        "editorGroup.border": "#0F0F0F",
        "editorGroupHeader.tabsBackground": "#000000",
        "editorGroupHeader.tabsBorder": "#111111",
        "editorGroupHeader.border": "#111111",
        "panel.background": "#050505",
        "panel.border": "#111111",
        "panelTitle.activeBorder": "#6ECFE6",
        "statusBar.background": "#000000",
        "statusBar.foreground": "#A0A0A0",
        "statusBar.debuggingBackground": "#262626",
        "statusBar.noFolderBackground": "#000000",
        "statusBarItem.remoteForeground": "#7E7E7E",
        "statusBarItem.remoteBackground": "#111111",
        "statusBar.border": "#111111",
        "activityBar.background": "#000000",
        "activityBar.foreground": "#D4D4D4",
        "activityBar.inactiveForeground": "#6E6E6E",
        "activityBarBadge.background": "#6ECFE6",
        "activityBarBadge.foreground": "#000000",
        "activityBar.border": "#0F0F0F",
        "notificationCenterHeader.background": "#050505",
        "notifications.background": "#050505",
        "notifications.foreground": "#D4D4D4",
        "diffEditor.insertedTextBackground": "#4BCB8A20",
        "diffEditor.removedTextBackground": "#D37A5C25",
        "editorError.foreground": "#FF8A7A",
        "editorWarning.foreground": "#E5B567",
        "editorInfo.foreground": "#6ECFE6",
        "editorHint.foreground": "#A2F2C8",
        "errorForeground": "#FFB15A",
        "titleBar.activeBackground": "#050505",
        "titleBar.activeForeground": "#7E7E7E",
        "titleBar.inactiveBackground": "#050505",
        "titleBar.inactiveForeground": "#4E4E4E",
        "titleBar.border": "#111111",
        "scrollbarSlider.background": "#4E4E4E66",
        "scrollbarSlider.hoverBackground": "#4E4E4E99",
        "scrollbarSlider.activeBackground": "#7E7E7E99",
        "gitDecoration.addedResourceForeground": "#4BCB8A",
        "gitDecoration.modifiedResourceForeground": "#A0D6FF",
        "gitDecoration.deletedResourceForeground": "#D37A5C",
        "gitDecoration.untrackedResourceForeground": "#A2F2C8",
        "gitDecoration.ignoredResourceForeground": "#4E4E4E",
        "terminal.border": "#111111",
        "terminal.background": "#000000"
    },
    "semanticHighlighting": true,
    "tokenColors": [
        {
            "name": "Main text / default",
            "scope": [
                "source",
                "meta.embedded",
                "variable",
                "meta.object-literal.key"
            ],
            "settings": { "foreground": "#CCCCCC" }
        },
        {
            "name": "Keywords (control, import, etc.)",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator",
                "storage.type",
                "storage.modifier"
            ],
            "settings": { "foreground": "#7FD8E8", "fontStyle": "" }
        },
        {
            "name": "Types and classes",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.type",
                "support.class"
            ],
            "settings": { "foreground": "#A2F2C8", "fontStyle": "" }
        },
        {
            "name": "Functions and methods",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call",
                "meta.method-call"
            ],
            "settings": { "foreground": "#94E6BE", "fontStyle": "" }
        },
        {
            "name": "Parameters and variables (special cases)",
            "scope": ["variable.parameter", "meta.parameter", "meta.argument"],
            "settings": { "foreground": "#C8C8C8" }
        },
        {
            "name": "Constants / enums",
            "scope": [
                "variable.other.constant",
                "variable.other.enummember",
                "constant.language",
                "constant.character",
                "support.constant"
            ],
            "settings": { "foreground": "#EBC77E", "fontStyle": "bold" }
        },
        {
            "name": "Strings",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#EBC77E", "fontStyle": "" }
        },
        {
            "name": "Interpolation / template expressions",
            "scope": ["string.template meta.embedded", "string.interpolated"],
            "settings": { "foreground": "#7FD8E8" }
        },
        {
            "name": "Numbers and booleans",
            "scope": ["constant.numeric", "constant.boolean"],
            "settings": { "foreground": "#D69CA7" }
        },
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#777777", "fontStyle": "italic" }
        },
        {
            "name": "Punctuation and delimiters",
            "scope": [
                "punctuation",
                "punctuation.separator",
                "punctuation.terminator",
                "punctuation.definition.string",
                "punctuation.definition.parameters",
                "punctuation.definition.arguments",
                "meta.brace",
                "meta.bracket",
                "meta.delimiter"
            ],
            "settings": { "foreground": "#5E5E5E" }
        },
        {
            "name": "Operators",
            "scope": ["keyword.operator", "punctuation.definition.operator"],
            "settings": { "foreground": "#A0A0A0" }
        },
        {
            "name": "Attributes / decorators / annotations",
            "scope": [
                "meta.decorator",
                "entity.other.attribute-name",
                "meta.annotation"
            ],
            "settings": { "foreground": "#D69CA7", "fontStyle": "italic" }
        },
        {
            "name": "Imports and exports",
            "scope": [
                "keyword.control.import",
                "keyword.control.export",
                "keyword.control.from"
            ],
            "settings": { "foreground": "#7FD8E8" }
        },
        {
            "name": "JSON keys / property names",
            "scope": [
                "support.type.property-name",
                "meta.object-literal.key string"
            ],
            "settings": { "foreground": "#CFCFCF" }
        },
        {
            "name": "Markup headings",
            "scope": ["markup.heading", "markup.heading entity.name.section"],
            "settings": { "foreground": "#EBC77E", "fontStyle": "bold" }
        },
        {
            "name": "Markup bold",
            "scope": ["markup.bold"],
            "settings": { "foreground": "#CCCCCC", "fontStyle": "bold" }
        },
        {
            "name": "Markup italic",
            "scope": ["markup.italic"],
            "settings": { "foreground": "#CCCCCC", "fontStyle": "italic" }
        },
        {
            "name": "Links (code / markdown)",
            "scope": ["markup.underline.link", "string.other.link"],
            "settings": { "foreground": "#7FD8E8", "fontStyle": "underline" }
        },
        {
            "name": "Invalid / errors",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#000000", "background": "#FFB15A" }
        },
        {
            "name": "Deprecated",
            "scope": ["meta.deprecated"],
            "settings": {
                "foreground": "#9D5A4C",
                "fontStyle": "strikethrough"
            }
        },
        {
            "name": "TypeScript: interfaces, types, enums",
            "scope": [
                "entity.name.type.ts",
                "entity.name.type.interface.ts",
                "entity.name.type.alias.ts",
                "entity.name.enum.ts",
                "support.type.primitive.ts"
            ],
            "settings": { "foreground": "#A2F2C8", "fontStyle": "" }
        },
        {
            "name": "TypeScript: decorators",
            "scope": [
                "meta.decorator.ts",
                "meta.decorator punctuation.definition.tag.ts"
            ],
            "settings": { "foreground": "#D69CA7", "fontStyle": "italic" }
        },
        {
            "name": "TypeScript: type-related keywords",
            "scope": [
                "keyword.operator.type.annotation.ts",
                "keyword.operator.type.ts",
                "storage.type.type.ts",
                "storage.type.interface.ts"
            ],
            "settings": { "foreground": "#7FD8E8", "fontStyle": "" }
        },
        {
            "name": "TypeScript: this, super",
            "scope": [
                "variable.language.this.ts",
                "variable.language.super.ts"
            ],
            "settings": { "foreground": "#C8C8C8" }
        },
        {
            "name": "TypeScript: JSX tags",
            "scope": ["entity.name.tag.tsx", "support.class.component.tsx"],
            "settings": { "foreground": "#EBC77E", "fontStyle": "" }
        },
        {
            "name": "TypeScript: JSX attributes",
            "scope": ["entity.other.attribute-name.tsx"],
            "settings": { "foreground": "#D69CA7", "fontStyle": "" }
        },
        {
            "name": "Python: builtins",
            "scope": [
                "support.function.builtin.python",
                "support.type.builtin.python"
            ],
            "settings": { "foreground": "#94E6BE" }
        },
        {
            "name": "Python: self and cls",
            "scope": [
                "variable.parameter.function.language.special.self.python",
                "variable.parameter.function.language.special.cls.python"
            ],
            "settings": { "foreground": "#C8C8C8", "fontStyle": "italic" }
        },
        {
            "name": "Python: decorators",
            "scope": [
                "meta.function.decorator.python",
                "entity.name.function.decorator.python"
            ],
            "settings": { "foreground": "#D69CA7", "fontStyle": "italic" }
        },
        {
            "name": "Python: type hints",
            "scope": [
                "meta.annotation.type.python",
                "meta.function.parameters.python entity.name.type",
                "meta.generic-name.python"
            ],
            "settings": { "foreground": "#A2F2C8", "fontStyle": "" }
        },
        {
            "name": "Python: f-string interpolation",
            "scope": [
                "string.quoted.single.f.python meta.embedded.line",
                "string.quoted.double.f.python meta.embedded.line",
                "constant.character.format.placeholder.other.python"
            ],
            "settings": { "foreground": "#7FD8E8" }
        },
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#595959", "fontStyle": "italic" }
        },
        {
            "name": "Punctuation & operators",
            "scope": [
                "punctuation",
                "keyword.operator",
                "storage.type.function.arrow"
            ],
            "settings": { "foreground": "#444444" }
        },
        {
            "name": "Keywords & control flow",
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#6ECFE6" }
        },
        {
            "name": "Functions & methods",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call",
                "variable.function"
            ],
            "settings": { "foreground": "#9FE0C2" }
        },
        {
            "name": "Types, classes & interfaces",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.type",
                "support.class"
            ],
            "settings": { "foreground": "#E6B2CA" }
        },
        {
            "name": "Variables & parameters",
            "scope": ["variable", "meta.parameter", "variable.parameter"],
            "settings": { "foreground": "#D4D4D4" }
        },
        {
            "name": "Constants, enums, booleans, numbers",
            "scope": [
                "constant",
                "constant.numeric",
                "constant.language",
                "variable.other.constant",
                "entity.name.constant",
                "support.constant"
            ],
            "settings": { "foreground": "#A0D6FF" }
        },
        {
            "name": "Strings & template strings",
            "scope": [
                "string",
                "string.quoted",
                "string.template",
                "constant.other.symbol"
            ],
            "settings": { "foreground": "#EBCF87" }
        },
        {
            "name": "Decorators / annotations",
            "scope": [
                "meta.decorator",
                "meta.annotation",
                "entity.name.function.decorator"
            ],
            "settings": { "foreground": "#D5A5E6" }
        },
        {
            "name": "Builtins / important identifiers",
            "scope": [
                "support.variable",
                "support.other.variable",
                "variable.language",
                "keyword.other.this"
            ],
            "settings": { "foreground": "#F3B38C" }
        },
        {
            "name": "JSON keys & object keys",
            "scope": [
                "support.type.property-name.json",
                "meta.object-literal.key"
            ],
            "settings": { "foreground": "#A0D6FF" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
