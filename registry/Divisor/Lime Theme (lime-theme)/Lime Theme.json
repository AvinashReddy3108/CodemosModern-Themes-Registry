{
    "name": "lime-theme",
    "tokenColors": [
        {
            "name": "Global settings",
            "settings": { "background": "#131414", "foreground": "#FFFFFF" }
        },
        {
            "name": "String",
            "scope": "string",
            "settings": { "foreground": "#818287" }
        },
        {
            "name": "Boolean",
            "scope": "constant.language.boolean",
            "settings": { "foreground": "#5FFF00" }
        },
        {
            "name": "Number",
            "scope": "constant.numeric",
            "settings": { "foreground": "#FFFF33" }
        },
        {
            "name": "Identifier",
            "scope": "variable, support.variable, support.class, support.constant, meta.definition.variable entity.name.function",
            "settings": { "foreground": "#8eff00" }
        },
        {
            "name": "Keyword",
            "scope": "keyword, modifier, variable.language.this, support.type.object, constant.language",
            "settings": { "foreground": "#5FFF00" }
        },
        {
            "name": "Function call",
            "scope": "entity.name.function, support.function",
            "settings": { "foreground": "#FFFF33" }
        },
        {
            "name": "Storage",
            "scope": "storage.type, storage.modifier",
            "settings": { "foreground": "#5FFF00" }
        },
        {
            "name": "Modules",
            "scope": "support.module, support.node",
            "settings": { "foreground": "#8eff00", "fontStyle": "italic" }
        },
        {
            "name": "Type",
            "scope": "support.type",
            "settings": { "foreground": "#666261" }
        },
        {
            "name": "Type",
            "scope": "entity.name.type, entity.other.inherited-class",
            "settings": { "foreground": "#666261" }
        },
        {
            "name": "Comment",
            "scope": "comment",
            "settings": { "foreground": "#393c3c", "fontStyle": "italic" }
        },
        {
            "name": "Class",
            "scope": "entity.name.type.class",
            "settings": { "foreground": "#666261", "fontStyle": "underline" }
        },
        {
            "name": "Class variable",
            "scope": "variable.object.property, meta.field.declaration entity.name.function",
            "settings": { "foreground": "#666261" }
        },
        {
            "name": "Class method",
            "scope": "meta.definition.method entity.name.function",
            "settings": { "foreground": "#666261" }
        },
        {
            "name": "Function definition",
            "scope": "meta.function entity.name.function",
            "settings": { "foreground": "#666261" }
        },
        {
            "name": "Template expression",
            "scope": "template.expression.begin, template.expression.end, punctuation.definition.template-expression.begin, punctuation.definition.template-expression.end",
            "settings": { "foreground": "#5FFF00" }
        },
        {
            "name": "Reset embedded/template expression colors",
            "scope": "meta.embedded, source.groovy.embedded, meta.template.expression",
            "settings": { "foreground": "#FFFFFF" }
        },
        {
            "name": "YAML key",
            "scope": "entity.name.tag.yaml",
            "settings": { "foreground": "#8eff00" }
        },
        {
            "name": "JSON key",
            "scope": "meta.object-literal.key, meta.object-literal.key string, support.type.property-name.json",
            "settings": { "foreground": "#8eff00" }
        },
        {
            "name": "JSON constant",
            "scope": "constant.language.json",
            "settings": { "foreground": "#5FFF00" }
        },
        {
            "name": "CSS class",
            "scope": "entity.other.attribute-name.class",
            "settings": { "foreground": "#5FFF00" }
        },
        {
            "name": "CSS ID",
            "scope": "entity.other.attribute-name.id",
            "settings": { "foreground": "#818287" }
        },
        {
            "name": "CSS tag",
            "scope": "source.css entity.name.tag",
            "settings": { "foreground": "#666261" }
        },
        {
            "name": "HTML tag outer",
            "scope": "meta.tag, punctuation.definition.tag",
            "settings": { "foreground": "#5FFF00" }
        },
        {
            "name": "HTML tag inner",
            "scope": "entity.name.tag",
            "settings": { "foreground": "#8eff00" }
        },
        {
            "name": "HTML tag attribute",
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#FFFF33" }
        },
        {
            "name": "Markdown heading",
            "scope": "markup.heading",
            "settings": { "foreground": "#5FFF00" }
        },
        {
            "name": "Markdown link text",
            "scope": "text.html.markdown meta.link.inline, meta.link.reference",
            "settings": { "foreground": "#8eff00" }
        },
        {
            "name": "Markdown list item",
            "scope": "text.html.markdown beginning.punctuation.definition.list",
            "settings": { "foreground": "#5FFF00" }
        },
        {
            "name": "Markdown italic",
            "scope": "markup.italic",
            "settings": { "foreground": "#8eff00", "fontStyle": "italic" }
        },
        {
            "name": "Markdown bold",
            "scope": "markup.bold",
            "settings": { "foreground": "#8eff00", "fontStyle": "bold" }
        },
        {
            "name": "Markdown bold italic",
            "scope": "markup.bold markup.italic, markup.italic markup.bold",
            "settings": { "foreground": "#8eff00", "fontStyle": "italic bold" }
        },
        {
            "name": "Markdown code block",
            "scope": "markup.fenced_code.block.markdown punctuation.definition.markdown",
            "settings": { "foreground": "#818287" }
        },
        {
            "name": "Markdown inline code",
            "scope": "markup.inline.raw.string.markdown",
            "settings": { "foreground": "#818287" }
        },
        {
            "name": "INI property name",
            "scope": "keyword.other.definition.ini",
            "settings": { "foreground": "#8eff00" }
        },
        {
            "name": "INI section title",
            "scope": "entity.name.section.group-title.ini",
            "settings": { "foreground": "#5FFF00" }
        },
        {
            "name": "C# class",
            "scope": "source.cs meta.class.identifier storage.type",
            "settings": { "foreground": "#666261", "fontStyle": "underline" }
        },
        {
            "name": "C# class method",
            "scope": "source.cs meta.method.identifier entity.name.function",
            "settings": { "foreground": "#666261" }
        },
        {
            "name": "C# function call",
            "scope": "source.cs meta.method-call meta.method, source.cs entity.name.function",
            "settings": { "foreground": "#FFFF33" }
        },
        {
            "name": "C# type",
            "scope": "source.cs storage.type",
            "settings": { "foreground": "#666261" }
        },
        {
            "name": "C# return type",
            "scope": "source.cs meta.method.return-type",
            "settings": { "foreground": "#666261" }
        },
        {
            "name": "C# preprocessor",
            "scope": "source.cs meta.preprocessor",
            "settings": { "foreground": "#393c3c" }
        },
        {
            "name": "C# namespace",
            "scope": "source.cs entity.name.type.namespace",
            "settings": { "foreground": "#FFFFFF" }
        },
        {
            "name": "Global settings",
            "settings": { "background": "#131414", "foreground": "#FFFFFF" }
        }
    ],
    "colors": {
        "focusBorder": "#5FFF00",
        "foreground": "#FFFFFF",
        "dropdown.background": "#1e2020",
        "input.background": "#1e2020",
        "inputOption.activeBorder": "#5FFF00",
        "list.activeSelectionBackground": "#5FFF0080",
        "list.dropBackground": "#5FFF0080",
        "list.focusBackground": "#5FFF0080",
        "list.hoverBackground": "#FFFFFF1a",
        "list.inactiveSelectionBackground": "#FFFFFF33",
        "activityBar.background": "#1a1c1c",
        "activityBar.dropBackground": "#5FFF0080",
        "activityBarBadge.background": "#5FFF00",
        "sideBar.background": "#161818",
        "sideBarSectionHeader.background": "#1a1c1c",
        "editorGroup.dropBackground": "#5FFF0080",
        "editorGroup.focusedEmptyBorder": "#5FFF00",
        "editorGroupHeader.tabsBackground": "#161818",
        "tab.border": "#00000033",
        "tab.activeBorder": "#5FFF00",
        "tab.inactiveBackground": "#1a1c1c",
        "editor.background": "#131414",
        "editor.foreground": "#FFFFFF",
        "editorLineNumber.foreground": "#FFFFFF4d",
        "editorLineNumber.activeForeground": "#5FFF00",
        "editor.lineHighlightBorder": "#FFFFFF1a",
        "editor.rangeHighlightBackground": "#FFFFFF0d",
        "editorWidget.background": "#161818",
        "editorHoverWidget.background": "#161818",
        "editorMarkerNavigation.background": "#161818",
        "peekView.border": "#5FFF00",
        "peekViewEditor.background": "#0f1010",
        "peekViewResult.background": "#161818",
        "peekViewTitle.background": "#131414",
        "panel.background": "#161818",
        "panel.border": "#FFFFFF1a",
        "panelTitle.activeBorder": "#FFFFFF80",
        "panelTitle.inactiveForeground": "#FFFFFF80",
        "statusBar.background": "#0f1010",
        "statusBar.debuggingBackground": "#5FFF00",
        "statusBar.noFolderBackground": "#0f1010",
        "statusBarItem.activeBackground": "#5FFF0080",
        "statusBarItem.hoverBackground": "#FFFFFF1a",
        "titleBar.activeBackground": "#0f1010",
        "pickerGroup.border": "#FFFFFF1a",
        "debugToolBar.background": "#1a1c1c",
        "selection.background": "#5FFF00"
    },
    "$schema": "vscode://schemas/color-theme"
}
