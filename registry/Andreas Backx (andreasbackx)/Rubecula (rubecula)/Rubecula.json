    "tokenColors": [
        { "settings": { "foreground": "#CECECE" } },
        {
            "scope": "constant.numeric.line-number.find-in-files - match",
            "settings": { "foreground": "#A082D9A0" }
        },
        {
            "scope": "entity.name.filename.find-in-files",
            "settings": { "foreground": "#CCC47A" }
        },
        {
            "name": "Comment",
            "scope": "comment",
            "settings": { "foreground": "#6E6E6E" }
        },
        {
            "name": "String",
            "scope": "string",
            "settings": { "foreground": "#CCC47A" }
        },
        {
            "name": "Number",
            "scope": "constant.numeric",
            "settings": { "foreground": "#A082D9" }
        },
        {
            "name": "Built-in constant",
            "scope": "constant.language",
            "settings": { "foreground": "#A082D9" }
        },
        {
            "name": "User-defined constant",
            "scope": ["constant.character", "constant.other"],
            "settings": { "foreground": "#A082D9" }
        },
        {
            "name": "Variable",
            "scope": "variable",
            "settings": { "foreground": "#CECECE" }
        },
        {
            "name": "Keyword",
            "scope": "keyword",
            "settings": { "foreground": "#E52E71" }
        },
        {
            "name": "Storage",
            "scope": "storage",
            "settings": { "foreground": "#E52E71" }
        },
        {
            "name": "Storage type",
            "scope": "storage.type",
            "settings": { "fontStyle": "italic", "foreground": "#6CC7D9" }
        },
        {
            "name": "Class name",
            "scope": "entity.name.class",
            "settings": { "fontStyle": "underline", "foreground": "#9CCC3D" }
        },
        {
            "name": "Inherited class",
            "scope": "entity.other.inherited-class",
            "settings": {
                "fontStyle": "italic underline",
                "foreground": "#9CCC3D"
            }
        },
        {
            "name": "Function name",
            "scope": "entity.name.function",
            "settings": { "foreground": "#9CCC3D" }
        },
        {
            "name": "Function argument",
            "scope": "variable.parameter",
            "settings": { "fontStyle": "italic", "foreground": "#D9882B" }
        },
        {
            "name": "Tag name",
            "scope": "entity.name.tag",
            "settings": { "foreground": "#E52E71" }
        },
        {
            "name": "Tag attribute",
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#9CCC3D" }
        },
        {
            "name": "Library function",
            "scope": "support.function",
            "settings": { "foreground": "#6CC7D9" }
        },
        {
            "name": "Library constant",
            "scope": "support.constant",
            "settings": { "foreground": "#6CC7D9" }
        },
        {
            "name": "Library class/type",
            "scope": ["support.type", "support.class"],
            "settings": { "fontStyle": "italic", "foreground": "#6CC7D9" }
        },
        {
            "name": "Library variable",
            "scope": "support.other.variable",
            "settings": { "foreground": "" }
        },
        {
            "name": "Invalid",
            "scope": "invalid",
            "settings": { "foreground": "#CECECE" }
        },
        {
            "name": "Invalid deprecated",
            "scope": "invalid.deprecated",
            "settings": { "foreground": "#CECECE" }
        },
        {
            "name": "JSON String",
            "scope": "meta.structure.dictionary.json string.quoted.double.json",
            "settings": { "foreground": "#CCC47A" }
        },
        {
            "name": "diff.header",
            "scope": ["meta.diff", "meta.diff.header"],
            "settings": { "foreground": "#6E6E6E" }
        },
        {
            "name": "diff.deleted",
            "scope": "markup.deleted",
            "settings": { "foreground": "#E52E71" }
        },
        {
            "name": "diff.inserted",
            "scope": "markup.inserted",
            "settings": { "foreground": "#9CCC3D" }
        },
        {
            "name": "diff.changed",
            "scope": "markup.changed",
            "settings": { "foreground": "#CCC47A" }
        },
        {
            "name": "Markup: raw inline",
            "scope": "text.html.markdown markup.raw.inline",
            "settings": { "foreground": "#A082D9" }
        },
        {
            "name": "Markup: italic",
            "scope": "markup.italic",
            "settings": { "fontStyle": "italic", "foreground": "#CCC47A" }
        },
        {
            "name": "Markup: bold",
            "scope": "markup.bold",
            "settings": { "fontStyle": "bold", "foreground": "#D9882B" }
        },
        {
            "name": "Markup: underline",
            "scope": "markup.underline",
            "settings": { "fontStyle": "underline", "foreground": "#6CC7D9" }
        },
        {
            "name": "Markup: Quote",
            "scope": "markup.quote",
            "settings": { "fontStyle": "italic", "foreground": "#6E6E6E" }
        },
        {
            "name": "Markup: Raw block",
            "scope": "markup.raw.block",
            "settings": { "foreground": "#A082D9" }
        },
        {
            "name": "Markup: table",
            "scope": "markup.table",
            "settings": { "foreground": "#6E6E6E" }
        },
        {
            "name": "Markdown: plain",
            "scope": "text.html.markdown",
            "settings": { "foreground": "#CECECE" }
        },
        {
            "name": "Markdown: linebreak",
            "scope": "text.html.markdown meta.dummy.line-break",
            "settings": { "foreground": "#6E6E6E" }
        },
        {
            "name": "Markdown: heading",
            "scope": [
                "markdown.heading",
                "markup.heading | markup.heading entity.name",
                "markup.heading.markdown punctuation.definition.heading.markdown"
            ],
            "settings": { "fontStyle": "bold", "foreground": "#E52E71" }
        },
        {
            "name": "Markdown: Blockquote",
            "scope": [
                "markup.quote",
                "punctuation.definition.blockquote.markdown"
            ],
            "settings": { "fontStyle": "italic", "foreground": "#6E6E6E" }
        },
        {
            "name": "Markdown: Link",
            "scope": "string.other.link.title.markdown",
            "settings": { "fontStyle": "underline", "foreground": "#6CC7D9" }
        },
        {
            "name": "Markdown: List Items Punctuation",
            "scope": "punctuation.definition.list_item.markdown",
            "settings": { "foreground": "#6E6E6E" }
        },
        {
            "name": "Markdown: Raw Block fenced",
            "scope": "markup.raw.block.fenced.markdown",
            "settings": { "foreground": "#A082D9" }
        },
        {
            "name": "Markdown: Fenced Bode Block",
            "scope": [
                "punctuation.definition.fenced.markdown",
                "variable.language.fenced.markdown"
            ],
            "settings": { "foreground": "#A082D9" }
        },
        {
            "name": "Markdown: Fenced Language",
            "scope": "variable.language.fenced.markdown",
            "settings": { "foreground": "#A082D9" }
        },
        {
            "name": "Markdown: Separator",
            "scope": "meta.separator",
            "settings": { "foreground": "#6E6E6E" }
        },
        {
            "scope": "token.info-token",
            "settings": { "foreground": "#6CC7D9" }
        },
        {
            "scope": "token.warn-token",
            "settings": { "foreground": "#D9882B" }
        },
        {
            "scope": "token.error-token",
            "settings": { "foreground": "#E52E71" }
        },
        {
            "scope": "token.debug-token",
            "settings": { "foreground": "#A082D9" }
        },
        {
            "name": "Python docstrings",
            "scope": ["string.quoted.docstring.multi"],
            "settings": { "foreground": "#6E6E6E" }
        },
        {
            "name": "Inherited classes",
            "scope": ["entity.other.inherited-class"],
            "settings": { "fontStyle": "" }
        },
        {
            "name": "Language specific variables",
            "scope": ["variable.language"],
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "UPPERCASE constants",
            "scope": ["constant.other.caps"],
            "settings": { "foreground": "#CECECE", "fontStyle": "" }
        },
        {
            "name": "JSON Keys",
            "scope": ["support.type.property-name.json"],
            "settings": { "fontStyle": "" }
        }
