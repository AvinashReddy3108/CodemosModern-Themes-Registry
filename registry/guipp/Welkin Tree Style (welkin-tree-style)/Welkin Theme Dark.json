{
    "name": "welkin-theme-dark",
    "type": "dark",
    "uiTheme": "vs-dark",
    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment.line.number-sign.tree"],
            "settings": { "foreground": "#6A9955", "fontStyle": "italic" }
        },
        {
            "name": "Keywords - Control Flow",
            "scope": [
                "keyword.control.sequence.tree",
                "keyword.control.selector.tree",
                "keyword.control.parallel.tree",
                "keyword.control.ifelse.tree",
                "keyword.control.while.tree"
            ],
            "settings": { "foreground": "#C586C0" }
        },
        {
            "name": "Keywords - Root Node",
            "scope": ["keyword.control.root_node.tree"],
            "settings": { "foreground": "#00FF88", "fontStyle": "bold" }
        },
        {
            "name": "Keywords - Init Node",
            "scope": ["keyword.control.init_node.tree"],
            "settings": { "foreground": "#7DD3C0", "fontStyle": "italic" }
        },
        {
            "name": "Keywords - Finish Node",
            "scope": ["keyword.control.finish_node.tree"],
            "settings": { "foreground": "#FF6B6B", "fontStyle": "bold" }
        },
        {
            "name": "Keywords - Logic Nodes",
            "scope": [
                "keyword.control.sequence.tree",
                "keyword.control.selector.tree",
                "keyword.control.parallel.tree"
            ],
            "settings": { "foreground": "#4EC9B0" }
        },
        {
            "name": "Keywords - Loop Nodes",
            "scope": ["keyword.control.while.tree"],
            "settings": { "foreground": "#C586C0", "fontStyle": "bold" }
        },
        {
            "name": "Keywords - Success Node",
            "scope": ["keyword.control.success.tree"],
            "settings": { "foreground": "#4EC9B0", "fontStyle": "bold" }
        },
        {
            "name": "Keywords - Failure Node",
            "scope": ["keyword.control.failure.tree"],
            "settings": { "foreground": "#F48771", "fontStyle": "bold" }
        },
        {
            "name": "Keywords - Other Node Types",
            "scope": [
                "keyword.control.shared_node.tree",
                "keyword.control.child_node.tree",
                "keyword.control.composite.tree",
                "keyword.control.decorator.tree"
            ],
            "settings": { "foreground": "#4EC9B0" }
        },
        {
            "name": "Keywords - Node Properties",
            "scope": [
                "keyword.control.name.tree",
                "keyword.control.param.tree",
                "keyword.control.shared_node.key.tree",
                "keyword.control.condition.tree",
                "keyword.control.action.tree"
            ],
            "settings": { "foreground": "#9CDCFE" }
        },
        {
            "name": "Keywords - Switcher",
            "scope": ["keyword.control.switcher.tree"],
            "settings": { "foreground": "#DCDCAA" }
        },
        {
            "name": "Keywords - Header",
            "scope": ["keyword.other.header.tree"],
            "settings": { "foreground": "#569CD6" }
        },
        {
            "name": "Keywords - Namespace",
            "scope": ["keyword.other.namespace.tree"],
            "settings": { "foreground": "#4EC9B0" }
        },
        {
            "name": "Keywords - File Reference",
            "scope": ["keyword.other.file.tree", "keyword.other.name.tree"],
            "settings": { "foreground": "#808080" }
        },
        {
            "name": "Operators - Arrow",
            "scope": [
                "keyword.operator.arrow.tree",
                "keyword.operator.arrow.method.tree",
                "keyword.operator.arrow.return.tree"
            ],
            "settings": { "foreground": "#D7BA7D", "fontStyle": "bold" }
        },
        {
            "name": "Operators - Other",
            "scope": [
                "keyword.operator.colon.tree",
                "keyword.operator.ampersand.tree",
                "keyword.operator.logical.and.tree",
                "keyword.operator.logical.or.tree",
                "keyword.operator.decorator.prefix.tree"
            ],
            "settings": { "foreground": "#D4D4D4" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation.separator.comma.tree",
                "punctuation.separator.namespace.tree",
                "punctuation.definition.parenthesis.begin.tree",
                "punctuation.definition.parenthesis.end.tree"
            ],
            "settings": { "foreground": "#808080" }
        },
        {
            "name": "Namespace",
            "scope": ["entity.name.namespace.tree"],
            "settings": { "foreground": "#4EC9B0", "fontStyle": "italic" }
        },
        {
            "name": "Function Names",
            "scope": [
                "entity.name.function.tree",
                "entity.name.function.call.tree",
                "entity.name.function.pid.tree"
            ],
            "settings": { "foreground": "#DCDCAA", "fontStyle": "bold" }
        },
        {
            "name": "Method Names",
            "scope": ["entity.name.function.method.tree"],
            "settings": { "foreground": "#4EC9B0", "fontStyle": "bold" }
        },
        {
            "name": "Reference Names",
            "scope": ["entity.name.reference.tree"],
            "settings": { "foreground": "#4EC9B0" }
        },
        {
            "name": "Function Call Meta",
            "scope": [
                "meta.function-call.tree",
                "meta.function-call.return-chain.tree",
                "meta.method-call.tree",
                "meta.return-chain.tree",
                "meta.return-chain-args.tree"
            ],
            "settings": { "foreground": "#D4D4D4" }
        },
        {
            "name": "Strings",
            "scope": ["string.quoted.double.tree"],
            "settings": { "foreground": "#D7BA7D" }
        },
        {
            "name": "Strings - Escaped",
            "scope": ["string.quoted.double.escaped.tree"],
            "settings": { "foreground": "#D7BA7D", "fontStyle": "italic" }
        },
        {
            "name": "Strings - Input Single",
            "scope": ["string.quoted.single.input.tree"],
            "settings": { "foreground": "#D7BA7D", "fontStyle": "italic" }
        },
        {
            "name": "Strings - Input Args",
            "scope": ["string.other.input-arg.tree"],
            "settings": { "foreground": "#D7BA7D", "fontStyle": "italic" }
        },
        {
            "name": "Macro Definition",
            "scope": ["meta.macro.tree", "constant.other.macro-content.tree"],
            "settings": { "foreground": "#4EC9B0", "fontStyle": "bold" }
        },
        {
            "name": "Enum Type",
            "scope": ["constant.language.enum.tree"],
            "settings": { "foreground": "#569CD6", "fontStyle": "bold" }
        },
        {
            "name": "Parameters",
            "scope": [
                "keyword.operator.param.tree",
                "variable.parameter.key.tree",
                "storage.type.tree",
                "punctuation.separator.param.tree"
            ],
            "settings": { "foreground": "#C586C0" }
        },
        {
            "name": "File References",
            "scope": ["string.unquoted.file.tree", "meta.file-reference.tree"],
            "settings": { "foreground": "#4EC9B0" }
        },
        {
            "name": "Variables - File Path",
            "scope": ["variable.name.file.tree"],
            "settings": { "foreground": "#4FC1FF" }
        },
        {
            "name": "Variables - Local (Blue - Very Bright)",
            "scope": ["variable.name.local.tree"],
            "settings": { "foreground": "#9CDCFE" }
        },
        {
            "name": "Variables - Shared (Blue - Bright)",
            "scope": ["variable.name.shared.tree"],
            "settings": { "foreground": "#00B7FF", "fontStyle": "bold" }
        },
        {
            "name": "Variables - Global (Blue - Bright)",
            "scope": ["variable.name.global.tree"],
            "settings": { "foreground": "#4A9EFF", "fontStyle": "bold" }
        },
        {
            "name": "Variables - Member (Blue - Medium)",
            "scope": ["variable.name.member.tree"],
            "settings": { "foreground": "#5B9BD5", "fontStyle": "bold" }
        },
        {
            "name": "Variables - Object (Blue - Medium Bright)",
            "scope": ["variable.other.object.tree"],
            "settings": { "foreground": "#6BA3D6", "fontStyle": "bold" }
        },
        {
            "name": "Variables - Temporary (Blue - Dark)",
            "scope": ["variable.name.tmp.tree"],
            "settings": { "foreground": "#3B7FC4", "fontStyle": "italic" }
        },
        {
            "name": "Variables - Brace",
            "scope": [
                "variable.other.brace.tree",
                "variable.name.brace-content.tree"
            ],
            "settings": { "foreground": "#6BA3D6", "fontStyle": "bold" }
        },
        {
            "name": "Variables - Interpolation",
            "scope": ["variable.interpolation.tree"],
            "settings": { "foreground": "#9CDCFE" }
        },
        {
            "name": "Variables - Default Override",
            "scope": ["variable.tree"],
            "settings": { "foreground": "#9CDCFE" }
        },
        {
            "name": "Numbers",
            "scope": ["constant.numeric.number.tree"],
            "settings": { "foreground": "#B5CEA8", "fontStyle": "bold" }
        },
        {
            "name": "String Escape",
            "scope": ["constant.character.escape.tree"],
            "settings": { "foreground": "#D7BA7D" }
        },
        {
            "name": "Boolean - True",
            "scope": ["constant.language.true.tree"],
            "settings": { "foreground": "#4EC9B0" }
        },
        {
            "name": "Boolean - False",
            "scope": ["constant.language.false.tree"],
            "settings": { "foreground": "#F48771" }
        },
        {
            "name": "Constants - Other",
            "scope": ["constant.other.constant.tree"],
            "settings": { "foreground": "#4EC9B0" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
