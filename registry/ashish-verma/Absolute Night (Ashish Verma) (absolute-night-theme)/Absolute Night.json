{
    "$schema": "vscode://schemas/color-theme",
    "name": "Absolute Night",
    "type": "dark",
    "semanticHighlighting": true,
    "colors": {
        "editor.background": "#0b0d10",
        "editor.foreground": "#c7cdd3",
        "editorLineNumber.foreground": "#3c4450",
        "editorLineNumber.activeForeground": "#9aa4b2",
        "editorCursor.foreground": "#d6e4ff",
        "editor.selectionBackground": "#1d2633",
        "editor.inactiveSelectionBackground": "#141a22",
        "editor.selectionHighlightBackground": "#1d263399",
        "editor.wordHighlightBackground": "#24304066",
        "editor.wordHighlightStrongBackground": "#2a364966",
        "editor.lineHighlightBackground": "#101317",
        "editorWhitespace.foreground": "#2a323c",
        "editorIndentGuide.background": "#1a2029",
        "editorIndentGuide.activeBackground": "#2b3441",
        "editorGutter.background": "#0a0c0f",
        "editorGutter.modifiedBackground": "#5fb3f3",
        "editorGutter.addedBackground": "#8ccf7e",
        "editorGutter.deletedBackground": "#e27d7d",
        "sideBar.background": "#0a0c0f",
        "sideBar.foreground": "#99a3af",
        "activityBar.background": "#0a0c0f",
        "activityBar.foreground": "#c7cdd3",
        "statusBar.background": "#0a0c0f",
        "statusBar.foreground": "#a6adb7",
        "titleBar.activeBackground": "#0a0c0f",
        "titleBar.activeForeground": "#c7cdd3",
        "panel.background": "#0a0c0f",
        "tab.activeBackground": "#0e1116",
        "tab.inactiveBackground": "#090b0e",
        "tab.activeForeground": "#e5e7eb",
        "tab.inactiveForeground": "#9aa4b2",
        "tab.border": "#0a0c0f",
        "dropdown.background": "#0e1116",
        "dropdown.foreground": "#c7cdd3",
        "list.activeSelectionBackground": "#131a24",
        "list.inactiveSelectionBackground": "#10161f",
        "list.hoverBackground": "#0f141c",
        "list.focusBackground": "#121922",
        "scrollbarSlider.background": "#2a324255",
        "scrollbarSlider.hoverBackground": "#2a324277",
        "scrollbarSlider.activeBackground": "#2a324299",
        "editorSuggestWidget.background": "#0e1116",
        "editorSuggestWidget.foreground": "#c7cdd3",
        "editorSuggestWidget.selectedBackground": "#162030",
        "editorWidget.background": "#0e1116",
        "badge.background": "#1f2a3b",
        "badge.foreground": "#c7cdd3",
        "terminal.background": "#0b0d10",
        "terminal.foreground": "#c7cdd3",
        "terminal.ansiBlack": "#0b0d10",
        "terminal.ansiRed": "#e27d7d",
        "terminal.ansiGreen": "#9dc49d",
        "terminal.ansiYellow": "#e3c18a",
        "terminal.ansiBlue": "#8fb4f4",
        "terminal.ansiMagenta": "#c7a6f2",
        "terminal.ansiCyan": "#86d1d1",
        "terminal.ansiWhite": "#d5dbe1",
        "terminal.ansiBrightBlack": "#1b1f26",
        "terminal.ansiBrightRed": "#f08f8f",
        "terminal.ansiBrightGreen": "#a8d9a8",
        "terminal.ansiBrightYellow": "#f1d19c",
        "terminal.ansiBrightBlue": "#a0c2ff",
        "terminal.ansiBrightMagenta": "#d6b8ff",
        "terminal.ansiBrightCyan": "#9ae2e2",
        "terminal.ansiBrightWhite": "#e8edf3",
        "editorBracketHighlight.foreground1": "#90b4f8",
        "editorBracketHighlight.foreground2": "#9fd3a6",
        "editorBracketHighlight.foreground3": "#e6c07b",
        "editorBracketHighlight.foreground4": "#c7a6f2",
        "editorBracketHighlight.foreground5": "#7ad1e6",
        "editorBracketHighlight.foreground6": "#f0b8d0",
        "editorBracketHighlight.unexpectedBracket.foreground": "#ff6b6b",
        "editorBracketMatch.background": "#1b2433",
        "editorBracketMatch.border": "#1b2433"
    },
    "tokenColors": [
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#6b7280", "fontStyle": "italic" }
        },
        {
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#89a7f2" }
        },
        {
            "scope": [
                "entity.name.function",
                "support.function",
                "variable.function"
            ],
            "settings": { "foreground": "#c4a7e7" }
        },
        {
            "scope": ["string", "punctuation.definition.string"],
            "settings": { "foreground": "#a7d4a0" }
        },
        {
            "scope": ["constant.numeric", "constant.character.numeric"],
            "settings": { "foreground": "#e8c28c" }
        },
        {
            "scope": ["constant.language", "support.constant"],
            "settings": { "foreground": "#d5b0cf" }
        },
        {
            "scope": ["variable", "meta.definition.variable.name"],
            "settings": { "foreground": "#cfd6dc" }
        },
        {
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#b8c2cc" }
        },
        {
            "scope": [
                "entity.name.type",
                "support.type",
                "entity.other.inherited-class"
            ],
            "settings": { "foreground": "#a6d0d6" }
        },
        {
            "scope": ["entity.name.class", "support.class"],
            "settings": { "foreground": "#a6d0d6", "fontStyle": "bold" }
        },
        {
            "scope": ["punctuation", "meta.brace", "meta.delimiter"],
            "settings": { "foreground": "#8a93a4" }
        },
        {
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#ffffff", "background": "#ff4d4d" }
        }
    ]
}
