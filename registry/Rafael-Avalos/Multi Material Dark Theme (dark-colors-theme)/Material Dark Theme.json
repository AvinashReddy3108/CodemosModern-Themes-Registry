{
    "$schema": "vscode://schemas/color-theme",
    "type": "dark",
    "colors": {
        "activityBar.background": "#121418",
        "activityBar.foreground": "#ffffff",
        "activityBarBadge.background": "#49b6ff",
        "activityBarBadge.foreground": "#000000",
        "badge.background": "#49b6ff",
        "badge.foreground": "#000000",
        "button.background": "#0679dd",
        "button.foreground": "#ffffff",
        "button.hoverBackground": "#49b6ff",
        "debugExceptionWidget.background": "#ff9f2e60",
        "debugExceptionWidget.border": "#ff9f2e60",
        "debugToolBar.background": "#20232a",
        "diffEditor.insertedTextBackground": "#29bf1220",
        "diffEditor.removedTextBackground": "#f21b3f20",
        "dropdown.background": "#2b303b",
        "dropdown.border": "#363c49",
        "editor.background": "#121418",
        "editor.findMatchBackground": "#f39d12",
        "editor.findMatchHighlightBackground": "#49b6ffe3",
        "editor.findMatchHighlightForeground": "#fffffff0",
        "editor.findMatchForeground": "#ffffff",
        "editor.foreground": "#e4dfe7",
        "editor.hoverHighlightBackground": "#373941",
        "editor.lineHighlightBackground": "#2e323d",
        "editor.lineHighlightBorder": "#2e323d",
        "editor.rangeHighlightBackground": "#372f3c",
        "editor.selectionBackground": "#303541",
        "editor.selectionHighlightBackground": "#4f435580",
        "editor.wordHighlightBackground": "#4f4355",
        "editor.wordHighlightStrongBackground": "#db45a280",
        "editorBracketHighlight.foreground1": "#ed598e",
        "editorBracketHighlight.foreground2": "#00e676",
        "editorBracketHighlight.foreground3": "#aa00ff",
        "editorBracketHighlight.foreground4": "#ffeb3b",
        "editorBracketHighlight.foreground5": "#5188ff",
        "editorBracketHighlight.foreground6": "#98c379",
        "editorCodeLens.foreground": "#746f77",
        "editorCursor.foreground": "#ffcc00",
        "editorError.foreground": "#d4503f",
        "editorGroup.dropBackground": "#495061d7",
        "editorGroup.emptyBackground": "#121418",
        "editorGroupHeader.tabsBackground": "#121418",
        "editorGutter.addedBackground": "#9bc53dbb",
        "editorGutter.deletedBackground": "#fc644dbb",
        "editorGutter.modifiedBackground": "#5bc0ebbb",
        "editorHoverWidget.background": "#373941",
        "editorHoverWidget.border": "#00e8c5cc",
        "editorIndentGuide.activeBackground": "#585c66",
        "editorIndentGuide.background": "#333844",
        "editorLineNumber.foreground": "#746f77",
        "editorLink.activeForeground": "#3b79c7",
        "editorOverviewRuler.border": "#1b1d23",
        "editorRuler.foreground": "#4f4355",
        "editorSuggestWidget.background": "#20232a",
        "editorSuggestWidget.border": "#372f3c",
        "editorSuggestWidget.selectedBackground": "#373941",
        "editorWarning.foreground": "#ff9f2e",
        "editorWhitespace.foreground": "#333844",
        "editorWidget.background": "#20232a",
        "errorForeground": "#d4503f",
        "focusBorder": "#746f77",
        "foreground": "#d5ced9",
        "input.background": "#2b303b",
        "input.placeholderForeground": "#746f77",
        "inputOption.activeBorder": "#c668ba",
        "inputValidation.errorBackground": "#d4503f",
        "inputValidation.errorBorder": "#d4503f",
        "inputValidation.infoBackground": "#3b6599",
        "inputValidation.infoBorder": "#3b6599",
        "inputValidation.warningBackground": "#ee9e3d",
        "inputValidation.warningBorder": "#ee9e3d",
        "list.activeSelectionBackground": "#333742",
        "list.activeSelectionForeground": "#ffffff",
        "list.dropBackground": "#3a404e",
        "list.focusBackground": "#333742",
        "list.focusForeground": "#eeeeee",
        "list.hoverBackground": "#333742",
        "list.hoverForeground": "#eeeeee",
        "list.inactiveSelectionBackground": "#2a2c33",
        "list.inactiveSelectionForeground": "#49b6ff",
        "merge.currentContentBackground": "#f9267240",
        "merge.currentHeaderBackground": "#f92672",
        "merge.incomingContentBackground": "#3b79c740",
        "merge.incomingHeaderBackground": "#3b79c7bb",
        "peekView.border": "#262931",
        "peekViewEditor.background": "#2a2c32",
        "peekViewEditor.matchHighlightBackground": "#ff9f2e60",
        "peekViewResult.background": "#2a2c32",
        "peekViewResult.matchHighlightBackground": "#ff9f2e60",
        "peekViewResult.selectionBackground": "#121418",
        "peekViewTitle.background": "#2a2c32",
        "peekViewTitleDescription.foreground": "#78747a",
        "progressBar.background": "#c668ba",
        "scrollbar.shadow": "#25282f",
        "scrollbarSlider.activeBackground": "#3a3f4ccc",
        "scrollbarSlider.background": "#4a5f4b77",
        "scrollbarSlider.hoverBackground": "#3a3f4caa",
        "selection.background": "#746f77",
        "sideBar.background": "#121418",
        "sideBar.foreground": "#dddddd",
        "sideBarSectionHeader.background": "#121418",
        "sideBarTitle.foreground": "#49b6ff",
        "statusBar.background": "#121418",
        "statusBar.debuggingBackground": "#fc634c",
        "statusBar.noFolderBackground": "#121418",
        "statusBarItem.activeBackground": "#07ebc8cc",
        "statusBarItem.hoverBackground": "#0bc9acb0",
        "statusBarItem.prominentBackground": "#0bc9acb0",
        "statusBarItem.prominentHoverBackground": "#07ebc8cc",
        "tab.activeBackground": "#121418",
        "tab.activeBorder": "#49b6ff",
        "tab.activeForeground": "#49b6ff",
        "tab.border": "#15232d",
        "tab.inactiveBackground": "#121418",
        "tab.inactiveForeground": "#a29fa5",
        "terminal.ansiBlue": "#7cb7ff",
        "terminal.ansiBrightBlue": "#7cb7ff",
        "terminal.ansiBrightCyan": "#00e8c6",
        "terminal.ansiBrightGreen": "#96e072",
        "terminal.ansiBrightMagenta": "#ff00aa",
        "terminal.ansiBrightRed": "#ee5d43",
        "terminal.ansiBrightYellow": "#ffe66d",
        "terminal.ansiCyan": "#00e8c6",
        "terminal.ansiGreen": "#96e072",
        "terminal.ansiMagenta": "#ff00aa",
        "terminal.ansiRed": "#ee5d43",
        "terminal.ansiYellow": "#ffe66d",
        "terminalCursor.background": "#121418",
        "terminalCursor.foreground": "#ffe66d",
        "titleBar.activeBackground": "#1e2027",
        "walkThrough.embeddedEditorBackground": "#121418",
        "widget.shadow": "#14151a",
        "search.resultsInfoForeground": "#fff"
    },
    "tokenColors": [
        { "scope": "comment", "settings": { "foreground": "#888888" } },
        {
            "scope": "punctuation.accessor.js",
            "settings": { "foreground": "#00aeff", "fontStyle": "bold" }
        },
        { "scope": "string", "settings": { "foreground": "#FFF59D" } },
        {
            "scope": "constant.numeric",
            "settings": { "foreground": "#ff5990" }
        },
        {
            "scope": "constant.language",
            "settings": { "foreground": "#ff5990" }
        },
        {
            "scope": ["constant.character", "constant.other"],
            "settings": { "foreground": "#ff5990" }
        },
        {
            "scope": "variable",
            "settings": { "fontStyle": "italic", "foreground": "#ffffff" }
        },
        {
            "scope": "meta.var.expr.js",
            "settings": { "fontStyle": "bold", "foreground": "#ffffff" }
        },
        {
            "scope": "variable.other.object.property.js",
            "settings": { "fontStyle": "italic", "foreground": "#fc0054" }
        },
        { "scope": "keyword", "settings": { "foreground": "#E91E63" } },
        {
            "scope": "storage",
            "settings": { "foreground": "#E91E63", "fontStyle": "" }
        },
        {
            "scope": "storage.type",
            "settings": { "foreground": "#00aeff", "fontStyle": "italic" }
        },
        {
            "scope": "entity.name.class",
            "settings": { "foreground": "#9EE34F", "fontStyle": "underline" }
        },
        {
            "scope": "entity.other.inherited-class",
            "settings": {
                "foreground": "#9EE34F",
                "fontStyle": "italic underline"
            }
        },
        {
            "scope": "entity.name.function",
            "settings": { "foreground": "#9EE34F", "fontStyle": "" }
        },
        {
            "scope": "variable.parameter",
            "settings": { "foreground": "#FFAB40", "fontStyle": "italic" }
        },
        {
            "scope": "entity.name.tag",
            "settings": { "foreground": "#E91E63", "fontStyle": "" }
        },
        {
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#9EE34F", "fontStyle": "" }
        },
        {
            "scope": "support.function",
            "settings": { "foreground": "#81D4FA", "fontStyle": "" }
        },
        {
            "scope": "support.constant",
            "settings": { "foreground": "#81D4FA", "fontStyle": "" }
        },
        {
            "scope": ["support.type", "support.class"],
            "settings": { "foreground": "#81D4FA", "fontStyle": "italic" }
        },
        { "scope": "support.other.variable", "settings": { "fontStyle": "" } },
        {
            "scope": ["support.other.namespace", "entity.name.type.namespace"],
            "settings": { "foreground": "#FFB2F9" }
        },
        {
            "scope": "support.other.namespace.use-as.php",
            "settings": { "foreground": "#81D4FA" }
        },
        {
            "scope": "variable.language.namespace.php",
            "settings": { "foreground": "#D66990" }
        },
        {
            "scope": "punctuation.separator.inheritance.php",
            "settings": { "foreground": "#E91E63" }
        },
        {
            "scope": [
                "support.function.misc.css",
                "support.constant.property-value.css",
                "support.constant.font-name.css"
            ],
            "settings": { "foreground": "#FFF59D" }
        },
        {
            "scope": [
                "meta.tag.template.value.twig",
                "meta.tag.template.block.twig"
            ],
            "settings": { "foreground": "#CD5AC5" }
        },
        {
            "scope": "keyword.control.twig",
            "settings": { "foreground": "#E05D8C" }
        },
        {
            "scope": "variable.other.twig",
            "settings": { "foreground": "#E5A5E0" }
        },
        {
            "scope": "variable.other.property.twig",
            "settings": { "foreground": "#FFE1FC" }
        },
        {
            "scope": "constant.language.twig",
            "settings": { "foreground": "#FFD2A6" }
        },
        {
            "scope": "constant.numeric.twig",
            "settings": { "foreground": "#FFD0FB" }
        },
        {
            "scope": "support.function.twig",
            "settings": { "foreground": "#90E7F7" }
        },
        {
            "scope": "meta.function-call.other.twig",
            "settings": { "foreground": "#FAB85A" }
        },
        {
            "scope": "meta.function-call.twig",
            "settings": { "foreground": "#FAB85A" }
        },
        {
            "scope": "invalid",
            "settings": {
                "foreground": "#F8F8F0",
                "background": "#E91E63",
                "fontStyle": ""
            }
        },
        {
            "scope": "invalid.deprecated",
            "settings": { "foreground": "#F8F8F0", "background": "#ff5990" }
        },
        { "scope": "text source", "settings": { "background": "#3D3D3D55" } },
        {
            "scope": ["meta.diff", "meta.diff.header"],
            "settings": { "foreground": "#E0EDDD", "fontStyle": "bold" }
        },
        {
            "scope": "markup.deleted",
            "settings": { "foreground": "#D32F2F", "fontStyle": "" }
        },
        {
            "scope": "markup.changed",
            "settings": { "foreground": "#E53935", "fontStyle": "" }
        },
        { "scope": "markup.inserted", "settings": { "foreground": "#60CF30" } },
        {
            "scope": ["meta.diff", "meta.diff.range"],
            "settings": { "foreground": "#3BC0F0" }
        },
        {
            "scope": [
                "markup.heading.markdown",
                "markup.heading.1.markdown",
                "markup.heading.2.markdown"
            ],
            "settings": { "foreground": "#9EE34F" }
        },
        {
            "scope": "markup.bold.markdown",
            "settings": { "foreground": "#F8F8F2", "fontStyle": "bold" }
        },
        {
            "scope": "markup.italic.markdown",
            "settings": { "foreground": "#F8F8F2", "fontStyle": "italic" }
        },
        {
            "scope": [
                "punctuation.definition.bold.markdown",
                "punctuation.definition.italic.markdown",
                "punctuation.definition.raw.markdown"
            ],
            "settings": { "foreground": "#D32F2F" }
        },
        {
            "scope": "markup.list.unnumbered.markdown",
            "settings": { "foreground": "#ff5990" }
        },
        {
            "scope": "markup.list.numbered.markdown",
            "settings": { "foreground": "#ff5990" }
        },
        {
            "scope": [
                "markup.raw.block.markdown",
                "markup.raw.inline.markdown"
            ],
            "settings": { "foreground": "#FFF59D" }
        },
        {
            "scope": [
                "markup.quote.markdown",
                "punctuation.definition.blockquote.markdown"
            ],
            "settings": { "foreground": "#6C71C4" }
        },
        {
            "scope": "meta.separator.markdown",
            "settings": { "foreground": "#ff5990" }
        },
        {
            "scope": [
                "meta.image.inline.markdown",
                "markup.underline.link.markdown"
            ],
            "settings": { "foreground": "#8C8C8C", "fontStyle": "italic" }
        },
        {
            "scope": [
                "string.other.link.title.markdown",
                "string.other.link.description.markdown"
            ],
            "settings": { "foreground": "#9EE34F" }
        },
        {
            "scope": "punctuation.definition.link.markdown",
            "settings": { "foreground": "#8C8C8C" }
        },
        {
            "scope": "punctuation.definition.metadata.markdown",
            "settings": { "foreground": "#8C8C8C" }
        },
        {
            "scope": [
                "punctuation.definition.string.begin.markdown",
                "punctuation.definition.string.end.markdown",
                "punctuation.definition.constant.markdown"
            ],
            "settings": { "foreground": "#8C8C8C" }
        },
        {
            "scope": "token.info-token",
            "settings": { "foreground": "#6796E6" }
        },
        {
            "scope": "token.warn-token",
            "settings": { "foreground": "#CD9731" }
        },
        {
            "scope": "token.error-token",
            "settings": { "foreground": "#F44747" }
        },
        {
            "scope": "token.debug-token",
            "settings": { "foreground": "#B267E6" }
        },
        {
            "scope": [
                "punctuation.definition.template-expression.begin",
                "punctuation.definition.template-expression.end"
            ],
            "settings": { "foreground": "#ff5990" }
        },
        {
            "scope": ["string.template meta.template.expression"],
            "settings": { "foreground": "#FFFFFF" }
        },
        { "scope": ["source.python"], "settings": { "foreground": "#FFFFFF" } },
        {
            "scope": ["variable.language.special.self.python"],
            "settings": { "foreground": "#72ff4f" }
        },
        {
            "scope": ["meta.function-call.python"],
            "settings": { "foreground": "#4ac0ff", "fontStyle": "italic" }
        },
        {
            "scope": ["meta.object-literal.key.js"],
            "settings": { "foreground": "#4ac0ff", "fontStyle": "italic" }
        }
    ]
}
