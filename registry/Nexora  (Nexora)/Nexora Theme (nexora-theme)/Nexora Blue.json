    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#6B7280", "fontStyle": "italic" }
        },
        {
            "name": "Strings",
            "scope": ["string", "string.quoted"],
            "settings": { "foreground": "#A3BE8C" }
        },
        {
            "name": "String Escape",
            "scope": ["constant.character.escape"],
            "settings": { "foreground": "#F0B35A" }
        },
        {
            "name": "Numbers",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#F0B35A" }
        },
        {
            "name": "Boolean",
            "scope": ["constant.language.boolean"],
            "settings": { "foreground": "#F0B35A" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#FF5C5C" }
        },
        {
            "name": "Operators",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#3B82F6" }
        },
        {
            "name": "Punctuation",
            "scope": ["punctuation"],
            "settings": { "foreground": "#8B92A1" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "meta.definition.variable.name"],
            "settings": { "foreground": "#E6E9EF" }
        },
        {
            "name": "Object Properties",
            "scope": [
                "meta.object-literal.key",
                "meta.object.member",
                "variable.object.property"
            ],
            "settings": { "foreground": "#E6E9EF" }
        },
        {
            "name": "HTML Tag Names",
            "scope": ["entity.name.tag", "entity.name.tag.html"],
            "settings": { "foreground": "#F97316" }
        },
        {
            "name": "HTML Tag Brackets",
            "scope": [
                "punctuation.definition.tag.html",
                "punctuation.definition.tag"
            ],
            "settings": { "foreground": "#EA580C" }
        },
        {
            "name": "HTML Attributes",
            "scope": [
                "entity.other.attribute-name",
                "entity.other.attribute-name.html"
            ],
            "settings": { "foreground": "#FB923C" }
        },
        {
            "name": "HTML Attribute Values",
            "scope": ["string.quoted.single.html", "string.quoted.double.html"],
            "settings": { "foreground": "#A3BE8C" }
        },
        {
            "name": "HTML Script Tag",
            "scope": ["entity.name.tag.script.html"],
            "settings": { "foreground": "#F97316", "fontStyle": "italic" }
        },
        {
            "name": "HTML Style Tag",
            "scope": ["entity.name.tag.style.html"],
            "settings": { "foreground": "#F97316", "fontStyle": "italic" }
        },
        {
            "name": "HTML Entity",
            "scope": [
                "constant.character.entity",
                "constant.character.entity.html"
            ],
            "settings": { "foreground": "#FB923C" }
        },
        {
            "name": "HTML Comment",
            "scope": ["comment.block.html"],
            "settings": { "foreground": "#6B7280", "fontStyle": "italic" }
        },
        {
            "name": "CSS Tag Selector",
            "scope": ["entity.name.tag.css"],
            "settings": { "foreground": "#3B82F6" }
        },
        {
            "name": "CSS Class Selector",
            "scope": ["entity.other.attribute-name.class.css"],
            "settings": { "foreground": "#60A5FA", "fontStyle": "italic" }
        },
        {
            "name": "CSS ID Selector",
            "scope": ["entity.other.attribute-name.id.css"],
            "settings": { "foreground": "#2563EB", "fontStyle": "bold" }
        },
        {
            "name": "CSS Pseudo-class",
            "scope": ["entity.other.pseudo-class.css"],
            "settings": { "foreground": "#60A5FA" }
        },
        {
            "name": "CSS Pseudo-element",
            "scope": ["entity.other.pseudo-element.css"],
            "settings": { "foreground": "#2563EB" }
        },
        {
            "name": "CSS Property Name",
            "scope": ["support.type.property-name.css"],
            "settings": { "foreground": "#2563EB" }
        },
        {
            "name": "CSS Property Value",
            "scope": ["support.constant.property-value.css"],
            "settings": { "foreground": "#60A5FA" }
        },
        {
            "name": "CSS Color Hex",
            "scope": [
                "constant.other.color.rgb-value.css",
                "constant.other.color.hex.css"
            ],
            "settings": { "foreground": "#F0B35A" }
        },
        {
            "name": "CSS Unit",
            "scope": ["keyword.other.unit.css"],
            "settings": { "foreground": "#60A5FA" }
        },
        {
            "name": "CSS At-rule",
            "scope": ["keyword.control.at-rule.css"],
            "settings": { "foreground": "#3B82F6", "fontStyle": "italic" }
        },
        {
            "name": "CSS Vendor Prefix",
            "scope": ["vendor.prefix.css"],
            "settings": { "foreground": "#2563EB" }
        },
        {
            "name": "JS Keywords",
            "scope": [
                "keyword.control.js",
                "keyword.operator.js",
                "storage.type.js"
            ],
            "settings": { "foreground": "#F0B35A" }
        },
        {
            "name": "JS Function Names",
            "scope": [
                "entity.name.function.js",
                "support.function.js",
                "meta.function-call.generic.js"
            ],
            "settings": { "foreground": "#F5C965" }
        },
        {
            "name": "JS Method Names",
            "scope": ["meta.method.js", "entity.name.function.method.js"],
            "settings": { "foreground": "#F5C965" }
        },
        {
            "name": "JS Object Key",
            "scope": ["meta.object-literal.key.js"],
            "settings": { "foreground": "#D4952D" }
        },
        {
            "name": "JS Object Property",
            "scope": ["variable.other.object.property.js"],
            "settings": { "foreground": "#D4952D" }
        },
        {
            "name": "JS Variable Declaration",
            "scope": ["meta.definition.variable.js"],
            "settings": { "foreground": "#F0B35A", "fontStyle": "italic" }
        },
        {
            "name": "JS Import/Export",
            "scope": ["keyword.control.import.js", "keyword.control.export.js"],
            "settings": { "foreground": "#F0B35A", "fontStyle": "bold" }
        },
        {
            "name": "JS Template String",
            "scope": ["string.template.js", "string.template.expression.js"],
            "settings": { "foreground": "#A3BE8C" }
        },
        {
            "name": "JS Template Expression",
            "scope": ["meta.template.expression.js"],
            "settings": { "foreground": "#D4952D" }
        },
        {
