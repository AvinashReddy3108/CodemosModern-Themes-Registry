            "settings": { "foreground": "#00D9FF", "fontStyle": "italic" }
        },
        {
            "name": "TS Interface Property",
            "scope": ["meta.interface.body.ts"],
            "settings": { "foreground": "#00A8CC" }
        },
        {
            "name": "TS Decorator",
            "scope": ["meta.decorator.ts"],
            "settings": { "foreground": "#00D9FF", "fontStyle": "italic" }
        },
        {
            "name": "TS Keywords",
            "scope": ["keyword.control.ts", "storage.type.ts"],
            "settings": { "foreground": "#00D9FF" }
        },
        {
            "name": "TS Namespace",
            "scope": ["entity.name.namespace.ts"],
            "settings": { "foreground": "#22E8FF", "fontStyle": "italic" }
        },
        {
            "name": "TS Function",
