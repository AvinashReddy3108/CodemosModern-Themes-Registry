    "tokenColors": [
        { "scope": ["comment"], "settings": { "foreground": "#feada67e" } },
        {
            "scope": [
                "comment",
                "keyword.control",
                "keyword.operator",
                "variable.language",
                "storage.type",
                "markup.italic.markdown",
                "punctuation.definition.keyword"
            ],
            "settings": { "fontStyle": "italic" }
        },
        {
            "scope": ["keyword.operator.logical"],
            "settings": { "fontStyle": "" }
        },
        {
            "scope": ["markup.heading", "markup.bold.markdown"],
            "settings": { "fontStyle": "bold" }
        },
        {
            "scope": [
                "markup.underline",
                "entity.other.inherited-class",
                "entity.name.type",
                "entity.name.class"
            ],
            "settings": { "fontStyle": "underline" }
        },
        {
            "scope": [
                "keyword.control",
                "keyword.other",
                "keyword.other.DML.sql",
                "markup.heading",
                "markup.underline.link",
                "markup.underline",
                "entity.other.inherited-class",
                "entity.name.section",
                "variable.language",
                "punctuation.definition.binding-pattern",
                "punctuation.section",
                "string.quoted",
                "string.quoted.double.json",
                "string",
                "storage",
                "keyword.other.unit.px.css",
                "keyword.other.unit.fr.css",
                "keyword.other.unit.s.css",
                "keyword.other.unit.percentage.css",
                "entity.name.filename.find-in-files"
            ],
            "settings": { "foreground": "#feada6" }
        },
        {
            "scope": [
                "keyword.operator",
                "storage.type",
                "entity.other.attribute-name",
                "markup.list",
                "punctuation.definition.template-expression",
                "punctuation.definition.list",
                "punctuation.section.embedded",
                "markup.deleted",
                "meta.function-call.generic",
                "support.other.escape.special.regexp"
            ],
            "settings": { "foreground": "#C792EA" }
        },
        {
            "scope": ["constant.numeric", "support.function.builtin"],
            "settings": { "foreground": "#F8C275" }
        },
        {
            "scope": [
                "constant.language",
                "constant.language.null",
                "constant.language.boolean.true",
                "constant.language.boolean.false",
                "beginning.puntuation.definition.list.markdown",
                "entity.other.attribute-name.pseudo-element.css"
            ],
            "settings": { "foreground": "#F39B35" }
        },
        {
            "scope": [
                "punctuation.definition.string",
                "constant.character.escape",
                "support.class",
                "constant",
                "support.type"
            ],
            "settings": { "foreground": "#88ff00" }
        },
        {
            "scope": [
                "punctuation.accessor",
                "punctuation.terminator",
                "punctuation.separator.continuation",
                "markup.quote",
                "markup.changed",
                "string.quoted.docstring",
                "keyword.type",
                "variable.other.object",
                "constant.other.database-name.sql"
            ],
            "settings": { "foreground": "#00ffff" }
        },
        {
            "scope": [
                "variable.parameter",
                "variable.other.object.property",
                "meta.structure.dictionary.json",
                "punctuation.definition.parameters",
                "punctuation.definition.block",
                "punctuation.definition.dictionary",
                "punctuation.definition.array"
            ],
            "settings": { "foreground": "#f76c8a" }
        },
        {
            "scope": ["support.constant"],
            "settings": { "foreground": "#fcf6ff" }
        },
        {
            "scope": [
                "support.function",
                "entity.name.tag",
                "entity.name.function"
            ],
            "settings": { "foreground": "#82AAFF" }
        },
        {
            "scope": [
                "entity.name.type",
                "support.type.property-name",
                "punctuation.support",
                "markup.fenced_code.block.markdown"
            ],
            "settings": { "foreground": "#8DF9F9" }
        },
        {
            "scope": [
                "meta.tag",
                "string.regexp",
                "punctuation.definition.tag"
            ],
            "settings": { "foreground": "#9d75b8" }
        },
        {
            "scope": [
                "punctuation.separator",
                "support.variable",
                "keyword.other.alias.sql"
            ],
            "settings": { "foreground": "#c7ADFB" }
        },
        {
            "scope": [
                "meta.object-literal.key.js",
                "meta.brace",
                "meta.brace.square.js",
                "meta.brace.square.ts",
                "variable",
                "constant.other.table-name.sql"
            ],
            "settings": { "foreground": "#fbd3e1" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
