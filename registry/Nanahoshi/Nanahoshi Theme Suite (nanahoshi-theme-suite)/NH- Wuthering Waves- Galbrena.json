    "tokenColors": [
        {
            "name": "Editor text",
            "scope": ["source", "text"],
            "settings": { "foreground": "#F8F8F2" }
        },
        {
            "name": "Comments",
            "scope": [
                "comment",
                "punctuation.definition.comment",
                "string.quoted.docstring"
            ],
            "settings": { "foreground": "#6272A4" }
        },
        {
            "name": "Doc comment tags",
            "scope": [
                "storage.type.class.jsdoc",
                "keyword.other.documentation",
                "punctuation.definition.block.tag.jsdoc",
                "entity.name.tag.yaml"
            ],
            "settings": { "foreground": "#FFB74D", "fontStyle": "bold italic" }
        },
        {
            "name": "Doc comment values",
            "scope": [
                "variable.other.jsdoc",
                "meta.other.type.phpdoc",
                "variable.parameter.jsdoc"
            ],
            "settings": { "foreground": "#FF89EEFF" }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.control.flow",
                "keyword.control.import",
                "keyword.other",
                "keyword.declaration",
                "storage.type",
                "storage.modifier"
            ],
            "settings": { "foreground": "#3B67FFFF" }
        },
        {
            "name": "Strings",
            "scope": [
                "string",
                "string.quoted",
                "string.quoted.single",
                "string.quoted.double",
                "string.quoted.triple",
                "string.template"
            ],
            "settings": { "foreground": "#FF89EEFF" }
        },
        {
            "name": "String escapes",
            "scope": [
                "constant.character.escape",
                "constant.character.unicode"
            ],
            "settings": { "foreground": "#FF89EEFF" }
        },
        {
            "name": "Invalid string escapes",
            "scope": ["invalid.illegal.escape"],
            "settings": { "foreground": "#EF55B4FF" }
        },
        {
            "name": "Numbers",
            "scope": [
                "constant.numeric",
                "constant.numeric.integer",
                "constant.numeric.float",
                "constant.numeric.hex",
                "constant.numeric.octal",
                "constant.numeric.binary"
            ],
            "settings": { "foreground": "#FF9800" }
        },
        {
            "name": "Constants",
            "scope": [
                "constant.language",
                "constant.language.boolean",
                "constant.language.null",
                "constant.language.undefined",
                "variable.other.constant",
                "support.constant"
            ],
            "settings": { "foreground": "#FF9800" }
        },
        {
            "name": "Class names",
            "scope": [
                "entity.name.class",
                "entity.name.type.class",
                "entity.name.type",
                "entity.other.inherited-class",
                "support.class",
                "meta.class entity.name"
            ],
            "settings": { "foreground": "#EF55B4FF" }
        },
        {
            "name": "Type references",
            "scope": [
                "entity.name.type.instance",
                "support.type",
                "storage.type.generic",
                "entity.name.type.parameter",
                "meta.type.annotation entity.name.type"
            ],
            "settings": { "foreground": "#EF55B4FF" }
        },
        {
            "name": "Interface / enum names",
            "scope": [
                "entity.name.interface",
                "entity.name.type.interface",
                "entity.name.type.enum"
            ],
            "settings": { "foreground": "#FF99D5FF" }
        },
        {
            "name": "Function declarations",
            "scope": [
                "entity.name.function",
                "entity.name.function.constructor",
                "entity.name.function.destructor"
            ],
            "settings": { "foreground": "#EF55B4FF" }
        },
        {
            "name": "Function calls",
            "scope": [
                "meta.function-call",
                "meta.function-call entity.name.function",
                "variable.function",
                "support.function"
            ],
            "settings": { "foreground": "#00BFFF" }
        },
        {
            "name": "Parameters",
            "scope": [
                "variable.parameter",
                "meta.function.parameter variable",
                "meta.parameter"
            ],
            "settings": { "foreground": "#E1BEE7" }
        },
        {
            "name": "Identifiers",
            "scope": [
                "variable",
                "variable.other",
                "variable.other.readwrite",
                "variable.other.object"
            ],
            "settings": { "foreground": "#F8F8F2" }
        },
        {
            "name": "Instance fields",
            "scope": [
                "variable.other.object.property",
                "variable.other.member",
                "variable.other.property",
                "support.variable.property",
                "meta.object-literal.key"
            ],
            "settings": { "foreground": "#F8F8F2", "fontStyle": "bold" }
        },
        {
            "name": "Static members",
            "scope": [
                "variable.other.global",
                "variable.other.static",
                "support.variable",
                "meta.property-access support.variable"
            ],
            "settings": { "foreground": "#FDD796FF" }
        },
        {
            "name": "Language variables (this, self, super)",
            "scope": [
                "variable.language",
                "variable.language.this",
                "variable.language.self",
                "variable.language.super"
            ],
            "settings": { "foreground": "#EF55B4FF" }
        },
        {
            "name": "Operators",
            "scope": [
                "keyword.operator",
                "keyword.operator.arithmetic",
                "keyword.operator.assignment",
                "keyword.operator.comparison",
                "keyword.operator.logical",
                "keyword.operator.bitwise",
                "keyword.operator.type"
            ],
            "settings": { "foreground": "#3B67FFFF" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation.separator",
                "punctuation.terminator",
                "punctuation.accessor",
                "punctuation.definition.parameters.begin",
                "punctuation.definition.parameters.end"
            ],
            "settings": { "foreground": "#3B67FFFF" }
        },
        {
            "name": "HTML/XML tags",
            "scope": [
                "entity.name.tag",
                "meta.tag.sgml",
                "punctuation.definition.tag"
            ],
            "settings": { "foreground": "#3B67FFFF" }
        },
        {
            "name": "HTML/XML attributes",
            "scope": [
                "entity.other.attribute-name",
                "entity.other.attribute-name.html",
                "meta.tag entity.other.attribute-name"
            ],
            "settings": { "foreground": "#65B1E2FF" }
        },
        {
            "name": "HTML/XML attribute values",
            "scope": [
                "string.quoted.double.html",
                "string.quoted.single.html",
                "meta.attribute-with-value.html string"
            ],
            "settings": { "foreground": "#FF89EEFF" }
        },
        {
            "name": "HTML entities",
            "scope": [
                "constant.character.entity",
                "punctuation.definition.entity.html"
            ],
            "settings": { "foreground": "#FF9800" }
        },
        {
            "name": "Annotations / Decorators",
            "scope": [
                "meta.decorator",
                "entity.name.function.decorator",
                "storage.type.annotation",
                "punctuation.decorator"
            ],
            "settings": { "foreground": "#00BFFF" }
        },
        {
            "name": "CSS property names",
            "scope": [
                "support.type.property-name",
                "support.type.property-name.css",
                "support.type.property-name.scss",
                "support.type.property-name.less",
                "meta.property-name"
            ],
            "settings": { "foreground": "#FFB74D" }
        },
        {
            "name": "CSS property values",
            "scope": [
                "support.constant.property-value",
                "support.constant.color",
                "support.constant.font-name",
                "meta.property-value"
            ],
            "settings": { "foreground": "#FF89EEFF" }
        },
        {
            "name": "CSS pseudo-classes / IDs",
            "scope": [
                "entity.other.attribute-name.pseudo-class",
                "entity.other.attribute-name.pseudo-element",
                "entity.other.attribute-name.id",
                "entity.other.attribute-name.class.css"
            ],
            "settings": { "foreground": "#EF55B4FF" }
        },
        {
            "name": "CSS at-rules",
            "scope": [
                "keyword.control.at-rule",
                "keyword.control.at-rule.media",
                "keyword.control.at-rule.keyframes",
                "keyword.control.at-rule.import"
            ],
            "settings": { "foreground": "#3B67FFFF" }
        },
        {
            "name": "Regular expressions",
            "scope": [
                "string.regexp",
                "string.regexp.character-class",
                "constant.other.character-class.regexp",
                "keyword.operator.quantifier.regexp",
                "keyword.control.anchor.regexp"
            ],
            "settings": { "foreground": "#FF89EEFF" }
        },
        {
            "name": "Regex groups",
            "scope": [
                "punctuation.definition.group.regexp",
                "punctuation.definition.group.assertion.regexp",
                "keyword.operator.or.regexp"
            ],
            "settings": { "foreground": "#3B67FFFF" }
        },
        {
            "name": "JSON keys",
            "scope": [
                "support.type.property-name.json",
                "meta.structure.dictionary.key.json string",
                "meta.mapping.key string"
            ],
            "settings": { "foreground": "#00BFFF" }
        },
        {
            "name": "YAML keys",
            "scope": ["entity.name.tag.yaml", "meta.mapping.key.yaml string"],
            "settings": { "foreground": "#00BFFF" }
        },
        {
            "name": "Kotlin function literal braces",
            "scope": [
                "punctuation.definition.function.kotlin",
                "keyword.operator.arrow.kotlin"
            ],
            "settings": { "foreground": "#3B67FFFF" }
        },
        {
            "name": "Markup headings",
            "scope": [
                "markup.heading",
                "markup.heading.markdown",
                "entity.name.section.markdown"
            ],
            "settings": { "foreground": "#3B67FFFF", "fontStyle": "bold" }
        },
        {
            "name": "Markup bold",
            "scope": ["markup.bold", "punctuation.definition.bold"],
            "settings": { "foreground": "#EF55B4FF", "fontStyle": "bold" }
        },
        {
            "name": "Markup italic",
            "scope": ["markup.italic", "punctuation.definition.italic"],
            "settings": { "foreground": "#E1BEE7", "fontStyle": "italic" }
        },
        {
            "name": "Markup inline code",
            "scope": [
                "markup.inline.raw",
                "markup.raw.inline",
                "markup.raw.block"
            ],
            "settings": { "foreground": "#FF89EEFF" }
        },
        {
            "name": "Markup links",
            "scope": [
                "markup.underline.link",
                "string.other.link",
                "meta.link"
            ],
            "settings": { "foreground": "#00BFFF" }
        },
        {
            "name": "Markup blockquote",
            "scope": ["markup.quote", "markup.quote.markdown"],
            "settings": { "foreground": "#6272A4" }
        },
        {
            "name": "Imported / exported names",
            "scope": [
                "meta.import variable.other.readwrite.alias",
                "meta.import variable.other.readwrite",
                "meta.export variable.other.readwrite.alias",
                "meta.export variable.other.readwrite",
                "meta.statement.import variable",
                "meta.import-from variable"
            ],
            "settings": { "foreground": "#EF55B4FF" }
        },
        {
            "name": "Invalid / errors",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#FF3366" }
        }
    ],
    "semanticTokenColors": {
        "class": "#EF55B4FF",
        "class.declaration": "#EF55B4FF",
        "interface": "#FF99D5FF",
        "interface.declaration": "#FF99D5FF",
        "enum": "#FF99D5FF",
        "enum.declaration": "#FF99D5FF",
        "type": "#FF99D5FF",
        "type.declaration": "#FF99D5FF",
        "typeParameter": "#EF55B4FF",
        "function": "#EF55B4FF",
        "function.declaration": "#EF55B4FF",
        "method": "#00BFFF",
        "method.declaration": "#00BFFF",
        "enumMember": "#FF9800",
        "variable.readonly": "#F8F8F2",
        "parameter": "#E1BEE7",
        "property": { "foreground": "#F8F8F2", "bold": true }
    },
    "$schema": "vscode://schemas/color-theme"
}
