    "semanticHighlighting": true,
    "tokenColors": [
        {
            "name": "Comment",
            "scope": [
                "comment",
                "punctuation.definition.comment",
                "string.comment"
            ],
            "settings": { "foreground": "#6a737d" }
        },
        {
            "name": "Constant",
            "scope": [
                "constant",
                "entity.name.constant",
                "variable.other.constant",
                "variable.other.enummember",
                "variable.language"
            ],
            "settings": { "foreground": "#005cc5" }
        },
        {
            "name": "Entity",
            "scope": ["entity", "entity.name"],
            "settings": { "foreground": "#6f42c1" }
        },
        {
            "name": "Entity Name",
            "scope": [
                "entity.name",
                "meta.export.default",
                "meta.definition.variable"
            ],
            "settings": { "foreground": "#e36209" }
        },
        {
            "name": "Default Text",
            "scope": [
                "variable.parameter.function",
                "meta.jsx.children",
                "meta.block",
                "meta.tag.attributes",
                "entity.name.constant",
                "meta.object.member",
                "meta.embedded.expression"
            ],
            "settings": { "foreground": "#24292e" }
        },
        {
            "name": "Function",
            "scope": ["entity.name.function"],
            "settings": { "foreground": "#6f42c1" }
        },
        {
            "name": "Tag",
            "scope": ["entity.name.tag", "support.class.component"],
            "settings": { "foreground": "#22863a" }
        },
        {
            "name": "Keyword",
            "scope": ["keyword"],
            "settings": { "foreground": "#d73a49" }
        },
        {
            "name": "Storage",
            "scope": ["storage", "storage.type"],
            "settings": { "foreground": "#d73a49" }
        },
        {
            "name": "Storage Modifier",
            "scope": [
                "storage.modifier.package",
                "storage.modifier.import",
                "storage.type.java"
            ],
            "settings": { "foreground": "#24292e" }
        },
        {
            "name": "String",
            "scope": ["string", "string punctuation.section.embedded source"],
            "settings": { "foreground": "#032f62" }
        },
        {
            "name": "Support",
            "scope": ["support"],
            "settings": { "foreground": "#005cc5" }
        },
        {
            "name": "Property Name",
            "scope": ["meta.property-name", "support.type.property-name"],
            "settings": { "foreground": "#005cc5" }
        },
        {
            "name": "Variable",
            "scope": ["variable"],
            "settings": { "foreground": "#e36209" }
        },
        {
            "name": "Variable Other",
            "scope": ["variable.other"],
            "settings": { "foreground": "#24292e" }
        },
        {
            "name": "Invalid",
            "scope": [
                "invalid.broken",
                "invalid.deprecated",
                "invalid.illegal",
                "invalid.unimplemented"
            ],
            "settings": { "foreground": "#b31d28", "fontStyle": "italic" }
        },
        {
            "name": "String Variable",
            "scope": ["string variable"],
            "settings": { "foreground": "#005cc5" }
        },
        {
            "name": "Regexp",
            "scope": ["source.regexp", "string.regexp"],
            "settings": { "foreground": "#032f62" }
        },
        {
            "name": "Regexp Escape",
            "scope": ["string.regexp constant.character.escape"],
            "settings": { "foreground": "#22863a", "fontStyle": "bold" }
        },
        {
            "name": "Support Constant",
            "scope": ["support.constant", "support.variable"],
            "settings": { "foreground": "#005cc5" }
        },
        {
            "name": "JSON Property",
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#22863a" }
        },
        {
            "name": "Punctuation Embedded",
            "scope": ["punctuation.section.embedded"],
            "settings": { "foreground": "#d73a49" }
        },
        {
            "name": "Constant Character",
            "scope": ["constant.other.placeholder", "constant.character"],
            "settings": { "foreground": "#d73a49" }
        },
        {
            "name": "Markup Heading",
            "scope": ["markup.heading", "markup.heading entity.name"],
            "settings": { "foreground": "#005cc5", "fontStyle": "bold" }
        },
        {
            "name": "Markup Quote",
            "scope": ["markup.quote"],
            "settings": { "foreground": "#22863a" }
        },
        {
            "name": "Markup Italic",
            "scope": ["markup.italic"],
            "settings": { "foreground": "#24292e", "fontStyle": "italic" }
        },
        {
            "name": "Markup Bold",
            "scope": ["markup.bold"],
            "settings": { "foreground": "#24292e", "fontStyle": "bold" }
        },
        {
            "name": "Markup Underline",
            "scope": ["markup.underline"],
            "settings": { "fontStyle": "underline" }
        },
        {
            "name": "Markup Strikethrough",
            "scope": ["markup.strikethrough"],
            "settings": { "fontStyle": "strikethrough" }
        },
        {
            "name": "Markup Raw",
            "scope": ["markup.inline.raw"],
            "settings": { "foreground": "#005cc5" }
        },
        {
            "name": "Markup Deleted",
            "scope": [
                "markup.deleted",
                "meta.diff.header.from-file",
                "punctuation.definition.deleted"
            ],
            "settings": { "foreground": "#b31d28" }
        },
        {
            "name": "Markup Inserted",
            "scope": [
                "markup.inserted",
                "meta.diff.header.to-file",
                "punctuation.definition.inserted"
            ],
            "settings": { "foreground": "#22863a" }
        },
        {
            "name": "Markup Changed",
            "scope": ["markup.changed", "punctuation.definition.changed"],
            "settings": { "foreground": "#e36209" }
        },
        {
            "name": "Diff Range",
            "scope": ["meta.diff.range"],
            "settings": { "foreground": "#6f42c1", "fontStyle": "bold" }
        },
        {
            "name": "Diff Header",
            "scope": ["meta.diff.header"],
            "settings": { "foreground": "#005cc5" }
        },
        {
            "name": "Bracket Highlighter",
            "scope": [
                "brackethighlighter.tag",
                "brackethighlighter.curly",
                "brackethighlighter.round",
                "brackethighlighter.square",
                "brackethighlighter.angle",
                "brackethighlighter.quote"
            ],
            "settings": { "foreground": "#586069" }
        },
        {
            "name": "Bracket Unmatched",
            "scope": ["brackethighlighter.unmatched"],
            "settings": { "foreground": "#b31d28" }
        },
        {
            "name": "Link",
            "scope": ["constant.other.reference.link", "string.other.link"],
            "settings": { "foreground": "#032f62" }
        },
        {
            "name": "HTML Tag",
            "scope": ["entity.name.tag.html"],
            "settings": { "foreground": "#22863a" }
        },
        {
            "name": "HTML Attribute Name",
            "scope": [
                "entity.other.attribute-name.html",
                "entity.other.attribute-name"
            ],
            "settings": { "foreground": "#6f42c1" }
        },
        {
            "name": "HTML Attribute Value",
            "scope": ["string.quoted.double.html", "string.quoted.single.html"],
            "settings": { "foreground": "#032f62" }
        },
        {
            "name": "HTML Punctuation Tag",
            "scope": [
                "punctuation.definition.tag.html",
                "punctuation.definition.tag.begin.html",
                "punctuation.definition.tag.end.html"
            ],
            "settings": { "foreground": "#22863a" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
