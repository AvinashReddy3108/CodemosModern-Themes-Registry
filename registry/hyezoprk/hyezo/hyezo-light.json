    "tokenColors": [
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#8D9AA6" }
        },
        {
            "scope": "comment.block.preprocessor",
            "settings": { "foreground": "#AAAAAA", "fontStyle": "" }
        },
        {
            "scope": [
                "meta.brace.square",
                "meta.brace.round",
                "punctuation.separator.parameter"
            ],
            "settings": { "foreground": "#999999" }
        },
        {
            "scope": ["variable.parameter", "meta.function.parameter variable"],
            "settings": { "foreground": "#990055" }
        },
        {
            "scope": [
                "meta.embedded",
                "source.groovy.embedded",
                "meta.template.expression"
            ],
            "settings": { "foreground": "#494949" }
        },
        {
            "scope": "invalid.deprecated",
            "settings": { "foreground": "#96000080" }
        },
        {
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#D93556" }
        },
        {
            "scope": [
                "keyword.operator",
                "constant.language.import-export-all"
            ],
            "settings": { "foreground": "#9A6E3A" }
        },
        {
            "scope": ["keyword", "storage"],
            "settings": { "foreground": "#0077AA" }
        },
        {
            "scope": [
                "storage.type",
                "support.type",
                "keyword.operator.expression",
                "keyword.operator.new"
            ],
            "settings": { "foreground": "#0077AA" }
        },
        {
            "scope": [
                "cast.expr.ts meta.brace.angle.ts",
                "keyword.operator.definiteassignment"
            ],
            "settings": { "foreground": "#EE9900" }
        },
        {
            "scope": [
                "constant.language",
                "support.constant",
                "variable.language"
            ],
            "settings": { "foreground": "#0077AA" }
        },
        {
            "scope": [
                "support.variable.property.dom",
                "support.variable.dom",
                "support.variable.property",
                "variable"
            ],
            "settings": { "foreground": "#494949" }
        },
        {
            "scope": [
                "meta.template.expression punctuation.definition.template-expression",
                "expression.embedded punctuation.definition.generic",
                "punctuation.section.embedded",
                "variable.interpolation",
                "string.interpolated.pug",
                "meta.interpolation.stylus meta.brace.curly"
            ],
            "settings": { "foreground": "#EE9900", "fontStyle": "bold" }
        },
        {
            "scope": [
                "entity.name.function",
                "support.function",
                "new.expr entity.name.type"
            ],
            "settings": { "foreground": "#D93556" }
        },
        {
            "scope": ["support.class"],
            "settings": { "foreground": "#D93556", "fontStyle": "bold" }
        },
        {
            "scope": "entity.other.inherited-class",
            "settings": { "foreground": "#008D55" }
        },
        { "scope": "support.class", "settings": { "foreground": "#008D55" } },
        {
            "scope": "support.class.component",
            "settings": { "foreground": "#D93556" }
        },
        {
            "scope": [
                "entity.name.type",
                "support.type.primitive",
                "support.type.builtin",
                "meta.type.annotation entity.name.type",
                "meta.type.parameters entity.name.type"
            ],
            "settings": { "foreground": "#708090" }
        },
        { "scope": "entity.name.type", "settings": { "fontStyle": "bold" } },
        {
            "scope": [
                "punctuation.definition.typeparameters",
                "keyword.operator.type",
                "keyword.operator.optional",
                "source.tsx punctuation.section.embedded",
                "source.jsx punctuation.section.embedded"
            ],
            "settings": { "foreground": "#EE9900", "fontStyle": "" }
        },
        {
            "scope": [
                "entity.other.attribute-name.html",
                "entity.other.attribute-name.id.html",
                "entity.other.attribute-name.tsx"
            ],
            "settings": { "foreground": "#0077AA" }
        },
        {
            "scope": "entity.name.exception",
            "settings": { "foreground": "#660000" }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.character",
                "constant",
                "constant.language.boolean",
                "constant.language.nan",
                "constant.language.infinity",
                "constant.language.undefined",
                "constant.language.null",
                "source.editorconfig constant.language"
            ],
            "settings": { "foreground": "#990055", "fontStyle": "bold" }
        },
        {
            "scope": ["entity.other.inherited-class"],
            "settings": { "fontStyle": "bold" }
        },
        {
            "scope": ["string", "punctuation.definition.string"],
            "settings": { "foreground": "#008D55" }
        },
        {
            "scope": "constant.character.escape",
            "settings": { "foreground": "#EE9900" }
        },
        {
            "scope": [
                "string.regexp",
                "string.regexp punctuation.definition.string"
            ],
            "settings": { "foreground": "#EE9900" }
        },
        {
            "scope": "constant.other.symbol",
            "settings": { "foreground": "#AB6526" }
        },
        { "scope": "punctuation", "settings": { "foreground": "#999999" } },
        {
            "scope": [
                "meta.tag.metadata.doctype entity.name.tag",
                "meta.tag.metadata.doctype punctuation.definition.tag",
                "meta.tag.metadata.doctype entity.other.attribute-name.html",
                "meta.tag.sgml.doctype"
            ],
            "settings": { "foreground": "#8D9AA6BB" }
        },
        { "scope": "entity.name.tag", "settings": { "foreground": "#990055" } },
        {
            "scope": ["meta.tag string"],
            "settings": { "foreground": "#0077AA" }
        },
        {
            "scope": [
                "meta.tag entity.other.attribute-name",
                "entity.other.attribute-name.html"
            ],
            "settings": { "foreground": "#0077AA" }
        },
        {
            "scope": [
                "constant.character.entity",
                "punctuation.definition.entity"
            ],
            "settings": { "foreground": "#AB6526" }
        },
        {
            "scope": ["meta.property-name", "support.type.property-name"],
            "settings": { "foreground": "#990055" }
        },
        {
            "scope": ["keyword.control.at-rule.import"],
            "settings": { "foreground": "#0077AA" }
        },
        {
            "scope": [
                "entity.other.attribute-name.class",
                "entity.other.attribute-name punctuation.definition.entity"
            ],
            "settings": { "foreground": "#008D55" }
        },
        {
            "scope": ["entity.name.tag.css"],
            "settings": { "foreground": "#EE9900" }
        },
        {
            "scope": [
                "entity.other.attribute-name.id",
                "entity.other.attribute-name.id punctuation.definition.entity"
            ],
            "settings": { "foreground": "#9A6E3A" }
        },
        {
            "scope": ["entity.other.attribute-name.id.html"],
            "settings": { "foreground": "#008D55" }
        },
        {
            "scope": ["constant.numeric.css"],
            "settings": { "foreground": "#384048" }
        },
        {
            "scope": [
                "entity.other.attribute-name punctuation.definition.entity"
            ],
            "settings": { "foreground": "#999999" }
        },
        {
            "scope": ["constant.numeric keyword.other.unit"],
            "settings": { "foreground": "#8D9AA6" }
        },
        {
            "scope": ["variable.parameter.url"],
            "settings": { "foreground": "#9A6E3A" }
        },
        {
            "scope": ["constant.other.color"],
            "settings": { "foreground": "#0077AA" }
        },
        {
            "scope": [
                "entity.other.attribute-name.pseudo-element",
                "entity.other.attribute-name.pseudo-class"
            ],
            "settings": { "foreground": "#0077AA" }
        },
        {
            "scope": [
                "meta.property-value",
                "meta.property-value constant.other",
                "support.constant.property-value"
            ],
            "settings": { "foreground": "#448C27" }
        },
        {
            "scope": "keyword.other.important",
            "settings": { "foreground": "#D93556", "fontStyle": "bold" }
        },
        { "scope": ["variable.scss"], "settings": { "foreground": "#EE9900" } },
        {
            "scope": ["entity.name.tag.reference.scss"],
            "settings": { "foreground": "#9A6E3A" }
        },
        { "scope": "markup.changed", "settings": { "foreground": "#EE9900" } },
        { "scope": "markup.deleted", "settings": { "foreground": "#D93556" } },
        { "scope": "markup.error", "settings": { "foreground": "#660000" } },
        { "scope": "markup.inserted", "settings": { "foreground": "#008D55" } },
        { "scope": "meta.link", "settings": { "foreground": "#4B83CD" } },
        {
            "scope": ["markup.output", "markup.raw"],
            "settings": { "foreground": "#777777" }
        },
        { "scope": "markup.prompt", "settings": { "foreground": "#777777" } },
        { "scope": "markup.heading", "settings": { "foreground": "#AA3731" } },
        {
            "scope": "markup.traceback",
            "settings": { "foreground": "#660000" }
        },
        {
            "scope": "markup.underline",
            "settings": { "fontStyle": "underline" }
        },
        { "scope": "markup.quote", "settings": { "foreground": "#7A3E9D" } },
        {
            "scope": ["meta.diff.range", "meta.diff.index", "meta.separator"],
            "settings": { "foreground": "#0077AA" }
        },
        {
            "scope": "meta.diff.header.from-file",
            "settings": { "foreground": "#990055" }
        },
        {
            "scope": "meta.diff.header.to-file",
            "settings": { "foreground": "#008D55" }
        },
        {
            "scope": ["entity.name.section.group-title.ini"],
            "settings": { "foreground": "#EE9900", "fontStyle": "bold" }
        },
        {
            "scope": ["punctuation.definition.entity.ini"],
            "settings": { "foreground": "#999999" }
        },
        {
            "scope": ["keyword.other.definition.ini"],
            "settings": { "foreground": "#990055" }
        },
        { "scope": ["source.ini"], "settings": { "foreground": "#0077AA" } },
        {
            "scope": ["entity.name.section.markdown", "markup.heading.setext"],
            "settings": { "foreground": "#EE9900", "fontStyle": "bold" }
        },
        {
            "scope": ["punctuation.definition.list"],
            "settings": { "foreground": "#D93556" }
        },
        {
            "scope": ["markup.inline.raw"],
            "settings": { "foreground": "#0077AA" }
        },
        {
            "scope": [
                "meta.link punctuation.definition.string",
                "meta.image punctuation.definition.string"
            ],
            "settings": { "foreground": "#999999" }
        },
        { "scope": "markup.bold", "settings": { "fontStyle": "bold" } },
        { "scope": "markup.italic", "settings": { "fontStyle": "italic" } },
        {
            "scope": ["markup.underline.link.image.markdown"],
            "settings": { "foreground": "#990055DD" }
        },
        {
            "scope": ["markup.heading.setext"],
            "settings": { "foreground": "#9BA6B1" }
        },
        {
            "scope": "constant.numeric.json",
            "settings": { "foreground": "#0077AA" }
        },
        {
            "scope": "string.interpolated.pug variable",
            "settings": { "foreground": "#494949" }
        },
        {
            "scope": ["support.variable"],
            "settings": { "foreground": "#EE9900" }
        },
        {
            "scope": ["meta.tag string", "source.vue string.quoted"],
            "settings": { "foreground": "#008D55" }
        },
        {
            "scope": "meta.directive.vue entity.other.attribute-name.html",
            "settings": { "foreground": "#E19100" }
        },
        {
            "scope": [
                "meta.function-call.generic.python",
                "meta.function-call support.type"
            ],
            "settings": { "foreground": "#D93556" }
        },
        {
            "scope": [
                "punctuation.definition.list.end.python",
                "punctuation.definition.list.begin.python"
            ],
            "settings": { "foreground": "#999999" }
        },
        {
            "scope": ["support.type.exception", "entity.name.exception"],
            "settings": { "foreground": "#D93556", "fontStyle": "bold" }
        },
        { "scope": "log.info", "settings": { "foreground": "#0087C1" } },
        { "scope": "log.warning", "settings": { "foreground": "#EE9900" } },
        { "scope": "log.error", "settings": { "foreground": "#D93556" } },
        { "scope": "log.debug", "settings": { "foreground": "#9A6E3A" } },
        { "scope": "log.constant", "settings": { "foreground": "#990055" } },
        {
            "scope": "comment.block.documentation variable.other.jsdoc",
            "settings": { "foreground": "#494949" }
        },
        {
            "scope": "punctuation.definition.directive",
            "settings": { "foreground": "#990055" }
        },
        {
            "scope": "string.quoted.other.lt-gt.include punctuation.definition.string",
            "settings": { "foreground": "#999999" }
        },
        {
            "scope": "punctuation.separator.namespace",
            "settings": { "foreground": "#9A6E3A" }
        },
        {
            "scope": ["meta.import.java storage.modifier"],
            "settings": { "foreground": "#990055" }
        },
        {
            "scope": ["keyword.operator.instanceof.java"],
            "settings": { "foreground": "#0077AA" }
        },
        {
            "scope": [
                "punctuation.definition.variable.begin.batchfile",
                "punctuation.definition.variable.end.batchfile"
            ],
            "settings": { "foreground": "#D93556" }
