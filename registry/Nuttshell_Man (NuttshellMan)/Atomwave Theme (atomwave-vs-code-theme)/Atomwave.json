    "semanticHighlighting": true,
    "tokenColors": [
        {
            "scope": [
                "comment",
                "punctuation.definition.comment",
                "string.comment"
            ],
            "settings": { "foreground": "#ccc8" }
        },
        {
            "scope": [
                "constant",
                "entity.name.constant",
                "variable.other.constant",
                "variable.other.enummember",
                "variable.language"
            ],
            "settings": { "foreground": "#61abff" }
        },
        {
            "scope": ["entity", "entity.name"],
            "settings": { "foreground": "#a075f0" }
        },
        {
            "scope": "variable.parameter.function",
            "settings": { "foreground": "#ccc" }
        },
        { "scope": "entity.name.tag", "settings": { "foreground": "#0f9" } },
        { "scope": "keyword", "settings": { "foreground": "#fb606f" } },
        {
            "scope": ["storage", "storage.type"],
            "settings": { "foreground": "#fb606f" }
        },
        {
            "scope": [
                "storage.modifier.package",
                "storage.modifier.import",
                "storage.type.java"
            ],
            "settings": { "foreground": "#ccc" }
        },
        {
            "scope": [
                "string",
                "punctuation.definition.string",
                "string punctuation.section.embedded source"
            ],
            "settings": { "foreground": "#8fc3ff" }
        },
        { "scope": "support", "settings": { "foreground": "#61abff" } },
        {
            "scope": "meta.property-name",
            "settings": { "foreground": "#61abff" }
        },
        { "scope": "variable", "settings": { "foreground": "#ffa05c" } },
        { "scope": "variable.other", "settings": { "foreground": "#ccc" } },
        {
            "scope": "invalid.broken",
            "settings": { "fontStyle": "italic", "foreground": "#ff9ea9" }
        },
        {
            "scope": "invalid.deprecated",
            "settings": { "fontStyle": "italic", "foreground": "#ff9ea9" }
        },
        {
            "scope": "invalid.illegal",
            "settings": { "fontStyle": "italic", "foreground": "#ff9ea9" }
        },
        {
            "scope": "invalid.unimplemented",
            "settings": { "fontStyle": "italic", "foreground": "#ff9ea9" }
        },
        {
            "scope": "carriage-return",
            "settings": {
                "fontStyle": "italic underline",
                "background": "#fb606f",
                "foreground": "#141414",
                "content": "^M"
            }
        },
        { "scope": "message.error", "settings": { "foreground": "#ff9ea9" } },
        { "scope": "string variable", "settings": { "foreground": "#61abff" } },
        {
            "scope": ["source.regexp", "string.regexp"],
            "settings": { "foreground": "#cce6ff" }
        },
        {
            "scope": [
                "string.regexp.character-class",
                "string.regexp constant.character.escape",
                "string.regexp source.ruby.embedded",
                "string.regexp string.regexp.arbitrary-repitition"
            ],
            "settings": { "foreground": "#cce6ff" }
        },
        {
            "scope": "string.regexp constant.character.escape",
            "settings": { "fontStyle": "bold", "foreground": "#0f9" }
        },
        {
            "scope": "support.constant",
            "settings": { "foreground": "#61abff" }
        },
        {
            "scope": "support.variable",
            "settings": { "foreground": "#61abff" }
        },
        {
            "scope": "meta.module-reference",
            "settings": { "foreground": "#61abff" }
        },
        {
            "scope": "punctuation.definition.list.begin.markdown",
            "settings": { "foreground": "#ffa05c" }
        },
        {
            "scope": ["markup.heading", "markup.heading entity.name"],
            "settings": { "fontStyle": "bold", "foreground": "#61abff" }
        },
        { "scope": "markup.quote", "settings": { "foreground": "#0f9" } },
        {
            "scope": "markup.italic",
            "settings": { "fontStyle": "italic", "foreground": "#ccc" }
        },
        {
            "scope": "markup.bold",
            "settings": { "fontStyle": "bold", "foreground": "#ccc" }
        },
        {
            "scope": ["markup.underline"],
            "settings": { "fontStyle": "underline" }
        },
        {
            "scope": ["markup.strikethrough"],
            "settings": { "fontStyle": "strikethrough" }
        },
        {
            "scope": "markup.inline.raw",
            "settings": { "foreground": "#61abff" }
        },
        {
            "scope": [
                "markup.deleted",
                "meta.diff.header.from-file",
                "punctuation.definition.deleted"
            ],
            "settings": { "background": "#981b21", "foreground": "#ff9ea9" }
        },
        {
            "scope": [
                "markup.inserted",
                "meta.diff.header.to-file",
                "punctuation.definition.inserted"
            ],
            "settings": { "background": "#00331f", "foreground": "#0f9" }
        },
        {
            "scope": ["markup.changed", "punctuation.definition.changed"],
            "settings": { "background": "#c75000", "foreground": "#ffa05c" }
        },
        {
            "scope": ["markup.ignored", "markup.untracked"],
            "settings": { "foreground": "#282828", "background": "#61abff" }
        },
        {
            "scope": "meta.diff.range",
            "settings": { "foreground": "#a075f0", "fontStyle": "bold" }
        },
        {
            "scope": "meta.diff.header",
            "settings": { "foreground": "#61abff" }
        },
        {
            "scope": "meta.separator",
            "settings": { "fontStyle": "bold", "foreground": "#61abff" }
        },
        { "scope": "meta.output", "settings": { "foreground": "#61abff" } },
        {
            "scope": [
                "brackethighlighter.tag",
                "brackethighlighter.curly",
                "brackethighlighter.round",
                "brackethighlighter.square",
                "brackethighlighter.angle",
                "brackethighlighter.quote"
            ],
            "settings": { "foreground": "#ccc" }
        },
        {
            "scope": "brackethighlighter.unmatched",
            "settings": { "foreground": "#ff9ea9" }
        },
        {
            "scope": ["constant.other.reference.link", "string.other.link"],
            "settings": { "foreground": "#cce6ff", "fontStyle": "underline" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
