{
    "name": "Obsidian MERN PRO",
    "type": "dark",
    "colors": {
        "editor.background": "#050505",
        "editor.foreground": "#FFFFFF",
        "editorCursor.foreground": "#00FFFF",
        "editor.selectionBackground": "#2B0040",
        "editor.lineHighlightBackground": "#0E0E0E",
        "editorLineNumber.foreground": "#3A3A3A",
        "editorLineNumber.activeForeground": "#FFFF00",
        "sideBar.background": "#020202",
        "sideBar.foreground": "#CFCFCF",
        "activityBar.background": "#020202",
        "activityBar.foreground": "#00FFFF",
        "statusBar.background": "#020202",
        "statusBar.foreground": "#FFFFFF"
    },
    "tokenColors": [
        {
            "scope": "comment",
            "settings": { "foreground": "#6B6B6B", "fontStyle": "italic" }
        },
        {
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#B026FF" }
        },
        {
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call",
                "variable.function"
            ],
            "settings": { "foreground": "#00AFFF" }
        },
        { "scope": "variable", "settings": { "foreground": "#FFFF00" } },
        { "scope": "string", "settings": { "foreground": "#00FF3C" } },
        {
            "scope": "constant.numeric",
            "settings": { "foreground": "#FF003C" }
        },
        {
            "scope": [
                "entity.name.tag",
                "entity.name.tag.jsx",
                "support.class.component.jsx"
            ],
            "settings": { "foreground": "#FF2E97" }
        },
        {
            "scope": ["support.type", "entity.name.type", "support.class"],
            "settings": { "foreground": "#FFA500" }
        },
        {
            "scope": [
                "meta.object-literal.key",
                "support.type.property-name.json"
            ],
            "settings": { "foreground": "#00FFD5" }
        },
        {
            "scope": ["punctuation", "meta.brace"],
            "settings": { "foreground": "#7DF9FF" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
