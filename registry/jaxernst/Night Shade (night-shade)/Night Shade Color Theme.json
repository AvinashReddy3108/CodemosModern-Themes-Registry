            "settings": { "foreground": "#A599D0" }
        },
        {
            "scope": ["variable.other", "variable.parameter", "variable"],
            "settings": { "foreground": "#DFE1E7" }
        },
        {
            "scope": [
                "variable.other.constant",
                "variable.other.readonly",
                "entity.other.attribute-name"
            ],
            "settings": { "foreground": "#D0D0D0" }
        },
        {
            "scope": [
                "punctuation.definition.template-expression",
                "keyword.operator",
                "support.type.primitive",
                "support.type.builtin",
                "constant.language"
            ],
            "settings": { "foreground": "#98B6BC" }
        },
        {
            "scope": [
                "keyword.other.special-method",
                "entity.name.tag",
                "storage.type.function.arrow"
            ],
            "settings": { "foreground": "#7DACC1", "fontStyle": "bold" }
        },
        {
            "scope": [
                "storage.type",
                "entity.name.type.module",
                "entity.name.type",
                "keyword.control.module.elixir"
            ],
            "settings": { "foreground": "#88BBFF" }
        },
        {
            "scope": [
                "support.class.component",
                "entity.name.type",
                "entity.name.type.module"
            ],
            "settings": { "foreground": "#78BEA1" }
        },
        {
            "scope": ["punctuation.definition.string.template"],
            "settings": { "foreground": "#88CC44" }
        },
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#7A6D66" }
        },
        {
            "scope": "token.info-token",
            "settings": { "foreground": "#6796E6" }
        },
        {
            "scope": "token.warn-token",
            "settings": { "foreground": "#CD9731" }
        },
        {
            "scope": "token.error-token",
            "settings": { "foreground": "#F44747" }
        },
        {
            "scope": "token.debug-token",
            "settings": { "foreground": "#B267E6" }
        }
