                "variable.other.member",
                "entity.name.class",
                "entity.name.namespace",
                "constant.other",
                "variable",
                "variable.other",
                "variable.other.constant.js",
                "text.find-in-files",
                "source",
                "entity.name.type.module",
                "source.sql support.function",
                "support.other.namespace.php"
