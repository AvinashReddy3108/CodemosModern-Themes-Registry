            ],
            "settings": { "fontStyle": "italic", "foreground": "#F39C12" }
        },
        {
            "name": "Regular Expressions",
            "scope": ["string.regexp"],
            "settings": { "foreground": "#FFCCFF" }
        },
        {
            "name": "Escape Characters",
            "scope": ["constant.character.escape"],
            "settings": { "foreground": "#FFB6C1" }
        },
        {
            "name": "URL",
            "scope": ["*url*", "*link*", "*uri*"],
