{
    "$schema": "vscode://schemas/color-theme",
    "tokenColors": [
        {
            "name": "Cyan",
            "scope": [
                "support.constant",
                "variable.other.constant",
                "entity.other.attribute-name.id",
                "constant.language.boolean",
                "constant.language.json.comments"
            ],
            "settings": { "foreground": "#56B6C2", "fontStyle": "" }
        },
        {
            "name": "Magenta",
            "scope": [
                "support.class.builtin",
                "constant.language.null",
                "keyword.operator.logical",
                "keyword.other.important",
                "keyword.control.at-rule"
            ],
            "settings": { "foreground": "#C678DD", "fontStyle": "" }
        },
        {
            "name": "Magenta Italic",
            "scope": [
                "keyword.control",
                "keyword.operator.new",
                "storage.type.function",
                "storage.type"
            ],
            "settings": { "foreground": "#C678DD", "fontStyle": "italic" }
        },
        {
            "name": "Blue",
            "scope": [
                "support.class.component",
                "support.constant.property-value",
                "entity.name.function",
                "support.function.misc",
                "constant.character.escape",
                "punctuation.definition.template-expression.begin",
                "punctuation.definition.template-expression.end"
            ],
            "settings": { "foreground": "#61AFEF", "fontStyle": "" }
        },
        {
            "name": "Orange",
            "scope": [
                "constant.numeric",
                "keyword.other.unit",
                "constant.other.color.rgb-value",
                "entity.other.attribute-name.class"
            ],
            "settings": { "foreground": "#D19A66", "fontStyle": "" }
        },
        {
            "name": "Yellow",
            "scope": ["entity.other.attribute-name", "variable.language.this"],
            "settings": { "foreground": "#E5C07B", "fontStyle": "" }
        },
        {
            "name": "Yellow Italic",
            "scope": ["variable.other.object"],
            "settings": { "foreground": "#E5C07B", "fontStyle": "italic" }
        },
        {
            "name": "Green",
            "scope": [
                "string.quoted",
                "punctuation.definition.string",
                "string.template",
                "meta.attribute-selector"
            ],
            "settings": { "foreground": "#98C379", "fontStyle": "" }
        },
        {
            "name": "Red",
            "scope": [
                "meta.object-literal.key",
                "variable.other.object.property",
                "constant.language.import-export-all",
                "entity.name.tag",
                "support.type.property-name.json",
                "support.variable.property",
                "meta.definition.variable",
                "variable"
            ],
            "settings": { "foreground": "#e06c75", "fontStyle": "" }
        },
        {
            "name": "White -2",
            "scope": [
                "meta.brace",
                "punctuation.section.function.scss",
                "punctuation.definition.attribute-selector",
                "punctuation.section.embedded",
                "source",
                "support.type.property-name",
                "punctuation.definition.tag",
                "keyword.operator",
                "punctuation.separator"
            ],
            "settings": { "foreground": "#adb1ba", "fontStyle": "" }
        },
        {
            "name": "Black +4 Italic",
            "scope": [
                "comment.block.documentation",
                "punctuation.definition.comment",
                "comment.line",
                "comment.block",
                "meta.path"
            ],
            "settings": { "foreground": "#5a5e66", "fontStyle": "italic" }
        },
        { "scope": "markup.italic", "settings": { "fontStyle": "italic" } },
        { "scope": "heading.2", "settings": { "fontStyle": "bold" } },
        { "scope": "markup.bold", "settings": { "fontStyle": "bold" } },
        {
            "scope": "storage.type.function.arrow",
            "settings": { "fontStyle": "" }
        }
    ],
