    "tokenColors": [
        {
            "name": "Comments - subdued program notes",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#D08B92", "fontStyle": "italic" }
        },
        {
            "name": "Documentation comments",
            "scope": [
                "comment.block.documentation",
                "comment.block.documentation punctuation.definition.comment"
            ],
            "settings": { "foreground": "#FFC8CD", "fontStyle": "italic" }
        },
        {
            "name": "Keywords and control flow",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.expression",
                "storage.modifier",
                "storage.type"
            ],
            "settings": { "foreground": "#FF6A3D" }
        },
        {
            "name": "Module boundaries",
            "scope": [
                "keyword.control.import",
                "keyword.control.export",
                "keyword.control.from",
                "keyword.control.as",
                "keyword.other.important"
            ],
            "settings": { "foreground": "#FFE066" }
        },
        {
            "name": "Operators and punctuation",
            "scope": [
                "keyword.operator",
                "punctuation",
                "punctuation.separator",
                "punctuation.terminator",
                "meta.brace",
                "meta.delimiter"
            ],
            "settings": { "foreground": "#FFC8CD" }
        },
        {
            "name": "Functions and calls",
            "scope": [
                "entity.name.function",
                "support.function",
                "support.function.builtin",
                "meta.function-call",
                "variable.function",
                "meta.method-call",
                "entity.name.function.member",
                "support.function.console",
                "support.function.dom",
                "support.function.node"
            ],
            "settings": { "foreground": "#FF4D6D" }
        },
        {
            "name": "React and framework hooks",
            "scope": [
                "support.function.react",
                "support.function.hook",
                "entity.name.function.react",
                "variable.other.readwrite.alias.js",
                "variable.other.readwrite.alias.ts",
                "meta.import variable.other.readwrite"
            ],
            "settings": { "foreground": "#FF9A62" }
        },
        {
            "name": "Next.js, React Server Components, and directives",
            "scope": [
                "string.quoted.single.js meta.directive",
                "string.quoted.double.js meta.directive",
                "string.quoted.single.ts meta.directive",
                "string.quoted.double.ts meta.directive",
                "meta.directive",
                "keyword.other.directive",
                "support.constant.nextjs",
                "support.constant.astro"
            ],
            "settings": { "foreground": "#FFE066" }
        },
        {
            "name": "React components and constructors",
            "scope": [
                "support.class.component",
                "entity.name.type.class.jsx",
                "entity.name.tag support.class.component",
                "variable.other.object.js",
                "variable.other.object.ts",
                "entity.name.function.constructor",
                "entity.name.tag.jsx support.class.component",
                "entity.name.tag.tsx support.class.component"
            ],
            "settings": { "foreground": "#FF9A62" }
        },
        {
            "name": "Variables and parameters",
            "scope": [
                "variable",
                "variable.other",
                "variable.parameter",
                "support.variable",
                "meta.definition.variable"
            ],
            "settings": { "foreground": "#FFE4E6" }
        },
        {
            "name": "Language constants",
            "scope": [
                "constant.language",
                "constant.character",
                "constant.other",
                "variable.language",
                "support.constant"
            ],
            "settings": { "foreground": "#FF9A62" }
        },
        {
            "name": "Numbers and units",
            "scope": [
                "constant.numeric",
                "constant.numeric.css",
                "keyword.other.unit",
                "support.constant.property-value.css"
            ],
            "settings": { "foreground": "#FFE066" }
        },
        {
            "name": "Strings",
            "scope": [
                "string",
                "punctuation.definition.string",
                "string.quoted",
                "string.template"
            ],
            "settings": { "foreground": "#FFD166" }
        },
        {
            "name": "String escapes and interpolation",
            "scope": [
                "constant.character.escape",
                "punctuation.definition.template-expression",
                "punctuation.section.embedded",
                "source.js.embedded.expression",
                "source.ts.embedded.expression"
            ],
            "settings": { "foreground": "#FFE066" }
        },
        {
            "name": "Regular expressions",
            "scope": [
                "string.regexp",
                "constant.other.character-class.regexp",
                "keyword.operator.quantifier.regexp"
            ],
            "settings": { "foreground": "#FF2D45" }
        },
        {
            "name": "Types, classes, and interfaces",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "entity.name.struct",
                "entity.name.enum",
                "entity.name.type.alias",
                "entity.name.type.module",
                "support.class",
                "support.type",
                "support.type.primitive",
                "storage.type.interface",
                "entity.name.type.interface",
                "entity.name.type.ts",
                "entity.name.type.tsx",
                "support.type.builtin.ts",
                "support.type.builtin.tsx"
            ],
            "settings": { "foreground": "#FFE066" }
        },
        {
            "name": "TypeScript generics and constraints",
            "scope": [
                "entity.name.type.parameter",
                "meta.type.parameters",
                "meta.type.parameters.ts",
                "meta.type.parameters.tsx",
                "punctuation.definition.typeparameters",
                "keyword.operator.type.annotation",
                "keyword.operator.expression.keyof",
                "keyword.operator.expression.infer",
                "keyword.operator.expression.is"
            ],
            "settings": { "foreground": "#FF9A62" }
        },
        {
            "name": "Object properties and JSON keys",
            "scope": [
                "variable.object.property",
                "variable.other.property",
                "support.type.property-name",
                "support.type.property-name.json",
                "meta.object-literal.key",
                "meta.property.object",
                "entity.name.tag.yaml",
                "entity.name.section"
            ],
            "settings": { "foreground": "#FFB0A1" }
        },
        {
            "name": "Decorators and annotations",
            "scope": [
                "meta.decorator",
                "punctuation.decorator",
                "storage.type.annotation",
                "entity.name.function.decorator",
                "meta.function.decorator"
            ],
            "settings": { "foreground": "#FF2D45", "fontStyle": "italic" }
        },
        {
            "name": "JSX, Astro, HTML, and XML tags",
            "scope": [
                "entity.name.tag",
                "entity.name.tag.html",
                "entity.name.tag.jsx",
                "entity.name.tag.tsx",
                "entity.name.tag.astro",
                "punctuation.definition.tag"
            ],
            "settings": { "foreground": "#FF4D6D" }
        },
        {
            "name": "JSX text and embedded expressions",
            "scope": [
                "meta.jsx.children",
                "meta.jsx.children.js",
                "meta.jsx.children.tsx",
                "meta.embedded.expression",
                "punctuation.section.embedded.begin.jsx",
                "punctuation.section.embedded.end.jsx",
                "punctuation.section.embedded.begin.tsx",
                "punctuation.section.embedded.end.tsx"
            ],
            "settings": { "foreground": "#FFC8CD" }
        },
        {
            "name": "JSX, Astro, HTML, and Tailwind attributes",
            "scope": [
                "entity.other.attribute-name",
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.html",
                "entity.other.attribute-name.jsx",
                "entity.other.attribute-name.tsx",
                "entity.other.attribute-name.astro",
                "support.type.property-name.css"
            ],
            "settings": { "foreground": "#FFE066", "fontStyle": "italic" }
        },
        {
            "name": "Tailwind utility class strings",
            "scope": [
                "meta.attribute.class.html string",
                "meta.attribute.class.jsx string",
                "meta.attribute.class.tsx string",
                "meta.attribute.class.astro string",
                "string.quoted.double.html meta.class",
                "string.quoted.single.html meta.class",
                "support.constant.tailwind"
            ],
            "settings": { "foreground": "#FFD166" }
        },
        {
            "name": "CSS selectors",
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css",
                "entity.name.tag.css",
                "entity.other.attribute-name.pseudo-class.css",
                "entity.other.attribute-name.pseudo-element.css"
            ],
            "settings": { "foreground": "#FF4D6D" }
        },
        {
            "name": "CSS properties",
            "scope": [
                "support.type.property-name.css",
                "meta.property-name.css",
                "support.type.vendored.property-name.css"
