{
    "name": "Starbound",
    "semanticHighlighting": true,
    "colors": {
        "focusBorder": "#154bb2ff",
        "sash.hoverBorder": "#154bb2ff",
        "textLink.foreground": "#52d9ff",
        "button.secondaryBackground": "#154bb2ff",
        "button.secondaryForeground": "#ffffffff",
        "button.background": "#ea9300ff",
        "button.foreground": "#000000ff",
        "dropdown.background": "#12101cff",
        "editorWidget.background": "#12101cff",
        "editorGroup.emptyBackground": "#12101cff",
        "input.background": "#000000ff",
        "input.border": "#222222ff",
        "panel.border": "#222222ff",
        "titleBar.inactiveBackground": "#12101cff",
        "titleBar.activeBackground": "#12101cff",
        "list.hoverBackground": "#52d9ff33",
        "list.activeSelectionBackground": "#52d9ff33",
        "list.inactiveSelectionBackground": "#52d9ff33",
        "editor.background": "#000000ff",
        "editor.foreground": "#d8d1cc",
        "editorGroupHeader.tabsBackground": "#12101cff",
        "tab.inactiveBackground": "#12101cff",
        "tab.activeBackground": "#000000ff",
        "tab.border": "#00000000",
        "sideBar.background": "#12101cff",
        "sideBar.foreground": "#d8d1cc",
        "sideBarSectionHeader.background": "#12101cff",
        "sideBarSectionHeader.foreground": "#d8d1cc",
        "sideBarTitle.foreground": "#d8d1cc",
        "activityBar.background": "#12101cff",
        "activityBar.activeBorder": "#d8d1cc",
        "activityBar.foreground": "#d8d1cc",
        "activityBarBadge.background": "#e8e200ff",
        "activityBarBadge.foreground": "#000000ff",
        "statusBar.background": "#154bb2ff",
        "statusBar.noFolderBackground": "#12101cff",
        "statusBar.debuggingBackground": "#e8e200ff",
        "statusBar.debuggingForeground": "#000000ff",
        "statusBarItem.remoteBackground": "#154bb2ff",
        "statusBarItem.remoteForeground": "#ffffffff",
        "statusBarItem.warningBackground": "#ea9300ff",
        "statusBarItem.warningForeground": "#000000ff",
        "statusBarItem.errorBackground": "#ea3900ff"
    },
    "semanticTokenColors": { "*.decorator": { "italic": true } },
    "tokenColors": [
        {
            "name": "Code - Comments",
            "scope": ["comment", "string.quoted.docstring.multi.python"],
            "settings": { "foreground": "#a59f99", "fontStyle": "italic" }
        },
        {
            "name": "Code - Control Keywords",
            "scope": [
                "keyword.other",
                "keyword.control",
                "keyword.operator.new"
            ],
            "settings": { "foreground": "#955cff" }
        },
        {
            "name": "Code - Types N' Stuff Keywords",
            "scope": ["storage.modifier", "storage.type"],
            "settings": { "foreground": "#955cff", "fontStyle": "italic" }
        },
        {
            "name": "Code - Operators",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#99938f" }
        },
        {
            "name": "Code - Functions",
            "scope": ["entity.name.function", "meta.function-call.generic"],
            "settings": { "foreground": "#52d9ff" }
        },
        {
            "name": "Code - Classes",
            "scope": ["entity.name.type"],
            "settings": { "foreground": "#ea9300ff" }
        },
        {
            "name": "Code - Special",
            "scope": ["variable.language", "constant.other.caps"],
            "settings": { "foreground": "#ea3900ff" }
        },
        {
            "name": "Code - Super Special",
            "scope": [
                "punctuation.definition.decorator.python",
                "entity.name.type.lifetime.rust",
                "entity.name.type.numeric"
            ],
            "settings": { "foreground": "#e8e200ff", "fontStyle": "italic" }
        },
        {
            "name": "Code - Numbers",
            "scope": ["constant.numeric", "constant.language"],
            "settings": { "foreground": "#ea9300ff" }
        },
        {
            "name": "Code - Strings",
            "scope": ["string"],
            "settings": { "foreground": "#e8e200ff" }
        },
        {
            "name": "Code - Special Values",
            "scope": [
                "entity.name.type.result.rust",
                "entity.name.type.option.rust"
            ],
            "settings": { "foreground": "#ea3900ff", "fontStyle": "italic" }
        },
        {
            "name": "Markdown - Headers",
            "scope": [
                "markup.heading.setext",
                "punctuation.definition.heading.markdown"
            ],
            "settings": { "foreground": "#955cff" }
        },
        {
            "name": "Markdown - Table",
            "scope": [
                "punctuation.definition.table",
                "punctuation.separator.table"
            ],
            "settings": { "foreground": "#ea9300ff" }
        },
        {
            "name": "Markdown - Link Title",
            "scope": [
                "string.other.link.description",
                "string.other.link.title"
            ],
            "settings": { "foreground": "#e8e200ff" }
        },
        {
            "name": "Markdown - Link Link",
            "scope": [
                "markup.underline.link.markdown",
                "markup.underline.link.image.markdown"
            ],
            "settings": { "foreground": "#52d9ff", "fontStyle": "italic" }
        },
        {
            "name": "Markdown - Link Punctuation",
            "scope": [
                "punctuation.definition.link",
                "punctuation.definition.metadata"
            ],
            "settings": { "foreground": "#955cff" }
        },
        {
            "name": "Markdown - Code",
            "scope": [
                "markup.raw.block.markdown",
                "markup.inline.raw.string.markdown",
                "fenced_code.block.language.markdown"
            ],
            "settings": { "foreground": "#52d9ff" }
        },
        {
            "name": "Markdown - List",
            "scope": ["punctuation.definition.list"],
            "settings": { "foreground": "#52d9ff" }
        },
        {
            "name": "Markdown - Punctuation - Other",
            "scope": [
                "punctuation.definition.raw",
                "markup.fenced_code.block.markdown"
            ],
            "settings": { "foreground": "#ea9300ff" }
        },
        {
            "name": "Markup - Key",
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#52d9ff" }
        },
        {
            "name": "Markup - Property Name",
            "scope": ["support.type.property-name"],
            "settings": { "foreground": "#ea9300ff" }
        },
        {
            "name": "Markup - Attribute",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#ea9300ff" }
        },
        {
            "name": "Style - Entity",
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css"
            ],
            "settings": { "foreground": "#955cff" }
        },
        {
            "name": "Style - Name",
            "scope": [
                "support.type.property-name.css",
                "entity.name.tag.reference.scss"
            ],
            "settings": { "foreground": "#d8d1cc" }
        },
        {
            "name": "Style - Colors",
            "scope": ["constant.other.color", "support.constant.color"],
            "settings": { "foreground": "#ea9300ff" }
        },
        {
            "name": "Style - Operations",
            "scope": [
                "support.function.misc.scss",
                "keyword.control.at-rule.extend.scss",
                "keyword.control.at-rule.import.scss",
                "keyword.control.for.scss"
            ],
            "settings": { "foreground": "#52d9ff" }
        },
        {
            "name": "Style - Constant",
            "scope": ["support.constant.property-value.css"],
            "settings": { "foreground": "#ea3900ff" }
        },
        {
            "name": "Style - Numeric",
            "scope": [
                "keyword.other.unit.percentage.css",
                "keyword.other.unit.pt.css",
                "keyword.other.unit.px.css",
                "keyword.other.unit.em.css",
                "keyword.other.unit.vw.css",
                "keyword.other.unit.vh.css",
                "keyword.other.unit.s.css"
            ],
            "settings": { "foreground": "#ea9300ff" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
