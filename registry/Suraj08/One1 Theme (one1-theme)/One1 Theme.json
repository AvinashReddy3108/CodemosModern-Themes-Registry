{
    "$schema": "vscode://schemas/color-theme",
    "name": "One1 Theme",
    "type": "dark",
    "colors": {
        "editor.background": "#0D0D14",
        "sideBar.background": "#1B1333",
        "statusBar.background": "#24114D",
        "activityBar.background": "#1A0F38",
        "sideBar.border": "#3B2A5B",
        "statusBar.border": "#3B2A5B",
        "titleBar.activeBackground": "#2A1755",
        "titleBar.inactiveBackground": "#221344",
        "editor.selectionBackground": "#4A5E78",
        "editorCursor.foreground": "#00E5FF",
        "editorLineNumber.foreground": "#8A8FA3",
        "editor.foreground": "#E4E8FF",
        "editor.findMatchBackground": "#FFEA00AA",
        "editor.findMatchBorder": "#FFEA00",
        "editor.findMatchHighlightBackground": "#FFEA0055",
        "editorError.foreground": "#FF3B3B",
        "editorWarning.foreground": "#FF9500",
        "editorInfo.foreground": "#33CFFF"
    },
    "tokenColors": [
        {
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#BF5FFF" }
        },
        {
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#FF6F91" }
        },
        {
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call"
            ],
            "settings": { "foreground": "#00FFC6" }
        },
        {
            "scope": [
                "variable",
                "meta.definition.variable.name",
                "support.variable"
            ],
            "settings": { "foreground": "#FFE066" }
        },
        {
            "scope": ["constant.numeric", "constant.language"],
            "settings": { "foreground": "#4DB8FF" }
        },
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#8A8FA3", "fontStyle": "italic" }
        },
        {
            "scope": [
                "constant",
                "variable.other.constant",
                "entity.name.constant"
            ],
            "settings": { "foreground": "#FFB84D" }
        },
        {
            "scope": ["entity.name.tag.html", "entity.name.tag"],
            "settings": { "foreground": "#FF4D4D" }
        },
        {
            "scope": [
                "support.class.html",
                "entity.other.attribute-name.class.html"
            ],
            "settings": { "foreground": "#4DFF91" }
        },
        {
            "scope": [
                "entity.other.attribute-name",
                "entity.other.attribute-name.html"
            ],
            "settings": { "foreground": "#FFD93B" }
        },
        {
            "scope": ["string.quoted.double.html", "string.quoted.single.html"],
            "settings": { "foreground": "#00E5FF" }
        },
        {
            "scope": [
                "punctuation.definition.tag.begin",
                "punctuation.definition.tag.end"
            ],
            "settings": { "foreground": "#FF4D4D" }
        },
        {
            "scope": ["entity.name.tag.css", "support.type.property-name.css"],
            "settings": { "foreground": "#FF6EC7" }
        },
        {
            "scope": [
                "entity.name.tag.wildcard.css",
                "entity.name.function.css"
            ],
            "settings": { "foreground": "#00FFC6" }
        },
        {
            "scope": [
                "entity.other.attribute-name.css",
                "support.constant.property-value.css"
            ],
            "settings": { "foreground": "#FFD93B" }
        },
        {
            "scope": ["constant.numeric.css", "keyword.other.unit.css"],
            "settings": { "foreground": "#4DB8FF" }
        },
        {
            "scope": ["entity.name.class.css", "entity.name.id.css"],
            "settings": { "foreground": "#4DFF91" }
        },
        {
            "scope": [
                "keyword.control.at-rule.css",
                "keyword.control.import.css"
            ],
            "settings": { "foreground": "#FF4D4D" }
        }
    ]
}
