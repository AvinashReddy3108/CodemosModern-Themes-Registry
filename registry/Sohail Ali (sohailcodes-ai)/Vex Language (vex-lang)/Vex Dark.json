{
    "name": "Vex Dark",
    "type": "dark",
    "colors": {
        "editor.background": "#0d0d0d",
        "editor.foreground": "#e0e0e0",
        "editorLineNumber.foreground": "#444444",
        "editorCursor.foreground": "#ff4500",
        "editor.selectionBackground": "#ff450033",
        "editor.lineHighlightBackground": "#1a1a1a",
        "activityBarBadge.background": "#ff4500",
        "sideBarTitle.foreground": "#bbbbbb"
    },
    "tokenColors": [
        {
            "scope": "keyword.control.vex",
            "settings": { "foreground": "#ff4500", "fontStyle": "bold" }
        },
        {
            "scope": "keyword.declaration.vex",
            "settings": { "foreground": "#ff6a00", "fontStyle": "bold" }
        },
        {
            "scope": "keyword.import.vex",
            "settings": { "foreground": "#ff8c42" }
        },
        {
            "scope": "support.function.builtin.vex",
            "settings": { "foreground": "#ff4500", "fontStyle": "bold" }
        },
        {
            "scope": "string.quoted.double.vex",
            "settings": { "foreground": "#98c379" }
        },
        {
            "scope": "string.quoted.single.vex",
            "settings": { "foreground": "#98c379" }
        },
        {
            "scope": "variable.other.interpolated.vex",
            "settings": { "foreground": "#e5c07b", "fontStyle": "bold" }
        },
        {
            "scope": "constant.numeric.vex",
            "settings": { "foreground": "#d19a66" }
        },
        {
            "scope": "constant.language.vex",
            "settings": { "foreground": "#ff6a00", "fontStyle": "bold" }
        },
        {
            "scope": "entity.name.function.vex",
            "settings": { "foreground": "#61afef" }
        },
        {
            "scope": "comment.line.hash.vex",
            "settings": { "foreground": "#444444", "fontStyle": "italic" }
        },
        {
            "scope": "keyword.control.mode.vex",
            "settings": { "foreground": "#ff4500", "fontStyle": "italic bold" }
        },
        {
            "scope": "keyword.operator.vex",
            "settings": { "foreground": "#ff4500" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
