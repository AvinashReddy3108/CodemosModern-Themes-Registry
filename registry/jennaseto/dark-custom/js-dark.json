        "settings.headerForeground": "#FBC3BC",
        "settings.modifiedItemIndicator": "#FBC3BC",
        "settings.numberInputBackground": "#1D1D1D",
        "settings.numberInputForeground": "#F7F7F7",
        "settings.textInputBackground": "#1D1D1D",
        "settings.textInputForeground": "#F7F7F7",
        "sideBar.background": "#1D1D1D",
        "sideBar.border": "#FBC3BC50",
        "sideBar.foreground": "#99C1B9",
        "sideBarSectionHeader.background": "#1D1D1D",
        "sideBarSectionHeader.border": "#1D1D1D60",
        "sideBarSectionHeader.foreground": "#99C1B9",
        "sideBarTitle.foreground": "#F7F7F7",
        "statusBar.background": "#D8E2DC",
        "statusBar.border": "#1D1D1D60",
        "statusBar.debuggingBackground": "#C0B9DD",
        "statusBar.debuggingForeground": "#FFFFFF",
        "statusBar.foreground": "#463F3E",
        "statusBar.noFolderBackground": "#1D1D1D",
        "statusBarItem.hoverBackground": "#FBC3BC20",
        "statusBarItem.remoteBackground": "#FBC3BC",
        "statusBarItem.remoteForeground": "#1D1D1D",
