    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "fontStyle": "italic", "foreground": "#6a726d" }
        },
        {
            "name": "Variables, Parameters",
            "scope": [
                "variable",
                "string constant.other.placeholder",
                "entity.name.variable.parameter",
                "entity.name.variable.local",
                "variable.parameter"
            ],
            "settings": { "foreground": "#f09eb7" }
        },
        {
            "name": "Properties",
            "scope": ["variable.other.object.property"],
            "settings": { "foreground": "#59a8ff" }
        },
        {
            "name": "Colors",
            "scope": ["constant.other.color"],
            "settings": { "foreground": "#fecc1b" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#f09eb7" }
        },
        {
            "name": "Invalid - Deprecated",
            "scope": ["invalid.deprecated"],
            "settings": { "foreground": "#b7bcbe" }
        },
        {
            "name": "Keyword, Storage",
            "scope": ["keyword", "storage.modifier"],
            "settings": { "foreground": "#e79fd7" }
        },
        {
            "name": "Keyword Control",
            "scope": [
                "keyword.control",
                "keyword.control.flow",
                "keyword.control.from",
                "keyword.control.import",
                "keyword.control.as"
            ],
            "settings": { "foreground": "#e79fd7" }
        },
        {
            "name": "Keyword",
            "scope": [
                "keyword.other.using",
                "keyword.other.namespace",
                "keyword.other.class",
                "keyword.other.new",
                "keyword.other.event",
                "keyword.other.this",
                "keyword.other.await",
                "keyword.other.var",
                "keyword.other.package",
                "keyword.other.import",
                "variable.language.this",
                "storage.type.ts"
            ],
            "settings": { "foreground": "#e79fd7" }
        },
        {
            "name": "Types, Primitives",
            "scope": ["keyword.type", "storage.type.primitive"],
            "settings": { "foreground": "#54cfb7" }
        },
        {
            "name": "Function",
            "scope": ["storage.type.function"],
            "settings": { "foreground": "#59a8ff" }
        },
        {
            "name": "Operator, Misc",
            "scope": [
                "constant.other.color",
                "punctuation",
                "punctuation.section.class.end",
                "meta.tag",
                "punctuation.definition.tag",
                "punctuation.separator.inheritance.php",
                "punctuation.definition.tag.html",
                "punctuation.definition.tag.begin.html",
                "punctuation.definition.tag.end.html",
                "keyword.other.template",
                "keyword.other.substitution"
            ],
            "settings": { "foreground": "#b7bcbe" }
        },
        {
            "name": "Embedded",
            "scope": ["punctuation.section.embedded", "variable.interpolation"],
            "settings": { "foreground": "#b7bcbe" }
        },
        {
            "name": "Tag",
            "scope": [
                "entity.name.tag",
                "meta.tag.sgml",
                "markup.deleted.git_gutter"
            ],
            "settings": { "foreground": "#f09eb7" }
        },
        {
            "name": "Function, Special Method",
            "scope": [
                "entity.name.function",
                "meta.function-call",
                "variable.function",
                "support.function",
                "keyword.other.special-method"
            ],
            "settings": { "foreground": "#59a8ff" }
        },
        {
            "name": "Block Level Variables",
            "scope": ["meta.block variable.other"],
            "settings": { "foreground": "#f09eb7" }
        },
        {
            "name": "Other Variable, String Link",
            "scope": ["support.other.variable", "string.other.link"],
            "settings": { "foreground": "#f09eb7" }
        },
        {
            "name": "Number, Constant, Function Argument, Tag Attribute, Embedded",
            "scope": [
                "constant.numeric",
                "constant.language",
                "support.constant",
                "constant.character",
                "constant.escape",
                "keyword.other.unit",
                "keyword.other"
            ],
            "settings": { "foreground": "#d83bd2" }
        },
        {
            "name": "String, Symbols, Inherited Class, Markup Heading",
            "scope": [
                "string",
                "constant.other.symbol",
                "constant.other.key",
                "entity.other.inherited-class",
                "markup.heading",
                "markup.inserted.git_gutter",
                "meta.group.braces.curly constant.other.object.key.js string.unquoted.label.js"
            ],
            "settings": { "fontStyle": "", "foreground": "#fecc1b" }
        },
        {
            "name": "Class, Support",
            "scope": [
                "entity.name",
                "support.type",
                "support.class",
                "support.other.namespace.use.php",
                "meta.use.php",
                "support.other.namespace.php",
                "markup.changed.git_gutter",
                "support.type.sys-types"
            ],
            "settings": { "foreground": "#59a8ff" }
