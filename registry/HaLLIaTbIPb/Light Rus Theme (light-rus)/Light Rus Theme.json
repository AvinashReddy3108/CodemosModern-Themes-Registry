        "problemsInfoIcon.foreground": "#3794ff",
        "editorHoverWidget.background": "#ffffff",
        "editorHoverWidget.foreground": "#000000",
        "editorHoverWidget.border": "#0039a6",
        "editorSuggestWidget.background": "#0039a6",
        "editorSuggestWidget.selectedBackground": "#d52b1e",
        "editorSuggestWidget.selectedForeground": "#ffffff",
        "editorSuggestWidget.highlightForeground": "#ffcc00",
        "editorSuggestWidget.border": "#001f5c",
        "editorSuggestWidget.foreground": "#ffffff",
        "terminal.background": "#001f5c",
        "terminal.foreground": "#ffffff",
        "terminalCursor.foreground": "#d52b1e",
        "terminal.ansiBlack": "#000000",
        "terminal.ansiRed": "#cd3131",
        "terminal.ansiGreen": "#00BC00",
        "terminal.ansiYellow": "#949800",
        "terminal.ansiBlue": "#0451a5",
        "terminal.ansiMagenta": "#bc05bc",
        "terminal.ansiCyan": "#0598bc",
        "terminal.ansiWhite": "#555555",
        "terminal.ansiBrightBlack": "#666666",
        "terminal.ansiBrightRed": "#cd3131",
        "terminal.ansiBrightGreen": "#14CE14",
        "terminal.ansiBrightYellow": "#b5ba00",
        "terminal.ansiBrightBlue": "#0451a5",
        "terminal.ansiBrightMagenta": "#bc05bc",
        "terminal.ansiBrightCyan": "#0598bc",
        "terminal.ansiBrightWhite": "#a5a5a5",
        "editorCursor.foreground": "#d52b1e",
        "editorIndentGuide.background1": "#0039a620",
        "editorBracketMatch.background": "#d52b1e20",
        "editorBracketMatch.border": "#d52b1e"
    },
    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "fontStyle": "italic", "foreground": "#008000" }
        },
        {
            "name": "Strings",
            "scope": [
                "string",
                "punctuation.definition.string",
                "string.quoted.double",
                "string.quoted.single"
            ],
            "settings": { "foreground": "#a31515" }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "storage.type",
                "storage.modifier",
                "keyword.control",
                "keyword.operator"
            ],
            "settings": { "foreground": "#0000ff", "fontStyle": "bold" }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call"
            ],
            "settings": { "foreground": "#795E26" }
        },
        {
            "name": "Variables",
            "scope": [
                "variable",
                "variable.parameter",
                "variable.other.readwrite",
                "variable.other.property"
            ],
            "settings": { "foreground": "#001080" }
        },
        {
            "name": "Classes and Types",
            "scope": [
                "entity.name.class",
                "support.type",
                "entity.name.type",
                "storage.type"
            ],
            "settings": { "foreground": "#267f99", "fontStyle": "bold" }
        },
        {
            "name": "Numbers",
            "scope": ["constant.numeric", "constant.language.numeric"],
            "settings": { "foreground": "#098658" }
        },
        {
            "name": "Operators",
            "scope": ["keyword.operator", "punctuation.accessor"],
            "settings": { "foreground": "#000000" }
        },
        {
            "name": "HTML Main Tags",
            "scope": [
                "entity.name.tag.html",
                "entity.name.tag.structure.any.html",
                "entity.name.tag.block.any.html"
            ],
            "settings": { "foreground": "#800000", "fontStyle": "bold" }
        },
        {
            "name": "HTML Semantic Tags",
            "scope": [
                "entity.name.tag.semantic.html",
                "entity.name.tag.header.html",
                "entity.name.tag.footer.html",
                "entity.name.tag.section.html",
                "entity.name.tag.article.html",
                "entity.name.tag.nav.html",
                "entity.name.tag.aside.html"
            ],
            "settings": { "foreground": "#267f99", "fontStyle": "bold" }
        },
        {
            "name": "HTML Form Tags",
            "scope": [
                "entity.name.tag.form.html",
                "entity.name.tag.input.html",
                "entity.name.tag.button.html",
                "entity.name.tag.select.html",
                "entity.name.tag.textarea.html",
                "entity.name.tag.label.html"
            ],
            "settings": { "foreground": "#d52b1e", "fontStyle": "bold" }
        },
        {
            "name": "HTML Media Tags",
            "scope": [
                "entity.name.tag.img.html",
                "entity.name.tag.video.html",
                "entity.name.tag.audio.html",
                "entity.name.tag.canvas.html",
                "entity.name.tag.svg.html"
            ],
            "settings": { "foreground": "#9457a0", "fontStyle": "bold" }
        },
        {
            "name": "HTML List Tags",
            "scope": [
                "entity.name.tag.ul.html",
                "entity.name.tag.ol.html",
                "entity.name.tag.li.html"
            ],
            "settings": { "foreground": "#098658", "fontStyle": "bold" }
        },
        {
            "name": "HTML Table Tags",
            "scope": [
                "entity.name.tag.table.html",
                "entity.name.tag.tr.html",
                "entity.name.tag.td.html",
                "entity.name.tag.th.html",
                "entity.name.tag.thead.html",
                "entity.name.tag.tbody.html"
            ],
            "settings": { "foreground": "#795E26", "fontStyle": "bold" }
        },
        {
            "name": "HTML Script/Style Tags",
            "scope": [
                "entity.name.tag.script.html",
                "entity.name.tag.style.html",
                "meta.tag.structure.script.html",
                "meta.tag.structure.style.html"
            ],
            "settings": { "foreground": "#0000ff", "fontStyle": "bold" }
        },
        {
            "name": "HTML Link/Meta Tags",
            "scope": [
                "entity.name.tag.link.html",
                "entity.name.tag.meta.html",
                "entity.name.tag.title.html"
            ],
            "settings": { "foreground": "#0451a5", "fontStyle": "bold" }
        },
        {
            "name": "HTML Tag Punctuation",
            "scope": [
                "punctuation.definition.tag.html",
                "punctuation.definition.tag.begin.html",
                "punctuation.definition.tag.end.html"
            ],
            "settings": { "foreground": "#666666" }
        },
        {
            "name": "HTML Attributes - IDs",
            "scope": ["entity.other.attribute-name.id.html"],
            "settings": { "foreground": "#ff0000", "fontStyle": "bold" }
        },
        {
            "name": "HTML Attributes - Classes",
            "scope": ["entity.other.attribute-name.class.html"],
            "settings": { "foreground": "#d52b1e" }
        },
        {
            "name": "HTML Attributes - Standard",
            "scope": [
                "entity.other.attribute-name",
                "meta.attribute.with-value.html",
                "entity.other.attribute-name.html"
            ],
            "settings": { "foreground": "#ff6b00" }
        },
        {
            "name": "HTML Attribute Values",
            "scope": [
                "string.attribute-value.html",
                "meta.attribute-with-value.html string"
            ],
            "settings": { "foreground": "#a31515" }
        },
        {
            "name": "HTML Text Content",
            "scope": [
                "text.html.basic",
                "meta.tag.other.html",
                "meta.tag.block.any.html"
            ],
            "settings": { "foreground": "#000000" }
        },
        {
            "name": "HTML Doctype",
            "scope": [
                "meta.tag.sgml.doctype",
                "meta.tag.sgml.doctype string",
                "meta.tag.sgml.doctype entity.name.tag"
            ],
            "settings": { "foreground": "#808080" }
        },
        {
            "name": "HTML Entities",
            "scope": ["constant.character.entity"],
            "settings": { "foreground": "#0000ff" }
        },
        {
            "name": "CSS Properties - Layout",
            "scope": [
                "support.type.property-name.css",
                "meta.property-name.css"
            ],
            "settings": { "foreground": "#ff0000" }
        },
        {
            "name": "CSS Properties - Colors",
            "scope": ["support.type.property-name.color.css"],
            "settings": { "foreground": "#d52b1e" }
        },
        {
            "name": "CSS Properties - Text",
            "scope": [
                "support.type.property-name.font.css",
                "support.type.property-name.text.css"
            ],
            "settings": { "foreground": "#9457a0" }
        },
        {
            "name": "CSS Values - Colors",
            "scope": ["constant.other.color.css"],
            "settings": { "foreground": "#098658" }
        },
        {
            "name": "CSS Values - Numbers",
            "scope": ["constant.numeric.css"],
            "settings": { "foreground": "#795E26" }
        },
        {
            "name": "CSS Values - Strings",
            "scope": ["string.quoted.css"],
            "settings": { "foreground": "#a31515" }
        },
        {
            "name": "CSS Selectors - IDs",
            "scope": ["entity.other.attribute-name.id.css"],
            "settings": { "foreground": "#ff0000", "fontStyle": "bold" }
        },
        {
            "name": "CSS Selectors - Classes",
            "scope": ["entity.other.attribute-name.class.css"],
            "settings": { "foreground": "#d52b1e" }
        },
        {
            "name": "CSS Selectors - Tags",
            "scope": ["entity.name.tag.css"],
            "settings": { "foreground": "#0000ff", "fontStyle": "bold" }
        },
        {
            "name": "CSS Selectors - Pseudo",
            "scope": [
                "entity.other.attribute-name.pseudo-class.css",
                "entity.other.attribute-name.pseudo-element.css"
            ],
            "settings": { "foreground": "#9457a0" }
        },
        {
            "name": "CSS Punctuation",
            "scope": [
                "punctuation.separator.key-value.css",
                "punctuation.terminator.rule.css",
                "punctuation.section.property-list.css"
            ],
            "settings": { "foreground": "#000000" }
        },
        {
            "name": "JavaScript Objects",
            "scope": ["variable.other.object", "variable.other.property"],
            "settings": { "foreground": "#001080" }
        },
        {
            "name": "JSON Keys",
            "scope": [
                "support.type.property-name.json",
                "meta.structure.dictionary.json string.quoted.double.json"
            ],
            "settings": { "foreground": "#0451a5" }
        },
        {
            "name": "Constants",
            "scope": ["constant.language", "variable.other.constant"],
            "settings": { "foreground": "#0000ff" }
        },
        {
            "name": "Invalid/Illegal",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#ff0000", "fontStyle": "underline" }
        },
        {
            "name": "General Punctuation",
            "scope": ["punctuation", "punctuation.separator"],
            "settings": { "foreground": "#000000" }
        },
        {
            "name": "Markdown Headers",
            "scope": ["markup.heading", "markup.heading.setext"],
            "settings": { "foreground": "#0000ff", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Links",
            "scope": ["markup.underline.link", "string.other.link"],
            "settings": { "foreground": "#0451a5" }
        },
        {
            "name": "Markdown Bold",
            "scope": ["markup.bold"],
            "settings": { "fontStyle": "bold", "foreground": "#000000" }
        },
        {
            "name": "Markdown Italic",
            "scope": ["markup.italic"],
            "settings": { "fontStyle": "italic", "foreground": "#000000" }
        },
        {
            "name": "JavaScript Keywords",
            "scope": ["storage.type.js", "storage.modifier.js"],
            "settings": { "foreground": "#0000ff", "fontStyle": "bold" }
        },
        {
            "name": "JavaScript Built-in Objects",
            "scope": [
                "support.class.builtin.js",
                "support.function.builtin.js"
            ],
            "settings": { "foreground": "#267f99" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
