    "tokenColors": [
        {
            "name": "Comment text",
            "scope": "comment,comment.block.html",
            "settings": { "foreground": "#83aad4ff" }
        },
        {
            "name": "Comment punctuation",
            "scope": "punctuation.definition.comment, punctuation.whitespace.comment",
            "settings": { "foreground": "#697d90ff" }
        },
        {
            "name": "String",
            "scope": "string, string.unquoted",
            "settings": { "foreground": "#97a983ff" }
