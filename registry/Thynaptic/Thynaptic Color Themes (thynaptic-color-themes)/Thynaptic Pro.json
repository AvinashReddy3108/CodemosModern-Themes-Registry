        "notifications.border": "#3F3F46",
        "notificationToast.border": "#3F3F46",
        "gitDecoration.modifiedResourceForeground": "#F59E0B",
        "gitDecoration.deletedResourceForeground": "#EF4444",
        "gitDecoration.untrackedResourceForeground": "#10B981",
        "gitDecoration.ignoredResourceForeground": "#52525B",
        "gitDecoration.conflictingResourceForeground": "#A855F7"
    },
    "tokenColors": [
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#71717A", "fontStyle": "italic" }
        },
        {
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#10B981" }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.language",
                "constant.character"
            ],
            "settings": { "foreground": "#F59E0B" }
        },
        {
            "scope": ["variable", "variable.other", "variable.parameter"],
            "settings": { "foreground": "#FAFAFA" }
        },
        {
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#E4E4E7", "fontStyle": "bold" }
        },
        {
            "scope": [
                "entity.name.function",
                "meta.function-call",
                "support.function"
            ],
            "settings": { "foreground": "#D4D4D8" }
        },
        {
            "scope": [
                "entity.name.class",
                "entity.name.type",
                "support.class",
                "support.type"
            ],
            "settings": { "foreground": "#E4E4E7" }
        },
        {
            "scope": ["entity.name.tag", "markup.heading"],
            "settings": { "foreground": "#FAFAFA", "fontStyle": "bold" }
        },
        {
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#A1A1AA" }
        },
        {
            "scope": ["punctuation", "meta.brace", "meta.bracket"],
            "settings": { "foreground": "#A1A1AA" }
        },
        {
            "scope": ["markup.bold"],
            "settings": { "foreground": "#FAFAFA", "fontStyle": "bold" }
        },
        {
            "scope": ["markup.italic"],
            "settings": { "foreground": "#D4D4D8", "fontStyle": "italic" }
        },
        {
            "scope": ["markup.underline"],
            "settings": { "fontStyle": "underline" }
        },
        {
            "scope": ["markup.inline.raw", "markup.fenced_code"],
            "settings": { "foreground": "#10B981" }
        },
        {
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#EF4444" }
        }
    ],
    "semanticHighlighting": true,
    "$schema": "vscode://schemas/color-theme"
}
