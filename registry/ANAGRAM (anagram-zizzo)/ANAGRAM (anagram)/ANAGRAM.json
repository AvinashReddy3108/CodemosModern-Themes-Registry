        "list.activeSelectionIconForeground": "#ffffff",
        "dropdown.background": "#181818",
        "dropdown.border": "#00000000",
        "dropdown.foreground": "#ffffff",
        "input.background": "#1c1c1c",
        "input.border": "#212121",
