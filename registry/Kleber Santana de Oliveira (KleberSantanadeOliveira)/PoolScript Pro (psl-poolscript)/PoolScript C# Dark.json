{"$comment":["Tema da extensão: a paleta do C# no Visual Studio Code (Dark+ mais as","cores semânticas que a extensão de C# emite). Foi pedido assim.","","As sete cores que definem o visual, e o que cada uma significa lá:","  #569CD6  palavra da linguagem e tipo primitivo   (class, int, private)","  #C586C0  controle de fluxo                       (if, return, foreach)","  #4EC9B0  nome de TIPO                            (a classe, o pai)","  #DCDCAA  nome de MÉTODO e chamada","  #9CDCFE  parâmetro, variável local, campo","  #CE9178  string          #B5CEA8  número        #6A9955  comentário","","A gramática foi ajustada junto pra emitir os escopos que essas cores","esperam (entity.name.type.class, variable.parameter, ...) — sem isso o","tema pintaria cores certas em lugares errados."],"name":"PoolScript C# Dark","type":"dark","colors":{"editor.background":"#1E1E1E","editor.foreground":"#D4D4D4","editorLineNumber.foreground":"#858585","editorLineNumber.activeForeground":"#C6C6C6","editor.selectionBackground":"#264F78","editor.selectionHighlightBackground":"#ADD6FF26","editor.lineHighlightBackground":"#282828","editor.wordHighlightBackground":"#575757B8","editorCursor.foreground":"#AEAFAD","editorIndentGuide.background1":"#404040","editorIndentGuide.activeBackground1":"#707070","editorBracketMatch.background":"#0064001A","editorBracketMatch.border":"#888888","editorBracketHighlight.foreground1":"#FFD700","editorBracketHighlight.foreground2":"#DA70D6","editorBracketHighlight.foreground3":"#179FFF","editorError.foreground":"#F14C4C","editorWarning.foreground":"#CCA700","sideBar.background":"#252526","activityBar.background":"#333333","statusBar.background":"#007ACC","titleBar.activeBackground":"#3C3C3C","tab.activeBackground":"#1E1E1E","tab.inactiveBackground":"#2D2D2D","tab.activeBorderTop":"#007ACC"},"tokenColors":[{"name":"comentário","scope":["comment","comment.line","comment.block","punctuation.definition.comment"],"settings":{"foreground":"#6A9955","fontStyle":""}},{"name":"controle de fluxo — o roxo do C#","scope":["keyword.control","keyword.control.poolscript","keyword.control.verb.poolscript"],"settings":{"foreground":"#C586C0"}},{"name":"palavra da linguagem, tipo primitivo, modificador","scope":["storage","storage.type","storage.type.poolscript","storage.type.class.poolscript","storage.type.function.poolscript","storage.modifier","storage.modifier.poolscript","keyword.other","support.type"],"settings":{"foreground":"#569CD6"}},{"name":"operador lógico — palavra, então azul, como o `is`/`as` do C#","scope":["keyword.operator.logical","keyword.operator.word"],"settings":{"foreground":"#569CD6"}},{"name":"operador de símbolo","scope":["keyword.operator","punctuation","meta.brace"],"settings":{"foreground":"#D4D4D4"}},{"name":"nome de TIPO — o teal do C#","scope":["entity.name.type","entity.name.type.class","entity.name.type.class.poolscript","entity.name.type.poolscript","entity.other.inherited-class","entity.other.inherited-class.poolscript","support.class"],"settings":{"foreground":"#4EC9B0"}},{"name":"nome de método e chamada — o amarelo do C#","scope":["entity.name.function","entity.name.function.poolscript","entity.name.function.call.poolscript","support.function","support.function.builtin.poolscript","meta.function-call"],"settings":{"foreground":"#DCDCAA"}},{"name":"atributo/decorador","scope":["entity.name.function.decorator.poolscript","punctuation.decorator.poolscript","meta.decorator.poolscript"],"settings":{"foreground":"#DCDCAA"}},{"name":"parâmetro, variável local e campo — o azul claro do C#","scope":["variable","variable.parameter","variable.parameter.poolscript","variable.other","variable.other.property.poolscript","meta.embedded.poolscript"],"settings":{"foreground":"#9CDCFE"}},{"name":"`self` é o `this`: palavra da linguagem, não variável","scope":["variable.language","variable.language.self.poolscript"],"settings":{"foreground":"#569CD6"}},{"name":"string","scope":["string","string.quoted.double.poolscript","string.quoted.single.poolscript","string.quoted.triple.poolscript"],"settings":{"foreground":"#CE9178"}},{"name":"escape dentro da string","scope":["constant.character.escape","constant.character.escape.poolscript"],"settings":{"foreground":"#D7BA7D"}},{"name":"interpolação: as chaves saem da cor da string","scope":["punctuation.definition.template-expression.begin.poolscript","punctuation.definition.template-expression.end.poolscript"],"settings":{"foreground":"#569CD6"}},{"name":"número","scope":["constant.numeric","constant.numeric.poolscript"],"settings":{"foreground":"#B5CEA8"}},{"name":"true / false / null","scope":["constant.language","constant.language.boolean.poolscript","constant.language.null.poolscript"],"settings":{"foreground":"#569CD6"}},{"name":"inválido","scope":["invalid","invalid.illegal"],"settings":{"foreground":"#F44747"}}],"semanticHighlighting":true,"semanticTokenColors":{"class":"#4EC9B0","type":"#4EC9B0","method":"#DCDCAA","function":"#DCDCAA","parameter":"#9CDCFE","variable":"#9CDCFE","property":"#9CDCFE","namespace":"#4EC9B0","keyword":"#569CD6","string":"#CE9178","number":"#B5CEA8","comment":"#6A9955"},"$schema":"vscode://schemas/color-theme"}