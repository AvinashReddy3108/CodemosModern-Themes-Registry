{
    "$schema": "vscode://schemas/color-theme",
    "name": "Neon Sentinel Deep",
    "include": "./neon-sentinel-color-theme.json",
    "type": "dark",
    "semanticHighlighting": true,
    "colors": {
        "foreground": "#bdf5ff",
        "descriptionForeground": "#5f9ead",
        "focusBorder": "#ff3f1f",
        "icon.foreground": "#20d8ff",
        "activityBar.background": "#020911",
        "activityBar.foreground": "#31e8ff",
        "activityBar.inactiveForeground": "#315d6c",
        "activityBar.border": "#06202d",
        "activityBarBadge.background": "#ff351c",
        "sideBar.background": "#030c14",
        "sideBar.foreground": "#aeeef8",
        "sideBar.border": "#082635",
        "sideBarTitle.foreground": "#31e8ff",
        "sideBarSectionHeader.background": "#061825",
        "sideBarSectionHeader.foreground": "#59edff",
        "list.activeSelectionBackground": "#0b3547",
        "list.inactiveSelectionBackground": "#092638",
        "list.hoverBackground": "#0a2231",
        "list.highlightForeground": "#ff4a26",
        "editor.background": "#02070d",
        "editor.foreground": "#bdf5ff",
        "editorLineNumber.foreground": "#173e4d",
        "editorLineNumber.activeForeground": "#35e7ff",
        "editorCursor.foreground": "#ff3f1f",
        "editor.selectionBackground": "#0b839c44",
        "editor.selectionHighlightBackground": "#ff3f1f22",
        "editor.wordHighlightBackground": "#00d8ff1f",
        "editor.wordHighlightStrongBackground": "#ff351c36",
        "editor.findMatchBackground": "#ff3f1f70",
        "editor.findMatchHighlightBackground": "#00d8ff36",
        "editor.lineHighlightBackground": "#061621",
        "editor.lineHighlightBorder": "#00d8ff10",
        "editorIndentGuide.background1": "#0c2837",
        "editorIndentGuide.activeBackground1": "#20d8ff",
        "editorWhitespace.foreground": "#143846",
        "editorGutter.background": "#02070d",
        "editorOverviewRuler.border": "#02070d",
        "editorGroupHeader.tabsBackground": "#020911",
        "tab.activeBackground": "#030c14",
        "tab.inactiveBackground": "#020911",
        "tab.activeBorderTop": "#ff3f1f",
        "statusBar.background": "#030c14",
        "panel.background": "#020911",
        "titleBar.activeBackground": "#020911",
        "terminal.background": "#02070d",
        "terminal.foreground": "#bdf5ff",
        "button.background": "#078fb0",
        "button.hoverBackground": "#16cbed",
        "badge.background": "#ff351c",
        "progressBar.background": "#ff3f1f"
    },
    "tokenColors": [
        {
            "name": "Deep Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#476f7a", "fontStyle": "italic" }
        },
        {
            "name": "Deep Strings",
            "scope": ["string", "constant.other.symbol"],
            "settings": { "foreground": "#72ffc8" }
        },
        {
            "name": "Deep Keywords",
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#ff3f1f", "fontStyle": "bold" }
        },
        {
            "name": "Deep Functions",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call",
                "variable.function"
            ],
            "settings": { "foreground": "#20d8ff" }
        },
        {
            "name": "Deep Types",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.type",
                "support.class",
                "storage.type.cs"
            ],
            "settings": { "foreground": "#39aaff" }
        }
    ],
    "semanticTokenColors": {
        "comment": { "foreground": "#476f7a", "italic": true },
        "string": "#72ffc8",
        "keyword": "#ff3f1f",
        "modifier": "#ff4a26",
        "function": "#20d8ff",
        "method": "#20d8ff",
        "type": "#39aaff",
        "class": "#39aaff",
        "property": "#59edff"
    }
}
