        "badge.background": "#FA725A",
        "badge.foreground": "#ffffff",
        "progressBar.background": "#59A0E2",
        "notifications.background": "#F7F5F1",
        "notifications.foreground": "#1a1a1a",
        "notifications.border": "#E6E3DD",
        "notificationsErrorIcon.foreground": "#E25F59",
        "notificationsWarningIcon.foreground": "#B38600",
        "notificationsInfoIcon.foreground": "#59A0E2",
        "quickInput.background": "#F7F5F1",
        "quickInput.foreground": "#1a1a1a",
        "quickInputList.focusBackground": "#E6E3DD",
        "quickInputTitle.background": "#F7F5F1",
        "focusBorder": "#59A0E266",
        "selection.background": "#59A0E244"
    },
    "tokenColors": [
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#b0ada6", "fontStyle": "italic" }
        },
        {
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.new",
                "keyword.operator.expression",
                "keyword.operator.logical",
                "storage.type",
                "storage.modifier"
            ],
            "settings": { "foreground": "#3b6ecc" }
        },
        {
            "scope": [
                "keyword.control.flow",
                "keyword.control.return",
                "keyword.control.import",
                "keyword.control.export",
                "keyword.control.from",
                "keyword.control.conditional",
                "keyword.control.loop"
            ],
            "settings": { "foreground": "#3b6ecc" }
        },
        {
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#5a7a30" }
        },
        {
            "scope": [
                "punctuation.definition.template-expression",
                "string.template punctuation.definition.template-expression"
            ],
            "settings": { "foreground": "#c85a3a" }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.numeric.decimal",
                "constant.numeric.integer",
                "constant.numeric.float",
                "constant.numeric.hex"
            ],
            "settings": { "foreground": "#c85a3a" }
        },
        {
            "scope": [
                "constant.language",
                "constant.language.boolean",
                "constant.language.null",
                "constant.language.undefined"
            ],
            "settings": { "foreground": "#c85a3a" }
        },
        {
            "scope": [
                "entity.name.function",
                "meta.function-call",
                "support.function"
            ],
            "settings": { "foreground": "#7c3aed" }
        },
        {
            "scope": ["variable.parameter", "meta.parameters"],
            "settings": { "foreground": "#1a1a1a", "fontStyle": "italic" }
        },
        {
            "scope": ["variable", "variable.other", "variable.other.readwrite"],
            "settings": { "foreground": "#1a1a1a" }
        },
        {
            "scope": [
                "variable.other.property",
                "variable.other.object.property",
                "meta.object-literal.key"
            ],
            "settings": { "foreground": "#4a4a4a" }
        },
        {
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.type",
                "support.class",
                "entity.other.inherited-class"
            ],
            "settings": { "foreground": "#8f6d00" }
        },
        {
            "scope": ["meta.type.annotation", "entity.name.type.alias"],
            "settings": { "foreground": "#8f6d00" }
        },
        {
            "scope": ["entity.name.type.interface"],
            "settings": { "foreground": "#8f6d00" }
        },
        {
            "scope": ["entity.name.type.enum"],
            "settings": { "foreground": "#8f6d00" }
        },
        {
            "scope": [
                "keyword.operator",
                "keyword.operator.assignment",
                "keyword.operator.comparison",
                "keyword.operator.arithmetic"
            ],
            "settings": { "foreground": "#736356" }
        },
        {
            "scope": [
                "punctuation",
                "punctuation.definition.block",
                "punctuation.definition.parameters",
                "meta.brace"
            ],
            "settings": { "foreground": "#8a8580" }
        },
        {
            "scope": ["entity.name.tag", "support.class.component"],
            "settings": { "foreground": "#c74040" }
        },
        {
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#8f6d00", "fontStyle": "italic" }
        },
        {
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css"
            ],
            "settings": { "foreground": "#8f6d00" }
        },
        {
            "scope": ["support.type.property-name.css"],
            "settings": { "foreground": "#3b6ecc" }
        },
        {
            "scope": [
                "support.constant.property-value.css",
                "constant.other.color.rgb-value.hex.css",
                "constant.numeric.css"
            ],
            "settings": { "foreground": "#c85a3a" }
        },
        {
            "scope": ["entity.name.tag.css"],
            "settings": { "foreground": "#c74040" }
        },
        {
            "scope": ["support.function.css", "support.constant.media.css"],
            "settings": { "foreground": "#7c3aed" }
        },
        {
            "scope": ["string.regexp", "constant.other.character-class.regexp"],
            "settings": { "foreground": "#2d8e9e" }
        },
        {
            "scope": ["markup.heading", "entity.name.section.markdown"],
            "settings": { "foreground": "#3b6ecc", "fontStyle": "bold" }
        },
        {
            "scope": ["markup.bold"],
            "settings": { "foreground": "#1a1a1a", "fontStyle": "bold" }
        },
        {
            "scope": ["markup.italic"],
            "settings": { "foreground": "#1a1a1a", "fontStyle": "italic" }
        },
        {
            "scope": ["markup.inline.raw", "markup.fenced_code.block"],
            "settings": { "foreground": "#5a7a30" }
        },
        {
            "scope": ["markup.underline.link"],
            "settings": { "foreground": "#7c3aed" }
        },
        {
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#3b6ecc" }
        },
        {
            "scope": ["string.quoted.double.json"],
            "settings": { "foreground": "#5a7a30" }
        },
        {
            "scope": ["entity.name.tag.yaml"],
            "settings": { "foreground": "#3b6ecc" }
        },
        {
            "scope": ["meta.decorator", "meta.decorator punctuation.decorator"],
            "settings": { "foreground": "#8f6d00" }
        },
        {
            "scope": [
                "variable.other.readwrite.alias",
                "meta.import variable.other.readwrite"
            ],
            "settings": { "foreground": "#1a1a1a" }
        },
        {
            "scope": ["string.quoted.module"],
            "settings": { "foreground": "#5a7a30" }
        },
        {
            "scope": [
                "variable.language.this",
                "variable.language.self",
                "variable.language.super"
            ],
            "settings": { "foreground": "#c74040", "fontStyle": "italic" }
        },
        {
            "scope": ["variable.other.constant", "variable.other.enummember"],
            "settings": { "foreground": "#c85a3a" }
        },
        {
            "scope": ["support.constant", "support.variable"],
            "settings": { "foreground": "#2d8e9e" }
        },
        {
            "scope": ["constant.character.escape"],
            "settings": { "foreground": "#2d8e9e" }
        }
    ],
    "semanticTokenColors": {
        "function": "#7c3aed",
        "function.declaration": "#7c3aed",
        "method": "#7c3aed",
        "method.declaration": "#7c3aed",
        "variable": "#1a1a1a",
        "variable.readonly": "#c85a3a",
        "property": "#4a4a4a",
        "property.declaration": "#4a4a4a",
        "parameter": { "foreground": "#1a1a1a", "italic": true },
        "type": "#8f6d00",
        "interface": "#8f6d00",
        "enum": "#8f6d00",
        "enumMember": "#c85a3a",
        "namespace": "#8f6d00",
        "class": "#8f6d00",
        "class.declaration": "#8f6d00"
    },
    "$schema": "vscode://schemas/color-theme"
}
