        "breadcrumbPicker.background": "#1e1e1e",
        "scrollbar.shadow": "#00000044",
        "scrollbarSlider.background": "#ffffff15",
        "scrollbarSlider.hoverBackground": "#ffffff25",
        "scrollbarSlider.activeBackground": "#ffffff35",
        "badge.background": "#FA725A",
        "badge.foreground": "#ffffff",
        "progressBar.background": "#5c7cff",
        "notifications.background": "#1e1e1e",
        "notifications.foreground": "#e0e0e0",
        "notifications.border": "#333333",
        "notificationsErrorIcon.foreground": "#f87171",
        "notificationsWarningIcon.foreground": "#D4A52E",
        "notificationsInfoIcon.foreground": "#5c7cff",
        "quickInput.background": "#1e1e1e",
        "quickInput.foreground": "#e0e0e0",
        "quickInputList.focusBackground": "#2a2a2a",
        "quickInputTitle.background": "#1e1e1e",
        "focusBorder": "#5c7cff66",
        "selection.background": "#5c7cff44"
    },
    "tokenColors": [
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#555555", "fontStyle": "italic" }
        },
        {
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.new",
                "keyword.operator.expression",
                "keyword.operator.logical",
                "storage.type",
                "storage.modifier"
            ],
            "settings": { "foreground": "#5c7cff" }
        },
        {
            "scope": [
                "keyword.control.flow",
                "keyword.control.return",
                "keyword.control.import",
                "keyword.control.export",
                "keyword.control.from",
                "keyword.control.conditional",
                "keyword.control.loop"
            ],
            "settings": { "foreground": "#5c7cff" }
        },
        {
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#4bd395" }
        },
        {
            "scope": [
                "punctuation.definition.template-expression",
                "string.template punctuation.definition.template-expression"
            ],
            "settings": { "foreground": "#ff8a70" }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.numeric.decimal",
                "constant.numeric.integer",
                "constant.numeric.float",
                "constant.numeric.hex"
            ],
            "settings": { "foreground": "#ff8a70" }
        },
        {
            "scope": [
                "constant.language",
                "constant.language.boolean",
                "constant.language.null",
                "constant.language.undefined"
            ],
            "settings": { "foreground": "#ff8a70" }
        },
        {
            "scope": [
                "entity.name.function",
                "meta.function-call",
                "support.function"
            ],
            "settings": { "foreground": "#a78bfa" }
        },
        {
            "scope": ["variable.parameter", "meta.parameters"],
            "settings": { "foreground": "#e0e0e0", "fontStyle": "italic" }
        },
        {
            "scope": ["variable", "variable.other", "variable.other.readwrite"],
            "settings": { "foreground": "#e0e0e0" }
        },
        {
            "scope": [
                "variable.other.property",
                "variable.other.object.property",
                "meta.object-literal.key"
            ],
            "settings": { "foreground": "#cccccc" }
        },
        {
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.type",
                "support.class",
                "entity.other.inherited-class"
            ],
            "settings": { "foreground": "#D4A52E" }
        },
        {
            "scope": ["meta.type.annotation", "entity.name.type.alias"],
            "settings": { "foreground": "#D4A52E" }
        },
        {
            "scope": ["entity.name.type.interface"],
            "settings": { "foreground": "#D4A52E" }
        },
        {
            "scope": ["entity.name.type.enum"],
            "settings": { "foreground": "#D4A52E" }
        },
        {
            "scope": [
                "keyword.operator",
                "keyword.operator.assignment",
                "keyword.operator.comparison",
                "keyword.operator.arithmetic"
            ],
            "settings": { "foreground": "#94a3ad" }
        },
        {
            "scope": [
                "punctuation",
                "punctuation.definition.block",
                "punctuation.definition.parameters",
                "meta.brace"
            ],
            "settings": { "foreground": "#808080" }
        },
        {
            "scope": ["entity.name.tag", "support.class.component"],
            "settings": { "foreground": "#f87171" }
        },
        {
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#D4A52E", "fontStyle": "italic" }
        },
        {
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css"
            ],
            "settings": { "foreground": "#D4A52E" }
        },
        {
            "scope": ["support.type.property-name.css"],
            "settings": { "foreground": "#5c7cff" }
        },
        {
            "scope": [
                "support.constant.property-value.css",
                "constant.other.color.rgb-value.hex.css",
                "constant.numeric.css"
            ],
            "settings": { "foreground": "#ff8a70" }
        },
        {
            "scope": ["entity.name.tag.css"],
            "settings": { "foreground": "#f87171" }
        },
        {
            "scope": ["support.function.css", "support.constant.media.css"],
            "settings": { "foreground": "#a78bfa" }
        },
        {
            "scope": ["string.regexp", "constant.other.character-class.regexp"],
            "settings": { "foreground": "#67d4e2" }
        },
        {
            "scope": ["markup.heading", "entity.name.section.markdown"],
            "settings": { "foreground": "#5c7cff", "fontStyle": "bold" }
        },
        {
            "scope": ["markup.bold"],
            "settings": { "foreground": "#e0e0e0", "fontStyle": "bold" }
        },
        {
            "scope": ["markup.italic"],
            "settings": { "foreground": "#e0e0e0", "fontStyle": "italic" }
        },
        {
            "scope": ["markup.inline.raw", "markup.fenced_code.block"],
            "settings": { "foreground": "#4bd395" }
        },
        {
            "scope": ["markup.underline.link"],
            "settings": { "foreground": "#a78bfa" }
        },
        {
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#5c7cff" }
        },
        {
            "scope": ["string.quoted.double.json"],
            "settings": { "foreground": "#4bd395" }
        },
        {
            "scope": ["entity.name.tag.yaml"],
            "settings": { "foreground": "#5c7cff" }
        },
        {
            "scope": ["meta.decorator", "meta.decorator punctuation.decorator"],
            "settings": { "foreground": "#D4A52E" }
        },
        {
            "scope": [
                "variable.other.readwrite.alias",
                "meta.import variable.other.readwrite"
            ],
            "settings": { "foreground": "#e0e0e0" }
        },
        {
            "scope": ["string.quoted.module"],
            "settings": { "foreground": "#4bd395" }
        },
        {
            "scope": [
                "variable.language.this",
                "variable.language.self",
                "variable.language.super"
            ],
            "settings": { "foreground": "#f87171", "fontStyle": "italic" }
        },
        {
            "scope": ["variable.other.constant", "variable.other.enummember"],
            "settings": { "foreground": "#ff8a70" }
        },
        {
            "scope": ["support.constant", "support.variable"],
            "settings": { "foreground": "#67d4e2" }
        },
        {
            "scope": ["constant.character.escape"],
            "settings": { "foreground": "#67d4e2" }
        }
    ],
    "semanticTokenColors": {
        "function": "#a78bfa",
        "function.declaration": "#a78bfa",
        "method": "#a78bfa",
        "method.declaration": "#a78bfa",
        "variable": "#e0e0e0",
        "variable.readonly": "#ff8a70",
        "property": "#cccccc",
        "property.declaration": "#cccccc",
        "parameter": { "foreground": "#e0e0e0", "italic": true },
        "type": "#D4A52E",
        "interface": "#D4A52E",
        "enum": "#D4A52E",
        "enumMember": "#ff8a70",
        "namespace": "#D4A52E",
        "class": "#D4A52E",
        "class.declaration": "#D4A52E"
    },
    "$schema": "vscode://schemas/color-theme"
}
