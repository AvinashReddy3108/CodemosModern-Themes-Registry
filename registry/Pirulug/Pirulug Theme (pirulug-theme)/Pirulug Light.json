    "tokenColors": [
        { "settings": { "background": "#f6f7f9", "foreground": "#1f2328" } },
        {
            "scope": ["meta.embedded", "source.groovy.embedded"],
            "settings": { "background": "#f6f7f9", "foreground": "#1f2328" }
        },
        {
            "name": "Comment",
            "scope": "comment",
            "settings": { "foreground": "#6b7280", "fontStyle": "italic" }
        },
        {
            "name": "String",
            "scope": "string",
            "settings": { "foreground": "#166534" }
        },
        {
            "name": "Template Definition",
            "scope": [
                "punctuation.definition.template-expression",
                "punctuation.section.embedded"
            ],
            "settings": { "foreground": "#ff0055" }
        },
        {
            "name": "Reset JavaScript string interpolation expression",
            "scope": ["meta.template.expression"],
            "settings": { "foreground": "#1f2328" }
        },
        {
            "name": "Number",
            "scope": "constant.numeric",
            "settings": { "foreground": "#5b2b82" }
        },
        {
            "name": "Built-in constant",
            "scope": "constant.language",
            "settings": { "foreground": "#5b2b82" }
        },
        {
            "name": "User-defined constant",
            "scope": "constant.character, constant.other",
            "settings": { "foreground": "#5b2b82" }
        },
        {
            "name": "Variable",
            "scope": "variable",
            "settings": { "fontStyle": "", "foreground": "#1f2328" }
        },
        {
            "name": "Keyword",
            "scope": "keyword",
            "settings": { "foreground": "#ff0055", "fontStyle": "italic" }
        },
        {
            "name": "Storage",
            "scope": "storage",
            "settings": { "fontStyle": "", "foreground": "#ff0055" }
        },
        {
            "name": "Storage type",
            "scope": "storage.type",
            "settings": { "fontStyle": "italic", "foreground": "#0891b2" }
        },
        {
            "name": "Class name",
            "scope": "entity.name.type, entity.name.class",
            "settings": { "fontStyle": "underline", "foreground": "#1d4ed8" }
        },
        {
            "name": "Inherited class",
            "scope": "entity.other.inherited-class",
            "settings": {
                "fontStyle": "italic underline",
                "foreground": "#1d4ed8"
            }
        },
        {
            "name": "Function name",
            "scope": "entity.name.function",
            "settings": { "fontStyle": "", "foreground": "#166534" }
        },
        {
            "name": "Function argument",
            "scope": "variable.parameter",
            "settings": { "fontStyle": "italic", "foreground": "#c2410c" }
        },
        {
            "name": "Tag name",
            "scope": "entity.name.tag",
            "settings": { "fontStyle": "", "foreground": "#ff0055" }
        },
        {
            "name": "Tag attribute",
            "scope": "entity.other.attribute-name",
            "settings": { "fontStyle": "", "foreground": "#0891b2" }
        },
        {
            "name": "Library function",
            "scope": "support.function",
            "settings": { "fontStyle": "", "foreground": "#1d4ed8" }
        },
        {
            "name": "Library constant",
            "scope": "support.constant",
            "settings": { "fontStyle": "", "foreground": "#1d4ed8" }
        },
        {
            "name": "Library class/type",
            "scope": "support.type, support.class",
            "settings": { "fontStyle": "italic", "foreground": "#1d4ed8" }
        },
        {
            "name": "Library variable",
            "scope": "support.other.variable",
            "settings": { "fontStyle": "" }
        },
        {
            "name": "Invalid",
            "scope": "invalid",
            "settings": {
                "background": "#ff0055",
                "fontStyle": "",
                "foreground": "#ffffff"
            }
        },
        {
            "name": "Invalid deprecated",
            "scope": "invalid.deprecated",
            "settings": { "background": "#5b2b82", "foreground": "#ffffff" }
        },
        {
            "name": "JSON String",
            "scope": "meta.structure.dictionary.json string.quoted.double.json",
            "settings": { "foreground": "#166534" }
        },
        {
            "name": "diff.header",
            "scope": "meta.diff, meta.diff.header",
            "settings": { "foreground": "#6b7280" }
        },
        {
            "name": "diff.deleted",
            "scope": "markup.deleted",
            "settings": { "foreground": "#d92d20" }
        },
        {
            "name": "diff.inserted",
            "scope": "markup.inserted",
            "settings": { "foreground": "#166534" }
        },
        {
            "name": "diff.changed",
            "scope": "markup.changed",
            "settings": { "foreground": "#8a6a00" }
        },
        {
            "scope": "constant.numeric.line-number.find-in-files - match",
            "settings": { "foreground": "#5b2b82" }
        },
        {
            "scope": "entity.name.filename.find-in-files",
            "settings": { "foreground": "#1d4ed8" }
        },
        {
            "name": "Markup Quote",
            "scope": "markup.quote",
            "settings": { "foreground": "#ff0055" }
        },
        {
            "name": "Markup Lists",
            "scope": "markup.list",
            "settings": { "foreground": "#8a6a00" }
        },
        {
            "name": "Markup Styling",
            "scope": "markup.bold, markup.italic",
            "settings": { "foreground": "#0891b2" }
        },
        {
            "name": "Markup Inline",
            "scope": "markup.inline.raw",
            "settings": { "fontStyle": "", "foreground": "#c2410c" }
        },
        {
            "name": "Markup Headings",
            "scope": "markup.heading",
            "settings": { "foreground": "#1d4ed8" }
        },
        {
            "name": "Markup Setext Header",
            "scope": "markup.heading.setext",
            "settings": { "fontStyle": "", "foreground": "#1d4ed8" }
        },
        {
            "scope": "token.info-token",
            "settings": { "foreground": "#1d4ed8" }
        },
        {
            "scope": "token.warn-token",
            "settings": { "foreground": "#c2410c" }
        },
        {
            "scope": "token.error-token",
            "settings": { "foreground": "#d92d20" }
        },
        {
            "scope": "token.debug-token",
            "settings": { "foreground": "#c2410c" }
        },
        {
            "name": "this.self",
            "scope": "variable.language",
            "settings": { "foreground": "#ff0055" }
        },
        {
            "scope": [
                "entity.name.type.class.php",
                "entity.other.inherited-class.php"
            ],
            "settings": { "fontStyle": "italic bold", "foreground": "#1d4ed8" }
        },
        {
            "scope": [
                "entity.name.function.php",
                "support.function.construct.php",
                "support.function.magic.php"
            ],
            "settings": { "fontStyle": "italic bold", "foreground": "#1d4ed8" }
        },
        {
            "scope": ["storage.modifier.extends.php", "storage.modifier.php"],
            "settings": { "fontStyle": "italic bold", "foreground": "#ff0055" }
        },
        {
            "scope": [
                "variable.other.php",
                "variable.other.property.php",
                "variable.other.readwrite.php"
            ],
            "settings": { "foreground": "#0891b2" }
        },
        {
            "scope": "keyword.control.php",
            "settings": { "fontStyle": "italic", "foreground": "#ff0055" }
        },
        {
            "scope": [
                "punctuation.definition.tag.begin.html",
                "punctuation.definition.tag.end.html",
                "punctuation.separator.key-value.html",
                "punctuation.definition.string.begin.html",
                "punctuation.definition.string.end.html"
            ],
            "settings": { "foreground": "#4b5563" }
        },
        {
            "scope": "entity.name.tag.html",
            "settings": { "fontStyle": "bold", "foreground": "#1d4ed8" }
        },
        {
            "scope": "entity.other.attribute-name.html",
            "settings": { "fontStyle": "italic", "foreground": "#0891b2" }
        },
        {
            "scope": "string.quoted.double.html",
            "settings": { "foreground": "#166534" }
        },
        {
            "scope": "comment.block.html",
            "settings": { "fontStyle": "italic", "foreground": "#6b7280" }
        },
        {
            "scope": [
                "entity.name.tag.css",
                "entity.name.tag.scss",
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.class.scss",
                "entity.other.attribute-name.id.css",
                "entity.other.attribute-name.id.scss"
            ],
            "settings": { "fontStyle": "bold", "foreground": "#1d4ed8" }
        },
        {
            "scope": [
                "support.type.property-name.css",
                "support.type.property-name.scss"
            ],
            "settings": { "fontStyle": "italic", "foreground": "#0891b2" }
        },
        {
            "scope": [
                "support.constant.property-value.css",
                "support.constant.property-value.scss"
            ],
            "settings": { "foreground": "#c2410c" }
        },
        {
            "scope": [
                "variable.scss",
                "variable.parameter.scss",
                "variable.other.scss",
                "punctuation.definition.variable.scss"
            ],
            "settings": { "foreground": "#5b2b82" }
        },
        {
            "scope": "keyword.control.at-rule",
            "settings": { "fontStyle": "italic", "foreground": "#ff0055" }
        },
        {
            "scope": [
                "storage.type.js",
                "storage.type.ts",
                "keyword.control.js",
                "keyword.control.ts",
                "keyword.operator.new.js",
                "keyword.operator.new.ts"
            ],
            "settings": { "fontStyle": "italic", "foreground": "#ff0055" }
        },
        {
            "scope": [
                "entity.name.function.js",
                "entity.name.function.ts",
                "support.function.dom.js",
                "support.function.dom.ts"
            ],
            "settings": { "foreground": "#1d4ed8" }
        },
        {
            "scope": "variable.language.this",
            "settings": { "fontStyle": "bold", "foreground": "#c2410c" }
        },
        {
            "scope": ["entity.name.tag.pug", "storage.type.pug"],
            "settings": { "fontStyle": "bold", "foreground": "#ff0055" }
        },
        {
            "scope": "entity.other.attribute-name.tag.pug",
            "settings": { "fontStyle": "italic", "foreground": "#0891b2" }
        },
        {
            "scope": ["comment.line.pug", "comment.block.pug"],
            "settings": { "fontStyle": "italic", "foreground": "#6b7280" }
        },
        {
            "scope": "string.interpolated.pug",
            "settings": { "foreground": "#ff0055" }
        }
