{
    "name": "SwiftCode Theme - Swiftcode Only",
    "colors": {
        "editor.background": "#231E19",
        "editor.foreground": "#AFAFAF",
        "activityBarBadge.background": "#6d5922",
        "sideBarTitle.foreground": "#bbbbbb"
    },
    "tokenColors": [
        {
            "name": "Swiftcode conditional",
            "scope": "keyword.control.conditional.swico",
            "settings": { "foreground": "#569CD6" }
        },
        {
            "name": "Swiftcode flow",
            "scope": "keyword.control.flow.swico",
            "settings": { "foreground": "#ca067f" }
        },
        {
            "name": "Swiftcode built in",
            "scope": "keyword.control.builtin.swico",
            "settings": { "foreground": "#2ec241" }
        },
        {
            "name": "Swiftcode logic",
            "scope": "keyword.control.logic.swico",
            "settings": { "foreground": "#d8c40d" }
        },
        {
            "name": "Swiftcode string",
            "scope": "string.quoted.double.swico",
            "settings": { "foreground": "#11add4" }
        },
        {
            "name": "Swiftcode escape",
            "scope": "constant.character.escape.swico",
            "settings": { "foreground": "#569CD6" }
        },
        {
            "name": "Swiftcode Time",
            "scope": "keyword.control.time.swico",
            "settings": { "foreground": "#84c611" }
        },
        {
            "name": "Swiftcode Arithmatic",
            "scope": "keyword.operator.arithmatic.swico",
            "settings": { "foreground": "#72065b" }
        },
        {
            "name": "Swiftcode Finish",
            "scope": "keyword.control.finish.swico",
            "settings": { "foreground": "#72065b" }
        },
        {
            "name": "Swiftcode Comments",
            "scope": "keyword.operator.cmnt.swico",
            "settings": { "foreground": "#2c4e29" }
        },
        {
            "name": "Swiftcode Misc",
            "scope": "keyword.operator.delimeter.swico",
            "settings": { "foreground": "#d66101" }
        },
        {
            "name": "Swiftcode Comparison",
            "scope": "keyword.operator.comparison.swico",
            "settings": { "foreground": "#911111" }
        },
        {
            "name": "Swiftcode funcs Loops",
            "scope": "keyword.control.funcsloops.swico",
            "settings": { "foreground": "#0412d1" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
