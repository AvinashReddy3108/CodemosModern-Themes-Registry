        {
            "scope": "variable.other.property",
            "settings": { "foreground": "#b191d4" }
        },
        {
            "scope": "variable.other.object",
            "settings": { "foreground": "#66c2cd" }
        },
        {
            "scope": [
                "keyword.other.DML.sql",
                "keyword.other.DDL.create.sql",
                "keyword.other.DDL.alter.sql",
                "keyword.other.DDL.drop.sql"
            ],
            "settings": { "foreground": "#b45ed8", "fontStyle": "bold" }
        },
        {
            "scope": [
                "keyword.other.data.sql",
                "keyword.other.order.sql",
                "keyword.other.join.sql"
            ],
            "settings": { "foreground": "#d670ff" }
        },
        {
            "scope": "support.function.aggregate.sql",
            "settings": { "foreground": "#66c2cd" }
        },
        {
            "scope": [
                "constant.numeric.sql",
                "constant.other.database-name.sql",
                "constant.other.table-name.sql"
            ],
            "settings": { "foreground": "#f5b0ef" }
        },
        {
            "scope": ["string.quoted.single.sql", "string.quoted.double.sql"],
            "settings": { "foreground": "#89c4ff" }
        },
        {
            "scope": [
                "support.function.scalar.sql",
                "support.function.string.sql",
                "support.function.math.sql"
            ],
            "settings": { "foreground": "#66c2cd" }
        },
        {
            "scope": [
                "entity.name.function.sql",
                "support.function.datetime.sql"
            ],
            "settings": { "foreground": "#c27fd6" }
        },
        {
            "scope": [
                "constant.other.operator.sql",
                "keyword.operator.logical.sql",
                "keyword.operator.comparison.sql"
            ],
            "settings": { "foreground": "#b45ed8" }
        },
        {
            "scope": "variable.other.column.sql",
            "settings": { "foreground": "#d4c5d8" }
        },
        {
            "scope": ["support.function", "support.class", "support.type"],
            "settings": { "foreground": "#b45ed8" }
        },
        { "scope": "storage.type", "settings": { "foreground": "#d670ff" } },
        {
            "scope": "storage.modifier",
            "settings": { "foreground": "#9228b3" }
        },
        {
            "scope": "constant.language",
            "settings": { "foreground": "#66c2cd" }
        },
        {
            "scope": "entity.name.type",
            "settings": { "foreground": "#c27fd6" }
        },
        { "scope": "entity.name.tag", "settings": { "foreground": "#b45ed8" } },
        {
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#b191d4" }
        },
        {
            "scope": "markup.heading",
            "settings": { "foreground": "#b45ed8", "fontStyle": "bold" }
        },
        {
            "scope": "markup.quote",
            "settings": { "foreground": "#b191d4", "fontStyle": "italic" }
        },
        {
            "scope": "markup.bold",
            "settings": { "foreground": "#f5b0ef", "fontStyle": "bold" }
        },
        {
            "scope": "markup.italic",
            "settings": { "foreground": "#66c2cd", "fontStyle": "italic" }
        },
        {
            "scope": "markup.inline.raw",
            "settings": { "foreground": "#89c4ff" }
        },
        { "scope": "markup.list", "settings": { "foreground": "#b45ed8" } },
