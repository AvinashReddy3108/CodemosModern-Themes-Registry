            ],
            "settings": { "foreground": "#ffa6d9" }
        },
        {
            "scope": [
                "meta.definition.property.ts",
                "meta.definition.property.js"
            ],
            "settings": { "foreground": "#e4a6ff" }
        },
        {
            "scope": [
                "punctuation.definition.string.begin.ts",
