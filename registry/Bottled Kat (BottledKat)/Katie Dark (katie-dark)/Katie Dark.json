        "tab.unfocusedActiveBorder": "#D4A4BC",
        "tab.unfocusedActiveBackground": "#D4A4BC40",
        "tab.unfocusedActiveForeground": "#F0F0F0",
        "tab.unfocusedInactiveBackground": "#D4A4BC10",
        "tab.unfocusedInactiveForeground": "#F0F0F07f",
        "terminal.ansiBlack": "#000018",
        "terminal.ansiBlue": "#FFD4EC",
        "terminal.ansiBrightBlack": "#D4A4BC",
