    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#848478", "fontStyle": "italic" }
        },
        {
            "name": "String",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#1A7A40" }
        },
        {
            "name": "String escape / interpolation punctuation",
            "scope": [
                "constant.character.escape",
                "punctuation.definition.template-expression"
            ],
            "settings": { "foreground": "#df0043" }
        },
        {
            "name": "Regexp",
            "scope": ["string.regexp"],
            "settings": { "foreground": "#007A9A" }
        },
        {
            "name": "Numeric literal",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#df0043" }
        },
        {
            "name": "Boolean / null / undefined",
            "scope": [
                "constant.language.boolean",
                "constant.language.null",
                "constant.language.undefined",
                "constant.language.nan"
            ],
            "settings": { "foreground": "#1e64f1", "fontStyle": "italic bold" }
        },
        {
            "name": "Other language constants",
            "scope": ["constant.language"],
            "settings": { "foreground": "#1e64f1" }
        },
        {
            "name": "Keyword — control flow",
            "scope": [
                "keyword.control",
                "keyword.operator.new",
                "keyword.other.using"
            ],
            "settings": { "foreground": "#c7ba16", "fontStyle": "" }
        },
        {
            "name": "Keyword — other",
            "scope": ["keyword"],
            "settings": { "foreground": "#c7ba16" }
        },
        {
            "name": "Keyword operator",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#3A3A44", "fontStyle": "" }
        },
        {
            "name": "Storage type / modifier (var, const, class, function...)",
            "scope": ["storage.type", "storage.modifier"],
            "settings": { "foreground": "#1e64f1", "fontStyle": "italic bold" }
        },
        {
            "name": "Arrow function =>",
            "scope": ["storage.type.function.arrow"],
            "settings": { "foreground": "#1e64f1", "fontStyle": "" }
        },
        {
            "name": "Type / class name",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "entity.name.namespace",
                "support.class",
                "support.type"
            ],
            "settings": { "foreground": "#df0043" }
        },
        {
            "name": "Inherited class",
            "scope": ["entity.other.inherited-class"],
            "settings": { "foreground": "#00bbff", "fontStyle": "" }
        },
        {
            "name": "Interface",
            "scope": ["entity.name.type.interface"],
            "settings": { "foreground": "#00bbff", "fontStyle": "" }
        },
        {
            "name": "Generic / type parameter",
            "scope": [
                "entity.name.type.parameter",
                "punctuation.definition.typeparameters"
            ],
            "settings": { "foreground": "#00bbff" }
        },
        {
            "name": "Function / method name",
            "scope": [
                "entity.name.function",
                "meta.function-call entity.name.function",
                "support.function"
            ],
            "settings": { "foreground": "#9451f8" }
        },
        {
            "name": "Function parameter",
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#00a2e1", "fontStyle": "italic" }
        },
        {
            "name": "Variable",
            "scope": ["variable", "variable.other.readwrite"],
            "settings": { "foreground": "#1E1E22" }
        },
        {
            "name": "Variable — language (this, self, super, global)",
            "scope": ["variable.language"],
            "settings": { "foreground": "#00a2e1", "fontStyle": "italic" }
        },
        {
            "name": "Variable — property / member access",
            "scope": [
                "variable.other.property",
                "variable.other.object.property",
                "support.variable"
            ],
            "settings": { "foreground": "#c7ba16" }
        },
        {
            "name": "Variable — constant (ALL_CAPS / readonly)",
            "scope": ["variable.other.constant"],
            "settings": { "foreground": "#cd5a63" }
        },
        {
            "name": "Punctuation — separators, terminators",
            "scope": [
                "punctuation.separator",
                "punctuation.terminator",
                "punctuation.accessor",
                "punctuation.definition.parameters"
            ],
            "settings": { "foreground": "#6A6A72" }
        },
        {
            "name": "Punctuation — brackets / braces / parens",
            "scope": [
                "punctuation.definition.block",
                "punctuation.section",
                "meta.brace.round",
                "meta.brace.square",
                "meta.brace.curly"
            ],
            "settings": { "foreground": "#3A3A44" }
        },
        {
            "name": "Tag name",
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#b78484", "fontStyle": "" }
        },
        {
            "name": "Tag attribute name",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#df0043" }
        },
        {
            "name": "Tag attribute value (string)",
            "scope": [
                "string.quoted.html",
                "string.quoted.double.html",
                "string.quoted.single.html"
            ],
            "settings": { "foreground": "#1A7A40" }
        },
        {
            "name": "HTML/XML tag punctuation",
            "scope": [
                "punctuation.definition.tag",
                "punctuation.definition.tag.begin",
                "punctuation.definition.tag.end"
            ],
            "settings": { "foreground": "#848478" }
        },
        {
            "name": "CSS property name",
            "scope": [
                "support.type.property-name.css",
                "support.type.property-name"
            ],
            "settings": { "foreground": "#0849d7" }
        },
        {
            "name": "CSS property value",
            "scope": [
                "support.constant.property-value.css",
                "meta.property-value.css"
            ],
            "settings": { "foreground": "#00ce53" }
        },
        {
            "name": "CSS selector tag",
            "scope": ["entity.name.tag.css"],
            "settings": { "foreground": "#1e64f1" }
        },
        {
            "name": "CSS selector attribute / pseudo",
            "scope": [
                "entity.other.attribute-name.css",
                "entity.other.attribute-name.pseudo-class",
                "entity.other.attribute-name.pseudo-element"
            ],
            "settings": { "foreground": "#df0043" }
        },
        {
            "name": "CSS class / id selector",
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css"
            ],
            "settings": { "foreground": "#00bbff" }
        },
        {
            "name": "CSS unit / numeric",
            "scope": ["constant.numeric.css", "keyword.other.unit.css"],
            "settings": { "foreground": "#c7ba16" }
        },
        {
            "name": "Decorator / annotation",
            "scope": [
                "meta.decorator",
                "punctuation.decorator",
                "entity.name.function.decorator"
            ],
            "settings": { "foreground": "#A04800", "fontStyle": "italic" }
        },
        {
            "name": "Diff inserted",
            "scope": ["markup.inserted"],
            "settings": { "foreground": "#1A7A40" }
        },
        {
            "name": "Diff deleted",
            "scope": ["markup.deleted"],
            "settings": { "foreground": "#B82A00" }
        },
        {
            "name": "Diff changed",
            "scope": ["markup.changed"],
            "settings": { "foreground": "#0032c8" }
        },
        {
            "name": "Markdown heading",
            "scope": ["markup.heading", "entity.name.section.markdown"],
            "settings": { "foreground": "#1A1A1E", "fontStyle": "bold" }
        },
        {
            "name": "Markdown bold",
            "scope": ["markup.bold"],
            "settings": { "foreground": "#1A1A1E", "fontStyle": "bold" }
        },
        {
            "name": "Markdown italic",
            "scope": ["markup.italic"],
            "settings": { "foreground": "#005F88", "fontStyle": "italic" }
        },
        {
            "name": "Markdown inline code",
            "scope": ["markup.inline.raw", "markup.fenced_code.block"],
            "settings": { "foreground": "#1A7A40" }
        },
        {
            "name": "Markdown link",
            "scope": ["markup.underline.link"],
            "settings": { "foreground": "#00A0CC" }
        },
        {
            "name": "Markdown blockquote",
            "scope": ["markup.quote"],
            "settings": { "foreground": "#848478", "fontStyle": "italic" }
        },
        {
            "name": "Markdown list bullet",
            "scope": ["punctuation.definition.list.begin.markdown"],
            "settings": { "foreground": "#df0043" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid"],
            "settings": { "foreground": "#B82A00", "fontStyle": "underline" }
        },
        {
            "name": "Deprecated",
            "scope": ["invalid.deprecated"],
            "settings": {
                "foreground": "#A04800",
                "fontStyle": "strikethrough"
            }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "namespace": { "foreground": "#0078A8" },
        "class": { "foreground": "#00bbff" },
        "class.declaration": { "foreground": "#00bbff" },
        "interface": { "foreground": "#00bbff" },
        "enum": { "foreground": "#00bbff" },
        "enumMember": { "foreground": "#df0043" },
        "struct": { "foreground": "#00bbff" },
        "typeParameter": { "foreground": "#00bbff", "italic": true },
        "function": { "foreground": "#9451f8" },
        "function.declaration": { "foreground": "#9451f8", "bold": true },
        "method": { "foreground": "#9451f8" },
        "method.declaration": { "foreground": "#9451f8", "bold": true },
        "property": { "foreground": "#c7ba16" },
        "property.declaration": { "foreground": "#c7ba16" },
        "property.readonly": { "foreground": "#cd5a63", "italic": true },
        "parameter": { "foreground": "#00c524", "italic": true },
        "variable": { "foreground": "#1E1E22" },
        "variable.readonly": { "foreground": "#cd5a63" },
        "variable.readonly.defaultLibrary": {
            "foreground": "#cd5a63",
            "italic": true
        },
        "selfKeyword": { "foreground": "#00a2e1", "italic": true },
        "macro": { "foreground": "#df0043" },
        "keyword": { "foreground": "#c7ba16" },
        "modifier": { "foreground": "#1e64f1", "italic": true },
        "comment": { "foreground": "#848478", "italic": true },
        "string": { "foreground": "#1A7A40" },
        "number": { "foreground": "#df0043" },
        "regexp": { "foreground": "#007A9A" },
        "operator": { "foreground": "#3A3A44" },
        "type": { "foreground": "#0078A8" },
        "decorator": { "foreground": "#df0043", "italic": true },
        "label": { "foreground": "#848478" }
    },
    "$schema": "vscode://schemas/color-theme"
}
