    "tokenColors": [
        { "scope": "emphasis", "settings": { "fontStyle": "italic" } },
        { "scope": "strong", "settings": { "fontStyle": "bold" } },
        {
            "scope": "comment",
            "settings": { "foreground": "#616E88", "fontStyle": "italic" }
        },
        {
            "scope": [
                "punctuation.definition.comment",
                "punctuation.end.definition.comment",
                "punctuation.start.definition.comment"
            ],
            "settings": { "foreground": "#616E88" }
        },
        { "scope": "invalid.illegal", "settings": { "foreground": "#BF616A" } },
        {
            "scope": "invalid.deprecated",
            "settings": {
                "foreground": "#EBCB8B",
                "fontStyle": "strikethrough"
            }
        },
        {
            "scope": "token.error-token",
            "settings": { "foreground": "#BF616A" }
        },
        {
            "scope": "token.debug-token",
            "settings": { "foreground": "#B48EAD" }
        },
        {
            "scope": "token.info-token",
            "settings": { "foreground": "#88C0D0" }
        },
        {
            "scope": "token.warn-token",
            "settings": { "foreground": "#EBCB8B" }
        },
        {
            "scope": [
                "constant.language",
                "constant.language.boolean",
                "support.constant",
                "variable.language.this",
                "variable.language.special"
            ],
            "settings": { "foreground": "#B48EAD" }
        },
        {
            "scope": ["variable.language.this", "variable.language.special"],
            "settings": { "fontStyle": "italic" }
        },
        {
            "scope": "constant.numeric",
            "settings": { "foreground": "#D08770" }
        },
        {
            "scope": [
                "constant.character",
                "constant.other",
                "support.constant.property-value",
                "variable.other.constant"
            ],
            "settings": { "foreground": "#B48EAD" }
        },
        {
            "scope": "constant.character.escape",
            "settings": { "foreground": "#EBCB8B" }
        },
        {
            "scope": ["constant.regexp", "string.regexp"],
            "settings": { "foreground": "#EBCB8B" }
        },
        {
            "scope": ["keyword", "storage", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#81A1C1" }
        },
        {
            "scope": "keyword.operator",
            "settings": { "foreground": "#ECEFF4" }
        },
        {
            "scope": "keyword.other.new",
            "settings": { "foreground": "#81A1C1", "fontStyle": "bold" }
        },
        {
            "scope": "keyword.control",
            "settings": { "foreground": "#81A1C1", "fontStyle": "bold" }
        },
        {
            "scope": [
                "variable",
                "variable.other",
                "variable.parameter",
                "meta.definition.variable.name",
                "support.variable"
            ],
            "settings": { "foreground": "#EBCB8B" }
        },
        {
            "scope": [
                "entity.name.function",
                "meta.function.definition entity.name.function",
                "meta.function-call entity.name.function",
                "meta.method-call entity.name.function",
                "support.function",
                "entity.name.function.constructor"
