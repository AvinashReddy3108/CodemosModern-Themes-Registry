    "tokenColors": [
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#a78bfa", "fontStyle": "italic" }
        },
        {
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#d946ef", "fontStyle": "bold" }
        },
        {
            "scope": [
                "keyword.control",
                "keyword.operator.new",
                "keyword.other.important"
            ],
            "settings": { "foreground": "#ff0080", "fontStyle": "bold" }
        },
        {
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call"
            ],
            "settings": { "foreground": "#00ffff", "fontStyle": "bold" }
        },
        {
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.class",
                "entity.other.inherited-class"
            ],
            "settings": { "foreground": "#c084fc", "fontStyle": "bold" }
        },
        {
            "scope": ["string", "string.quoted"],
            "settings": { "foreground": "#00ff88" }
        },
        {
            "scope": [
                "string.template",
                "meta.template.expression",
                "punctuation.definition.template-expression"
            ],
            "settings": { "foreground": "#22d3ee", "fontStyle": "bold" }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.language.boolean",
                "constant.language.null"
            ],
            "settings": { "foreground": "#ff9500" }
        },
        {
            "scope": [
                "variable",
                "variable.other.readwrite",
                "variable.parameter"
            ],
            "settings": { "foreground": "#a5f3fc" }
        },
        {
            "scope": [
                "variable.other.property",
                "variable.other.object.property",
                "support.type.property-name"
            ],
            "settings": { "foreground": "#38bdf8" }
        },
        {
            "scope": [
                "variable.other.constant",
                "constant.language",
                "constant.character"
            ],
            "settings": { "foreground": "#fb7185" }
        },
        {
            "scope": [
                "keyword.operator",
                "keyword.operator.arithmetic",
                "keyword.operator.logical"
            ],
            "settings": { "foreground": "#a855f7" }
        },
        {
            "scope": ["punctuation", "meta.brace", "punctuation.separator"],
            "settings": { "foreground": "#fde047" }
        },
        {
            "scope": ["entity.name.tag", "meta.tag"],
            "settings": { "foreground": "#ff006e", "fontStyle": "bold" }
        },
        {
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#06b6d4", "fontStyle": "italic" }
        },
        {
            "scope": [
                "entity.name.tag.css",
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css"
            ],
            "settings": { "foreground": "#8b5cf6", "fontStyle": "bold" }
        },
        {
            "scope": ["support.type.property-name.css"],
            "settings": { "foreground": "#3b82f6" }
        },
        {
            "scope": [
                "support.constant.property-value.css",
                "meta.property-value.css"
            ],
            "settings": { "foreground": "#84cc16" }
        },
        {
            "scope": [
                "keyword.control.import",
                "keyword.control.export",
                "keyword.control.from"
            ],
            "settings": { "foreground": "#f472b6", "fontStyle": "bold" }
        },
        {
            "scope": ["variable.language.this", "variable.language.self"],
            "settings": { "foreground": "#ff8800", "fontStyle": "italic bold" }
        },
        {
            "scope": ["entity.name.function.decorator", "meta.decorator"],
            "settings": { "foreground": "#fbbf24", "fontStyle": "bold" }
        },
        {
            "scope": ["string.regexp"],
            "settings": { "foreground": "#a3e635", "fontStyle": "bold" }
        },
        {
            "scope": ["constant.character.escape"],
            "settings": { "foreground": "#ffff00", "fontStyle": "bold" }
        },
        {
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#22d3ee", "fontStyle": "bold" }
        },
        {
            "scope": ["markup.heading.1"],
            "settings": { "foreground": "#ff0080", "fontStyle": "bold" }
        },
        {
            "scope": ["markup.heading.2"],
            "settings": { "foreground": "#d946ef", "fontStyle": "bold" }
        },
        {
            "scope": ["markup.heading.3"],
            "settings": { "foreground": "#c084fc", "fontStyle": "bold" }
        },
        {
            "scope": [
                "markup.heading.4",
                "markup.heading.5",
                "markup.heading.6"
            ],
            "settings": { "foreground": "#a78bfa", "fontStyle": "bold" }
        },
        {
            "scope": ["markup.bold"],
            "settings": { "foreground": "#ff006e", "fontStyle": "bold" }
        },
        {
            "scope": ["markup.italic"],
            "settings": { "foreground": "#2dd4bf", "fontStyle": "italic" }
        },
        {
            "scope": ["markup.inline.raw", "markup.fenced_code"],
            "settings": { "foreground": "#00ff88" }
        },
        {
            "scope": ["markup.underline.link"],
            "settings": { "foreground": "#0ea5e9" }
        },
        {
            "scope": ["markup.quote"],
            "settings": { "foreground": "#a855f7", "fontStyle": "italic" }
        },
        {
            "scope": ["entity.name.type.interface"],
            "settings": { "foreground": "#14b8a6", "fontStyle": "bold" }
        },
        {
            "scope": ["entity.name.type.enum"],
            "settings": { "foreground": "#f59e0b", "fontStyle": "bold" }
        },
        {
            "scope": ["entity.name.namespace", "entity.name.type.module"],
            "settings": { "foreground": "#6366f1", "fontStyle": "bold" }
        },
        {
            "scope": ["support.constant"],
            "settings": { "foreground": "#facc15" }
        },
        {
            "scope": ["meta.tag.metadata", "entity.name.tag.metadata"],
            "settings": { "foreground": "#84cc16" }
        },
        {
            "scope": ["invalid", "invalid.deprecated"],
            "settings": {
                "foreground": "#ff3333",
                "fontStyle": "bold strikethrough"
            }
        },
        {
            "scope": ["keyword.other.DML.sql"],
            "settings": { "foreground": "#06b6d4", "fontStyle": "bold" }
        },
        {
            "scope": [
                "entity.name.function.decorator.python",
                "meta.function.decorator.python"
            ],
            "settings": { "foreground": "#fbbf24", "fontStyle": "bold" }
        },
        {
            "scope": ["meta.type.annotation", "storage.type.annotation"],
            "settings": { "foreground": "#38bdf8" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
