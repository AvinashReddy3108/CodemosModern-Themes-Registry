    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#5a6a7a", "fontStyle": "italic" }
        },
        {
            "name": "String",
            "scope": [
                "string",
                "string.quoted",
                "string.template",
                "string.quoted.docstring",
                "string.quoted.docstring.multi",
                "string.quoted.docstring.multi.python"
            ],
            "settings": { "foreground": "#00ff88" }
        },
        {
            "name": "Python Self",
            "scope": [
                "variable.language.self",
                "variable.parameter.function.language.special.self",
                "variable.language.special.self.python"
            ],
            "settings": { "foreground": "#ff6666", "fontStyle": "italic" }
        },
        {
            "name": "Python Cls",
            "scope": [
                "variable.parameter.function.language.special.cls.python"
            ],
            "settings": { "foreground": "#ff6666", "fontStyle": "italic" }
        },
        {
            "name": "Source Python",
            "scope": ["source.python"],
            "settings": { "foreground": "#c5d0e6" }
        },
        {
            "name": "Meta Item Access",
            "scope": ["meta.item-access", "meta.indexed-name"],
            "settings": { "foreground": "#c5d0e6" }
        },
        {
            "name": "String Escape",
            "scope": ["constant.character.escape"],
            "settings": { "foreground": "#66ffaa" }
        },
        {
            "name": "Number",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#ffb000" }
        },
        {
            "name": "Boolean",
            "scope": ["constant.language.boolean"],
            "settings": { "foreground": "#ffb000" }
        },
        {
            "name": "Constant",
            "scope": ["constant", "constant.language", "constant.other"],
            "settings": { "foreground": "#ffb000" }
        },
        {
            "name": "Keyword",
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#a855f7" }
        },
        {
            "name": "Keyword Control",
            "scope": ["keyword.control"],
            "settings": { "foreground": "#a855f7" }
        },
        {
            "name": "Keyword Operator",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#00b8d9" }
        },
        {
            "name": "Function",
            "scope": [
                "entity.name.function",
                "meta.function-call",
                "support.function"
            ],
            "settings": { "foreground": "#00d9ff" }
        },
        {
            "name": "Function Parameter",
            "scope": ["variable.parameter", "meta.function.parameters"],
            "settings": { "foreground": "#c5d0e6", "fontStyle": "italic" }
        },
        {
            "name": "Method",
            "scope": ["entity.name.function.member", "meta.method-call"],
            "settings": { "foreground": "#00d9ff" }
        },
        {
            "name": "Class",
            "scope": [
                "entity.name.class",
                "entity.name.type.class",
                "support.class"
            ],
            "settings": { "foreground": "#0a8a8a" }
        },
        {
            "name": "Type",
            "scope": [
                "entity.name.type",
                "support.type",
                "entity.name.type.interface"
            ],
            "settings": { "foreground": "#0a8a8a" }
        },
        {
            "name": "Variable",
            "scope": [
                "variable",
                "variable.other",
                "variable.other.readwrite",
                "meta.member.access.python"
            ],
            "settings": { "foreground": "#c5d0e6" }
        },
        {
            "name": "Variable Property",
            "scope": [
                "variable.other.property",
                "variable.other.object.property",
                "support.variable.property",
                "meta.attribute.python"
            ],
            "settings": { "foreground": "#00b8d9" }
        },
        {
            "name": "Python Builtins",
            "scope": [
                "support.function.builtin.python",
                "support.type.python",
                "support.function.magic.python"
            ],
            "settings": { "foreground": "#00d9ff" }
        },
        {
            "name": "Python Magic Methods",
            "scope": [
                "support.function.magic.python",
                "support.variable.magic.python"
            ],
            "settings": { "foreground": "#00d9ff" }
        },
        {
            "name": "Function Call Generic",
            "scope": [
                "meta.function-call.generic",
                "meta.function-call.python"
            ],
            "settings": { "foreground": "#00d9ff" }
        },
        {
            "name": "Variable Constant",
            "scope": ["variable.other.constant"],
            "settings": { "foreground": "#ffb000" }
        },
        {
            "name": "Punctuation",
            "scope": ["punctuation"],
            "settings": { "foreground": "#8892a2" }
        },
        {
            "name": "Punctuation Braces",
            "scope": [
                "punctuation.definition.block",
                "punctuation.definition.parameters",
                "punctuation.section"
            ],
            "settings": { "foreground": "#8892a2" }
        },
        {
            "name": "Operator",
            "scope": ["keyword.operator", "punctuation.accessor"],
            "settings": { "foreground": "#00b8d9" }
        },
        {
            "name": "Decorator",
            "scope": [
                "meta.decorator",
                "punctuation.decorator",
                "entity.name.function.decorator"
            ],
            "settings": { "foreground": "#ffb000" }
        },
        {
            "name": "Tag",
            "scope": ["entity.name.tag", "support.class.component"],
            "settings": { "foreground": "#ff3333" }
        },
        {
            "name": "Tag Attribute",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#ffb000" }
        },
        {
            "name": "Library",
            "scope": ["support.type.builtin", "support.class.builtin"],
            "settings": { "foreground": "#0a8a8a" }
        },
        {
            "name": "Import",
            "scope": [
                "meta.import",
                "keyword.control.import",
                "keyword.control.from"
            ],
            "settings": { "foreground": "#a855f7" }
        },
        {
            "name": "Import Path",
            "scope": ["string.quoted.module"],
            "settings": { "foreground": "#00ff88" }
        },
        {
            "name": "Namespace",
            "scope": ["entity.name.namespace", "entity.name.module"],
            "settings": { "foreground": "#c5d0e6" }
        },
        {
            "name": "Markup Heading",
            "scope": ["markup.heading", "entity.name.section"],
            "settings": { "foreground": "#00d9ff", "fontStyle": "bold" }
        },
        {
            "name": "Markup Bold",
            "scope": ["markup.bold"],
            "settings": { "foreground": "#c5d0e6", "fontStyle": "bold" }
        },
        {
            "name": "Markup Italic",
            "scope": ["markup.italic"],
            "settings": { "foreground": "#c5d0e6", "fontStyle": "italic" }
        },
        {
            "name": "Markup Underline",
            "scope": ["markup.underline"],
            "settings": { "fontStyle": "underline" }
        },
        {
            "name": "Markup Link",
            "scope": ["markup.underline.link", "string.other.link"],
            "settings": { "foreground": "#00d9ff" }
        },
        {
            "name": "Markup List",
            "scope": ["markup.list", "punctuation.definition.list"],
            "settings": { "foreground": "#ffb000" }
        },
        {
            "name": "Markup Quote",
            "scope": ["markup.quote"],
            "settings": { "foreground": "#8892a2", "fontStyle": "italic" }
        },
        {
            "name": "Markup Code",
            "scope": ["markup.inline.raw", "markup.fenced_code"],
            "settings": { "foreground": "#00ff88" }
        },
        {
            "name": "Markup Inserted",
            "scope": ["markup.inserted"],
            "settings": { "foreground": "#00ff88" }
        },
        {
            "name": "Markup Deleted",
            "scope": ["markup.deleted"],
            "settings": { "foreground": "#ff3333" }
        },
        {
            "name": "Markup Changed",
            "scope": ["markup.changed"],
            "settings": { "foreground": "#ffb000" }
        },
        {
            "name": "JSON Key",
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#00b8d9" }
        },
        {
            "name": "YAML Key",
            "scope": ["entity.name.tag.yaml"],
            "settings": { "foreground": "#00b8d9" }
        },
        {
            "name": "CSS Property",
            "scope": ["support.type.property-name.css"],
            "settings": { "foreground": "#00b8d9" }
        },
        {
            "name": "CSS Value",
            "scope": ["support.constant.property-value.css"],
            "settings": { "foreground": "#c5d0e6" }
        },
        {
            "name": "CSS Unit",
            "scope": ["keyword.other.unit.css"],
            "settings": { "foreground": "#ffb000" }
        },
        {
            "name": "CSS Selector",
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css"
            ],
            "settings": { "foreground": "#0a8a8a" }
        },
        {
            "name": "Regex",
            "scope": ["string.regexp"],
            "settings": { "foreground": "#ff6666" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#ff3333" }
        },
        {
            "name": "Deprecated",
            "scope": ["invalid.deprecated"],
            "settings": {
                "foreground": "#ff6666",
                "fontStyle": "strikethrough"
            }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
