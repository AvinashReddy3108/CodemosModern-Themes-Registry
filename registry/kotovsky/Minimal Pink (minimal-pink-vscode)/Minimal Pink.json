        "gitDecoration.deletedResourceForeground": "#FF6B9A",
        "gitDecoration.untrackedResourceForeground": "#4EC9B0",
        "gitDecoration.ignoredResourceForeground": "#767676",
        "gitDecoration.conflictingResourceForeground": "#FF8AAF",
