        "diffEditor.removedTextBackground": "#FF6B9A26",
        "diffEditor.insertedLineBackground": "#4EC9B014",
        "diffEditor.removedLineBackground": "#FF6B9A14",
        "peekView.border": "#FF6B9A",
        "peekViewEditor.background": "#0C0C0C",
        "peekViewEditor.matchHighlightBackground": "#FF6B9A44",
        "peekViewResult.background": "#141414",
        "peekViewResult.fileForeground": "#D4D4D4",
        "peekViewResult.lineForeground": "#A0A0A0",
        "peekViewResult.matchHighlightBackground": "#FF6B9A44",
        "peekViewResult.selectionBackground": "#222222",
        "peekViewTitle.background": "#141414",
        "peekViewTitleDescription.foreground": "#A0A0A0",
        "peekViewTitleLabel.foreground": "#D4D4D4"
    },
    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment"],
            "settings": { "foreground": "#767676" }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.new",
                "storage",
                "storage.type"
            ],
            "settings": { "foreground": "#FF6B9A" }
        },
        {
            "name": "Strings",
            "scope": ["string"],
            "settings": { "foreground": "#4EC9B0" }
        },
        {
            "name": "Numbers",
            "scope": [
                "constant.numeric",
                "constant.character",
                "constant.other"
            ],
            "settings": { "foreground": "#DCDCAA" }
        },
        {
            "name": "Booleans and Null",
            "scope": ["constant.language.boolean", "constant.language.null"],
            "settings": { "foreground": "#DCDCAA" }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "meta.function-call",
                "support.function",
                "variable.function"
            ],
            "settings": { "foreground": "#D4D4D4" }
        },
        {
            "name": "Variables and Identifiers",
            "scope": [
                "variable",
                "identifier",
                "variable.other",
                "variable.parameter"
            ],
            "settings": { "foreground": "#D4D4D4" }
        },
        {
            "name": "Types",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "entity.name.interface",
                "entity.name.struct",
                "support.class",
                "support.type"
            ],
            "settings": { "foreground": "#A0A0A0" }
        },
        {
            "name": "Operators",
            "scope": ["operator", "keyword.operator"],
            "settings": { "foreground": "#D4D4D4" }
        },
        {
            "name": "Punctuation",
            "scope": ["punctuation", "meta.brace", "meta.delimiter"],
            "settings": { "foreground": "#767676" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid"],
            "settings": { "foreground": "#F2F2F2", "fontStyle": "underline" }
        },
        {
            "name": "Properties and Object Keys",
            "scope": [
                "variable.other.property",
                "support.variable.property",
                "support.type.property-name",
                "support.type.property-name.json",
                "support.type.property-name.json.comments",
                "support.type.property-name.css",
                "support.type.vendored.property-name",
                "meta.property-name",
                "meta.object-literal.key string",
                "meta.object-literal.key.ts",
                "meta.object-literal.key.tsx",
                "meta.object-literal.key.js",
                "meta.object-literal.key.jsx",
                "meta.object-literal.key",
                "entity.name.tag"
            ],
            "settings": { "foreground": "#D4D4D4" }
        },
        {
            "name": "Regular Expressions and Escapes",
            "scope": ["string.regexp", "constant.character.escape"],
            "settings": { "foreground": "#DCDCAA" }
        }
    ]
}
