    "tokenColors": [
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#7A7E85" }
        },
        {
            "scope": ["comment.block", "comment.line"],
            "settings": { "foreground": "#7A7E85" }
        },
        {
            "scope": [
                "comment.block.documentation",
                "comment.line.documentation",
                "comment.block.documentation.go",
                "comment.line.double-slash.documentation"
            ],
            "settings": { "foreground": "#5F826B", "fontStyle": "italic" }
        },
        {
            "scope": ["keyword", "storage", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#CF8E6D" }
        },
        {
            "scope": [
                "keyword.operator",
                "keyword.operator.expression",
                "storage.type.function"
            ],
            "settings": { "foreground": "#CF8E6D" }
        },
        {
            "scope": [
                "string",
                "constant.other.symbol",
                "punctuation.definition.string"
            ],
            "settings": { "foreground": "#6AAB73" }
        },
        {
            "scope": ["constant.character.escape"],
            "settings": { "foreground": "#CF8E6D" }
        },
        {
            "scope": ["invalid.illegal.invalid-string-escape"],
            "settings": { "foreground": "#CF8E6D" }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.language.boolean",
                "constant.language.nil",
                "constant.language.null"
            ],
            "settings": { "foreground": "#2AACB8" }
        },
        {
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "entity.name.struct",
                "entity.name.enum",
                "support.type",
                "support.class"
            ],
            "settings": { "foreground": "#BCBEC4" }
        },
        {
            "scope": [
                "entity.name.type.parameter",
                "variable.other.type.parameter"
            ],
            "settings": { "foreground": "#16BAAC" }
        },
        {
            "scope": [
                "entity.name.function",
                "meta.function-call entity.name.function"
            ],
            "settings": { "foreground": "#56A8F5" }
        },
        {
            "scope": ["support.function", "variable.function"],
            "settings": { "foreground": "#57AAF7" }
        },
        {
            "scope": ["entity.name.function.static"],
            "settings": { "foreground": "#57AAF7", "fontStyle": "italic" }
        },
        {
            "scope": [
                "constant.other",
                "variable.other.constant",
                "variable.other.enummember",
                "support.constant",
                "meta.object-literal.key"
            ],
            "settings": { "foreground": "#C77DBB", "fontStyle": "italic" }
        },
        {
            "scope": [
                "variable.other.property",
                "variable.other.object.property",
                "support.variable.property"
            ],
            "settings": { "foreground": "#C77DBB" }
        },
        {
            "scope": [
                "variable.other.property.static",
                "support.variable.property.static"
            ],
            "settings": { "foreground": "#C77DBB", "fontStyle": "italic" }
        },
        {
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#BCBEC4" }
        },
        {
            "scope": [
                "variable.other",
                "source.go variable.other",
                "source.swift variable.other"
            ],
            "settings": { "foreground": "#BCBEC4" }
        },
        {
            "scope": [
                "meta.annotation",
                "storage.type.annotation",
                "entity.name.type.annotation",
                "punctuation.definition.annotation"
            ],
            "settings": { "foreground": "#B3AE60" }
        },
        {
            "scope": ["string.regexp", "constant.regexp", "source.regexp"],
            "settings": { "foreground": "#42C3D4" }
        },
        {
            "scope": [
                "keyword.operator.regexp",
                "constant.other.character-class.regexp"
            ],
            "settings": { "foreground": "#B2AE60", "fontStyle": "bold" }
        },
        {
            "scope": [
                "entity.name.tag",
                "entity.name.tag.html",
                "entity.name.tag.xml",
                "punctuation.definition.tag"
            ],
            "settings": { "foreground": "#D5B778" }
        },
        {
            "scope": [
                "entity.name.tag.custom",
                "support.class.component",
                "support.class.component.jsx",
                "support.class.component.tsx"
            ],
            "settings": { "foreground": "#2FBAA3" }
        },
        {
            "scope": [
                "entity.other.attribute-name",
                "entity.other.attribute-name.html",
                "entity.other.attribute-name.xml"
            ],
            "settings": { "foreground": "#BCBEC4" }
        },
        {
            "scope": [
                "constant.character.entity",
                "constant.character.entity.xml",
                "constant.character.entity.html"
            ],
            "settings": { "foreground": "#56A8F5" }
        },
        {
            "scope": ["support.type.property-name.css"],
            "settings": { "foreground": "#C77DBB" }
        },
        {
            "scope": [
                "support.constant.property-value.css",
                "constant.other.color.rgb-value.css"
            ],
            "settings": { "foreground": "#56A8F5" }
        },
        {
            "scope": ["keyword.other.important.css"],
            "settings": { "foreground": "#CF8E6D", "fontStyle": "bold" }
        },
        {
            "scope": [
                "variable.css",
                "variable.scss",
                "variable.sass",
                "variable.less"
            ],
            "settings": { "foreground": "#6D9CBE" }
        },
        {
            "scope": [
                "markup.underline.link",
                "string.other.link",
                "meta.link.inline.markdown"
            ],
            "settings": { "foreground": "#56A8F5", "fontStyle": "underline" }
        },
        {
            "scope": ["markup.bold"],
            "settings": { "foreground": "#BCBEC4", "fontStyle": "bold" }
        },
        {
            "scope": ["markup.italic"],
            "settings": { "foreground": "#BCBEC4", "fontStyle": "italic" }
        },
        {
            "scope": ["markup.heading"],
            "settings": { "foreground": "#CF8E6D", "fontStyle": "bold" }
        },
        {
            "scope": ["markup.quote"],
            "settings": { "foreground": "#7A7E85", "fontStyle": "italic" }
        },
        {
            "scope": ["markup.inline.raw", "markup.fenced_code.block"],
            "settings": { "foreground": "#CED0D6" }
        },
        {
            "scope": [
                "support.type.property-name.json",
                "meta.structure.dictionary.key.json string"
            ],
            "settings": { "foreground": "#C77DBB" }
        },
        {
            "scope": [
                "entity.name.section.properties",
                "support.type.property-name.properties"
            ],
            "settings": { "foreground": "#CF8E6D", "fontStyle": "underline" }
        },
        {
            "scope": [
                "keyword.control.directive.velocity",
                "keyword.control.directive"
            ],
            "settings": { "foreground": "#E8BF6A", "fontStyle": "bold" }
        },
        {
            "scope": ["entity.name.label", "constant.other.label"],
            "settings": {
                "foreground": "#B3AE60",
                "fontStyle": "bold underline"
            }
        },
        {
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#F75464" }
        },
        {
            "scope": ["invalid.deprecated", "markup.strikethrough"],
            "settings": {
                "foreground": "#6F737A",
                "fontStyle": "strikethrough"
            }
        }
    ],
    "semanticTokenColors": {
        "comment": "#7A7E85",
        "*.documentation": { "foreground": "#5F826B", "italic": true },
        "keyword": "#CF8E6D",
        "string": "#6AAB73",
        "number": "#2AACB8",
        "regexp": "#42C3D4",
        "operator": "#BCBEC4",
        "namespace": "#BCBEC4",
        "type": "#BCBEC4",
        "class": "#BCBEC4",
        "enum": "#BCBEC4",
        "interface": "#BCBEC4",
        "struct": "#BCBEC4",
        "typeParameter": "#16BAAC",
        "function": "#56A8F5",
        "method": "#57AAF7",
        "macro": "#B3AE60",
        "variable": "#BCBEC4",
        "parameter": "#BCBEC4",
        "property": "#C77DBB",
        "enumMember": { "foreground": "#C77DBB", "italic": true },
        "*.readonly": { "foreground": "#C77DBB", "italic": true },
        "*.static": { "foreground": "#C77DBB", "italic": true },
        "method.static": { "foreground": "#57AAF7", "italic": true },
        "function.static": { "foreground": "#57AAF7", "italic": true },
        "property.static": { "foreground": "#C77DBB", "italic": true },
        "variable.static": { "foreground": "#C77DBB", "italic": true },
        "*.deprecated": { "foreground": "#6F737A", "strikethrough": true },
        "*.modification": { "foreground": "#BCBEC4", "underline": true }
    },
    "$schema": "vscode://schemas/color-theme"
}
