    "tokenColors": [
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#8C8C8C", "fontStyle": "italic" }
        },
        {
            "scope": ["comment.block", "comment.line"],
            "settings": { "foreground": "#8C8C8C", "fontStyle": "italic" }
        },
        {
            "scope": [
                "comment.block.documentation",
                "comment.line.documentation",
                "comment.block.documentation.go",
                "comment.line.double-slash.documentation"
            ],
            "settings": { "foreground": "#8C8C8C", "fontStyle": "italic" }
        },
        {
            "scope": ["keyword", "storage", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#0033B3" }
        },
        {
            "scope": [
                "keyword.operator",
                "keyword.operator.expression",
                "storage.type.function"
            ],
            "settings": { "foreground": "#0033B3" }
        },
        {
            "scope": [
                "string",
                "constant.other.symbol",
                "punctuation.definition.string"
            ],
            "settings": { "foreground": "#067D17" }
        },
        {
            "scope": ["constant.character.escape"],
            "settings": { "foreground": "#0037A6" }
        },
        {
            "scope": ["invalid.illegal.invalid-string-escape"],
            "settings": { "foreground": "#067D17" }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.language.boolean",
                "constant.language.nil",
                "constant.language.null"
            ],
            "settings": { "foreground": "#1750EB" }
        },
        {
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "entity.name.struct",
                "entity.name.enum",
                "support.type",
                "support.class"
            ],
            "settings": { "foreground": "#080808" }
        },
        {
            "scope": [
                "entity.name.type.parameter",
                "variable.other.type.parameter"
            ],
            "settings": { "foreground": "#007E8A" }
        },
        {
            "scope": [
                "entity.name.function",
                "meta.function-call entity.name.function"
            ],
            "settings": { "foreground": "#00627A" }
        },
        {
            "scope": ["support.function", "variable.function"],
            "settings": { "foreground": "#00627A" }
        },
        {
            "scope": ["entity.name.function.static"],
            "settings": { "foreground": "#00627A", "fontStyle": "italic" }
        },
        {
            "scope": [
                "constant.other",
                "variable.other.constant",
                "variable.other.enummember",
                "support.constant",
                "meta.object-literal.key"
            ],
            "settings": { "foreground": "#871094", "fontStyle": "italic" }
        },
        {
            "scope": [
                "variable.other.property",
                "variable.other.object.property",
                "support.variable.property"
            ],
            "settings": { "foreground": "#871094" }
        },
        {
            "scope": [
                "variable.other.property.static",
                "support.variable.property.static"
            ],
            "settings": { "foreground": "#871094", "fontStyle": "italic" }
        },
        {
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#080808" }
        },
        {
            "scope": [
                "variable.other",
                "source.go variable.other",
                "source.swift variable.other"
            ],
            "settings": { "foreground": "#000000" }
        },
        {
            "scope": [
                "meta.annotation",
                "storage.type.annotation",
                "entity.name.type.annotation",
                "punctuation.definition.annotation"
            ],
            "settings": { "foreground": "#9E880D" }
        },
        {
            "scope": ["string.regexp", "constant.regexp", "source.regexp"],
            "settings": { "foreground": "#264EFF" }
        },
        {
            "scope": [
                "keyword.operator.regexp",
                "constant.other.character-class.regexp"
            ],
            "settings": { "foreground": "#264EFF" }
        },
        {
            "scope": [
                "entity.name.tag",
                "entity.name.tag.html",
                "entity.name.tag.xml",
                "punctuation.definition.tag"
            ],
            "settings": { "foreground": "#0033B3" }
        },
        {
            "scope": [
                "entity.name.tag.custom",
                "support.class.component",
                "support.class.component.jsx",
                "support.class.component.tsx"
            ],
            "settings": { "foreground": "#007C7C" }
        },
        {
            "scope": [
                "entity.other.attribute-name",
                "entity.other.attribute-name.html",
                "entity.other.attribute-name.xml"
            ],
            "settings": { "foreground": "#080808" }
        },
        {
            "scope": [
                "constant.character.entity",
                "constant.character.entity.xml",
                "constant.character.entity.html"
            ],
            "settings": { "foreground": "#00627A" }
        },
        {
            "scope": ["support.type.property-name.css"],
            "settings": { "foreground": "#871094" }
        },
        {
            "scope": [
                "support.constant.property-value.css",
                "constant.other.color.rgb-value.css"
            ],
            "settings": { "foreground": "#00627A" }
        },
        {
            "scope": ["keyword.other.important.css"],
            "settings": { "foreground": "#0033B3" }
        },
        {
            "scope": [
                "variable.css",
                "variable.scss",
                "variable.sass",
                "variable.less"
            ],
            "settings": { "foreground": "#871094" }
        },
        {
            "scope": [
                "markup.underline.link",
                "string.other.link",
                "meta.link.inline.markdown"
            ],
            "settings": { "foreground": "#00627A" }
        },
        {
            "scope": ["markup.bold"],
            "settings": { "foreground": "#080808", "fontStyle": "bold" }
        },
        {
            "scope": ["markup.italic"],
            "settings": { "foreground": "#080808", "fontStyle": "italic" }
        },
        {
            "scope": ["markup.heading"],
            "settings": { "foreground": "#0033B3", "fontStyle": "bold" }
        },
        {
            "scope": ["markup.quote"],
            "settings": { "foreground": "#8C8C8C", "fontStyle": "italic" }
        },
        {
            "scope": ["markup.inline.raw", "markup.fenced_code.block"],
            "settings": { "foreground": "#000000" }
        },
        {
            "scope": [
                "support.type.property-name.json",
                "meta.structure.dictionary.key.json string"
            ],
            "settings": { "foreground": "#871094" }
        },
        {
            "scope": [
                "entity.name.section.properties",
                "support.type.property-name.properties"
            ],
            "settings": { "foreground": "#083080" }
        },
        {
            "scope": [
                "keyword.control.directive.velocity",
                "keyword.control.directive"
            ],
            "settings": { "foreground": "#0033B3" }
        },
        {
            "scope": ["entity.name.label", "constant.other.label"],
            "settings": { "foreground": "#9E880D", "fontStyle": "underline" }
        },
        {
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#F50000" }
        },
        {
            "scope": ["invalid.deprecated", "markup.strikethrough"],
            "settings": {
                "foreground": "#818594",
                "fontStyle": "strikethrough"
            }
        }
    ],
    "semanticTokenColors": {
        "comment": { "foreground": "#8C8C8C", "italic": true },
        "*.documentation": { "foreground": "#8C8C8C", "italic": true },
        "keyword": "#0033B3",
        "string": "#067D17",
        "number": "#1750EB",
        "regexp": "#264EFF",
        "operator": "#080808",
        "namespace": "#080808",
        "type": "#080808",
        "class": "#080808",
        "enum": "#080808",
        "interface": "#080808",
        "struct": "#080808",
        "typeParameter": "#007E8A",
        "function": "#00627A",
        "method": "#00627A",
        "macro": "#9E880D",
        "variable": "#080808",
        "parameter": "#080808",
        "property": "#871094",
        "enumMember": { "foreground": "#871094", "italic": true },
        "*.readonly": { "foreground": "#871094", "italic": true },
        "*.static": { "foreground": "#871094", "italic": true },
        "method.static": { "foreground": "#00627A", "italic": true },
        "function.static": { "foreground": "#00627A", "italic": true },
        "property.static": { "foreground": "#871094", "italic": true },
        "variable.static": { "foreground": "#871094", "italic": true },
        "*.deprecated": { "foreground": "#818594", "strikethrough": true },
        "*.modification": { "foreground": "#080808", "underline": true }
    },
    "$schema": "vscode://schemas/color-theme"
}
