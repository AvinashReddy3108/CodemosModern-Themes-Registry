        "list.filterMatchBackground": "#0e111b20",
        "list.inactiveSelectionBackground": "#23283840",
        "list.hoverForeground": "#d8dfe4",
        "statusBarItem.hoverBackground": "#232838"
    },
    "tokenColors": [
        {
            "scope": ["constant.language.boolean"],
            "settings": { "foreground": "#d29922" }
        },
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#798093", "fontStyle": "italic" }
        },
        {
            "scope": ["string", "string.quoted"],
            "settings": { "foreground": "#29c3a0" }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.language",
                "constant.character"
            ],
            "settings": { "foreground": "#d29922" }
        },
        {
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#26acf4" }
        },
        {
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#26acf4" }
        },
        {
            "scope": ["entity.name.type", "entity.name.class", "support.class"],
            "settings": { "foreground": "#26acf4" }
        },
        {
            "scope": ["variable", "variable.parameter", "variable.other"],
            "settings": { "foreground": "#d8dfe4" }
        },
        {
            "scope": ["entity.name.tag", "punctuation.definition.tag"],
            "settings": { "foreground": "#26acf4" }
        },
        {
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#d29922" }
        },
        {
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#ff1648" }
        },
        { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
        { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
        {
            "scope": ["markup.heading"],
            "settings": { "foreground": "#26acf4", "fontStyle": "bold" }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "macro": "#26acf4",
        "label": "#26acf4",
        "namespace": "#26acf4",
        "variable.defaultLibrary": "#26acf4",
        "function.defaultLibrary": "#26acf4",
        "interface": "#26acf4",
        "regexp": "#26acf4",
        "keyword": { "foreground": "#b369dd", "fontStyle": "bold" },
        "variable": "#fafafa",
        "variable.readonly": "#d29922",
        "parameter": "#d29922",
        "type": "#d29922",
        "enum": "#d29922",
        "enumMember": "#29c3a0",
        "property": "#fafafa",
        "property.readonly": "#d29922",
        "string": "#29c3a0",
        "number": "#d29922",
        "operator": "#fafafa",
        "decorator": "#d29922",
        "typeParameter": "#d29922",
        "*.declaration": "#fbfbfb",
        "*.definition": "#fbfbfb",
        "*.modification": "#d29922",
        "*.async": { "fontStyle": "italic" },
        "*.static": { "fontStyle": "italic" },
        "*.abstract": { "fontStyle": "italic" },
        "comment": { "foreground": "#71717a", "fontStyle": "italic" },
        "function": { "foreground": "#29c3a0", "fontStyle": "bold" },
        "method": { "foreground": "#29c3a0", "fontStyle": "bold" },
        "class": { "foreground": "#d29922", "fontStyle": "bold" }
    },
    "$schema": "vscode://schemas/color-theme"
}
