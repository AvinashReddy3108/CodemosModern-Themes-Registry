    "tokenColors": [
        {
            "scope": ["constant.language.boolean"],
            "settings": { "foreground": "#d29922" }
        },
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#b4b4b4", "fontStyle": "italic" }
        },
        {
            "scope": ["string", "string.quoted"],
            "settings": { "foreground": "#29c3a0" }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.language",
                "constant.character"
            ],
            "settings": { "foreground": "#d29922" }
        },
        {
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#fcdfc2" }
        },
        {
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#fcdfc2" }
        },
        {
            "scope": ["entity.name.type", "entity.name.class", "support.class"],
            "settings": { "foreground": "#fcdfc2" }
        },
        {
            "scope": ["variable", "variable.parameter", "variable.other"],
            "settings": { "foreground": "#eeeeee" }
        },
        {
            "scope": ["entity.name.tag", "punctuation.definition.tag"],
            "settings": { "foreground": "#fcdfc2" }
        },
        {
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#d29922" }
        },
        {
            "scope": ["punctuation", "meta.brace"],
            "settings": { "foreground": "#b4b4b4" }
        },
        {
            "scope": ["operator", "keyword.operator"],
            "settings": { "foreground": "#fcdfc2" }
        },
        {
            "scope": ["invalid", "invalid.illegal"],
            "settings": {
                "foreground": "#e55031",
                "fontStyle": "bold underline"
            }
        },
        {
            "scope": ["markup.bold"],
            "settings": { "fontStyle": "bold", "foreground": "#fcdfc2" }
        },
        {
            "scope": ["markup.italic"],
            "settings": { "fontStyle": "italic", "foreground": "#d29922" }
        },
        {
            "scope": ["markup.heading"],
            "settings": { "foreground": "#fcdfc2", "fontStyle": "bold" }
        },
        {
            "scope": ["markup.underline.link"],
            "settings": { "foreground": "#29c3a0", "fontStyle": "underline" }
        },
        {
            "scope": ["meta.import", "meta.export"],
            "settings": { "foreground": "#29c3a0" }
        },
        {
            "scope": ["support.type.property-name"],
            "settings": { "foreground": "#d29922" }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "macro": "#fcdfc2",
        "label": "#fcdfc2",
        "namespace": "#fcdfc2",
        "variable.defaultLibrary": "#fcdfc2",
        "function.defaultLibrary": "#fcdfc2",
        "interface": "#fcdfc2",
        "regexp": "#fcdfc2",
        "keyword": { "foreground": "#fcdfc2", "fontStyle": "bold" },
        "variable": "#fafafa",
        "variable.readonly": "#d29922",
        "parameter": "#d29922",
        "type": "#d29922",
        "enum": "#d29922",
        "enumMember": "#29c3a0",
        "property": "#fafafa",
        "property.readonly": "#d29922",
        "string": "#29c3a0",
        "number": "#d29922",
        "operator": "#fafafa",
        "decorator": "#d29922",
        "typeParameter": "#d29922",
        "*.declaration": "#fbfbfb",
        "*.definition": "#fbfbfb",
        "*.modification": "#d29922",
        "*.async": { "fontStyle": "italic" },
        "*.static": { "fontStyle": "italic" },
        "*.abstract": { "fontStyle": "italic" },
        "comment": { "foreground": "#71717a", "fontStyle": "italic" },
        "function": { "foreground": "#29c3a0", "fontStyle": "bold" },
        "method": { "foreground": "#29c3a0", "fontStyle": "bold" },
        "class": { "foreground": "#d29922", "fontStyle": "bold" }
    },
    "$schema": "vscode://schemas/color-theme"
}
