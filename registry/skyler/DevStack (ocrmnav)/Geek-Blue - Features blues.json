{
    "name": "Geek-Blue",
    "type": "dark",
    "colors": {},
    "tokenColors": [
        {
            "scope": ["constant.language.boolean"],
            "settings": { "foreground": "#d29922" }
        },
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#a3a3a3", "fontStyle": "italic" }
        },
        {
            "scope": ["string", "string.quoted"],
            "settings": { "foreground": "#29c3a0" }
        },
        { "scope": ["string.regexp"], "settings": { "foreground": "#fafafa" } },
        {
            "scope": [
                "constant.numeric",
                "constant.language",
                "constant.character"
            ],
            "settings": { "foreground": "#d29922" }
        },
        {
            "scope": ["constant.other"],
            "settings": { "foreground": "#fafafa" }
        },
        {
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#fafafa", "fontStyle": "bold" }
        },
        {
            "scope": ["keyword.control", "keyword.operator.new"],
            "settings": { "foreground": "#fafafa", "fontStyle": "bold" }
        },
        {
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#fafafa" }
        },
        {
            "scope": ["variable", "variable.other"],
            "settings": { "foreground": "#fafafa" }
        },
        {
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#d29922" }
        },
        {
            "scope": ["variable.language"],
            "settings": { "foreground": "#fafafa", "fontStyle": "italic" }
        },
        {
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#29c3a0", "fontStyle": "bold" }
        },
        {
            "scope": ["entity.name.type", "entity.name.class", "support.class"],
            "settings": { "foreground": "#d29922", "fontStyle": "bold" }
        },
        {
            "scope": ["entity.other.inherited-class"],
            "settings": { "foreground": "#29c3a0", "fontStyle": "italic" }
        },
        {
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#fafafa" }
        },
        {
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#29c3a0" }
        },
        {
            "scope": ["support.type.property-name"],
            "settings": { "foreground": "#fafafa" }
        },
        {
            "scope": ["meta.property-name"],
            "settings": { "foreground": "#fafafa" }
        },
        {
            "scope": ["meta.object-literal.key"],
            "settings": { "foreground": "#fafafa" }
        },
        { "scope": ["punctuation"], "settings": { "foreground": "#a3a3a3" } },
        {
            "scope": ["punctuation.definition.template-expression"],
            "settings": { "foreground": "#fafafa" }
        },
        {
            "scope": ["invalid"],
            "settings": { "foreground": "#7f1d1d", "fontStyle": "bold" }
        },
        {
            "scope": ["markup.heading"],
            "settings": { "foreground": "#fafafa", "fontStyle": "bold" }
        },
        {
            "scope": ["markup.bold"],
            "settings": { "foreground": "#d29922", "fontStyle": "bold" }
        },
        {
            "scope": ["markup.italic"],
            "settings": { "foreground": "#fafafa", "fontStyle": "italic" }
        },
        {
            "scope": ["markup.inserted"],
            "settings": { "foreground": "#29c3a0" }
        },
        {
            "scope": ["markup.deleted"],
            "settings": { "foreground": "#7f1d1d" }
        },
        {
            "scope": ["markup.changed"],
            "settings": { "foreground": "#d29922" }
        },
        {
            "scope": ["markup.inline.raw"],
            "settings": { "foreground": "#29c3a0" }
        },
        { "scope": ["meta.selector"], "settings": { "foreground": "#fafafa" } },
        {
            "scope": ["entity.name.tag.css"],
            "settings": { "foreground": "#d29922" }
        },
        {
            "scope": ["entity.other.attribute-name.class.css"],
            "settings": { "foreground": "#29c3a0" }
        },
        {
            "scope": ["entity.other.attribute-name.id.css"],
            "settings": { "foreground": "#fafafa" }
        },
        {
            "scope": ["support.type.property-name.css"],
            "settings": { "foreground": "#fafafa" }
        },
        {
            "scope": ["support.constant.property-value.css"],
            "settings": { "foreground": "#29c3a0" }
        },
        {
            "scope": ["support.type.vendored.property-name.css"],
            "settings": { "foreground": "#a3a3a3" }
        },
        {
            "scope": ["source.css.scss entity.name.tag"],
            "settings": { "foreground": "#d29922" }
        },
        {
            "scope": ["meta.decorator"],
            "settings": { "foreground": "#d29922" }
        },
        {
            "scope": ["entity.name.function.decorator"],
            "settings": { "foreground": "#d29922" }
        },
        {
            "scope": ["storage.type.function.python"],
            "settings": { "foreground": "#fafafa" }
        },
        {
            "scope": ["storage.type.class.python"],
            "settings": { "foreground": "#fafafa" }
        },
        {
            "scope": ["support.type.python"],
            "settings": { "foreground": "#d29922" }
        },
        {
            "scope": ["meta.function-call.generic.python"],
            "settings": { "foreground": "#29c3a0" }
        },
        {
            "scope": ["punctuation.definition.tag"],
            "settings": { "foreground": "#fafafa" }
        },
        { "scope": ["meta.tag"], "settings": { "foreground": "#fafafa" } },
        {
            "scope": ["support.constant.json"],
            "settings": { "foreground": "#d29922" }
        },
        {
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#29c3a0" }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "macro": "#fafafa",
        "label": "#fafafa",
        "variable.defaultLibrary": "#fafafa",
        "interface": "#fafafa",
        "function.defaultLibrary": "#fafafa",
        "namespace": "#fafafa",
        "keyword": { "foreground": "#fafafa", "fontStyle": "bold" },
        "variable": "#fafafa",
        "variable.readonly": "#d29922",
        "parameter": "#d29922",
        "type": "#d29922",
        "enum": "#d29922",
        "enumMember": "#29c3a0",
        "property": "#fafafa",
        "property.readonly": "#d29922",
        "string": "#29c3a0",
        "number": "#d29922",
        "regexp": "#fafafa",
        "operator": "#fafafa",
        "decorator": "#d29922",
        "typeParameter": "#d29922",
        "*.declaration": "#fbfbfb",
        "*.definition": "#fbfbfb",
        "*.modification": "#d29922",
        "*.async": { "fontStyle": "italic" },
        "*.static": { "fontStyle": "italic" },
        "*.abstract": { "fontStyle": "italic" },
        "function": { "foreground": "#29c3a0", "fontStyle": "bold" },
        "method": { "foreground": "#29c3a0", "fontStyle": "bold" },
        "comment": { "foreground": "#a3a3a3", "fontStyle": "italic" },
        "class": { "foreground": "#d29922", "fontStyle": "bold" }
    },
    "$schema": "vscode://schemas/color-theme"
}
