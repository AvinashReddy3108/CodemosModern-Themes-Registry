        "list.filterMatchBackground": "#1b1b1b20",
        "list.inactiveSelectionBackground": "#33333340",
        "list.hoverForeground": "#f2f5fc",
        "statusBarItem.hoverBackground": "#333333"
    },
    "tokenColors": [
        {
            "scope": ["constant.language.boolean"],
            "settings": { "foreground": "#d29922" }
        },
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#cecece", "fontStyle": "italic" }
        },
        {
            "scope": ["string", "string.quoted"],
            "settings": { "foreground": "#29c3a0" }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.language",
                "constant.character"
            ],
            "settings": { "foreground": "#d29922" }
        },
        {
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#ff96cb" }
        },
        {
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#9acdff" }
        },
        {
            "scope": ["entity.name.type", "entity.name.class", "support.class"],
            "settings": { "foreground": "#cc9aff" }
        },
        {
            "scope": ["variable", "variable.parameter", "variable.other"],
            "settings": { "foreground": "#f2f5fc" }
        },
        {
            "scope": ["entity.name.tag", "punctuation.definition.tag"],
            "settings": { "foreground": "#ff96cb" }
        },
        {
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#9acdff" }
        },
        {
            "scope": ["punctuation", "meta.brace"],
            "settings": { "foreground": "#cecece" }
        },
        {
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#ff6364" }
        },
        {
            "scope": ["markup.bold"],
            "settings": { "fontStyle": "bold", "foreground": "#ff96cb" }
        },
        { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
        {
            "scope": ["markup.heading"],
            "settings": { "foreground": "#ff96cb", "fontStyle": "bold" }
        },
        {
            "scope": ["markup.underline.link"],
            "settings": { "foreground": "#9acdff" }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "macro": "#ff96cb",
        "label": "#ff96cb",
        "namespace": "ff96cb",
        "variable.defaultLibrary": "#ff96cb",
        "function.defaultLibrary": "#ff96cb",
        "interface": "#ff96cb",
        "regexp": "#ff96cb",
        "keyword": { "foreground": "#ff96cb", "fontStyle": "bold" },
        "variable": "#fafafa",
        "variable.readonly": "#d29922",
        "parameter": "#d29922",
        "type": "#d29922",
        "enum": "#d29922",
        "enumMember": "#29c3a0",
        "property": "#fafafa",
        "property.readonly": "#d29922",
        "string": "#29c3a0",
        "number": "#d29922",
        "operator": "#fafafa",
        "decorator": "#d29922",
        "typeParameter": "#d29922",
        "*.declaration": "#fbfbfb",
        "*.definition": "#fbfbfb",
        "*.modification": "#d29922",
        "*.async": { "fontStyle": "italic" },
        "*.static": { "fontStyle": "italic" },
        "*.abstract": { "fontStyle": "italic" },
        "comment": { "foreground": "#71717a", "fontStyle": "italic" },
        "function": { "foreground": "#29c3a0", "fontStyle": "bold" },
        "method": { "foreground": "#29c3a0", "fontStyle": "bold" },
        "class": { "foreground": "#d29922", "fontStyle": "bold" }
    },
    "$schema": "vscode://schemas/color-theme"
}
