    "tokenColors": [
        {
            "scope": ["constant.language.boolean"],
            "settings": { "foreground": "#d29922" }
        },
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#9ba2ae", "fontStyle": "italic" }
        },
        {
            "scope": ["string", "string.quoted"],
            "settings": { "foreground": "#29c3a0" }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.language",
                "constant.character"
            ],
            "settings": { "foreground": "#d29922" }
        },
        {
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#818cf9" }
        },
        {
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#818cf9" }
        },
        {
            "scope": ["entity.name.type", "entity.name.class", "support.class"],
            "settings": { "foreground": "#818cf9" }
        },
        {
            "scope": ["variable", "variable.parameter", "variable.other"],
            "settings": { "foreground": "#e4e8ef" }
        },
        {
            "scope": ["entity.name.tag", "punctuation.definition.tag"],
            "settings": { "foreground": "#818cf9" }
        },
        {
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#29c3a0" }
        },
        {
            "scope": ["punctuation", "meta.brace"],
            "settings": { "foreground": "#9ba2ae" }
        },
        {
            "scope": ["operator", "keyword.operator"],
            "settings": { "foreground": "#818cf9" }
        },
        {
            "scope": ["invalid", "invalid.illegal"],
            "settings": {
                "foreground": "#f14444",
                "fontStyle": "bold underline"
            }
        },
        {
            "scope": ["markup.bold"],
            "settings": { "fontStyle": "bold", "foreground": "#818cf9" }
        },
        { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
        {
            "scope": ["markup.heading"],
            "settings": { "foreground": "#818cf9", "fontStyle": "bold" }
        },
        {
            "scope": ["markup.underline.link"],
            "settings": { "foreground": "#29c3a0", "fontStyle": "underline" }
        },
        {
            "scope": ["meta.import", "meta.export"],
            "settings": { "foreground": "#29c3a0" }
        },
        {
            "scope": ["support.type.property-name"],
            "settings": { "foreground": "#29c3a0" }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "macro": "#818cf9",
        "label": "#818cf9",
        "namespace": "#818cf9",
        "variable.defaultLibrary": "#818cf9",
        "function.defaultLibrary": "#818cf9",
        "interface": "#818cf9",
        "regexp": "#818cf9",
        "keyword": { "foreground": "#818cf9", "fontStyle": "bold" },
        "variable": "#fafafa",
        "variable.readonly": "#d29922",
        "parameter": "#d29922",
        "type": "#d29922",
        "enum": "#d29922",
        "enumMember": "#29c3a0",
        "property": "#fafafa",
        "property.readonly": "#d29922",
        "string": "#29c3a0",
        "number": "#d29922",
        "operator": "#fafafa",
        "decorator": "#d29922",
        "typeParameter": "#d29922",
        "*.declaration": "#fbfbfb",
        "*.definition": "#fbfbfb",
        "*.modification": "#d29922",
        "*.async": { "fontStyle": "italic" },
        "*.static": { "fontStyle": "italic" },
        "*.abstract": { "fontStyle": "italic" },
        "comment": { "foreground": "#71717a", "fontStyle": "italic" },
        "function": { "foreground": "#29c3a0", "fontStyle": "bold" },
        "method": { "foreground": "#29c3a0", "fontStyle": "bold" },
        "class": { "foreground": "#d29922", "fontStyle": "bold" }
    },
    "$schema": "vscode://schemas/color-theme"
}
