        "variable.defaultLibrary": "#4FC1FF",
        "function": "#DCDCAA",
        "method": "#DCDCAA",
        "member": "#9CDCFE",
        "keyword": "#C586C0",
        "comment": "#6A9955",
        "string": "#CE9178",
        "number": "#B5CEA8",
        "operator": "#D4D4D4",
