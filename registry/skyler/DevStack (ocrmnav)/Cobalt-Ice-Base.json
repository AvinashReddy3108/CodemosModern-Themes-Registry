        "macro": "#BD63C5",
        "modifier": "#C586C0",
        "regexp": "#D16969",
        "label": "#D4D4D4"
    },
    "tokenColors": [
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#6A9955" }
        },
        {
            "scope": [
                "string",
                "punctuation.definition.string",
                "string.template",
                "punctuation.definition.template-expression"
            ],
            "settings": { "foreground": "#CE9178" }
        },
        {
            "scope": "constant.numeric",
            "settings": { "foreground": "#B5CEA8" }
        },
        {
            "scope": "constant.language",
            "settings": { "foreground": "#4FC1FF" }
        },
        { "scope": "variable", "settings": { "foreground": "#9CDCFE" } },
        {
            "scope": "variable.parameter",
            "settings": { "foreground": "#9CDCFE" }
        },
        {
            "scope": "variable.other.object.property",
            "settings": { "foreground": "#9CDCFE" }
        },
        {
            "scope": "variable.other.readwrite",
            "settings": { "foreground": "#9CDCFE" }
        },
        {
            "scope": "variable.other.property",
            "settings": { "foreground": "#9CDCFE" }
        },
        {
            "scope": "support.type.property-name",
            "settings": { "foreground": "#9CDCFE" }
        },
        {
            "scope": "support.constant",
            "settings": { "foreground": "#4FC1FF" }
        },
        { "scope": "support.class", "settings": { "foreground": "#34d399" } },
        { "scope": "support.type", "settings": { "foreground": "#34d399" } },
        {
            "scope": "support.function",
            "settings": { "foreground": "#DCDCAA" }
        },
        {
            "scope": "entity.name.function",
            "settings": { "foreground": "#DCDCAA" }
        },
        {
            "scope": "entity.name.type",
            "settings": { "foreground": "#34d399" }
        },
        {
            "scope": "entity.name.class",
            "settings": { "foreground": "#34d399" }
        },
        { "scope": "entity.name.tag", "settings": { "foreground": "#569CD6" } },
        {
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#9CDCFE" }
        },
        { "scope": "keyword", "settings": { "foreground": "#C586C0" } },
        { "scope": "keyword.control", "settings": { "foreground": "#C586C0" } },
        {
            "scope": "keyword.operator",
            "settings": { "foreground": "#D4D4D4" }
        },
        { "scope": "storage", "settings": { "foreground": "#C586C0" } },
        { "scope": "storage.type", "settings": { "foreground": "#C586C0" } },
        {
            "scope": "storage.modifier",
            "settings": { "foreground": "#C586C0" }
        },
        {
            "scope": "punctuation.definition.tag",
            "settings": { "foreground": "#808080" }
        },
        {
            "scope": "string.quoted.triple",
            "settings": { "foreground": "#CE9178" }
        },
        { "scope": "invalid", "settings": { "foreground": "#F44747" } },
        {
            "scope": "markup.heading",
            "settings": { "foreground": "#569CD6", "fontStyle": "bold" }
        },
        {
            "scope": "markup.heading.markdown",
            "settings": { "foreground": "#569CD6" }
        },
        {
            "scope": "markup.heading.1.markdown",
            "settings": { "foreground": "#569CD6" }
        },
        {
            "scope": "markup.heading.2.markdown",
            "settings": { "foreground": "#4EC9B0" }
        },
        {
            "scope": "markup.heading.3.markdown",
            "settings": { "foreground": "#4FC1FF" }
        },
        {
            "scope": "markup.heading.4.markdown",
            "settings": { "foreground": "#9CDCFE" }
        },
        {
            "scope": "markup.heading.5.markdown",
            "settings": { "foreground": "#C586C0" }
        },
        {
            "scope": "markup.heading.6.markdown",
            "settings": { "foreground": "#DCDCAA" }
        },
        {
            "scope": "markup.bold",
            "settings": { "fontStyle": "bold", "foreground": "#D4D4D4" }
        },
        {
            "scope": "markup.italic",
            "settings": { "fontStyle": "italic", "foreground": "#D4D4D4" }
        },
        {
            "scope": "markup.strikethrough",
            "settings": { "foreground": "#808080" }
        },
        {
            "scope": "markup.inline.raw",
            "settings": { "foreground": "#CE9178" }
        },
        {
            "scope": "markup.fenced_code.block",
            "settings": { "foreground": "#CE9178" }
        },
        {
            "scope": "markup.quote",
            "settings": { "foreground": "#6A9955", "fontStyle": "italic" }
        },
        { "scope": "markup.list", "settings": { "foreground": "#9CDCFE" } },
        {
            "scope": "markup.list.numbered",
            "settings": { "foreground": "#9CDCFE" }
        },
        {
            "scope": "markup.list.unordered",
            "settings": { "foreground": "#9CDCFE" }
        },
        {
            "scope": "meta.separator.markdown",
            "settings": { "foreground": "#808080" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
