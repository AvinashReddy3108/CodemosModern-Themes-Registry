{
    "$schema": "vscode://schemas/color-theme",
    "name": "FullstacksJS",
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "type": { "foreground": "#4fd9ff" },
        "type.terraform-provider": { "foreground": "#ff7272" },
        "hcl-blockType": { "foreground": "#ff7272" },
        "typeParameter": { "foreground": "#4fd9ff" },
        "namespace": { "foreground": "#14FFDE" },
        "enum": { "foreground": "#14FFDE" },
        "enumMember": { "foreground": "#ffffff" },
        "interface": { "foreground": "#4fd9ff" },
        "annotation": { "foreground": "#ffd257" },
        "variable": { "foreground": "#ffffff" },
        "field": { "foreground": "#ffd257" }
    },
    "tokenColors": [
        {
            "name": "Punctuation",
            "scope": [
                "storage.type.function.arrow",
                "keyword.operator",
                "meta.brace",
                "punctuation.accessor",
                "punctuation.separator.comma"
            ],
            "settings": { "foreground": "#ffffff" }
        },
        {
            "name": "Comment",
            "scope": "comment.line, comment.block, punctuation.definition.comment",
            "settings": { "foreground": "#ffffff4d", "fontStyle": "italic" }
        },
        {
            "name": "Keyword",
            "scope": "keyword, storage.type, storage.modifier, variable.language.this, variable.language.super",
            "settings": { "foreground": "#ff7272" }
        },
        {
            "name": "String",
            "scope": "string",
            "settings": { "foreground": "#c6ff90" }
        },
        {
            "name": "Decorator",
            "scope": [
                "entity.name.function.decorator",
                "meta.function.decorator"
            ],
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "TypeScript Values",
            "scope": ["constant.language", "storage.type.numeric.bigint"],
            "settings": { "foreground": "#c5b5ff" }
        },
        {
            "name": "Variable",
            "scope": "meta.definition.property",
            "settings": { "foreground": "#ffffff" }
        },
        {
            "name": "Type Operator",
            "scope": "keyword.operator.type",
            "settings": { "foreground": "#ffffff" }
        },
        {
            "name": "Type",
            "scope": "entity.name.type",
            "settings": { "foreground": "#4fd9ff" }
        },
        {
            "name": "Primitive Type",
            "scope": "support.type.primitive, support.type.builtin",
            "settings": { "foreground": "#14FFDE" }
        },
        {
            "name": "Function Call",
            "scope": "meta.function-call",
            "settings": { "foreground": "#ffa478" }
        },
        {
            "name": "Class",
            "scope": "support.class",
            "settings": { "foreground": "#ff7272" }
        },
        {
            "name": "Tag",
            "scope": "entity.name.tag, keyword.other.doctype",
            "settings": { "foreground": "#ff7272" }
        },
        {
            "name": "Tag Attributes",
            "scope": "meta.tag.attributes",
            "settings": { "foreground": "#ffffff" }
        },
        {
            "name": "C++ Keywords",
            "scope": "entity.name.function.definition.special.constructor.cpp",
            "settings": { "foreground": "#ff7272" }
        },
        {
            "name": "C++ Type",
            "scope": "storage.type.template.argument.T.cpp",
            "settings": { "foreground": "#4fd9ff" }
        },
        {
            "name": "C++ Label",
            "scope": "entity.name.label.cpp",
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "C++ Include",
            "scope": "string.quoted.other.lt-gt.include.cpp",
            "settings": { "foreground": "#4fd9ff" }
        },
        {
            "name": "C++ Punctuation",
            "scope": "support.other.attribute.cpp",
            "settings": { "foreground": "#c5b5ff" }
        },
        {
            "name": "C++ Function Call",
            "scope": [
                "entity.name.function.call.cpp",
                "entity.name.function.preprocessor.cpp"
            ],
            "settings": { "foreground": "#ffa478" }
        },
        {
            "name": "C++ Scope Resolution",
            "scope": [
                "entity.name.scope-resolution.cpp",
                "entity.name.scope-resolution.function.call.cpp"
            ],
            "settings": { "foreground": "#14FFDE" }
        },
        {
            "name": "CSS Value",
            "scope": "meta.property-value.css, support.constant.property-value.css, support.constant.color.current.css",
            "settings": { "foreground": "#4fd9ff" }
        },
        {
            "name": "Primitive Values",
            "scope": "keyword.other.unit, constant.numeric.css, constant.other.color.rgb-value.hex.css",
            "settings": { "foreground": "#ffffff" }
        },
        {
            "name": "CSS Function",
            "scope": "support.function.misc.css, meta.function.misc.css, support.function.transform.css",
            "settings": { "foreground": "#ffa478" }
        },
        {
            "name": "CSS Variable",
            "scope": "variable.argument.css",
            "settings": { "foreground": "#14FFDE" }
        },
        {
            "name": "CSS Pseudo Class",
            "scope": "entity.other.attribute-name.pseudo-class.css",
            "settings": { "foreground": "#ffa478" }
        },
        {
            "name": "CSS Property Name",
            "scope": "meta.property-name.css, entity.name.tag.custom.css",
            "settings": { "foreground": "#ffffff" }
        },
        {
            "name": "CSS Punctuation",
            "scope": "punctuation.definition.entity.begin.bracket.square.css, punctuation.definition.entity.end.bracket.square.css, punctuation.section.function.begin.bracket.round.css, punctuation.section.function.end.bracket.round.css, punctuation.separator.list.comma.css",
            "settings": { "foreground": "#ffffff" }
        },
        {
            "name": "CSS Attribute",
            "scope": "entity.other.attribute-name.css",
            "settings": { "foreground": "#ffffff" }
        },
        {
            "name": "CSS Selector",
            "scope": "entity.other.attribute-name.id.css, entity.name.tag.css, entity.other.attribute-name.class.css, entity.other.keyframe-offset.css",
            "settings": { "foreground": "#ff7272", "fontStyle": "bold" }
        },
        {
            "name": "CSS Pseudo Element",
            "scope": "entity.other.attribute-name.pseudo-element.css",
            "settings": { "foreground": "#ffd257", "fontStyle": "bold" }
        },
        {
            "name": "CSS At Rule",
            "scope": "meta.at-rule.body.css, meta.at-rule.header.css",
            "settings": { "foreground": "#ffffff" }
        },
        {
            "name": "CSS At Rule",
            "scope": ["keyword.control.at-rule.css", "keyword.control.at-rule"],
            "settings": { "foreground": "#ff7272", "fontStyle": "bold" }
        },
        {
            "name": "Java Punctuation",
            "scope": [
                "punctuation.separator.delimiter.java",
                "keyword.control.ternary.java"
            ],
            "settings": { "foreground": "#ffffff" }
        },
        {
            "name": "Java Types",
            "scope": ["storage.type.java", "storage.type.generic.java"],
            "settings": { "foreground": "#4fd9ff" }
        },
        {
            "name": "Java Primitive",
            "scope": "storage.type.primitive.java",
            "settings": { "foreground": "#c5b5ff" }
        },
        {
            "name": "Java Values",
            "scope": [
                "constant.numeric.decimal.java",
                "storage.modifier.import.java",
                "storage.modifier.package.java",
                "meta.function-call.java"
            ],
            "settings": { "foreground": "#ffffff" }
        },
        {
            "name": "Java Enums",
            "scope": ["constant.other.enum.java", "entity.name.type.enum.java"],
            "settings": { "foreground": "#14FFDE" }
        },
        {
            "name": "JSON String",
            "scope": "string.json, punctuation.support.type.property-name.end.json.comments",
            "settings": { "foreground": "#ffa478" }
        },
        {
            "name": "JSON Constant",
            "scope": "constant.language.json",
            "settings": { "foreground": "#c5b5ff", "fontStyle": "bold" }
        },
        {
            "name": "Python Number",
            "scope": ["storage.type.number.python"],
            "settings": { "foreground": "#ffffff" }
        },
        {
            "name": "Python Self",
            "scope": [
                "variable.parameter.function.language.special.self.python"
            ],
            "settings": { "foreground": "#ffd257", "fontStyle": "bold" }
        },
        {
            "name": "Python Punctuation",
            "scope": [
                "punctuation.definition.arguments.begin",
                "punctuation.definition.arguments.end",
                "punctuation.separator.arguments"
            ],
            "settings": { "foreground": "#ffffff" }
        },
        {
            "name": "Python Variable",
            "scope": ["meta.function-call.arguments.python"],
            "settings": { "foreground": "#ffffff" }
        },
        {
            "name": "Python Magic",
            "scope": ["support.function.magic.python"],
            "settings": { "foreground": "#c5b5ff", "fontStyle": "bold" }
        },
        {
            "name": "Python String Operator",
            "scope": ["storage.type.string.python"],
            "settings": { "foreground": "#c5b5ff" }
        },
        {
            "name": "Regex",
            "scope": "string.regexp",
            "settings": { "foreground": "#ffd257", "fontStyle": "bold" }
        },
        {
            "name": "Regex Groups",
            "scope": "punctuation.definition.group.regexp, punctuation.definition.character-class.regexp",
            "settings": { "foreground": "#ff7272" }
        },
        {
            "name": "Regex Operators",
            "scope": "constant.other.character-class.regexp, keyword.operator.quantifier.regexp,keyword.operator.or.regexp, punctuation.definition.group.assertion.regexp",
            "settings": { "foreground": "#c5b5ff", "fontStyle": "bold" }
        },
        {
            "name": "Rust Keywords",
            "scope": "entity.name.function.macro.rules.rust",
            "settings": { "foreground": "#ff7272" }
        },
        {
            "name": "Rust Namespace",
            "scope": "entity.name.namespace.rust",
            "settings": { "foreground": "#14FFDE" }
        },
        {
            "name": "Rust Number",
            "scope": "constant.numeric.decimal.rust",
            "settings": { "foreground": "#ffffff" }
        },
        {
            "name": "Rust Punctuation",
            "scope": [
                "punctuation.brackets.attribute.rust",
                "punctuation.brackets.round.rust",
                "punctuation.comma.rust",
                "variable.other.rust"
            ],
            "settings": { "foreground": "#ffffff" }
        },
        {
            "name": "Rust Lifetime",
            "scope": "entity.name.type.lifetime.rust",
            "settings": { "foreground": "#c5b5ff" }
        },
        {
            "name": "Rust Macro",
            "scope": ["entity.name.function.macro.rust"],
            "settings": { "foreground": "#ffd257" }
        },
        {
            "name": "Rust Function Call",
            "scope": "meta.function.call.rust",
            "settings": { "foreground": "#ffa478" }
        },
        {
            "name": "Rust Self",
            "scope": "variable.language.self.rust",
            "settings": { "foreground": "#ffd257", "fontStyle": "bold" }
        },
        {
            "name": "Rust Attribute",
            "scope": "meta.attribute.rust",
            "settings": { "foreground": "#ffa478" }
        },
        {
            "name": "Shell Keywords",
            "scope": "support.function.builtin.shell",
            "settings": { "foreground": "#ff7272" }
        },
        {
            "name": "Shell Keywords",
            "scope": "punctuation.definition.string.heredoc.delimiter.shell",
            "settings": { "foreground": "#c5b5ff", "fontStyle": "bold" }
        },
        {
            "name": "Shell Keywords",
            "scope": "entity.name.command.shell",
            "settings": { "foreground": "#ffffff", "fontStyle": "bold" }
        },
        {
            "name": "Shell Keywords",
            "scope": "constant.other.option",
            "settings": { "foreground": "#ffffff" }
        },
        {
            "name": "Terraform Keywords",
            "scope": "entity.name.type.terraform",
            "settings": { "foreground": "#ff7272" }
        },
        {
            "name": "TypeScript Punctuation",
            "scope": "constant.language.import-export-all",
            "settings": { "foreground": "#ffffff", "fontStyle": "italic" }
        },
        {
            "name": "TypeScript Number",
            "scope": "constant.numeric.decimal.tsx",
            "settings": { "foreground": "#ffffff" }
        },
        {
            "name": "Type Parameter",
            "scope": "comment.line.triple-slash.directive.ts",
            "settings": { "foreground": "#ffffff", "fontStyle": "" }
        },
        {
            "name": "TypeScript Label",
            "scope": ["meta.decorator.js", "meta.decorator.tsx"],
            "settings": { "foreground": "#ffa478" }
        },
        {
            "name": "Type Parameter",
            "scope": "entity.name.label.tsx",
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "TypeScript Keywords",
            "scope": [
                "keyword.operator.expression.keyof.tsx",
                "keyword.operator.expression.typeof.tsx",
                "keyword.operator.type.asserts.ts",
                "keyword.operator.expression.instanceof",
                "keyword.operator.new.tsx",
                "keyword.operator.new.ts"
            ],
            "settings": { "foreground": "#ff7272" }
        },
        {
            "name": "TypeScript Primitive",
            "scope": ["support.type.primitive.tsx", "support.type.builtin.tsx"],
            "settings": { "foreground": "#14FFDE" }
        },
        {
            "name": "TypeScript Variable",
            "scope": [
                "variable.other.object.property.js",
                "variable.other.object.js",
                "meta.template.expression.js",
                "variable.other.object.property.ts",
                "variable.other.object.ts",
                "meta.template.expression.ts",
                "variable.other.object.property.jsx",
                "variable.other.object.jsx",
                "meta.template.expression.jsx",
                "variable.other.object.property.tsx",
                "variable.other.object.tsx",
                "meta.template.expression.tsx"
            ],
            "settings": { "foreground": "#ffffff" }
        },
        {
            "name": "JSX Components",
            "scope": "support.class.component.tsx, support.class.component.js.jsx",
            "settings": { "foreground": "#ffa478", "fontStyle": "bold" }
        },
        {
            "name": "Embedded",
            "scope": "punctuation.section.embedded",
            "settings": { "foreground": "#ff7272" }
        },
        {
            "name": "Tags",
            "scope": "entity.name.tag.localname.xml, entity.name.tag.html, entity.name.tag.tsx",
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Key",
            "scope": "meta.map.key.yaml",
            "settings": { "foreground": "#ff7272" }
        },
        {
            "name": "String",
            "scope": "string.unquoted.plain.out.yaml",
            "settings": { "foreground": "#ffffff" }
        },
        {
            "name": "Block Scalar",
            "scope": "keyword.control.flow.block-scalar.literal.yaml, keyword.control.flow.block-scalar.folded.yaml",
            "settings": { "foreground": "#ffffff" }
        }
    ],
