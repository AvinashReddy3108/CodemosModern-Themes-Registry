{
    "name": "Cybertrauma's",
    "type": "dark",
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "enumMember": { "foreground": "#ffe300" },
        "variable.constant": { "foreground": "#ff0000" },
        "variable.defaultLibrary": { "foreground": "#ffa600" }
    },
    "tokenColors": [
        {
            "name": "Comment",
            "scope": [
                "comment",
                "string.quoted.docstring.multi.python",
                "string.quoted.docstring.multi.python punctuation.definition.string.begin.python",
                "string.quoted.docstring.multi.python punctuation.definition.string.end.python"
            ],
            "settings": { "foreground": "#108046", "fontStyle": "italic" }
        },
        {
            "name": "String",
            "scope": [
                "string.quoted",
                "string.template",
                "punctuation.definition.string"
            ],
            "settings": { "foreground": "#f77326" }
        },
        {
            "name": "Punctuation within templates",
            "scope": "string.template meta.embedded.line",
            "settings": { "foreground": "#b3aeae" }
        },
        {
            "name": "Variable",
            "scope": ["variable", "entity.name.variable"],
            "settings": { "foreground": "#1fc9cf" }
        },
        {
            "name": "Language variable",
            "scope": "variable.language",
            "settings": { "foreground": "#fe4450", "fontStyle": "bold" }
        },
        {
            "name": "Parameter",
            "scope": "variable.parameter",
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "Storage (declaration or modifier keyword)",
            "scope": ["storage.type", "storage.modifier"],
            "settings": { "foreground": "#fbff00" }
        },
        {
            "name": "Constant",
            "scope": "constant",
            "settings": { "foreground": "#ff1500" }
        },
        {
            "name": "Regex",
            "scope": "string.regexp",
            "settings": { "foreground": "#ff1500" }
        },
        {
            "name": "Number",
            "scope": "constant.numeric",
            "settings": { "foreground": "#f51400" }
        },
        {
            "name": "Language constant (boolean, null)",
            "scope": "constant.language",
            "settings": { "foreground": "#ff1500" }
        },
        {
            "name": "Character escape",
            "scope": "constant.character.escape",
            "settings": { "foreground": "#36f9f6" }
        },
        {
            "name": "Entity",
            "scope": "entity.name",
            "settings": { "foreground": "#fc0011" }
        },
        {
            "name": "HTML or XML tag",
            "scope": "entity.name.tag",
            "settings": { "foreground": "#00ff8c" }
        },
        {
            "name": "HTML or XML tag brackets",
            "scope": ["punctuation.definition.tag"],
            "settings": { "foreground": "#00fffb" }
        },
        {
            "name": "Tag attribute",
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#ffcc00" }
        },
        {
            "name": "Tag attribute HTML",
            "scope": "entity.other.attribute-name.html",
            "settings": { "foreground": "#ffcc00", "fontStyle": "italic" }
        },
        {
            "name": "Class",
            "scope": ["entity.name.type", "meta.attribute.class.html"],
            "settings": { "foreground": "#ff0011" }
        },
        {
            "name": "Inherited class",
            "scope": "entity.other.inherited-class",
            "settings": { "foreground": "#ff5201" }
        },
        {
            "name": "Function",
            "scope": ["entity.name.function", "variable.function"],
            "settings": { "foreground": "#00fffb" }
        },
        {
            "name": "JS Export",
            "scope": ["keyword.control.export.js", "keyword.control.import.js"],
            "settings": { "foreground": "#00ff8c" }
        },
        {
            "name": "JS Numerics",
            "scope": ["constant.numeric.decimal.js"],
            "settings": { "foreground": "#00e1ff" }
        },
        {
            "name": "Keyword",
            "scope": "keyword",
            "settings": { "foreground": "#ffcc00" }
        },
        {
            "name": "Control keyword",
            "scope": "keyword.control",
            "settings": { "foreground": "#ffcc00" }
        },
        {
            "name": "Operator",
            "scope": "keyword.operator",
            "settings": { "foreground": "#ffcc00" }
        },
        {
            "name": "Special operator",
            "scope": [
                "keyword.operator.new",
                "keyword.operator.expression",
                "keyword.operator.logical"
            ],
            "settings": { "foreground": "#ffcc00" }
        },
        {
            "name": "Unit",
            "scope": "keyword.other.unit",
            "settings": { "foreground": "#ff3e2c" }
        },
        {
            "name": "Support",
            "scope": "support",
            "settings": { "foreground": "#ff1d2c" }
        },
        {
            "name": "Support function",
            "scope": "support.function",
            "settings": { "foreground": "#0ffffb" }
        },
        {
            "name": "Support variable",
            "scope": "support.variable",
            "settings": { "foreground": "#ff7edb" }
        },
        {
            "name": "Object literal key / property",
            "scope": ["meta.object-literal.key", "support.type.property-name"],
            "settings": { "foreground": "#ff32c5" }
        },
        {
            "name": "Key-value separator",
            "scope": "punctuation.separator.key-value",
            "settings": { "foreground": "#ffffff" }
        },
        {
            "name": "Embedded punctuation",
            "scope": "punctuation.section.embedded",
            "settings": { "foreground": "#ffcc00" }
        },
        {
            "name": "Template expression",
            "scope": [
                "punctuation.definition.template-expression.begin",
                "punctuation.definition.template-expression.end"
            ],
            "settings": { "foreground": "#00ff8c" }
        },
        {
            "name": "CSS property",
            "scope": [
                "support.type.property-name.css",
                "support.type.property-name.json"
            ],
            "settings": { "foreground": "#00ff8c" }
        },
        {
            "name": "JS Switch control",
            "scope": "switch-block.expr.js",
            "settings": { "foreground": "#00ff8c" }
        },
        {
            "name": "JS object path",
            "scope": "variable.other.constant.property.js, variable.other.property.js",
            "settings": { "foreground": "#0ae2ff" }
        },
        {
            "name": "Color",
            "scope": "constant.other.color",
            "settings": { "foreground": "#ff402e" }
        },
        {
            "name": "Font names",
            "scope": "support.constant.font-name",
            "settings": { "foreground": "#ff2d19" }
        },
        {
            "name": "CSS #id",
            "scope": "entity.other.attribute-name.id",
            "settings": { "foreground": "#00fffb" }
        },
        {
            "name": "Pseudo CSS",
            "scope": [
                "entity.other.attribute-name.pseudo-element",
                "entity.other.attribute-name.pseudo-class"
            ],
            "settings": { "foreground": "#D50" }
        },
        {
            "name": "CSS support functions (rgb)",
            "scope": "support.function.misc.css",
            "settings": { "foreground": "#ff2331" }
        },
        {
            "name": "Markup heading",
            "scope": ["markup.heading", "entity.name.section"],
            "settings": { "foreground": "#ff14bc" }
        },
        {
            "name": "Markup text",
            "scope": ["text.html", "keyword.operator.assignment"],
            "settings": { "foreground": "#ffffffee" }
        },
        {
            "name": "Markup quote",
            "scope": "markup.quote",
            "settings": { "foreground": "#ffffffcc", "fontStyle": "italic" }
        },
        {
            "name": "Markup list",
            "scope": "beginning.punctuation.definition.list",
            "settings": { "foreground": "#ff00b7" }
        },
        {
            "name": "Markup link",
            "scope": "markup.underline.link",
            "settings": { "foreground": "#D50" }
        },
        {
            "name": "Markup link description",
            "scope": "string.other.link.description",
            "settings": { "foreground": "#ff321f" }
        },
        {
            "name": "Python function call",
            "scope": "meta.function-call.generic.python",
            "settings": { "foreground": "#1bfffb" }
        },
        {
            "name": "Python variable params",
            "scope": "variable.parameter.function-call.python",
            "settings": { "foreground": "#2bffa0" }
        },
        {
            "name": "C# storage type",
            "scope": "storage.type.cs",
            "settings": { "foreground": "#ff2331" }
        },
        {
            "name": "C# local variable",
            "scope": "entity.name.variable.local.cs",
            "settings": { "foreground": "#ff28c2" }
        },
        {
            "name": "C# properties and fields",
            "scope": [
                "entity.name.variable.field.cs",
                "entity.name.variable.property.cs"
            ],
            "settings": { "foreground": "#ff26c2" }
        },
        {
            "name": "C placeholder",
            "scope": "constant.other.placeholder.c",
            "settings": { "foreground": "#28fd9d", "fontStyle": "italic" }
        },
        {
            "name": "C preprocessors",
            "scope": [
                "keyword.control.directive.include.c",
                "keyword.control.directive.define.c"
            ],
            "settings": { "foreground": "#22ff9b" }
        },
        {
            "name": "C storage modifier",
            "scope": "storage.modifier.c",
            "settings": { "foreground": "#ff2635" }
        },
        {
            "name": "C++ operators",
            "scope": "source.cpp keyword.operator",
            "settings": { "foreground": "#ffd21d" }
        },
        {
            "name": "C++ placeholder",
            "scope": "constant.other.placeholder.cpp",
            "settings": { "foreground": "#2cffa0", "fontStyle": "italic" }
        },
        {
            "name": "C++ include",
            "scope": [
                "keyword.control.directive.include.cpp",
                "keyword.control.directive.define.cpp"
            ],
            "settings": { "foreground": "#2effa1" }
        },
        {
            "name": "C++ constant modifier",
            "scope": "storage.modifier.specifier.const.cpp",
            "settings": { "foreground": "#fc2735" }
        },
        {
            "name": "Elixir Classes",
            "scope": [
                "source.elixir support.type.elixir",
                "source.elixir meta.module.elixir entity.name.class.elixir"
            ],
            "settings": { "foreground": "#1afaf6" }
        },
        {
            "name": "Elixir Functions",
            "scope": "source.elixir entity.name.function",
            "settings": { "foreground": "#17ff97" }
        },
        {
            "name": "Elixir Constants",
            "scope": [
                "source.elixir constant.other.symbol.elixir",
                "source.elixir constant.other.keywords.elixir"
            ],
            "settings": { "foreground": "#1af8f4" }
        },
        {
            "name": "Elixir String Punctuation",
            "scope": "source.elixir punctuation.definition.string",
            "settings": { "foreground": "#2aff9f" }
        },
        {
            "name": "Elixir",
            "scope": [
                "source.elixir variable.other.readwrite.module.elixir",
                "source.elixir variable.other.readwrite.module.elixir punctuation.definition.variable.elixir"
            ],
            "settings": { "foreground": "#06ff8f" }
        },
        {
            "name": "Elixir Binary Punctuation",
            "scope": "source.elixir .punctuation.binary.elixir",
            "settings": { "foreground": "#ff00b7", "fontStyle": "italic" }
        },
        {
            "name": "Clojure Globals",
            "scope": ["entity.global.clojure"],
            "settings": { "foreground": "#00fffb", "fontStyle": "bold" }
        },
        {
            "name": "Clojure Storage",
            "scope": ["storage.control.clojure"],
            "settings": { "foreground": "#13fffb", "fontStyle": "italic" }
        },
        {
            "name": "Clojure Metadata",
            "scope": [
                "meta.metadata.simple.clojure",
                "meta.metadata.map.clojure"
            ],
            "settings": { "foreground": "#ff1c2b", "fontStyle": "italic" }
        },
        {
            "name": "Clojure Macros, Quoted",
            "scope": ["meta.quoted-expression.clojure"],
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "Clojure Symbols",
            "scope": ["meta.symbol.clojure"],
            "settings": { "foreground": "#ff31c5" }
        },
        {
            "name": "Go basic",
            "scope": "source.go",
            "settings": { "foreground": "#ff2ac3" }
        },
        {
            "name": "Go Function Calls",
            "scope": "source.go meta.function-call.go",
            "settings": { "foreground": "#00fffb" }
        },
        {
            "name": "Go Keywords",
            "scope": [
                "source.go keyword.package.go",
                "source.go keyword.import.go",
                "source.go keyword.function.go",
                "source.go keyword.type.go",
                "source.go keyword.const.go",
                "source.go keyword.var.go",
                "source.go keyword.map.go",
                "source.go keyword.channel.go",
                "source.go keyword.control.go"
            ],
            "settings": { "foreground": "#ffcf0d" }
        },
        {
            "name": "Go interfaces",
            "scope": [
                "source.go storage.type",
                "source.go keyword.struct.go",
                "source.go keyword.interface.go"
            ],
            "settings": { "foreground": "#0aff91" }
        },
        {
            "name": "Go Constants e.g. nil, string format (%s, %d, etc.)",
            "scope": [
                "source.go constant.language.go",
                "source.go constant.other.placeholder.go",
                "source.go variable"
            ],
            "settings": { "foreground": "#17dffa" }
        },
        {
            "name": "Markdown links and image paths",
            "scope": [
                "markup.underline.link.markdown",
                "markup.inline.raw.string.markdown"
            ],
            "settings": { "foreground": "#29ff9e", "fontStyle": "italic" }
        },
        {
            "name": "Markdown links and image paths",
            "scope": ["string.other.link.title.markdown"],
            "settings": { "foreground": "#ffce0b" }
        },
        {
            "name": "Markdown headings",
            "scope": [
                "markup.heading.markdown",
                "entity.name.section.markdown"
            ],
            "settings": { "foreground": "#ff35c6", "fontStyle": "bold" }
        },
        {
            "name": "Markdown italic",
            "scope": ["markup.italic.markdown"],
            "settings": { "foreground": "#00e1ff", "fontStyle": "italic" }
        },
        {
            "name": "Markdown bold",
            "scope": ["markup.bold.markdown"],
            "settings": { "foreground": "#2EE2FA", "fontStyle": "bold" }
        },
        {
            "name": "Markdown quotes",
            "scope": [
                "punctuation.definition.quote.begin.markdown",
                "markup.quote.markdown"
            ],
            "settings": { "foreground": "#06ff8f" }
        },
        {
            "name": "Basic source colours",
            "scope": ["source.dart", "source.python", "source.scala"],
            "settings": { "foreground": "#06ff8f" }
        },
        {
            "name": "Dart strings",
            "scope": ["string.interpolated.single.dart"],
            "settings": { "foreground": "#fd4736" }
        },
        {
            "name": "Dart variable params",
            "scope": ["variable.parameter.dart"],
            "settings": { "foreground": "#1eff9a" }
        },
        {
            "name": "Dart numerics",
            "scope": ["constant.numeric.dart"],
            "settings": { "foreground": "#00e1ff" }
        },
        {
            "name": "Scala variable params",
            "scope": ["variable.parameter.scala"],
            "settings": { "foreground": "#2EE2FA" }
        },
        {
            "name": "Scala",
            "scope": ["meta.template.expression.scala"],
            "settings": { "foreground": "#1eff9a" }
        }
    ],
