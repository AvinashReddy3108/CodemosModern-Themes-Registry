    "name": "OneCalm",
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "property": "#a7d984",
        "property.declaration": "#a7d984",
        "variable": "#ffffffaf",
        "source.interpolation": "#ffffffaf",
        "type": "#7fc1f7",
        "class": "#7fc1f7",
        "type.declaration": "#7fc1f7",
        "class.constructor": "#bf9ffe",
        "method.constructor": "#bf9ffe",
        "class.annotation": "#ffffffaf",
        "property.annotation": "#ffffffaf",
        "annotation": "#ffffffaf"
    },
    "tokenColors": [
        {
            "name": "Chalky",
            "scope": [
                "markup.inline",
                "markup.quote",
                "source.ini",
                "string.other.link.description",
                "string"
            ],
            "settings": { "foreground": "#e2c08d" }
        },
        {
            "name": "Coral",
            "scope": [
                "keyword",
                "storage.type",
                "storage.modifier",
                "markup.italic",
                "punctuation.definition.block.tag",
                "entity.name.tag",
                "support.type.property-name",
                "heading",
                "punctuation.definition.list.begin.markdown",
                "punctuation.definition.list.end.markdown",
                "punctuation.definition.template-expression",
                "punctuation.section.embedded",
                "variable.language",
                "keyword.operator.expression.typeof",
                "keyword.control.anchor",
                "keyword.operator.new"
            ],
            "settings": { "foreground": "#f08585" }
        },
        {
            "name": "Cyan",
            "scope": [
                "string.regexp",
                "constant.other.character-class",
                "constant.character.escape",
                "markup.underline.link",
                "string.url",
                "entity.other.attribute-name",
                "variable.parameter",
                "variable.object.property",
                "meta.object-literal.key"
            ],
            "settings": { "foreground": "#8dc4b2" }
        },
        {
            "name": "Malibu",
            "scope": [
                "entity.other.inherited-class",
                "keyword.other.type",
                "storage.modifier.import",
                "storage.modifier.package",
                "storage.type.built-in",
                "storage.type.generic",
                "storage.type.java",
                "storage.type.groovy",
                "storage.type.primitive",
                "support.class",
                "support.other.namespace",
                "support.type",
                "entity.name.type.class",
                "entity.name.type.interface",
                "entity.name.type.enum",
                "entity.name.type.module",
                "entity.name.type.parameter",
                "entity.name.type",
                "support.type.primitive"
            ],
            "settings": { "foreground": "#7fc1f7" }
        },
        {
            "name": "Ivory",
            "scope": [
                "meta.brace",
                "punctuation.accessor",
                "punctuation.definition.block",
                "punctuation.separator",
                "support.type.property-name.css",
                "variable.other.constant",
                "string.interpolated.expression",
                "keyword.operator",
                "storage.type.function.arrow",
                "meta.arrow",
                "storage.type.annotation",
                "punctuation.definition.annotation",
                "meta.decorator"
            ],
            "settings": { "foreground": "#ffffffaf" }
        },
        {
            "name": "Sage",
            "scope": [],
            "settings": { "foreground": "#a7d984" }
        },
        {
            "name": "Stone",
            "scope": ["comment"],
            "settings": { "foreground": "#727b89" }
        },
        {
            "name": "Violet",
            "scope": [
                "entity.other.attribute-name.id.css",
                "string.other.link",
                "variable.language.super",
                "entity.name.function",
                "meta.function-call",
                "support.function",
                "keyword.operator.comparison",
                "keyword.operator.logical",
                "keyword.operator.bitwise",
                "keyword.operator.decrement",
                "keyword.operator.increment"
            ],
            "settings": { "foreground": "#bf9ffe" }
        },
        {
            "name": "Whiskey",
            "scope": [
                "keyword.operator.quantifier.regexp",
                "markup.bold",
                "variable.other.jsdoc",
                "variable.other.enummember",
                "constant",
                "support.constant"
            ],
            "settings": { "foreground": "#eaa768" }
        },
        {
            "name": "Always italic",
            "scope": ["markup.quote", "markup.italic"],
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "Always bold",
            "scope": ["heading", "markup.bold"],
            "settings": { "fontStyle": "bold" }
        }
    ],
    "type": "dark",
    "$schema": "vscode://schemas/color-theme"
}
