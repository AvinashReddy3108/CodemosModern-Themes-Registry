{
    "type": "light",
    "name": "vmtmz.pages.dev",
    "colors": {
        "editor.background": "#f0f0f0",
        "activityBar.background": "#f0f0f0",
        "activityBar.foreground": "#963200",
        "panel.background": "#f0f0f0",
        "titleBar.activeBackground": "#f0f0f0",
        "menu.background": "#f0f0f0",
        "menu.selectionBackground": "#979797",
        "terminal.background": "#f0f0f0",
        "sideBar.background": "#f0f0f0",
        "activityBarBadge.background": "#f0f0f0",
        "list.activeSelectionBackground": "#979797",
        "tab.activeBorder": "#963200",
        "notifications.background": "#f0f0f0",
        "commandCenter.background": "#f0f0f0",
        "statusBar.background": "#f0f0f0",
        "statusBar.foreground": "#000000",
        "statusBar.noFolderBackground": "#f0f0f0",
        "statusBar.noFolderForeground": "#000000",
        "statusBar.debuggingBackground": "#f0f0f0",
        "statusBar.debuggingForeground": "#000000",
        "peekViewEditor.background": "#f0f0f0",
        "peekViewResult.background": "#f0f0f0"
    },
    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#00800070" }
        },
        {
            "name": "Comments: Preprocessor",
            "scope": "comment.block.preprocessor",
            "settings": { "fontStyle": "", "foreground": "#00800070" }
        },
        {
            "name": "Comments: Documentation",
            "scope": ["comment.documentation", "comment.block.documentation"],
            "settings": { "foreground": "#00800070" }
        },
        {
            "name": "Invalid - Illegal",
            "scope": "invalid.illegal",
            "settings": { "foreground": "#660000" }
        },
        {
            "name": "Operators",
            "scope": "keyword.operator",
            "settings": { "foreground": "#A626A4" }
        },
        {
            "name": "Keywords",
            "scope": ["keyword", "storage"],
            "settings": { "foreground": "#A626A4" }
        },
        {
            "name": "Types",
            "scope": ["storage.type", "support.type"],
            "settings": { "foreground": "#A626A4" }
        },
        {
            "name": "Language Constants",
            "scope": [
                "constant.language",
                "support.constant",
                "variable.language"
            ],
            "settings": { "foreground": "#A626A4" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "support.variable"],
            "settings": { "foreground": "#000000" }
        },
        {
            "name": "Functions",
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#8250DF" }
        },
        {
            "name": "Classes",
            "scope": [
                "entity.name.type",
                "entity.other.inherited-class",
                "support.class"
            ],
            "settings": { "foreground": "#000000" }
        },
        {
            "name": "Exceptions",
            "scope": "entity.name.exception",
            "settings": { "foreground": "#A626A4" }
        },
        {
            "name": "Sections",
            "scope": "entity.name.section",
            "settings": { "foreground": "#A626A4" }
        },
        {
            "name": "Numbers, Characters",
            "scope": ["constant.numeric", "constant.character", "constant"],
            "settings": { "foreground": "#8250DF" }
        },
        {
            "name": "Strings",
            "scope": ["string"],
            "settings": { "foreground": "#963200" }
        },
        {
            "name": "Strings: Escape Sequences",
            "scope": "constant.character.escape",
            "settings": { "foreground": "#963200" }
        },
        {
            "name": "Strings: Regular Expressions",
            "scope": "string.regexp",
            "settings": { "foreground": "#8250DF" }
        },
        {
            "name": "Strings: Symbols",
            "scope": "constant.other.symbol",
            "settings": { "foreground": "#963200" }
        },
        {
            "name": "Punctuation",
            "scope": "punctuation",
            "settings": { "foreground": "#000000" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
