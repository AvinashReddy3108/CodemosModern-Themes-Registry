{
    "name": "Milk outside a bag of milk",
    "tokenColors": [
        {
            "name": "Global settings",
            "settings": { "background": "#171717", "foreground": "#eb958f" }
        },
        {
            "name": "String",
            "scope": "string",
            "settings": { "foreground": "#d96257" }
        },
        {
            "name": "String Escape",
            "scope": "constant.character.escape, text.html constant.character.entity.named, punctuation.definition.entity.html",
            "settings": { "foreground": "#ff9382" }
        },
        {
            "name": "Boolean",
            "scope": "constant.language.boolean",
            "settings": { "foreground": "#5c2f55" }
        },
        {
            "name": "Number",
            "scope": "constant.numeric",
            "settings": { "foreground": "#8ebdde" }
        },
        {
            "name": "Identifier",
            "scope": "variable, support.variable, support.class, support.constant, meta.definition.variable entity.name.function",
            "settings": { "foreground": "#8a467f" }
        },
        {
            "name": "Keyword",
            "scope": "keyword, modifier, variable.language.this, support.type.object, constant.language",
            "settings": { "foreground": "#5c2f55" }
        },
        {
            "name": "Function call",
            "scope": "entity.name.function, support.function",
            "settings": { "foreground": "#8ebdde" }
        },
        {
            "name": "Storage",
            "scope": "storage.type, storage.modifier",
            "settings": { "foreground": "#5c2f55" }
        },
        {
            "name": "Modules",
            "scope": "support.module, support.node",
            "settings": { "foreground": "#8a467f", "fontStyle": "italic" }
        },
        {
            "name": "Type",
            "scope": "support.type",
            "settings": { "foreground": "#8edea1" }
        },
        {
            "name": "Type",
            "scope": "entity.name.type, entity.other.inherited-class",
            "settings": { "foreground": "#8edea1" }
        },
        {
            "name": "Comment",
            "scope": "comment",
            "settings": { "foreground": "#454545", "fontStyle": "italic" }
        },
        {
            "name": "Class",
            "scope": "entity.name.type.class",
            "settings": { "foreground": "#8edea1", "fontStyle": "underline" }
        },
        {
            "name": "Class variable",
            "scope": "variable.object.property, meta.field.declaration entity.name.function",
            "settings": { "foreground": "#8edea1" }
        },
        {
            "name": "Class method",
            "scope": "meta.definition.method entity.name.function",
            "settings": { "foreground": "#8edea1" }
        },
        {
            "name": "Function definition",
            "scope": "meta.function entity.name.function",
            "settings": { "foreground": "#8edea1" }
        },
        {
            "name": "Template expression",
            "scope": "template.expression.begin, template.expression.end, punctuation.definition.template-expression.begin, punctuation.definition.template-expression.end",
            "settings": { "foreground": "#5c2f55" }
        },
        {
            "name": "Reset embedded/template expression colors",
            "scope": "meta.embedded, source.groovy.embedded, meta.template.expression",
            "settings": { "foreground": "#eb958f" }
        },
        {
            "name": "YAML key",
            "scope": "entity.name.tag.yaml",
            "settings": { "foreground": "#8a467f" }
        },
        {
            "name": "JSON key",
            "scope": "meta.object-literal.key, meta.object-literal.key string, support.type.property-name.json",
            "settings": { "foreground": "#8a467f" }
        },
        {
            "name": "JSON constant",
            "scope": "constant.language.json",
            "settings": { "foreground": "#5c2f55" }
        },
        {
            "name": "CSS class",
            "scope": "entity.other.attribute-name.class",
            "settings": { "foreground": "#5c2f55" }
        },
        {
            "name": "CSS ID",
            "scope": "entity.other.attribute-name.id",
            "settings": { "foreground": "#d96257" }
        },
        {
            "name": "CSS tag",
            "scope": "source.css entity.name.tag",
            "settings": { "foreground": "#8edea1" }
        },
        {
            "name": "HTML tag outer",
            "scope": "meta.tag, punctuation.definition.tag",
            "settings": { "foreground": "#5c2f55" }
        },
        {
            "name": "HTML tag inner",
            "scope": "entity.name.tag",
            "settings": { "foreground": "#8a467f" }
        },
        {
            "name": "HTML tag attribute",
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#8ebdde" }
        },
        {
            "name": "Markdown heading",
            "scope": "markup.heading",
            "settings": { "foreground": "#5c2f55" }
        },
        {
            "name": "Markdown link text",
            "scope": "text.html.markdown meta.link.inline, meta.link.reference",
            "settings": { "foreground": "#8a467f" }
        },
        {
            "name": "Markdown list item",
            "scope": "text.html.markdown beginning.punctuation.definition.list",
            "settings": { "foreground": "#5c2f55" }
        },
        {
            "name": "Markdown italic",
            "scope": "markup.italic",
            "settings": { "foreground": "#8a467f", "fontStyle": "italic" }
        },
        {
            "name": "Markdown bold",
            "scope": "markup.bold",
            "settings": { "foreground": "#8a467f", "fontStyle": "bold" }
        },
        {
            "name": "Markdown bold italic",
            "scope": "markup.bold markup.italic, markup.italic markup.bold",
            "settings": { "foreground": "#8a467f", "fontStyle": "italic bold" }
        },
        {
            "name": "Markdown code block",
            "scope": "markup.fenced_code.block.markdown punctuation.definition.markdown",
            "settings": { "foreground": "#d96257" }
        },
        {
            "name": "Markdown inline code",
            "scope": "markup.inline.raw.string.markdown",
            "settings": { "foreground": "#d96257" }
        },
        {
            "name": "INI property name",
            "scope": "keyword.other.definition.ini",
            "settings": { "foreground": "#8a467f" }
        },
        {
            "name": "INI section title",
            "scope": "entity.name.section.group-title.ini",
            "settings": { "foreground": "#5c2f55" }
        },
        {
            "name": "C# class",
            "scope": "source.cs meta.class.identifier storage.type",
            "settings": { "foreground": "#8edea1", "fontStyle": "underline" }
        },
        {
            "name": "C# class method",
            "scope": "source.cs meta.method.identifier entity.name.function",
            "settings": { "foreground": "#8edea1" }
        },
        {
            "name": "C# function call",
            "scope": "source.cs meta.method-call meta.method, source.cs entity.name.function",
            "settings": { "foreground": "#8ebdde" }
        },
        {
            "name": "C# type",
            "scope": "source.cs storage.type",
            "settings": { "foreground": "#8edea1" }
        },
        {
            "name": "C# return type",
            "scope": "source.cs meta.method.return-type",
            "settings": { "foreground": "#8edea1" }
        },
        {
            "name": "C# preprocessor",
            "scope": "source.cs meta.preprocessor",
            "settings": { "foreground": "#454545" }
        },
        {
            "name": "C# namespace",
            "scope": "source.cs entity.name.type.namespace",
            "settings": { "foreground": "#eb958f" }
        },
        {
            "name": "Global settings",
            "settings": { "background": "#171717", "foreground": "#eb958f" }
        }
    ],
    "colors": {
        "focusBorder": "#5c2f55",
        "foreground": "#eb958f",
        "button.background": "#5c2f55",
        "button.foreground": "#ffffff",
        "dropdown.background": "#242424",
        "input.background": "#242424",
        "inputOption.activeBorder": "#5c2f55",
        "list.activeSelectionBackground": "#5c2f5580",
        "list.activeSelectionForeground": "#FFFFFF",
        "list.dropBackground": "#5c2f5580",
        "list.focusForeground": "#FFFFFF",
        "list.highlightForeground": "#5c2f55",
        "list.hoverBackground": "#FFFFFF1a",
        "list.inactiveSelectionBackground": "#FFFFFF33",
        "activityBar.background": "#202020",
        "activityBar.dropBackground": "#5c2f5580",
        "activityBarBadge.background": "#5c2f55",
        "activityBarBadge.foreground": "#ffffff",
        "badge.background": "#5c2f55",
        "badge.foreground": "#ffffff",
        "sideBar.background": "#1b1b1b",
        "sideBarSectionHeader.background": "#202020",
        "editorGroup.dropBackground": "#5c2f5580",
        "editorGroup.focusedEmptyBorder": "#5c2f55",
        "editorGroupHeader.tabsBackground": "#1b1b1b",
        "tab.border": "#00000033",
        "tab.activeBorder": "#5c2f55",
        "tab.inactiveBackground": "#202020",
        "tab.activeModifiedBorder": "#5c2f55",
        "tab.inactiveModifiedBorder": "#371c33",
        "tab.unfocusedActiveModifiedBorder": "#492544",
        "tab.unfocusedInactiveModifiedBorder": "#371c33",
        "editor.background": "#171717",
        "editor.foreground": "#eb958f",
        "editorLineNumber.foreground": "#FFFFFF4d",
        "editorLineNumber.activeForeground": "#5c2f55",
        "editor.lineHighlightBorder": "#FFFFFF1a",
        "editor.rangeHighlightBackground": "#FFFFFF0d",
        "editorWidget.background": "#1b1b1b",
        "editorHoverWidget.background": "#1b1b1b",
        "editorMarkerNavigation.background": "#1b1b1b",
        "peekView.border": "#5c2f55",
        "peekViewEditor.background": "#121212",
        "peekViewResult.background": "#1b1b1b",
        "peekViewTitle.background": "#171717",
        "panel.background": "#1b1b1b",
        "panel.border": "#FFFFFF1a",
        "panelTitle.activeBorder": "#eb958f80",
        "panelTitle.inactiveForeground": "#eb958f80",
        "statusBar.background": "#121212",
        "statusBar.debuggingBackground": "#5c2f55",
        "statusBar.debuggingForeground": "#ffffff",
        "statusBar.noFolderBackground": "#121212",
        "statusBarItem.activeBackground": "#5c2f5580",
        "statusBarItem.hoverBackground": "#FFFFFF1a",
        "statusBarItem.remoteBackground": "#5c2f55",
        "statusBarItem.remoteForeground": "#ffffff",
        "titleBar.activeBackground": "#121212",
        "pickerGroup.border": "#FFFFFF1a",
        "debugToolBar.background": "#202020",
        "editorBracketHighlight.foreground1": "#733a6a",
        "editorBracketHighlight.foreground2": "#ff7a6c",
        "editorBracketHighlight.foreground3": "#b1ffc9",
        "editorBracketHighlight.foreground4": "#b1ecff",
        "selection.background": "#5c2f55"
    },
    "$schema": "vscode://schemas/color-theme"
}
