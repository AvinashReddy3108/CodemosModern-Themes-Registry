    "tokenColors": [
        {
            "name": "JSON Key",
            "scope": [
                "support.type.property-name.json",
                "meta.object-literal.key"
            ],
            "settings": { "foreground": "#d9d9d9" }
        },
        {
            "scope": "variable.parameter.function",
            "settings": { "foreground": "#d9d9d9" }
        },
        {
            "scope": "comment, punctuation.definition.comment",
            "settings": { "foreground": "#5a5a5aad" }
        },
        {
            "scope": "punctuation.definition.string, punctuation.definition.variable, punctuation.definition.parameters, punctuation.definition.array",
            "settings": { "foreground": "#fafafacf" }
        },
        { "scope": "none", "settings": { "foreground": "#a2a2a2" } },
        {
            "scope": "keyword.operator",
            "settings": { "foreground": "#fdfdfdcf", "fontStyle": "" }
        },
        {
            "scope": "keyword",
            "settings": { "foreground": "#8a8a8aee", "fontStyle": "italic" }
        },
        { "scope": "variable", "settings": { "foreground": "#d9d9d9ee" } },
        {
            "scope": "entity.name.function, meta.require, support.function.any-method",
            "settings": { "foreground": "#f4f4f4ee", "fontStyle": "italic" }
        },
        {
            "scope": "support.class, entity.name.class, entity.name.type.class",
            "settings": { "foreground": "#8c8c8c" }
        },
        { "scope": "meta.class", "settings": { "foreground": "#d9d9d9" } },
        {
            "scope": "keyword.other.special-method",
            "settings": { "foreground": "#5c5c5c" }
        },
        { "scope": "storage", "settings": { "foreground": "#8a8a8aee" } },
        {
            "scope": "support.function",
            "settings": { "foreground": "#777777" }
        },
        {
            "scope": "string, constant.other.symbol, entity.other.inherited-class",
            "settings": { "foreground": "#e2e2e2b6" }
        },
        {
            "scope": "constant.numeric",
            "settings": { "foreground": "#d0d0d0" }
        },
        { "scope": "none", "settings": { "foreground": "#858585" } },
        { "scope": "none", "settings": { "foreground": "#858585" } },
        { "scope": "constant", "settings": { "foreground": "#c2c2c2" } },
        { "scope": "entity.name.tag", "settings": { "foreground": "#5d5d5d" } },
        {
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#858585" }
        },
        {
            "scope": "entity.other.attribute-name.id, punctuation.definition.entity",
            "settings": { "foreground": "#5c5c5c" }
        },
        { "scope": "meta.selector", "settings": { "foreground": "#8a8a8aee" } },
        { "scope": "none", "settings": { "foreground": "#858585" } },
        {
            "scope": "markup.heading punctuation.definition.heading, entity.name.section",
            "settings": { "foreground": "#5c5c5c", "fontStyle": "" }
        },
        {
            "scope": "keyword.other.unit",
            "settings": { "foreground": "#858585" }
        },
        {
            "scope": "markup.bold, punctuation.definition.bold",
            "settings": { "foreground": "#8c8c8c", "fontStyle": "bold" }
        },
        {
            "scope": "markup.italic, punctuation.definition.italic",
            "settings": { "foreground": "#8a8a8aee", "fontStyle": "italic" }
        },
        {
            "scope": "markup.raw.inline",
            "settings": { "foreground": "#e0e0e0bf" }
        },
        {
            "scope": "string.other.link, punctuation.definition.string.end.markdown",
            "settings": { "foreground": "#6a6a6a" }
        },
        { "scope": "meta.link", "settings": { "foreground": "#858585" } },
        { "scope": "markup.list", "settings": { "foreground": "#6a6a6a" } },
        { "scope": "markup.quote", "settings": { "foreground": "#858585" } },
        { "scope": "meta.separator", "settings": { "foreground": "#a2a2a2" } },
        {
            "scope": "markup.inserted",
            "settings": { "foreground": "#e0e0e0bf" }
        },
        { "scope": "markup.deleted", "settings": { "foreground": "#6a6a6a" } },
        {
            "scope": "markup.changed",
            "settings": { "foreground": "#8a8a8aee" }
        },
        {
            "scope": "constant.other.color",
            "settings": { "foreground": "#777777" }
        },
        { "scope": "string.regexp", "settings": { "foreground": "#777777" } },
        {
            "scope": "constant.character.escape",
            "settings": { "foreground": "#777777" }
        },
        {
            "scope": "punctuation.section.embedded, variable.interpolation",
            "settings": { "foreground": "#8a8a8aee" }
        },
        { "scope": "invalid.illegal", "settings": { "foreground": "#d9d9d9" } },
        { "scope": "invalid.broken", "settings": { "foreground": "#020202" } },
        {
            "scope": "invalid.deprecated",
            "settings": { "foreground": "#d9d9d9" }
        },
        {
            "scope": "invalid.unimplemented",
            "settings": { "foreground": "#d9d9d9" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
