    "tokenColors": [
        {
            "name": "JSON Key",
            "scope": [
                "support.type.property-name.json",
                "meta.object-literal.key"
            ],
            "settings": { "foreground": "#760e8dc5" }
        },
        {
            "scope": "variable.parameter.function",
            "settings": { "foreground": "#760e8dc5" }
        },
        {
            "scope": "comment, punctuation.definition.comment",
            "settings": { "foreground": "#a792b5aa" }
        },
        {
            "scope": "punctuation.definition.string, punctuation.definition.variable, punctuation.definition.parameters, punctuation.definition.array",
            "settings": { "foreground": "#24003b98" }
        },
        { "scope": "none", "settings": { "foreground": "#300f57" } },
        {
            "scope": "keyword.operator",
            "settings": { "foreground": "#24003b", "fontStyle": "" }
        },
        {
            "scope": "keyword",
            "settings": { "foreground": "#9772a6", "fontStyle": "italic" }
        },
        { "scope": "variable", "settings": { "foreground": "#774495" } },
        {
            "scope": "entity.name.function, meta.require, support.function.any-method",
            "settings": { "foreground": "#6d3480ef", "fontStyle": "italic" }
        },
        {
            "scope": "support.class, entity.name.class, entity.name.type.class",
            "settings": { "foreground": "#6b428f" }
        },
        { "scope": "meta.class", "settings": { "foreground": "#210047" } },
        {
            "scope": "keyword.other.special-method",
            "settings": { "foreground": "#ae80c2" }
        },
        { "scope": "storage", "settings": { "foreground": "#b665d7" } },
        {
            "scope": "support.function",
            "settings": { "foreground": "#9262a5" }
        },
        {
            "scope": "string, constant.other.symbol, entity.other.inherited-class",
            "settings": { "foreground": "#24003bc0" }
        },
        {
            "scope": "constant.numeric",
            "settings": { "foreground": "#531c62" }
        },
        { "scope": "none", "settings": { "foreground": "#6d3480ef" } },
        { "scope": "none", "settings": { "foreground": "#6d3480ef" } },
        { "scope": "constant", "settings": { "foreground": "#921eb2" } },
        { "scope": "entity.name.tag", "settings": { "foreground": "#927fb5" } },
        {
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#ae7ac1" }
        },
        {
            "scope": "entity.other.attribute-name.id, punctuation.definition.entity",
            "settings": { "foreground": "#ae80c2" }
        },
        { "scope": "meta.selector", "settings": { "foreground": "#9262a5" } },
        { "scope": "none", "settings": { "foreground": "#6d3480ef" } },
        {
            "scope": "markup.heading punctuation.definition.heading, entity.name.section",
            "settings": { "foreground": "#ae80c2", "fontStyle": "" }
        },
        {
            "scope": "keyword.other.unit",
            "settings": { "foreground": "#6d3480ef" }
        },
        {
            "scope": "markup.bold, punctuation.definition.bold",
            "settings": { "foreground": "#6b428f", "fontStyle": "bold" }
        },
        {
            "scope": "markup.italic, punctuation.definition.italic",
            "settings": { "foreground": "#9262a5", "fontStyle": "italic" }
        },
        {
            "scope": "markup.raw.inline",
            "settings": { "foreground": "#24003bc0" }
        },
        {
            "scope": "string.other.link, punctuation.definition.string.end.markdown",
            "settings": { "foreground": "#9262a5" }
        },
        { "scope": "meta.link", "settings": { "foreground": "#6d3480ef" } },
        { "scope": "markup.list", "settings": { "foreground": "#9262a5" } },
        { "scope": "markup.quote", "settings": { "foreground": "#6d3480ef" } },
        { "scope": "meta.separator", "settings": { "foreground": "#300f57" } },
        {
            "scope": "markup.inserted",
            "settings": { "foreground": "#24003bc0" }
        },
        { "scope": "markup.deleted", "settings": { "foreground": "#9262a5" } },
        { "scope": "markup.changed", "settings": { "foreground": "#9262a5" } },
        {
            "scope": "constant.other.color",
            "settings": { "foreground": "#9262a5" }
        },
        { "scope": "string.regexp", "settings": { "foreground": "#9262a5" } },
        {
            "scope": "constant.character.escape",
            "settings": { "foreground": "#9262a5" }
        },
        {
            "scope": "punctuation.section.embedded, variable.interpolation",
            "settings": { "foreground": "#9262a5" }
        },
        { "scope": "invalid.illegal", "settings": { "foreground": "#210047" } },
        { "scope": "invalid.broken", "settings": { "foreground": "#faf8fb" } },
        {
            "scope": "invalid.deprecated",
            "settings": { "foreground": "#210047" }
        },
        {
            "scope": "invalid.unimplemented",
            "settings": { "foreground": "#210047" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
