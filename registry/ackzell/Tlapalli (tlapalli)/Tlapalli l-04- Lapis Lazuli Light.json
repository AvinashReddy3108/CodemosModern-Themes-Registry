    "tokenColors": [
        {
            "name": "JSON Key",
            "scope": [
                "support.type.property-name.json",
                "meta.object-literal.key"
            ],
            "settings": { "foreground": "#1154a5ee" }
        },
        {
            "scope": "variable.parameter.function",
            "settings": { "foreground": "#1154a5ee" }
        },
        {
            "scope": "comment, punctuation.definition.comment",
            "settings": { "foreground": "#92a7b5ad" }
        },
        {
            "scope": "punctuation.definition.string, punctuation.definition.variable, punctuation.definition.parameters, punctuation.definition.array",
            "settings": { "foreground": "#00243b98" }
        },
        { "scope": "none", "settings": { "foreground": "#0f3057" } },
        {
            "scope": "keyword.operator",
            "settings": { "foreground": "#00243b", "fontStyle": "" }
        },
        {
            "scope": "keyword",
            "settings": { "foreground": "#7b9db9", "fontStyle": "italic" }
        },
        { "scope": "variable", "settings": { "foreground": "#185b8eee" } },
        {
            "scope": "entity.name.function, meta.require, support.function.any-method",
            "settings": { "foreground": "#002647", "fontStyle": "italic" }
        },
        {
            "scope": "support.class, entity.name.class, entity.name.type.class",
            "settings": { "foreground": "#426b8fcf" }
        },
        { "scope": "meta.class", "settings": { "foreground": "#002647" } },
        {
            "scope": "keyword.other.special-method",
            "settings": { "foreground": "#80a2c2" }
        },
        { "scope": "storage", "settings": { "foreground": "#2476b9" } },
        {
            "scope": "support.function",
            "settings": { "foreground": "#6287a5" }
        },
        {
            "scope": "string, constant.other.symbol, entity.other.inherited-class",
            "settings": { "foreground": "#0c3f5ec7" }
        },
        {
            "scope": "constant.numeric",
            "settings": { "foreground": "#084066" }
        },
        { "scope": "none", "settings": { "foreground": "#346180" } },
        { "scope": "none", "settings": { "foreground": "#346180" } },
        { "scope": "constant", "settings": { "foreground": "#106daa" } },
        { "scope": "entity.name.tag", "settings": { "foreground": "#7f9ab5" } },
        {
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#518eb7" }
        },
        {
            "scope": "entity.other.attribute-name.id, punctuation.definition.entity",
            "settings": { "foreground": "#80a2c2" }
        },
        { "scope": "meta.selector", "settings": { "foreground": "#2476b9" } },
        { "scope": "none", "settings": { "foreground": "#346180" } },
        {
            "scope": "markup.heading punctuation.definition.heading, entity.name.section",
            "settings": { "foreground": "#80a2c2", "fontStyle": "" }
        },
        {
            "scope": "keyword.other.unit",
            "settings": { "foreground": "#346180" }
        },
        {
            "scope": "markup.bold, punctuation.definition.bold",
            "settings": { "foreground": "#426b8fcf", "fontStyle": "bold" }
        },
        {
            "scope": "markup.italic, punctuation.definition.italic",
            "settings": { "foreground": "#2476b9", "fontStyle": "italic" }
        },
        {
            "scope": "markup.raw.inline",
            "settings": { "foreground": "#00243bc7" }
        },
        {
            "scope": "string.other.link, punctuation.definition.string.end.markdown",
            "settings": { "foreground": "#6287a5" }
        },
        { "scope": "meta.link", "settings": { "foreground": "#346180" } },
        { "scope": "markup.list", "settings": { "foreground": "#6287a5" } },
        { "scope": "markup.quote", "settings": { "foreground": "#346180" } },
        { "scope": "meta.separator", "settings": { "foreground": "#0f3057" } },
        {
            "scope": "markup.inserted",
            "settings": { "foreground": "#00243bc7" }
        },
        { "scope": "markup.deleted", "settings": { "foreground": "#6287a5" } },
        { "scope": "markup.changed", "settings": { "foreground": "#2476b9" } },
        {
            "scope": "constant.other.color",
            "settings": { "foreground": "#6287a5" }
        },
        { "scope": "string.regexp", "settings": { "foreground": "#6287a5" } },
        {
            "scope": "constant.character.escape",
            "settings": { "foreground": "#6287a5" }
        },
        {
            "scope": "punctuation.section.embedded, variable.interpolation",
            "settings": { "foreground": "#2476b9" }
        },
        { "scope": "invalid.illegal", "settings": { "foreground": "#002647" } },
        { "scope": "invalid.broken", "settings": { "foreground": "#f2f5f8" } },
        {
            "scope": "invalid.deprecated",
            "settings": { "foreground": "#002647" }
        },
        {
            "scope": "invalid.unimplemented",
            "settings": { "foreground": "#002647" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
