    "tokenColors": [
        {
            "scope": [
                "variable",
                "string constant.other.placeholder",
                "invalid.deprecated",
                "keyword",
                "storage.type",
                "storage.modifier"
            ],
            "settings": { "foreground": "#FF0000" }
        },
        {
            "scope": [
                "storage.type.function.js",
                "variable.other.readwrite.alias.js",
                "meta.block.js"
            ],
            "settings": { "foreground": "#fc03c6", "fontStyle": "italic" }
        },
        {
            "scope": [
                "variable",
                "string constant.other.placeholder",
                "entity.name.function",
                "punctuation.definition.interpolation.end.bracket.curly.scss",
                "punctuation.definition.interpolation.begin.bracket.curly.scss"
            ],
            "settings": { "fontStyle": "italic" }
        },
        {
            "scope": [
                "punctuation.definition.interpolation.end.bracket.curly.scss",
                "punctuation.definition.interpolation.begin.bracket.curly.scss"
            ],
            "settings": { "foreground": "#FFBD00" }
        },
        {
            "scope": ["constant.other.php"],
            "settings": { "foreground": "#FF0000" }
        },
        {
            "scope": ["constant.other.color", "constant.numeric.decimal.js"],
            "settings": { "foreground": "#ff8800" }
        },
        {
            "scope": [
                "invalid",
                "invalid.illegal",
                "keyword.operator.logical.ts"
            ],
            "settings": { "foreground": "#10FF00" }
        },
        {
            "scope": ["Keyword", "Storage"],
            "settings": { "fontStyle": "italic" }
        },
        {
            "scope": [
                "keyword.control",
                "constant.other.color",
                "punctuation.definition.tag",
                "punctuation",
                "punctuation.separator.inheritance.php",
                "punctuation.definition.tag.html",
                "punctuation.section.embedded",
                "keyword.other.template",
                "keyword.other.substitution",
                "entity.name.tag.reference.scss"
            ],
            "settings": { "foreground": "#A7A8AF" }
        },
        {
            "scope": ["keyword.control.export.js"],
            "settings": { "foreground": "#00ffb3" }
        },
        {
            "scope": [
                "punctuation.definition.tag.begin.html",
                "punctuation.definition.tag.end.html",
                "entity.name.type.module.js"
            ],
            "settings": { "foreground": "#00BF15" }
        },
        {
            "scope": [
                "keyword.control.at-rule",
                "punctuation.terminator.rule.css",
                "keyword.control.operator",
                "punctuation.definition.entity.css",
                "keyword.operator.assignment.js",
                "punctuation.separator.comma.js",
                "punctuation.definition.string.begin.js",
                "punctuation.definition.string.end.js",
                "punctuation.definition.binding-pattern.object.js"
            ],
            "settings": { "foreground": "#02FEFF" }
        },
        {
            "scope": ["punctuation.definition", "string.quoted.single.scss"],
            "settings": { "foreground": "#ff3300" }
        },
        { "scope": ["keyword.control"], "settings": { "fontStyle": "bold" } },
        {
            "scope": ["keyword.operator.new.js", "keyword.operator.new.ts"],
            "settings": { "foreground": "#0084ff", "fontStyle": "italic" }
        },
        {
            "scope": [
                "comment.line.scss",
                "comment.line.double-slash.js",
                "punctuation.definition.comment.scss",
                "punctuation.definition.comment.js",
                "punctuation.definition.comment.html",
                "comment.block.html"
            ],
            "settings": { "foreground": "#6D6F7C" }
        },
        {
            "scope": [
                "text.html.derivative",
                "new.expr.ts",
                "variable.other.readwrite.alias.ts",
                "entity.name.function.ts"
            ],
            "settings": { "foreground": "#ff008c" }
        },
        {
            "scope": [
                "entity.name.tag",
                "meta.tag.sgml",
                "markup.deleted.git_gutter",
                "meta.var.expr.ts"
            ],
            "settings": { "foreground": "#02FEFF" }
        },
        {
            "scope": [
                "storage.type.class.jsdoc",
                "punctuation.definition.block.tag.jsdoc"
            ],
            "settings": { "foreground": "#0044ff" }
        },
        {
            "scope": [
                "comment.line.double-slash.ts",
                "comment.block.ts",
                "punctuation.definition.comment.ts",
                "comment.block.documentation.ts"
            ],
            "settings": { "foreground": "#00a100b9" }
        },
        {
            "scope": ["entity.name.tag.html"],
            "settings": { "fontStyle": "bold" }
        },
        {
            "scope": [
                "variable.parameter.js",
                "variable.parameter.keyframe-list.css"
            ],
            "settings": { "foreground": "#00ffbf", "fontStyle": "italic" }
        },
        {
            "scope": [
                "variable.other.object.js",
                "storage.type.js",
                "string.other.link.title.markdown",
                "variable.other.property.js"
            ],
            "settings": { "foreground": "#00fff2", "fontStyle": "" }
        },
        {
            "scope": [
                "variable.other.readwrite.js",
                "variable.other.readwrite.ts",
                "variable.other.object.property.ts",
                "keyword.control.conditional.ts"
            ],
            "settings": { "foreground": "#15ff00", "fontStyle": "italic" }
        },
        {
            "scope": [
                "string",
                "string.quoted.double.html",
                "variable.other.constant.js",
                "variable.other.object.property.js",
                "string.quoted.double.json",
                "markup.fenced_code.block.markdown",
                "markup.inline.raw.string.markdown",
                "variable.function",
                "keyword.other.special-method",
                "markup.bold",
                "markup.bold.markdown",
                "markup.italic.markdown",
                "meta.class-method.js entity.name.function.js",
                "variable.function.constructor",
                "entity.name.tag.other.html",
                "entity.name.tag.block.any.html",
                "source.sass keyword.control"
            ],
            "settings": { "foreground": "#FF7306" }
        },
        {
            "scope": ["string.quoted.double.", "string.quoted.single"],
            "settings": { "foreground": "#ff6600" }
        },
        {
            "scope": ["variable.other.readwrite.alias.js"],
            "settings": { "foreground": "#eeff00" }
        },
        {
            "scope": [
                "entity.name.function",
                "variable.other.property.ts",
                "punctuation.terminator.statement.ts"
            ],
            "settings": { "foreground": "#ff00dd", "fontStyle": "italic" }
        },
        {
            "scope": [
                "punctuation.definition.string.begin.html",
                "punctuation.definition.string.end.html"
            ],
            "settings": { "foreground": "#FF0000" }
        },
        {
            "scope": [
                "support.other.variable",
                "string.other.link",
                "markup.table",
                "variable.other.constant.ts",
                "variable.other.object.ts"
            ],
            "settings": { "foreground": "#02FEFF" }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.language",
                "constant.character",
                "constant.escape",
                "keyword.other.unit",
                "keyword.other",
                "punctuation.separator.key-value.html"
            ],
            "settings": { "foreground": "#FF0000" }
        },
        {
            "scope": [
                "variable.parameter.function.language.special",
                "variable.parameter"
            ],
            "settings": { "foreground": "#10FF00" }
        },
        {
            "scope": [
                "constant.other.symbol",
                "constant.other.key",
                "entity.other.inherited-class",
                "keyword.other.unit",
                "markup.heading",
                "markup.inserted.git_gutter",
                "meta.group.braces.curly",
                "constant.other.object.key.js",
                "string.unquoted.label.js",
                "storage.type.ts"
            ],
            "settings": { "foreground": "#FFBD00", "fontStyle": "" }
        },
        {
            "scope": [
                "entity.name",
                "support.type",
                "support.class",
                "support.orther.namespace.use.php",
                "meta.use.php",
                "support.other.namespace.php",
                "markup.changed.git_gutter",
                "support.type.sys-types",
                "entity.other.attribute-name.html"
            ],
            "settings": { "foreground": "#FF0000" }
        },
        { "scope": ["support.type"], "settings": { "foreground": "#B2CCD6" } },
        {
            "scope": [
                "source.css support.type.property-name",
                "source.sass support.type.property-name",
                "source.scss support.type.property-name",
                "source.less support.type.property-name",
                "source.stylus support.type.property-name",
                "source.postcss support.type.property-name"
            ],
            "settings": { "foreground": "#00BF15" }
        },
        {
            "scope": [
                "entity.name.module.js",
                "variable.import.parameter.js",
                "variable.other.class.js"
            ],
            "settings": { "foreground": "#10FF00" }
        },
        {
            "scope": [
                "entity.name.method.js",
                "tag.decorator.js entity.name.tag.js",
                "tag.decorator.js punctuation.definition.tag.js"
            ],
            "settings": { "foreground": "#FF7306", "fontStyle": "italic" }
        },
        {
            "scope": ["entity.other.attribute-name", "support.function"],
            "settings": { "foreground": "#FF0000" }
        },
        {
            "scope": [
                "entity.other.attribute-name.id",
                "entity.other.attribute-name.class",
                "entity.other.attribute-name.pseudo-class",
                "entity.name.tag.css",
                "keyword.control.conditional.js",
                "support.constant",
                "entity.other.attribute-name.html",
                "string.quoted.single.js",
                "meta.object-literal.key"
            ],
            "settings": { "foreground": "#ff3d02" }
        },
        {
            "scope": ["source.scss keyword.control"],
            "settings": { "foreground": "#FF0000" }
        },
        {
            "scope": [
                "markup.inserted",
                "constant.numeric.decimal.ts",
                "keyword.operator.arithmetic.ts",
                "keyword.control.loop.ts"
            ],
            "settings": { "foreground": "#00ffdd" }
        },
        {
            "scope": ["markup.deleted"],
            "settings": { "foreground": "#10FF00" }
        },
        {
            "scope": ["markup.changed"],
            "settings": { "foreground": "#FF0000" }
        },
        { "scope": ["string.regexp"], "settings": { "foreground": "#FF0000" } },
        {
            "scope": ["constant.character.escape"],
            "settings": { "foreground": "#FF0000" }
        },
        {
            "scope": ["*url*", "*link*", "*uri*"],
            "settings": { "fontStyle": "underline" }
        },
        {
            "scope": [
                "source.js constant.other.object.key.js string.unquoted.label.js"
            ],
            "settings": { "foreground": "#ff5202", "fontStyle": "italic" }
        },
        {
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#02FEFF" }
        },
        {
            "scope": [
                "text.html.markdown",
                "punctuation.definition.list_item.markdown",
                "string.quoted.double.ts",
                "string.quoted.single"
            ],
            "settings": { "foreground": "#ff7c02" }
        },
        {
            "scope": ["text.html.markdown markup.inline.raw.markdown"],
            "settings": { "foreground": "#FF0000" }
        },
        {
            "scope": [
                "text.html.markdown markup.inline.raw.markdown",
                "punctuation.definition.raw.markdown"
            ],
            "settings": { "foreground": "#FFE60050" }
        },
        {
            "scope": ["text.html.markdown meta.dummy.line-break"],
            "settings": {}
        },
        {
            "scope": [
                "markdown.heading",
                "markup.heading | markup.heading entity.name",
                "markup.heading.markdown punctuation.definition.heading.markdown",
                "entity.name.section.markdown"
            ],
            "settings": { "foreground": "#00BF15", "fontStyle": "bold" }
        },
        {
            "scope": ["markup.underline"],
            "settings": { "foreground": "#FF7306", "fontStyle": "underline" }
        },
        { "scope": ["markup.strike"], "settings": { "fontStyle": "" } },
        {
            "scope": [
                "markup.quote punctuation.definition.blockquote.markdown"
            ],
            "settings": { "foreground": "#FFE60050" }
        },
        { "scope": ["markup.quote"], "settings": { "fontStyle": "italic" } },
        {
            "scope": ["string.other.link.description.title.markdown"],
            "settings": { "foreground": "#ff5100" }
        },
        {
            "scope": ["constant.other.reference.link.markdown"],
            "settings": { "foreground": "#FF0000" }
        },
        {
            "scope": ["markup.raw.block"],
            "settings": { "foreground": "#FF0000" }
        },
        {
            "scope": [
                "punctuation.definition.raw.markdown",
                "punctuation.definition.markdown"
            ],
            "settings": { "foreground": "#FF0000" }
        },
        {
            "scope": ["variable.language.fenced.markdown"],
            "settings": { "foreground": "#FFE600" }
        },
        {
            "scope": ["meta.separator"],
            "settings": { "foreground": "#A7A8AF", "fontStyle": "bold" }
        },
        {
            "scope": "token.info-token",
            "settings": { "foreground": "#FFE600" }
        },
        {
            "scope": "token.warn-token",
            "settings": { "foreground": "#FF0000" }
        },
        {
            "scope": "token.error-token",
            "settings": {
                "foreground": "#ff0015",
                "fontStyle": "bold underline strikethrough"
            }
        },
        {
            "scope": "token.debug-token",
            "settings": { "foreground": "#FF0000" }
        },
        {
            "scope": ["keyword.control.from.ts", "keyword.control.import.ts"],
            "settings": { "foreground": "#0066ff" }
        }
    ]
}
