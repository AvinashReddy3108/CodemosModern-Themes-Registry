            "settings": { "foreground": "#000000" }
        },
        {
            "scope": ["entity.name.function.js"],
            "settings": { "foreground": "#1FBCFF", "fontStyle": "bold" }
        },
        {
            "scope": ["string.template.js"],
            "settings": { "foreground": "#4e9bff", "fontStyle": "italic" }
        },
        {
            "scope": [
                "list.begin.bracket.curly.css",
                "entity.other.attribute-name.class.css",
                "list.end.bracket.curly.css"
            ],
            "settings": { "foreground": "#00ffb3" }
        },
        {
            "scope": ["error.css"],
            "settings": { "foreground": "#FF0000", "fontStyle": "bold" }
        },
        {
            "scope": ["constant.character.escape.js"],
            "settings": { "foreground": "#0077ff", "fontStyle": "bold" }
        },
        {
            "scope": ["support.type.property-name.css"],
            "settings": { "foreground": "#5dffff", "fontStyle": "bold" }
        },
        {
            "scope": ["support.constant.property-value.css"],
            "settings": { "foreground": "#0084ff" }
        },
        {
            "scope": [
                "entity.other.attribute-name.id.css",
                "punctuation.definition.entity.css"
            ],
            "settings": { "foreground": "#ff95f6" }
        },
        {
            "scope": ["entity.other.attribute-name.class.css"],
            "settings": { "foreground": "#fc59ee" }
        },
        {
            "scope": [
                "punctuation.definition.string.begin.html",
                "punctuation.definition.string.end.html",
                "string.quoted.double.html",
                "string.quoted.single.html"
            ],
            "settings": { "foreground": "#ff8ef9" }
        },
        {
            "scope": ["meta.brace.round"],
            "settings": { "foreground": "#ff00f2" }
        },
        {
            "scope": [
                "support.other.variable",
                "string.other.link",
                "markup.table"
            ],
            "settings": { "foreground": "#009B9E" }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.language",
                "constant.character",
                "constant.escape",
                "keyword.other.unit",
                "keyword.other",
                "punctuation.separator.key-value.html"
            ],
            "settings": { "foreground": "#f952ff" }
        },
        {
            "scope": [
                "variable.parameter.function.language.special",
                "variable.parameter"
            ],
            "settings": { "foreground": "#000000" }
        },
        {
            "scope": [
                "constant.other.symbol",
                "constant.other.key",
                "entity.other.inherited-class",
