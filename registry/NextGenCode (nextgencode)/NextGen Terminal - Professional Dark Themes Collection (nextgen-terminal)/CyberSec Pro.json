    "tokenColors": [
        {
            "name": "Comment - Security Warning",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#6a737d", "fontStyle": "italic" }
        },
        {
            "name": "Security TODO/FIXME/HACK",
            "scope": ["keyword.codetag"],
            "settings": { "foreground": "#ff5722", "fontStyle": "bold" }
        },
        {
            "name": "String - Validated Input",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#4caf50" }
        },
        {
            "name": "String Escape - Sanitized",
            "scope": ["constant.character.escape"],
            "settings": { "foreground": "#66bb6a", "fontStyle": "bold" }
        },
        {
            "name": "Number - Safe Constant",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#00bcd4" }
        },
        {
            "name": "Keyword - Control Flow (Security Critical)",
            "scope": ["keyword.control", "keyword.operator.new"],
            "settings": { "foreground": "#ff9800", "fontStyle": "bold" }
        },
        {
            "name": "Keyword - Authentication",
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#00bcd4" }
        },
        {
            "name": "Function - Secure Method",
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#2196f3" }
        },
        {
            "name": "Class - Data Structure",
            "scope": [
                "entity.name.class",
                "entity.name.type.class",
                "support.class"
            ],
            "settings": { "foreground": "#66bb6a", "fontStyle": "bold" }
        },
        {
            "name": "Variable - Data",
            "scope": ["variable", "support.variable"],
            "settings": { "foreground": "#c9d1d9" }
        },
        {
            "name": "Variable - This/Self (Security Context)",
            "scope": ["variable.language.this", "variable.language.self"],
            "settings": { "foreground": "#ff9800", "fontStyle": "italic" }
        },
        {
            "name": "Property - Encrypted Field",
            "scope": ["variable.object.property", "support.type.property-name"],
            "settings": { "foreground": "#42a5f5" }
        },
        {
            "name": "Constant - Environment Variable",
            "scope": ["variable.other.constant", "constant.other"],
            "settings": { "foreground": "#26c6da", "fontStyle": "bold" }
        },
        {
            "name": "Operator - Security Check",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#4caf50" }
        },
        {
            "name": "SQL/Query - Injection Risk",
            "scope": [
                "keyword.other.DML.sql",
                "constant.other.database-name",
                "constant.other.table-name"
            ],
            "settings": {
                "foreground": "#9c27b0",
                "fontStyle": "bold underline"
            }
        },
        {
            "name": "Regex - Pattern Validation",
            "scope": ["string.regexp"],
            "settings": { "foreground": "#cddc39" }
        },
        {
            "name": "JSON Key - Configuration",
            "scope": [
                "support.type.property-name.json",
                "meta.structure.dictionary.key.json"
            ],
            "settings": { "foreground": "#42a5f5" }
        },
        {
            "name": "HTML/XML Tag - XSS Risk",
            "scope": ["entity.name.tag", "punctuation.definition.tag"],
            "settings": { "foreground": "#ff5722" }
        },
        {
            "name": "HTML Attribute - Input Validation",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#ff9800" }
        },
        {
            "name": "CSS Selector - Styling",
            "scope": [
                "entity.name.tag.css",
                "entity.other.attribute-name.class.css"
            ],
            "settings": { "foreground": "#4caf50" }
        },
        {
            "name": "Import/Require - Dependency",
            "scope": [
                "keyword.control.import",
                "keyword.control.from",
                "meta.import"
            ],
            "settings": { "foreground": "#00bcd4" }
        },
        {
            "name": "Module Name - External Package",
            "scope": ["variable.other.readwrite.module"],
            "settings": { "foreground": "#26c6da" }
        },
        {
            "name": "Decorator/Annotation - Security Marker",
            "scope": [
                "entity.name.function.decorator",
                "meta.decorator",
                "punctuation.decorator"
            ],
            "settings": { "foreground": "#ffc107", "fontStyle": "bold" }
        },
        {
            "name": "Type - Interface/Protocol",
            "scope": ["entity.name.type", "support.type"],
            "settings": { "foreground": "#66bb6a" }
        },
        {
            "name": "Invalid - Security Violation",
            "scope": ["invalid", "invalid.illegal"],
            "settings": {
                "foreground": "#f44336",
                "fontStyle": "bold underline"
            }
        },
        {
            "name": "Deprecated - Insecure Function",
            "scope": ["invalid.deprecated"],
            "settings": {
                "foreground": "#ff9800",
                "fontStyle": "strikethrough"
            }
        },
        {
            "name": "Markup Heading - Documentation",
            "scope": ["markup.heading"],
            "settings": { "foreground": "#4caf50", "fontStyle": "bold" }
        },
        {
            "name": "Markup Link - External Resource",
            "scope": ["markup.underline.link"],
            "settings": { "foreground": "#2196f3", "fontStyle": "underline" }
        },
        {
            "name": "Markup Code - Secure Snippet",
            "scope": ["markup.inline.raw", "markup.fenced_code"],
            "settings": { "foreground": "#66bb6a" }
        },
        {
            "name": "JavaScript - console (Debug)",
            "scope": ["support.type.object.console"],
            "settings": { "foreground": "#ff9800" }
        },
        {
            "name": "JavaScript - Promise/Async (Security Chain)",
            "scope": [
                "storage.type.function.arrow",
                "storage.type.function.async"
            ],
            "settings": { "foreground": "#42a5f5", "fontStyle": "italic" }
        },
        {
            "name": "Python - Self Parameter",
            "scope": ["variable.parameter.function.language.special.self"],
            "settings": { "foreground": "#ff9800", "fontStyle": "italic" }
        },
        {
            "name": "Solidity - Contract",
            "scope": ["storage.type.contract"],
            "settings": { "foreground": "#ffc107", "fontStyle": "bold" }
        },
        {
            "name": "Solidity - Security Modifiers",
            "scope": ["storage.type.modifier"],
            "settings": { "foreground": "#4caf50", "fontStyle": "bold" }
        },
        {
            "name": "Solidity - Events",
            "scope": ["storage.type.event"],
            "settings": { "foreground": "#00bcd4" }
        },
        {
            "name": "Rust - Lifetime",
            "scope": ["storage.modifier.lifetime"],
            "settings": { "foreground": "#ff9800" }
        },
        {
            "name": "Go - Error Handling",
            "scope": ["variable.other.go"],
            "settings": { "foreground": "#c9d1d9" }
        },
        {
            "name": "🔴 HIGH RISK - eval/exec/innerHTML (Dangerous)",
            "scope": [
                "support.function.dangerous",
                "entity.name.function.dangerous",
                "support.function.eval",
                "support.function.exec"
            ],
            "settings": {
                "foreground": "#ff3333",
                "fontStyle": "bold underline"
            }
        },
        {
            "name": "🟠 MEDIUM RISK - document.cookie/localStorage (Warning)",
            "scope": [
                "support.variable.dom",
                "support.class.storage",
                "support.variable.property.dom"
            ],
            "settings": { "foreground": "#ff9800", "fontStyle": "bold" }
        },
        {
            "name": "✅ SAFE - crypto/bcrypt/helmet (Secure)",
            "scope": [
                "support.class.crypto",
                "support.function.secure",
                "entity.name.type.crypto"
            ],
            "settings": { "foreground": "#66bb6a", "fontStyle": "bold" }
        },
        {
            "name": "🚨 XSS Risk - User Input in HTML",
            "scope": [
                "text.html meta.embedded.block.php",
                "text.html meta.embedded.line.php",
                "string.quoted.double.html meta.attribute-with-value.html"
            ],
            "settings": { "foreground": "#ff5722", "fontStyle": "underline" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
