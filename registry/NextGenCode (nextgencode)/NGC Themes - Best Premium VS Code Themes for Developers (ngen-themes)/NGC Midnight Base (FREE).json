    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#6b7280", "fontStyle": "italic" }
        },
        {
            "name": "Strings",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#7dd3a0" }
        },
        {
            "name": "Template Expressions",
            "scope": ["meta.template.expression"],
            "settings": { "foreground": "#d4d4d6" }
        },
        {
            "name": "Regular Expressions",
            "scope": ["string.regexp"],
            "settings": { "foreground": "#7dd3a0" }
        },
        {
            "name": "Numbers",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#e8a5c2" }
        },
        {
            "name": "Constants",
            "scope": [
                "constant.language",
                "constant.character",
                "constant.other"
            ],
            "settings": { "foreground": "#e8a5c2" }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.new",
                "keyword.operator.expression",
                "keyword.operator.logical",
                "storage.type",
                "storage.modifier"
            ],
            "settings": { "foreground": "#6fa0e6" }
        },
        {
            "name": "Operators",
            "scope": ["keyword.operator", "punctuation.accessor"],
            "settings": { "foreground": "#d4d4d6" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "support.variable"],
            "settings": { "foreground": "#e8a5c2" }
        },
        {
            "name": "Parameters",
            "scope": ["variable.parameter", "meta.function.parameter"],
            "settings": { "foreground": "#e8a5c2" }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call"
            ],
            "settings": { "foreground": "#dcc38b" }
        },
        {
            "name": "Classes",
            "scope": [
                "entity.name.class",
                "entity.name.type.class",
                "support.class"
            ],
            "settings": { "foreground": "#6fa0e6" }
        },
        {
            "name": "Types",
            "scope": ["entity.name.type", "support.type"],
            "settings": { "foreground": "#6fa0e6" }
        },
        {
            "name": "Interfaces",
            "scope": ["entity.name.type.interface"],
            "settings": { "foreground": "#6fa0e6" }
        },
        {
            "name": "Properties",
            "scope": [
                "variable.object.property",
                "variable.other.property",
                "support.type.property-name"
            ],
            "settings": { "foreground": "#dcc38b" }
        },
        {
            "name": "Tag Names",
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#6fa0e6" }
        },
        {
            "name": "Tag Attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#dcc38b" }
        },
        {
            "name": "CSS Classes",
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css"
            ],
            "settings": { "foreground": "#6fa0e6" }
        },
        {
            "name": "CSS Properties",
            "scope": ["support.type.property-name.css"],
            "settings": { "foreground": "#dcc38b" }
        },
        {
            "name": "Markdown Headings",
            "scope": ["markup.heading", "entity.name.section.markdown"],
            "settings": { "foreground": "#6fa0e6", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Bold",
            "scope": ["markup.bold"],
            "settings": { "foreground": "#d4d4d6", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Italic",
            "scope": ["markup.italic"],
            "settings": { "foreground": "#d4d4d6", "fontStyle": "italic" }
        },
        {
            "name": "Markdown Links",
            "scope": [
                "markup.underline.link",
                "string.other.link.title.markdown"
            ],
            "settings": { "foreground": "#6fa0e6" }
        },
        {
            "name": "Markdown Code",
            "scope": ["markup.inline.raw", "markup.fenced_code.block.markdown"],
            "settings": { "foreground": "#7dd3a0" }
        },
        {
            "name": "JSON Keys",
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#dcc38b" }
        },
        {
            "name": "Python Decorators",
            "scope": ["meta.function.decorator.python"],
            "settings": { "foreground": "#6fa0e6" }
        },
        {
            "name": "Python Self",
            "scope": ["variable.language.special.self.python"],
            "settings": { "foreground": "#e8a5c2", "fontStyle": "italic" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation.separator",
                "punctuation.terminator",
                "punctuation.definition"
            ],
            "settings": { "foreground": "#d4d4d6" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#ff6b6b" }
        },
        {
            "name": "Deprecated",
            "scope": ["invalid.deprecated"],
            "settings": { "foreground": "#dcc38b" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
