    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#8D8B88", "fontStyle": "italic" }
        },
        {
            "name": "Strings",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#B5A69A" }
        },
        {
            "name": "Numbers and constants",
            "scope": [
                "constant.numeric",
                "constant.language",
                "constant.character",
                "constant.other"
            ],
            "settings": { "foreground": "#D4524F" }
        },
        {
            "name": "Keywords and storage",
            "scope": ["keyword", "storage", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#E44743" }
        },
        {
            "name": "Operators and punctuation",
            "scope": [
                "keyword.operator",
                "punctuation",
                "meta.brace",
                "meta.delimiter"
            ],
            "settings": { "foreground": "#DFDEDC" }
        },
        {
            "name": "Functions and methods",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call",
                "variable.function"
            ],
            "settings": { "foreground": "#F7F5F0" }
        },
        {
            "name": "Types and classes",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.type",
                "support.class",
                "entity.other.inherited-class"
            ],
            "settings": { "foreground": "#B5A69A" }
        },
        {
            "name": "Variables and parameters",
            "scope": [
                "variable",
                "variable.parameter",
                "meta.definition.variable"
            ],
            "settings": { "foreground": "#DFDEDC" }
        },
        {
            "name": "Properties and fields",
            "scope": [
                "variable.other.property",
                "support.variable.property",
                "meta.property-name"
            ],
            "settings": { "foreground": "#D4524F" }
        },
        {
            "name": "Decorators and attributes",
            "scope": [
                "entity.name.function.decorator",
                "meta.decorator",
                "storage.type.annotation",
                "entity.other.attribute-name"
            ],
            "settings": { "foreground": "#B5A69A" }
        },
        {
            "name": "Tags",
            "scope": ["entity.name.tag", "support.class.component"],
            "settings": { "foreground": "#C82C29" }
        },
        {
            "name": "HTML and XML attributes",
            "scope": [
                "entity.other.attribute-name.html",
                "entity.other.attribute-name.xml"
            ],
            "settings": { "foreground": "#D4524F" }
        },
        {
            "name": "CSS selectors",
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css",
                "entity.name.tag.css"
            ],
            "settings": { "foreground": "#B5A69A" }
        },
        {
            "name": "CSS properties",
            "scope": [
                "support.type.property-name.css",
                "support.type.vendored.property-name.css"
            ],
            "settings": { "foreground": "#DFDEDC" }
        },
        {
            "name": "Regular expressions",
            "scope": ["string.regexp", "constant.character.escape"],
            "settings": { "foreground": "#D4524F" }
        },
        {
            "name": "Markdown headings",
            "scope": ["markup.heading", "entity.name.section.markdown"],
            "settings": { "foreground": "#E44743", "fontStyle": "bold" }
        },
        {
            "name": "Markdown links",
            "scope": ["markup.underline.link", "string.other.link"],
            "settings": { "foreground": "#F7F5F0" }
        },
        {
            "name": "Markdown emphasis",
            "scope": ["markup.italic"],
            "settings": { "fontStyle": "italic", "foreground": "#B5A69A" }
        },
        {
            "name": "Markdown strong",
            "scope": ["markup.bold"],
            "settings": { "fontStyle": "bold", "foreground": "#F7F5F0" }
        },
        {
            "name": "JSON keys",
            "scope": [
                "support.type.property-name.json",
                "support.type.property-name.json.comments"
            ],
            "settings": { "foreground": "#D4524F" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#F7F5F0", "background": "#A43331" }
        }
    ],
    "semanticTokenColors": {
        "function": "#F7F5F0",
        "method": "#F7F5F0",
        "macro": "#D4524F",
        "class": "#B5A69A",
        "interface": "#B5A69A",
        "struct": "#B5A69A",
        "enum": "#D4524F",
        "enumMember": "#D4524F",
        "type": "#B5A69A",
        "typeParameter": "#DFDEDC",
        "parameter": "#DFDEDC",
        "variable": "#DFDEDC",
        "property": "#D4524F",
        "decorator": "#B5A69A",
        "namespace": "#F7F5F0",
        "keyword": "#E44743",
        "string": "#B5A69A",
        "number": "#D4524F",
        "comment": { "foreground": "#8D8B88", "italic": true },
        "variable.readonly": "#D4524F",
        "property.readonly": "#D4524F",
        "function.declaration": { "foreground": "#F7F5F0", "bold": true },
        "method.declaration": { "foreground": "#F7F5F0", "bold": true },
        "class.declaration": { "foreground": "#B5A69A", "bold": true }
    }
}
