        "terminal.ansiYellow": "#C4A98A",
        "terminal.ansiBlue": "#6F88A5",
        "terminal.ansiMagenta": "#7A6B73",
        "terminal.ansiCyan": "#8DA5AA",
        "terminal.ansiWhite": "#D8D0C7",
        "terminal.ansiBrightBlack": "#29313B",
        "terminal.ansiBrightRed": "#E18B6B",
        "terminal.ansiBrightGreen": "#9AA094",
        "terminal.ansiBrightYellow": "#D6BA95",
        "terminal.ansiBrightBlue": "#88A3C4",
        "terminal.ansiBrightMagenta": "#99828C",
        "terminal.ansiBrightCyan": "#A8BEC3",
        "terminal.ansiBrightWhite": "#F3EEE8",
