    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#7E837C", "fontStyle": "italic" }
        },
        {
            "name": "Strings",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#C4A98A" }
        },
        {
            "name": "Numbers and constants",
            "scope": [
                "constant.numeric",
                "constant.language",
                "constant.character",
                "constant.other"
            ],
            "settings": { "foreground": "#D6BA95" }
        },
        {
            "name": "Keywords and storage",
            "scope": ["keyword", "storage", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#AA7F60", "fontStyle": "bold" }
        },
        {
            "name": "Operators and punctuation",
            "scope": [
                "keyword.operator",
                "punctuation",
                "meta.brace",
                "meta.delimiter"
            ],
            "settings": { "foreground": "#CFC6BC" }
        },
        {
            "name": "Functions and methods",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call",
                "variable.function"
            ],
            "settings": { "foreground": "#6F88A5" }
        },
        {
            "name": "Types and classes",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.type",
                "support.class",
                "entity.other.inherited-class"
            ],
            "settings": { "foreground": "#C4A98A" }
        },
        {
            "name": "Variables and parameters",
            "scope": [
                "variable",
                "variable.parameter",
                "meta.definition.variable"
            ],
            "settings": { "foreground": "#CFC6BC" }
        },
        {
            "name": "Properties and fields",
            "scope": [
                "variable.other.property",
                "support.variable.property",
                "meta.property-name"
            ],
            "settings": { "foreground": "#C4A98A" }
        },
        {
            "name": "Decorators and attributes",
            "scope": [
                "entity.name.function.decorator",
                "meta.decorator",
                "storage.type.annotation",
                "entity.other.attribute-name"
            ],
            "settings": { "foreground": "#C4A98A" }
        },
        {
            "name": "Tags",
            "scope": ["entity.name.tag", "support.class.component"],
            "settings": { "foreground": "#AA7F60" }
        },
        {
            "name": "HTML and XML attributes",
            "scope": [
                "entity.other.attribute-name.html",
                "entity.other.attribute-name.xml"
            ],
            "settings": { "foreground": "#C4A98A" }
        },
        {
            "name": "CSS selectors",
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css",
                "entity.name.tag.css"
            ],
            "settings": { "foreground": "#C4A98A" }
        },
        {
            "name": "CSS properties",
            "scope": [
                "support.type.property-name.css",
                "support.type.vendored.property-name.css"
            ],
            "settings": { "foreground": "#CFC6BC" }
        },
        {
            "name": "Regular expressions",
            "scope": ["string.regexp", "constant.character.escape"],
            "settings": { "foreground": "#C4A98A" }
        },
        {
            "name": "Markdown headings",
            "scope": ["markup.heading", "entity.name.section.markdown"],
            "settings": { "foreground": "#D97B5D", "fontStyle": "bold" }
        },
        {
            "name": "Markdown links",
            "scope": ["markup.underline.link", "string.other.link"],
            "settings": { "foreground": "#D8D0C7" }
        },
        {
            "name": "Markdown emphasis",
            "scope": ["markup.italic"],
            "settings": { "fontStyle": "italic", "foreground": "#C4A98A" }
        },
        {
            "name": "Markdown strong",
            "scope": ["markup.bold"],
            "settings": { "fontStyle": "bold", "foreground": "#D8D0C7" }
        },
        {
            "name": "JSON keys",
            "scope": [
                "support.type.property-name.json",
                "support.type.property-name.json.comments"
            ],
            "settings": { "foreground": "#C4A98A" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#D8D0C7", "background": "#7A6B73" }
        }
    ],
    "semanticTokenColors": {
        "function": "#6F88A5",
        "method": "#6F88A5",
        "macro": "#C4A98A",
        "class": "#C4A98A",
        "interface": "#C4A98A",
        "struct": "#C4A98A",
        "enum": "#D6BA95",
        "enumMember": "#C4A98A",
        "type": "#C4A98A",
        "typeParameter": "#CFC6BC",
        "parameter": "#D8D0C7",
        "variable": "#CFC6BC",
        "property": "#AFC0C3",
        "decorator": "#AA7F60",
        "namespace": "#D8D0C7",
        "keyword": "#AA7F60",
        "string": "#C4A98A",
        "number": "#D6BA95",
        "comment": { "foreground": "#7E837C", "fontStyle": "italic" },
        "variable.readonly": "#D6BA95",
        "property.readonly": "#D6BA95",
        "function.declaration": { "foreground": "#D8D0C7", "bold": true },
        "method.declaration": { "foreground": "#D8D0C7", "bold": true },
        "class.declaration": { "foreground": "#C4A98A", "bold": true }
    }
}
