        "debugIcon.stopForeground": "#AA7F60",
        "debugIcon.restartForeground": "#CFC6BC",
        "debugIcon.stepOverForeground": "#CFC6BC",
        "debugIcon.stepIntoForeground": "#CFC6BC",
        "debugIcon.stepOutForeground": "#CFC6BC",
        "debugIcon.disconnectForeground": "#7A6B73",
