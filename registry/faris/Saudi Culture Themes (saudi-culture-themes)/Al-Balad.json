    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#7B705F", "fontStyle": "italic" }
        },
        {
            "name": "Strings",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#D2A46E" }
        },
        {
            "name": "Numbers and constants",
            "scope": [
                "constant.numeric",
                "constant.language",
                "constant.character",
                "constant.other"
            ],
            "settings": { "foreground": "#C08A55" }
        },
        {
            "name": "Keywords and storage",
            "scope": ["keyword", "storage", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#6F8F8E", "fontStyle": "bold" }
        },
        {
            "name": "Operators",
            "scope": [
                "keyword.operator",
                "punctuation.separator",
                "punctuation.accessor"
            ],
            "settings": { "foreground": "#A5845A" }
        },
        {
            "name": "Functions and methods",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call",
                "variable.function"
            ],
            "settings": { "foreground": "#E7D8C5" }
        },
        {
            "name": "Types and classes",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.type",
                "support.class",
                "storage.type.class"
            ],
            "settings": { "foreground": "#A5845A" }
        },
        {
            "name": "Variables and properties",
            "scope": [
                "variable",
                "variable.other",
                "support.variable",
                "meta.object-literal.key"
            ],
            "settings": { "foreground": "#D9C3AB" }
        },
        {
            "name": "Parameters",
            "scope": ["variable.parameter", "meta.parameter"],
            "settings": { "foreground": "#E5D4BF" }
        },
        {
            "name": "Decorators and annotations",
            "scope": [
                "meta.decorator",
                "punctuation.decorator",
                "storage.type.annotation"
            ],
            "settings": { "foreground": "#C08A55" }
        },
        {
            "name": "Tags",
            "scope": ["entity.name.tag", "support.class.component"],
            "settings": { "foreground": "#6F8F8E" }
        },
        {
            "name": "Attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#A5845A" }
        },
        {
            "name": "Punctuation",
            "scope": ["punctuation", "meta.brace", "meta.delimiter"],
            "settings": { "foreground": "#A9947C" }
        },
        {
            "name": "Invalid and errors",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#D07A5C", "fontStyle": "bold" }
        },
        {
            "name": "Markup headings",
            "scope": ["markup.heading", "entity.name.section"],
            "settings": { "foreground": "#A5845A", "fontStyle": "bold" }
        },
        {
            "name": "Markup bold",
            "scope": ["markup.bold"],
            "settings": { "foreground": "#E7D8C5", "fontStyle": "bold" }
        },
        {
            "name": "Markup italic",
            "scope": ["markup.italic"],
            "settings": { "foreground": "#D9C3AB", "fontStyle": "italic" }
        },
        {
            "name": "Markup links",
            "scope": ["markup.underline.link", "string.other.link"],
            "settings": { "foreground": "#6F8F8E" }
        },
        {
            "name": "JSON keys",
            "scope": [
                "support.type.property-name.json",
                "meta.mapping.key.yaml"
            ],
            "settings": { "foreground": "#A5845A" }
        },
        {
            "name": "CSS properties",
            "scope": [
                "support.type.property-name.css",
                "support.type.vendored.property-name.css"
            ],
            "settings": { "foreground": "#6F8F8E" }
        },
        {
            "name": "CSS values",
            "scope": [
                "support.constant.property-value.css",
                "constant.other.color.rgb-value.css"
            ],
            "settings": { "foreground": "#D2A46E" }
        }
    ],
    "semanticTokenColors": {
        "function": "#E7D8C5",
        "method": "#E7D8C5",
        "class": "#A5845A",
        "interface": "#6F8F8E",
        "enum": "#C08A55",
        "variable": "#D9C3AB",
        "parameter": "#E5D4BF",
        "property": "#CBA982",
        "decorator": "#C08A55",
        "variable.readonly": "#D2A46E",
        "property.readonly": "#D2A46E",
        "keyword": "#6F8F8E",
        "string": "#D2A46E",
        "number": "#C08A55",
        "comment": { "foreground": "#7B705F", "fontStyle": "italic" },
        "type": "#A5845A",
        "namespace": "#6F8F8E",
        "enumMember": "#D2A46E",
        "macro": "#C08A55",
        "regexp": "#6F8F8E",
        "operator": "#A5845A"
    }
}
