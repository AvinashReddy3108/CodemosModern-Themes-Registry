    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#7A6B32", "fontStyle": "italic" }
        },
        {
            "name": "Strings",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#8A946F" }
        },
        {
            "name": "Numbers and constants",
            "scope": [
                "constant.numeric",
                "constant.language",
                "constant.character",
                "constant.other"
            ],
            "settings": { "foreground": "#B8946B" }
        },
        {
            "name": "Keywords and storage",
            "scope": ["keyword", "storage", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#A44E2E" }
        },
        {
            "name": "Operators and punctuation",
            "scope": [
                "keyword.operator",
                "punctuation",
                "meta.brace",
                "meta.delimiter"
            ],
            "settings": { "foreground": "#7A6B32" }
        },
        {
            "name": "Functions and methods",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call",
                "variable.function"
            ],
            "settings": { "foreground": "#7A6B32" }
        },
        {
            "name": "Types and classes",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.type",
                "support.class",
                "entity.other.inherited-class"
            ],
            "settings": { "foreground": "#8A946F" }
        },
        {
            "name": "Variables and parameters",
            "scope": [
                "variable",
                "variable.parameter",
                "meta.definition.variable"
            ],
            "settings": { "foreground": "#2F2E2B" }
        },
        {
            "name": "Properties and fields",
            "scope": [
                "variable.other.property",
                "support.variable.property",
                "meta.property-name"
            ],
            "settings": { "foreground": "#B8946B" }
        },
        {
            "name": "Decorators and attributes",
            "scope": [
                "entity.name.function.decorator",
                "meta.decorator",
                "storage.type.annotation",
                "entity.other.attribute-name"
            ],
            "settings": { "foreground": "#A44E2E" }
        },
        {
            "name": "Tags",
            "scope": ["entity.name.tag", "support.class.component"],
            "settings": { "foreground": "#A44E2E" }
        },
        {
            "name": "HTML and XML attributes",
            "scope": [
                "entity.other.attribute-name.html",
                "entity.other.attribute-name.xml"
            ],
            "settings": { "foreground": "#B8946B" }
        },
        {
            "name": "CSS selectors",
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css",
                "entity.name.tag.css"
            ],
            "settings": { "foreground": "#8A946F" }
        },
        {
            "name": "CSS properties",
            "scope": [
                "support.type.property-name.css",
                "support.type.vendored.property-name.css"
            ],
            "settings": { "foreground": "#7A6B32" }
        },
        {
            "name": "Regular expressions",
            "scope": ["string.regexp", "constant.character.escape"],
            "settings": { "foreground": "#A44E2E" }
        },
        {
            "name": "Markdown headings",
            "scope": ["markup.heading", "entity.name.section.markdown"],
            "settings": { "foreground": "#A44E2E", "fontStyle": "bold" }
        },
        {
            "name": "Markdown links",
            "scope": ["markup.underline.link", "string.other.link"],
            "settings": { "foreground": "#7A6B32" }
        },
        {
            "name": "Markdown emphasis",
            "scope": ["markup.italic"],
            "settings": { "fontStyle": "italic", "foreground": "#B8946B" }
        },
        {
            "name": "Markdown strong",
            "scope": ["markup.bold"],
            "settings": { "fontStyle": "bold", "foreground": "#2F2E2B" }
        },
        {
            "name": "JSON keys",
            "scope": [
                "support.type.property-name.json",
                "support.type.property-name.json.comments"
            ],
            "settings": { "foreground": "#B8946B" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#F6EFE6", "background": "#A44E2E" }
        }
    ],
    "semanticTokenColors": {
        "function": "#7A6B32",
        "method": "#7A6B32",
        "macro": "#B8946B",
        "class": "#8A946F",
        "interface": "#8A946F",
        "struct": "#8A946F",
        "enum": "#B8946B",
        "enumMember": "#B8946B",
        "type": "#8A946F",
        "typeParameter": "#7A6B32",
        "parameter": "#2F2E2B",
        "variable": "#2F2E2B",
        "property": "#B8946B",
        "decorator": "#A44E2E",
        "namespace": "#7A6B32",
        "keyword": "#A44E2E",
        "string": "#8A946F",
        "number": "#B8946B",
        "comment": { "foreground": "#7A6B32", "italic": true },
        "variable.readonly": "#B8946B",
        "property.readonly": "#B8946B",
        "function.declaration": { "foreground": "#7A6B32", "bold": true },
        "method.declaration": { "foreground": "#7A6B32", "bold": true },
        "class.declaration": { "foreground": "#8A946F", "bold": true }
    }
}
