        "terminal.ansiMagenta": "#A44E2E",
        "terminal.ansiCyan": "#8A946F",
        "terminal.ansiWhite": "#E9E1D3",
        "terminal.ansiBrightBlack": "#7A6B32",
        "terminal.ansiBrightRed": "#A44E2E",
