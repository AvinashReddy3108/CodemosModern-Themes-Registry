{
    "name": "Magic Suite RMScript Light",
    "type": "light",
    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment.line.rmscript"],
            "settings": { "fontStyle": "italic", "foreground": "#808080" }
        },
        {
            "name": "Macros",
            "scope": ["macro.rmscript"],
            "settings": { "foreground": "#0033CC" }
        },
        {
            "name": "Keywords",
            "scope": ["constant.language.rmscript"],
            "settings": { "foreground": "#005086" }
        },
        {
            "name": "Parameter Names",
            "scope": ["parameter.name.rmscript"],
            "settings": { "foreground": "#4E9E31" }
        },
        {
            "name": "Parameter Values",
            "scope": ["parameter.value.rmscript"],
            "settings": { "foreground": "#007272" }
        },
        {
            "name": "Variables",
            "scope": ["variable.rmscript"],
            "settings": { "foreground": "#007272" }
        },
        {
            "name": "List Separators",
            "scope": ["separator.list.rmscript"],
            "settings": { "foreground": "#666" }
        },
        {
            "name": "Operators",
            "scope": ["operator.rmscript"],
            "settings": { "foreground": "#000" }
        },
        {
            "name": "Operators",
            "scope": ["operator.variable.rmscript"],
            "settings": { "foreground": "#884400" }
        },
        {
            "name": "Operators",
            "scope": ["operator.special.rmscript"],
            "settings": { "foreground": "#E545E5" }
        },
        {
            "name": "Numbers",
            "scope": ["constant.numeric.rmscript"],
            "settings": { "foreground": "#6BB799" }
        },
        {
            "name": "Strings",
            "scope": [
                "string.quoted.double.rmscript",
                "string.quoted.single.rmscript",
                "string.quoted.backtick.rmscript"
            ],
            "settings": { "foreground": "#CA2424" }
        },
        {
            "name": "Escapes",
            "scope": ["constant.character.escape.rmscript"],
            "settings": { "foreground": "#FF9933" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
