{
    "name": "Magic Suite NCalc Dark",
    "type": "dark",
    "colors": {},
    "tokenColors": [
        {
            "scope": "keyword.other.ncalc",
            "settings": { "foreground": "#3dc9b0" }
        },
        {
            "scope": "keyword.operator.ncalc, keyword.operator.word.ncalc",
            "settings": { "foreground": "#f3a81e" }
        },
        {
            "scope": "punctuation.bracket.ncalc",
            "settings": { "foreground": "#f3a81e" }
        },
        {
            "scope": "constant.other.date.ncalc",
            "settings": { "foreground": "#d99c13" }
        },
        {
            "scope": "variable.other.bracket.ncalc",
            "settings": { "foreground": "#f3a81e" }
        },
        {
            "scope": "comment.line.double-slash.ncalc, comment.block.ncalc",
            "settings": { "foreground": "#808080" }
        },
        {
            "scope": "string.quoted.single.ncalc",
            "settings": { "foreground": "#ce9178" }
        },
        {
            "scope": "constant.numeric.float.ncalc, constant.numeric.hex.ncalc, constant.numeric.integer.ncalc",
            "settings": { "foreground": "#b5cea8" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
