{
    "name": "Lanciabones Light",
    "type": "light",
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "variable": "#444444",
        "variable.declaration": "#444444",
        "variable.readonly": "#444444",
        "parameter": "#444444",
        "property": "#444444",
        "property.readonly": "#444444",
        "function": "#000000",
        "function.declaration": { "foreground": "#000000", "bold": true },
        "method": "#000000",
        "method.declaration": { "foreground": "#000000", "bold": true },
        "type": { "foreground": "#000000", "italic": true },
        "class": { "foreground": "#000000", "italic": true },
        "interface": { "foreground": "#000000", "italic": true },
        "enum": { "foreground": "#000000", "italic": true },
        "enumMember": "#444444",
        "namespace": "#444444",
        "keyword": { "foreground": "#000000", "bold": true },
        "comment": {
            "foreground": "#000000",
            "background": "#F5E97F",
            "italic": true
        },
        "string": { "foreground": "#000000", "italic": false },
        "number": "#444444",
        "regexp": "#000000",
        "operator": "#444444",
        "decorator": "#000000",
        "macro": { "foreground": "#222222", "bold": true }
    },
