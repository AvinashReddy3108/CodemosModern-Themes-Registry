{
    "type": "dark",
    "colors": {
        "window.activeBorder": "#1F1F24",
        "debugIcon.breakpointForeground": "#ff5f56",
        "editor.background": "#292A30",
        "editor.selectionBackground": "#264f78aa",
        "editor.selectionHighlightBackground": "#264f7855",
        "editorCursor.foreground": "#cfd3d8",
        "editor.lineHighlightBackground": "#ffffff06",
        "editorGutter.addedBackground": "#2f7d4c",
        "editorGutter.modifiedBackground": "#9a7b2f",
        "editorGutter.deletedBackground": "#a14444",
        "sideBar.background": "#1d2023",
        "sideBar.border": "#1A1B1F",
        "statusBar.background": "#1C1C1E",
        "statusBar.foreground": "#C7C7CC",
        "statusBar.border": "#2C2C2E",
        "statusBar.noFolderBackground": "#1C1C1E",
        "statusBarItem.remoteForeground": "#C7C7CC",
        "statusBarItem.hoverBackground": "#2C2C2E",
        "statusBarItem.activeBackground": "#2C2C2E",
        "statusBarItem.prominentForeground": "#0A84FF",
        "statusBarItem.prominentBackground": "#1C1C1E",
        "titleBar.inactiveBackground": "#131416",
        "titleBar.activeBackground": "#2A2D2E",
        "statusBarItem.remoteBackground": "#2A2D2E",
        "sideBarSectionHeader.background": "#2A2D2E",
        "diffEditor.insertedLineBackground": "#2f7d4caa",
        "diffEditor.removedLineBackground": "#a14444aa",
        "diffEditor.insertedTextBackground": "#2f7d4caa",
        "diffEditor.removedTextBackground": "#a14444aa",
        "editorOverviewRuler.modifiedForeground": "#9a7b2f",
        "editorOverviewRuler.addedForeground": "#2f7d4c",
        "editorOverviewRuler.deletedForeground": "#a14444",
        "gitDecoration.addedResourceForeground": "#2f7d4c",
        "gitDecoration.modifiedResourceForeground": "#9a7b2f",
        "gitDecoration.deletedResourceForeground": "#a14444",
        "gitDecoration.untrackedResourceForeground": "#4EC9B0",
        "gitDecoration.ignoredResourceForeground": "#6E7681",
        "gitDecoration.conflictingResourceForeground": "#E06C75",
        "activityBar.background": "#1E1E1E",
        "activityBar.activeBorder": "#0A84FF",
        "activityBarBadge.background": "#0A84FF",
        "activityBarBadge.foreground": "#FFFFFF",
        "activityBarTop.activeBorder": "#0A84FF",
        "tab.activeBorder": "#0A84FF",
        "tab.inactiveBackground": "#1E1E1E",
        "tab.hoverBackground": "#2A2D2E",
        "statusBar.debuggingBackground": "#2c3e50",
        "statusBar.debuggingForeground": "#ffffff",
        "statusBar.debuggingBorder": "#00000000",
        "editorLineNumber.foreground": "#5c6066",
        "editorLineNumber.activeForeground": "#c9ccd1",
        "quickInput.background": "#1b1d20",
        "quickInput.foreground": "#d4d7dc",
        "pickerGroup.foreground": "#6e7681",
        "quickInputList.focusBackground": "#264f78aa",
        "quickInputList.focusForeground": "#ffffff",
        "editorBracketHighlight.foreground1": "#6e7681",
        "editorBracketHighlight.foreground2": "#6e7681",
        "editorBracketHighlight.foreground3": "#5e81ac",
        "editorBracketHighlight.foreground4": "#81a1c1",
        "editorBracketHighlight.foreground5": "#88c0d0",
        "editorBracketHighlight.foreground6": "#a3b1c6",
        "editorBracketMatch.border": "#6ea8ff",
        "editorBracketHighlight.unexpectedBracket.foreground": "#ff5f56",
        "panel.border": "#1A1B1F",
        "panelTitle.activeBorder": "#0A84FF",
        "terminal.foreground": "#D8DEE5",
        "terminalCursor.foreground": "#D8DEE5",
        "terminalCursor.background": "#D8DEE5",
        "terminal.selectionBackground": "#2A2D34",
        "terminal.ansiBlack": "#1B1C20",
        "terminal.ansiRed": "#E06C75",
        "terminal.ansiGreen": "#98C379",
        "terminal.ansiYellow": "#D9C97C",
        "terminal.ansiBlue": "#61AFEF",
        "terminal.ansiMagenta": "#C792EA",
        "terminal.ansiCyan": "#4CA6C0",
        "terminal.ansiWhite": "#D8DEE5",
        "terminal.ansiBrightBlack": "#3A3D44",
        "terminal.ansiBrightRed": "#FF7A85",
        "terminal.ansiBrightGreen": "#B4E88B",
        "terminal.ansiBrightYellow": "#F2DD8A",
        "terminal.ansiBrightBlue": "#7DC4FF",
        "terminal.ansiBrightMagenta": "#D8A8FF",
        "terminal.ansiBrightCyan": "#67CBE7",
        "terminal.ansiBrightWhite": "#FFFFFF"
    },
    "tokenColors": [
        { "scope": "keyword", "settings": { "foreground": "#C792EA" } },
        { "scope": "keyword.control", "settings": { "foreground": "#C792EA" } },
        {
            "scope": "constant.numeric",
            "settings": { "foreground": "#D9C97C" }
        },
        {
            "scope": "entity.name.type",
            "settings": { "foreground": "#6BDFFF" }
        },
        { "scope": "support.type", "settings": { "foreground": "#4CA6C0" } },
        {
            "scope": "entity.name.function",
            "settings": { "foreground": "#4EC9B0" }
        },
        { "scope": "string", "settings": { "foreground": "#F78C6C" } },
        { "scope": "variable", "settings": { "foreground": "#D8DEE5" } },
        {
            "scope": "variable.parameter",
            "settings": { "foreground": "#D8DEE5" }
        },
        {
            "scope": "variable.other.property",
            "settings": { "foreground": "#C7D0D9" }
        },
        {
            "scope": "variable.language",
            "settings": { "foreground": "#7E8A96" }
        },
        { "scope": "comment", "settings": { "foreground": "#6A9955" } },
        { "scope": "keyword", "settings": { "foreground": "#FF7AB2" } },
        { "scope": "storage.type", "settings": { "foreground": "#FF7AB2" } },
        { "scope": "invalid", "settings": { "foreground": "#E51400" } },
        { "scope": "meta.embedded", "settings": { "foreground": "#37acac" } },
        { "scope": "entity.name.tag", "settings": { "foreground": "#37acac" } },
        {
            "scope": ["variable.scss", "support.type.vendored.property-name"],
            "settings": { "foreground": "#37acac", "fontStyle": "bold" }
        },
        { "scope": "comment", "settings": { "foreground": "#6A9955" } },
        {
            "scope": [
                "entity.name.tag.html",
                "entity.name.tag.xml",
                "entity.name.tag.css",
                "entity.name.tag.sass",
                "entity.name.tag.namespace.xmlmeta.tag.xml"
            ],
            "settings": { "foreground": "#C792EA" }
        },
        {
            "scope": [
                "entity.other.attribute-name.html",
                "entity.other.attribute-name.xml",
                "entity.other.attribute-name.css",
                "entity.other.attribute-name.sass",
                "entity.other.attribute-name.localname.xmlmeta.tag.xml"
            ],
            "settings": { "foreground": "#4EC9B0" }
        },
        {
            "scope": [
                "string.quoted.double.html",
                "string.quoted.single.html",
                "string.quoted.double.xml",
                "string.quoted.single.xml",
                "string.quoted.css",
                "string.quoted.sass"
            ],
            "settings": { "foreground": "#F78C6C" }
        },
        {
            "scope": [
                "variable.other.css",
                "variable.other.sass",
                "entity.other.attribute-name.pseudo-class.css"
            ],
            "settings": { "foreground": "#C792EA" }
        },
        {
            "scope": [
                "entity.name.tag.css",
                "entity.other.attribute-name.class.css"
            ],
            "settings": { "foreground": "#D8DEE5" }
        },
        {
            "scope": "entity.name.tag.css",
            "settings": { "foreground": "#3fe764" }
        },
        {
            "scope": ["entity.name.selector.css", "entity.name.selector.sass"],
            "settings": { "foreground": "#FF7AB2" }
        },
        {
            "scope": [
                "support.constant.property-value.css",
                "support.constant.property-value.sass"
            ],
            "settings": { "foreground": "#F78C6C" }
        },
        {
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#E51400" }
        },
        {
            "scope": [
                "support.constant.property-name.css",
                "support.constant.property-name.sass"
            ],
            "settings": { "foreground": "#C586C0" }
        },
        {
            "scope": [
                "entity.other.attribute-name.url.html",
                "entity.other.attribute-name.url.xml",
                "support.constant.url.css"
            ],
            "settings": { "foreground": "#4DA6FF" }
        },
        {
            "scope": "meta.return-type",
            "settings": { "foreground": "#4EC9B0" }
        },
        {
            "scope": "entity.other.inherited-class",
            "settings": { "foreground": "#4EC9B0" }
        },
        {
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#9bdad6" }
        },
        {
            "scope": "entity.name.type.namespace.cs",
            "settings": { "foreground": "#D8DEE5" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
