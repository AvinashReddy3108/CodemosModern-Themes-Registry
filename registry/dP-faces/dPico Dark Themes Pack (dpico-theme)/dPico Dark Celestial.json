    "name": "dPico Dark Celestial",
    "tokenColors": [
        { "scope": "emphasis", "settings": { "fontStyle": "italic" } },
        { "scope": "strong", "settings": { "fontStyle": "bold" } },
        { "scope": "markup.italic", "settings": { "fontStyle": "italic" } },
        { "scope": "markup.bold", "settings": { "fontStyle": "bold" } },
        {
            "scope": "token.info-token",
            "settings": { "foreground": "#6796E6" }
        },
        {
            "scope": "token.warn-token",
            "settings": { "foreground": "#CD9731" }
        },
        {
            "scope": "token.error-token",
            "settings": { "foreground": "#F44747" }
        },
        {
            "scope": "token.debug-token",
            "settings": { "foreground": "#B267E6" }
        },
        {
            "scope": [
                "entity.other.attribute-name",
                "support.type.property-name.css",
                "meta.property-name.css",
                "punctuation.definition.dictionary",
                "punctuation.definition.array",
                "constant.other.table-name.sql",
                "keyword.operator",
                "punctuation.definition.arguments",
                "variable.other.property",
                "variable.other.object.property",
                "variable.other.object",
                "meta.object-literal.key",
                "variable.other.normal.shell",
                "variable.other.readwrite.batchfile"
            ],
            "settings": { "foreground": "#cecece" }
        },
        {
            "scope": [
                "keyword",
                "storage.modifier",
                "storage.type",
                "variable.parameter",
                "markup.underline.link",
                "meta.brace.square",
                "punctuation.section.array",
                "punctuation.definition.begin",
                "punctuation.definition.end",
                "punctuation.definition.parameters",
                "punctuation.definition.block"
            ],
            "settings": { "foreground": "#a8a8a8" }
        },
        {
            "scope": [
                "comment",
                "punctuation.definition.comment",
                "keyword.command.rem.batchfile"
            ],
            "settings": { "foreground": "#626262" }
        },
        {
            "scope": [
                "string",
                "punctuation.definition.string",
                "constant.numeric",
                "constant.language.boolean",
                "constant.language.null",
                "support.type.primitive",
                "support.variable.dom",
                "support.variable.property",
                "meta.property-name",
                "meta.property-value",
                "support.constant.handlebars",
                "markup.italic",
                "markup.bold",
                "markup.inline.raw",
                "markup.raw",
                "markup.fenced_code.block",
                "keyword.other.unit",
                "keyword.other.special-method.batchfile",
                "keyword.other.definition.ini"
            ],
            "settings": { "foreground": "#669ecc" }
        },
        {
            "scope": [
                "entity.name.type",
                "entity.other.inherited-class",
                "entity.name.function",
                "entity.name.function.shell",
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id",
                "support.function",
                "support.type.property-name.json",
                "entity.name.tag",
                "punctuation.definition.tag",
                "keyword.other.sql",
                "keyword.other.DML.sql",
                "keyword.other.LUW.sql",
                "storage.type.sql",
                "storage.modifier.sql",
                "keyword.other.DDL.create.II.sql",
                "markup.heading",
                "punctuation.definition.entity",
                "punctuation.definition.heading",
                "keyword.command.batchfile",
                "keyword.operator.at.batchfile",
                "meta.function-call.generic",
                "variable.parameter.batchfile",
                "variable.other.positional.shell",
                "variable.other.special.shell",
                "entity.name.section.group-title.ini"
            ],
            "settings": { "foreground": "#66c0cc" }
        },
        {
            "scope": [
                "constant",
                "constant.other",
                "constant.other.database-name",
                "variable.other.constant",
                "entity.name.function.preprocessor",
                "variable.language.this",
                "variable.language.special.self",
                "variable.language.super",
                "markup.quote",
                "string.other.link.title",
                "string.other.link.description.markdown",
                "punctuation.definition.template-expression",
                "meta.template.expression",
                "keyword.control.statement.batchfile",
                "keyword.operator.new",
                "keyword.operator.expression.instanceof",
                "keyword.other.new",
                "keyword.operator.expression.typeof",
                "storage.type.function.arrow",
                "keyword.operator.key",
                "variable.parameter.repeat.batchfile"
            ],
            "settings": { "foreground": "#667ccc" }
        }
    ],
    "type": "dark"
}
