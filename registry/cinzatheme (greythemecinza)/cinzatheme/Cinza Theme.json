{
    "name": "Cinza Theme",
    "colors": {
        "editor.background": "#282C34",
        "editor.foreground": "#d8dbe0",
        "activityBarBadge.background": "#757982",
        "sideBarTitle.foreground": "#dee1e6",
        "activityBar.background": "#21252B",
        "activityBar.border": "#3C3C3C",
        "activityBar.activeBorder": "#6f7788",
        "activityBar.activeBackground": "#555962",
        "list.activeSelectionBackground": "#21252B",
        "list.activeSelectionForeground": "#e7eef1",
        "list.focusOutline": "#686969",
        "list.inactiveFocusOutline": "#414040",
        "list.warningForeground": "#d69419",
        "sideBar.background": "#21252B",
        "sideBar.border": "#3f4756",
        "sideBarSectionHeader.background": "#4d515a",
        "sideBarSectionHeader.foreground": "#ccd0db",
        "sideBarTitle.background": "#21252B",
        "focusBorder": "#3e424b",
        "statusBar.background": "#262a32",
        "button.background": "#3c4048",
        "input.background": "#3c4048",
        "input.border": "#4d515a",
        "input.placeholderForeground": "#9fa4ae",
        "input.foreground": "#f3faff",
        "dropdown.background": "#282C34",
        "menu.separatorBackground": "#3c4048",
        "editor.lineHighlightBorder": "#00000000",
        "editor.lineHighlightBackground": "#2d323b",
        "editor.foldBackground": "#00000000"
    },
    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "fontStyle": "italic", "foreground": "#8c8b8d" }
        },
        {
            "name": "Classes",
            "scope": "storage.type.class.python",
            "settings": { "foreground": "#A48BC9", "fontStyle": "italic bold" }
        },
        {
            "name": "builtin",
            "scope": "support.function.builtin.python",
            "settings": { "foreground": "#A48BC9" }
        },
        {
            "name": "instacias",
            "scope": "meta.function-call.arguments.python",
            "settings": { "foreground": "#D19A66", "fontStyle": "italic" }
        },
        {
            "name": "decorator",
            "scope": "meta.function.decorator.python",
            "settings": { "foreground": "#8FA4C2", "fontStyle": "italic" }
        },
        {
            "name": "Functions",
            "scope": "storage.type.function.python",
            "settings": { "foreground": "#D19A66" }
        },
        {
            "name": "self",
            "scope": "variable.language.special.self.python",
            "settings": { "foreground": "#6c8acd", "fontStyle": "italic" }
        },
        { "scope": "invalid", "settings": { "foreground": "#C26677" } },
        {
            "scope": "keyword",
            "settings": { "foreground": "#A48BC9", "fontStyle": "italic" }
        },
        { "scope": "string", "settings": { "foreground": "#A3C183" } },
        { "scope": "variable", "settings": { "foreground": "#CCDDE6" } },
        { "scope": "support", "settings": { "foreground": "#8FA4C2" } },
        {
            "scope": "constant.numeric",
            "settings": { "foreground": "#BF8857" }
        },
        { "scope": "markup.deleted", "settings": { "foreground": "#C26677" } },
        { "scope": "markup.inserted", "settings": { "foreground": "#A3C183" } },
        {
            "scope": "meta.function-call.python",
            "settings": { "foreground": "#8FA4C2" }
        },
        {
            "name": "Pontuacoes",
            "scope": "punctuation.separator",
            "settings": { "foreground": "#adafb3" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
