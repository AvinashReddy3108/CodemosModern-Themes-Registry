{
    "name": "Jewel",
    "type": "dark",
    "colors": {
        "editor.background": "#2B2B2B",
        "editor.foreground": "#A9B7C6"
    },
    "tokenColors": [
        {
            "name": "Source",
            "scope": [
                "entity.name.section.markdown",
                "meta.function-call.arguments.python",
                "meta.use.rust",
                "source",
                "variable.other.object.property.ts",
                "storage.modifier.import",
                "storage.modifier.package",
                "variable.parameter.ts",
                "keyword.operator.assignment.ts",
                "string.template.ts meta.template.expression.ts meta.embedded.line.ts punctuation.accessor.ts",
                "string.template.ts meta.template.expression.ts meta.embedded.line.ts variable.other.object.ts",
                "string.template.ts meta.template.expression.ts meta.embedded.line.ts variable.other.property.ts",
                "string.template.ts meta.template.expression.ts meta.embedded.line.ts variable.other.readwrite.ts",
                "variable.other.object.ts",
                "text.xml",
                "string.other.link.title.markdown "
            ],
            "settings": { "foreground": "#A9B7C6" }
        },
        {
            "name": "Grey",
            "scope": ["punctuation.definition.comment", "comment.line"],
            "settings": { "foreground": "#808080" }
        },
        {
            "name": "Golden",
            "scope": [
                "constant.character.escape",
                "entity.name.function",
                "entity.name.module",
                "entity.name.section.markdown",
                "meta.definition.function.ts entity.name.function.ts",
                "meta.function.definition entity.name.function",
                "punctuation.definition.string.template.begin",
                "punctuation.definition.string.template.end",
                "punctuation.definition.template-expression.begin",
                "punctuation.definition.template-expression.end",
                "support.function.macro",
                "variable.other.constant.clojure",
                "variable.language.documentroot",
                "entity.name.tag",
                "punctuation.definition.annotation",
                "source.yml entity.name",
                "meta.scope.logical-expression.shell"
            ],
            "settings": { "foreground": "#FFC66D" }
        },
        {
            "name": "Orange",
            "scope": [
                "keyword.operator",
                "constant.language",
                "keyword",
                "keyword.local",
                "keyword.operator",
                "meta.bracket.julia",
                "punctuation",
                "storage.type",
                "storage.modifier",
                "constant.language.boolean.false.ts"
            ],
            "settings": { "foreground": "#CC7832" }
        },
        {
            "name": "Pink",
            "scope": ["entity.name.tag.yaml"],
            "settings": { "foreground": "#e67d7d" }
        },
        {
            "name": "Green",
            "scope": [
                "meta.tag.sgml.doctype",
                "string.quoted",
                "punctuation.definition.string",
                "string.unquoted",
                "string",
                "string.template.ts"
            ],
            "settings": { "foreground": "#629755" }
        },
        {
            "name": "Light Blue",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#6897BB" }
        },
        {
            "name": "Darker Blue",
            "scope": [
                "string.other.link.title.markdown.foam",
                "entity.name.function.ts meta.function-call.ts",
                "meta.import.ts meta.block.ts",
                "meta.import.ts variable.other.readwrite.alias.ts",
                "entity.name.function.ts",
                "entity.name.function.ahk",
                "entity.name.function.clojure",
                "entity.name.function.mermaid",
                "support.function.any-method.nim",
                "support.function.julia",
                "support.function.powershell",
                "meta.link.inline.markdown markup.underline.link.markdown",
                "meta.function-call",
                "meta.symbol.namespace",
                "entity.name.function.member",
                "support.function.builtin.python",
                "meta.function-call.python"
            ],
            "settings": { "foreground": "#82AAFF" }
        },
        {
            "name": "White",
            "scope": [
                "support.type",
                "meta.type",
                "entity.other.attribute-name",
                "storage.type.concrete",
                "storage.type.primitive",
                "storage.type.built-in",
                "entity.other.inherited-class",
                "entity.name.type.class",
                "meta.group storage.type",
                "source.json meta.structure support.type",
                "storage.type.annotation",
                "punctuation.definition.typeparameters.begin.ts meta.type.parameters.ts"
            ],
            "settings": { "foreground": "#D1DDE9" }
        },
        {
            "name": "discover",
            "scope": [],
            "settings": { "foreground": "#FF0000" }
        },
        {
            "name": "Purple",
            "scope": [
                "fenced_code.block.language",
                "constant.character.entity",
                "punctuation.separator.key-value.ts",
                "meta.object-literal.key",
                "meta.objectliteral.ts punctuation.definition.block.ts",
                "support.function.magic",
                "support.variable.automatic",
                "support.variable.automatic punctuation.definition.variable"
            ],
            "settings": { "foreground": "#9876AA" }
        },
        {
            "name": "Italic",
            "scope": [
                "markup.italic.markdown",
                "storage.type.annotation",
                "entity.name.function.macro",
                "support.function.macro",
                "markup.list.unnumbered.markdown",
                "punctuation.definition.annotation"
            ],
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "Underline",
            "scope": [
                "fenced_code.block.language",
                "meta.object-literal.key.ts",
                "meta.objectliteral.ts punctuation.definition.block.ts"
            ],
            "settings": { "fontStyle": "underline" }
        },
        {
            "name": "Italic Bold",
            "scope": [
                "support.type",
                "meta.type",
                "storage.type.concrete",
                "storage.type.primitive",
                "storage.type.built-in",
                "entity.other.inherited-class",
                "entity.name.type.class",
                "meta.group storage.type",
                "string.other.link.title.markdown "
            ],
            "settings": { "fontStyle": "italic bold" }
        },
        {
            "name": "Underline",
            "scope": [
                "string.template.ts meta.template.expression.ts meta.embedded.line.ts variable.other.readwrite.ts",
                "string.template.ts meta.template.expression.ts meta.embedded.line.ts punctuation.accessor.ts",
                "string.template.ts meta.template.expression.ts meta.embedded.line.ts variable.other.object.ts",
                "string.template.ts meta.template.expression.ts meta.embedded.line.ts variable.other.property.ts"
            ],
            "settings": { "fontStyle": "underline" }
        },
        {
            "name": "bold",
            "scope": ["markup.bold.markdown", "heading.1.markdown"],
            "settings": { "fontStyle": "bold" }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "class": { "foreground": "#D1DDE9", "fontStyle": "italic bold" },
        "function": { "foreground": "#82AAFF" },
        "parameter": { "italic": true },
        "module": { "bold": true, "foreground": "#9876AA" },
        "variable": {},
        "function.declaration": { "foreground": "#FFC66D" },
        "method.declaration": { "foreground": "#FFC66D" },
        "function.builtin": { "foreground": "#9876AA" },
        "variable.builtin": { "foreground": "#9876AA" },
        "variable.declaration": { "italic": true },
        "selfParameter:python": {
            "foreground": "#9876AA",
            "fontStyle": "italic"
        }
    },
    "$schema": "vscode://schemas/color-theme"
}
