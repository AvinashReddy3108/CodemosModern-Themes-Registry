{
    "name": "Clarity Theme",
    "colors": {
        "activityBar.background": "#00A3E0",
        "activityBar.foreground": "#ffffff",
        "activityBar.activeBackground": "#0077A3",
        "activityBar.activeBorder": "#ffffff",
        "activityBar.inactiveForeground": "#ffffff",
        "activityBarBadge.background": "#ffffff",
        "activityBarBadge.foreground": "#00A3E0",
        "sideBar.background": "#1e1e1e",
        "sideBar.foreground": "#cccccc",
        "sideBar.border": "#00A3E0",
        "statusBar.background": "#00A3E0",
        "statusBar.foreground": "#ffffff",
        "statusBar.border": "#0077A3",
        "statusBar.noFolderBackground": "#0077A3",
        "statusBar.debuggingBackground": "#0077A3",
        "tab.activeBorder": "#00A3E0",
        "tab.unfocusedActiveBorder": "#00A3E0",
        "tab.activeBackground": "#1e1e1e",
        "tab.inactiveBackground": "#2d2d2d",
        "tab.activeForeground": "#ffffff",
        "tab.inactiveForeground": "#969696",
        "tab.border": "#252526",
        "tab.hoverBackground": "#2a2a2a",
        "tab.hoverForeground": "#ffffff",
        "titleBar.activeBackground": "#00A3E0",
        "titleBar.inactiveBackground": "#00A3E0",
        "titleBar.activeForeground": "#ffffff",
        "titleBar.inactiveForeground": "#e6e6e6",
        "titleBar.border": "#0077A3",
        "button.background": "#00A3E0",
        "button.foreground": "#ffffff",
        "button.hoverBackground": "#0088c7",
        "input.background": "#1e1e1e",
        "input.foreground": "#ffffff",
        "input.border": "#00A3E0",
        "inputOption.activeBorder": "#00A3E0",
        "editorGroupHeader.tabsBackground": "#1e1e1e",
        "editorGroupHeader.noTabsBackground": "#1e1e1e",
        "editorGroupHeader.tabsBorder": "#00A3E0",
        "toolbar.activeBackground": "#0077A3",
        "toolbar.hoverBackground": "#006a94",
        "icon.foreground": "#ffffff",
        "panel.background": "#1e1e1e",
        "panel.border": "#00A3E0",
        "panelTitle.activeBorder": "#00A3E0",
        "panelTitle.activeForeground": "#ffffff",
        "panelTitle.inactiveForeground": "#cccccc",
        "editor.background": "#1e1e1e",
        "editor.foreground": "#d4d4d4",
        "editorLineNumber.foreground": "#858585",
        "editorLineNumber.activeForeground": "#00A3E0",
        "editorCursor.foreground": "#00A3E0",
        "editor.selectionBackground": "#264f78",
        "editor.selectionHighlightBackground": "#264f7840",
        "list.activeSelectionBackground": "#333333",
        "list.activeSelectionForeground": "#ffffff",
        "list.inactiveSelectionBackground": "#2a2a2a",
        "list.hoverBackground": "#3a3a3a",
        "list.focusOutline": "#00A3E0",
        "list.selectionOutline": "#00A3E0",
        "list.hoverOutline": "#0077A3",
        "quickInput.background": "#1e1e1e",
        "quickInput.foreground": "#ffffff",
        "scrollbarSlider.background": "#79797966",
        "scrollbarSlider.hoverBackground": "#646464b3",
        "scrollbarSlider.activeBackground": "#bfbfbf66",
        "badge.background": "#00A3E0",
        "badge.foreground": "#ffffff",
        "notification.background": "#252526",
        "notification.foreground": "#cccccc",
        "notification.border": "#00A3E0",
        "widget.shadow": "#00000050",
        "editorWidget.background": "#252526",
        "editorWidget.border": "#00A3E0",
        "dropdown.background": "#1e1e1e",
        "dropdown.foreground": "#ffffff",
        "dropdown.border": "#00A3E0"
    },
    "tokenColors": [
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#6A9955", "fontStyle": "italic" }
        },
        {
            "scope": ["string", "string.quoted"],
            "settings": { "foreground": "#ce9178" }
        },
        {
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#569cd6" }
        },
        {
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#dcdcaa" }
        },
        {
            "scope": ["entity.name.type", "entity.name.class", "support.class"],
            "settings": { "foreground": "#4ec9b0" }
        },
        {
            "scope": ["variable", "entity.name.variable"],
            "settings": { "foreground": "#9cdcfe" }
        },
        {
            "scope": ["constant.numeric", "constant.language"],
            "settings": { "foreground": "#b5cea8" }
        },
        {
            "scope": ["constant.character.escape"],
            "settings": { "foreground": "#d7ba7d" }
        },
        {
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#569cd6" }
        },
        {
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#9cdcfe" }
        },
        {
            "scope": ["support.type.property-name"],
            "settings": { "foreground": "#9cdcfe" }
        },
        {
            "scope": ["markup.heading"],
            "settings": { "foreground": "#569cd6", "fontStyle": "bold" }
        },
        {
            "scope": ["markup.bold"],
            "settings": { "foreground": "#569cd6", "fontStyle": "bold" }
        },
        { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
        {
            "scope": ["markup.inline.raw"],
            "settings": { "foreground": "#ce9178" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
