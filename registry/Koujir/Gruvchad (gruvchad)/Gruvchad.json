            "settings": { "foreground": "#e0c080" }
        },
        {
            "scope": ["variable.this", "support.variable"],
            "settings": { "foreground": "#cc7f94" }
        },
        {
            "scope": [
                "entity.name",
                "entity.static",
                "entity.name.class.static.function",
                "entity.name.function",
                "entity.name.class",
                "entity.name.type"
