{
    "colorspacename": "sRGB",
    "name": "Niji Shine",
    "semanticclass": "Niji.Shine.dark",
    "type": "dark",
    "colors": {
        "editor.background": "#353541",
        "editor.foreground": "#cccccc",
        "editor.lineHighlightBackground": "#aaaaaa25",
        "editor.selectionBackground": "#aaaaaa25",
        "editorLineNumber.foreground": "#888888",
        "editorCursor.background": "#ffffff00",
        "editorCursor.foreground": "#ffffff37",
        "statusBar.background": "#1f1f25",
        "statusBar.noFolderBackground": "#1f1f25",
        "statusBar.debuggingBackground": "#1f1f25",
        "statusBar.foreground": "#cccccc",
        "activityBar.foreground": "#ffffff",
        "panelTitle.activeBorder": "#ea5b76",
        "pickerGroup.border": "#6495cf",
        "pickerGroup.foreground": "#6495cf",
        "list.focusBackground": "#464646",
        "list.activeSelectionBackground": "#2c2c35",
        "list.inactiveSelectionBackground": "#24242b",
        "list.hoverBackground": "#24242b",
        "statusBar.border": "#42424e",
        "sideBar.border": "#42424e",
        "sideBar.background": "#1f1f25",
        "activityBar.border": "#42424e",
        "activityBar.background": "#1f1f25"
    },
    "tokenColors": [
        {
            "settings": {
                "background": "#353541",
                "foreground": "#ccc",
                "caret": "#fff",
                "lineHighlight": "#aaaaaa25",
                "selection": "#aaaaaa25",
                "selectionBorder": "#aaaaaa25"
            }
        },
        {
            "scope": "comment",
            "settings": { "foreground": "#6b6b6b", "fontStyle": "italic" }
        },
        {
            "scope": "constant.numeric",
            "settings": { "foreground": "#d7a96b" }
        },
        {
            "scope": "constant.language",
            "settings": { "foreground": "#eb613f" }
        },
        {
            "scope": "constant.character.escape",
            "settings": { "foreground": "#ee762e" }
        },
        {
            "scope": "constant.other.placeholder",
            "settings": { "foreground": "#fff03c" }
        },
        { "scope": "constant.other", "settings": { "foreground": "#f19557" } },
        {
            "scope": "variable.other.constant",
            "settings": { "foreground": "#ccc" }
        },
        {
            "scope": "entity.name.constant",
            "settings": { "foreground": "#ccc" }
        },
        { "scope": "entity.name", "settings": { "foreground": "#fed552" } },
        {
            "scope": "entity.name.class",
            "settings": { "foreground": "#99b7dc" }
        },
        {
            "scope": "entity.name.type",
            "settings": { "foreground": "#fed552" }
        },
        {
            "scope": "entity.other.inherited-class",
            "settings": { "foreground": "#eceb70" }
        },
        {
            "scope": "entity.name.function",
            "settings": { "foreground": "#6495cf" }
        },
        { "scope": "entity.name.tag", "settings": { "foreground": "#92cfbb" } },
        {
            "scope": "entity.name.section",
            "settings": { "foreground": "#7278a8" }
        },
        {
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#7e6ca8" }
        },
        { "scope": "invalid", "settings": { "foreground": "#d1342c" } },
        {
            "scope": "invalid.illegal",
            "settings": { "background": "#f7e78e", "foreground": "#b63b40" }
        },
        {
            "scope": "invalid.deprecated",
            "settings": { "background": "#f7e78e", "foreground": "#e22b30" }
        },
        { "scope": "keyword", "settings": { "foreground": "#ea5b76" } },
        { "scope": "keyword.control", "settings": { "foreground": "#ea5b76" } },
        {
            "scope": "keyword.operator",
            "settings": { "foreground": "#b5b1e1" }
        },
        {
            "scope": "punctuation.definition.keyword",
            "settings": { "foreground": "#b5b1e1" }
        },
        {
            "scope": "punctuation.definition.string",
            "settings": { "foreground": "#ed90ba" }
        },
        {
            "scope": "punctuation.definition.variable",
            "settings": { "foreground": "#6495cf" }
        },
        {
            "scope": "punctuation.definition.template-expression",
            "settings": { "foreground": "#ed90ba" }
        },
        { "scope": "storage.type", "settings": { "foreground": "#fed552" } },
        {
            "scope": "storage.modifier",
            "settings": { "foreground": "#fed552" }
        },
        { "scope": "string.regexp", "settings": { "foreground": "#92cfbb" } },
        { "scope": "string", "settings": { "foreground": "#58a6dc" } },
        { "scope": "string.quoted", "settings": { "foreground": "#58a6dc" } },
        { "scope": "support", "settings": { "foreground": "#fed552" } },
        {
            "scope": "support.constant",
            "settings": { "foreground": "#f5ad3b" }
        },
        { "scope": "support.module", "settings": { "foreground": "#efb864" } },
        {
            "scope": "support.function",
            "settings": { "foreground": "#7e6ca8" }
        },
        { "scope": "support.class", "settings": { "foreground": "#c7b83c" } },
        { "scope": "support.type", "settings": { "foreground": "#fed552" } },
        {
            "scope": "variable.parameter",
            "settings": { "foreground": "#9bce92" }
        },
        {
            "scope": "variable.function",
            "settings": { "foreground": "#6495cf" }
        },
        {
            "scope": "variable.language",
            "settings": { "foreground": "#b63b40" }
        },
        {
            "scope": "meta.function-call.generic",
            "settings": { "foreground": "#6495cf" }
        },
        { "scope": "markup.heading", "settings": { "foreground": "#6495cf" } },
        {
            "scope": "markup.list.unnumbered",
            "settings": { "foreground": "#f1becb" }
        },
        {
            "scope": "markup.list.numbered",
            "settings": { "foreground": "#f1becb" }
        },
        {
            "scope": "markup.bold",
            "settings": { "foreground": "#92cfbb", "fontStyle": "bold" }
        },
        {
            "scope": "markup.italic",
            "settings": { "foreground": "#92cfbb", "fontStyle": "italic" }
        },
        {
            "scope": "markup.underline",
            "settings": { "foreground": "#92cfbb" }
        },
        {
            "scope": "markup.inserted",
            "settings": { "foreground": "#92cfbb", "background": "#454341" }
        },
        {
            "scope": "markup.deleted",
            "settings": { "foreground": "#7f6575", "background": "#454341" }
        },
        {
            "scope": "entity.name.type.class",
            "settings": { "foreground": "#99b7dc" }
        },
        {
            "scope": "constant.character.format.placeholder",
            "settings": { "foreground": "#fff03c" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
