    "tokenColors": [
        {
            "scope": [
                "source",
                "support.type.property-name.css",
                "variable",
                "meta.variable",
                "variable.other.object.property",
                "variable.other.readwrite.alias",
                "variable.parameter",
                "meta.parameter",
                "variable.other.property",
                "meta.property",
                "constant.character.escape",
                "constant.other.placeholder",
                "constant.language.boolean",
                "constant.language.json",
                "variable.function",
                "punctuation",
                "punctuation.terminator",
                "punctuation.definition.tag",
                "punctuation.separator",
                "punctuation.definition.string",
                "punctuation.section.block",
                "variable.readonly"
            ],
            "settings": { "foreground": "#dedede" }
        },
        {
            "scope": [
                "variable.other.constant",
                "entity.name.function.method",
                "meta.function.method",
                "variable.other.object",
                "entity.name.function.preprocessor",
                "markup.underline.link",
                "support.type",
                "constant.language.boolean.json",
                "support.type.property-name",
                "entity.name.tag.yaml"
            ],
            "settings": { "foreground": "#007eea" }
        },
        {
            "scope": [
                "entity.name.type.class",
                "entity.name.type.struct",
                "entity.name.type.enum",
                "entity.name.namespace",
                "storage.modifier.namespace",
                "markup.bold.markdown",
                "variable.type.parameter",
                "variable.parameter.type",
                "meta.decorator",
                "punctuation.decorator",
                "entity.name.function.decorator",
                "storage.type.numeric.go",
                "storage.type.byte.go",
                "storage.type.boolean.go",
                "storage.type.string.go",
                "storage.type.uintptr.go",
                "storage.type.error.go",
                "storage.type.rune.go",
                "constant.language.go",
                "support.class.dart",
                "keyword.other.documentation",
                "storage.modifier.import.java",
                "punctuation.definition.list.begin.markdown",
                "punctuation.definition.quote.begin.markdown",
                "meta.separator.markdown",
                "entity.name.section.markdown"
            ],
            "settings": { "foreground": "#ffe926" }
        },
        {
            "scope": [
                "entity.name.type.interface",
                "entity.name.type",
                "meta.object-literal.key",
                "support.function",
                "meta.function-call.generic",
                "meta.attribute",
                "keyword.channel.go",
                "keyword.other.platform.os.swift",
                "constant.numeric.decimal.tsx"
            ],
            "settings": { "foreground": "#984cff" }
        },
        {
            "scope": [
                "entity.other.attribute-name",
                "keyword.operator.address.go",
                "keyword.operator.arithmetic",
                "keyword.operator.assignment",
                "keyword.operator.bitwise",
                "keyword.operator.comparison",
                "keyword.operator.custom.infix.swift",
                "keyword.operator.decrement",
                "keyword.operator.expression",
                "keyword.operator.increment",
                "keyword.operator.logical",
                "keyword.operator.pointer.go",
                "keyword.operator.relational",
                "keyword.other.definition.ini"
            ],
            "settings": { "foreground": "#ff4963" }
        },
        {
            "scope": [
                "support.class.component",
                "entity.name.tag",
                "support.variable",
                "entity.name.function.ts"
            ],
            "settings": { "foreground": "#21dcff" }
        },
        {
            "scope": "entity.name.function",
            "settings": { "foreground": "#57c3ff" }
        },
        {
            "scope": [
                "variable.other.global",
                "variable.language.this",
                "meta.preprocessor",
                "entity.name.label",
                "punctuation.definition.label",
                "markup.italic.markdown",
                "support.type.python",
                "variable.legacy.builtin.python",
                "support.constant.property-value.css",
                "storage.modifier.attribute.swift"
            ],
            "settings": { "foreground": "#2be9f8" }
        },
        {
            "scope": "variable.other.local",
            "settings": { "foreground": "#00244b" }
        },
        {
            "scope": [
                "string",
                "string.quoted.single.tsx",
                "keyword.control.export"
            ],
            "settings": { "foreground": "#e8d873" }
        },
        {
            "scope": ["string.other.link", "markup.inline.raw.string.markdown"],
            "settings": { "foreground": "#00e65c" }
        },
        {
            "scope": ["keyword", "keyword.operator"],
            "settings": { "foreground": "#fc6e28" }
        },
        {
            "scope": [
                "keyword.control.import",
                "keyword.control.from",
                "keyword.import",
                "storage.modifier",
                "keyword.modifier",
                "storage.type",
                "keyword.control.exception",
                "keyword.control.trycatch",
                "punctuation.definition.heading.markdown"
            ],
            "settings": { "foreground": "#f038f6" }
        },
        {
            "scope": [
                "comment",
                "punctuation.definition.comment",
                "comment.documentation",
                "comment.line.documentation"
            ],
            "settings": { "foreground": "#a3a3b3" }
        },
        {
            "scope": [
                "constant.numeric",
                "meta.group.regexp",
                "constant.other.php",
                "support.constant.ext.php",
                "constant.other.class.php",
                "support.constant.core.php",
                "fenced_code.block.language",
                "constant.other.caps.python",
                "support.type.exception.python",
                "source.css keyword.other.unit",
                "variable.other.object.property.js.jsx",
                "variable.other.object.js"
            ],
            "settings": { "foreground": "#e1e34e" }
        },
        {
            "scope": ["entity.name.module", "storage.modifier.module"],
            "settings": { "foreground": "#fa2948" }
        },
        {
            "scope": [
                "constant",
                "support.class",
                "support.constant",
                "text.html.markdown string",
                "source.css support.function",
                "source.php support.function",
                "support.function.magic.python",
                "entity.other.attribute-name.id",
                "markup.deleted"
            ],
            "settings": { "foreground": "#ff2f46" }
        }
    ]
}
