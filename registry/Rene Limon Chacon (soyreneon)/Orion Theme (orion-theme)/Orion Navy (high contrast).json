        "editorIndentGuide.background1": "#071727",
        "list.activeSelectionBackground": "#00244b",
        "list.inactiveSelectionBackground": "#00244b",
        "editor.findMatchBackground": "#003ef1",
        "tab.unfocusedInactiveModifiedBorder": "#003ef1",
        "inputValidation.infoBorder": "#003ef1",
