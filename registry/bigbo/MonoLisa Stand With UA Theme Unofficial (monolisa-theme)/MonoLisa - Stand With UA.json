{
    "$schema": "vscode://schemas/color-theme",
    "name": "Cobalt2 - Stand With UA",
    "type": "dark",
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "function": { "foreground": "#edd51c" },
        "variable": "#fff",
        "interface": { "foreground": "#86b7fc", "italic": true },
        "type": { "foreground": "#86b7fc", "italic": true },
        "property": "#9effff"
    },
    "colors": {
