            "scope": ["variable.language.fenced.markdown"],
            "settings": { "foreground": "#424242" }
        },
        {
            "scope": ["meta.separator"],
            "settings": { "foreground": "#424242", "fontStyle": "bold" }
        },
        { "scope": ["markup.table"], "settings": { "foreground": "#C0C0C0" } },
