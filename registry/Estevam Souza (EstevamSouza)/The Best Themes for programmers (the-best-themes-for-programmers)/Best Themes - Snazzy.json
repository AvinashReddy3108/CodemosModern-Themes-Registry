        "editorOverviewRuler.errorForeground": "#ff5c5780",
        "editorOverviewRuler.incomingContentForeground": "#585a61",
        "editorOverviewRuler.infoForeground": "#9aedfe80",
        "editorOverviewRuler.modifiedForeground": "#9aedfe80",
        "editorOverviewRuler.selectionHighlightForeground": "#F3F99D",
        "editorOverviewRuler.warningForeground": "#ffbc5880",
        "editorOverviewRuler.wordHighlightForeground": "#9aedfe",
        "editorOverviewRuler.wordHighlightStrongForeground": "#5af78e",
        "editorRuler.foreground": "#4d4e4f",
        "editorSuggestWidget.background": "#232631",
        "editorSuggestWidget.foreground": "#eff0eb",
        "editorSuggestWidget.selectedBackground": "#40414a",
        "editorWarning.foreground": "#9aedfe",
        "editorWhitespace.foreground": "#4d4e4f",
        "editorWidget.background": "#181b29",
        "errorForeground": "#ff5c57",
        "extensionButton.prominentBackground": "#5af78e90",
        "extensionButton.prominentForeground": "#eff0eb",
        "extensionButton.prominentHoverBackground": "#5af78e60",
        "focusBorder": "#585a61",
        "foreground": "#eff0eb",
        "gitDecoration.conflictingResourceForeground": "#F3F99D",
        "gitDecoration.deletedResourceForeground": "#ff5c57",
        "gitDecoration.ignoredResourceForeground": "#4d4e4f",
        "gitDecoration.modifiedResourceForeground": "#9aedfe",
        "gitDecoration.untrackedResourceForeground": "#5af78e",
        "input.background": "#141622",
        "input.border": "#2c2f3f",
        "input.foreground": "#eff0eb",
        "input.placeholderForeground": "#4d4e4f",
        "inputOption.activeBorder": "#585a61",
        "inputValidation.errorBorder": "#ff5c57",
        "inputValidation.infoBorder": "#ff6ac1",
        "inputValidation.warningBorder": "#F3F99D",
        "list.activeSelectionBackground": "#40414a",
        "list.activeSelectionForeground": "#eff0eb",
        "list.dropBackground": "#40414a",
        "list.errorForeground": "#ff5c57",
        "list.focusBackground": "#40414a",
        "list.highlightForeground": "#9aedfe",
        "list.hoverBackground": "#40414a",
        "list.inactiveSelectionBackground": "#40414a",
        "list.warningForeground": "#F3F99D",
        "listFilterWidget.background": "#181b29",
        "listFilterWidget.noMatchesOutline": "#ff5c57",
        "listFilterWidget.outline": "#4d4e4f",
        "merge.currentHeaderBackground": "#5af78e90",
        "merge.incomingHeaderBackground": "#585a6190",
        "panel.background": "#141622",
        "panel.border": "#2c2f3f",
        "panelTitle.activeBorder": "#ff6ac1",
        "panelTitle.activeForeground": "#eff0eb",
        "panelTitle.inactiveForeground": "#eff0eb",
        "peekView.border": "#5af78e",
        "peekViewEditor.background": "#141622",
        "peekViewEditor.matchHighlightBackground": "#ffbc5880",
        "peekViewResult.background": "#232631",
        "peekViewResult.fileForeground": "#eff0eb",
        "peekViewResult.lineForeground": "#eff0eb",
        "peekViewResult.matchHighlightBackground": "#ffbc5880",
        "peekViewResult.selectionBackground": "#40414a",
        "peekViewResult.selectionForeground": "#eff0eb",
        "peekViewTitle.background": "#2c2f3f",
        "peekViewTitleDescription.foreground": "#57c7ff",
        "peekViewTitleLabel.foreground": "#eff0eb",
        "pickerGroup.border": "#585a61",
        "pickerGroup.foreground": "#9aedfe",
        "progressBar.background": "#ff6ac1",
        "selection.background": "#585a61",
        "settings.checkboxBackground": "#232631",
        "settings.checkboxBorder": "#2c2f3f",
        "settings.checkboxForeground": "#eff0eb",
        "settings.dropdownBackground": "#232631",
        "settings.dropdownBorder": "#2c2f3f",
        "settings.dropdownForeground": "#eff0eb",
        "settings.headerForeground": "#eff0eb",
        "settings.modifiedItemIndicator": "#ff6ac1",
        "settings.numberInputBackground": "#232631",
        "settings.numberInputBorder": "#2c2f3f",
        "settings.numberInputForeground": "#eff0eb",
        "settings.textInputBackground": "#232631",
        "settings.textInputBorder": "#2c2f3f",
        "settings.textInputForeground": "#eff0eb",
        "sideBar.background": "#181b29",
        "sideBar.border": "#2c2f3f",
        "sideBarSectionHeader.background": "#141622",
        "sideBarSectionHeader.border": "#2c2f3f",
        "sideBarTitle.foreground": "#eff0eb",
        "statusBar.background": "#181b29",
        "statusBar.debuggingBackground": "#ff5c57",
        "statusBar.debuggingForeground": "#eff0eb",
        "statusBar.foreground": "#585a61",
        "statusBar.noFolderBackground": "#141622",
        "statusBar.noFolderForeground": "#eff0eb",
        "statusBarItem.prominentBackground": "#ff5c57",
        "statusBarItem.prominentHoverBackground": "#F3F99D",
        "tab.activeBackground": "#181b29",
        "tab.activeBorder": "#ff6ac1",
        "tab.border": "#2c2f3f",
        "tab.inactiveBackground": "#141622",
        "tab.inactiveForeground": "#585a61",
        "terminal.ansiBlack": "#141622",
        "terminal.ansiBlue": "#57c7ff",
        "terminal.ansiBrightBlack": "#585a61",
        "terminal.ansiBrightBlue": "#57c7ff",
        "terminal.ansiBrightCyan": "#9aedfe",
        "terminal.ansiBrightGreen": "#5af78e",
        "terminal.ansiBrightMagenta": "#ff6ac1",
        "terminal.ansiBrightRed": "#ff5c57",
        "terminal.ansiBrightWhite": "#eff0eb",
        "terminal.ansiBrightYellow": "#F3F99D",
        "terminal.ansiCyan": "#9aedfe",
        "terminal.ansiGreen": "#5af78e",
        "terminal.ansiMagenta": "#ff6ac1",
        "terminal.ansiRed": "#ff5c57",
        "terminal.ansiWhite": "#eff0eb",
        "terminal.ansiYellow": "#F3F99D",
        "titleBar.activeBackground": "#181b29",
        "titleBar.activeForeground": "#eff0eb",
        "titleBar.inactiveBackground": "#2c2f3f",
        "titleBar.inactiveForeground": "#585a61",
        "walkThrough.embeddedEditorBackground": "#232631"
    },
    "tokenColors": [
        { "scope": "strong, markup.bold", "settings": { "fontStyle": "bold" } },
        {
            "scope": "emphasis, markup.italic",
            "settings": { "fontStyle": "italic" }
        },
        {
            "scope": "markup.underline",
            "settings": { "fontStyle": "underline" }
        },
        {
            "scope": "comment, punctuation.definition.comment, string.quoted.docstring",
            "settings": { "foreground": "#4D4E4F", "fontStyle": "italic" }
        },
        { "scope": "storage.type", "settings": { "foreground": "#F3F99D" } },
        {
            "scope": "storage.type.primitive, support.type, entity.name.type, keyword.type, keyword.other.unit",
            "settings": { "foreground": "#9AEDFE" }
        },
        {
            "scope": "string, meta.structure.dictionary.json string.quoted.double.json",
            "settings": { "foreground": "#5AF78E" }
        },
        {
            "scope": "constant.language.boolean",
            "settings": { "foreground": "#B76AFF" }
        },
        {
            "scope": "constant.numeric, support.constant",
            "settings": { "foreground": "#F3F99D" }
        },
        {
            "scope": "constant.language.null",
            "settings": { "foreground": "#FF5C57" }
        },
        {
            "scope": "constant.language.undefined",
            "settings": { "foreground": "#FF6AC1" }
        },
        {
            "scope": "meta.function entity.name.function",
            "settings": { "foreground": "#57C7FF" }
        },
        {
            "scope": "entity.name.function, meta.function-call, support.function, keyword.other.special-method, meta.require, variable.language.super, keyword.other.get, keyword.other.set",
            "settings": { "foreground": "#57C7FF" }
        },
        {
            "scope": "variable, support.variable, support.class, support.constant, meta.definition.variable entity.name.function",
            "settings": { "foreground": "#EFF0EB" }
        },
        {
            "scope": "variable.other.constant.property",
            "settings": { "foreground": "#F3F99D" }
        },
        {
            "scope": "entity.name.type.class",
            "settings": { "foreground": "#FF5C57" }
        },
        {
            "scope": "entity.other.inherited-class entity.name.type.module",
            "settings": { "foreground": "#FF5C57" }
        },
        {
            "scope": "variable.object.property",
            "settings": { "foreground": "#F3F99D" }
        },
        {
            "scope": "meta.definition.method entity.name.function",
            "settings": { "foreground": "#F3F99D" }
        },
        {
            "scope": "keyword, modifier, storage.modifier, support.type.object, constant.language, variable.language.this, variable.language.special.self",
            "settings": { "foreground": "#FF6AC1" }
        },
        {
            "scope": "support.module, support.node",
            "settings": { "foreground": "#FF5C57" }
        },
        {
            "scope": "template.expression.begin, template.expression.end",
            "settings": { "foreground": "#FF6AC1" }
        },
        {
            "scope": "support.type.exception",
            "settings": { "foreground": "#F3F99D" }
        },
        {
            "scope": "markup.inserted.diff, meta.diff.header.to-file",
            "settings": { "foreground": "#5AF78E", "background": "#4D4E4F" }
        },
        {
            "scope": "markup.deleted.diff, meta.diff.header.from-file",
            "settings": { "foreground": "#FF5C57", "background": "#4D4E4F" }
        },
        {
            "scope": "source.cs meta.class.identifier storage.type",
            "settings": { "foreground": "#FF5C57" }
        },
        {
            "scope": "source.cs meta.method.identifier entity.name.function",
            "settings": { "foreground": "#F3F99D" }
        },
        {
            "scope": "source.cs meta.method-call meta.method, source.cs entity.name.function",
            "settings": { "foreground": "#57C7FF" }
        },
        {
            "scope": "source.cs storage.type",
            "settings": { "foreground": "#F3F99D" }
        },
        {
            "scope": "source.cs meta.method.return-type",
            "settings": { "foreground": "#9AEDFE" }
        },
        {
            "scope": "source.cs meta.preprocessor",
            "settings": { "foreground": "#4D4E4F" }
        },
        {
            "scope": "source.cs entity.name.type.namespace",
            "settings": { "foreground": "#EFF0EB" }
        },
        {
            "scope": "entity.other.attribute-name.class",
            "settings": { "foreground": "#9AEDFE" }
        },
        {
            "scope": "entity.other.attribute-name.id",
            "settings": { "foreground": "#9AEDFE" }
        },
        {
            "scope": "source.css entity.name.tag",
            "settings": { "foreground": "#F3F99D" }
        },
        {
            "scope": "source.css support.type.property-name",
            "settings": { "foreground": "#FF5C57" }
        },
        {
            "scope": "meta.tag, punctuation.definition.tag",
            "settings": { "foreground": "#EFF0EB" }
        },
        { "scope": "entity.name.tag", "settings": { "foreground": "#FF5C57" } },
        {
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#F3F99D" }
        },
        {
            "scope": "punctuation.section.embedded",
            "settings": { "foreground": "#FF5C57" }
        },
        {
            "scope": "keyword.other.definition.ini",
            "settings": { "foreground": "#FF5C57" }
        },
        {
            "scope": "entity.name.section.group-title.ini",
            "settings": { "foreground": "#57C7FF" }
        },
        {
            "scope": "source.java storage.modifier.package, source.java storage.modifier.import",
            "settings": { "foreground": "#EFF0EB" }
        },
        {
            "scope": "source.java storage.type.annotation",
            "settings": { "foreground": "#FF5C57", "fontStyle": "italic" }
        },
        {
            "scope": "source.java meta.method-call meta.method",
            "settings": { "foreground": "#57C7FF" }
        },
        {
            "scope": "source.java meta.method-call meta.inner-class meta.method",
            "settings": { "foreground": "#EFF0EB" }
        },
        {
            "scope": "source.java meta.method-call meta.inner-class meta.method meta.method-call meta.method",
            "settings": { "foreground": "#57C7FF" }
        },
        {
            "scope": "source.java meta.definition.variable entity.name.function",
            "settings": { "foreground": "#57C7FF" }
        },
        {
            "scope": "source.java constant.language",
            "settings": { "foreground": "#5AF78E" }
        },
        {
            "scope": "source.js storage.modifier.async",
            "settings": { "foreground": "#FF6AC1" }
        },
        {
            "scope": "meta.object-literal.key, meta.object-literal.key string, support.type.property-name.json",
            "settings": { "foreground": "#FF5C57" }
        },
        {
            "scope": "constant.language.json",
            "settings": { "foreground": "#FF6AC1" }
        },
        { "scope": "markup.heading", "settings": { "foreground": "#57C7FF" } },
        {
            "scope": "text.html.markdown meta.link.inline, meta.link.reference, markup.underline.link.image",
            "settings": { "foreground": "#FF5C57" }
        },
        {
            "scope": "text.html.markdown markup.quote",
            "settings": { "foreground": "#9AEDFE" }
        },
        {
            "scope": "text.html.markdown beginning.punctuation.definition.list",
            "settings": { "foreground": "#F3F99D" }
        },
        {
            "scope": "text.html.markdown markup.inline.raw",
            "settings": { "foreground": "#FF6AC1" }
        },
        {
            "scope": "markup.italic",
            "settings": { "foreground": "#FF5C57", "fontStyle": "italic" }
        },
        {
            "scope": "markup.bold",
            "settings": { "foreground": "#FF5C57", "fontStyle": "bold" }
        },
        {
            "scope": "markup.bold markup.italic, markup.italic markup.bold",
            "settings": { "foreground": "#FF5C57", "fontStyle": "italic bold" }
        },
        {
            "scope": "source.python keyword.operator.arithmetic",
            "settings": { "foreground": "#EFF0EB" }
        },
        {
            "scope": "source.python meta.function storage.type.function",
            "settings": { "foreground": "#FF6AC1" }
        },
        {
            "scope": "source.python meta.function-call.arguments",
            "settings": { "foreground": "#EFF0EB" }
        },
        {
            "scope": "source.python meta.function entity.name.function.decorator",
            "settings": { "foreground": "#FF5C57" }
        },
        {
            "scope": "source.python constant.language",
            "settings": { "foreground": "#5AF78E" }
        },
        {
            "scope": "entity.name.tag.yaml",
            "settings": { "foreground": "#FF5C57" }
        },
        {
            "scope": ["meta.selectionset.graphql variable"],
            "settings": { "foreground": "#F3F99D" }
        },
        {
            "scope": ["meta.selectionset.graphql meta.arguments variable"],
            "settings": { "foreground": "#EFF0EB" }
        },
        {
            "scope": [
                "entity.name.fragment.graphql",
                "variable.fragment.graphql"
            ],
            "settings": { "foreground": "#9AEDFE" }
        },
        {
            "scope": [
                "keyword.operator",
                "keyword.operator.new",
                "keyword.operator.expression",
                "string",
                "constant.other.placeholder",
                "meta.embedded.assembly",
                "storage.modifier",
                "storage.type",
                "storage.type.class.jsdoc",
                "storage.type.function.jsdoc",
                "storage.type.typedef.jsdoc",
                "storage.type.variable.jsdoc",
                "keyword.control",
                "comment",
                "comment.block",
                "entity.other.attribute-name.html",
                "variable",
                "entity.name.function",
                "entity.name.type",
                "entity.name.class",
                "entity.name.tag",
                "entity.name.section",
                "entity.name.selector",
                "entity.name.method",
                "entity.name.module",
                "entity.name.scope-resolution",
                "entity.name.variable"
            ],
            "settings": { "fontStyle": "" }
        },
        {
            "scope": "token.info-token",
            "settings": { "foreground": "#6796E6" }
        },
        {
            "scope": "token.warn-token",
            "settings": { "foreground": "#CD9731" }
        },
        {
            "scope": "token.error-token",
            "settings": { "foreground": "#F44747" }
        },
        {
            "scope": "token.debug-token",
            "settings": { "foreground": "#B267E6" }
        }
    ]
}
