{
    "name": "Best Themes - Darcula Darker",
    "$schema": "vscode://schemas/color-theme",
    "type": "dark",
    "colors": {
        "activityBar.background": "#1e1e1e",
        "activityBar.foreground": "#97a7c8",
        "activityBarBadge.background": "#ffc66d",
        "activityBarBadge.foreground": "#000000",
        "button.hoverBackground": "#ffc66d",
        "debugToolBar.background": "#1e1e1e",
        "dropdown.background": "#1e1e1e",
        "dropdown.border": "#97a7c8",
        "editor.background": "#1e1e1e",
        "editor.findMatchBackground": "#111111",
        "editor.foreground": "#a9b7c6",
        "editor.lineHighlightBackground": "#111111",
        "editor.lineHighlightBorder": "#111111",
        "editor.selectionBackground": "#111111",
        "editorBracketMatch.border": "#97a7c8",
        "editorCursor.foreground": "#ffc66d",
        "editorError.foreground": "#ff0000",
        "editorGroup.border": "#1e1e1e",
        "editorGroupHeader.noTabsBackground": "#1e1e1e",
        "editorGroupHeader.tabsBackground": "#1e1e1e",
        "editorGutter.addedBackground": "#608b4e",
        "editorGutter.deletedBackground": "#fb467b",
        "editorGutter.modifiedBackground": "#ffc66d",
        "editorHoverWidget.background": "#1e1e1e",
        "editorIndentGuide.background": "#111111",
        "editorLineNumber.foreground": "#5c6370",
        "editorOverviewRuler.border": "#1e1e1e",
        "editorRuler.foreground": "#18222d",
        "editorSuggestWidget.background": "#1e1e1e",
        "editorSuggestWidget.selectedBackground": "#111111",
        "editorWarning.foreground": "#fbff00",
        "editorWhitespace.foreground": "#111111",
        "editorWidget.background": "#1e1e1e",
        "focusBorder": "#97a7c8",
        "input.background": "#1e1e1e",
        "input.border": "#ffc66d",
        "list.activeSelectionBackground": "#1e1e1e",
        "list.activeSelectionForeground": "#ffc66d",
        "list.focusBackground": "#18222d",
        "list.focusForeground": "#ffc66d",
        "list.highlightForeground": "#ffc66d",
        "list.hoverBackground": "#111111",
        "list.inactiveSelectionBackground": "#1e1e1e",
        "list.inactiveSelectionForeground": "#ffc66d",
        "panel.background": "#1e1e1e",
        "panel.border": "#ffc66d",
        "panelTitle.activeForeground": "#ffc66d",
        "panelTitle.inactiveForeground": "#97a7c8",
        "peekView.border": "#97a7c8",
        "peekViewEditor.background": "#1e1e1e",
        "peekViewResult.background": "#1e1e1e",
        "peekViewResult.selectionBackground": "#1e1e1e",
        "peekViewTitle.background": "#1e1e1e",
        "peekViewTitleLabel.foreground": "#ffc66d",
        "progressBar.background": "#ffc66d",
        "scrollbar.shadow": "#111111",
        "scrollbarSlider.background": "#111111",
        "scrollbarSlider.hoverBackground": "#111111",
        "sideBar.background": "#1a1a1a",
        "sideBarSectionHeader.background": "#1e1e1e",
        "statusBar.background": "#1e1e1e",
        "statusBar.debuggingBackground": "#1e1e1e",
        "statusBar.foreground": "#97a7c8",
        "tab.activeBackground": "#1e1e1e",
        "tab.activeBorder": "#ffc66d",
        "tab.activeForeground": "#ffc66d",
        "tab.border": "#1e1e1e",
        "tab.inactiveBackground": "#1e1e1e",
        "tab.inactiveForeground": "#97a7c8",
        "tab.unfocusedActiveBorder": "#1e1e1e",
        "titleBar.activeBackground": "#1e1e1e",
        "titleBar.inactiveForeground": "#1e1e1e",
        "widget.shadow": "#000000"
    },
    "tokenColors": [
        { "scope": "emphasis", "settings": { "fontStyle": "italic" } },
        { "scope": "strong", "settings": { "fontStyle": "bold" } },
        { "scope": "header", "settings": { "foreground": "#000080" } },
        {
            "scope": "comment",
            "settings": { "foreground": "#808080", "fontStyle": "italic" }
        },
        {
            "scope": ["constant.language", "constant.character"],
            "settings": { "foreground": "#CC7832" }
        },
        {
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#6897BB" }
        },
        { "scope": "constant.regexp", "settings": { "foreground": "#646695" } },
        { "scope": "entity.name.tag", "settings": { "foreground": "#FFC66D" } },
        {
            "scope": "entity.name.tag.css",
            "settings": { "foreground": "#FFC66D" }
        },
        {
            "scope": [
                "entity.other.attribute-name.class.html",
                "entity.other.attribute-name.class.jade"
            ],
            "settings": { "foreground": "#9876AA" }
        },
        {
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#A9B7C6" }
        },
        {
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.class.mixin.css",
                "entity.other.attribute-name.id.css",
                "entity.other.attribute-name.parent-selector.css",
                "entity.other.attribute-name.pseudo-class.css",
                "entity.other.attribute-name.pseudo-element.css",
                "source.css.less entity.other.attribute-name.id",
                "entity.other.attribute-name.attribute.scss",
                "entity.other.attribute-name.scss"
            ],
            "settings": { "foreground": "#FFC66D" }
        },
        { "scope": "invalid", "settings": { "foreground": "#F44747" } },
        {
            "scope": "markup.underline",
            "settings": { "fontStyle": "underline" }
        },
        {
            "scope": "markup.bold",
            "settings": { "foreground": "#A9B7C6", "fontStyle": "bold" }
        },
        { "scope": "markup.heading", "settings": { "foreground": "#A9B7C6" } },
        { "scope": "markup.italic", "settings": { "fontStyle": "italic" } },
        { "scope": "markup.inserted", "settings": { "foreground": "#6A8759" } },
        { "scope": "markup.deleted", "settings": { "foreground": "#CC7832" } },
        { "scope": "markup.changed", "settings": { "foreground": "#A9B7C6" } },
        {
            "scope": "beginning.punctuation.definition.quote.markdown",
            "settings": { "foreground": "#608B4E" }
        },
        {
            "scope": "beginning.punctuation.definition.list.markdown",
            "settings": { "foreground": "#6796E6" }
        },
        {
            "scope": "markup.inline.raw",
            "settings": { "foreground": "#CC7832" }
        },
        { "scope": "meta.selector", "settings": { "foreground": "#FFC66D" } },
        {
            "scope": "punctuation.definition.tag",
            "settings": { "foreground": "#FFC66D" }
        },
        {
            "scope": "meta.preprocessor",
            "settings": { "foreground": "#CC7832" }
        },
        {
            "scope": "meta.preprocessor.string",
            "settings": { "foreground": "#CC7832" }
        },
        {
            "scope": "meta.preprocessor.numeric",
            "settings": { "foreground": "#6A8759" }
        },
        {
            "scope": "meta.structure.dictionary.key.python",
            "settings": { "foreground": "#9876AA" }
        },
        {
            "scope": "meta.diff.header",
            "settings": { "foreground": "#CC7832" }
        },
        { "scope": "storage", "settings": {} },
        { "scope": "storage.type", "settings": { "foreground": "#CC7832" } },
        {
            "scope": "storage.modifier",
            "settings": { "foreground": "#CC7832" }
        },
        {
            "scope": "string",
            "settings": { "foreground": "#6A8759", "fontStyle": "italic" }
        },
        {
            "scope": "string.tag",
            "settings": { "foreground": "#6A8759", "fontStyle": "italic" }
        },
        {
            "scope": "string.value",
            "settings": { "foreground": "#6A8759", "fontStyle": "italic" }
        },
        { "scope": "string.regexp", "settings": { "foreground": "#6A8759" } },
        {
            "scope": [
                "punctuation.definition.template-expression.begin.js",
                "punctuation.definition.template-expression.begin.ts",
                "punctuation.definition.template-expression.end.ts",
                "punctuation.definition.template-expression.end.js"
            ],
            "settings": { "foreground": "#A9B7C6" }
        },
        {
            "scope": [
                "keyword.operator.relational.js",
                "support.type.vendored.property-name",
                "support.type.property-name",
                "variable.css",
                "variable.scss",
                "variable.other.less",
                "entity.other.inherited-class.php",
                "entity.name.type.class.php",
                "entity.name.type.namespace.php",
                "keyword.operator.key.php",
                "storage.type.php",
                "support.class.builtin.php"
            ],
            "settings": { "foreground": "#A9B7C6" }
        },
        {
            "scope": [
                "variable.other.property",
                "support.variable.property.dom",
                "entity.other.inherited-class",
                "variable.other.php",
                "variable.language.this.php"
            ],
            "settings": { "foreground": "#9876AA" }
        },
        {
            "scope": [
                "variable.other.object",
                "variable.other.object.property",
                "support.class.dom",
                "meta.function-call",
                "entity.name.type.module"
            ],
            "settings": { "foreground": "#A9B7C6" }
        },
        {
            "scope": [
                "variable.other.readwrite",
                "variable.parameter",
                "variable.other.readwrite.alias"
            ],
            "settings": { "foreground": "#A9B7C6" }
        },
        { "scope": "keyword", "settings": { "foreground": "#CC7832" } },
        { "scope": "keyword.control", "settings": { "foreground": "#CC7832" } },
        {
            "scope": "keyword.operator",
            "settings": { "foreground": "#CC7832" }
        },
        {
            "scope": [
                "keyword.operator.new",
                "keyword.operator.expression",
                "keyword.operator.cast",
                "keyword.operator.sizeof",
                "keyword.operator.logical.python",
                "keyword.operator.logical.php"
            ],
            "settings": { "foreground": "#CC7832" }
        },
        {
            "scope": [
                "punctuation.separator.key-value",
                "keyword.operator.assignment",
                "keyword.operator.comparison",
                "keyword.operator.logical",
                "keyword.operator.accessor",
                "keyword.operator.class.php",
                "support.class.exception.php"
            ],
            "settings": { "foreground": "#A9B7C6" }
        },
        {
            "scope": "keyword.other.unit",
            "settings": { "foreground": "#6A8759" }
        },
        {
            "scope": [
                "punctuation.section.embedded.begin.metatag.php",
                "punctuation.section.embedded.end.metatag.php"
            ],
            "settings": { "foreground": "#CC7832" }
        },
        {
            "scope": "support.function.git-rebase",
            "settings": { "foreground": "#9876AA" }
        },
        {
            "scope": "constant.sha.git-rebase",
            "settings": { "foreground": "#6A8759" }
        },
        {
            "scope": [
                "storage.modifier.import.java",
                "storage.modifier.package.java"
            ],
            "settings": { "foreground": "#D4D4D4" }
        },
        {
            "scope": "variable.language",
            "settings": { "foreground": "#CC7832" }
        },
        {
            "scope": [
                "entity.name.function",
                "support.function",
                "support.constant.handlebars"
            ],
            "settings": { "foreground": "#FFC66D" }
        },
        {
            "scope": [
                "meta.return-type",
                "support.class",
                "support.type",
                "entity.name.type",
                "entity.name.class",
                "storage.type.cs",
                "storage.type.generic.cs",
                "storage.type.modifier.cs",
                "storage.type.variable.cs",
                "storage.type.annotation.java",
                "storage.type.generic.java",
                "storage.type.java",
                "storage.type.object.array.java",
                "storage.type.primitive.array.java",
                "storage.type.primitive.java",
                "storage.type.token.java",
                "storage.type.groovy",
                "storage.type.annotation.groovy",
                "storage.type.parameters.groovy",
                "storage.type.generic.groovy",
                "storage.type.object.array.groovy",
                "storage.type.primitive.array.groovy",
                "storage.type.primitive.groovy"
            ],
            "settings": { "foreground": "#4EC9B0" }
        },
        {
            "scope": [
                "support.class",
                "entity.name.class",
                "support.type",
                "entity.name.type"
            ],
            "settings": { "foreground": "#FFC66D" }
        },
        {
            "scope": ["storage.type.function.arrow"],
            "settings": { "foreground": "#A9B7C6" }
        },
        {
            "scope": [
                "meta.type.cast.expr",
                "meta.type.new.expr",
                "support.constant.math",
                "support.constant.dom",
                "support.constant.json"
            ],
            "settings": { "foreground": "#4EC9B0" }
        },
        { "scope": "keyword.control", "settings": { "foreground": "#CC7832" } },
        {
            "scope": ["meta.definition.variable.name", "support.variable"],
            "settings": { "foreground": "#A9B7C6" }
        },
        { "scope": ["variable"], "settings": { "foreground": "#FFC66D" } },
        {
            "scope": [
                "meta.object-literal.key",
                "meta.object-literal.key entity.name.function"
            ],
            "settings": { "foreground": "#9876AA" }
        },
        {
            "scope": [
                "meta.property.object.js",
                "constant.other.object.key.js",
                "string.unquoted.label.js"
            ],
            "settings": { "foreground": "#9876AA" }
        },
        {
            "scope": [
                "support.constant.property-value",
                "support.constant.font-name",
                "support.constant.media-type",
                "support.constant.media",
                "constant.other.color.rgb-value",
                "constant.other.rgb-value",
                "support.constant.color"
            ],
            "settings": { "foreground": "#CC7832" }
        },
        {
            "scope": "token.info-token",
            "settings": { "foreground": "#6796E6" }
        },
        {
            "scope": "token.warn-token",
            "settings": { "foreground": "#CD9731" }
        },
        {
            "scope": "token.error-token",
            "settings": { "foreground": "#F44747" }
        },
        {
            "scope": "token.debug-token",
            "settings": { "foreground": "#B267E6" }
        },
        {
            "scope": [
                "modifier",
                "this",
                "comment",
                "storage.modifier.js",
                "entity.other.attribute-name.js"
            ],
            "settings": { "fontStyle": "italic" }
        },
        {
            "scope": [
                "comment",
                "variable.language",
                "variable.parameter",
                "entity.other.attribute-name",
                "keyword",
                "markup.underline.link",
                "storage.modifier",
                "storage.type",
                "string.url",
                "variable.language.super",
                "variable.language.this"
            ],
            "settings": { "fontStyle": "" }
        },
        {
            "scope": [
                "keyword.operator",
                "keyword.other.type",
                "storage.modifier.import",
                "storage.modifier.package",
                "storage.type.built-in",
                "storage.type.function.arrow",
                "storage.type.generic",
                "storage.type.java",
                "storage.type.primitive"
            ],
            "settings": { "fontStyle": "" }
        }
    ]
}
