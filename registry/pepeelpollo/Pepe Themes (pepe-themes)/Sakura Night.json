    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#543253", "fontStyle": "italic" }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "keyword.control",
                "storage.type",
                "storage.modifier",
                "keyword.operator.new"
            ],
            "settings": { "foreground": "#276188" }
        },
        {
            "name": "Import / Export",
            "scope": [
                "keyword.control.import",
                "keyword.control.export",
                "keyword.control.from",
                "keyword.control.as"
            ],
            "settings": { "foreground": "#276188", "fontStyle": "italic" }
        },
        {
            "name": "Operators",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#C8A0B8" }
        },
        {
            "name": "Strings",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#F7D0BD" }
        },
        {
            "name": "String escape",
            "scope": ["constant.character.escape", "string.regexp"],
            "settings": { "foreground": "#F0C0D8" }
        },
        {
            "name": "Numbers",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#F0C0A0" }
        },
        {
            "name": "Boolean / Null",
            "scope": ["constant.language"],
            "settings": { "foreground": "#4E8FA8", "fontStyle": "bold" }
        },
        {
            "name": "Constants",
            "scope": ["variable.other.constant"],
            "settings": { "foreground": "#F7D0BD" }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call entity.name.function"
            ],
            "settings": { "foreground": "#4E8FA8", "fontStyle": "bold" }
        },
        {
            "name": "Function parameters",
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#EEC0D4", "fontStyle": "italic" }
        },
        {
            "name": "Classes / Types",
            "scope": [
                "entity.name.class",
                "entity.name.type",
                "entity.other.inherited-class",
                "support.class"
            ],
            "settings": { "foreground": "#D4A0C0", "fontStyle": "bold" }
        },
        {
            "name": "Interfaces",
            "scope": ["entity.name.type.interface"],
            "settings": { "foreground": "#D4A0C0", "fontStyle": "italic" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "variable.other"],
            "settings": { "foreground": "#EEC0D4" }
        },
        {
            "name": "Object properties",
            "scope": [
                "variable.other.property",
                "support.variable.property",
                "meta.object-literal.key"
            ],
            "settings": { "foreground": "#D8B0C8" }
        },
        {
            "name": "HTML/JSX Tags",
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#276188" }
        },
        {
            "name": "Tag attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#EEC0D4" }
        },
        {
            "name": "CSS classes & IDs",
            "scope": [
                "entity.other.attribute-name.class",
                "entity.other.attribute-name.id"
            ],
            "settings": { "foreground": "#F7D0BD" }
        },
        {
            "name": "CSS properties",
            "scope": ["support.type.property-name"],
            "settings": { "foreground": "#4E8FA8" }
        },
        {
            "name": "CSS values",
            "scope": ["support.constant.property-value"],
            "settings": { "foreground": "#F7D0BD" }
        },
        {
            "name": "CSS units",
            "scope": ["keyword.other.unit"],
            "settings": { "foreground": "#F0C0A0" }
        },
        {
            "name": "Punctuation",
            "scope": ["punctuation", "punctuation.definition"],
            "settings": { "foreground": "#A080A0" }
        },
        {
            "name": "This / Self",
            "scope": ["variable.language.this", "variable.language.self"],
            "settings": { "foreground": "#276188", "fontStyle": "italic" }
        },
        {
            "name": "Decorators",
            "scope": ["meta.decorator", "entity.name.function.decorator"],
            "settings": { "foreground": "#F7D0BD", "fontStyle": "italic" }
        },
        {
            "name": "JSON keys",
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#4E8FA8" }
        },
        {
            "name": "Markdown headings",
            "scope": ["markup.heading"],
            "settings": { "foreground": "#EEC0D4", "fontStyle": "bold" }
        },
        {
            "name": "Markdown bold",
            "scope": ["markup.bold"],
            "settings": { "foreground": "#F7D0BD", "fontStyle": "bold" }
        },
        {
            "name": "Markdown italic",
            "scope": ["markup.italic"],
            "settings": { "foreground": "#EEC0D4", "fontStyle": "italic" }
        },
        {
            "name": "Markdown code",
            "scope": ["markup.inline.raw"],
            "settings": { "foreground": "#4E8FA8" }
        },
        {
            "name": "Markdown links",
            "scope": ["markup.underline.link"],
            "settings": { "foreground": "#276188", "fontStyle": "underline" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid"],
            "settings": {
                "foreground": "#C06080",
                "fontStyle": "strikethrough"
            }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "function": { "foreground": "#4E8FA8", "bold": true },
        "method": { "foreground": "#4E8FA8" },
        "class": { "foreground": "#D4A0C0", "bold": true },
        "interface": { "foreground": "#D4A0C0", "italic": true },
        "type": { "foreground": "#D4A0C0" },
        "enum": { "foreground": "#F0C0A0" },
        "enumMember": { "foreground": "#F0C0A0" },
        "variable": { "foreground": "#EEC0D4" },
        "variable.constant": { "foreground": "#F7D0BD" },
        "parameter": { "foreground": "#EEC0D4", "italic": true },
        "property": { "foreground": "#D8B0C8" },
        "keyword": { "foreground": "#276188" },
        "string": { "foreground": "#F7D0BD" },
        "number": { "foreground": "#F0C0A0" },
        "operator": { "foreground": "#C8A0B8" },
        "comment": { "foreground": "#543253", "italic": true },
        "decorator": { "foreground": "#F7D0BD", "italic": true },
        "namespace": { "foreground": "#D4A0C0" },
        "macro": { "foreground": "#F7D0BD" }
    },
    "$schema": "vscode://schemas/color-theme"
}
