        "editorSuggestWidget.selectedBackground": "#2A2A2A",
        "editorHoverWidget.background": "#1A1A1A",
        "editorHoverWidget.border": "#5A3A1A",
        "diffEditor.insertedTextBackground": "#4EC9B020",
        "diffEditor.removedTextBackground": "#E0505020",
