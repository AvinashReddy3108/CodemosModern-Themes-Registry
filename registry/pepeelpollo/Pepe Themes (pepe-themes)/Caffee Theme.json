        "statusBar.noFolderBackground": "#1C1C1C",
        "statusBar.debuggingBackground": "#7A4A20",
        "statusBar.debuggingForeground": "#FFD080",
        "statusBarItem.hoverBackground": "#5A3A1A",
        "statusBarItem.remoteBackground": "#C08040",
        "statusBarItem.remoteForeground": "#141414",
        "titleBar.activeBackground": "#141414",
        "titleBar.activeForeground": "#C08040",
        "titleBar.inactiveBackground": "#111111",
        "titleBar.inactiveForeground": "#5A4A3A",
        "titleBar.border": "#2A2A2A",
        "tab.activeBackground": "#1C1C1C",
        "tab.activeForeground": "#F0A830",
        "tab.activeBorder": "#C08040",
        "tab.inactiveBackground": "#141414",
        "tab.inactiveForeground": "#6A5A4A",
        "tab.border": "#2A2A2A",
        "tab.hoverBackground": "#252525",
        "tab.hoverForeground": "#C08040",
        "editorGroupHeader.tabsBackground": "#141414",
        "editorGroupHeader.tabsBorder": "#2A2A2A",
        "panel.background": "#141414",
        "panel.border": "#2A2A2A",
        "panelTitle.activeBorder": "#F0A830",
        "panelTitle.activeForeground": "#F0A830",
        "panelTitle.inactiveForeground": "#6A5A4A",
        "terminal.background": "#141414",
        "terminal.foreground": "#D4C5A9",
        "terminal.ansiBrightBlack": "#5A4A3A",
        "terminal.ansiBrightBlue": "#569CD6",
        "terminal.ansiBrightCyan": "#4EC9B0",
        "terminal.ansiBrightGreen": "#B5CEA8",
        "terminal.ansiBrightMagenta": "#C586C0",
        "terminal.ansiBrightRed": "#E05050",
        "terminal.ansiBrightWhite": "#D4C5A9",
        "terminal.ansiBrightYellow": "#F0A830",
        "terminal.ansiBlack": "#141414",
        "terminal.ansiBlue": "#569CD6",
        "terminal.ansiCyan": "#4EC9B0",
        "terminal.ansiGreen": "#6A9955",
        "terminal.ansiMagenta": "#C586C0",
        "terminal.ansiRed": "#CC4444",
        "terminal.ansiWhite": "#C4A882",
        "terminal.ansiYellow": "#C08040",
        "terminal.selectionBackground": "#5A3A1A55",
        "terminalCursor.foreground": "#F0A830",
        "scrollbarSlider.background": "#3A2A1A66",
        "scrollbarSlider.hoverBackground": "#5A3A1A88",
        "scrollbarSlider.activeBackground": "#7A5A30AA",
        "badge.background": "#F0A830",
        "badge.foreground": "#141414",
        "button.background": "#7A5A30",
        "button.foreground": "#F0E0C0",
        "button.hoverBackground": "#A07840",
        "input.background": "#1A1A1A",
        "input.border": "#5A3A1A",
        "input.foreground": "#D4C5A9",
        "input.placeholderForeground": "#6A5A4A",
        "inputOption.activeBackground": "#3A2A1A",
        "inputOption.activeForeground": "#F0A830",
        "inputOption.activeBorder": "#F0A830",
        "dropdown.background": "#1A1A1A",
        "dropdown.foreground": "#D4C5A9",
        "dropdown.border": "#5A3A1A",
        "focusBorder": "#C08040",
        "foreground": "#D4C5A9",
        "disabledForeground": "#5A4A3A",
        "widget.shadow": "#00000099",
        "icon.foreground": "#C08040",
        "errorForeground": "#E05050",
        "notifications.background": "#1A1A1A",
        "notifications.foreground": "#D4C5A9",
        "notifications.border": "#5A3A1A",
        "gitDecoration.addedResourceForeground": "#4EC9B0",
        "gitDecoration.modifiedResourceForeground": "#F0A830",
        "gitDecoration.deletedResourceForeground": "#E05050",
        "gitDecoration.untrackedResourceForeground": "#B5CEA8",
        "gitDecoration.ignoredResourceForeground": "#5A4A3A",
        "breadcrumb.foreground": "#6A5A4A",
        "breadcrumb.focusForeground": "#C08040",
        "breadcrumb.activeSelectionForeground": "#F0A830",
        "breadcrumbPicker.background": "#1A1A1A",
        "settings.headerForeground": "#F0A830",
        "settings.modifiedItemIndicator": "#C08040"
    },
    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#6A9955", "fontStyle": "italic" }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "keyword.control",
                "storage.type",
                "storage.modifier",
                "keyword.operator.new"
            ],
            "settings": { "foreground": "#C586C0" }
        },
        {
            "name": "Import / Export keywords",
            "scope": [
                "keyword.control.import",
                "keyword.control.export",
                "keyword.control.from",
                "keyword.control.as"
            ],
            "settings": { "foreground": "#C586C0" }
        },
        {
            "name": "Operators",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#D4C5A9" }
        },
        {
            "name": "Strings",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#CE9178" }
        },
        {
            "name": "String escape",
            "scope": ["constant.character.escape", "string.regexp"],
            "settings": { "foreground": "#D7BA7D" }
        },
        {
            "name": "Numbers",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#B5CEA8" }
        },
        {
            "name": "Boolean / Null",
            "scope": ["constant.language"],
            "settings": { "foreground": "#569CD6" }
        },
        {
            "name": "Constants",
            "scope": ["variable.other.constant"],
            "settings": { "foreground": "#4FC1FF" }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call entity.name.function"
            ],
            "settings": { "foreground": "#DCDCAA" }
        },
        {
            "name": "Function parameters",
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#9CDCFE", "fontStyle": "italic" }
        },
        {
            "name": "Classes / Types",
            "scope": [
                "entity.name.class",
                "entity.name.type",
                "entity.other.inherited-class",
                "support.class"
            ],
            "settings": { "foreground": "#4EC9B0" }
        },
        {
            "name": "Interfaces",
            "scope": ["entity.name.type.interface"],
            "settings": { "foreground": "#4EC9B0", "fontStyle": "italic" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "variable.other"],
            "settings": { "foreground": "#9CDCFE" }
        },
        {
            "name": "Object properties",
            "scope": ["variable.other.property", "support.variable.property"],
            "settings": { "foreground": "#9CDCFE" }
        },
        {
            "name": "HTML/JSX Tags",
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#569CD6" }
        },
        {
            "name": "Tag attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#9CDCFE" }
        },
        {
            "name": "CSS classes & IDs",
            "scope": [
                "entity.other.attribute-name.class",
                "entity.other.attribute-name.id"
            ],
            "settings": { "foreground": "#D7BA7D" }
        },
        {
            "name": "CSS properties",
            "scope": ["support.type.property-name"],
            "settings": { "foreground": "#9CDCFE" }
        },
        {
            "name": "CSS values",
            "scope": ["support.constant.property-value"],
            "settings": { "foreground": "#CE9178" }
        },
        {
            "name": "Punctuation",
            "scope": ["punctuation", "punctuation.definition"],
            "settings": { "foreground": "#D4C5A9" }
        },
        {
            "name": "This / Self",
            "scope": ["variable.language.this", "variable.language.self"],
            "settings": { "foreground": "#569CD6", "fontStyle": "italic" }
        },
        {
            "name": "Decorators",
            "scope": ["meta.decorator", "entity.name.function.decorator"],
            "settings": { "foreground": "#DCDCAA", "fontStyle": "italic" }
        },
        {
            "name": "JSON keys",
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#9CDCFE" }
        },
        {
            "name": "Markdown headings",
            "scope": ["markup.heading"],
            "settings": { "foreground": "#F0A830", "fontStyle": "bold" }
        },
        {
            "name": "Markdown bold",
            "scope": ["markup.bold"],
            "settings": { "foreground": "#DCDCAA", "fontStyle": "bold" }
        },
        {
            "name": "Markdown italic",
            "scope": ["markup.italic"],
            "settings": { "foreground": "#CE9178", "fontStyle": "italic" }
        },
        {
            "name": "Markdown code",
            "scope": ["markup.inline.raw"],
            "settings": { "foreground": "#4EC9B0" }
        },
        {
            "name": "Markdown links",
            "scope": ["markup.underline.link"],
            "settings": { "foreground": "#569CD6", "fontStyle": "underline" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid"],
            "settings": { "foreground": "#E05050" }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "function": { "foreground": "#DCDCAA" },
        "method": { "foreground": "#DCDCAA" },
        "class": { "foreground": "#4EC9B0" },
        "interface": { "foreground": "#4EC9B0", "italic": true },
        "type": { "foreground": "#4EC9B0" },
        "enum": { "foreground": "#B8D7A3" },
        "enumMember": { "foreground": "#B8D7A3" },
        "variable": { "foreground": "#9CDCFE" },
        "variable.constant": { "foreground": "#4FC1FF" },
        "parameter": { "foreground": "#9CDCFE", "italic": true },
        "property": { "foreground": "#9CDCFE" },
        "keyword": { "foreground": "#C586C0" },
        "string": { "foreground": "#CE9178" },
        "number": { "foreground": "#B5CEA8" },
        "operator": { "foreground": "#D4C5A9" },
        "comment": { "foreground": "#6A9955", "italic": true },
        "decorator": { "foreground": "#DCDCAA", "italic": true },
        "namespace": { "foreground": "#4EC9B0" },
        "macro": { "foreground": "#F0A830" }
    },
    "$schema": "vscode://schemas/color-theme"
}
