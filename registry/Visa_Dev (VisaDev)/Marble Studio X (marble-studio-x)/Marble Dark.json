{
    "name": "Marble Dark",
    "type": "dark",
    "semanticHighlighting": true,
    "colors": {
        "editor.background": "#0F1624",
        "editor.foreground": "#D7E3F4",
        "editorLineNumber.foreground": "#4E5B73",
        "editorLineNumber.activeForeground": "#89A3C7",
        "editorCursor.foreground": "#00C9B1",
        "editor.selectionBackground": "#1C355D",
        "editor.inactiveSelectionBackground": "#1A2A44",
        "editor.lineHighlightBackground": "#131C2D",
        "editorIndentGuide.background1": "#1A2333",
        "editorIndentGuide.activeBackground1": "#2B3A52",
        "editorWhitespace.foreground": "#25344D",
        "editorBracketMatch.background": "#22406E55",
        "editorBracketMatch.border": "#4A79C5",
        "editorError.foreground": "#F97583",
        "editorWarning.foreground": "#E5C07B",
        "editorInfo.foreground": "#61AFEF",
        "editorHint.foreground": "#56B6C2",
        "sideBar.background": "#0C1320",
        "sideBar.foreground": "#C7D6EA",
        "sideBar.border": "#172234",
        "activityBar.background": "#0A1220",
        "activityBar.foreground": "#00C9B1",
        "activityBar.inactiveForeground": "#5B738F",
        "activityBarBadge.background": "#00C9B1",
        "activityBarBadge.foreground": "#05141B",
        "statusBar.background": "#0B1A2C",
        "statusBar.foreground": "#D7E3F4",
        "statusBar.border": "#14324A",
        "titleBar.activeBackground": "#0B1627",
        "titleBar.activeForeground": "#D7E3F4",
        "titleBar.inactiveBackground": "#0A1422",
        "titleBar.inactiveForeground": "#7E92AC",
        "tab.activeBackground": "#132038",
        "tab.inactiveBackground": "#0D172A",
        "tab.activeForeground": "#D7E3F4",
        "tab.inactiveForeground": "#8AA1BE",
        "tab.border": "#1B2B43",
        "panel.background": "#0B1323",
        "terminal.background": "#0A1220",
        "terminal.foreground": "#D7E3F4",
        "terminal.ansiBlack": "#0A0F17",
        "terminal.ansiRed": "#E06C75",
        "terminal.ansiGreen": "#98C379",
        "terminal.ansiYellow": "#E5C07B",
        "terminal.ansiBlue": "#61AFEF",
        "terminal.ansiMagenta": "#C678DD",
        "terminal.ansiCyan": "#56B6C2",
        "terminal.ansiWhite": "#ABB2BF",
        "terminal.ansiBrightBlack": "#5C6370",
        "terminal.ansiBrightRed": "#F07B84",
        "terminal.ansiBrightGreen": "#A9D18E",
        "terminal.ansiBrightYellow": "#F2D28F",
        "terminal.ansiBrightBlue": "#7ABCF3",
        "terminal.ansiBrightMagenta": "#D58BE9",
        "terminal.ansiBrightCyan": "#71C8D2",
        "terminal.ansiBrightWhite": "#DDE6F2"
    },
    "tokenColors": [
        {
            "name": "Include",
            "scope": ["keyword.other.include"],
            "settings": { "foreground": "#C792EA" }
        },
        {
            "name": "Fragment",
            "scope": ["keyword.other.fragment"],
            "settings": { "foreground": "#00C9B1" }
        },
        {
            "name": "MARBLE Client brackets",
            "scope": ["punctuation.definition.bracket.marble.client"],
            "settings": { "foreground": "#E5C07B" }
        },
        {
            "name": "MARBLE Client — action/command/function",
            "scope": ["keyword.declaration.action.command.function.marble"],
            "settings": { "foreground": "#C678DD" }
        },
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#7B889E", "fontStyle": "italic" }
        },
        {
            "name": "Keywords",
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#56B6C2" }
        },
        {
            "name": "Strings",
            "scope": ["string", "constant.other.symbol"],
            "settings": { "foreground": "#98C379" }
        },
        {
            "name": "Numbers",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#E5C07B" }
        },
        {
            "name": "Entity Names",
            "scope": [
                "entity.name.type",
                "entity.name.function",
                "entity.name.class"
            ],
            "settings": { "foreground": "#61AFEF" }
        },
        {
            "name": "Functions and Methods",
            "scope": ["support.function", "meta.function-call"],
            "settings": { "foreground": "#C678DD" }
        },
        {
            "name": "Annotations and Decorators",
            "scope": ["storage.modifier.annotation", "meta.annotation"],
            "settings": { "foreground": "#D19A66" }
        },
        {
            "name": "Operators and Punctuation",
            "scope": [
                "keyword.operator",
                "punctuation.separator",
                "punctuation.terminator"
            ],
            "settings": { "foreground": "#ABB2BF" }
        },
        {
            "name": "Parameters and Variables",
            "scope": ["variable", "variable.parameter"],
            "settings": { "foreground": "#E5C07B" }
        },
        {
            "name": "Property Names",
            "scope": ["support.type.property-name", "meta.object-literal.key"],
            "settings": { "foreground": "#7ABCF3" }
        },
        {
            "name": "HTTP Methods and Status",
            "scope": [
                "support.constant.http-method",
                "constant.numeric.http-status"
            ],
            "settings": { "foreground": "#00C9B1", "fontStyle": "bold" }
        },
        {
            "name": "Directive Lines",
            "scope": ["meta.preprocessor.sqlplus", "entity.name.tag"],
            "settings": { "foreground": "#C792EA" }
        },
        {
            "name": "Marble Entity Preview — include",
            "scope": ["keyword.other.include.marble.entity"],
            "settings": { "foreground": "#C792EA" }
        },
        {
            "name": "Marble Entity Preview — fragment",
            "scope": ["keyword.other.fragment.marble.entity"],
            "settings": { "foreground": "#00C9B1" }
        },
        {
            "name": "Marble Entity Preview — visibility (parentkey, key, private, public)",
            "scope": ["storage.modifier.visibility.marble.entity"],
            "settings": { "foreground": "#F0B429" }
        },
        {
            "name": "Marble Entity Preview — attribute names",
            "scope": ["variable.other.attribute.marble.entity"],
            "settings": { "foreground": "#7EC8E3" }
        },
        {
            "name": "Marble Entity Preview — block keywords",
            "scope": ["keyword.control.marble.entity"],
            "settings": { "foreground": "#D19A66" }
        },
        {
            "name": "Marble Entity Preview — attribute flags",
            "scope": ["constant.other.flag.marble.entity"],
            "settings": { "foreground": "#61AFEF" }
        },
        {
            "name": "Marble Entity Preview — flags, /DERIVED, /UPPERCASE",
            "scope": ["keyword.operator.marble.entity"],
            "settings": { "foreground": "#61AFEF" }
        },
        {
            "name": "Marble Entity Preview — datatypes (TEXT, DATE, etc.)",
            "scope": ["storage.type.marble.entity"],
            "settings": { "foreground": "#56B6C2" }
        },
        {
            "name": "Marble Entity Preview — type params (parens region)",
            "scope": ["meta.type-params.marble.entity"],
            "settings": { "foreground": "#ABB2BF" }
        },
        {
            "name": "Marble Entity Preview — brackets () {}",
            "scope": [
                "punctuation.definition.group.begin.marble.entity",
                "punctuation.definition.group.end.marble.entity",
                "punctuation.definition.bracket.curly.marble.entity"
            ],
            "settings": { "foreground": "#F0C674" }
        },
        {
            "name": "Marble Entity Preview — association target entity",
            "scope": ["entity.name.type.target.marble.entity"],
            "settings": { "foreground": "#C792EA", "fontStyle": "bold" }
        },
        {
            "name": "Marble Enumeration Preview — include",
            "scope": ["keyword.other.include.marble.enumeration"],
            "settings": { "foreground": "#C792EA" }
        },
        {
            "name": "Marble Enumeration Preview — fragment",
            "scope": ["keyword.other.fragment.marble.enumeration"],
            "settings": { "foreground": "#00C9B1" }
        },
        {
            "name": "Marble Enumeration Preview — keywords",
            "scope": ["keyword.control.marble.enumeration"],
            "settings": { "foreground": "#E5C07B" }
        },
        {
            "name": "Marble Enumeration Preview — property keys",
            "scope": ["support.type.property-name.marble.enumeration"],
            "settings": { "foreground": "#7ABCF3" }
        },
        {
            "name": "Marble Enumeration Preview — identifiers",
            "scope": ["variable.other.marble.enumeration"],
            "settings": { "foreground": "#D7E3F4" }
        },
        {
            "name": "Constants",
            "scope": ["constant.language", "constant.character"],
            "settings": { "foreground": "#E06C75" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#FFFFFF", "background": "#C72E3A" }
        }
    ],
    "semanticTokenColors": {
        "namespace": "#61AFEF",
        "class": "#61AFEF",
        "enum": "#D19A66",
        "interface": "#56B6C2",
        "struct": "#56B6C2",
        "typeParameter": "#E5C07B",
        "type": "#56B6C2",
        "parameter": "#E5C07B",
        "variable": "#D7E3F4",
        "property": "#7ABCF3",
        "enumMember": "#E06C75",
        "function": "#C678DD",
        "method": "#C678DD",
        "macro": "#C792EA",
        "keyword": "#56B6C2",
        "comment": { "foreground": "#7B889E", "fontStyle": "italic" },
        "string": "#98C379",
        "number": "#E5C07B",
        "regexp": "#56B6C2",
        "operator": "#ABB2BF"
    },
    "$schema": "vscode://schemas/color-theme"
}
