{
    "type": "dark",
    "name": "Darcula",
    "semanticHighlighting": true,
    "colors": {
        "editor.background": "#2B2B2B",
        "editor.foreground": "#CCCCCC",
        "editor.selectionBackground": "#204182CC",
        "editor.lineHighlightBackground": "#FFFFFF0B",
        "editorGutter.background": "#FFFFFF0B",
        "editorLineNumber.activeForeground": "#A4A3A3",
        "editorLineNumber.foreground": "#606366",
        "titleBar.border": "#323232",
        "titleBar.activeBackground": "#3C3F41",
        "titleBar.inactiveBackground": "#FFFFFF10",
        "titleBar.activeForeground": "#CCCCCC",
        "sideBar.border": "#FFFFFF1A",
        "sideBar.background": "#3C3F41",
        "sideBar.foreground": "#BBBBBB",
        "sideBarTitle.foreground": "#BBBBBB",
        "sideBarSectionHeader.background": "#3C3F41",
        "sideBarSectionHeader.border": "#323232",
        "sideBarSectionHeader.foreground": "#BBBBBB",
        "statusBar.foreground": "#CCCCCC",
        "statusBar.background": "#3C3F41",
        "statusBar.border": "#464646",
        "tab.activeBackground": "#4E5254",
        "tab.inactiveBackground": "#3C3F41",
        "tab.activeBorder": "#4A88C7",
        "editorSuggestWidget.background": "#303030",
        "editorSuggestWidget.highlightForeground": "#CC6E2F",
        "editorSuggestWidget.selectedBackground": "#204182CC",
        "badge.background": "#FF00001A",
        "activityBar.activeBackground": "#3472ED",
        "activityBar.background": "#3C3F41",
        "activityBar.border": "#323232",
        "activityBar.foreground": "#FFFFFF",
        "activityBar.inactiveForeground": "#CED0D6",
        "activityBarBadge.background": "#548AF7",
        "activityBarBadge.foreground": "#CED0D6",
        "list.hoverBackground": "#45494A",
        "list.hoverForeground": "#BBBBBB",
        "scrollbarSlider.background": "#494949",
        "scrollbarSlider.activeBackground": "#595959",
        "tree.indentGuidesStroke": "#505355",
        "tree.inactiveIndentGuidesStroke": "#505355",
        "editorWhitespace.foreground": "#5A5A5A",
        "editorRuler.foreground": "#4D4D4D",
        "editorInlayHint.foreground": "#787878",
        "editorInlayHint.typeForeground": "#787878"
    },
    "tokenColors": [
        {
            "scope": "invalid",
            "settings": { "foreground": "#", "fontStyle": "" }
        },
        {
            "scope": "entity",
            "settings": { "foreground": "#a9b7c6", "fontStyle": "" }
        },
        {
            "scope": "constant.numeric",
            "settings": { "foreground": "#267dff", "fontStyle": "" }
        },
        {
            "scope": "keyword",
            "settings": { "foreground": "#597cc2", "fontStyle": "" }
        },
        {
            "scope": "string",
            "settings": { "foreground": "#807d6e", "fontStyle": "bold" }
        },
        {
            "scope": "comment.block,punctuation.definition.comment",
            "settings": { "foreground": "#7a7a7a", "fontStyle": "" }
        },
        {
            "scope": "comment.line",
            "settings": { "foreground": "#7a7a7a", "fontStyle": "" }
        },
        {
            "scope": "comment.documentation",
            "settings": { "foreground": "#7a7a7a", "fontStyle": "" }
        },
        {
            "scope": "punctuation",
            "settings": { "foreground": "#597cc2", "fontStyle": "" }
        },
        {
            "scope": "punctuation",
            "settings": { "foreground": "#5c7ab8", "fontStyle": "" }
        },
        {
            "scope": "constant",
            "settings": { "foreground": "#828eba", "fontStyle": "" }
        },
        {
            "scope": "entity.name.function",
            "settings": { "foreground": "#d9af6c", "fontStyle": "" }
        },
        {
            "scope": "constant.character.escape",
            "settings": { "foreground": "#597cc2", "fontStyle": "" }
        },
        {
            "scope": "invalid",
            "settings": { "foreground": "#807d6e", "fontStyle": "bold" }
        },
        {
            "scope": "meta.tag",
            "settings": { "foreground": "#66a6ff", "fontStyle": "bold" }
        },
        {
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#55ff", "fontStyle": "" }
        },
        {
            "scope": "constant.character.entity",
            "settings": { "foreground": "#55ff", "fontStyle": "" }
        },
        {
            "scope": "variable.parameter.misc.css",
            "settings": { "foreground": "#287bde", "fontStyle": "" }
        },
        {
            "scope": "variable.other.less",
            "settings": { "foreground": "#d0d0ff", "fontStyle": "" }
        },
        {
            "scope": "variable.parameter.sass",
            "settings": { "foreground": "#6d9cbe", "fontStyle": "" }
        },
        {
            "scope": "entity.other.attribute-name.tag",
            "settings": { "foreground": "#d0d0ff", "fontStyle": "" }
        },
        {
            "scope": "comment.block.css",
            "settings": { "foreground": "#bc9455", "fontStyle": "" }
        },
        {
            "scope": "entity.other.attribute-name.html,text.html.derivative",
            "settings": { "foreground": "#bababa", "fontStyle": "" }
        },
        {
            "scope": "string.quoted.double.html",
            "settings": { "foreground": "#4c84d9", "fontStyle": "" }
        },
        {
            "scope": "punctuation.definition.tag.begin.html,punctuation.definition.tag.end.html",
            "settings": { "foreground": "#e8bf6a", "fontStyle": "" }
        },
        {
            "scope": "entity.name.tag.html",
            "settings": { "foreground": "#e8bf6a", "fontStyle": "" }
        },
        {
            "scope": "support.type.property-name.json",
            "settings": { "foreground": "#828eba", "fontStyle": "" }
        },
        {
            "scope": "string.quoted.double.json,punctuation.definition.string.begin.json,punctuation.definition.string.end.json",
            "settings": { "foreground": "#807d6e", "fontStyle": "bold" }
        },
        {
            "scope": "punctuation.definition.dictionary.end.json,punctuation.definition.dictionary.begin.json,punctuation.definition.array.begin.json,punctuation.definition.array.end.json",
            "settings": { "foreground": "#aeb5bd", "fontStyle": "" }
        },
        {
            "scope": "constant.language.json",
            "settings": { "foreground": "#597cc2", "fontStyle": "" }
        },
        {
            "scope": "support.type.primitive.ts,support.type.builtin.ts,storage.modifier.ts,storage.type.class.ts,storage.type.ts,storage.type.property.ts,storage.modifier.async.ts,storage.type.interface.ts,storage.type.enum.ts,storage.type.type.ts,storage.type.function.ts,variable.language.this.ts",
            "settings": { "foreground": "#597cc2", "fontStyle": "" }
        },
        {
            "scope": "variable.parameter.ts,meta.import.ts variable.other.readwrite.alias.ts",
            "settings": { "foreground": "#a9b7c6", "fontStyle": "" }
        },
        {
            "scope": "support.type.primitive.tsx,support.type.builtin.tsx,storage.modifier.tsx,storage.type.class.tsx,storage.type.tsx,storage.type.property.tsx,storage.modifier.async.tsx,storage.type.interface.tsx,storage.type.enum.tsx,storage.type.type.tsx,storage.type.function.tsx,variable.language.this.tsx",
            "settings": { "foreground": "#597cc2", "fontStyle": "" }
        },
        {
            "scope": "variable.parameter.txs,meta.import.tsx variable.other.readwrite.alias.tsx",
            "settings": { "foreground": "#a9b7c6", "fontStyle": "" }
        },
        {
            "scope": "punctuation.definition.tag.begin.tsx,punctuation.definition.tag.end.tsx",
            "settings": { "foreground": "#e8bf6a", "fontStyle": "" }
        },
        {
            "scope": "entity.name.tag.tsx",
            "settings": { "foreground": "#26BCA3", "fontStyle": "" }
        },
        {
            "scope": "entity.other.attribute-name.tsx",
            "settings": { "foreground": "#bababa", "fontStyle": "" }
        },
        {
            "scope": "meta.tag.attributes.tsx keyword.operator.assignment.tsx",
            "settings": { "foreground": "#807d6e", "fontStyle": "" }
        },
        {
            "scope": "meta.object.member.tsx, meta.embedded.expression.tsx variable.other.property.tsx",
            "settings": { "foreground": "#828eba", "fontStyle": "" }
        },
        {
            "scope": "storage.type.function.arrow.tsx,punctuation.definition.binding-pattern.array.tsx,keyword.operator.assignment.tsx,keyword.operator.comparison.tsx,keyword.operator.logical.tsx,meta.brace.round.tsx,punctuation.definition.parameters.begin.tsx,punctuation.definition.parameters.end.tsx",
            "settings": { "foreground": "#aeb5bd", "fontStyle": "" }
        },
        {
            "scope": "constant.language.boolean.false.tsx,constant.language.boolean.true.tsx",
            "settings": { "foreground": "#597cc2", "fontStyle": "" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
