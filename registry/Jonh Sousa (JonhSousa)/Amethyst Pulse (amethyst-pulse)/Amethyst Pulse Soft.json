    "tokenColors": [
        {
            "name": "Java Class Name",
            "scope": ["entity.name.type.class.java"],
            "settings": { "foreground": "#BB9AF7", "fontStyle": "bold" }
        },
        {
            "name": "Java Interface Name",
            "scope": ["entity.name.type.interface.java"],
            "settings": { "foreground": "#7AA2F7", "fontStyle": "italic" }
        },
        {
            "name": "Java Method Name",
            "scope": ["entity.name.function.java"],
            "settings": { "foreground": "#FF9E64", "fontStyle": "italic" }
        },
        {
            "name": "Java Field/Variable",
            "scope": ["variable.other.java"],
            "settings": { "foreground": "#9ECE6A" }
        },
        {
            "name": "Java Keywords",
            "scope": ["keyword.other.java", "storage.type.java"],
