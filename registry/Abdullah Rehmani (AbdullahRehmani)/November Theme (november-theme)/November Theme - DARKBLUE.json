    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "fontStyle": "bold", "foreground": "#5a6468" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "string constant.other.placeholder"],
            "settings": { "fontStyle": "bold", "foreground": "#efecec" }
        },
        {
            "name": "Punctuation",
            "scope": ["punctuation"],
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Colors",
            "scope": ["constant.other.color"],
            "settings": { "foreground": "#ffffff" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#FF5370" }
        },
        {
            "name": "Keyword, Storage",
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "fontStyle": "bold", "foreground": "#001db0" }
        },
        {
            "name": "Keyword, import and export",
            "scope": [
                "keyword.control.import.js",
                "keyword.control.import.ts",
                "keyword.control.import.js.jsx",
                "keyword.control.import.tsx",
                "keyword.control.from.js",
                "keyword.control.from.ts",
                "keyword.control.from.js.jsx",
                "keyword.control.from.tsx",
                "keyword.control.export.js",
                "keyword.control.export.ts",
                "keyword.control.export.js.jsx",
                "keyword.control.export.tsx"
            ],
            "settings": { "foreground": "#a58dff" }
        },
        {
            "name": "Keyword block level{ }, try and catch, if and else",
            "scope": [
                "source.js keyword.control.trycatch.js",
                "source.js.jsx keyword.control.trycatch.js.jsx",
                "source.js keyword.control.conditional.js",
                "source.js.jsx keyword.control.conditional.js.jsx"
            ],
            "settings": { "foreground": "#7e5aff" }
        },
        {
            "name": "Keyword, Function & this",
            "scope": [
                "storage.type.function.js",
                "storage.type.function.ts",
                "storage.type.function.js.jsx",
                "storage.type.function.tsx",
                "variable.language.this.js",
                "variable.language.this.ts",
                "variable.language.this.js.jsx",
                "variable.language.this.tsx"
            ],
            "settings": { "foreground": "#1f44ff", "fontStyle": "bold" }
        },
        {
            "name": "Keyword, Function's return",
            "scope": [
                "keyword.control.flow.js",
                "keyword.control.flow.ts",
                "keyword.control.flow.js.jsx",
                "keyword.control.flow.tsx",
                "source.js meta.function.js meta.block.js keyword.control.flow.js",
                "source.js.jsx meta.function.js.jsx meta.block.js.jsx keyword.control.flow.js.jsx"
            ],
            "settings": { "foreground": "#5474be" }
        },
        {
            "name": "Keyword, delete, typeof, spreadOpeartor",
            "scope": [
                "source.js keyword.operator.expression.delete.js",
                "source.js.jsx keyword.operator.expression.delete.js.jsx",
                "source.js keyword.operator.expression.typeof.js",
                "source.js.jsx keyword.operator.expression.typeof.js.jsx",
                "source.js meta.var.expr.js meta.objectliteral.js meta.object.member.js keyword.operator.spread.js",
