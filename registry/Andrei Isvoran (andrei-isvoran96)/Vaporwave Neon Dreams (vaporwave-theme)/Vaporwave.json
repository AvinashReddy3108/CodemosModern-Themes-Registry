    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#a0a0a0", "fontStyle": "italic" }
        },
        {
            "name": "String",
            "scope": [
                "string",
                "string.quoted",
                "string.template",
                "string.quoted.single",
                "string.quoted.double",
                "string.quoted.triple"
            ],
            "settings": { "foreground": "#7effc8" }
        },
        {
            "name": "String Interpolation",
            "scope": [
                "punctuation.definition.template-expression",
                "punctuation.section.embedded",
                "meta.template.expression"
            ],
            "settings": { "foreground": "#ff6b9d" }
        },
        {
            "name": "Regular Expression",
            "scope": ["string.regexp"],
            "settings": { "foreground": "#ff9e64" }
        },
        {
            "name": "Number",
            "scope": [
                "constant.numeric",
                "constant.numeric.integer",
                "constant.numeric.float",
                "constant.numeric.hex",
                "constant.numeric.octal",
                "constant.numeric.binary"
            ],
            "settings": { "foreground": "#ff9e64" }
        },
        {
            "name": "Boolean",
            "scope": [
                "constant.language.boolean",
                "constant.language.true",
                "constant.language.false"
            ],
            "settings": { "foreground": "#ff9e64" }
        },
        {
            "name": "Null/Undefined",
            "scope": [
                "constant.language.null",
                "constant.language.undefined",
                "constant.language.nil"
            ],
            "settings": { "foreground": "#ff9e64" }
        },
        {
            "name": "Language Constants",
            "scope": ["constant.language"],
            "settings": { "foreground": "#ff9e64" }
        },
        {
            "name": "Other Constants",
            "scope": [
                "constant.other",
                "constant.character",
                "constant.character.escape"
            ],
            "settings": { "foreground": "#ff9e64" }
        },
        {
            "name": "Keyword",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.control.conditional",
                "keyword.control.loop",
                "keyword.control.flow"
            ],
            "settings": { "foreground": "#ff6b9d" }
        },
        {
            "name": "Keyword Operator",
            "scope": [
                "keyword.operator",
                "keyword.operator.assignment",
                "keyword.operator.arithmetic",
                "keyword.operator.logical",
                "keyword.operator.comparison"
            ],
            "settings": { "foreground": "#ff6b9d" }
        },
        {
            "name": "Keyword Other",
            "scope": ["keyword.other", "keyword.other.unit"],
            "settings": { "foreground": "#ff6b9d" }
        },
        {
            "name": "Storage Type",
            "scope": [
                "storage.type",
                "storage.type.function",
                "storage.type.class",
                "storage.type.interface",
                "storage.type.enum"
            ],
            "settings": { "foreground": "#ff6b9d" }
        },
        {
            "name": "Storage Modifier",
            "scope": [
                "storage.modifier",
                "storage.modifier.async",
                "storage.modifier.static",
                "storage.modifier.public",
                "storage.modifier.private",
                "storage.modifier.protected"
            ],
            "settings": { "foreground": "#ff6b9d" }
        },
        {
            "name": "Variable",
            "scope": [
                "variable",
                "variable.other",
                "variable.other.readwrite",
                "variable.other.local"
            ],
            "settings": { "foreground": "#00fff5" }
        },
        {
            "name": "Variable Parameter",
            "scope": ["variable.parameter", "variable.parameter.function"],
            "settings": { "foreground": "#00fff5", "fontStyle": "italic" }
        },
        {
            "name": "Variable Property",
            "scope": [
                "variable.other.property",
                "variable.other.object.property"
            ],
            "settings": { "foreground": "#00fff5" }
        },
        {
            "name": "Variable Language (this, self, super)",
            "scope": [
                "variable.language",
                "variable.language.this",
                "variable.language.self",
                "variable.language.super"
            ],
            "settings": { "foreground": "#ff6b9d", "fontStyle": "italic" }
        },
        {
            "name": "Variable Constant",
            "scope": ["variable.other.constant"],
            "settings": { "foreground": "#ff9e64" }
        },
        {
            "name": "Function Name",
            "scope": [
                "entity.name.function",
                "meta.function entity.name.function"
            ],
            "settings": { "foreground": "#ffd866" }
        },
        {
            "name": "Function Call",
            "scope": [
                "meta.function-call entity.name.function",
                "meta.function-call",
                "support.function"
            ],
            "settings": { "foreground": "#ffd866" }
        },
        {
            "name": "Method Call",
            "scope": [
                "meta.method-call entity.name.function",
                "meta.method-call"
            ],
            "settings": { "foreground": "#ffd866" }
        },
        {
            "name": "Built-in Function",
            "scope": ["support.function.builtin", "support.function.magic"],
            "settings": { "foreground": "#ffd866" }
        },
        {
            "name": "Class Name",
            "scope": ["entity.name.class", "entity.name.type.class"],
            "settings": { "foreground": "#c792ea" }
        },
        {
            "name": "Type Name",
            "scope": [
                "entity.name.type",
                "entity.name.type.interface",
                "entity.name.type.enum",
                "entity.name.type.alias"
            ],
            "settings": { "foreground": "#c792ea" }
        },
        {
            "name": "Inherited Class",
            "scope": ["entity.other.inherited-class"],
            "settings": { "foreground": "#c792ea", "fontStyle": "italic" }
        },
        {
            "name": "Support Type",
            "scope": [
                "support.type",
                "support.type.primitive",
                "support.type.builtin"
            ],
            "settings": { "foreground": "#c792ea" }
        },
        {
            "name": "Support Class",
            "scope": ["support.class"],
            "settings": { "foreground": "#c792ea" }
        },
        {
            "name": "Type Parameter",
            "scope": ["entity.name.type.parameter"],
            "settings": { "foreground": "#c792ea", "fontStyle": "italic" }
        },
        {
            "name": "Decorator",
            "scope": [
                "meta.decorator",
                "entity.name.function.decorator",
                "punctuation.decorator"
            ],
            "settings": { "foreground": "#c792ea" }
        },
        {
            "name": "Annotation",
            "scope": ["meta.annotation", "storage.type.annotation"],
            "settings": { "foreground": "#c792ea" }
        },
        {
            "name": "Module Name",
            "scope": ["entity.name.module", "entity.name.namespace"],
            "settings": { "foreground": "#c792ea" }
        },
        {
            "name": "Import/Export",
            "scope": [
                "keyword.control.import",
                "keyword.control.export",
                "keyword.control.from",
                "keyword.control.as"
            ],
            "settings": { "foreground": "#ff6b9d" }
        },
        {
            "name": "Module Path",
            "scope": ["string.quoted.module"],
            "settings": { "foreground": "#7effc8" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation",
                "punctuation.definition",
                "punctuation.separator",
                "punctuation.terminator"
            ],
            "settings": { "foreground": "#eaeaea" }
        },
        {
            "name": "Brackets",
            "scope": [
                "punctuation.definition.block",
                "punctuation.definition.parameters",
                "punctuation.section.block",
                "punctuation.section.function",
                "meta.brace"
            ],
            "settings": { "foreground": "#eaeaea" }
        },
        {
            "name": "Tag Name",
            "scope": ["entity.name.tag", "punctuation.definition.tag"],
            "settings": { "foreground": "#ff6b9d" }
        },
        {
            "name": "Tag Attribute",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#c792ea", "fontStyle": "italic" }
        },
        {
            "name": "Tag Attribute Value",
            "scope": ["string.quoted.double.html", "string.quoted.single.html"],
            "settings": { "foreground": "#7effc8" }
        },
        {
            "name": "Component Tag (JSX/Vue)",
            "scope": ["support.class.component", "entity.name.tag.component"],
            "settings": { "foreground": "#c792ea" }
        },
        {
            "name": "CSS Selector",
            "scope": [
                "entity.name.tag.css",
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css"
            ],
            "settings": { "foreground": "#ffd866" }
        },
        {
