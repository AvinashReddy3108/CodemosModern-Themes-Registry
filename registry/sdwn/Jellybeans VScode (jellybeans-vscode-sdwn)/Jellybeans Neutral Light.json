            "settings": { "foreground": "#3a6830" }
        },
        {
            "name": "String Regex",
            "scope": ["string.regexp"],
            "settings": { "foreground": "#806030" }
        },
        {
            "name": "Symbols",
            "scope": ["constant.other.symbol", "constant.other.key"],
