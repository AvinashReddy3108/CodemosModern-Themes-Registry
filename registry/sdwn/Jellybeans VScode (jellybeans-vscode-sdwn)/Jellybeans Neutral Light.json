        "function.defaultLibrary": "#883838",
        "method": "#706010",
        "method.declaration": { "foreground": "#706010", "fontStyle": "" },
        "class": { "foreground": "#6848a0", "fontStyle": "" },
        "class.declaration": { "foreground": "#604898", "fontStyle": "" },
        "interface": { "foreground": "#604898", "fontStyle": "italic" },
        "type": { "foreground": "#6848a0", "fontStyle": "" },
        "type.declaration": { "foreground": "#604898", "fontStyle": "" },
        "enum": { "foreground": "#604898", "fontStyle": "" },
        "enumMember": { "foreground": "#883838", "fontStyle": "" },
        "namespace": { "foreground": "#706010", "fontStyle": "italic" },
        "keyword": { "foreground": "#4a6898", "fontStyle": "" },
        "string": "#3a6830",
        "number": "#883838",
        "regexp": "#806030",
        "operator": "#3a6880",
        "decorator": { "foreground": "#883838", "fontStyle": "italic" },
        "macro": { "foreground": "#5a80a0", "fontStyle": "" },
        "comment": { "foreground": "#808080", "fontStyle": "italic" },
        "type.defaultLibrary": {
            "foreground": "#3a6830",
            "fontStyle": "italic"
        },
        "typeParameter": { "foreground": "#6848a0", "fontStyle": "italic" }
    },
    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "fontStyle": "italic", "foreground": "#808080" }
        },
        {
            "name": "Variables",
            "scope": [
                "variable",
                "string constant.other.placeholder",
                "variable.other.readwrite",
                "variable.other.object"
            ],
            "settings": { "foreground": "#583888" }
        },
        {
            "name": "Variable Parameters",
            "scope": ["variable.parameter", "meta.function.parameter"],
            "settings": { "foreground": "#604880" }
        },
        {
            "name": "Variable Special/Builtin",
            "scope": ["variable.language", "variable.other.constant"],
            "settings": { "fontStyle": "", "foreground": "#883838" }
        },
        {
            "name": "Object Properties",
            "scope": [
                "variable.other.property",
                "variable.other.object.property",
                "meta.object-literal.key"
            ],
            "settings": { "foreground": "#303030" }
        },
        {
            "name": "Colors",
            "scope": ["constant.other.color"],
            "settings": { "foreground": "#883838" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal", "invalid.deprecated"],
            "settings": { "fontStyle": "", "foreground": "#883838" }
        },
        {
            "name": "Keyword",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.control.conditional",
                "keyword.control.loop",
                "keyword.control.flow"
            ],
            "settings": { "fontStyle": "", "foreground": "#4a6898" }
        },
        {
            "name": "Storage Type",
            "scope": [
                "storage.type",
                "storage.type.function",
                "storage.type.class"
            ],
            "settings": { "fontStyle": "", "foreground": "#4a6898" }
        },
        {
            "name": "Storage Modifier",
            "scope": ["storage.modifier", "keyword.other.special-method"],
            "settings": { "fontStyle": "italic", "foreground": "#4a6898" }
        },
        {
            "name": "Keyword Import/Export",
            "scope": [
                "keyword.control.import",
                "keyword.control.export",
                "keyword.control.from",
                "keyword.control.as"
            ],
            "settings": { "foreground": "#5a80a0" }
        },
        {
            "name": "Keyword Return",
            "scope": ["keyword.control.return"],
            "settings": { "fontStyle": "", "foreground": "#4a6898" }
        },
        {
            "name": "Operator",
            "scope": [
                "keyword.operator",
                "keyword.operator.arithmetic",
                "keyword.operator.comparison",
                "keyword.operator.logical",
                "keyword.operator.assignment"
            ],
            "settings": { "foreground": "#3a6880" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation",
                "meta.brace",
                "punctuation.section.embedded"
            ],
            "settings": { "foreground": "#404040" }
        },
        {
            "name": "Punctuation Brackets",
            "scope": [
                "punctuation.definition.bracket",
                "punctuation.definition.parameters",
                "punctuation.definition.block",
                "meta.brace.round",
                "meta.brace.square",
                "meta.brace.curly"
            ],
            "settings": { "foreground": "#606060" }
        },
        {
            "name": "Punctuation Delimiter",
            "scope": [
                "punctuation.separator",
                "punctuation.delimiter",
                "punctuation.terminator"
            ],
            "settings": { "foreground": "#505050" }
        },
        {
            "name": "Tag",
            "scope": ["entity.name.tag", "meta.tag.sgml"],
            "settings": { "fontStyle": "", "foreground": "#4a6898" }
        },
        {
            "name": "Tag Attribute",
            "scope": ["entity.other.attribute-name"],
            "settings": { "fontStyle": "italic", "foreground": "#706010" }
        },
        {
            "name": "Tag Punctuation",
            "scope": [
                "punctuation.definition.tag",
                "punctuation.definition.tag.html",
                "punctuation.definition.tag.begin.html",
                "punctuation.definition.tag.end.html"
            ],
            "settings": { "foreground": "#3a6830" }
        },
        {
            "name": "Function Declaration",
            "scope": [
                "entity.name.function",
                "meta.function.declaration entity.name.function"
            ],
            "settings": { "fontStyle": "", "foreground": "#706010" }
        },
        {
            "name": "Function Call",
            "scope": [
                "meta.function-call",
                "variable.function",
                "entity.name.function-call"
            ],
            "settings": { "foreground": "#706010" }
        },
        {
            "name": "Function Builtin",
            "scope": ["support.function", "support.function.builtin"],
            "settings": { "foreground": "#883838" }
        },
        {
            "name": "Method",
            "scope": ["entity.name.method", "entity.name.method-call"],
            "settings": { "fontStyle": "", "foreground": "#706010" }
        },
        {
            "name": "Number",
            "scope": [
                "constant.numeric",
                "constant.numeric.integer",
                "constant.numeric.float",
                "constant.numeric.hex",
                "constant.numeric.octal",
                "constant.numeric.binary"
            ],
            "settings": { "foreground": "#883838" }
        },
        {
            "name": "Constant",
            "scope": [
                "constant.language",
                "constant.language.boolean",
                "constant.language.null",
                "constant.language.undefined"
            ],
            "settings": { "fontStyle": "", "foreground": "#883838" }
        },
        {
            "name": "Constant Builtin",
            "scope": ["support.constant", "support.constant.builtin"],
            "settings": { "fontStyle": "", "foreground": "#883838" }
        },
        {
            "name": "Constant Character Escape",
            "scope": ["constant.character.escape", "constant.escape"],
            "settings": { "fontStyle": "", "foreground": "#883838" }
        },
        {
            "name": "String",
            "scope": [
                "string",
                "string.quoted",
                "string.quoted.double",
                "string.quoted.single",
                "string.template"
            ],
            "settings": { "foreground": "#3a6830" }
        },
        {
            "name": "String Interpolation",
            "scope": [
                "punctuation.definition.template-expression",
