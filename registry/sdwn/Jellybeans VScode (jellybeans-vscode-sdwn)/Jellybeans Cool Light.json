        "function.defaultLibrary": "#c82020",
        "method": "#1564c0",
        "method.declaration": { "foreground": "#1564c0", "fontStyle": "" },
        "class": { "foreground": "#0e6b8a", "fontStyle": "" },
        "class.declaration": { "foreground": "#0a5878", "fontStyle": "" },
        "interface": { "foreground": "#0a5878", "fontStyle": "italic" },
        "type": { "foreground": "#0e6b8a", "fontStyle": "" },
        "type.declaration": { "foreground": "#0a5878", "fontStyle": "" },
        "enum": { "foreground": "#0a5878", "fontStyle": "" },
        "enumMember": { "foreground": "#c82020", "fontStyle": "" },
        "namespace": { "foreground": "#1564c0", "fontStyle": "italic" },
        "keyword": { "foreground": "#6030c8", "fontStyle": "" },
        "string": "#1a8070",
        "number": "#c73030",
        "regexp": "#9a7000",
        "operator": "#2080a0",
        "decorator": { "foreground": "#c82020", "fontStyle": "italic" },
        "macro": { "foreground": "#2a7cbf", "fontStyle": "" },
        "comment": { "foreground": "#7090a8", "fontStyle": "italic" },
        "type.defaultLibrary": {
            "foreground": "#1a8070",
            "fontStyle": "italic"
        },
        "typeParameter": { "foreground": "#0e6b8a", "fontStyle": "italic" }
    },
    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "fontStyle": "italic", "foreground": "#7090a8" }
        },
        {
            "name": "Variables",
            "scope": [
                "variable",
                "string constant.other.placeholder",
                "variable.other.readwrite",
                "variable.other.object"
            ],
            "settings": { "foreground": "#502888" }
        },
        {
            "name": "Variable Parameters",
            "scope": ["variable.parameter", "meta.function.parameter"],
            "settings": { "foreground": "#7050b0" }
        },
        {
            "name": "Variable Special/Builtin",
            "scope": ["variable.language", "variable.other.constant"],
            "settings": { "fontStyle": "", "foreground": "#c82020" }
        },
        {
            "name": "Object Properties",
            "scope": [
                "variable.other.property",
                "variable.other.object.property",
                "meta.object-literal.key"
            ],
            "settings": { "foreground": "#405878" }
        },
        {
            "name": "Colors",
            "scope": ["constant.other.color"],
            "settings": { "foreground": "#c82020" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal", "invalid.deprecated"],
            "settings": { "fontStyle": "", "foreground": "#c82020" }
        },
        {
            "name": "Keyword",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.control.conditional",
                "keyword.control.loop",
                "keyword.control.flow"
            ],
            "settings": { "fontStyle": "", "foreground": "#6030c8" }
        },
        {
            "name": "Storage Type",
            "scope": [
                "storage.type",
                "storage.type.function",
                "storage.type.class"
            ],
            "settings": { "fontStyle": "", "foreground": "#6030c8" }
        },
        {
            "name": "Storage Modifier",
            "scope": ["storage.modifier", "keyword.other.special-method"],
            "settings": { "fontStyle": "italic", "foreground": "#6030c8" }
        },
        {
            "name": "Keyword Import/Export",
            "scope": [
                "keyword.control.import",
                "keyword.control.export",
                "keyword.control.from",
                "keyword.control.as"
            ],
            "settings": { "foreground": "#2a7cbf" }
        },
        {
            "name": "Keyword Return",
            "scope": ["keyword.control.return"],
            "settings": { "fontStyle": "", "foreground": "#6030c8" }
        },
        {
            "name": "Operator",
            "scope": [
                "keyword.operator",
                "keyword.operator.arithmetic",
                "keyword.operator.comparison",
                "keyword.operator.logical",
                "keyword.operator.assignment"
            ],
            "settings": { "foreground": "#2080a0" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation",
                "meta.brace",
                "punctuation.section.embedded"
            ],
            "settings": { "foreground": "#2a3d55" }
        },
        {
            "name": "Punctuation Brackets",
            "scope": [
                "punctuation.definition.bracket",
                "punctuation.definition.parameters",
                "punctuation.definition.block",
                "meta.brace.round",
                "meta.brace.square",
                "meta.brace.curly"
            ],
            "settings": { "foreground": "#405878" }
        },
        {
            "name": "Punctuation Delimiter",
            "scope": [
                "punctuation.separator",
                "punctuation.delimiter",
                "punctuation.terminator"
            ],
            "settings": { "foreground": "#304868" }
        },
        {
            "name": "Tag",
            "scope": ["entity.name.tag", "meta.tag.sgml"],
            "settings": { "fontStyle": "", "foreground": "#6030c8" }
        },
        {
            "name": "Tag Attribute",
            "scope": ["entity.other.attribute-name"],
            "settings": { "fontStyle": "italic", "foreground": "#1564c0" }
        },
        {
            "name": "Tag Punctuation",
            "scope": [
                "punctuation.definition.tag",
                "punctuation.definition.tag.html",
                "punctuation.definition.tag.begin.html",
                "punctuation.definition.tag.end.html"
            ],
            "settings": { "foreground": "#1a8070" }
        },
        {
            "name": "Function Declaration",
            "scope": [
                "entity.name.function",
                "meta.function.declaration entity.name.function"
            ],
            "settings": { "fontStyle": "", "foreground": "#1564c0" }
        },
        {
            "name": "Function Call",
            "scope": [
                "meta.function-call",
                "variable.function",
                "entity.name.function-call"
            ],
            "settings": { "foreground": "#1564c0" }
        },
        {
            "name": "Function Builtin",
            "scope": ["support.function", "support.function.builtin"],
            "settings": { "foreground": "#c82020" }
        },
        {
            "name": "Method",
            "scope": ["entity.name.method", "entity.name.method-call"],
            "settings": { "fontStyle": "", "foreground": "#1564c0" }
        },
        {
            "name": "Number",
            "scope": [
                "constant.numeric",
                "constant.numeric.integer",
                "constant.numeric.float",
                "constant.numeric.hex",
                "constant.numeric.octal",
                "constant.numeric.binary"
            ],
            "settings": { "foreground": "#c73030" }
        },
        {
            "name": "Constant",
            "scope": [
                "constant.language",
                "constant.language.boolean",
                "constant.language.null",
                "constant.language.undefined"
            ],
            "settings": { "fontStyle": "", "foreground": "#c73030" }
        },
        {
            "name": "Constant Builtin",
            "scope": ["support.constant", "support.constant.builtin"],
            "settings": { "fontStyle": "", "foreground": "#c82020" }
        },
        {
            "name": "Constant Character Escape",
            "scope": ["constant.character.escape", "constant.escape"],
            "settings": { "fontStyle": "", "foreground": "#c82020" }
        },
        {
            "name": "String",
            "scope": [
                "string",
                "string.quoted",
                "string.quoted.double",
                "string.quoted.single",
                "string.template"
            ],
            "settings": { "foreground": "#1a8070" }
        },
        {
            "name": "String Interpolation",
            "scope": [
                "punctuation.definition.template-expression",
                "meta.template.expression"
            ],
            "settings": { "foreground": "#1a8070" }
        },
        {
            "name": "String Regex",
            "scope": ["string.regexp"],
            "settings": { "foreground": "#9a7000" }
        },
        {
            "name": "Symbols",
            "scope": ["constant.other.symbol", "constant.other.key"],
            "settings": { "fontStyle": "", "foreground": "#1a8070" }
        },
        {
            "name": "Class",
            "scope": [
                "entity.name.class",
                "entity.name.type.class",
                "support.class"
            ],
            "settings": { "fontStyle": "", "foreground": "#0e6b8a" }
        },
        {
            "name": "Class Definition",
            "scope": [
                "meta.class entity.name.class",
                "meta.class.declaration entity.name.type"
