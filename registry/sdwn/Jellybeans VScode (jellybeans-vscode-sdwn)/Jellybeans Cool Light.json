            "settings": { "fontStyle": "", "foreground": "#0a5878" }
        },
        {
            "name": "Type",
            "scope": ["entity.name.type", "support.type"],
            "settings": { "fontStyle": "", "foreground": "#0e6b8a" }
        },
        {
            "name": "Type Builtin",
            "scope": ["support.type.primitive", "support.type.builtin"],
            "settings": { "fontStyle": "italic", "foreground": "#1a8070" }
        },
        {
            "name": "Interface",
            "scope": ["entity.name.type.interface"],
            "settings": { "fontStyle": "italic", "foreground": "#0a5878" }
        },
        {
            "name": "Namespace",
            "scope": [
                "entity.name.namespace",
                "support.other.namespace",
                "support.other.namespace.use.php",
                "support.other.namespace.php",
                "meta.use.php"
            ],
            "settings": { "fontStyle": "italic", "foreground": "#1564c0" }
