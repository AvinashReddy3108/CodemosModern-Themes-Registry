    "semanticTokenColors": {
        "variable": "#b5c9e0",
        "variable.readonly": "#b5c9e0",
        "variable.defaultLibrary": "#f07070",
        "property": "#a0c8e8",
        "property.readonly": "#82aaff",
        "parameter": "#d0c0f0",
        "function": "#82aaff",
        "function.declaration": { "foreground": "#82aaff", "fontStyle": "" },
        "function.defaultLibrary": "#f07070",
        "method": "#82aaff",
        "method.declaration": { "foreground": "#82aaff", "fontStyle": "" },
        "class": { "foreground": "#89ddff", "fontStyle": "" },
        "class.declaration": { "foreground": "#a0eeff", "fontStyle": "" },
        "interface": { "foreground": "#a0eeff", "fontStyle": "italic" },
        "type": { "foreground": "#89ddff", "fontStyle": "" },
        "type.declaration": { "foreground": "#a0eeff", "fontStyle": "" },
        "enum": { "foreground": "#a0eeff", "fontStyle": "" },
        "enumMember": { "foreground": "#f07070", "fontStyle": "" },
        "namespace": { "foreground": "#82aaff", "fontStyle": "italic" },
        "keyword": { "foreground": "#c792ea", "fontStyle": "" },
        "string": "#73c0a9",
        "number": "#f78c6c",
        "regexp": "#e0c060",
        "operator": "#89ddff",
        "decorator": { "foreground": "#f07070", "fontStyle": "italic" },
        "macro": { "foreground": "#4fc3f7", "fontStyle": "" },
        "comment": { "foreground": "#4a6878", "fontStyle": "italic" },
        "type.defaultLibrary": {
            "foreground": "#5a9a80",
            "fontStyle": "italic"
        },
        "typeParameter": { "foreground": "#89ddff", "fontStyle": "italic" }
    },
    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "fontStyle": "italic", "foreground": "#4a6878" }
        },
        {
            "name": "Variables",
            "scope": [
                "variable",
                "string constant.other.placeholder",
                "variable.other.readwrite",
                "variable.other.object"
            ],
            "settings": { "foreground": "#b5c9e0" }
        },
        {
            "name": "Variable Parameters",
            "scope": ["variable.parameter", "meta.function.parameter"],
            "settings": { "foreground": "#d0c0f0" }
        },
        {
            "name": "Variable Special/Builtin",
            "scope": ["variable.language", "variable.other.constant"],
            "settings": { "fontStyle": "", "foreground": "#f07070" }
        },
        {
            "name": "Object Properties",
            "scope": [
                "variable.other.property",
                "variable.other.object.property",
                "meta.object-literal.key"
            ],
            "settings": { "foreground": "#a0c8e8" }
        },
        {
            "name": "Colors",
            "scope": ["constant.other.color"],
            "settings": { "foreground": "#f07070" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal", "invalid.deprecated"],
            "settings": { "fontStyle": "", "foreground": "#f07070" }
        },
        {
            "name": "Keyword",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.control.conditional",
                "keyword.control.loop",
                "keyword.control.flow"
            ],
            "settings": { "fontStyle": "", "foreground": "#c792ea" }
        },
        {
            "name": "Storage Type",
            "scope": [
                "storage.type",
                "storage.type.function",
                "storage.type.class"
            ],
            "settings": { "fontStyle": "", "foreground": "#c792ea" }
        },
        {
            "name": "Storage Modifier",
            "scope": ["storage.modifier", "keyword.other.special-method"],
            "settings": { "fontStyle": "italic", "foreground": "#c792ea" }
        },
        {
            "name": "Keyword Import/Export",
            "scope": [
                "keyword.control.import",
                "keyword.control.export",
                "keyword.control.from",
                "keyword.control.as"
            ],
            "settings": { "foreground": "#4fc3f7" }
        },
        {
            "name": "Keyword Return",
            "scope": ["keyword.control.return"],
            "settings": { "fontStyle": "", "foreground": "#c792ea" }
        },
        {
            "name": "Operator",
            "scope": [
                "keyword.operator",
                "keyword.operator.arithmetic",
                "keyword.operator.comparison",
                "keyword.operator.logical",
                "keyword.operator.assignment"
            ],
            "settings": { "foreground": "#89ddff" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation",
                "meta.brace",
                "punctuation.section.embedded"
            ],
            "settings": { "foreground": "#8098b0" }
        },
        {
            "name": "Punctuation Brackets",
            "scope": [
                "punctuation.definition.bracket",
                "punctuation.definition.parameters",
                "punctuation.definition.block",
                "meta.brace.round",
                "meta.brace.square",
                "meta.brace.curly"
            ],
            "settings": { "foreground": "#6a8098" }
        },
        {
            "name": "Punctuation Delimiter",
            "scope": [
                "punctuation.separator",
                "punctuation.delimiter",
                "punctuation.terminator"
            ],
            "settings": { "foreground": "#7090a8" }
        },
        {
            "name": "Tag",
            "scope": ["entity.name.tag", "meta.tag.sgml"],
            "settings": { "fontStyle": "", "foreground": "#c792ea" }
        },
        {
            "name": "Tag Attribute",
            "scope": ["entity.other.attribute-name"],
            "settings": { "fontStyle": "italic", "foreground": "#82aaff" }
        },
        {
            "name": "Tag Punctuation",
            "scope": [
                "punctuation.definition.tag",
                "punctuation.definition.tag.html",
                "punctuation.definition.tag.begin.html",
                "punctuation.definition.tag.end.html"
            ],
            "settings": { "foreground": "#5a9a80" }
        },
        {
            "name": "Function Declaration",
            "scope": [
                "entity.name.function",
                "meta.function.declaration entity.name.function"
            ],
            "settings": { "fontStyle": "", "foreground": "#82aaff" }
        },
        {
            "name": "Function Call",
            "scope": [
                "meta.function-call",
                "variable.function",
                "entity.name.function-call"
            ],
            "settings": { "foreground": "#82aaff" }
        },
        {
            "name": "Function Builtin",
            "scope": ["support.function", "support.function.builtin"],
            "settings": { "foreground": "#f07070" }
        },
        {
            "name": "Method",
            "scope": ["entity.name.method", "entity.name.method-call"],
            "settings": { "fontStyle": "", "foreground": "#82aaff" }
        },
        {
            "name": "Number",
            "scope": [
                "constant.numeric",
                "constant.numeric.integer",
                "constant.numeric.float",
                "constant.numeric.hex",
                "constant.numeric.octal",
                "constant.numeric.binary"
            ],
            "settings": { "foreground": "#f78c6c" }
        },
        {
            "name": "Constant",
            "scope": [
                "constant.language",
                "constant.language.boolean",
                "constant.language.null",
                "constant.language.undefined"
            ],
            "settings": { "fontStyle": "", "foreground": "#f78c6c" }
        },
        {
            "name": "Constant Builtin",
            "scope": ["support.constant", "support.constant.builtin"],
            "settings": { "fontStyle": "", "foreground": "#f07070" }
        },
        {
            "name": "Constant Character Escape",
            "scope": ["constant.character.escape", "constant.escape"],
            "settings": { "fontStyle": "", "foreground": "#f07070" }
        },
        {
            "name": "String",
            "scope": [
                "string",
                "string.quoted",
                "string.quoted.double",
                "string.quoted.single",
                "string.template"
            ],
            "settings": { "foreground": "#73c0a9" }
        },
        {
            "name": "String Interpolation",
            "scope": [
                "punctuation.definition.template-expression",
                "meta.template.expression"
            ],
            "settings": { "foreground": "#5a9a80" }
        },
        {
            "name": "String Regex",
            "scope": ["string.regexp"],
            "settings": { "foreground": "#e0c060" }
        },
        {
            "name": "Symbols",
            "scope": ["constant.other.symbol", "constant.other.key"],
            "settings": { "fontStyle": "", "foreground": "#73c0a9" }
        },
        {
            "name": "Class",
            "scope": [
                "entity.name.class",
                "entity.name.type.class",
                "support.class"
            ],
            "settings": { "fontStyle": "", "foreground": "#89ddff" }
        },
        {
            "name": "Class Definition",
            "scope": [
                "meta.class entity.name.class",
                "meta.class.declaration entity.name.type"
            ],
            "settings": { "fontStyle": "", "foreground": "#a0eeff" }
        },
        {
            "name": "Type",
            "scope": ["entity.name.type", "support.type"],
            "settings": { "fontStyle": "", "foreground": "#89ddff" }
        },
        {
            "name": "Type Builtin",
            "scope": ["support.type.primitive", "support.type.builtin"],
            "settings": { "fontStyle": "italic", "foreground": "#5a9a80" }
        },
        {
            "name": "Interface",
            "scope": ["entity.name.type.interface"],
            "settings": { "fontStyle": "italic", "foreground": "#a0eeff" }
        },
        {
            "name": "Namespace",
            "scope": [
                "entity.name.namespace",
                "support.other.namespace",
                "support.other.namespace.use.php",
                "support.other.namespace.php",
                "meta.use.php"
            ],
            "settings": { "fontStyle": "italic", "foreground": "#82aaff" }
        },
        {
            "name": "Inherited Class",
            "scope": ["entity.other.inherited-class"],
            "settings": { "fontStyle": "italic", "foreground": "#89ddff" }
        },
