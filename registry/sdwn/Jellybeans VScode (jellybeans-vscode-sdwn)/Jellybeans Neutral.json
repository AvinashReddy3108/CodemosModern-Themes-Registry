            "settings": { "foreground": "#88a478" }
        },
        {
            "name": "String Regex",
            "scope": ["string.regexp"],
            "settings": { "foreground": "#d8b478" }
        },
        {
            "name": "Symbols",
            "scope": ["constant.other.symbol", "constant.other.key"],
            "settings": { "fontStyle": "", "foreground": "#96a878" }
        },
        {
            "name": "Class",
            "scope": [
