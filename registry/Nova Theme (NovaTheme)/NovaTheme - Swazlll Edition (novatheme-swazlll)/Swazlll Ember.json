    "semanticHighlighting": true,
    "semanticTokenColors": {
        "namespace": "#ffb380",
        "namespace.declaration": "#ffcc99",
        "class": "#ffcc99",
        "class.declaration": "#ffcc99",
        "interface": { "foreground": "#ffaa44", "fontStyle": "italic" },
        "struct": "#ffcc99",
        "enum": "#ffcc99",
        "enumMember": "#ffe0cc",
        "typeAlias": "#ffcc99",
        "type": "#ffcc99",
        "type.defaultLibrary": "#ffcc99",
        "function": "#ff9933",
        "function.declaration": "#ff9933",
        "method": "#ff9933",
        "method.declaration": "#ff9933",
        "macro": "#ffcc00",
        "variable": "#ffe0cc",
        "variable.readonly": "#ffffff",
        "variable.defaultLibrary": "#ffe0cc",
        "parameter": { "foreground": "#ffffff", "fontStyle": "italic" },
        "property": "#ffe0cc",
        "property.declaration": "#ffe0cc",
        "property.readonly": { "foreground": "#ffcc99" },
        "event": "#ffcc00",
        "decorator": { "foreground": "#ffcc00", "fontStyle": "italic" },
        "label": "#ffcc00",
        "keyword": "#ff6600",
        "comment": { "foreground": "#5a2a00", "fontStyle": "italic" },
        "string": "#ffb380",
        "number": "#ffcc00",
        "regexp": "#ffdd44",
        "operator": "#ff9933",
        "selfKeyword": { "foreground": "#ffcc00", "fontStyle": "italic" },
        "magicFunction": { "foreground": "#ffcc00", "fontStyle": "italic" },
        "builtinType": "#ffcc99",
        "constParameter": { "foreground": "#ffffff", "fontStyle": "italic" }
    },
    "tokenColors": [
        {
            "name": "Comment",
            "scope": [
                "comment",
                "comment.line",
                "comment.block",
                "comment.block.documentation"
            ],
            "settings": { "foreground": "#5a2a00", "fontStyle": "italic" }
        },
        {
            "name": "String",
            "scope": [
                "string",
                "string.quoted",
                "string.quoted.single",
                "string.quoted.double",
                "string.template"
            ],
            "settings": { "foreground": "#ffb380" }
        },
        {
            "name": "String - Escape Sequences",
            "scope": "constant.character.escape",
            "settings": { "foreground": "#ffcc00" }
        },
        {
            "name": "Regular Expressions",
            "scope": "string.regexp",
            "settings": { "foreground": "#ffdd44" }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.control.flow",
                "keyword.control.return",
                "keyword.control.conditional",
                "keyword.control.loop",
                "keyword.control.import",
                "keyword.control.from",
                "keyword.control.export"
            ],
            "settings": { "foreground": "#ff6600" }
        },
        {
            "name": "Keywords - Operators",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#ff9933" }
        },
        {
            "name": "Storage Types",
            "scope": [
                "storage.type",
                "storage.type.function",
                "storage.type.class",
                "storage.type.let",
                "storage.type.const",
                "storage.type.var"
            ],
            "settings": { "foreground": "#ff6600" }
        },
        {
            "name": "Storage Modifiers",
            "scope": [
                "storage.modifier",
                "storage.modifier.async",
                "storage.modifier.static"
            ],
            "settings": { "foreground": "#ff9933", "fontStyle": "italic" }
        },
        {
            "name": "Function Names",
            "scope": ["entity.name.function", "entity.name.function.member"],
            "settings": { "foreground": "#ff9933" }
        },
        {
            "name": "Function Calls",
            "scope": ["meta.function-call", "support.function"],
            "settings": { "foreground": "#ff9933" }
        },
        {
            "name": "Built-in Functions",
            "scope": ["support.function.builtin", "support.function.magic"],
            "settings": { "foreground": "#ffcc00" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "variable.other", "variable.other.readwrite"],
            "settings": { "foreground": "#ffe0cc" }
        },
        {
            "name": "Variables - Parameter",
            "scope": "variable.parameter",
            "settings": { "foreground": "#ffffff", "fontStyle": "italic" }
        },
        {
            "name": "Variables - Language",
            "scope": ["variable.language", "variable.language.this"],
            "settings": { "foreground": "#ffcc00", "fontStyle": "italic" }
        },
        {
            "name": "Types / Classes",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "entity.name.interface",
                "entity.name.enum"
            ],
            "settings": { "foreground": "#ffcc99" }
        },
        {
            "name": "Numbers",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#ffcc00" }
        },
        {
            "name": "Language Constants",
            "scope": [
                "constant.language",
                "constant.language.boolean",
                "constant.language.null"
            ],
            "settings": { "foreground": "#ff9944" }
        },
        {
            "name": "Decorator",
            "scope": ["meta.decorator", "entity.name.function.decorator"],
            "settings": { "foreground": "#ffcc00", "fontStyle": "italic" }
        },
        {
            "name": "Tag Names",
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#ff6600" }
        },
        {
            "name": "Tag Attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#ff9933" }
        },
        {
            "name": "CSS Properties",
            "scope": "support.type.property-name",
            "settings": { "foreground": "#ffb380" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation",
                "punctuation.separator",
                "punctuation.terminator"
            ],
            "settings": { "foreground": "#ffb380" }
        },
        {
            "name": "Markdown Headings",
            "scope": ["markup.heading"],
            "settings": { "foreground": "#ff6600", "fontStyle": "bold" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#ff3333" }
        }
    ]
}
