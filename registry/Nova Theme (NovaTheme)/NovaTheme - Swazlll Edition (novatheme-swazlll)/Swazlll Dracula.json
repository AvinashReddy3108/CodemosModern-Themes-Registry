    "semanticHighlighting": true,
    "semanticTokenColors": {
        "namespace": "#8be9fd",
        "namespace.declaration": "#cfc3ff",
        "class": "#cfc3ff",
        "class.declaration": "#cfc3ff",
        "interface": { "foreground": "#50fa7b", "fontStyle": "italic" },
        "struct": "#cfc3ff",
        "enum": "#cfc3ff",
        "enumMember": "#f8f8f2",
        "typeAlias": "#cfc3ff",
        "type": "#cfc3ff",
        "type.defaultLibrary": "#cfc3ff",
        "function": "#50fa7b",
        "function.declaration": "#50fa7b",
        "method": "#50fa7b",
        "method.declaration": "#50fa7b",
        "macro": "#ffb86c",
        "variable": "#f8f8f2",
        "variable.readonly": "#f8f8f2",
        "variable.defaultLibrary": "#f8f8f2",
        "parameter": { "foreground": "#ffb86c", "fontStyle": "italic" },
        "property": "#f8f8f2",
        "property.declaration": "#f8f8f2",
        "property.readonly": { "foreground": "#f8f8f2" },
        "event": "#ff79c6",
        "decorator": { "foreground": "#ff79c6", "fontStyle": "italic" },
        "label": "#ffb86c",
        "keyword": "#ff79c6",
        "comment": { "foreground": "#6272a4", "fontStyle": "italic" },
        "string": "#f1fa8c",
        "number": "#bd93f9",
        "regexp": "#ffb86c",
        "operator": "#ff79c6",
        "selfKeyword": { "foreground": "#bd93f9", "fontStyle": "italic" },
        "magicFunction": { "foreground": "#ff79c6", "fontStyle": "italic" },
        "builtinType": "#cfc3ff",
        "constParameter": { "foreground": "#ffb86c", "fontStyle": "italic" }
    },
    "tokenColors": [
        {
            "name": "Comment",
            "scope": [
                "comment",
                "comment.line",
                "comment.block",
                "comment.block.documentation"
            ],
            "settings": { "foreground": "#6272a4", "fontStyle": "italic" }
        },
        {
            "name": "String",
            "scope": [
                "string",
                "string.quoted",
                "string.quoted.single",
                "string.quoted.double",
                "string.template"
            ],
            "settings": { "foreground": "#f1fa8c" }
        },
        {
            "name": "String - Escape Sequences",
            "scope": "constant.character.escape",
            "settings": { "foreground": "#ff79c6" }
        },
        {
            "name": "Regular Expressions",
            "scope": "string.regexp",
            "settings": { "foreground": "#ffb86c" }
        },
        {
            "name": "Keywords - Control Flow",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.control.flow",
                "keyword.control.return",
                "keyword.control.conditional",
                "keyword.control.loop",
                "keyword.control.trycatch",
                "keyword.control.import",
                "keyword.control.from",
                "keyword.control.export",
                "keyword.control.default"
            ],
            "settings": { "foreground": "#ff79c6" }
        },
        {
            "name": "Keywords - Operators",
            "scope": [
                "keyword.operator",
                "keyword.operator.assignment",
                "keyword.operator.comparison",
                "keyword.operator.logical",
                "keyword.operator.arithmetic",
                "keyword.operator.type",
                "keyword.operator.new"
            ],
            "settings": { "foreground": "#ff79c6" }
        },
        {
            "name": "Storage Types",
            "scope": [
                "storage.type",
                "storage.type.function",
                "storage.type.class",
                "storage.type.let",
                "storage.type.const",
                "storage.type.var"
            ],
            "settings": { "foreground": "#ff79c6" }
        },
        {
            "name": "Storage Modifiers",
            "scope": [
                "storage.modifier",
                "storage.modifier.async",
                "storage.modifier.static",
                "storage.modifier.abstract"
            ],
            "settings": { "foreground": "#bd93f9", "fontStyle": "italic" }
        },
        {
            "name": "Function Names",
            "scope": [
                "entity.name.function",
                "entity.name.function.member",
                "meta.definition.method entity.name.function"
            ],
            "settings": { "foreground": "#50fa7b" }
        },
        {
            "name": "Function Calls",
            "scope": [
                "meta.function-call",
                "meta.function-call entity.name.function",
                "support.function"
            ],
            "settings": { "foreground": "#50fa7b" }
        },
        {
            "name": "Built-in Functions",
            "scope": [
                "support.function.builtin",
                "support.function.console",
                "support.function.magic"
            ],
            "settings": { "foreground": "#8be9fd" }
        },
        {
            "name": "Variables",
            "scope": [
                "variable",
                "variable.other",
                "variable.other.readwrite",
                "variable.other.local"
            ],
            "settings": { "foreground": "#f8f8f2" }
        },
        {
            "name": "Variables - Constants",
            "scope": [
                "variable.other.constant",
                "variable.other.constant.property"
            ],
            "settings": { "foreground": "#f8f8f2" }
        },
        {
            "name": "Variables - Parameter",
            "scope": "variable.parameter",
            "settings": { "foreground": "#ffb86c", "fontStyle": "italic" }
        },
        {
            "name": "Variables - Language",
            "scope": [
                "variable.language",
                "variable.language.this",
                "variable.language.self"
            ],
            "settings": { "foreground": "#bd93f9", "fontStyle": "italic" }
        },
        {
            "name": "Types / Classes",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "entity.name.interface",
                "entity.name.struct",
                "entity.name.enum"
            ],
            "settings": { "foreground": "#cfc3ff" }
        },
        {
            "name": "Numbers",
            "scope": [
                "constant.numeric",
                "constant.numeric.integer",
                "constant.numeric.float"
            ],
            "settings": { "foreground": "#bd93f9" }
        },
        {
            "name": "Language Constants",
            "scope": [
                "constant.language",
                "constant.language.boolean",
                "constant.language.null",
                "constant.language.undefined"
            ],
            "settings": { "foreground": "#bd93f9" }
        },
        {
            "name": "Decorator / Annotation",
            "scope": ["meta.decorator", "entity.name.function.decorator"],
            "settings": { "foreground": "#ff79c6", "fontStyle": "italic" }
        },
        {
            "name": "Tag Names",
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#ff79c6" }
        },
        {
            "name": "Tag Attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#50fa7b" }
        },
        {
            "name": "CSS Properties",
            "scope": "support.type.property-name",
            "settings": { "foreground": "#8be9fd" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation",
                "punctuation.separator",
                "punctuation.terminator"
            ],
            "settings": { "foreground": "#f8f8f2" }
        },
        {
            "name": "Namespace / Module Names",
            "scope": ["entity.name.namespace", "entity.name.module"],
            "settings": { "foreground": "#8be9fd" }
        },
        {
            "name": "Markdown Headings",
            "scope": ["markup.heading", "entity.name.section.markdown"],
            "settings": { "foreground": "#bd93f9", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Bold",
            "scope": "markup.bold",
            "settings": { "foreground": "#f8f8f2", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Italic",
            "scope": "markup.italic",
            "settings": { "foreground": "#8be9fd", "fontStyle": "italic" }
        },
        {
            "name": "Markdown Code",
            "scope": "markup.inline.raw",
            "settings": { "foreground": "#f1fa8c" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#ff5555" }
        }
    ]
}
