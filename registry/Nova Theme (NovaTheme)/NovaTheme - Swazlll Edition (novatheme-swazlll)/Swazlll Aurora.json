        "list.hoverBackground": "#0c1f18",
        "list.focusBackground": "#0a2e20",
        "list.highlightForeground": "#00ffa3",
        "list.errorForeground": "#ff6b9d",
        "list.warningForeground": "#ffd166",
        "gitDecoration.addedResourceForeground": "#00ffa3",
        "gitDecoration.modifiedResourceForeground": "#ffd166",
        "gitDecoration.deletedResourceForeground": "#ff6b9d",
        "gitDecoration.untrackedResourceForeground": "#7fffd4",
        "gitDecoration.ignoredResourceForeground": "#0a2e20",
        "gitDecoration.conflictingResourceForeground": "#ff79c6",
        "diffEditor.insertedTextBackground": "#00ffa320",
        "diffEditor.removedTextBackground": "#ff6b9d20",
        "diffEditor.insertedLineBackground": "#00ffa312",
        "diffEditor.removedLineBackground": "#ff6b9d12",
        "scrollbarSlider.background": "#00ffa320",
        "scrollbarSlider.hoverBackground": "#00ffa340",
        "scrollbarSlider.activeBackground": "#00ffa360",
        "peekView.border": "#00ffa3",
        "peekViewEditor.background": "#050e0a80",
        "peekViewResult.background": "#050e0a",
        "peekViewTitle.background": "#030a08",
        "peekViewTitleLabel.foreground": "#00ffa3",
        "textLink.foreground": "#00ffa3",
        "textLink.activeForeground": "#20c997",
        "badge.background": "#ff79c6",
        "badge.foreground": "#000000",
        "progressBar.background": "#00ffa3"
    },
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "namespace": "#20c997",
        "class": "#00d4aa",
        "interface": { "foreground": "#7fffd4", "fontStyle": "italic" },
        "type": "#00d4aa",
        "function": "#20c997",
        "method": "#20c997",
        "variable": "#a8e6cf",
        "variable.readonly": "#c8ddd5",
        "parameter": { "foreground": "#c8ddd5", "fontStyle": "italic" },
        "property": "#c8ddd5",
        "decorator": { "foreground": "#ff6b9d", "fontStyle": "italic" },
        "keyword": "#00ffa3",
        "comment": { "foreground": "#2d5a4a", "fontStyle": "italic" },
        "string": "#7fffd4",
        "number": "#ff79c6",
        "operator": "#64dfb4"
    },
    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "comment.line", "comment.block"],
            "settings": { "foreground": "#2d5a4a", "fontStyle": "italic" }
        },
        {
            "name": "String",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#7fffd4" }
        },
        {
            "name": "Escape",
            "scope": "constant.character.escape",
            "settings": { "foreground": "#ff79c6" }
        },
        {
            "name": "Regexp",
            "scope": "string.regexp",
            "settings": { "foreground": "#ffd166" }
        },
        {
            "name": "Keywords",
            "scope": ["keyword", "keyword.control", "storage.type"],
            "settings": { "foreground": "#00ffa3" }
        },
        {
            "name": "Storage Modifiers",
            "scope": "storage.modifier",
            "settings": { "foreground": "#00d4aa", "fontStyle": "italic" }
        },
        {
            "name": "Operators",
            "scope": "keyword.operator",
            "settings": { "foreground": "#64dfb4" }
        },
        {
            "name": "Functions",
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#20c997" }
        },
        {
            "name": "Built-in Functions",
            "scope": ["support.function.builtin", "support.function.magic"],
            "settings": { "foreground": "#ff6b9d" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "variable.other"],
            "settings": { "foreground": "#a8e6cf" }
        },
        {
            "name": "Parameters",
            "scope": "variable.parameter",
            "settings": { "foreground": "#c8ddd5", "fontStyle": "italic" }
        },
        {
            "name": "This/Self",
            "scope": "variable.language",
            "settings": { "foreground": "#ff6b9d", "fontStyle": "italic" }
        },
        {
            "name": "Types",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.class",
                "support.type"
            ],
            "settings": { "foreground": "#00d4aa" }
        },
        {
            "name": "Interface",
            "scope": "entity.name.type.interface",
            "settings": { "foreground": "#7fffd4", "fontStyle": "italic" }
        },
        {
            "name": "Numbers",
            "scope": "constant.numeric",
            "settings": { "foreground": "#ff79c6" }
        },
        {
            "name": "Language Constants",
            "scope": "constant.language",
            "settings": { "foreground": "#ff79c6", "fontStyle": "italic" }
        },
        {
            "name": "Other Constants",
            "scope": ["constant", "constant.other"],
            "settings": { "foreground": "#ffd166" }
        },
        {
            "name": "Decorators",
            "scope": [
                "entity.name.function.decorator",
                "meta.decorator",
                "storage.type.annotation"
            ],
            "settings": { "foreground": "#ff79c6", "fontStyle": "italic" }
        },
        {
            "name": "HTML Tags",
            "scope": "entity.name.tag",
            "settings": { "foreground": "#00ffa3" }
        },
        {
            "name": "HTML Attributes",
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#00d4aa" }
        },
        {
            "name": "CSS Properties",
            "scope": "support.type.property-name.css",
            "settings": { "foreground": "#20c997" }
        },
        {
            "name": "JSON Keys",
            "scope": "support.type.property-name.json",
            "settings": { "foreground": "#00d4aa" }
        },
        {
            "name": "Markdown Heading",
            "scope": "markup.heading",
            "settings": { "foreground": "#00ffa3", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Link",
            "scope": "markup.underline.link",
            "settings": { "foreground": "#00ffa3", "fontStyle": "underline" }
        },
        {
            "name": "Invalid",
            "scope": "invalid",
            "settings": {
                "foreground": "#ff6b9d",
                "fontStyle": "strikethrough"
            }
        }
    ]
}
