        "panelTitle.activeBorder": "#00ffa3",
        "panelTitle.inactiveForeground": "#2d5a4a",
        "breadcrumb.foreground": "#2d5a4a",
        "breadcrumb.background": "#071215",
        "breadcrumb.focusForeground": "#20c997",
        "breadcrumb.activeSelectionForeground": "#00ffa3",
        "breadcrumbPicker.background": "#050e0a",
        "terminal.background": "#060f0c",
        "terminal.foreground": "#c8ddd5",
        "terminal.border": "#0a1e16",
        "terminalCursor.foreground": "#00ffa3",
        "terminal.ansiBlack": "#1a2e28",
        "terminal.ansiRed": "#ff6b9d",
        "terminal.ansiGreen": "#00ffa3",
        "terminal.ansiYellow": "#ffd166",
