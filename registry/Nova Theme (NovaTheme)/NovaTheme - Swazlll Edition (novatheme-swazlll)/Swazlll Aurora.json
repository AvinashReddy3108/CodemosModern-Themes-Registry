        "statusBar.background": "#003d2e",
        "statusBar.foreground": "#c8ddd5",
        "statusBar.border": "#0a2e20",
        "statusBar.debuggingBackground": "#ff79c6",
        "statusBar.debuggingForeground": "#000000",
        "statusBar.noFolderBackground": "#030a08",
        "statusBarItem.remoteBackground": "#00ffa3",
        "statusBarItem.remoteForeground": "#000000",
        "statusBarItem.errorBackground": "#ff6b9d",
        "statusBarItem.errorForeground": "#ffffff",
        "statusBarItem.warningBackground": "#ffd166",
        "statusBarItem.warningForeground": "#000000",
        "statusBarItem.hoverBackground": "#ffffff15",
