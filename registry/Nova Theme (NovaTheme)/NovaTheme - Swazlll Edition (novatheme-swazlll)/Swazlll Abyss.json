    "semanticHighlighting": true,
    "semanticTokenColors": {
        "namespace": "#80e0ff",
        "namespace.declaration": "#a0eeff",
        "class": "#a0eeff",
        "class.declaration": "#a0eeff",
        "interface": { "foreground": "#44ffdd", "fontStyle": "italic" },
        "struct": "#a0eeff",
        "enum": "#a0eeff",
        "enumMember": "#c0e8e8",
        "typeAlias": "#a0eeff",
        "type": "#a0eeff",
        "type.defaultLibrary": "#a0eeff",
        "function": "#00ffcc",
        "function.declaration": "#00ffcc",
        "method": "#00ffcc",
        "method.declaration": "#00ffcc",
        "macro": "#ff9966",
        "variable": "#c0e8e8",
        "variable.readonly": "#e0f8f8",
        "variable.defaultLibrary": "#c0e8e8",
        "parameter": { "foreground": "#e0f8f8", "fontStyle": "italic" },
        "property": "#c0e8e8",
        "property.declaration": "#c0e8e8",
        "property.readonly": { "foreground": "#a0eeff" },
        "event": "#8877ff",
        "decorator": { "foreground": "#8877ff", "fontStyle": "italic" },
        "label": "#ff9966",
        "keyword": "#00ddaa",
        "comment": { "foreground": "#1a4a44", "fontStyle": "italic" },
        "string": "#80e0ff",
        "number": "#ff9966",
        "regexp": "#ffbb88",
        "operator": "#44ffdd",
        "selfKeyword": { "foreground": "#8877ff", "fontStyle": "italic" },
        "magicFunction": { "foreground": "#8877ff", "fontStyle": "italic" },
        "builtinType": "#a0eeff",
        "constParameter": { "foreground": "#e0f8f8", "fontStyle": "italic" }
    },
    "tokenColors": [
        {
            "name": "Comment",
            "scope": [
                "comment",
                "comment.line",
                "comment.block",
                "comment.block.documentation"
            ],
            "settings": { "foreground": "#1a4a44", "fontStyle": "italic" }
        },
        {
            "name": "String",
            "scope": [
                "string",
                "string.quoted",
                "string.quoted.single",
                "string.quoted.double",
                "string.template"
            ],
            "settings": { "foreground": "#80e0ff" }
        },
        {
            "name": "String - Escape Sequences",
            "scope": "constant.character.escape",
            "settings": { "foreground": "#8877ff" }
        },
        {
            "name": "Regular Expressions",
            "scope": "string.regexp",
            "settings": { "foreground": "#ffbb88" }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.control.flow",
                "keyword.control.return",
                "keyword.control.conditional",
                "keyword.control.loop",
                "keyword.control.import",
                "keyword.control.from",
                "keyword.control.export"
            ],
            "settings": { "foreground": "#00ddaa" }
        },
        {
            "name": "Keywords - Operators",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#44ffdd" }
        },
        {
            "name": "Storage Types",
            "scope": [
                "storage.type",
                "storage.type.function",
                "storage.type.class",
                "storage.type.let",
                "storage.type.const",
                "storage.type.var"
            ],
            "settings": { "foreground": "#00ddaa" }
        },
        {
            "name": "Storage Modifiers",
            "scope": [
                "storage.modifier",
                "storage.modifier.async",
                "storage.modifier.static"
            ],
            "settings": { "foreground": "#00ffcc", "fontStyle": "italic" }
        },
        {
            "name": "Function Names",
            "scope": ["entity.name.function", "entity.name.function.member"],
            "settings": { "foreground": "#00ffcc" }
        },
        {
            "name": "Function Calls",
            "scope": ["meta.function-call", "support.function"],
            "settings": { "foreground": "#00ffcc" }
        },
        {
            "name": "Built-in Functions",
            "scope": ["support.function.builtin", "support.function.magic"],
            "settings": { "foreground": "#8877ff" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "variable.other", "variable.other.readwrite"],
            "settings": { "foreground": "#c0e8e8" }
        },
        {
            "name": "Variables - Parameter",
            "scope": "variable.parameter",
            "settings": { "foreground": "#e0f8f8", "fontStyle": "italic" }
        },
        {
            "name": "Variables - Language",
            "scope": ["variable.language", "variable.language.this"],
            "settings": { "foreground": "#8877ff", "fontStyle": "italic" }
        },
        {
            "name": "Types / Classes",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "entity.name.interface",
                "entity.name.enum"
            ],
            "settings": { "foreground": "#a0eeff" }
        },
        {
            "name": "Numbers",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#ff9966" }
        },
        {
            "name": "Language Constants",
            "scope": [
                "constant.language",
                "constant.language.boolean",
                "constant.language.null"
            ],
            "settings": { "foreground": "#44ffdd" }
        },
        {
            "name": "Decorator",
            "scope": ["meta.decorator", "entity.name.function.decorator"],
            "settings": { "foreground": "#8877ff", "fontStyle": "italic" }
        },
        {
            "name": "Tag Names",
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#00ddaa" }
        },
        {
            "name": "Tag Attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#80e0ff" }
        },
        {
            "name": "CSS Properties",
            "scope": "support.type.property-name",
            "settings": { "foreground": "#80e0ff" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation",
                "punctuation.separator",
                "punctuation.terminator"
            ],
            "settings": { "foreground": "#80c0c0" }
        },
        {
            "name": "Namespace / Module Names",
            "scope": ["entity.name.namespace", "entity.name.module"],
            "settings": { "foreground": "#80e0ff" }
        },
        {
            "name": "Markdown Headings",
            "scope": ["markup.heading"],
            "settings": { "foreground": "#00ddaa", "fontStyle": "bold" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#ff5566" }
        }
    ]
}
