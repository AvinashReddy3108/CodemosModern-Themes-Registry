    "semanticHighlighting": true,
    "semanticTokenColors": {
        "namespace": "#86efac",
        "namespace.declaration": "#a7f3d0",
        "class": "#a7f3d0",
        "class.declaration": "#a7f3d0",
        "interface": { "foreground": "#34d399", "fontStyle": "italic" },
        "struct": "#a7f3d0",
        "enum": "#a7f3d0",
        "enumMember": "#c6f6d5",
        "typeAlias": "#a7f3d0",
        "type": "#a7f3d0",
        "type.defaultLibrary": "#a7f3d0",
        "function": "#4ade80",
        "function.declaration": "#4ade80",
        "method": "#4ade80",
        "method.declaration": "#4ade80",
        "macro": "#fbbf24",
        "variable": "#c8e6c9",
        "variable.readonly": "#e8f5e9",
        "variable.defaultLibrary": "#c8e6c9",
        "parameter": { "foreground": "#e8f5e9", "fontStyle": "italic" },
        "property": "#c8e6c9",
        "property.declaration": "#c8e6c9",
        "property.readonly": { "foreground": "#a7f3d0" },
        "event": "#fbbf24",
        "decorator": { "foreground": "#fbbf24", "fontStyle": "italic" },
        "label": "#fbbf24",
        "keyword": "#2ecc71",
        "comment": { "foreground": "#2e6b3c", "fontStyle": "italic" },
        "string": "#86efac",
        "number": "#fbbf24",
        "regexp": "#fcd34d",
        "operator": "#34d399",
        "selfKeyword": { "foreground": "#fbbf24", "fontStyle": "italic" },
        "magicFunction": { "foreground": "#fbbf24", "fontStyle": "italic" },
        "builtinType": "#a7f3d0",
        "constParameter": { "foreground": "#e8f5e9", "fontStyle": "italic" }
    },
    "tokenColors": [
        {
            "name": "Comment",
            "scope": [
                "comment",
                "comment.line",
                "comment.block",
                "comment.block.documentation"
            ],
            "settings": { "foreground": "#2e6b3c", "fontStyle": "italic" }
        },
        {
            "name": "Comment - Doc Tags",
            "scope": [
                "comment.block.documentation keyword",
                "comment.block.documentation punctuation.definition.tag",
                "storage.type.class.jsdoc"
            ],
            "settings": { "foreground": "#1a5c2e", "fontStyle": "italic" }
        },
        {
            "name": "String",
            "scope": [
                "string",
                "string.quoted",
                "string.quoted.single",
                "string.quoted.double",
                "string.template"
            ],
            "settings": { "foreground": "#86efac" }
        },
        {
            "name": "String - Escape Sequences",
            "scope": "constant.character.escape",
            "settings": { "foreground": "#fbbf24" }
        },
        {
            "name": "Template Literal Expression",
            "scope": [
                "punctuation.definition.template-expression",
                "meta.embedded.expression.ts",
                "meta.template.expression"
            ],
            "settings": { "foreground": "#a7f3d0" }
        },
        {
            "name": "Regular Expressions",
            "scope": "string.regexp",
            "settings": { "foreground": "#fcd34d" }
        },
        {
            "name": "Regex Groups",
            "scope": [
                "punctuation.definition.group.regexp",
                "punctuation.definition.character-class.regexp",
                "keyword.operator.quantifier.regexp"
            ],
            "settings": { "foreground": "#fbbf24" }
        },
        {
            "name": "Keywords - Control Flow",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.control.flow",
                "keyword.control.return",
                "keyword.control.conditional",
                "keyword.control.loop",
                "keyword.control.trycatch",
                "keyword.control.import",
                "keyword.control.from",
                "keyword.control.export",
                "keyword.control.default"
            ],
            "settings": { "foreground": "#2ecc71" }
        },
        {
            "name": "Keywords - Operators",
            "scope": [
                "keyword.operator",
                "keyword.operator.assignment",
                "keyword.operator.comparison",
                "keyword.operator.logical",
                "keyword.operator.arithmetic",
                "keyword.operator.type",
                "keyword.operator.new",
                "keyword.operator.delete",
                "keyword.operator.typeof",
                "keyword.operator.void",
                "keyword.operator.instanceof"
            ],
            "settings": { "foreground": "#34d399" }
        },
        {
            "name": "Keywords - Other",
            "scope": [
                "keyword.other",
                "keyword.other.using",
                "keyword.other.await"
            ],
            "settings": { "foreground": "#2ecc71" }
        },
        {
            "name": "Storage Types",
            "scope": [
                "storage.type",
                "storage.type.function",
                "storage.type.class",
                "storage.type.interface",
                "storage.type.type",
                "storage.type.enum",
                "storage.type.namespace",
                "storage.type.let",
                "storage.type.const",
                "storage.type.var"
            ],
            "settings": { "foreground": "#2ecc71" }
        },
        {
            "name": "Storage Modifiers",
            "scope": [
                "storage.modifier",
                "storage.modifier.async",
                "storage.modifier.static",
                "storage.modifier.abstract",
                "storage.modifier.public",
                "storage.modifier.private",
                "storage.modifier.protected",
                "storage.modifier.override",
                "storage.modifier.readonly",
                "storage.modifier.export",
                "storage.modifier.default"
            ],
            "settings": { "foreground": "#4ade80", "fontStyle": "italic" }
        },
        {
            "name": "Function Names",
            "scope": [
                "entity.name.function",
                "entity.name.function.member",
                "meta.definition.method entity.name.function"
            ],
            "settings": { "foreground": "#4ade80" }
        },
        {
            "name": "Function Calls",
            "scope": [
                "meta.function-call",
                "meta.function-call entity.name.function",
                "support.function"
            ],
            "settings": { "foreground": "#4ade80" }
        },
        {
            "name": "Built-in Functions",
            "scope": [
                "support.function.builtin",
                "support.function.console",
                "support.function.magic"
            ],
            "settings": { "foreground": "#fbbf24" }
        },
        {
            "name": "Variables",
            "scope": [
                "variable",
                "variable.other",
                "variable.other.readwrite",
                "variable.other.local",
                "variable.other.object"
            ],
            "settings": { "foreground": "#c8e6c9" }
        },
        {
            "name": "Variables - Constants",
            "scope": [
                "variable.other.constant",
                "variable.other.constant.property"
            ],
            "settings": { "foreground": "#e8f5e9" }
        },
        {
            "name": "Variables - Parameter",
            "scope": "variable.parameter",
            "settings": { "foreground": "#e8f5e9", "fontStyle": "italic" }
        },
        {
            "name": "Variables - Language",
            "scope": [
                "variable.language",
                "variable.language.this",
                "variable.language.self",
                "variable.language.super"
            ],
            "settings": { "foreground": "#fbbf24", "fontStyle": "italic" }
        },
        {
            "name": "Types / Classes",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "entity.name.interface",
                "entity.name.struct",
                "entity.name.enum",
                "entity.name.type.alias"
            ],
            "settings": { "foreground": "#a7f3d0" }
        },
        {
            "name": "Inherited Class",
            "scope": "entity.other.inherited-class",
            "settings": { "foreground": "#86efac", "fontStyle": "italic" }
        },
        {
            "name": "Object Properties",
            "scope": [
                "variable.other.property",
                "variable.other.object.property",
                "support.variable.property",
                "meta.object-literal.key"
            ],
            "settings": { "foreground": "#c8e6c9" }
        },
        {
            "name": "Numbers",
            "scope": [
                "constant.numeric",
                "constant.numeric.integer",
                "constant.numeric.float",
                "constant.numeric.hex"
            ],
            "settings": { "foreground": "#fbbf24" }
        },
        {
            "name": "Language Constants",
            "scope": [
                "constant.language",
                "constant.language.boolean",
                "constant.language.null",
                "constant.language.undefined",
                "constant.language.nan"
            ],
            "settings": { "foreground": "#fcd34d" }
        },
        {
            "name": "Constant Names",
            "scope": ["variable.other.constant", "entity.name.constant"],
            "settings": { "foreground": "#e8f5e9" }
        },
        {
            "name": "Decorator / Annotation",
            "scope": [
                "meta.decorator",
                "entity.name.function.decorator",
                "punctuation.decorator",
                "meta.annotation"
            ],
            "settings": { "foreground": "#fbbf24", "fontStyle": "italic" }
        },
        {
            "name": "Tag Names",
            "scope": ["entity.name.tag", "meta.tag entity.name.tag"],
            "settings": { "foreground": "#2ecc71" }
        },
        {
            "name": "Tag Attributes",
            "scope": [
                "entity.other.attribute-name",
                "meta.tag.attributes entity.other.attribute-name"
            ],
            "settings": { "foreground": "#86efac" }
        },
        {
            "name": "CSS Class / ID",
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css"
            ],
            "settings": { "foreground": "#4ade80" }
        },
        {
            "name": "CSS Properties",
            "scope": "support.type.property-name",
            "settings": { "foreground": "#86efac" }
        },
        {
            "name": "CSS Values",
            "scope": ["support.constant.property-value", "meta.property-value"],
            "settings": { "foreground": "#c8e6c9" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation",
                "punctuation.separator",
                "punctuation.terminator",
                "punctuation.definition.block"
            ],
            "settings": { "foreground": "#81c784" }
        },
        {
            "name": "Import / Export Paths",
            "scope": ["meta.import string", "meta.export string"],
            "settings": { "foreground": "#a7f3d0" }
        },
        {
            "name": "Namespace / Module Names",
            "scope": ["entity.name.namespace", "entity.name.module"],
            "settings": { "foreground": "#86efac" }
        },
        {
            "name": "Markdown Headings",
            "scope": ["markup.heading", "entity.name.section.markdown"],
            "settings": { "foreground": "#2ecc71", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Bold",
