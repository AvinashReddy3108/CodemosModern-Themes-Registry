        "list.activeSelectionForeground": "#f0d5c8",
        "list.activeSelectionIconForeground": "#ff6b35",
        "list.inactiveSelectionBackground": "#200e08",
        "list.hoverBackground": "#1f1008",
        "list.focusBackground": "#2a1008",
        "list.highlightForeground": "#ff6b35",
        "list.errorForeground": "#ff4d6d",
        "list.warningForeground": "#ffd166",
        "gitDecoration.addedResourceForeground": "#06d6a0",
        "gitDecoration.modifiedResourceForeground": "#ffd166",
        "gitDecoration.deletedResourceForeground": "#ff4d6d",
        "gitDecoration.untrackedResourceForeground": "#ff8c42",
        "gitDecoration.ignoredResourceForeground": "#3a1a10",
        "gitDecoration.conflictingResourceForeground": "#ef476f",
        "diffEditor.insertedTextBackground": "#06d6a020",
        "diffEditor.removedTextBackground": "#ff4d6d20",
        "diffEditor.insertedLineBackground": "#06d6a012",
        "diffEditor.removedLineBackground": "#ff4d6d12",
        "scrollbarSlider.background": "#ff6b3520",
        "scrollbarSlider.hoverBackground": "#ff6b3540",
        "scrollbarSlider.activeBackground": "#ff6b3560",
        "peekView.border": "#ff6b35",
        "peekViewEditor.background": "#150a0680",
        "peekViewResult.background": "#150a06",
        "peekViewTitle.background": "#100806",
        "peekViewTitleLabel.foreground": "#ff6b35",
        "textLink.foreground": "#ff8c42",
        "textLink.activeForeground": "#ff6b35",
        "badge.background": "#ef476f",
        "badge.foreground": "#ffffff",
        "progressBar.background": "#ff6b35"
    },
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "namespace": "#ff8c42",
        "class": "#ff8c42",
        "interface": { "foreground": "#06d6a0", "fontStyle": "italic" },
        "type": "#ff8c42",
        "function": "#ef476f",
        "method": "#ef476f",
        "variable": "#f9c5b0",
        "variable.readonly": "#f0d5c8",
        "parameter": { "foreground": "#f0d5c8", "fontStyle": "italic" },
        "property": "#f0d5c8",
        "decorator": { "foreground": "#ff4d6d", "fontStyle": "italic" },
        "keyword": "#ff6b35",
        "comment": { "foreground": "#5a3020", "fontStyle": "italic" },
        "string": "#ffd166",
        "number": "#06d6a0",
        "operator": "#ffaa80"
    },
    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "comment.line", "comment.block"],
            "settings": { "foreground": "#5a3020", "fontStyle": "italic" }
        },
        {
            "name": "String",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#ffd166" }
        },
        {
            "name": "Escape",
            "scope": "constant.character.escape",
            "settings": { "foreground": "#ef476f" }
        },
        {
            "name": "Regexp",
            "scope": "string.regexp",
            "settings": { "foreground": "#ff8c42" }
        },
        {
            "name": "Keywords",
            "scope": ["keyword", "keyword.control", "storage.type"],
            "settings": { "foreground": "#ff6b35" }
        },
        {
            "name": "Storage Modifiers",
            "scope": "storage.modifier",
            "settings": { "foreground": "#ff8c42", "fontStyle": "italic" }
        },
        {
            "name": "Operators",
            "scope": "keyword.operator",
            "settings": { "foreground": "#ffaa80" }
        },
        {
            "name": "Functions",
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#ef476f" }
        },
        {
            "name": "Built-in Functions",
            "scope": ["support.function.builtin", "support.function.magic"],
            "settings": { "foreground": "#ff4d6d" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "variable.other"],
            "settings": { "foreground": "#f9c5b0" }
        },
        {
            "name": "Parameters",
            "scope": "variable.parameter",
            "settings": { "foreground": "#f0d5c8", "fontStyle": "italic" }
        },
        {
            "name": "This/Self",
            "scope": "variable.language",
            "settings": { "foreground": "#ff4d6d", "fontStyle": "italic" }
        },
        {
            "name": "Types",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.class",
                "support.type"
            ],
            "settings": { "foreground": "#ff8c42" }
        },
        {
            "name": "Interface",
            "scope": "entity.name.type.interface",
            "settings": { "foreground": "#06d6a0", "fontStyle": "italic" }
        },
        {
            "name": "Numbers",
            "scope": "constant.numeric",
            "settings": { "foreground": "#06d6a0" }
        },
        {
            "name": "Language Constants",
            "scope": "constant.language",
            "settings": { "foreground": "#06d6a0", "fontStyle": "italic" }
        },
        {
            "name": "Other Constants",
            "scope": ["constant", "constant.other"],
            "settings": { "foreground": "#ffb347" }
        },
        {
            "name": "Decorators",
            "scope": [
                "entity.name.function.decorator",
                "meta.decorator",
                "storage.type.annotation"
            ],
            "settings": { "foreground": "#ff4d6d", "fontStyle": "italic" }
        },
        {
            "name": "HTML Tags",
            "scope": "entity.name.tag",
            "settings": { "foreground": "#ff6b35" }
        },
        {
            "name": "HTML Attributes",
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#ff8c42" }
        },
        {
            "name": "CSS Properties",
            "scope": "support.type.property-name.css",
            "settings": { "foreground": "#ef476f" }
        },
        {
            "name": "JSON Keys",
            "scope": "support.type.property-name.json",
            "settings": { "foreground": "#ff8c42" }
        },
        {
            "name": "Markdown Heading",
            "scope": "markup.heading",
            "settings": { "foreground": "#ff6b35", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Link",
            "scope": "markup.underline.link",
            "settings": { "foreground": "#ff8c42", "fontStyle": "underline" }
        },
        {
            "name": "Invalid",
            "scope": "invalid",
            "settings": {
                "foreground": "#ff4d6d",
                "fontStyle": "strikethrough"
            }
        }
    ]
}
