    "semanticHighlighting": true,
    "semanticTokenColors": {
        "namespace": "#f8bbd9",
        "namespace.declaration": "#ffcce0",
        "class": "#ffcce0",
        "class.declaration": "#ffcce0",
        "interface": { "foreground": "#ce93d8", "fontStyle": "italic" },
        "struct": "#ffcce0",
        "enum": "#ffcce0",
        "enumMember": "#fce4ec",
        "typeAlias": "#ffcce0",
        "type": "#ffcce0",
        "type.defaultLibrary": "#ffcce0",
        "function": "#f48fb1",
        "function.declaration": "#f48fb1",
        "method": "#f48fb1",
        "method.declaration": "#f48fb1",
        "macro": "#ffcc80",
        "variable": "#fce4ec",
        "variable.readonly": "#ffffff",
        "variable.defaultLibrary": "#fce4ec",
        "parameter": { "foreground": "#ffffff", "fontStyle": "italic" },
        "property": "#fce4ec",
        "property.declaration": "#fce4ec",
        "property.readonly": { "foreground": "#ffcce0" },
        "event": "#ce93d8",
        "decorator": { "foreground": "#ce93d8", "fontStyle": "italic" },
        "label": "#ffcc80",
        "keyword": "#f06292",
        "comment": { "foreground": "#6d2a3a", "fontStyle": "italic" },
        "string": "#f8bbd9",
        "number": "#ffcc80",
        "regexp": "#ffe0b2",
        "operator": "#f48fb1",
        "selfKeyword": { "foreground": "#ce93d8", "fontStyle": "italic" },
        "magicFunction": { "foreground": "#ce93d8", "fontStyle": "italic" },
        "builtinType": "#ffcce0",
        "constParameter": { "foreground": "#ffffff", "fontStyle": "italic" }
    },
    "tokenColors": [
        {
            "name": "Comment",
            "scope": [
                "comment",
                "comment.line",
                "comment.block",
                "comment.block.documentation"
            ],
            "settings": { "foreground": "#6d2a3a", "fontStyle": "italic" }
        },
        {
            "name": "String",
            "scope": [
                "string",
                "string.quoted",
                "string.quoted.single",
                "string.quoted.double",
                "string.template"
            ],
            "settings": { "foreground": "#f8bbd9" }
        },
        {
            "name": "String - Escape Sequences",
            "scope": "constant.character.escape",
            "settings": { "foreground": "#ce93d8" }
        },
        {
            "name": "Regular Expressions",
            "scope": "string.regexp",
            "settings": { "foreground": "#ffe0b2" }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.control.flow",
                "keyword.control.return",
                "keyword.control.conditional",
                "keyword.control.loop",
                "keyword.control.import",
                "keyword.control.from",
                "keyword.control.export"
            ],
            "settings": { "foreground": "#f06292" }
        },
        {
            "name": "Keywords - Operators",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#f48fb1" }
        },
        {
            "name": "Storage Types",
            "scope": [
                "storage.type",
                "storage.type.function",
                "storage.type.class",
                "storage.type.let",
                "storage.type.const",
                "storage.type.var"
            ],
            "settings": { "foreground": "#f06292" }
        },
        {
            "name": "Storage Modifiers",
            "scope": [
                "storage.modifier",
                "storage.modifier.async",
                "storage.modifier.static"
            ],
            "settings": { "foreground": "#ce93d8", "fontStyle": "italic" }
        },
        {
            "name": "Function Names",
            "scope": ["entity.name.function", "entity.name.function.member"],
            "settings": { "foreground": "#f48fb1" }
        },
        {
            "name": "Function Calls",
            "scope": ["meta.function-call", "support.function"],
            "settings": { "foreground": "#f48fb1" }
        },
        {
            "name": "Built-in Functions",
            "scope": ["support.function.builtin", "support.function.magic"],
            "settings": { "foreground": "#ce93d8" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "variable.other", "variable.other.readwrite"],
            "settings": { "foreground": "#fce4ec" }
        },
        {
            "name": "Variables - Parameter",
            "scope": "variable.parameter",
            "settings": { "foreground": "#ffffff", "fontStyle": "italic" }
        },
        {
            "name": "Variables - Language",
            "scope": ["variable.language", "variable.language.this"],
            "settings": { "foreground": "#ce93d8", "fontStyle": "italic" }
        },
        {
            "name": "Types / Classes",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "entity.name.interface",
                "entity.name.enum"
            ],
            "settings": { "foreground": "#ffcce0" }
        },
        {
            "name": "Numbers",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#ffcc80" }
        },
        {
            "name": "Language Constants",
            "scope": [
                "constant.language",
                "constant.language.boolean",
                "constant.language.null"
            ],
            "settings": { "foreground": "#ce93d8" }
        },
        {
            "name": "Decorator",
            "scope": ["meta.decorator", "entity.name.function.decorator"],
            "settings": { "foreground": "#ce93d8", "fontStyle": "italic" }
        },
        {
            "name": "Tag Names",
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#f06292" }
        },
        {
            "name": "Tag Attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#f48fb1" }
        },
        {
            "name": "CSS Properties",
            "scope": "support.type.property-name",
            "settings": { "foreground": "#f8bbd9" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation",
                "punctuation.separator",
                "punctuation.terminator"
            ],
            "settings": { "foreground": "#f8bbd9" }
        },
        {
            "name": "Markdown Headings",
            "scope": ["markup.heading"],
            "settings": { "foreground": "#f06292", "fontStyle": "bold" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#ff4444" }
        }
    ]
}
