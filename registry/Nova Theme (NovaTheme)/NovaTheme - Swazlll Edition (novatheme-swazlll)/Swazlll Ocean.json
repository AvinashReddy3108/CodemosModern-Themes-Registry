    "semanticHighlighting": true,
    "semanticTokenColors": {
        "namespace": "#48cae4",
        "namespace.declaration": "#4cc9f0",
        "class": "#4cc9f0",
        "class.declaration": "#4cc9f0",
        "interface": { "foreground": "#00e5c0", "fontStyle": "italic" },
        "struct": "#4cc9f0",
        "enum": "#4cc9f0",
        "enumMember": "#ade8f4",
        "typeAlias": "#4cc9f0",
        "type": "#4cc9f0",
        "type.defaultLibrary": "#4cc9f0",
        "function": "#48cae4",
        "function.declaration": "#48cae4",
        "method": "#48cae4",
        "method.declaration": "#48cae4",
        "macro": "#ff9f43",
        "variable": "#ade8f4",
        "variable.readonly": "#cdd9e5",
        "variable.defaultLibrary": "#ade8f4",
        "parameter": { "foreground": "#cdd9e5", "fontStyle": "italic" },
        "property": "#cdd9e5",
        "property.declaration": "#cdd9e5",
        "property.readonly": { "foreground": "#ade8f4" },
        "event": "#f72585",
        "decorator": { "foreground": "#f72585", "fontStyle": "italic" },
        "label": "#ff9f43",
        "keyword": "#00b4d8",
        "comment": { "foreground": "#3d6e9e", "fontStyle": "italic" },
        "string": "#74c7e8",
        "number": "#f06fff",
        "regexp": "#ff9f43",
        "operator": "#7ec8e3",
        "selfKeyword": { "foreground": "#f72585", "fontStyle": "italic" },
        "magicFunction": { "foreground": "#f72585", "fontStyle": "italic" },
        "builtinType": "#4cc9f0",
        "constParameter": { "foreground": "#cdd9e5", "fontStyle": "italic" }
    },
    "tokenColors": [
        {
            "name": "Comment",
            "scope": [
                "comment",
                "comment.line",
                "comment.block",
                "comment.block.documentation"
            ],
            "settings": { "foreground": "#3d6e9e", "fontStyle": "italic" }
        },
        {
            "name": "Comment - Doc Tags",
            "scope": [
                "comment.block.documentation keyword",
                "comment.block.documentation punctuation.definition.tag",
                "storage.type.class.jsdoc"
            ],
            "settings": { "foreground": "#1e7fa8", "fontStyle": "italic" }
        },
        {
            "name": "String",
            "scope": [
                "string",
                "string.quoted",
                "string.quoted.single",
                "string.quoted.double",
                "string.quoted.other",
                "string.template"
            ],
            "settings": { "foreground": "#74c7e8" }
        },
        {
            "name": "String - Escape Sequences",
            "scope": "constant.character.escape",
            "settings": { "foreground": "#f72585" }
        },
        {
            "name": "Template Literal Expression",
            "scope": [
                "punctuation.definition.template-expression",
                "meta.embedded.expression.ts",
                "meta.template.expression"
            ],
            "settings": { "foreground": "#4cc9f0" }
        },
        {
            "name": "Regular Expressions",
            "scope": "string.regexp",
            "settings": { "foreground": "#ff9f43" }
        },
        {
            "name": "Regex Groups",
            "scope": [
                "punctuation.definition.group.regexp",
                "punctuation.definition.character-class.regexp",
                "keyword.operator.quantifier.regexp"
            ],
            "settings": { "foreground": "#f72585" }
        },
        {
            "name": "Keywords - Control Flow",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.control.flow",
                "keyword.control.return",
                "keyword.control.conditional",
                "keyword.control.loop",
                "keyword.control.trycatch",
                "keyword.control.import",
                "keyword.control.from",
                "keyword.control.export",
                "keyword.control.default"
            ],
            "settings": { "foreground": "#00b4d8" }
        },
        {
            "name": "Keywords - Operators",
            "scope": [
                "keyword.operator",
                "keyword.operator.assignment",
                "keyword.operator.comparison",
                "keyword.operator.logical",
                "keyword.operator.arithmetic",
                "keyword.operator.type",
                "keyword.operator.new",
                "keyword.operator.delete",
                "keyword.operator.typeof",
                "keyword.operator.void",
                "keyword.operator.instanceof"
            ],
            "settings": { "foreground": "#7ec8e3" }
        },
        {
            "name": "Keywords - Other",
            "scope": [
                "keyword.other",
                "keyword.other.using",
                "keyword.other.await"
            ],
            "settings": { "foreground": "#00b4d8" }
        },
        {
            "name": "Storage Types",
            "scope": [
                "storage.type",
                "storage.type.function",
                "storage.type.class",
                "storage.type.interface",
                "storage.type.type",
                "storage.type.enum",
                "storage.type.namespace",
                "storage.type.let",
                "storage.type.const",
                "storage.type.var"
            ],
            "settings": { "foreground": "#00b4d8" }
        },
        {
            "name": "Storage Modifiers",
            "scope": [
                "storage.modifier",
                "storage.modifier.async",
                "storage.modifier.static",
                "storage.modifier.abstract",
                "storage.modifier.public",
                "storage.modifier.private",
                "storage.modifier.protected",
                "storage.modifier.override",
                "storage.modifier.readonly",
                "storage.modifier.export",
                "storage.modifier.default"
            ],
            "settings": { "foreground": "#4cc9f0", "fontStyle": "italic" }
        },
        {
            "name": "Function Names",
            "scope": [
                "entity.name.function",
                "entity.name.function.member",
                "meta.definition.method entity.name.function"
            ],
            "settings": { "foreground": "#48cae4" }
        },
        {
            "name": "Function Calls",
            "scope": [
                "meta.function-call",
                "meta.function-call entity.name.function",
                "support.function"
            ],
            "settings": { "foreground": "#48cae4" }
        },
        {
            "name": "Built-in Functions / Support",
            "scope": [
                "support.function.builtin",
                "support.function.console",
                "support.function.magic"
            ],
            "settings": { "foreground": "#f72585" }
        },
        {
            "name": "Variables",
            "scope": [
                "variable",
                "variable.other",
                "variable.other.readwrite",
                "variable.other.local",
                "variable.other.object"
            ],
            "settings": { "foreground": "#ade8f4" }
        },
        {
            "name": "Variables - Constants",
            "scope": [
                "variable.other.constant",
                "variable.other.constant.property"
            ],
            "settings": { "foreground": "#cdd9e5" }
        },
        {
            "name": "Variables - Parameter",
            "scope": "variable.parameter",
            "settings": { "foreground": "#cdd9e5", "fontStyle": "italic" }
        },
        {
            "name": "Variables - Language (this, self, super)",
            "scope": [
                "variable.language",
                "variable.language.this",
                "variable.language.self",
                "variable.language.super"
            ],
            "settings": { "foreground": "#f72585", "fontStyle": "italic" }
        },
        {
            "name": "Property Access",
            "scope": [
                "variable.other.property",
                "variable.other.object.property",
                "support.variable.property"
            ],
            "settings": { "foreground": "#cdd9e5" }
        },
        {
            "name": "Type Names",
            "scope": [
                "entity.name.type",
                "entity.name.type.class",
                "entity.name.type.interface",
                "entity.name.type.enum",
                "entity.name.type.module",
                "entity.name.type.namespace",
                "entity.name.type.alias",
                "support.class",
                "support.type"
            ],
            "settings": { "foreground": "#4cc9f0" }
        },
        {
            "name": "Class Names",
            "scope": ["entity.name.class", "entity.name.class.component"],
            "settings": { "foreground": "#4cc9f0" }
        },
        {
            "name": "Interface / Abstract (italic)",
            "scope": "entity.name.type.interface",
            "settings": { "foreground": "#00e5c0", "fontStyle": "italic" }
        },
        {
            "name": "Built-in Types",
            "scope": [
                "support.type.primitive",
                "support.type.builtin",
                "keyword.type",
                "storage.type.primitive"
            ],
            "settings": { "foreground": "#4cc9f0" }
        },
        {
            "name": "Inherited Class",
            "scope": "entity.other.inherited-class",
            "settings": { "foreground": "#48cae4", "fontStyle": "italic" }
        },
        {
            "name": "Numbers",
            "scope": [
                "constant.numeric",
                "constant.numeric.integer",
                "constant.numeric.float",
                "constant.numeric.hex",
                "constant.numeric.octal",
                "constant.numeric.binary"
            ],
            "settings": { "foreground": "#f06fff" }
        },
        {
            "name": "Language Constants (true/false/null/undefined)",
            "scope": [
                "constant.language",
                "constant.language.boolean",
                "constant.language.null",
                "constant.language.undefined",
                "constant.language.none"
            ],
            "settings": { "foreground": "#f06fff", "fontStyle": "italic" }
        },
        {
            "name": "Other Constants",
            "scope": [
                "constant",
                "constant.other",
                "constant.other.symbol",
                "constant.other.enum",
                "constant.other.key"
            ],
            "settings": { "foreground": "#ff9f43" }
        },
        {
            "name": "Decorators / Annotations",
            "scope": [
                "entity.name.function.decorator",
                "meta.decorator",
                "meta.decorator entity.name.function",
                "punctuation.decorator",
                "storage.type.annotation",
                "meta.annotation",
                "support.type.decorator"
            ],
            "settings": { "foreground": "#f72585", "fontStyle": "italic" }
        },
        {
            "name": "Module / Namespace Names",
            "scope": [
                "entity.name.module",
                "entity.name.namespace",
                "support.module",
                "variable.other.module"
            ],
            "settings": { "foreground": "#48cae4" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation",
                "punctuation.separator",
