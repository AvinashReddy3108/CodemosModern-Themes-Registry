        "gitDecoration.modifiedResourceForeground": "#ffa657",
        "gitDecoration.deletedResourceForeground": "#ff7b72",
        "gitDecoration.untrackedResourceForeground": "#79c0ff",
        "gitDecoration.ignoredResourceForeground": "#30363d",
        "gitDecoration.conflictingResourceForeground": "#d2a8ff",
        "diffEditor.insertedTextBackground": "#7ee78720",
        "diffEditor.removedTextBackground": "#ff7b7220",
        "diffEditor.insertedLineBackground": "#7ee78712",
        "diffEditor.removedLineBackground": "#ff7b7212",
        "scrollbarSlider.background": "#58a6ff20",
        "scrollbarSlider.hoverBackground": "#58a6ff40",
        "scrollbarSlider.activeBackground": "#58a6ff60",
        "peekView.border": "#58a6ff",
        "peekViewEditor.background": "#090d1380",
        "peekViewResult.background": "#090d13",
        "peekViewTitle.background": "#080c12",
        "peekViewTitleLabel.foreground": "#58a6ff",
        "textLink.foreground": "#58a6ff",
        "textLink.activeForeground": "#79c0ff",
        "badge.background": "#d2a8ff",
        "badge.foreground": "#000000",
        "progressBar.background": "#58a6ff"
    },
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "namespace": "#79c0ff",
        "class": "#79c0ff",
        "interface": { "foreground": "#7ee787", "fontStyle": "italic" },
        "type": "#79c0ff",
        "function": "#d2a8ff",
        "method": "#d2a8ff",
        "variable": "#ffa657",
        "variable.readonly": "#c9d1d9",
        "parameter": { "foreground": "#c9d1d9", "fontStyle": "italic" },
        "property": "#c9d1d9",
        "decorator": { "foreground": "#d2a8ff", "fontStyle": "italic" },
        "keyword": "#ff7b72",
        "comment": { "foreground": "#484f58", "fontStyle": "italic" },
        "string": "#a5d6ff",
        "number": "#79c0ff",
        "operator": "#ff7b72"
    },
    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "comment.line", "comment.block"],
            "settings": { "foreground": "#484f58", "fontStyle": "italic" }
        },
        {
            "name": "String",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#a5d6ff" }
        },
        {
            "name": "Escape",
            "scope": "constant.character.escape",
            "settings": { "foreground": "#d2a8ff" }
        },
        {
            "name": "Regexp",
            "scope": "string.regexp",
            "settings": { "foreground": "#ffa657" }
        },
        {
            "name": "Keywords",
            "scope": ["keyword", "keyword.control", "storage.type"],
            "settings": { "foreground": "#ff7b72" }
        },
        {
            "name": "Storage Modifiers",
            "scope": "storage.modifier",
            "settings": { "foreground": "#79c0ff", "fontStyle": "italic" }
        },
        {
            "name": "Operators",
            "scope": "keyword.operator",
            "settings": { "foreground": "#ff7b72" }
        },
        {
            "name": "Functions",
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#d2a8ff" }
        },
        {
            "name": "Built-in Functions",
            "scope": ["support.function.builtin", "support.function.magic"],
            "settings": { "foreground": "#ff7b72" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "variable.other"],
            "settings": { "foreground": "#ffa657" }
        },
        {
            "name": "Parameters",
            "scope": "variable.parameter",
            "settings": { "foreground": "#c9d1d9", "fontStyle": "italic" }
        },
        {
            "name": "This/Self",
            "scope": "variable.language",
            "settings": { "foreground": "#ff7b72", "fontStyle": "italic" }
        },
        {
            "name": "Types",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.class",
                "support.type"
            ],
            "settings": { "foreground": "#79c0ff" }
        },
        {
            "name": "Interface",
            "scope": "entity.name.type.interface",
            "settings": { "foreground": "#7ee787", "fontStyle": "italic" }
        },
        {
            "name": "Numbers",
            "scope": "constant.numeric",
            "settings": { "foreground": "#79c0ff" }
        },
        {
            "name": "Language Constants",
            "scope": "constant.language",
            "settings": { "foreground": "#79c0ff", "fontStyle": "italic" }
        },
        {
            "name": "Other Constants",
            "scope": ["constant", "constant.other"],
            "settings": { "foreground": "#ffa657" }
        },
        {
            "name": "Decorators",
            "scope": [
                "entity.name.function.decorator",
                "meta.decorator",
                "storage.type.annotation"
            ],
            "settings": { "foreground": "#d2a8ff", "fontStyle": "italic" }
        },
        {
            "name": "HTML Tags",
            "scope": "entity.name.tag",
            "settings": { "foreground": "#7ee787" }
        },
        {
            "name": "HTML Attributes",
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#79c0ff" }
        },
        {
            "name": "CSS Properties",
            "scope": "support.type.property-name.css",
            "settings": { "foreground": "#79c0ff" }
        },
        {
            "name": "JSON Keys",
            "scope": "support.type.property-name.json",
            "settings": { "foreground": "#79c0ff" }
        },
        {
            "name": "Markdown Heading",
            "scope": "markup.heading",
            "settings": { "foreground": "#58a6ff", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Link",
            "scope": "markup.underline.link",
            "settings": { "foreground": "#58a6ff", "fontStyle": "underline" }
        },
        {
            "name": "Invalid",
            "scope": "invalid",
            "settings": {
                "foreground": "#ff7b72",
                "fontStyle": "strikethrough"
            }
        }
    ]
}
