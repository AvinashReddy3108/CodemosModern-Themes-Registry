        "statusBar.border": "#131920",
        "statusBar.debuggingBackground": "#ff7b72",
        "statusBar.debuggingForeground": "#ffffff",
        "statusBar.noFolderBackground": "#080c12",
        "statusBarItem.remoteBackground": "#58a6ff",
        "statusBarItem.remoteForeground": "#ffffff",
        "statusBarItem.errorBackground": "#ff7b72",
        "statusBarItem.errorForeground": "#ffffff",
        "statusBarItem.warningBackground": "#ffa657",
        "statusBarItem.warningForeground": "#000000",
        "statusBarItem.hoverBackground": "#ffffff15",
        "panel.background": "#0d1117",
        "panel.border": "#1c2128",
        "panelTitle.activeForeground": "#58a6ff",
        "panelTitle.activeBorder": "#58a6ff",
        "panelTitle.inactiveForeground": "#484f58",
        "breadcrumb.foreground": "#484f58",
        "breadcrumb.background": "#0d1117",
        "breadcrumb.focusForeground": "#79c0ff",
        "breadcrumb.activeSelectionForeground": "#58a6ff",
        "breadcrumbPicker.background": "#090d13",
        "terminal.background": "#0d1117",
        "terminal.foreground": "#c9d1d9",
        "terminal.border": "#1c2128",
        "terminalCursor.foreground": "#58a6ff",
        "terminal.ansiBlack": "#1c2128",
        "terminal.ansiRed": "#ff7b72",
        "terminal.ansiGreen": "#7ee787",
        "terminal.ansiYellow": "#ffa657",
