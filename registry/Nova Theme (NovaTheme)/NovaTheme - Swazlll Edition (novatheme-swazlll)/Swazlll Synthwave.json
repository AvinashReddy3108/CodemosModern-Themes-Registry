    "semanticHighlighting": true,
    "semanticTokenColors": {
        "namespace": "#00ffff",
        "namespace.declaration": "#aa88ff",
        "class": "#aa88ff",
        "class.declaration": "#aa88ff",
        "interface": { "foreground": "#00ffcc", "fontStyle": "italic" },
        "struct": "#aa88ff",
        "enum": "#aa88ff",
        "enumMember": "#e2d9f3",
        "typeAlias": "#aa88ff",
        "type": "#aa88ff",
        "type.defaultLibrary": "#aa88ff",
        "function": "#00ffff",
        "function.declaration": "#00ffff",
        "method": "#00ffff",
        "method.declaration": "#00ffff",
        "macro": "#ffff00",
        "variable": "#e2d9f3",
        "variable.readonly": "#ffffff",
        "variable.defaultLibrary": "#e2d9f3",
        "parameter": { "foreground": "#ffaa44", "fontStyle": "italic" },
        "property": "#e2d9f3",
        "property.declaration": "#e2d9f3",
        "property.readonly": { "foreground": "#e2d9f3" },
        "event": "#ff00ff",
        "decorator": { "foreground": "#ff00ff", "fontStyle": "italic" },
        "label": "#ffff00",
        "keyword": "#ff00ff",
        "comment": { "foreground": "#5a3a7e", "fontStyle": "italic" },
        "string": "#ff80ff",
        "number": "#cc00ff",
        "regexp": "#ffff00",
        "operator": "#00ffff",
        "selfKeyword": { "foreground": "#ff00ff", "fontStyle": "italic" },
        "magicFunction": { "foreground": "#ff00ff", "fontStyle": "italic" },
        "builtinType": "#aa88ff",
        "constParameter": { "foreground": "#ffaa44", "fontStyle": "italic" }
    },
    "tokenColors": [
        {
            "name": "Comment",
            "scope": [
                "comment",
                "comment.line",
                "comment.block",
                "comment.block.documentation"
            ],
            "settings": { "foreground": "#5a3a7e", "fontStyle": "italic" }
        },
        {
            "name": "String",
            "scope": [
                "string",
                "string.quoted",
                "string.quoted.single",
                "string.quoted.double",
                "string.template"
            ],
            "settings": { "foreground": "#ff80ff" }
        },
        {
            "name": "String - Escape Sequences",
            "scope": "constant.character.escape",
            "settings": { "foreground": "#00ffff" }
        },
        {
            "name": "Regular Expressions",
            "scope": "string.regexp",
            "settings": { "foreground": "#ffff00" }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.control.flow",
                "keyword.control.return",
                "keyword.control.conditional",
                "keyword.control.loop",
                "keyword.control.trycatch",
                "keyword.control.import",
                "keyword.control.from",
                "keyword.control.export"
            ],
            "settings": { "foreground": "#ff00ff" }
        },
        {
            "name": "Keywords - Operators",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#00ffff" }
        },
        {
            "name": "Storage Types",
            "scope": [
                "storage.type",
                "storage.type.function",
                "storage.type.class",
                "storage.type.let",
                "storage.type.const",
                "storage.type.var"
            ],
            "settings": { "foreground": "#ff00ff" }
        },
        {
            "name": "Storage Modifiers",
            "scope": [
                "storage.modifier",
                "storage.modifier.async",
                "storage.modifier.static"
            ],
            "settings": { "foreground": "#cc00ff", "fontStyle": "italic" }
        },
        {
            "name": "Function Names",
            "scope": ["entity.name.function", "entity.name.function.member"],
            "settings": { "foreground": "#00ffff" }
        },
        {
            "name": "Function Calls",
            "scope": ["meta.function-call", "support.function"],
            "settings": { "foreground": "#00ffff" }
        },
        {
            "name": "Built-in Functions",
            "scope": ["support.function.builtin", "support.function.magic"],
            "settings": { "foreground": "#ff00ff" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "variable.other", "variable.other.readwrite"],
            "settings": { "foreground": "#e2d9f3" }
        },
        {
            "name": "Variables - Parameter",
            "scope": "variable.parameter",
            "settings": { "foreground": "#ffaa44", "fontStyle": "italic" }
        },
        {
            "name": "Variables - Language",
            "scope": ["variable.language", "variable.language.this"],
            "settings": { "foreground": "#ff00ff", "fontStyle": "italic" }
        },
        {
            "name": "Types / Classes",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "entity.name.interface",
                "entity.name.enum"
            ],
            "settings": { "foreground": "#aa88ff" }
        },
        {
            "name": "Numbers",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#cc00ff" }
        },
        {
            "name": "Language Constants",
            "scope": [
                "constant.language",
                "constant.language.boolean",
                "constant.language.null"
            ],
            "settings": { "foreground": "#cc00ff" }
        },
        {
            "name": "Decorator / Annotation",
            "scope": ["meta.decorator", "entity.name.function.decorator"],
            "settings": { "foreground": "#ff00ff", "fontStyle": "italic" }
        },
        {
            "name": "Tag Names",
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#ff00ff" }
        },
        {
            "name": "Tag Attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#cc00ff" }
        },
        {
            "name": "CSS Properties",
            "scope": "support.type.property-name",
            "settings": { "foreground": "#00ffff" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation",
                "punctuation.separator",
                "punctuation.terminator"
            ],
            "settings": { "foreground": "#c990ff" }
        },
        {
            "name": "Markdown Headings",
            "scope": ["markup.heading"],
            "settings": { "foreground": "#ff00ff", "fontStyle": "bold" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#ff4444" }
        }
    ]
}
