    "semanticHighlighting": true,
    "semanticTokenColors": {
        "namespace": "#88ffcc",
        "namespace.declaration": "#aaffcc",
        "class": "#aaffcc",
        "class.declaration": "#aaffcc",
        "interface": { "foreground": "#39ff14", "fontStyle": "italic" },
        "struct": "#aaffcc",
        "enum": "#aaffcc",
        "enumMember": "#ccffcc",
        "typeAlias": "#aaffcc",
        "type": "#aaffcc",
        "type.defaultLibrary": "#aaffcc",
        "function": "#39ff14",
        "function.declaration": "#39ff14",
        "method": "#39ff14",
        "method.declaration": "#39ff14",
        "macro": "#aaff00",
        "variable": "#ccffcc",
        "variable.readonly": "#eeffee",
        "variable.defaultLibrary": "#ccffcc",
        "parameter": { "foreground": "#eeffee", "fontStyle": "italic" },
        "property": "#ccffcc",
        "property.declaration": "#ccffcc",
        "property.readonly": { "foreground": "#aaffcc" },
        "event": "#aaff00",
        "decorator": { "foreground": "#aaff00", "fontStyle": "italic" },
        "label": "#aaff00",
        "keyword": "#00ff41",
        "comment": { "foreground": "#1a4d1a", "fontStyle": "italic" },
        "string": "#88ffcc",
        "number": "#aaff00",
        "regexp": "#ccff00",
        "operator": "#39ff14",
        "selfKeyword": { "foreground": "#aaff00", "fontStyle": "italic" },
        "magicFunction": { "foreground": "#aaff00", "fontStyle": "italic" },
        "builtinType": "#aaffcc",
        "constParameter": { "foreground": "#eeffee", "fontStyle": "italic" }
    },
    "tokenColors": [
        {
            "name": "Comment",
            "scope": [
                "comment",
                "comment.line",
                "comment.block",
                "comment.block.documentation"
            ],
            "settings": { "foreground": "#1a4d1a", "fontStyle": "italic" }
        },
        {
            "name": "String",
            "scope": [
                "string",
                "string.quoted",
                "string.quoted.single",
                "string.quoted.double",
                "string.template"
            ],
            "settings": { "foreground": "#88ffcc" }
        },
        {
            "name": "String - Escape Sequences",
            "scope": "constant.character.escape",
            "settings": { "foreground": "#aaff00" }
        },
        {
            "name": "Regular Expressions",
            "scope": "string.regexp",
            "settings": { "foreground": "#ccff00" }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.control.flow",
                "keyword.control.return",
                "keyword.control.conditional",
                "keyword.control.loop",
                "keyword.control.import",
                "keyword.control.from",
                "keyword.control.export"
            ],
            "settings": { "foreground": "#00ff41" }
        },
        {
            "name": "Keywords - Operators",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#39ff14" }
        },
        {
            "name": "Storage Types",
            "scope": [
                "storage.type",
                "storage.type.function",
                "storage.type.class",
                "storage.type.let",
                "storage.type.const",
                "storage.type.var"
            ],
            "settings": { "foreground": "#00ff41" }
        },
        {
            "name": "Storage Modifiers",
            "scope": [
                "storage.modifier",
                "storage.modifier.async",
                "storage.modifier.static"
            ],
            "settings": { "foreground": "#39ff14", "fontStyle": "italic" }
        },
        {
            "name": "Function Names",
            "scope": ["entity.name.function", "entity.name.function.member"],
            "settings": { "foreground": "#39ff14" }
        },
        {
            "name": "Function Calls",
            "scope": ["meta.function-call", "support.function"],
            "settings": { "foreground": "#39ff14" }
        },
        {
            "name": "Built-in Functions",
            "scope": ["support.function.builtin", "support.function.magic"],
            "settings": { "foreground": "#aaff00" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "variable.other", "variable.other.readwrite"],
            "settings": { "foreground": "#ccffcc" }
        },
        {
            "name": "Variables - Parameter",
            "scope": "variable.parameter",
            "settings": { "foreground": "#eeffee", "fontStyle": "italic" }
        },
        {
            "name": "Variables - Language",
            "scope": ["variable.language", "variable.language.this"],
            "settings": { "foreground": "#aaff00", "fontStyle": "italic" }
        },
        {
            "name": "Types / Classes",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "entity.name.interface",
                "entity.name.enum"
            ],
            "settings": { "foreground": "#aaffcc" }
        },
        {
            "name": "Numbers",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#aaff00" }
        },
        {
            "name": "Language Constants",
            "scope": [
                "constant.language",
                "constant.language.boolean",
                "constant.language.null"
            ],
            "settings": { "foreground": "#ccff44" }
        },
        {
            "name": "Decorator",
            "scope": ["meta.decorator", "entity.name.function.decorator"],
            "settings": { "foreground": "#aaff00", "fontStyle": "italic" }
        },
        {
            "name": "Tag Names",
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#00ff41" }
        },
        {
            "name": "Tag Attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#39ff14" }
        },
        {
            "name": "CSS Properties",
            "scope": "support.type.property-name",
            "settings": { "foreground": "#88ffcc" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation",
                "punctuation.separator",
                "punctuation.terminator"
            ],
            "settings": { "foreground": "#66cc66" }
        },
        {
            "name": "Markdown Headings",
            "scope": ["markup.heading"],
            "settings": { "foreground": "#00ff41", "fontStyle": "bold" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#ff4444" }
        }
    ]
}
