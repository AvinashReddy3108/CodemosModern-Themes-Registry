{
    "name": "Bocchi - Hitori Dark",
    "type": "dark",
    "colors": {
        "editor.background": "#010001",
        "editor.foreground": "#F6E9E6",
        "editor.lineHighlightBackground": "#F4A5B020",
        "editor.selectionBackground": "#F4A5B040",
        "editor.selectionHighlightBackground": "#F4A5B030",
        "editor.findMatchBackground": "#F4A5B050",
        "editor.findMatchHighlightBackground": "#F4A5B030",
        "editorLineNumber.foreground": "#B4698C",
        "editorLineNumber.activeForeground": "#F6E9E6",
        "editorIndentGuide.background": "#B4698C40",
        "editorIndentGuide.activeBackground": "#B4698C80",
        "editorBracketMatch.background": "#F4A5B030",
        "editorBracketMatch.border": "#FE01FE",
        "sideBar.background": "#0A0008",
        "sideBar.foreground": "#F6E9E6",
        "sideBarTitle.foreground": "#F6E9E6",
        "sideBarSectionHeader.background": "#B4698C40",
        "sideBarSectionHeader.foreground": "#F6E9E6",
        "activityBar.background": "#010001",
        "activityBar.foreground": "#F4A5B0",
        "activityBar.inactiveForeground": "#B4698C",
        "activityBarBadge.background": "#FE01FE",
        "activityBarBadge.foreground": "#F6E9E6",
        "titleBar.activeBackground": "#010001",
        "titleBar.activeForeground": "#F6E9E6",
        "titleBar.inactiveBackground": "#010001CC",
        "titleBar.inactiveForeground": "#B4698C",
        "statusBar.background": "#010001",
        "statusBar.foreground": "#F4A5B0",
        "statusBar.debuggingBackground": "#FE01FE",
        "statusBar.noFolderBackground": "#010001"
    },
    "tokenColors": [
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "storage.type",
                "storage.modifier",
                "keyword.control",
                "keyword.operator.new"
            ],
            "settings": { "foreground": "#F4A5B0", "fontStyle": "bold" }
        },
        {
            "name": "Types",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "entity.name.struct",
                "entity.name.enum",
                "entity.name.interface",
                "support.type",
                "support.class"
            ],
            "settings": { "foreground": "#FE01FE", "fontStyle": "bold" }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call"
            ],
            "settings": { "foreground": "#B4698C" }
        },
        {
            "name": "Variables",
            "scope": [
                "variable",
                "variable.other",
                "variable.parameter",
                "variable.language"
            ],
            "settings": { "foreground": "#F6E9E6" }
        },
        {
            "name": "Constants",
            "scope": [
                "constant",
                "constant.language",
                "constant.character",
                "constant.other"
            ],
            "settings": { "foreground": "#F4A5B0", "fontStyle": "bold" }
        },
        {
            "name": "Numbers",
            "scope": [
                "constant.numeric",
                "constant.numeric.integer",
                "constant.numeric.float",
                "constant.numeric.hex",
                "constant.numeric.octal",
                "constant.numeric.binary",
                "constant.numeric.decimal"
            ],
            "settings": { "foreground": "#FE01FE" }
        },
        {
            "name": "Strings",
            "scope": ["string", "string.template", "string.quoted"],
            "settings": { "foreground": "#B4698C" }
        },
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#5C015C", "fontStyle": "italic" }
        },
        {
            "name": "Operators",
            "scope": ["keyword.operator", "punctuation.definition"],
            "settings": { "foreground": "#F4A5B0" }
        },
        {
            "name": "Special Operators",
            "scope": [
                "keyword.operator.arithmetic",
                "keyword.operator.comparison",
                "keyword.operator.logical",
                "keyword.operator.assignment"
            ],
            "settings": { "foreground": "#FE01FE" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation",
                "punctuation.definition.block",
                "punctuation.definition.parameters",
                "punctuation.section",
                "meta.brace"
            ],
            "settings": { "foreground": "#B4698C" }
        },
        {
            "name": "Object Keys",
            "scope": [
                "meta.object-literal.key",
                "variable.object.property",
                "support.type.property-name"
            ],
            "settings": { "foreground": "#F4A5B0" }
        },
        {
            "name": "Language Constants",
            "scope": [
                "constant.language",
                "constant.language.boolean",
                "constant.language.null",
                "constant.language.undefined",
                "variable.language.this",
                "variable.language.super"
            ],
            "settings": { "foreground": "#FE01FE", "fontStyle": "italic bold" }
        },
        {
            "name": "Function Parameters",
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#F6E9E6", "fontStyle": "italic" }
        },
        {
            "name": "Import/Export Keywords",
            "scope": [
                "keyword.control.import",
                "keyword.control.export",
                "keyword.control.from"
            ],
            "settings": { "foreground": "#F4A5B0", "fontStyle": "bold" }
        },
        {
            "name": "HTML/XML Tags",
            "scope": ["entity.name.tag", "punctuation.definition.tag"],
            "settings": { "foreground": "#F4A5B0" }
        },
        {
            "name": "HTML/XML Attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#FE01FE", "fontStyle": "italic" }
        },
        {
            "name": "CSS Properties",
            "scope": [
                "support.type.property-name",
                "support.type.vendored.property-name"
            ],
            "settings": { "foreground": "#F4A5B0" }
        },
        {
            "name": "CSS Values",
            "scope": [
                "support.constant.property-value",
                "support.constant.vendored.property-value"
            ],
            "settings": { "foreground": "#B4698C" }
        },
        {
            "name": "Markdown Headers",
            "scope": ["markup.heading"],
            "settings": { "foreground": "#F4A5B0", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Links",
            "scope": ["markup.underline.link", "string.other.link"],
            "settings": { "foreground": "#FE01FE" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
