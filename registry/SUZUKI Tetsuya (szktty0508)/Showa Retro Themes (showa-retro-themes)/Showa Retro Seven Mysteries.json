    "tokenColors": [
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#E3ECEB80", "fontStyle": "italic" }
        },
        {
            "scope": [
                "string",
                "punctuation.definition.string",
                "constant.numeric",
                "constant.character",
                "constant.other"
            ],
            "settings": { "foreground": "#E3ECEB" }
        },
        {
            "scope": "constant.language",
            "settings": { "foreground": "#721212", "fontStyle": "bold" }
        },
        { "scope": "variable", "settings": { "foreground": "#E3ECEB" } },
        {
            "scope": "variable.language",
            "settings": { "foreground": "#721212", "fontStyle": "italic" }
        },
        {
            "scope": ["keyword", "storage"],
            "settings": { "foreground": "#721212", "fontStyle": "bold" }
        },
        {
            "scope": "storage.type",
            "settings": { "foreground": "#E3ECEB", "fontStyle": "italic" }
        },
        {
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.class",
                "entity.name.function",
                "support.function"
            ],
            "settings": { "foreground": "#E3ECEB", "fontStyle": "bold" }
        },
        {
            "scope": "entity.other.inherited-class",
            "settings": { "foreground": "#E3ECEB", "fontStyle": "italic" }
        },
        {
            "scope": "variable.parameter",
            "settings": { "foreground": "#E3ECEB", "fontStyle": "italic" }
        },
        {
            "scope": "entity.name.tag",
            "settings": { "foreground": "#721212", "fontStyle": "bold" }
        },
        {
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#E3ECEB", "fontStyle": "italic" }
        },
        {
            "scope": [
                "support.function",
                "support.constant",
                "support.type",
                "support.class",
                "support.variable"
            ],
            "settings": { "foreground": "#5C6A8D", "fontStyle": "" }
        },
        {
            "scope": "invalid",
            "settings": { "foreground": "#E3ECEB", "background": "#721212" }
        },
        {
            "scope": "invalid.deprecated",
            "settings": { "foreground": "#E3ECEB", "background": "#2A3655" }
        },
        {
            "scope": "support.type.property-name.json",
            "settings": { "foreground": "#721212" }
        },
        {
            "scope": "string.quoted.double.json",
            "settings": { "foreground": "#E3ECEB" }
        },
        {
            "scope": "constant.language.json",
            "settings": { "foreground": "#E3ECEB" }
        },
        {
            "scope": "markup.heading",
            "settings": { "foreground": "#721212", "fontStyle": "bold" }
        },
        {
            "scope": "markup.underline.link",
            "settings": { "foreground": "#5C6A8D", "fontStyle": "underline" }
        },
        {
            "scope": "markup.bold",
            "settings": { "foreground": "#E3ECEB", "fontStyle": "bold" }
        },
        {
            "scope": "markup.italic",
            "settings": { "foreground": "#E3ECEB", "fontStyle": "italic" }
        },
        {
            "scope": "markup.inline.raw",
            "settings": { "foreground": "#5C6A8D" }
        },
        {
            "scope": "token.info-token",
            "settings": { "foreground": "#6796E6" }
        },
        {
            "scope": "token.warn-token",
            "settings": { "foreground": "#CD9731" }
        },
        {
            "scope": "token.error-token",
            "settings": { "foreground": "#F44747" }
        },
        {
            "scope": "token.debug-token",
            "settings": { "foreground": "#B267E6" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
