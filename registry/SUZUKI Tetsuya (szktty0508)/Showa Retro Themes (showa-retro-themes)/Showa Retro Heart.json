    "tokenColors": [
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#B5987E", "fontStyle": "italic" }
        },
        {
            "scope": ["string", "punctuation.definition.string"],
            "settings": { "foreground": "#D58F84" }
        },
        {
            "scope": "constant.numeric",
            "settings": { "foreground": "#D58F84" }
        },
        {
            "scope": "constant.language",
            "settings": { "foreground": "#D15435", "fontStyle": "bold" }
        },
        {
            "scope": ["constant.character", "constant.other"],
            "settings": { "foreground": "#D58F84" }
        },
        { "scope": "variable", "settings": { "foreground": "#7D5E43" } },
        {
            "scope": "variable.language",
            "settings": { "foreground": "#D15435", "fontStyle": "italic" }
        },
        {
            "scope": "keyword",
            "settings": { "foreground": "#D15435", "fontStyle": "bold" }
        },
        {
            "scope": "storage",
            "settings": { "foreground": "#D15435", "fontStyle": "" }
        },
        {
            "scope": "storage.type",
            "settings": { "foreground": "#7D5E43", "fontStyle": "italic" }
        },
        {
            "scope": ["entity.name.type", "entity.name.class", "support.class"],
            "settings": {
                "foreground": "#7D5E43",
                "fontStyle": "bold underline"
            }
        },
        {
            "scope": "entity.other.inherited-class",
            "settings": {
                "foreground": "#7D5E43",
                "fontStyle": "italic underline"
            }
        },
        {
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#7D5E43", "fontStyle": "bold" }
        },
        {
            "scope": "variable.parameter",
            "settings": { "foreground": "#7D5E43", "fontStyle": "italic" }
        },
        {
            "scope": "entity.name.tag",
            "settings": { "foreground": "#D15435", "fontStyle": "bold" }
        },
        {
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#D58F84", "fontStyle": "italic" }
        },
        {
            "scope": "support.function",
            "settings": { "foreground": "#D58F84", "fontStyle": "bold" }
        },
        {
            "scope": "support.constant",
            "settings": { "foreground": "#D58F84" }
        },
        {
            "scope": ["support.type", "support.class"],
            "settings": { "foreground": "#D58F84", "fontStyle": "italic" }
        },
        {
            "scope": "support.variable",
            "settings": { "foreground": "#D58F84" }
        },
        {
            "scope": "invalid",
            "settings": { "foreground": "#E0C88A", "background": "#D15435" }
        },
        {
            "scope": "invalid.deprecated",
            "settings": { "foreground": "#7D5E43", "background": "#D58F84" }
        },
        {
            "scope": "support.type.property-name.json",
            "settings": { "foreground": "#D15435" }
        },
        {
            "scope": "string.quoted.double.json",
            "settings": { "foreground": "#D58F84" }
        },
        {
            "scope": "constant.language.json",
            "settings": { "foreground": "#E8B9AE" }
        },
        {
            "scope": "markup.heading",
            "settings": { "foreground": "#D15435", "fontStyle": "bold" }
        },
        {
            "scope": "markup.underline.link",
            "settings": { "foreground": "#D58F84", "fontStyle": "underline" }
        },
        {
            "scope": "markup.bold",
            "settings": { "foreground": "#7D5E43", "fontStyle": "bold" }
        },
        {
            "scope": "markup.italic",
            "settings": { "foreground": "#7D5E43", "fontStyle": "italic" }
        },
        {
            "scope": "markup.inline.raw",
            "settings": { "foreground": "#D58F84" }
        },
        {
            "scope": "token.info-token",
            "settings": { "foreground": "#316BCD" }
        },
        {
            "scope": "token.warn-token",
            "settings": { "foreground": "#CD9731" }
        },
        {
            "scope": "token.error-token",
            "settings": { "foreground": "#CD3131" }
        },
        {
            "scope": "token.debug-token",
            "settings": { "foreground": "#800080" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
