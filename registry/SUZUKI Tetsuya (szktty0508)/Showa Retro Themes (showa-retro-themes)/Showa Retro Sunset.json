    "tokenColors": [
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#D38F2C", "fontStyle": "italic" }
        },
        {
            "scope": ["string", "punctuation.definition.string"],
            "settings": { "foreground": "#C2AB5F" }
        },
        {
            "scope": "constant.numeric",
            "settings": { "foreground": "#F5F379" }
        },
        {
            "scope": [
                "constant.language",
                "constant.character",
                "constant.other"
            ],
            "settings": { "foreground": "#C5461D", "fontStyle": "bold" }
        },
        { "scope": "variable", "settings": { "foreground": "#281C15" } },
        {
            "scope": "variable.language",
            "settings": { "foreground": "#C5461D", "fontStyle": "italic" }
        },
        {
            "scope": ["keyword", "storage"],
            "settings": { "foreground": "#C5461D", "fontStyle": "bold" }
        },
        {
            "scope": "storage.type",
            "settings": { "foreground": "#D38F2C", "fontStyle": "italic" }
        },
        {
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.class",
                "entity.name.function",
                "support.function"
            ],
            "settings": { "foreground": "#801902", "fontStyle": "bold" }
        },
        {
            "scope": "entity.other.inherited-class",
            "settings": { "foreground": "#801902", "fontStyle": "italic" }
        },
        {
            "scope": "variable.parameter",
            "settings": { "foreground": "#281C15", "fontStyle": "italic" }
        },
        {
            "scope": "entity.name.tag",
            "settings": { "foreground": "#C5461D", "fontStyle": "bold" }
        },
        {
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#F5F379", "fontStyle": "italic" }
        },
        {
            "scope": [
                "support.function",
                "support.constant",
                "support.type",
                "support.class",
                "support.variable"
            ],
            "settings": { "foreground": "#D38F2C", "fontStyle": "" }
        },
        {
            "scope": "invalid",
            "settings": { "foreground": "#FFF8E6", "background": "#C5461D" }
        },
        {
            "scope": "invalid.deprecated",
            "settings": { "foreground": "#281C15", "background": "#F5F379" }
        },
        {
            "scope": "support.type.property-name.json",
            "settings": { "foreground": "#C5461D" }
        },
        {
            "scope": "string.quoted.double.json",
            "settings": { "foreground": "#C2AB5F" }
        },
        {
            "scope": "constant.language.json",
            "settings": { "foreground": "#D38F2C" }
        },
        {
            "scope": "markup.heading",
            "settings": { "foreground": "#C5461D", "fontStyle": "bold" }
        },
        {
            "scope": "markup.underline.link",
            "settings": { "foreground": "#F5F379", "fontStyle": "underline" }
        },
        {
            "scope": "markup.bold",
            "settings": { "foreground": "#281C15", "fontStyle": "bold" }
        },
        {
            "scope": "markup.italic",
            "settings": { "foreground": "#281C15", "fontStyle": "italic" }
        },
        {
            "scope": "markup.inline.raw",
            "settings": { "foreground": "#F5F379" }
        },
        {
            "scope": "token.info-token",
            "settings": { "foreground": "#316BCD" }
        },
        {
            "scope": "token.warn-token",
            "settings": { "foreground": "#CD9731" }
        },
        {
            "scope": "token.error-token",
            "settings": { "foreground": "#CD3131" }
        },
        {
            "scope": "token.debug-token",
            "settings": { "foreground": "#800080" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
