{
    "name": "Apex",
    "type": "dark",
    "colors": {
        "editor.background": "#202123",
        "editor.foreground": "#fff",
        "editorIndentGuide.background": "#adb5db30",
        "editorIndentGuide.activeBackground": "#adb5db99",
        "editorWhitespace.foreground": "#adb5db30",
        "editorCursor.background": "#202123",
        "editorGutter.background": "#202123",
        "editorLineNumber.foreground": "#adb5db4f",
        "editorLineNumber.activeForeground": "#e9ecef",
        "editor.lineHighlightBackground": "#202123",
        "editorGutter.foldingControlForeground": "#495057",
        "editorCursor.foreground": "#00baff",
        "terminalCursor.foreground": "#00baff",
        "editor.selectionBackground": "#f8f9fa11",
        "searchEditor.findMatchBackground": "#202123",
        "searchEditor.findMatchBorder": "#1862ab",
        "editor.rangeHighlightBackground": "#202123",
        "editor.findMatchBackground": "#202123",
        "editor.findMatchBorder": "#1862ab",
        "editor.findMatchHighlightBackground": "#202123",
        "editor.findMatchHighlightBorder": "#329af0",
        "editorBracketMatch.border": "#0097e8",
        "scrollbarSlider.background": "#495057",
        "scrollbar.shadow": "#212529",
        "scrollbarSlider.hoverBackground": "#495057",
        "scrollbarSlider.activeBackground": "#495057",
        "button.foreground": "#2f343a",
        "button.background": "#202123",
        "button.hoverBackground": "#202123",
        "panel.border": "#212529",
        "activityBar.border": "#212529",
        "focusBorder": "#212529",
        "statusBar.border": "#212529",
        "gitDecoration.addedResourceForeground": "#212529",
        "editorGutter.addedBackground": "#228ae699",
        "gitDecoration.ignoredResourceForeground": "#868e96",
        "gitDecoration.modifiedResourceForeground": "#12b886",
        "editorGutter.modifiedBackground": "#228ae699",
        "gitDecoration.deletedResourceForeground": "#fa5252",
        "editorGutter.deletedBackground": "#e6498099",
        "gitDecoration.untrackedResourceForeground": "#228ae6",
        "editorSuggestWidget.background": "#212529",
        "editorSuggestWidget.highlightForeground": "#f8f9fa",
        "editorSuggestWidget.selectedBackground": "#2f343a",
        "editorSuggestWidget.foreground": "#868e96",
        "quickInput.background": "#202123",
        "quickInput.foreground": "#adb5db99",
        "list.focusBackground": "#212529",
        "list.focusForeground": "#fff",
        "list.hoverBackground": "#212529",
        "list.activeSelectionBackground": "#202123",
        "list.inactiveSelectionBackground": "#202123",
        "statusBar.background": "#202123",
        "statusBar.noFolderBackground": "#fff",
        "statusBar.foreground": "#f8f9fa",
        "statusBar.noFolderForeground": "#2f343a",
        "tab.activeBorderTop": "#f8f9fa",
        "tab.activeForeground": "#fff",
        "tab.inactiveForeground": "#868e9699",
        "tab.inactiveBackground": "#202123",
        "tab.border": "#202123",
        "editorGroupHeader.tabsBackground": "#202123",
        "tree.indentGuidesStroke": "#202123",
        "sideBar.background": "#202123",
        "sideBar.border": "#212529",
        "sideBar.foreground": "#f8f9fa",
        "selection.background": "#adb5db30",
        "activityBar.background": "#202123",
        "activityBar.foreground": "#f8f9fa",
        "activityBar.activeBackground": "#212529",
        "activityBar.inactiveForeground": "#adb5db99",
        "activityBarBadge.background": "#00baff",
        "activityBarBadge.foreground": "#fff",
        "badge.background": "#00baff",
        "badge.foreground": "#202123",
        "input.background": "#2f343a",
        "input.foreground": "#adb5db",
        "dropdown.background": "#2f343a",
        "dropdown.border": "#adb5db",
        "dropdown.foreground": "#adb5db",
        "settings.dropdownBorder": "#2f343a",
        "settings.headerForeground": "#495057",
        "titleBar.activeBackground": "#202123",
        "titleBar.inactiveBackground": "#202123",
        "titleBar.activeForeground": "#fff",
        "sideBarSectionHeader.background": "#202123",
        "sideBarSectionHeader.foreground": "#868e96",
        "sideBarSectionHeader.border": "#212529",
        "editorWidget.background": "#212529"
    },
    "tokenColors": [
        {
            "name": "Bolded tokens",
            "scope": ["meta.selector", "meta.at-rule"],
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "String primitives",
            "scope": "string",
            "settings": { "foreground": "#868e96" }
        },
        {
            "name": "Comments",
            "scope": "comment",
            "settings": { "foreground": "#adb5db4f" }
        },
        {
            "name": "Bold",
            "scope": "markup.bold",
            "settings": { "foreground": "#495057", "fontStyle": "bold" }
        },
        {
            "name": "Italic",
            "scope": "markup.italic",
            "settings": { "foreground": "#495057", "fontStyle": "italic" }
        },
        {
            "name": "CSS Selectors",
            "scope": "meta.selector",
            "settings": { "foreground": "#f8f9fa", "fontStyle": "bold" }
        },
        {
            "name": "CSS Properties",
            "scope": "meta.property-value",
            "settings": { "foreground": "#868e96", "fontStyle": "" }
        },
        {
            "name": "Markdown heading marker",
            "scope": "markup.heading",
            "settings": { "foreground": "#f8f9fa", "fontStyle": "bold" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
