{
    "name": "My Custom Theme",
    "type": "dark",
    "extends": "Default Dark+",
    "tokenColors": [
        {
            "scope": "keyword.control.tct",
            "settings": { "foreground": "#d1001c", "fontStyle": "bold" }
        },
        {
            "scope": "keyword.control.tctcoltd",
            "settings": { "foreground": "#5dbaff", "fontStyle": "bold" }
        },
        {
            "scope": "keyword.control.tctcolts",
            "settings": { "foreground": "#00fbf4", "fontStyle": "bold" }
        },
        {
            "scope": "keyword.control.tctcolc1",
            "settings": { "foreground": "#ffffcb", "fontStyle": "bold" }
        },
        {
            "scope": "keyword.control.tctcolc2",
            "settings": { "foreground": "#fee775", "fontStyle": "bold" }
        },
        {
            "scope": "keyword.control.tctcolc3",
            "settings": { "foreground": "#fec140", "fontStyle": "bold" }
        },
        {
            "scope": "keyword.control.tctcolc4",
            "settings": { "foreground": "#ff8f21", "fontStyle": "bold" }
        },
        {
            "scope": "keyword.control.tctcolc5",
            "settings": { "foreground": "#ff6160", "fontStyle": "bold" }
        },
        {
            "scope": "keyword.control.tctparam",
            "settings": { "foreground": "#bf8752", "fontStyle": "bold" }
        },
        {
            "scope": "keyword.control.tcttypetrop",
            "settings": { "foreground": "#ff00f7", "fontStyle": "bold" }
        },
        {
            "scope": "keyword.control.tcttypesub",
            "settings": { "foreground": "#ff0084", "fontStyle": "bold" }
        },
        {
            "scope": "keyword.control.tcttypeex",
            "settings": { "foreground": "#ff0033", "fontStyle": "bold" }
        },
        {
            "scope": "constant.numeric.integer.tct",
            "settings": { "foreground": "#ffd359" }
        },
        {
            "scope": "constant.numeric.float.tct",
            "settings": { "foreground": "#ffd359" }
        },
        {
            "scope": "comment.line.double-slash.tct",
            "settings": { "foreground": "#009111" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
