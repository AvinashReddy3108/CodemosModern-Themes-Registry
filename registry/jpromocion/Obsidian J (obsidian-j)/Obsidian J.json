    "tokenColors": [
        {
            "scope": "comment markup.link",
            "settings": { "foreground": "#7F848E" }
        },
        {
            "scope": "comment, punctuation.definition.comment",
            "settings": { "foreground": "#7F848E", "fontStyle": "italic" }
        },
        {
            "scope": "comment.line.double-slash,comment.block.documentation",
            "settings": { "fontStyle": "italic" }
        },
        {
            "scope": ["string", "string.template"],
            "settings": { "foreground": "#EC7600" }
        },
        {
            "scope": "constant.numeric",
            "settings": { "foreground": "#EFC210" }
        },
        {
            "scope": [
                "string.embedded.begin",
                "string.embedded.end",
                "punctuation.definition.template-expression",
                "punctuation.section.embedded"
            ],
            "settings": { "foreground": "#EFC210" }
        },
        {
            "scope": [
                "punctuation.section.embedded.begin.js",
                "punctuation.section.embedded.end.js",
                "punctuation.section.embedded.begin.erb",
                "punctuation.section.embedded.end.erb",
                "source.elixir.embedded",
                "punctuation.separator",
                "punctuation.accessor",
                "meta.brace"
            ],
            "settings": { "foreground": "#ABB2BF" }
        },
        {
            "scope": "constant.language",
            "settings": { "foreground": "#678CB1" }
        },
        {
            "scope": ["constant.character", "constant.other"],
            "settings": { "foreground": "#678CB1" }
        },
        {
            "scope": "variable.language",
            "settings": { "foreground": "#93C763" }
        },
        {
            "scope": [
                "keyword",
                "keyword.operator.logical",
                "keyword.operator.constructor"
            ],
            "settings": { "foreground": "#93C763" }
        },
        {
            "scope": "keyword.operator",
            "settings": { "foreground": "#93C763" }
        },
        { "scope": "storage", "settings": { "foreground": "#93C763" } },
        { "scope": "storage.type", "settings": { "foreground": "#678CB1" } },
        {
            "scope": [
                "entity.name.class",
                "entity.name.module",
                "entity.name.type",
                "storage.identifier",
                "support.class"
            ],
            "settings": { "foreground": "#678CB1" }
        },
        {
            "scope": [
                "variable.other.object",
                "variable.other.constant",
                "variable.other.global",
                "variable.other.readwrite.class",
                "variable.other.readwrite.instance",
                "variable.other.readwrite.batchfile",
                "variable.readwrite",
                "variable.readwrite.other.block"
            ],
            "settings": { "foreground": "#678CB1" }
        },
        {
            "scope": [
                "variable.other",
                "variable.other.property",
                "variable.other.block"
            ],
            "settings": { "foreground": "#ABB2BF" }
        },
        {
            "scope": "entity.other.inherited-class",
            "settings": { "foreground": "#E8E2B7" }
        },
        {
            "scope": ["storage.modifier.import", "storage.modifier.package"],
            "settings": { "foreground": "#678CB1" }
        },
        {
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#E8E2B7" }
        },
        {
            "scope": [
                "variable.parameter",
                "entity.name.variable.parameter",
                "parameter.variable"
            ],
            "settings": { "foreground": "#ffcd22", "fontStyle": "italic" }
        },
        {
            "scope": "entity.name.function-call",
            "settings": { "foreground": "#ABB2BF" }
        },
        {
            "scope": ["function.support.builtin", "function.support.core"],
            "settings": { "foreground": "#E8E2B7" }
        },
        {
            "scope": ["entity.name.tag", "entity.name.tag.class.js"],
            "settings": { "foreground": "#93C763" }
        },
        {
            "scope": ["entity.name.tag.class", "entity.name.tag.id"],
            "settings": { "foreground": "#678CB1" }
        },
        {
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#E8E2B7" }
        },
        {
            "scope": "support.constant",
            "settings": { "foreground": "#678CB1" }
        },
        {
            "scope": ["support.type", "support.variable"],
            "settings": { "foreground": "#678CB1" }
        },
        {
            "scope": "support.dictionary.json",
            "settings": { "foreground": "#678CB1" }
        },
        {
            "scope": [
                "support.type.property-name.css",
                "support.type.property-name.scss",
                "support.type.property-name.less",
                "support.type.property-name.sass"
            ],
            "settings": { "foreground": "#ABB2BF" }
        },
        {
            "scope": [
                "entity.other.attribute-name.pseudo-class.css",
                "entity.other.attribute-name.pseudo-class.scss",
                "entity.other.attribute-name.pseudo-class.less",
                "entity.other.attribute-name.pseudo-class.sass",
                "entity.other.attribute-name.pseudo-element.css",
                "entity.other.attribute-name.pseudo-element.scss",
                "entity.other.attribute-name.pseudo-element.less",
                "entity.other.attribute-name.pseudo-element.sass"
            ],
            "settings": { "foreground": "#678CB1" }
        },
        {
            "scope": [
                "support.constant.css",
                "support.constant.scss",
                "support.constant.less",
                "support.constant.sass"
            ],
            "settings": { "foreground": "#E8E2B7" }
        },
        {
            "scope": [
                "variable.css",
                "variable.scss",
                "variable.less",
                "variable.sass"
            ],
            "settings": { "foreground": "#678CB1" }
        },
        {
            "scope": [
                "variable.css.string",
                "variable.scss.string",
                "variable.less.string",
                "variable.sass.string"
            ],
            "settings": { "foreground": "#EC7600" }
        },
        {
            "scope": ["unit.css", "unit.scss", "unit.less", "unit.sass"],
            "settings": { "foreground": "#EFC210" }
        },
        {
            "scope": [
                "function.css",
                "function.scss",
                "function.less",
                "function.sass"
            ],
            "settings": { "foreground": "#678CB1" }
        },
        { "scope": "support.other.variable", "settings": { "fontStyle": "" } },
        {
            "scope": "invalid",
            "settings": { "foreground": "#F8F8F0", "background": "#EFC210" }
        },
        {
            "scope": "invalid.deprecated",
            "settings": { "foreground": "#F8F8F0", "background": "#678CB1" }
        },
        {
            "scope": "support.type.property-name.json",
            "settings": { "foreground": "#678CB1" }
        },
        {
            "scope": "string.detected-link",
            "settings": { "foreground": "#678CB1" }
        },
        {
            "scope": ["meta.diff", "meta.diff.header"],
            "settings": { "foreground": "#75715E" }
        },
        { "scope": "markup.deleted", "settings": { "foreground": "#93C763" } },
        { "scope": "markup.inserted", "settings": { "foreground": "#E8E2B7" } },
        { "scope": "markup.changed", "settings": { "foreground": "#EC7600" } },
        {
            "scope": "constant.numeric.line-number.find-in-files - match",
            "settings": { "foreground": "#678CB1A0" }
        },
        {
            "scope": "entity.name.filename.find-in-files",
            "settings": { "foreground": "#EC7600" }
        },
        {
            "scope": "markup.italic, markup.italic.markdown",
            "settings": { "fontStyle": "italic" }
        },
        {
            "scope": [
                "punctuation.definition.italic.markdown",
                "punctuation.definition.bold.markdown",
                "punctuation.definition.heading.markdown"
            ],
            "settings": { "foreground": "#676F7D" }
        },
        {
            "scope": "punctuation.definition.italic.markdown",
            "settings": { "fontStyle": "italic" }
        },
        {
            "scope": "markup.underline.link.markdown",
            "settings": { "foreground": "#678CB1" }
        },
        {
            "scope": "markup.bold.markdown",
            "settings": { "fontStyle": "bold" }
        },
        {
            "scope": "markup.heading.markdown",
            "settings": { "foreground": "#93C763", "fontStyle": "bold" }
        },
        {
            "scope": "markup.quote.markdown",
            "settings": { "foreground": "#E8E2B7" }
        },
        {
            "scope": "meta.separator.markdown",
            "settings": { "foreground": "#EFC210", "fontStyle": "bold" }
        },
        {
            "scope": [
                "markup.raw.inline.markdown",
                "markup.raw.block.markdown"
            ],
            "settings": { "foreground": "#678CB1" }
        },
        {
            "scope": "punctuation.definition.list_item.markdown",
            "settings": { "foreground": "#FFFFFF", "fontStyle": "bold" }
        },
        {
            "scope": "token.info-token",
            "settings": { "foreground": "#6796E6" }
        },
        {
            "scope": "token.warn-token",
            "settings": { "foreground": "#CD9731" }
        },
        {
            "scope": "token.error-token",
            "settings": { "foreground": "#F44747" }
        },
        {
            "scope": "token.debug-token",
            "settings": { "foreground": "#B267E6" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
