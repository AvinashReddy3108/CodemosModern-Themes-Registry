{
    "name": "Mediteme",
    "type": "dark",
    "colors": {
        "activityBar.background": "#103a75",
        "badge.background": "#569cd6",
        "editor.background": "#21252B",
        "editor.foreground": "#e8e0c8",
        "editorCursor.foreground": "#e8e0c8",
        "titleBar.activeBackground": "#18263a",
        "titleBar.activeForeground": "#fcf9fc",
        "activityBar.activeBorder": "#ffda72",
        "activityBar.foreground": "#000000",
        "activityBar.inactiveForeground": "#ffffff8c",
        "breadcrumb.background": "#222730",
        "breadcrumbPicker.background": "#303742",
        "diffEditor.insertedTextBackground": "#7faa4e33",
        "dropdown.background": "#222121",
        "editor.selectionBackground": "#193770ec",
        "editor.selectionHighlightBackground": "#15416d88",
        "editor.wordHighlightBackground": "#40443370",
        "editor.wordHighlightStrongBackground": "#01397a6e",
        "editorGroupHeader.tabsBackground": "#18181a",
        "editorGutter.background": "#21252B",
        "editorGutter.foldingControlForeground": "#fdff8a",
        "editorIndentGuide.activeBackground": "#e3e4e250",
        "editorIndentGuide.background": "#000000",
        "editorLineNumber.activeForeground": "#ffd4b8",
        "editorLineNumber.foreground": "#a8a8a84d",
        "editorBracketHighlight.foreground1": "#5bb3b3",
        "editorBracketHighlight.foreground2": "#fac863",
        "editorBracketHighlight.foreground3": "#bb80b3",
        "editorBracketHighlight.foreground4": "#98c379",
        "editorBracketMatch.border": "#ffffff",
        "editorOverviewRuler.border": "#0000008c",
        "gitDecoration.addedResourceForeground": "#81b88b",
        "gitDecoration.conflictingResourceForeground": "#e4676b",
        "gitDecoration.deletedResourceForeground": "#c74e39",
        "gitDecoration.ignoredResourceForeground": "#837559",
        "gitlens.decorations.ignoredForegroundColor": "#c4c4c4",
        "gitDecoration.modifiedResourceForeground": "#ffd493",
        "gitDecoration.renamedResourceForeground": "#73c991",
        "gitDecoration.stageDeletedResourceForeground": "#c74e39",
        "gitDecoration.stageModifiedResourceForeground": "#e2c08d",
        "gitDecoration.submoduleResourceForeground": "#8db9e2",
        "gitDecoration.untrackedResourceForeground": "#73c991",
        "list.hoverBackground": "#0068638f",
        "menu.background": "#222121",
        "panel.background": "#101416",
        "panel.border": "#00000059",
        "panelTitle.activeBorder": "#f78166",
        "panelTitle.activeForeground": "#ecf5ff",
        "panelTitle.inactiveForeground": "#8b949e",
        "sideBar.background": "#121213",
        "sideBar.dropBackground": "#53595d80",
        "statusBar.background": "#02131f",
        "statusBarItem.remoteBackground": "#25a760",
        "tab.activeBackground": "#222730",
        "tab.activeModifiedBorder": "#f78166",
        "tab.border": "#585858",
        "tab.inactiveBackground": "#111111",
        "tab.inactiveModifiedBorder": "#f78166ad",
        "tab.lastPinnedBorder": "#ff9b9b",
        "terminal.dropBackground": "#262d3080",
        "tree.indentGuidesStroke": "#a7a66f",
        "activityBar.activeBackground": "#acad6f",
        "editor.lineHighlightBackground": "#0e1313b6",
        "editor.selectionHighlightBorder": "#59adf781",
        "editor.wordHighlightBorder": "#2963599a",
        "editor.wordHighlightStrongBorder": "#267ecc9d",
        "list.focusBackground": "#002e3b",
        "list.hoverForeground": "#ffffff",
        "list.inactiveFocusOutline": "#c1df8aa1",
        "menu.border": "#c2c2c283",
        "menubar.selectionBorder": "#a8a8a8",
        "statusBar.border": "#000000",
        "tab.activeBorderTop": "#0084ff",
        "tab.hoverBorder": "#ff9a9a",
        "terminal.background": "#101416",
        "terminal.tab.activeBorder": "#ff0202"
    },
    "semanticTokenColors": {
        "namespace": "#267cc2",
        "interface": "#267cc2",
        "class": "#33a3ff",
        "type": "#33a3ff",
        "*.typeHint": "#267cc2",
        "*.decorator": "#afeeff",
        "function": { "foreground": "#6cfdb4e7", "bold": false },
        "method": { "foreground": "#6cfdb4e7", "bold": false },
        "magicFunction": {
            "foreground": "#17ffd5e7",
            "italic": true,
            "bold": false
        },
        "annotation": {
            "foreground": "#afeeff",
            "bold": false,
            "italic": true
        },
        "local": { "foreground": "#b4d3dbe7" },
        "variable": { "foreground": "#b4d3dbe7", "bold": false },
        "variable.readonly": {
            "foreground": "#c0bfb4",
            "bold": true,
            "italic": false
        },
        "variable.readonly.local": {
            "foreground": "#c1e6f0e7",
            "italic": false,
            "bold": false
        },
        "variable.defaultLibrary": { "foreground": "#33a3ff", "bold": false },
        "property": "#9CDCFE",
        "field": "#9CDCFE",
        "parameter": "#e3e4dcee",
        "selfParameter": {
            "foreground": "#c6ccd7",
            "bold": true,
            "italic": false
        },
        "comment": "#576b5e",
        "typeParameter": {
            "foreground": "#d7ffe1",
            "italic": true,
            "bold": false
        },
        "enum": "#20a377",
        "controlKeyword": { "foreground": "#fd9743", "bold": false },
        "clsParameter": "#d7ffe1",
        "operator": "#e6616c",
        "keyword": "#fd9743",
        "keyword.operator": "#e6616c"
    },
    "semanticHighlighting": true,
    "tokenColors": [
        {
            "scope": "source, variable, meta.object, meta.tag, support.constant, meta.function-call.arguments, variable.parameter.function, support.type.object",
            "settings": { "foreground": "#b4d3dbe7", "fontStyle": "" }
        },
        {
            "scope": "variable.other",
            "settings": { "foreground": "#968b9b", "fontStyle": "italic" }
        },
        {
            "scope": "support.variable, variable.parameter",
            "settings": { "foreground": "#9CDCFE", "fontStyle": "" }
        },
        {
            "scope": "keyword, storage, keyword.control, keyword.operator.expression, primitive, modifier, language.constant, meta.preprocessor, support.type.primitive, keyword.language.gherkin.feature, punctuation.definition.decorator",
            "settings": { "foreground": "#fd9743" }
        },
        {
            "scope": "keyword.type, keyword.other, keyword.operator.new",
            "settings": { "foreground": "#f5c748ea", "fontStyle": "" }
        },
        {
            "scope": "keyword.operator.logical, punctuation.accessor",
            "settings": { "foreground": "#e6616c", "fontStyle": "bold" }
        },
        {
            "scope": "constant.language",
            "settings": { "foreground": "#E5C07B", "fontStyle": "bold" }
        },
        {
            "scope": "storage.modifier.import",
            "settings": { "foreground": "#ce9863", "fontStyle": "" }
        },
        {
            "scope": "storage.type.annotation, variable.language.this",
            "settings": { "foreground": "#e2f8e5", "fontStyle": "italic" }
        },
        {
            "scope": "punctuation.definition, punctuation.terminator",
            "settings": { "foreground": "#ffffff6c", "fontStyle": "" }
        },
        {
            "scope": "meta.type.parameters, entity.name.type.type-parameter, constant.character.format.placeholder, text.variable",
            "settings": { "foreground": "#d7ffe1", "fontStyle": "italic" }
        },
        {
            "scope": "entity.name.type, entity.name.type.alias, entity.name.type.class, meta.return.type, class.type.name, storage.type.variable, meta.type.annotation, return-type, inherited-class, entity.other.inherited-class, declaration.entity.type, declaration.heritage.type, storage.type.cs, new.expr, string.language.gherkin",
            "settings": { "foreground": "#33a3ff", "fontStyle": "" }
        },
        {
            "scope": "entity.name.type.interface, entity.name.type.namespace, entity.name.type.model",
            "settings": { "foreground": "#558dbb", "fontStyle": "" }
        },
        {
            "scope": "support.class",
            "settings": { "foreground": "#7EE787", "fontStyle": "" }
        },
        {
            "scope": "string, punctuation.definition.string, keyword.operator.quantifier.regexp",
            "settings": { "foreground": "#c9a192", "fontStyle": "" }
        },
        {
            "scope": "constant.character.escape",
            "settings": { "foreground": "#f1c2c2" }
        },
        {
            "scope": "comment, punctuation.definition.comment",
            "settings": { "foreground": "#576b5e" }
        },
        {
            "scope": "constant.numeric",
            "settings": { "foreground": "#56B6C2" }
        },
        {
            "scope": "property-name, support.function, meta.function-call, entity.name.function, variable.legacy.builtin, keyword.language.gherkin.feature.step, text.gherkin.feature",
            "settings": { "foreground": "#6cfdb4e7", "fontStyle": "" }
        },
        {
            "scope": "support.type.property-name, punctuation.support.type.property-name",
            "settings": { "foreground": "#86c7f3" }
        },
        {
            "scope": "entity.name.tag, selector, selector.attribute-name",
            "settings": { "foreground": "#E5C07B" }
        },
        {
            "scope": "meta.tag.begin, meta.tag.end",
            "settings": { "foreground": "#30A2C2" }
        },
        {
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#30C9AE", "fontStyle": "" }
        },
        {
            "scope": "tag.quoted, string.quoted.double.html, string.quoted.single.html, punctuation.definition.string.begin.html, punctuation.definition.string.end.html",
            "settings": { "foreground": "#A3A3A3" }
        },
        {
            "scope": "detected-link, string.detected-link",
            "settings": { "foreground": "#80C2E2" }
        },
        {
            "scope": "entity.name.tag.tsx, entity.name.tag.jsx, entity.name.tag.js",
            "settings": { "foreground": "#569CD6" }
        },
        {
            "scope": "meta.tag.begin.tsx, meta.tag.end.tsx, meta.tag.begin.jsx, meta.tag.end.jsx, meta.tag.begin.js, meta.tag.end.js",
            "settings": { "foreground": "#AAAAAA" }
        },
        {
            "scope": "entity.other.attribute-name.tsx, entity.other.attribute-name.js, entity.other.attribute-name.jsx",
            "settings": { "foreground": "#00CCFF" }
        },
        {
            "scope": "js.storage.type",
            "settings": { "foreground": "#FF8811", "fontStyle": "bold" }
        },
        {
            "scope": [
                "string.quoted.docstring.multi.python",
                "string.quoted.docstring.multi.python punctuation.definition.string.begin.python",
                "string.quoted.docstring.multi.python punctuation.definition.string.end.python"
            ],
            "settings": { "foreground": "#576b5e", "fontStyle": "italic" }
        },
        {
            "scope": [
                "punctuation.section.embedded.begin.php",
                "punctuation.section.embedded.end.php"
            ],
            "settings": { "foreground": "#B479DB" }
        },
        {
            "scope": [
                "variable.other.object.property",
                "variable.other.property",
                "variable.other.constant.property"
            ],
            "settings": { "foreground": "#5d9bbd", "fontStyle": "" }
        },
        {
            "scope": [
                "storage.type.class",
                "storage.type.function",
                "comment.line",
                "storage.type.annotation"
            ],
            "settings": { "fontStyle": "italic" }
        },
        {
            "scope": "token.info-token",
            "settings": { "foreground": "#6796E6" }
        },
        {
            "scope": "token.warn-token",
            "settings": { "foreground": "#CD9731" }
        },
        {
            "scope": "token.error-token",
            "settings": { "foreground": "#F44747" }
        },
        {
            "scope": "token.debug-token",
            "settings": { "foreground": "#B267E6" }
        },
        {
            "scope": "markup.bold, markup.heading, punctuation.definition.heading",
            "settings": { "foreground": "#569cd6", "fontStyle": "bold" }
        },
        {
            "scope": "markup.inline.raw",
            "settings": { "foreground": "#ce9178" }
        },
        {
            "scope": "markup.underline.link",
            "settings": { "foreground": "#e6db74" }
        },
        {
            "scope": [
                "markup.deleted",
                "meta.diff.header.from-file",
                "punctuation.definition.deleted"
            ],
            "settings": { "foreground": "#FFA198" }
        },
        {
            "scope": [
                "markup.inserted",
                "meta.diff.header.to-file",
                "punctuation.definition.inserted"
            ],
            "settings": { "foreground": "#7EE787" }
        },
        {
            "scope": ["markup.changed", "punctuation.definition.changed"],
            "settings": { "foreground": "#FFA657" }
        },
        {
            "scope": ["markup.ignored", "markup.untracked"],
            "settings": { "foreground": "#161B22" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
