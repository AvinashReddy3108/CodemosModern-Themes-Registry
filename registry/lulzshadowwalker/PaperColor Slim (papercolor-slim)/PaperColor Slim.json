    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#808080" }
        },
        {
            "name": "Comment (SpecialComment / bold)",
            "scope": [
                "comment.block.documentation",
                "comment.line.double-slash keyword"
            ],
            "settings": { "foreground": "#808080", "fontStyle": "bold" }
        },
        {
            "name": "String",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#d7af5f" }
        },
        {
            "name": "Character",
            "scope": ["string.quoted.single", "constant.character"],
            "settings": { "foreground": "#d7af5f", "fontStyle": "bold" }
        },
        {
            "name": "String Escape / SpecialChar",
            "scope": [
                "constant.character.escape",
                "string.regexp",
                "string.regexp punctuation"
            ],
            "settings": { "foreground": "#d7af5f" }
        },
        {
            "name": "Number",
            "scope": [
                "constant.numeric",
                "constant.numeric.integer",
                "constant.numeric.float",
                "constant.numeric.hex",
                "constant.numeric.octal"
            ],
            "settings": { "foreground": "#ff5faf" }
        },
        {
            "name": "Boolean",
            "scope": [
                "constant.language.boolean",
                "constant.language.true",
                "constant.language.false"
            ],
            "settings": { "foreground": "#d7af00", "fontStyle": "bold" }
        },
        {
            "name": "Constant",
            "scope": [
                "constant.language",
                "constant.language.null",
                "constant.language.undefined",
                "constant.language.nan",
                "variable.language.this",
                "variable.language.self",
                "variable.language.super"
            ],
            "settings": { "foreground": "#d0d0d0", "fontStyle": "bold" }
        },
        {
            "name": "Constant Other",
            "scope": ["constant.other", "constant.other.color"],
            "settings": { "foreground": "#d0d0d0" }
        },
        {
            "name": "Keyword / Statement",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.other",
                "storage.type",
                "storage.modifier"
            ],
            "settings": { "foreground": "#afd700" }
        },
        {
            "name": "Keyword Return / Conditional",
            "scope": [
                "keyword.control.conditional",
                "keyword.control.if",
                "keyword.control.else",
                "keyword.control.switch",
                "keyword.control.case",
                "keyword.control.return",
                "keyword.control.break",
                "keyword.control.continue",
                "keyword.control.ternary"
            ],
            "settings": { "foreground": "#afd700" }
        },
        {
            "name": "Keyword Loop / Repeat",
            "scope": [
                "keyword.control.loop",
                "keyword.control.for",
                "keyword.control.while",
                "keyword.control.do",
                "keyword.control.in",
                "keyword.control.of"
            ],
            "settings": { "foreground": "#afd700" }
        },
        {
            "name": "Keyword Exception",
            "scope": [
                "keyword.control.exception",
                "keyword.control.try",
                "keyword.control.catch",
                "keyword.control.finally",
                "keyword.control.throw",
                "keyword.control.trycatch"
            ],
            "settings": { "foreground": "#afd700" }
        },
        {
            "name": "Keyword Import / Include / PreProc",
            "scope": [
                "keyword.control.import",
                "keyword.control.export",
                "keyword.control.from",
                "keyword.control.as",
                "keyword.control.module",
                "keyword.control.require",
                "meta.import keyword",
                "meta.export keyword"
            ],
            "settings": { "foreground": "#afd700" }
        },
        {
            "name": "Preprocessor / Define / PreCondit",
            "scope": [
                "keyword.control.directive",
                "keyword.control.pragma",
                "meta.preprocessor",
                "meta.preprocessor.string",
                "keyword.preprocessor"
            ],
            "settings": { "foreground": "#afd700" }
        },
        {
            "name": "PreCondit (conditional preprocessor)",
            "scope": [
                "keyword.control.directive.conditional",
                "keyword.control.directive.ifdef",
                "keyword.control.directive.ifndef",
                "keyword.control.directive.endif"
            ],
            "settings": { "foreground": "#5faf5f" }
        },
        {
            "name": "Operator",
            "scope": [
                "keyword.operator",
                "keyword.operator.arithmetic",
                "keyword.operator.assignment",
                "keyword.operator.comparison",
                "keyword.operator.logical",
                "keyword.operator.bitwise",
                "keyword.operator.relational",
                "keyword.operator.expression",
                "keyword.operator.new",
                "keyword.operator.delete",
                "keyword.operator.type",
                "keyword.operator.void",
                "keyword.operator.typeof",
                "keyword.operator.instanceof",
                "keyword.operator.in",
                "keyword.operator.of",
                "keyword.operator.spread",
                "keyword.operator.rest"
            ],
            "settings": { "foreground": "#00afaf", "fontStyle": "bold" }
        },
        {
            "name": "Delimiter / Punctuation",
            "scope": [
                "punctuation.separator",
                "punctuation.terminator",
                "punctuation.accessor",
                "punctuation.definition.template-expression"
            ],
            "settings": { "foreground": "#00afaf" }
        },
        {
            "name": "Label",
            "scope": ["entity.name.label", "punctuation.definition.label"],
            "settings": { "foreground": "#00afaf" }
        },
        {
            "name": "Macro",
            "scope": [
                "entity.name.function.macro",
                "entity.name.function.preprocessor",
                "meta.preprocessor entity.name"
            ],
            "settings": { "foreground": "#00afaf" }
        },
        {
            "name": "Function",
            "scope": [
                "entity.name.function",
                "meta.function-call entity.name.function",
                "variable.function",
                "support.function"
            ],
            "settings": { "foreground": "#5fafd7" }
        },
        {
            "name": "Function Call",
            "scope": ["meta.function-call", "meta.method-call"],
            "settings": { "foreground": "#5fafd7" }
        },
        {
            "name": "Identifier / Variable",
            "scope": [
                "variable",
                "variable.other",
                "variable.other.readwrite",
                "variable.other.object",
                "variable.other.property"
            ],
            "settings": { "foreground": "#d7875f" }
        },
        {
            "name": "Property / Member",
            "scope": [
                "variable.other.member",
                "variable.other.field",
                "meta.property-name",
                "support.type.property-name",
                "entity.other.attribute-name"
            ],
            "settings": { "foreground": "#d7875f" }
        },
        {
            "name": "Parameter",
            "scope": ["variable.parameter", "meta.function.parameter variable"],
            "settings": { "foreground": "#d0d0d0" }
        },
        {
            "name": "Type",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "entity.name.interface",
                "entity.name.struct",
                "entity.name.enum",
                "support.type",
                "support.class",
                "meta.type.annotation entity.name.type"
            ],
            "settings": { "foreground": "#af87d7" }
        },
        {
            "name": "Typedef / Type Alias",
            "scope": [
                "entity.name.type.alias",
                "meta.type.alias entity.name.type"
            ],
            "settings": { "foreground": "#af87d7" }
        },
        {
