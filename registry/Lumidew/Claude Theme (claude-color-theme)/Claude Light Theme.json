    "tokenColors": [
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#9CA3AF", "fontStyle": "italic" }
        },
        {
            "scope": [
                "keyword",
                "storage.type",
                "storage.modifier",
                "keyword.control",
                "keyword.operator.new",
                "keyword.operator.expression"
            ],
            "settings": { "foreground": "#D946EF" }
        },
        {
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call",
                "entity.name.method"
            ],
            "settings": { "foreground": "#3B82F6" }
        },
        {
            "scope": [
                "string",
                "string.quoted",
                "string.template",
                "constant.other.symbol"
            ],
            "settings": { "foreground": "#059669" }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.language",
                "constant.character",
                "support.constant"
            ],
            "settings": { "foreground": "#D97706" }
        },
        {
            "scope": ["variable", "meta.variable", "variable.other.object"],
            "settings": { "foreground": "#374151" }
        },
        {
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#374151", "fontStyle": "" }
        },
        {
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.type",
                "support.class"
            ],
            "settings": { "foreground": "#7C3AED" }
        },
        {
            "scope": [
                "keyword.operator",
                "punctuation",
                "meta.brace",
                "meta.delimiter"
            ],
            "settings": { "foreground": "#6B7280" }
        },
        {
            "scope": [
                "entity.name.tag",
                "meta.tag.sgml",
                "markup.deleted.git_gutter"
            ],
            "settings": { "foreground": "#D946EF" }
        },
        {
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#D97706" }
        },
        {
            "scope": ["markup.heading", "entity.name.section"],
            "settings": { "foreground": "#D97706", "fontStyle": "bold" }
        },
        {
            "scope": ["markup.bold", "punctuation.definition.bold"],
            "settings": { "fontStyle": "bold" }
        },
        {
            "scope": ["markup.italic", "punctuation.definition.italic"],
            "settings": { "fontStyle": "italic" }
        },
        {
            "scope": ["markup.code.inline"],
            "settings": { "foreground": "#D946EF", "background": "#F3F4F6" }
        },
        {
            "scope": ["markup.inserted"],
            "settings": { "foreground": "#059669" }
        },
        {
            "scope": ["markup.deleted"],
            "settings": { "foreground": "#DC2626" }
        },
        {
            "scope": ["markup.changed"],
            "settings": { "foreground": "#D97706" }
        },
        {
            "scope": ["support.type.property-name", "meta.property-name"],
            "settings": { "foreground": "#374151" }
        },
        {
            "scope": ["meta.object-literal.key", "support.type.property-name"],
            "settings": { "foreground": "#374151" }
        }
    ]
}
