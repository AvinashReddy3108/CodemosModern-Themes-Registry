    "semanticTokenColors": {
        "type": "#ffadeb",
        "method.defaultLibrary": { "underline": false, "italic": false },
        "keyword": "#bec7e3",
        "variable.language": "#C4C6CA"
    },
    "tokenColors": [
        {
            "scope": "support.type",
            "settings": { "foreground": "#ffadeb", "fontStyle": "" }
        },
        {
            "scope": "keyword.control",
            "settings": { "foreground": "#bec7e3", "fontStyle": "" }
        },
        {
            "scope": "storage.type.function",
            "settings": { "foreground": "#bec7e3", "fontStyle": "" }
        },
        {
            "name": "Override storage.type in jsdoc",
            "scope": "storage.type.class.jsdoc",
            "settings": { "foreground": "#a6cebe", "fontStyle": "" }
        },
        {
            "scope": "storage.type.interface",
            "settings": { "foreground": "#ffadeb", "fontStyle": "" }
        },
        {
            "scope": "storage.type.type",
            "settings": { "foreground": "#bec7e3", "fontStyle": "" }
        },
        {
            "scope": "storage.type",
            "settings": { "foreground": "#C4C6CA", "fontStyle": "" }
        },
        {
            "scope": "support.type.property-name",
            "settings": { "foreground": "#bec7e3", "fontStyle": "" }
        },
        {
            "name": "Override property-name for json",
            "scope": "support.type.property-name.json",
            "settings": { "foreground": "#f3f5fa", "fontStyle": "" }
        },
        {
            "name": "Override constant (boolean) for json",
            "scope": "constant.language.json",
            "settings": { "foreground": "#ff9a7b", "fontStyle": "" }
        },
        {
            "scope": "string",
            "settings": { "foreground": "#aee8a3", "fontStyle": "" }
        },
        {
            "name": "Number",
            "scope": "constant.numeric",
            "settings": { "foreground": "#ff9a7b", "fontStyle": "" }
        },
        {
            "name": "Null, Undefined",
            "scope": "constant.language.null, constant.language.undefined",
            "settings": { "foreground": "#ff9a7b", "fontStyle": "" }
        },
        {
            "scope": "constant.language.boolean",
            "settings": { "foreground": "#ff9a7b", "fontStyle": "" }
        },
        {
            "scope": "comment",
            "settings": { "foreground": "#a6cebe", "fontStyle": "" }
        },
        {
            "name": "React props, html attributes",
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#C4C6CA", "fontStyle": "" }
        },
        {
            "name": "this",
            "scope": "variable.language",
            "settings": { "foreground": "#C4C6CA", "fontStyle": "" }
        },
        {
            "name": "Markdown - heading hash, blockquote marker, bold, italic, list",
            "scope": "punctuation.definition.heading.markdown, punctuation.definition.quote.begin.markdown,  punctuation.definition.bold.markdown, punctuation.definition.italic.markdown, punctuation.definition.list.begin.markdown, punctuation.definition.markdown",
            "settings": { "foreground": "#C4C6CA", "fontStyle": "" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
