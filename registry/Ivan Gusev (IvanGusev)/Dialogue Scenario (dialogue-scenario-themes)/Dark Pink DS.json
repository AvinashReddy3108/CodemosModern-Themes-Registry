    "semanticHighlighting": true,
    "semanticTokenColors": {
        "newOperator": "#e8cfeb",
        "stringLiteral": "#e99a9a",
        "customLiteral": "#D4D4D4",
        "numberLiteral": "#c3b283"
    },
    "$schema": "vscode://schemas/color-theme"
