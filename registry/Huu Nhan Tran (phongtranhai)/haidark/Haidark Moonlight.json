    "tokenColors": [
        {
            "name": "Global settings",
            "settings": { "background": "#1B1D1E", "foreground": "#D4D1C8" }
        },
        {
            "name": "Comment",
            "scope": [
                "comment",
                "punctuation.definition.comment",
                "string.quoted.docstring"
            ],
            "settings": { "foreground": "#6B7268", "fontStyle": "italic" }
        },
        {
            "name": "Variables and Plain Text",
            "scope": [
                "variable",
                "support.variable",
                "string constant.other.placeholder",
                "text.html"
            ],
            "settings": { "foreground": "#D4D1C8" }
        },
        {
            "name": "DOM Variables, Math, JSON constants",
            "scope": [
                "support.variable.dom",
                "support.constant.math",
                "support.type.object.module",
                "support.variable.object.process",
                "support.constant.json"
            ],
            "settings": { "foreground": "#E5B868" }
        },
        {
            "name": "Nil / Undefined",
            "scope": ["constant.language.undefined", "constant.language.null"],
            "settings": { "foreground": "#8B8B80" }
        },
        {
            "name": "Colors",
            "scope": ["constant.other.color"],
            "settings": { "foreground": "#FFFFFF" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#E0516E" }
        },
        {
            "name": "Invalid deprecated",
            "scope": ["invalid.deprecated"],
            "settings": { "foreground": "#C8A0D0" }
        },
        {
            "name": "Keyword, Storage",
            "scope": [
                "keyword",
                "storage.type",
                "storage.modifier",
                "keyword.other.important"
            ],
            "settings": { "foreground": "#E0516E", "fontStyle": "italic" }
        },
        {
            "name": "Keyword Control, Storage",
            "scope": ["keyword.control", "storage"],
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "Interpolation",
            "scope": [
                "punctuation.definition.template-expression",
                "punctuation.section.embedded"
            ],
            "settings": { "foreground": "#5CC4B8" }
        },
        {
            "name": "Spread / Rest Operator",
            "scope": ["keyword.operator.spread", "keyword.operator.rest"],
            "settings": { "foreground": "#E0516E", "fontStyle": "bold" }
        },
        {
            "name": "Operator, Punctuation, Misc",
            "scope": [
                "keyword.operator",
                "keyword.control",
                "punctuation",
                "punctuation.definition.string",
                "punctuation.support.type.property-name",
                "text.html.vue-html meta.tag",
                "punctuation.definition.keyword",
                "punctuation.terminator.rule",
                "punctuation.definition.entity",
                "constant.other.color",
                "meta.tag",
                "punctuation.definition.tag",
                "punctuation.separator.inheritance.php",
                "punctuation.definition.block.tag",
                "punctuation.definition.tag.html",
                "punctuation.definition.tag.begin.html",
                "punctuation.definition.tag.end.html",
                "meta.property-list",
                "meta.brace.square",
                "keyword.other.template",
                "keyword.other.substitution",
                "string.other.begin.code",
                "string.other.end.code"
            ],
            "settings": { "foreground": "#5CC4B8", "fontStyle": "normal" }
        },
        {
            "name": "Dark Punctuation",
            "scope": ["punctuation.definition.template-expression"],
            "settings": { "foreground": "#E0516E" }
        },
        {
            "name": "Tag",
            "scope": [
                "entity.name.tag",
                "meta.tag",
                "markup.deleted.git_gutter"
            ],
            "settings": { "foreground": "#E0516E" }
        },
        {
            "name": "Function, Special Method",
            "scope": [
                "entity.name.function",
                "variable.function",
                "keyword.other.special-method",
                "meta.function-call.generic"
            ],
            "settings": { "foreground": "#7DA5D8" }
        },
        {
            "name": "Support Function",
            "scope": [
                "support.function",
                "meta.function-call entity.name.function"
            ],
            "settings": { "foreground": "#5CC4B8" }
        },
        {
            "name": "Other Variable, String Link",
            "scope": ["support.other.variable", "string.other.link"],
            "settings": { "foreground": "#E0516E" }
        },
        {
            "name": "Constant, Function Argument, Tag Attribute, Embedded",
            "scope": [
                "variable.other.constant",
                "constant.language",
                "keyword.other.type.php",
                "storage.type.php",
                "support.constant",
                "constant.character",
                "constant.escape",
                "keyword.other.unit"
            ],
            "settings": { "foreground": "#F09070" }
        },
        {
            "name": "Number, Boolean",
            "scope": [
                "constant.numeric",
                "constant.language.boolean",
                "constant.language.json",
                "constant.language.infinity",
                "constant.language.nan"
            ],
            "settings": { "foreground": "#F09070" }
        },
        {
            "name": "Function Argument",
            "scope": [
                "variable.parameter.function.language.special",
                "variable.parameter",
                "meta.function.parameter variable"
            ],
            "settings": { "foreground": "#F0B8C8" }
        },
        {
            "name": "String, Symbols, Inherited Class, Markup Heading",
            "scope": [
                "string",
                "constant.other.symbol",
                "constant.other.key",
                "entity.other.inherited-class",
                "markup.heading",
                "markup.inserted.git_gutter",
                "meta.group.braces.curly constant.other.object.key.js string.unquoted.label.js",
                "meta.attribute-selector",
                "markup.inline.raw.code"
            ],
            "settings": { "foreground": "#A8C77B" }
        },
        {
            "name": "Object",
            "scope": ["variable.other.object"],
            "settings": { "foreground": "#E5B868" }
        },
        {
            "name": "Object Key",
            "scope": [
                "meta.object-literal.key",
                "string.alias.graphql",
                "string.unquoted.graphql",
                "string.unquoted.alias.graphql",
                "meta.field.declaration.ts variable.object.property",
                "variable.object.property"
            ],
            "settings": { "foreground": "#5CC4B8" }
        },
        {
            "name": "Nested Object Property",
            "scope": ["meta.object.member", "variable.other.object.property"],
            "settings": { "foreground": "#C5C0B5" }
        },
        {
            "name": "Object Property",
            "scope": [
                "variable.other.property",
                "support.variable.property",
                "support.variable.property.dom"
            ],
            "settings": { "foreground": "#C5C0B5" }
        },
        {
            "name": "Lambda Arrow",
            "scope": ["storage.type.function"],
            "settings": { "foreground": "#E0516E" }
        },
        {
            "name": "Class, Support, Entity Name",
            "scope": [
                "entity.name",
                "support.type",
                "support.class",
                "support.orther.namespace.use.php",
                "meta.use.php",
                "support.other.namespace.php",
                "markup.changed.git_gutter",
                "support.type.sys-types"
            ],
            "settings": { "foreground": "#E5B868" }
        },
        {
            "name": "Entity types",
            "scope": ["support.type"],
            "settings": { "foreground": "#F09070" }
        },
        {
            "name": "CSS Class and Support",
            "scope": [
                "source.css support.type.property-name",
                "source.sass support.type.property-name",
                "source.scss support.type.property-name",
                "source.less support.type.property-name",
                "source.stylus support.type.property-name",
                "source.postcss support.type.property-name",
                "support.type.property-name.css",
                "support.type.vendored.property-name"
            ],
            "settings": { "foreground": "#7DA5D8" }
        },
        {
            "name": "Sub-methods",
            "scope": [
                "entity.name.module.js",
                "variable.import.parameter.js",
                "variable.other.class.js"
            ],
            "settings": { "foreground": "#E0516E" }
        },
        {
            "name": "Language methods",
            "scope": ["variable.language"],
            "settings": { "foreground": "#E0516E", "fontStyle": "italic" }
        },
        {
            "name": "entity.name.method.js",
            "scope": ["entity.name.method.js"],
            "settings": { "foreground": "#7DA5D8", "fontStyle": "italic" }
        },
        {
            "name": "meta.method.js",
            "scope": [
                "meta.class-method.js entity.name.function.js",
                "variable.function.constructor"
            ],
            "settings": { "foreground": "#7DA5D8" }
        },
        {
            "name": "Attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#E5B868", "fontStyle": "italic" }
        },
        {
            "name": "HTML Attributes",
            "scope": [
                "text.html.basic entity.other.attribute-name.html",
                "text.html.basic entity.other.attribute-name"
            ],
            "settings": { "foreground": "#E5B868" }
        },
        {
            "name": "HTML Doctype",
            "scope": [
                "meta.tag.metadata.doctype entity.name.tag",
