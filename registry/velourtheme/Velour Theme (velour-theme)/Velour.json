{
    "name": "Velour",
    "type": "dark",
    "colors": {
        "activityBar.background": "#282746",
        "activityBar.foreground": "#eef",
        "activityBarBadge.background": "#525252",
        "activityBarBadge.foreground": "#f9e6ff",
        "badge.background": "#2e2e2e",
        "badge.foreground": "#e6ceeb",
        "focusBorder": "#89888a",
        "button.background": "#211b24",
        "button.foreground": "#eef",
        "button.hoverBackground": "#382b3d",
        "debugToolBar.background": "#393952",
        "diffEditor.insertedTextBackground": "#2BDF2B1C",
        "diffEditor.insertedTextBorder": "#2BDF2B3F",
        "diffEditor.removedTextBackground": "#FD0E1A1C",
        "diffEditor.removedTextBorder": "#FD0E1A3F",
        "dropdown.background": "#333352",
        "editor.background": "#16162B",
        "editor.foreground": "#eef",
        "editor.lineHighlightBackground": "#636f8f88",
        "editor.findMatchBackground": "#c300ff88",
        "editor.inactiveSelectionBackground": "#9875b8c0",
        "editor.selectionBackground": "#4c5e7980",
        "editor.selectionHighlightBackground": "#575b6152",
        "editor.wordHighlightBackground": "#0099ff80",
        "editor.wordHighlightStrongBackground": "#0099ff80",
        "editorCursor.foreground": "#bccfff",
        "editorGroupHeader.tabsBackground": "#333352",
        "editorIndentGuide.activeBackground": "#7f7f7f",
        "editorIndentGuide.background": "#505050",
        "editorLineNumber.activeForeground": "#6f6f6f",
        "editorWhitespace.foreground": "#505050",
        "editorWidget.background": "#1f1e43",
        "editorError.foreground": "#f56f6da1",
        "editorWarning.foreground": "#fde468a1",
        "inputOption.activeBorder": "#888a8a",
        "input.background": "#393952",
        "input.foreground": "#eef",
        "input.placeholderForeground": "#bbb",
        "list.activeSelectionBackground": "#877a8880",
        "list.focusBackground": "#2f2f43",
        "list.highlightForeground": "#a9a9a9",
        "list.hoverBackground": "#3e3e5e",
        "list.inactiveSelectionBackground": "#393952",
        "notifications.background": "#393952",
        "panelTitle.activeForeground": "#ffffff",
        "peekView.border": "#3655b5",
        "pickerGroup.foreground": "#636f8fbd",
        "sideBar.background": "#1f1e43",
        "sideBarSectionHeader.background": "#393952",
        "statusBar.background": "#403644",
        "statusBar.debuggingBackground": "#505050",
        "statusBar.noFolderBackground": "#505050",
        "tab.border": "#222",
        "tab.activeForeground": "#FFFFFF",
        "tab.activeBorder": "#A5A0DA",
        "tab.inactiveBackground": "#393952",
        "tab.inactiveForeground": "#FDF",
        "terminal.ansiWhite": "#FFF",
        "titleBar.activeBackground": "#505050",
        "textLink.activeForeground": "#ddd",
        "textLink.foreground": "#8796a7"
    },
    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#999999" }
        },
        {
            "name": "Entity",
            "scope": "entity",
            "settings": { "foreground": "#FFE51D" }
        },
        {
            "name": "Constant",
            "scope": "constant",
            "settings": { "foreground": "#0089D8" }
        },
        {
            "name": "Keyword",
            "scope": "keyword",
            "settings": { "foreground": "#FF8400" }
        },
        {
            "name": "Meta ",
            "scope": "meta",
            "settings": { "foreground": "#A7EAFA" }
        },
        {
            "name": "Meta Brace",
            "scope": [
                "meta.brace",
                "punctuation.definition.parameters.begin.js",
                "punctuation.definition.parameters.end.js"
            ],
            "settings": { "foreground": "#C1D0DE" }
        },
        {
            "name": "Punctuation",
            "scope": "punctuation",
            "settings": { "foreground": "#C1D0DE" }
        },
        {
            "name": "Punctuation — Parameters",
            "scope": "punctuation.definition.parameters",
            "settings": { "foreground": "#F3D476" }
        },
        {
            "name": "Punctuation — Template Expression",
            "scope": "punctuation.definition.template-expression",
            "settings": { "foreground": "#F3D476" }
        },
        {
            "name": "Storage",
            "scope": "storage",
            "settings": { "foreground": "#FFE51D" }
        },
        {
            "name": "Storage — Arrow Function",
            "scope": "storage.type.function.arrow",
            "settings": { "foreground": "#FFE51D" }
        },
        {
            "name": "String",
            "scope": ["string", "punctuation.definition.string"],
            "settings": { "foreground": "#F3D476" }
        },
        {
            "name": "String Template Color",
            "scope": [
                "string.template",
                "string.quoted.template.js",
                "punctuation.definition.string.template"
            ],
            "settings": { "foreground": "#7EB77D" }
        },
        {
            "name": "Support",
            "scope": "support",
            "settings": { "foreground": "#B1FFC5" }
        },
        {
            "name": "This",
            "scope": [
                "variable.language.this.js",
                "variable.language.this.ts",
                "variable.language.this.jsx",
                "variable.language.this.tsx"
            ],
            "settings": { "foreground": "#E15B64" }
        },
        {
            "name": "Support - Function Colors",
            "scope": "support.function",
            "settings": { "foreground": "#FF8400" }
        },
        {
            "name": "Support - Variable Property DOM Colors",
            "scope": "support.variable.property.dom",
            "settings": { "foreground": "#A7EAFA" }
        },
        {
            "name": "Variable",
            "scope": "variable",
            "settings": { "foreground": "#C1D0DE" }
        },
        {
            "name": "CSS - Entity",
            "scope": "source.css entity",
            "settings": { "foreground": "#FFABAB" }
        },
        {
            "name": "CSS - Class Selector",
            "scope": "entity.other.attribute-name.class.css",
            "settings": { "foreground": "#0089D8" }
        },
        {
            "name": "CSS - ID Selector",
            "scope": [
                "entity.other.attribute-name.id.css",
                "entity.other.attribute-name.pseudo-class.css"
            ],
            "settings": { "foreground": "#A5A0DA" }
        },
        {
            "name": "CSS - Color for Element Selector",
            "scope": "entity.name.tag.css",
            "settings": { "foreground": "#03C8FA" }
        },
        {
            "name": "CSS - Numeric",
            "scope": "constant.numeric.css",
            "settings": { "foreground": "#FF8400" }
        },
        {
            "name": "CSS - Units",
            "scope": [
                "keyword.other.unit.mm.css",
                "keyword.other.unit.cm.css",
                "keyword.other.unit.in.css",
                "keyword.other.unit.pt.css",
                "keyword.other.unit.px.css",
                "keyword.other.unit.pc.css",
                "keyword.other.unit.ex.css",
                "keyword.other.unit.em.css",
                "keyword.other.unit.rem.css",
                "keyword.other.unit.percentage.css",
                "keyword.other.unit.vh.css",
                "keyword.other.unit.vw.css",
                "keyword.other.unit.vmin.css",
                "keyword.other.unit.vmax.css",
                "keyword.other.unit.ch.css"
            ],
            "settings": { "foreground": "#F9E6EF" }
        },
        {
            "name": "CSS - Support",
            "scope": "source.css support",
            "settings": { "foreground": "#FFFFFF" }
        },
        {
            "name": "CSS - Constant",
            "scope": ["source.css constant", "source.css support.constant"],
            "settings": { "foreground": "#F0C7FD" }
        },
        {
            "name": "CSS - String",
            "scope": [
                "source.css string",
                "source.css punctuation.definition.string"
            ],
            "settings": { "foreground": "#FFE51D" }
        },
        {
            "name": "CSS - Variable",
            "scope": "source.css variable",
            "settings": { "foreground": "#FAA839" }
        },
        {
            "name": "CSS/Sass - Misc Keywords",
            "scope": [
                "keyword.other.important.css",
                "keyword.other.important.scss",
                "keyword.control.at-rule.keyframes.css",
                "keyword.control.at-rule.keyframes.scss",
                "keyword.control.at-rule.media.css",
                "keyword.control.at-rule.media.scss"
            ],
            "settings": { "foreground": "#7EB77D" }
        },
        {
            "name": "Sass - Control",
            "scope": [
                "keyword.control.if.scss",
                "keyword.control.for.scss",
                "keyword.control.while.scss"
            ],
            "settings": { "foreground": "#A7EAFA" }
        },
        {
            "name": "Sass - Support Function",
            "scope": "support.function.misc.scss",
            "settings": { "foreground": "#866DD3" }
        },
        {
            "name": "Sass - Meta Definition Variable",
            "scope": "meta.definition.variable.scss",
            "settings": { "foreground": "#7EB77D" }
        },
        {
            "name": "HTML - Doctype",
            "scope": "meta.tag.sgml.doctype.html",
            "settings": { "foreground": "#0089D8" }
        },
        {
            "name": "HTML - Misc",
            "scope": [
                "punctuation.definition.tag.begin.html",
                "punctuation.definition.tag.end.html",
                "punctuation.definition.tag.html",
                "meta.scope.between-tag-pair.html",
                "punctuation.definition.tag.html",
                "meta.tag.structure.any.html",
                "punctuation.definition.string.begin",
                "punctuation.definition.string.end",
                "meta.tag.inline.any.html",
                "meta.tag.other"
            ],
            "settings": { "foreground": "#FFFFFF" }
        },
        {
            "name": "HTML - Attribute",
            "scope": [
                "text.html.basic entity.other",
                "entity.other.attribute-name.html"
            ],
            "settings": { "foreground": "#FFABAB" }
        },
        {
            "name": "HTML - ID value",
            "scope": "meta.toc-list.id.html",
            "settings": { "foreground": "#03C8FA" }
        },
        {
            "name": "HTML - Quote",
            "scope": "string.quoted.double.html",
            "settings": { "foreground": "#F3D476" }
        },
        {
            "name": "HTML - Entity Other",
            "scope": "text.html.basic entity.other",
            "settings": { "foreground": "#FFE51D" }
        },
        {
            "name": "HTML - Script Tag",
            "scope": "meta.tag.metadata.script.html",
            "settings": { "foreground": "#F9E6FF" }
        },
        {
            "name": "HTML -  Tag",
            "scope": "entity.name.tag.html",
            "settings": { "foreground": "#F0C7FD" }
        },
        {
            "name": "JSON - Support",
            "scope": "source.json support",
            "settings": { "foreground": "#B1FFC5" }
        },
        {
            "name": "JSON - String",
            "scope": [
                "source.json string",
                "source.json punctuation.definition.string"
            ],
            "settings": { "foreground": "#A5A0DA" }
        },
        {
            "name": "JS - Entity Name Function",
            "scope": [
                "entity.name.function.js",
                "entity.name.function.ts",
                "entity.name.function.jsx",
                "entity.name.function.tsx"
            ],
            "settings": { "foreground": "#FAA839" }
        },
        {
            "name": "JS - Storage Type Function",
            "scope": [
                "storage.type.function.js",
                "storage.type.function.ts",
                "storage.type.function.jsx",
                "storage.type.function.tsx"
            ],
            "settings": { "foreground": "#7EB77D" }
        },
        {
            "name": "JS - Entity Name Class",
            "scope": [
                "entity.name.class.js",
                "entity.name.class.ts",
                "entity.name.class.jsx",
                "entity.name.class.tsx"
            ],
            "settings": { "foreground": "#F0C7FD" }
        },
        {
            "name": "JS — Control Flow",
            "scope": [
                "keyword.control.flow.js",
                "keyword.control.flow.ts",
                "keyword.control.flow.jsx",
                "keyword.control.flow.tsx"
            ],
            "settings": { "foreground": "#866DD3" }
        },
        {
            "name": "JS — Control Loop",
            "scope": [
                "keyword.control.loop.js",
                "keyword.control.loop.ts",
                "keyword.control.loop.jsx",
                "keyword.control.loop.tsx"
            ],
            "settings": { "foreground": "#F3D476" }
        },
        {
            "name": "JS — Operator",
            "scope": ["keyword.operator", "keyword.operator.assignment"],
            "settings": { "foreground": "#FFFFFF" }
        },
        {
            "name": "JS — Support",
            "scope": "support.class.builtin.js",
            "settings": { "foreground": "#BEE9AC" }
        },
        {
            "name": "JS — Module",
            "scope": [
                "keyword.control.module.js",
                "keyword.control.import.tsx"
            ],
            "settings": { "foreground": "#03C8FA", "fontStyle": "italic" }
        },
        {
            "name": "JS — Storage Type",
            "scope": [
                "storage.type.js",
                "storage.type.ts",
                "storage.type.jsx",
                "storage.type.tsx"
            ],
            "settings": { "foreground": "#03C8FA", "fontStyle": "italic" }
        },
        {
            "name": "JS — String Unquoted",
            "scope": [
                "string.unquoted.js",
                "string.unquoted.ts",
                "string.unquoted.jsx",
                "string.unquoted.tsx"
            ],
            "settings": { "foreground": "#7EB77D", "fontStyle": "italic" }
        },
        {
            "name": "JS — Storage R/W",
            "scope": [
                "variable.other.readwrite.js",
                "variable.other.readwrite.ts",
                "variable.other.readwrite.jsx",
                "variable.other.readwrite.tsx",
                "variable.other.readwrite.alias.tsx"
            ],
            "settings": { "foreground": "#F0C7FD" }
        },
        {
            "name": "JS — Property",
            "scope": [
                "variable.other.property.js",
                "variable.other.property.ts",
                "variable.other.property.jsx",
                "variable.other.property.tsx",
                "variable.other.object.property.tsx"
            ],
            "settings": { "foreground": "#CDF2E0" }
        },
        {
            "name": "JS - Assignment Operator",
            "scope": [
                "keyword.operator.assignment.js",
                "keyword.operator.assignment.ts",
                "keyword.operator.assignment.jsx",
                "keyword.operator.assignment.tsx"
            ],
            "settings": { "foreground": "#FFFFFF" }
        },
        {
            "name": "JSX/TSX - Meta Tag",
            "scope": ["meta.tag.jsx", "meta.tag.tsx"],
            "settings": { "foreground": "#FFFFFF" }
        },
        {
            "name": "JSX/TSX - Tags",
            "scope": [
                "entity.name.tag.jsx",
                "entity.name.tag.tsx",
                "support.class.component.open.jsx",
                "support.class.component.close.jsx",
                "support.class.component.open.tsx",
                "support.class.component.close.tsx",
                "support.class.component.tsx",
                "entity.name.tag.open.jsx",
                "entity.name.tag.close.jsx",
                "entity.name.tag.open.tsx",
                "entity.name.tag.close.tsx"
            ],
            "settings": { "foreground": "#F0C7FD" }
        },
        {
            "name": "JSX/TSX - className",
            "scope": [
                "entity.other.attribute-name.jsx",
                "entity.other.attribute-name.tsx"
            ],
            "settings": { "foreground": "#FFABAB" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
