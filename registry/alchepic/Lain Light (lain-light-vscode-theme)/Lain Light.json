            "scope": ["markup.bold"],
            "settings": { "foreground": "#CC7A00", "fontStyle": "bold" }
        },
        {
            "name": "Markup Changed",
            "scope": ["markup.changed"],
            "settings": { "foreground": "#A626A4" }
