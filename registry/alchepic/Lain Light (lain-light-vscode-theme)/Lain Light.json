            "scope": ["markup.deleted"],
            "settings": { "foreground": "#B366FF" }
        },
        {
            "name": "Markup Italic",
            "scope": ["markup.italic"],
            "settings": { "foreground": "#A626A4", "fontStyle": "italic" }
        },
        {
            "name": "Markup Heading",
            "scope": ["markup.heading"],
            "settings": { "foreground": "#B366FF" }
