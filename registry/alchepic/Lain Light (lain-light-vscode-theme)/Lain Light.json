            "scope": ["meta.selector"],
            "settings": { "foreground": "#A626A4" }
        },
        {
            "name": "Meta Separator",
            "scope": ["meta.separator"],
            "settings": { "foreground": "#3d3b4f" }
        },
        {
            "name": "Meta Tag",
            "scope": ["meta.tag"],
            "settings": { "foreground": "#3d3b4f" }
        },
        {
