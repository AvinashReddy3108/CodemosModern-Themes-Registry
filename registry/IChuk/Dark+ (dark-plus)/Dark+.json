{
    "name": "Dark+",
    "type": "dark",
    "colors": {
        "editor.background": "#000000",
        "editor.foreground": "#d4e8ff",
        "activityBarBadge.background": "#1f1f1f",
        "sideBarTitle.foreground": "#96fff3",
        "sideBar.background": "#1f1f1f",
        "sideBar.foreground": "#96fff3",
        "editorLineNumber.foreground": "#d2a5d6",
        "editorCursor.foreground": "#c0d6f0",
        "editor.selectionBackground": "#77438b",
        "statusBar.background": "#7d7d7d",
        "statusBar.foreground": "#212121"
    },
    "tokenColors": [
        {
            "name": "JSON Key",
            "scope": ["meta.object.key.json", "meta.array.key.json"],
            "settings": { "foreground": "#C678DD" }
        },
        {
            "name": "JSON Value",
            "scope": [
                "meta.object.value.json",
                "meta.array.value.json",
                "string.quoted.double.json",
                "constant.numeric.json",
                "constant.language.json",
                "constant.language.null.json"
            ],
            "settings": { "foreground": "#E06C75" }
        },
        {
            "name": "Comment",
            "scope": "comment",
            "settings": { "foreground": "#6A9955", "fontStyle": "italic" }
        },
        {
            "name": "Keyword",
            "scope": "keyword",
            "settings": { "foreground": "#C678DD" }
        },
        {
            "name": "String",
            "scope": "string",
            "settings": { "foreground": "#E06C75" }
        },
        {
            "name": "Function",
            "scope": "entity.name.function",
            "settings": { "foreground": "#61AFEF" }
        },
        {
            "name": "Variable",
            "scope": "variable",
            "settings": { "foreground": "#D19A66" }
        },
        {
            "name": "Class",
            "scope": "entity.name.class",
            "settings": { "foreground": "#E5C07B" }
        },
        {
            "name": "Method",
            "scope": "entity.name.method",
            "settings": { "foreground": "#61AFEF" }
        },
        {
            "name": "Property",
            "scope": "variable.other",
            "settings": { "foreground": "#D19A66" }
        },
        {
            "name": "Constant",
            "scope": "constant",
            "settings": { "foreground": "#D19A66" }
        },
        {
            "name": "Number",
            "scope": "constant.numeric",
            "settings": { "foreground": "#D19A66" }
        },
        {
            "name": "Boolean",
            "scope": "constant.language",
            "settings": { "foreground": "#56B6C2" }
        },
        {
            "name": "Null",
            "scope": "constant.language.null",
            "settings": { "foreground": "#E5C07B" }
        },
        {
            "name": "Operator",
            "scope": "keyword.operator",
            "settings": { "foreground": "#C678DD" }
        },
        {
            "name": "Type",
            "scope": "entity.name.type",
            "settings": { "foreground": "#D19A66" }
        },
        {
            "name": "Namespace",
            "scope": "entity.name.namespace",
            "settings": { "foreground": "#61AFEF" }
        },
        {
            "name": "Attribute",
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#D19A66" }
        },
        {
            "name": "Tag",
            "scope": "entity.name.tag",
            "settings": { "foreground": "#E06C75" }
        },
        {
            "name": "Decorator",
            "scope": "meta.decorator",
            "settings": { "foreground": "#C678DD" }
        },
        {
            "name": "Import",
            "scope": "meta.import",
            "settings": { "foreground": "#61AFEF" }
        },
        {
            "name": "Function Call",
            "scope": "meta.function-call",
            "settings": { "foreground": "#61AFEF" }
        },
        {
            "name": "Parameter",
            "scope": "variable.parameter",
            "settings": { "foreground": "#D19A66" }
        },
        {
            "name": "Interpolation",
            "scope": "interpolation",
            "settings": { "foreground": "#D19A66" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
