        "menu.selectionForeground": "#08DADA",
        "menu.separatorBackground": "#08DADA",
        "menubar.selectionBackground": "#721B1B",
        "menubar.selectionBorder": "#FF000050",
        "menubar.selectionForeground": "#08DADA",
        "minimap.background": "#000000",
