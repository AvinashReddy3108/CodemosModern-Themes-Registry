        "gitDecoration.deletedResourceForeground": "#FF3571",
        "gitDecoration.ignoredResourceForeground": "#FF0000",
        "gitDecoration.modifiedResourceForeground": "#FFB972",
        "gitDecoration.untrackedResourceForeground": "#51AEFF",
        "input.background": "#721B1B",
        "input.border": "#16FFF110",
