{
    "explorer.confirmDelete": false,
    "editor.fontSize": 14,
    "editor.fontLigatures": false,
    "terminal.integrated.fontSize": 14,
    "git.enableSmartCommit": true,
    "code-runner.clearPreviousOutput": true,
    "code-runner.showExecutionMessage": false,
    "editor.tokenColorCustomizations": {
        "[Default Dark+]": {
            "functions": "#ceb735",
            "keywords": "#9a7adf",
            "types": "#24d4b1",
            "strings": "#e78651",
            "variables": "#5daed5",
            "numbers": "#96e5a8",
            "textMateRules": [
                {
                    "scope": "",
                    "settings": { "foreground": "#ff0000", "fontStyle": "" }
                },
                {
                    "scope": "keyword.operator",
                    "settings": { "foreground": "#d2c057", "fontStyle": "" }
                },
                {
                    "scope": "keyword.operator.new",
                    "settings": { "foreground": "#9a7fd5", "fontStyle": "" }
                },
                {
                    "scope": "storage.modifier",
                    "settings": { "foreground": "#9a7adf", "fontStyle": "" }
                },
                {
                    "scope": "support.class",
                    "settings": { "foreground": "#dbdbdb", "fontStyle": "" }
                },
                {
                    "scope": "variable.parameter",
                    "settings": { "foreground": "#5daed5", "fontStyle": "" }
                },
                {
                    "scope": "keyword.other.using",
                    "settings": { "foreground": "#c97ec2", "fontStyle": "" }
                },
                {
                    "scope": "storage.type.new",
                    "settings": { "foreground": "#d55dad", "fontStyle": "" }
                },
                {
                    "scope": "support.class",
                    "settings": { "foreground": "#37daa4", "fontStyle": "" }
                },
                {
                    "scope": "variable.other.readwrite.alias.js",
                    "settings": { "foreground": "#37daa4", "fontStyle": "" }
                }
            ]
        }
    },
    "workbench.colorCustomizations": {
        "[Default Dark+]": { "editor.background": "#242424" }
    },
    "explorer.confirmDragAndDrop": false,
    "git.confirmSync": false,
    "gitlens.currentLine.enabled": false,
    "gitlens.hovers.currentLine.over": "line",
    "gitlens.codeLens.enabled": false,
    "editor.codeLens": false,
    "javascript.updateImportsOnFileMove.enabled": "always",
    "[javascript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
    "[html]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
    "cshap2plantuml.allInOne": true,
    "workbench.editorAssociations": { "*.ipynb": "jupyter-notebook" },
    "editor.formatOnType": true,
    "go.toolsManagement.autoUpdate": true,
    "editor.suggestSelection": "first",
    "vsintellicode.modify.editor.suggestSelection": "automaticallyOverrodeDefaultValue",
    "files.exclude": {
        "**/.classpath": true,
        "**/.project": true,
        "**/.settings": true,
        "**/.factorypath": true
    },
    "rust-client.rustupPath": "%USERPROFILE%/.cargo/bin/",
    "editor.renderWhitespace": "none",
    "mdb.confirmRunAll": false,
    "[json]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
    "prettier.tabWidth": 4,
    "prettier.jsxBracketSameLine": true,
    "prettier.useTabs": true,
    "prettier.embeddedLanguageFormatting": "off",
    "prettier.printWidth": 200,
    "thunder-client.codeSnippetLanguage": "cs-httpclient",
    "gitlens.codeLens.authors.enabled": false,
    "gitlens.codeLens.recentChange.enabled": false,
    "gitlens.hovers.annotations.changes": false,
    "gitlens.hovers.annotations.enabled": false,
    "redhat.telemetry.enabled": false,
    "java.jdt.ls.vmargs": "-XX:+UseParallelGC -XX:GCTimeRatio=4 -XX:AdaptiveSizePolicyWeight=90 -Dsun.zip.disableMemoryMapping=true -Xmx1G -Xms100m -javaagent:\"c:\\Users\\BRUNO\\.vscode\\extensions\\gabrielbb.vscode-lombok-1.0.1\\server\\lombok.jar\"",
    "files.autoSave": "afterDelay",
    "umlet.theme": "Light theme",
    "editor.inlayHints.enabled": "off",
    "window.zoomLevel": 1,
    "$schema": "vscode://schemas/color-theme"
}
