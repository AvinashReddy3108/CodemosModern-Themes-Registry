    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "fontStyle": "italic", "foreground": "#627694" }
        },
        {
            "name": "Variables and Parameters",
            "scope": [
                "variable",
                "string constant.other.placeholder",
                "entity.name.variable",
                "variable.parameter",
                "variable.other.constant"
            ],
            "settings": { "foreground": "#D8E0FB" }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator",
                "keyword.other.special-method",
                "keyword.other.unit",
                "storage.type.function",
                "storage.type.class",
                "storage.type"
            ],
            "settings": { "foreground": "#56C2EA" }
        },
        {
            "name": "Operators",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#56C2EA" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation.definition.string",
                "punctuation.definition.variable",
                "punctuation.definition.parameters",
                "punctuation.definition.array",
                "punctuation.section",
                "meta.brace"
            ],
            "settings": { "foreground": "#D8E0FB" }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "meta.function-call",
                "variable.function",
                "support.function",
                "keyword.other.special-method"
            ],
            "settings": { "foreground": "#C4A7FF" }
        },
        {
            "name": "Classes",
            "scope": [
                "entity.name.type",
                "entity.other.inherited-class",
                "support.class",
                "entity.name.class"
            ],
            "settings": { "foreground": "#FFCC66" }
        },
        {
            "name": "Strings",
            "scope": ["string", "punctuation.definition.string"],
            "settings": { "foreground": "#7DE3B3" }
        },
        {
            "name": "Constants",
            "scope": [
                "constant.language",
                "support.constant",
                "constant.character",
                "constant.escape"
            ],
            "settings": { "foreground": "#FFCC66" }
        },
        {
            "name": "Numbers",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#FFCC66" }
        },
        {
            "name": "Boolean",
            "scope": ["constant.language.boolean"],
            "settings": { "foreground": "#FFCC66" }
        },
        {
            "name": "Entity Types",
            "scope": [
                "support.type",
                "support.class",
                "support.other.namespace.use.php",
                "meta.use.php",
                "support.other.namespace.php",
                "markup.raw.textblock.documentation.php",
                "storage.type.php"
            ],
            "settings": { "foreground": "#FFCC66" }
        },
        {
            "name": "Entity Names",
            "scope": ["entity.name", "meta.entity"],
            "settings": { "foreground": "#FFCC66" }
        },
        {
            "name": "Tag Names",
            "scope": [
                "entity.name.tag",
                "meta.tag.sgml",
                "markup.deleted.git_gutter"
            ],
            "settings": { "foreground": "#56C2EA" }
        },
        {
            "name": "Tag Attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#C4A7FF" }
        },
        {
            "name": "Language methods",
            "scope": ["variable.language"],
            "settings": { "fontStyle": "italic", "foreground": "#56C2EA" }
        },
        {
            "name": "Markup - Heading",
            "scope": [
                "markup.heading",
                "markup.heading entity.name",
                "markup.heading.markdown punctuation.definition.heading.markdown"
            ],
            "settings": { "foreground": "#56C2EA", "fontStyle": "bold" }
        },
        {
            "name": "Markup - Italic",
            "scope": [
                "markup.italic",
                "markup.italic punctuation.definition.italic.markdown"
            ],
            "settings": { "fontStyle": "italic", "foreground": "#D8E0FB" }
        },
        {
            "name": "Markup - Bold",
            "scope": [
                "markup.bold",
                "markup.bold punctuation.definition.bold.markdown"
            ],
            "settings": { "fontStyle": "bold", "foreground": "#D8E0FB" }
        },
        {
            "name": "Markup - Link",
            "scope": ["markup.underline.link"],
            "settings": { "foreground": "#56C2EA" }
        },
        {
            "name": "Markup - Code",
            "scope": ["markup.inline.raw", "markup.raw.block"],
            "settings": { "foreground": "#7DE3B3" }
        },
        {
            "name": "Markup - Quote",
            "scope": ["markup.quote"],
            "settings": { "foreground": "#7DE3B3", "fontStyle": "italic" }
        },
        {
            "name": "Markup - List",
            "scope": ["markup.list punctuation.definition.list"],
            "settings": { "foreground": "#56C2EA" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#F97583" }
        },
        {
            "name": "Deprecated",
            "scope": ["invalid.deprecated"],
            "settings": {
                "foreground": "#F97583",
                "fontStyle": "strikethrough"
            }
        }
    ],
    "semanticTokenColors": {
        "namespace": "#FFCC66",
        "type": "#FFCC66",
        "class": "#FFCC66",
        "enum": "#FFCC66",
        "interface": "#FFCC66",
        "struct": "#FFCC66",
        "typeParameter": "#FFCC66",
        "parameter": "#D8E0FB",
        "variable": "#D8E0FB",
        "property": "#D8E0FB",
        "enumMember": "#FFCC66",
        "event": "#C4A7FF",
        "function": "#C4A7FF",
        "method": "#C4A7FF",
        "macro": "#56C2EA",
        "keyword": "#56C2EA",
        "modifier": "#56C2EA",
        "comment": "#627694",
        "string": "#7DE3B3",
        "number": "#FFCC66",
        "regexp": "#7DE3B3",
        "operator": "#56C2EA",
        "decorator": "#C4A7FF"
    },
    "$schema": "vscode://schemas/color-theme"
}
