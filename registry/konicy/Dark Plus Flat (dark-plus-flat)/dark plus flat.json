{
    "name": "dark plus flat",
    "type": "dark",
    "include": "./dark_plus.json",
    "colors": {
        "activityBar.background": "#1e1e1e",
        "sideBar.background": "#1e1e1e",
        "statusBar.background": "#1e1e1e",
        "titleBar.activeBackground": "#1e1e1e",
        "tab.inactiveBackground": "#1e1e1e",
        "editorGroupHeader.tabsBackground": "#1e1e1e",
        "sideBarSectionHeader.border": "#1e1e1e",
        "editorWidget.background": "#1e1e1e",
        "tab.activeBackground": "#2a2a2a",
        "statusBar.foreground": "#e0e0e0",
        "statusBar.border": "#272727",
        "scrollbar.shadow": "#0c0c0c",
        "progressBar.background": "#1e90ff",
        "focusBorder": "#1e90ff",
        "activityBarBadge.background": "#1e90ffb3",
        "activityBar.activeBorder": "#1e90ff",
        "button.background": "#1e90ffb3"
    },
    "tokenColors": [
        {
            "name": "parameter",
            "scope": ["variable.parameter"],
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "comments",
            "scope": ["comment"],
            "settings": { "foreground": "#7f848e" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
