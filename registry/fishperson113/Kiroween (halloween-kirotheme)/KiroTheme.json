{
    "$schema": "vscode://schemas/color-theme",
    "name": "KiroTheme",
    "type": "dark",
    "colors": {
        "editor.background": "#1A0A1F",
        "editor.foreground": "#C6C6C6",
        "sideBar.background": "#3D0842",
        "sideBar.foreground": "#C6C6C6",
        "sideBar.border": "#3D0842",
        "activityBar.background": "#EB5B00",
        "activityBar.foreground": "#FFB200",
        "activityBar.activeBorder": "#FFB200",
        "activityBar.inactiveForeground": "#FFFFFF",
        "statusBar.background": "#EB5B00",
        "statusBar.foreground": "#FFFFFF",
        "statusBar.border": "#FFB200",
        "tab.activeBackground": "#1A0A1F",
        "tab.inactiveBackground": "#0D0510",
        "tab.activeBorderTop": "#FFB200",
        "tab.inactiveForeground": "#C6C6C6",
        "panel.background": "#1A0A1F",
        "terminal.background": "#1A0A1F",
        "panel.border": "#EB5B00",
        "editorLineNumber.foreground": "#EB5B00",
        "editorCursor.foreground": "#FFB200",
        "editor.selectionBackground": "#D9165644",
        "editor.selectionHighlightBackground": "#D9165622",
        "editor.lineHighlightBackground": "#EB5B0022",
        "scrollbarSlider.background": "#EB5B0066",
        "scrollbarSlider.hoverBackground": "#EB5B0088",
        "scrollbarSlider.activeBackground": "#FFB200AA",
        "badge.background": "#FFB200",
        "badge.foreground": "#1A0A1F"
    },
    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#C6C6C6", "fontStyle": "italic" }
        },
        {
            "name": "Strings",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#D91656" }
        },
        {
            "name": "Template Expressions",
            "scope": [
                "meta.template.expression",
                "punctuation.definition.template-expression"
            ],
            "settings": { "foreground": "#EB5B00" }
        },
        {
            "name": "Keywords",
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#EB5B00" }
        },
        {
            "name": "Control Keywords",
            "scope": [
                "keyword.control",
                "keyword.operator.new",
                "keyword.operator.expression"
            ],
            "settings": { "foreground": "#EB5B00", "fontStyle": "bold" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "variable.other", "variable.parameter"],
            "settings": { "foreground": "#C6C6C6" }
        },
        {
            "name": "Function Names",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call"
            ],
            "settings": { "foreground": "#FFB200" }
        },
        {
            "name": "Types & Classes",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.type",
                "support.class"
            ],
            "settings": { "foreground": "#FFB200", "fontStyle": "bold" }
        },
        {
            "name": "Numbers & Constants",
            "scope": [
                "constant.numeric",
                "constant.language",
                "constant.character"
            ],
            "settings": { "foreground": "#EB5B00" }
        },
        {
            "name": "Operators",
            "scope": [
                "keyword.operator",
                "punctuation.separator",
                "punctuation.terminator"
            ],
            "settings": { "foreground": "#C6C6C6" }
        },
        {
            "name": "RegExp",
            "scope": ["string.regexp", "constant.character.escape"],
            "settings": { "foreground": "#EB5B00" }
        },
        {
            "name": "Errors & Invalid",
            "scope": ["invalid", "invalid.illegal", "invalid.deprecated"],
            "settings": {
                "foreground": "#D91656",
                "fontStyle": "bold underline"
            }
        },
        {
            "name": "JSON Property Names",
            "scope": ["support.type.property-name"],
            "settings": { "foreground": "#FFB200" }
        },
        {
            "name": "Markup Headings",
            "scope": ["markup.heading", "entity.name.section"],
            "settings": { "foreground": "#EB5B00", "fontStyle": "bold" }
        },
        {
            "name": "Markup Bold",
            "scope": ["markup.bold"],
            "settings": { "foreground": "#EB5B00", "fontStyle": "bold" }
        },
        {
            "name": "Markup Italic",
            "scope": ["markup.italic"],
            "settings": { "foreground": "#D91656", "fontStyle": "italic" }
        },
        {
            "name": "Markup Links",
            "scope": ["markup.underline.link", "string.other.link"],
            "settings": { "foreground": "#FFB200", "fontStyle": "underline" }
        }
    ]
}
