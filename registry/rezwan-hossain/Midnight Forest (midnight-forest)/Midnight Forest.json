            "settings": { "foreground": "#806731" }
        },
        {
            "name": "Tag start/end",
            "scope": "punctuation.definition.tag",
            "settings": { "foreground": "#796137" }
        },
        {
            "name": "Tag attribute",
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#806731" }
        },
        {
            "name": "Library function",
