    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "fontStyle": "italic", "foreground": "#035399be" }
        },
        {
            "name": "Comment",
            "scope": "comment",
            "settings": { "fontStyle": "italic ", "foreground": "#404d41af" }
        },
        { "settings": { "foreground": "#898576" } },
        {
            "scope": ["meta.embedded", "source.groovy.embedded"],
            "settings": { "foreground": "#806731" }
        },
        {
            "scope": "string.quoted.docstring.multi.python",
            "settings": {
                "fontStyle": "italic bold",
                "foreground": "#374238af"
            }
        },
        {
            "name": "String",
            "scope": "string",
            "settings": { "foreground": "#326777" }
        },
        {
            "name": "Regexp",
            "scope": "string.regexp",
            "settings": { "foreground": "#814b49" }
        },
        {
            "name": "Number",
            "scope": "constant.numeric",
            "settings": { "foreground": "#6a4771" }
        },
        {
            "name": "Variable",
            "scope": ["variable.language", "variable.other"],
            "settings": { "foreground": "#806731" }
        },
        {
            "name": "Keyword",
            "scope": "keyword",
            "settings": { "foreground": "#416644" }
        },
        {
            "name": "Storage",
            "scope": "storage",
            "settings": { "fontStyle": "bold", "foreground": "#806731" }
        },
        {
            "name": "Class name",
            "scope": ["entity.name.class", "entity.name.type"],
            "settings": { "fontStyle": "italic ", "foreground": "#814b49" }
        },
        {
            "name": "Function name",
            "scope": "entity.name.function",
            "settings": { "fontStyle": "", "foreground": "#326777" }
        },
        {
            "name": "Variable start",
            "scope": "punctuation.definition.variable",
            "settings": { "foreground": "#416644" }
        },
        {
            "name": "Embedded code markers",
            "scope": [
                "punctuation.section.embedded.begin",
                "punctuation.section.embedded.end"
            ],
            "settings": { "foreground": "#814b49" }
        },
        {
            "name": "Built-in constant",
            "scope": ["constant.language", "meta.preprocessor"],
            "settings": { "foreground": "#806731" }
        },
        {
            "name": "Support.construct",
            "scope": ["support.function.construct", "keyword.other.new"],
            "settings": { "foreground": "#814b49" }
        },
        {
            "name": "User-defined constant",
            "scope": ["constant.character", "constant.other"],
            "settings": { "foreground": "#814b49" }
        },
        {
            "name": "Inherited class",
            "scope": "entity.other.inherited-class",
            "settings": { "foreground": "#6a4771" }
        },
        {
            "name": "Function argument",
            "scope": "variable.parameter",
            "settings": {}
        },
        {
            "name": "Tag name",
