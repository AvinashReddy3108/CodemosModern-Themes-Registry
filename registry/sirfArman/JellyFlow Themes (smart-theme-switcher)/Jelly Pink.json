{
    "name": "Jelly Pink",
    "type": "dark",
    "colors": {
        "editor.background": "#1b1217",
        "editor.foreground": "#f5c2d7",
        "editorCursor.foreground": "#ff79c6",
        "selection.background": "#ff79c633",
        "sideBar.background": "#20141c",
        "activityBar.background": "#24161f",
        "statusBar.background": "#ff79c6",
        "statusBar.foreground": "#1b1217",
        "focusBorder": "#ff79c6"
    },
    "tokenColors": [
        {
            "scope": "comment",
            "settings": { "foreground": "#8b6f7f", "fontStyle": "italic" }
        },
        { "scope": "keyword", "settings": { "foreground": "#ff79c6" } },
        { "scope": "string", "settings": { "foreground": "#f1a7c7" } },
        {
            "scope": "entity.name.function",
            "settings": { "foreground": "#ffd6e7" }
        },
        { "scope": "variable", "settings": { "foreground": "#f8bbd0" } },
        { "scope": "constant.numeric", "settings": { "foreground": "#ffb7d5" } }
    ],
    "$schema": "vscode://schemas/color-theme"
}
