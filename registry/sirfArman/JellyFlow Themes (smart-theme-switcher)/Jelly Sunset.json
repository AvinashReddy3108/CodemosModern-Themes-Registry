{
    "name": "Jelly Sunset",
    "type": "dark",
    "colors": {
        "editor.background": "#1a0f0a",
        "editor.foreground": "#fed7aa",
        "editorCursor.foreground": "#fb923c",
        "selection.background": "#fb923c33",
        "sideBar.background": "#2a1208",
        "activityBar.background": "#2a1208",
        "statusBar.background": "#fb923c",
        "statusBar.foreground": "#1a0f0a",
        "focusBorder": "#fb923c"
    },
    "tokenColors": [
        {
            "scope": "comment",
            "settings": { "foreground": "#fdba74", "fontStyle": "italic" }
        },
        { "scope": "keyword", "settings": { "foreground": "#fb923c" } },
        { "scope": "string", "settings": { "foreground": "#fed7aa" } }
    ],
    "$schema": "vscode://schemas/color-theme"
}
