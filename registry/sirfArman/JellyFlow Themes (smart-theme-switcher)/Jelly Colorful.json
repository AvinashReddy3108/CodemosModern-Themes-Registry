{
    "name": "Jelly Colorful",
    "type": "dark",
    "colors": {
        "editor.background": "#0f0f1a",
        "editor.foreground": "#ffffff",
        "editorCursor.foreground": "#22d3ee",
        "selection.background": "#a855f733",
        "sideBar.background": "#1e1e3f",
        "activityBar.background": "#1e1e3f",
        "statusBar.background": "#ff79c6",
        "statusBar.foreground": "#0f0f1a",
        "focusBorder": "#22d3ee"
    },
    "tokenColors": [
        {
            "scope": "comment",
            "settings": { "foreground": "#94a3b8", "fontStyle": "italic" }
        },
        { "scope": "keyword", "settings": { "foreground": "#a855f7" } },
        { "scope": "string", "settings": { "foreground": "#22d3ee" } },
        {
            "scope": "entity.name.function",
            "settings": { "foreground": "#50fa7b" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
