{
    "name": "Jelly AMOLED",
    "type": "dark",
    "colors": {
        "editor.background": "#000000",
        "editor.foreground": "#e5e7eb",
        "editorCursor.foreground": "#94a3b8",
        "selection.background": "#94a3b833",
        "sideBar.background": "#000000",
        "activityBar.background": "#000000",
        "statusBar.background": "#000000",
        "statusBar.foreground": "#e5e7eb",
        "focusBorder": "#64748b"
    },
    "tokenColors": [
        {
            "scope": "comment",
            "settings": { "foreground": "#6b7280", "fontStyle": "italic" }
        },
        { "scope": "keyword", "settings": { "foreground": "#e5e7eb" } },
        { "scope": "string", "settings": { "foreground": "#9ca3af" } }
    ],
    "$schema": "vscode://schemas/color-theme"
}
