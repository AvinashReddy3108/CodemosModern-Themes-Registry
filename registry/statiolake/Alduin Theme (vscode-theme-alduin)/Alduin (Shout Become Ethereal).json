{
    "colors": {
        "foreground": "#dfdfaf",
        "editor.foreground": "#dfdfaf",
        "statusBar.foreground": "#8a8a8a",
        "focusBorder": "#444444",
        "editorRuler.foreground": "#333333",
        "editorIndentGuide.activeBackground": "#444444",
        "editorIndentGuide.background": "#282828",
        "editor.background": "#080808",
        "editor.selectionBackground": "#875f5f70",
        "editor.lineHighlightBackground": "#121212",
        "editor.lineHighlightBorder": "#121212",
        "titleBar.activeBackground": "#080808",
        "titleBar.inactiveBackground": "#1a1a1a",
        "titleBar.activeForeground": "#ffffff",
        "textLink.activeForeground": "#af8787",
        "textLink.foreground": "#af5f5f",
        "editorLink.activeForeground": "#ff0000",
        "badge.background": "#af5f5f",
        "input.background": "#080808",
        "quickInput.background": "#121212",
        "quickInput.foreground": "#dfdfaf",
        "quickInputList.focusBackground": "#af5f5f",
        "list.focusForeground": "#dfdfaf",
        "list.highlightForeground": "#ffffff",
        "list.focusBackground": "#af5f5f",
        "menu.foreground": "#dfdfaf",
        "menu.background": "#121212",
        "menu.selectionForeground": "#dfdfaf",
        "menu.selectionBackground": "#af5f5f",
        "menu.border": "#444444",
        "list.activeSelectionBackground": "#af5f5f",
        "list.inactiveSelectionBackground": "#af5f5f",
        "pickerGroup.foreground": "#585858",
        "pickerGroup.border": "#444444",
        "input.border": "#444444",
        "activityBarBadge.background": "#af5f5f",
        "activityBar.foreground": "#dfdfaf",
        "activityBar.background": "#121212",
        "activityBar.activeBackground": "#af5f5f",
        "activityBar.activeBorder": "#af5f5f",
        "selection.background": "#af5f5f",
        "sideBarTitle.foreground": "#dfdfaf",
        "sideBar.background": "#080808",
        "sideBar.border": "#444444",
        "panel.background": "#080808",
        "panel.border": "#444444",
        "statusBar.background": "#000000",
        "statusBar.noFolderBackground": "#000000",
        "statusBar.debuggingBackground": "#af5f5f",
        "editorGroupHeader.tabsBackground": "#121212",
        "notifications.background": "#121212",
        "notifications.foreground": "#585858",
        "editorSuggestWidget.background": "#080808",
        "editorSuggestWidget.foreground": "#dfdfaf",
        "editorSuggestWidget.selectedBackground": "#af5f5f",
        "editorSuggestWidget.highlightForeground": "#ffffff",
        "tab.inactiveBackground": "#121212",
        "tab.inactiveForeground": "#666650",
        "tab.activeForeground": "#dfdfaf",
        "tab.activeBackground": "#666666",
        "tab.activeBorder": "#121212",
        "tab.hoverBackground": "#333333",
        "tab.border": "#121212",
        "tab.hoverBorder": "#333333",
        "tab.hoverForeground": "#dfdfaf",
        "editorLineNumber.foreground": "#444444",
        "editorLineNumber.activeForeground": "#dfdfaf",
        "peekView.border": "#444444",
        "peekViewEditor.background": "#121212",
        "peekViewEditor.matchHighlightBackground": "#af5f5f60",
        "button.background": "#af5f5f",
        "progressBar.background": "#af5f5f"
    },
    "name": "Alduin (Shout Become Ethereal)",
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "selfKeyword": "#af8787",
        "*.documentation": "#afaf7c"
    },
    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#87875f" }
        },
        {
            "name": "Documentation Comment",
            "scope": [
                "comment.line.documentation",
                "comment.block.documentation"
            ],
            "settings": { "foreground": "#afaf7c" }
        },
        {
            "name": "Variables",
            "scope": [
                "variable",
                "string constant.other.placeholder",
                "variable.parameter",
                "meta.function-call.arguments"
            ],
            "settings": { "foreground": "#87afaf" }
        },
        {
            "name": "Colors",
            "scope": ["constant.other.color"],
            "settings": { "foreground": "#ffffff" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#af5f5f" }
        },
        {
            "name": "Keyword, Storage",
            "scope": [
                "keyword",
                "storage.type",
                "storage.modifier",
                "keyword.other.unit",
                "keyword.other"
            ],
            "settings": { "foreground": "#878787" }
        },
        {
            "name": "Operator, Misc",
            "scope": [
                "keyword.control",
                "constant.other.color",
                "meta.tag",
                "keyword.other.template",
                "keyword.other.substitution"
            ],
            "settings": { "foreground": "#878787" }
        },
        {
            "name": "Punctuations",
            "scope": [
                "punctuation.definition.tag",
                "punctuation.definition.arguments",
                "punctuation.definition.list.begin",
                "punctuation.definition.list.end",
                "punctuation.parenthesis.begin",
                "punctuation.parenthesis.end",
                "punctuation.separator.element",
                "punctuation.separator.arguments",
                "punctuation.section.embedded",
                "punctuation.separator.inheritance.php",
                "punctuation.definition.tag.html",
                "punctuation.definition.tag.begin.html",
                "punctuation.definition.tag.end.html"
            ],
            "settings": { "foreground": "#dfdfaf" }
        },
        {
            "name": "Attribute",
            "scope": ["meta.attribute"],
            "settings": { "foreground": "#dfaf87" }
        },
        {
            "name": "Tag",
            "scope": [
                "entity.name.tag",
                "meta.tag.sgml",
                "markup.deleted.git_gutter"
            ],
            "settings": { "foreground": "#af5f5f" }
        },
        {
            "name": "Function",
            "scope": [
                "entity.name.function",
                "meta.function-call",
                "variable.function",
                "support.function"
            ],
            "settings": { "foreground": "#875f5f" }
        },
        {
            "name": "Preprocessor",
            "scope": [
                "keyword.control.directive.include",
                "meta.preprocessor.include"
            ],
            "settings": { "foreground": "#dfaf87" }
        },
        {
            "name": "Macro, Special Method",
            "scope": [
                "entity.name.function.preprocessor",
                "keyword.other.special-method",
                "entity.name.function.macro",
                "meta.macro"
            ],
            "settings": { "foreground": "#dfaf87" }
        },
        {
            "name": "Block Level Variables",
            "scope": ["meta.block variable.other"],
            "settings": { "foreground": "#af5f5f" }
        },
        {
            "name": "Other Variable, String Link",
            "scope": ["support.other.variable", "string.other.link"],
            "settings": { "foreground": "#af5f5f" }
        },
        {
            "name": "Number, Constant, Function Argument, Tag Attribute, Embedded",
            "scope": [
                "constant.numeric",
                "constant.language",
                "support.constant",
                "constant.character",
                "constant.escape"
            ],
            "settings": { "foreground": "#af5f00" }
        },
        {
            "name": "String, Symbols, Inherited Class, Markup Heading",
            "scope": [
                "string",
                "punctuation.definition.string",
                "constant.other.symbol",
                "constant.other.key",
                "entity.other.inherited-class",
                "markup.heading",
                "markup.inserted.git_gutter",
                "meta.group.braces.curly constant.other.object.key.js string.unquoted.label.js"
            ],
            "settings": { "foreground": "#ffdf87" }
        },
        {
            "name": "Namespace",
            "scope": ["entity.name.namespace"],
            "settings": { "foreground": "#dfaf87" }
        },
        {
            "name": "Class, Support",
            "scope": [
                "entity.name",
                "support.type",
                "support.class",
                "support.other.namespace.use.php",
                "meta.use.php",
                "support.other.namespace.php",
                "markup.changed.git_gutter",
                "support.type.sys-types"
            ],
            "settings": { "foreground": "#af875f" }
        },
        {
            "name": "Entity Types",
            "scope": ["support.type"],
            "settings": { "foreground": "#af875f" }
        },
        {
            "name": "CSS Class and Support",
            "scope": [
                "source.css support.type.property-name",
                "source.sass support.type.property-name",
                "source.scss support.type.property-name",
                "source.less support.type.property-name",
                "source.stylus support.type.property-name",
                "source.postcss support.type.property-name"
            ],
            "settings": { "foreground": "#af875f" }
        },
        {
            "name": "Sub-methods",
            "scope": [
                "entity.name.module.js",
                "variable.import.parameter.js",
                "variable.other.class.js"
            ],
            "settings": { "foreground": "#af5f5f" }
        },
        {
            "name": "Language methods",
            "scope": ["variable.language"],
            "settings": { "foreground": "#af8787" }
        },
        {
            "name": "Enum Members",
            "scope": ["variable.other.enummember"],
            "settings": { "foreground": "#af8787" }
        },
        {
            "name": "entity.name.method.js",
            "scope": ["entity.name.method.js"],
            "settings": { "foreground": "#875f5f" }
        },
        {
            "name": "meta.method.js",
            "scope": [
                "meta.class-method.js entity.name.function.js",
                "variable.function.constructor"
            ],
            "settings": { "foreground": "#875f5f" }
        },
        {
            "name": "Attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#af875f" }
        },
        {
            "name": "HTML Attributes",
            "scope": [
                "text.html.basic entity.other.attribute-name.html",
                "text.html.basic entity.other.attribute-name"
            ],
            "settings": { "foreground": "#dfaf87" }
        },
        {
            "name": "CSS Classes",
            "scope": ["entity.other.attribute-name.class"],
            "settings": { "foreground": "#dfaf87" }
        },
        {
            "name": "CSS ID's",
            "scope": ["source.sass keyword.control"],
            "settings": { "foreground": "#875f5f" }
        },
        {
            "name": "Inserted",
            "scope": ["markup.inserted"],
            "settings": { "foreground": "#008787" }
        },
        {
            "name": "Deleted",
            "scope": ["markup.deleted"],
            "settings": { "foreground": "#af5f5f" }
        },
        {
            "name": "Changed",
            "scope": ["markup.changed"],
            "settings": { "foreground": "#af875f" }
        },
        {
            "name": "Regular Expressions",
            "scope": ["string.regexp"],
            "settings": { "foreground": "#af8787" }
        },
        {
            "name": "Escape Characters",
            "scope": ["constant.character.escape"],
            "settings": { "foreground": "#af8787" }
        },
        {
            "name": "URL",
            "scope": ["*url*", "*link*", "*uri*"],
            "settings": { "fontStyle": "underline" }
        },
        {
            "name": "Decorators",
            "scope": [
                "tag.decorator.js entity.name.tag.js",
                "tag.decorator.js punctuation.definition.tag.js"
            ],
            "settings": { "foreground": "#875f5f" }
        },
        {
            "name": "ES7 Bind Operator",
            "scope": [
                "source.js constant.other.object.key.js string.unquoted.label.js"
            ],
            "settings": { "foreground": "#af5f5f" }
        },
        {
            "name": "JSON Key - Level 0",
            "scope": [
                "source.json meta.structure.dictionary.json support.type.property-name.json"
            ],
            "settings": { "foreground": "#af8787" }
        },
        {
            "name": "Markdown - Plain",
            "scope": [
                "text.html.markdown",
                "punctuation.definition.list_item.markdown"
            ],
            "settings": { "foreground": "#dfdfaf" }
        },
        {
            "name": "Markdown - Markup Raw Inline",
            "scope": ["text.html.markdown markup.inline.raw.markdown"],
            "settings": { "foreground": "#af875f" }
        },
        {
            "name": "Markdown - Markup Raw Inline Punctuation",
            "scope": [
                "text.html.markdown markup.inline.raw.markdown punctuation.definition.raw.markdown"
            ],
            "settings": { "foreground": "#dfdfaf" }
        },
        {
            "name": "Markdown - Heading",
            "scope": [
                "markdown.heading",
                "markup.heading | markup.heading entity.name",
                "markup.heading.markdown punctuation.definition.heading.markdown"
            ],
            "settings": { "foreground": "#dfdfaf" }
        },
        {
            "name": "Markdown - Heading Body",
            "scope": ["entity.name.section.markdown"],
            "settings": { "foreground": "#dfaf87" }
        },
        {
            "name": "Markup - Italic",
            "scope": ["markup.italic"],
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "Markup - Bold",
            "scope": ["markup.bold", "markup.bold string"],
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Markup - Bold-Italic",
            "scope": [
                "markup.bold markup.italic",
                "markup.italic markup.bold",
                "markup.quote markup.bold",
                "markup.bold markup.italic string",
                "markup.italic markup.bold string",
                "markup.quote markup.bold string"
            ],
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Markup - Underline",
            "scope": ["markup.underline"],
            "settings": { "fontStyle": "underline" }
        },
        {
            "name": "Markdown - Blockquote",
            "scope": [
                "markup.quote punctuation.definition.blockquote.markdown"
            ],
            "settings": { "foreground": "#ffdf87" }
        },
        { "name": "Markup - Quote", "scope": ["markup.quote"], "settings": {} },
        {
            "name": "Markdown - Link",
            "scope": ["string.other.link.title.markdown"],
            "settings": { "foreground": "#875f5f" }
        },
        {
            "name": "Markdown - Link Description",
            "scope": ["string.other.link.description.title.markdown"],
            "settings": { "foreground": "#af875f" }
        },
        {
            "name": "Markdown - Link Anchor",
            "scope": ["constant.other.reference.link.markdown"],
            "settings": { "foreground": "#dfaf87" }
        },
        {
            "name": "Markup - Raw Block",
            "scope": ["markup.raw.block"],
            "settings": { "foreground": "#af875f" }
        },
        {
            "name": "Markdown - Raw Block Fenced",
            "scope": ["markup.raw.block.fenced.markdown"],
            "settings": { "foreground": "#1c1c1c50" }
        },
        {
            "name": "Markdown - Fenced Bode Block",
            "scope": ["punctuation.definition.fenced.markdown"],
            "settings": { "foreground": "#1c1c1c50" }
        },
        {
            "name": "Markdown - Fenced Bode Block Variable",
            "scope": [
                "markup.raw.block.fenced.markdown",
                "variable.language.fenced.markdown",
                "punctuation.section.class.end"
            ],
            "settings": { "foreground": "#dfdfaf" }
        },
        {
            "name": "Markdown - Fenced Language",
            "scope": ["variable.language.fenced.markdown"],
            "settings": { "foreground": "#ffdf87" }
        },
        {
            "name": "Markdown - Separator",
            "scope": ["meta.separator"],
            "settings": { "fontStyle": "bold", "foreground": "#ffdf87" }
        },
        {
            "name": "Markup - Table",
            "scope": ["markup.table"],
            "settings": { "foreground": "#dfdfaf" }
        },
        {
            "name": "Markdown - List Symbols",
            "scope": ["punctuation.definition.list.begin.markdown"],
            "settings": { "foreground": "#87afaf" }
        },
        {
            "name": "Markdown - Link Title",
            "scope": [
                "punctuation.definition.string.begin.markdown",
                "punctuation.definition.string.end.markdown",
                "string.other.link.title.markdown",
                "punctuation.definition.constant.markdown",
                "constant.other.reference.link.markdown"
            ],
            "settings": { "foreground": "#af5f5f" }
        },
        {
            "name": "Markdown - Inline Link Definition",
            "scope": ["meta.link.inline.markdown"],
            "settings": { "foreground": "#ffdf87" }
        },
        {
            "name": "TOML - Table Brackets",
            "scope": [
                "punctuation.definition.table.toml",
                "entity.other.attribute-name.table.toml"
            ],
            "settings": { "foreground": "#dfaf87" }
        },
        {
            "name": "TOML - Key",
            "scope": ["keyword.key.toml"],
            "settings": { "foreground": "#87afaf" }
        }
    ],
    "type": "dark",
    "$schema": "vscode://schemas/color-theme"
}
