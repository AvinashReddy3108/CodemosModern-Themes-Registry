    "tokenColors": [
        {
            "scope": "variable.parameter.function",
            "settings": { "foreground": "#aaaaaa", "fontStyle": "italic" }
        },
        {
            "scope": "comment, punctuation.definition.comment",
            "settings": { "foreground": "#383838" }
        },
        {
            "scope": "punctuation.definition.string, punctuation.definition.variable, punctuation.definition.parameters, punctuation.definition.array",
            "settings": { "foreground": "#aaaaaa" }
        },
        { "scope": "none", "settings": { "foreground": "#aaaaaa" } },
        {
            "scope": "keyword.operator",
            "settings": { "foreground": "#aaaaaa" }
        },
        {
            "scope": "keyword",
            "settings": { "foreground": "#6c6c6c", "fontStyle": "bold" }
        },
        { "scope": "variable", "settings": { "foreground": "#707070" } },
        {
            "scope": "entity.name.function, meta.require, support.function.any-method",
            "settings": { "foreground": "#626262", "fontStyle": "bold" }
        },
        {
            "scope": "support.class, entity.name.class, entity.name.type.class",
            "settings": { "foreground": "#939393", "fontStyle": "bold" }
        },
        {
            "scope": "meta.class",
            "settings": { "foreground": "#e2e2e2", "fontStyle": "bold" }
        },
        {
            "scope": "keyword.other.special-method",
            "settings": { "foreground": "#626262", "fontStyle": "bold" }
        },
        {
            "scope": "storage",
            "settings": { "foreground": "#6c6c6c", "fontStyle": "bold" }
        },
        {
            "scope": "support.function",
            "settings": { "foreground": "#7e7e7e", "fontStyle": "bold" }
        },
        {
            "scope": "storage.type",
            "settings": { "foreground": "#8d8d8d", "fontStyle": "bold italic" }
        },
        {
            "scope": "storage.modifier, storage.type.modifier",
            "settings": { "foreground": "#8d8d8d", "fontStyle": "bold italic" }
        },
        {
            "scope": "entity.other.inherited-class",
            "settings": { "foreground": "#878787", "fontStyle": "italic" }
        },
        {
            "scope": "variable.language",
            "settings": { "foreground": "#aaaaaa", "fontStyle": "italic" }
        },
        {
            "scope": "string, constant.other.symbol",
            "settings": { "foreground": "#878787" }
        },
        {
            "scope": "constant.numeric",
            "settings": { "foreground": "#8d8d8d" }
        },
        { "scope": "none", "settings": { "foreground": "#8d8d8d" } },
        { "scope": "none", "settings": { "foreground": "#8d8d8d" } },
        { "scope": "constant", "settings": { "foreground": "#8d8d8d" } },
        {
            "scope": "entity.name.tag",
            "settings": { "foreground": "#707070", "fontStyle": "bold" }
        },
        {
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#8d8d8d" }
        },
        {
            "scope": "entity.other.attribute-name.id, punctuation.definition.entity",
            "settings": { "foreground": "#626262" }
        },
        { "scope": "meta.selector", "settings": { "foreground": "#6c6c6c" } },
        { "scope": "none", "settings": { "foreground": "#8d8d8d" } },
        {
            "scope": "markup.heading punctuation.definition.heading, entity.name.section",
            "settings": { "foreground": "#626262", "fontStyle": "bold" }
        },
        {
            "scope": "keyword.other.unit",
            "settings": { "foreground": "#8d8d8d" }
        },
        {
            "scope": "markup.bold, punctuation.definition.bold",
            "settings": { "foreground": "#939393", "fontStyle": "bold" }
        },
        {
            "scope": "comment markup.bold",
            "settings": { "foreground": "#939393", "fontStyle": "bold italic" }
        },
        {
            "scope": "markup.italic, punctuation.definition.italic",
            "settings": { "foreground": "#6c6c6c", "fontStyle": "italic" }
        },
        {
            "scope": "comment markup.underline",
            "settings": {
                "foreground": "#8d8d8d",
                "fontStyle": "underline italic"
            }
        },
        {
            "scope": "markup.underline",
            "settings": { "foreground": "#8d8d8d", "fontStyle": "underline" }
        },
        {
            "scope": "storage.type.class.jsdoc",
            "settings": {
                "foreground": "#8d8d8d",
                "fontStyle": "italic underline"
            }
        },
        {
            "scope": "variable.parameter.js",
            "settings": { "foreground": "#aaaaaa", "fontStyle": "italic" }
        },
        {
            "scope": "markup.quote",
            "settings": { "foreground": "#8d8d8d", "fontStyle": "italic" }
        },
        {
            "scope": "markup.raw.inline",
            "settings": { "foreground": "#878787" }
        },
        {
            "scope": "variable.parameter.function",
            "settings": { "foreground": "#aaaaaa", "fontStyle": "italic" }
        },
        { "scope": "meta.link", "settings": { "foreground": "#8d8d8d" } },
        { "scope": "markup.list", "settings": { "foreground": "#707070" } },
        { "scope": "meta.separator", "settings": { "foreground": "#aaaaaa" } },
        { "scope": "markup.inserted", "settings": { "foreground": "#878787" } },
        { "scope": "markup.deleted", "settings": { "foreground": "#707070" } },
        { "scope": "markup.changed", "settings": { "foreground": "#6c6c6c" } },
        {
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#8d8d8d", "fontStyle": "italic" }
        },
        { "scope": "string.regexp", "settings": { "foreground": "#7e7e7e" } },
        {
            "scope": "constant.character.escape",
            "settings": { "foreground": "#7e7e7e" }
        },
        {
            "scope": "punctuation.section.embedded, variable.interpolation",
            "settings": { "foreground": "#6c6c6c" }
        },
        {
            "scope": "invalid.illegal",
            "settings": {
                "foreground": "#e2e2e2",
                "fontStyle": "bold italic underline"
            }
        },
        { "scope": "invalid.broken", "settings": { "foreground": "#101010" } },
        {
            "scope": "invalid.deprecated",
            "settings": {
                "foreground": "#e2e2e2",
                "fontStyle": "italic underline"
            }
        },
        {
            "scope": "invalid.unimplemented",
            "settings": { "foreground": "#e2e2e2" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
