{
    "$schema": "vscode://schemas/color-theme",
    "type": "light",
    "colors": {
        "editor.background": "#ffffff",
        "editor.lineHighlightBackground": "#f5f5f5",
        "editor.selectionBackground": "#b9b9b9",
        "editorSuggestWidget.selectedBackground": "#d6ebff",
        "editorSuggestWidget.selectedForeground": "#333333",
        "list.activeSelectionBackground": "#d6ebff",
        "list.activeSelectionForeground": "#333333",
        "menu.selectionBackground": "#d6ebff",
        "menu.selectionForeground": "#333333"
    },
    "tokenColors": [
        { "scope": "comment", "settings": { "foreground": "#696969" } },
        { "scope": "string", "settings": { "foreground": "#23238E" } },
        {
            "scope": "constant.numeric",
            "settings": { "foreground": "#8B0000" }
        },
        {
            "scope": "function.arguments.function-call",
            "settings": { "foreground": "#000000" }
        },
        { "scope": "delimiter", "settings": { "foreground": "#781F87" } },
        {
            "scope": "constant.language",
            "settings": { "foreground": "#AC4142" }
        },
        {
            "scope": "constant.character",
            "settings": { "foreground": "#AC4142" }
        },
        { "scope": "keyword", "settings": { "foreground": "#871F78" } },
        { "scope": "storage.type", "settings": { "foreground": "#871F78" } },
        {
            "scope": "entity.name.type.class",
            "settings": { "foreground": "#008B8B" }
        },
        {
            "scope": "entity.other.inherited-class",
            "settings": { "foreground": "#000000" }
        },
        {
            "scope": "entity.name.function",
            "settings": { "foreground": "#008B8B", "fontStyle": "" }
        },
        { "scope": "unicode.quoted", "settings": { "foreground": "#23238E" } },
        {
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#008B8B", "fontStyle": "" }
        },
        {
            "scope": "support.function",
            "settings": { "foreground": "#871F78", "fontStyle": "" }
        },
        {
            "scope": "support.constant",
            "settings": { "foreground": "#871F78", "fontStyle": "" }
        },
        {
            "scope": "support.type, support.class",
            "settings": { "foreground": "#23238E" }
        },
        {
            "scope": "meta.structure.dictionary.json string.quoted.double.json",
            "settings": { "foreground": "#23238E" }
        },
        { "scope": "variable.js", "settings": { "foreground": "#000000" } },
        {
            "scope": "storage.type.ts.js",
            "settings": { "foreground": "#871F78" }
        },
        { "scope": "keyword.js", "settings": { "foreground": "#871F78" } },
        {
            "scope": "property-name.css",
            "settings": { "foreground": "#000000" }
        },
        { "scope": "variable.jinja", "settings": { "foreground": "#000000" } },
        {
            "scope": "entity.name.tag.block.any.html",
            "settings": { "foreground": "#0032FF" }
        },
        {
            "scope": "entity.name.tag.inline.any.html",
            "settings": { "foreground": "#0032FF" }
        },
        {
            "scope": "meta.tag.any.html",
            "settings": { "foreground": "#0032FF" }
        },
        {
            "scope": "punctuation.definition.tag.begin.html",
            "settings": { "foreground": "#0032FF" }
        },
        {
            "scope": "punctuation.definition.tag.end.html",
            "settings": { "foreground": "#0032FF" }
        },
        {
            "scope": "entity.other.attribute-name.html",
            "settings": { "foreground": "#871F78" }
        },
        {
            "scope": "entity.name.tag.script.html",
            "settings": { "foreground": "#0032FF" }
        },
        {
            "scope": "punctuation.definition.tag.html",
            "settings": { "foreground": "#0032FF" }
        },
        {
            "scope": "entity.name.tag.structure.any.html",
            "settings": { "foreground": "#0032FF" }
        },
        {
            "scope": "entity.other.attribute-name.id.html",
            "settings": { "foreground": "#871F78" }
        },
        {
            "scope": "entity.other.django.delimiter.tag",
            "settings": { "foreground": "#871F78" }
        },
        {
            "scope": "entity.other.django.delimiter.variable",
            "settings": { "foreground": "#008B8B" }
        },
        {
            "scope": "entity.name.function.decorator.python",
            "settings": { "foreground": "#009900" }
        },
        {
            "scope": "support.type.python",
            "settings": { "foreground": "#009900" }
        },
        {
            "scope": "decorator.arguments.string.function.python",
            "settings": { "foreground": "#23238E" }
        },
        {
            "scope": "decorator.arguments.function.python",
            "settings": { "foreground": "#000000" }
        },
        {
            "scope": "token.meta.dictionary.key.python",
            "settings": { "foreground": "#23238E" }
        },
        {
            "scope": "support.type.exception.python",
            "settings": { "foreground": "#000000" }
        },
        {
            "scope": "variable.language.special.self.python",
            "settings": { "foreground": "#C86464" }
        },
        {
            "scope": "storage.type.string.python",
            "settings": { "foreground": "#23238E" }
        },
        {
            "scope": "storage.modifier.declaration.python",
            "settings": { "foreground": "#AC4142" }
        },
        {
            "scope": "python.function.parameter.parameters",
            "settings": { "foreground": "#000000" }
        },
        {
            "scope": "punctuation.definition.tag.xml",
            "settings": { "foreground": "#0032FF" }
        },
        {
            "scope": "entity.name.tag.localname.xml",
            "settings": { "foreground": "#0032FF" }
        },
        {
            "scope": "token.info-token",
            "settings": { "foreground": "#316BCD" }
        },
        {
            "scope": "token.warn-token",
            "settings": { "foreground": "#CD9731" }
        },
        {
            "scope": "token.error-token",
            "settings": { "foreground": "#CD3131" }
        },
        {
            "scope": "token.debug-token",
            "settings": { "foreground": "#800080" }
        }
    ]
}
