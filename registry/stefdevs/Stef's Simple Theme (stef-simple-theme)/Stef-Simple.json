{
    "name": "Stef-Simple",
    "type": "dark",
    "colors": {
        "editor.background": "#1d1a18",
        "editor.foreground": "#eeffff",
        "activityBarBadge.background": "#007acc",
        "sideBarTitle.foreground": "#bbbbbb"
    },
    "tokenColors": [
        {
            "name": "light",
            "scope": [
                "source",
                "keyword.type",
                "entity.name.type",
                "storage.type",
                "entity.name.variable.enum-member",
                "variable.other.object.function",
                "entity.name.function",
                "punctuation"
            ],
            "settings": { "foreground": "#B8ACA2" }
        },
        {
            "name": "dark",
            "scope": [
                "entity.name.variable",
                "variable.other",
                "variable.other.object",
                "keyword.operator",
                "constant"
            ],
            "settings": { "foreground": "#A8988D" }
        },
        {
            "name": "function",
            "scope": [],
            "settings": { "foreground": "#d85e12" }
        },
        {
            "name": "preprocessor",
            "scope": [
                "storage.modifier",
                "meta.preprocessor",
                "meta.preprocessor.region",
                "keyword.preprocessor",
                "punctuation.separator.hash",
                "storage.modifier",
                "keyword.other",
                "keyword.control",
                "entity.name.variable.preprocessor.symbol"
            ],
            "settings": { "foreground": "#966F75" }
        },
        {
            "name": "temp",
            "scope": [],
            "settings": { "foreground": "#6de97e" }
        },
        {
            "name": "comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "fontStyle": "italic", "foreground": "#72667A" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
