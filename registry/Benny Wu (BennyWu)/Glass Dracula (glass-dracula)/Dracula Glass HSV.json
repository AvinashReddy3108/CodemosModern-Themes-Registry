{
    "$schema": "vscode://schemas/color-theme",
    "name": "Dracula Glass HSV",
    "type": "dark",
    "semanticHighlighting": true,
    "colors": {
        "foreground": "#abb2bf",
        "focusBorder": "#212121",
        "widget.border": "#212121",
        "widget.shadow": "#00000040",
        "selection.background": "#2c313a",
        "editor.background": "#08090900",
        "editor.foreground": "#abb2bf",
        "editorLineNumber.foreground": "#495162",
        "editorLineNumber.activeForeground": "#abb2bf",
        "editorLineHighlightBackground": "#08090900",
        "editorCursor.foreground": "#212121",
        "editor.selectionBackground": "#2c313a",
        "editor.selectionHighlightBackground": "#555a6345",
        "editor.wordHighlightBackground": "#555a6345",
        "editor.wordHighlightStrongBackground": "#555a6345",
        "editorBracketMatch.background": "#abb2bf30",
        "editorGutter.background": "#08090900",
        "activityBar.background": "#08090900",
        "activityBarBadge.background": "#212121",
        "activityBarBadge.foreground": "#abb2bf",
        "sideBar.background": "#08090900",
        "sideBar.foreground": "#abb2bf",
        "sideBar.border": "#212121",
        "titleBar.activeBackground": "#080909DD",
        "titleBar.inactiveBackground": "#080909DD",
        "titleBar.activeForeground": "#abb2bf",
        "tab.activeBackground": "#080909",
        "tab.inactiveBackground": "#08090900",
        "tab.activeForeground": "#abb2bf",
        "tab.border": "#212121",
        "tab.activeBorderTop": "#212121",
        "statusBar.background": "#080909DD",
        "statusBar.foreground": "#abb2bf",
        "statusBar.border": "#212121",
        "panel.background": "#08090900",
        "panel.border": "#212121",
        "input.background": "#2c313a",
        "input.foreground": "#abb2bf",
        "input.border": "#212121",
        "dropdown.background": "#2c313a",
        "dropdown.foreground": "#abb2bf",
        "dropdown.border": "#212121",
        "list.hoverBackground": "#2c313a",
        "list.activeSelectionBackground": "#2c313a",
        "list.inactiveSelectionBackground": "#2c313a",
        "list.activeSelectionForeground": "#abb2bf",
        "list.inactiveSelectionForeground": "#abb2bf",
        "scrollbarSlider.background": "#4e566680",
        "scrollbarSlider.hoverBackground": "#5a6375",
        "terminal.background": "#08090900",
        "terminal.foreground": "#abb2bf",
        "terminalCursor.foreground": "#abb2bf",
        "terminal.ansiBlack": "#3f4451",
        "terminal.ansiRed": "#e05561",
        "terminal.ansiGreen": "#8cc265",
        "terminal.ansiYellow": "#d18f52",
        "terminal.ansiBlue": "#4aa5f0",
        "terminal.ansiMagenta": "#c162de",
        "terminal.ansiCyan": "#42b3c2",
        "terminal.ansiWhite": "#d7dae0",
        "terminal.ansiBrightBlack": "#4f5666",
        "terminal.ansiBrightRed": "#ff616e",
        "terminal.ansiBrightGreen": "#a5e075",
        "terminal.ansiBrightYellow": "#f0a45d",
        "terminal.ansiBrightBlue": "#4dc4ff",
        "terminal.ansiBrightMagenta": "#de73ff",
        "terminal.ansiBrightCyan": "#4cd1e0",
        "terminal.ansiBrightWhite": "#e6e6e6"
    },
    "tokenColors": [
        {
            "name": "zed:comment",
            "scope": ["comment"],
            "settings": { "foreground": "#9189de" }
        },
        {
            "name": "zed:comment.doc",
            "scope": ["comment.block.documentation"],
            "settings": { "foreground": "#e11b6a" }
        },
        {
            "name": "zed:keyword",
            "scope": ["keyword", "storage", "storage.type"],
            "settings": { "foreground": "#e11b6a" }
        },
        {
            "name": "zed:operator",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#e11b6a" }
        },
        {
            "name": "zed:attribute",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#e11b6a" }
        },
        {
            "name": "zed:function",
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#24cd12" }
        },
        {
            "name": "zed:constructor",
            "scope": ["entity.name.type.class"],
            "settings": { "foreground": "#e11b6a" }
        },
        {
            "name": "zed:type",
            "scope": ["entity.name.type", "support.type"],
            "settings": { "foreground": "#049dde" }
        },
        {
            "name": "zed:type.interface",
            "scope": ["entity.name.type.interface"],
            "settings": { "foreground": "#049dde", "fontStyle": "italic" }
        },
        {
            "name": "zed:type.super",
            "scope": ["entity.other.inherited-class"],
            "settings": { "foreground": "#049dde", "fontStyle": "italic" }
        },
        {
            "name": "zed:constant",
            "scope": ["constant"],
            "settings": { "foreground": "#7053e2" }
        },
        {
            "name": "zed:enum",
            "scope": ["entity.name.type.enum"],
            "settings": { "foreground": "#7053e2" }
        },
        {
            "name": "zed:number",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#7053e2" }
        },
        {
            "name": "zed:boolean",
            "scope": ["constant.language.boolean"],
            "settings": { "foreground": "#e11b6a" }
        },
        {
            "name": "zed:string",
            "scope": ["string"],
            "settings": { "foreground": "#d9b522" }
        },
        {
            "name": "zed:string.escape",
            "scope": ["constant.character.escape"],
            "settings": { "foreground": "#e11b6a" }
        },
        {
            "name": "zed:string.regex",
            "scope": ["string.regexp"],
            "settings": { "foreground": "#e4412f" }
        },
        {
            "name": "zed:string.special",
            "scope": ["string.other"],
            "settings": { "foreground": "#e11b6a" }
        },
        {
            "name": "zed:string.special.symbol",
            "scope": ["constant.other.symbol"],
            "settings": { "foreground": "#7053e2" }
        },
        {
            "name": "zed:text.literal",
            "scope": ["markup.raw", "markup.inline.raw"],
            "settings": { "foreground": "#24cd12" }
        },
        {
            "name": "zed:link_uri",
            "scope": ["markup.underline.link"],
            "settings": { "foreground": "#049dde" }
        },
        {
            "name": "zed:link_text",
            "scope": ["string.other.link.title"],
            "settings": { "foreground": "#e11b6a" }
        },
        {
            "name": "zed:tag",
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#e11b6a" }
        },
        {
            "name": "zed:property",
            "scope": ["variable.other.property"],
            "settings": { "foreground": "#049dde" }
        },
        {
            "name": "zed:variable",
            "scope": ["variable"],
            "settings": { "foreground": "#c3c3c3" }
        },
        {
            "name": "zed:variable.member",
            "scope": ["variable.other.member"],
            "settings": { "foreground": "#c3c3c3" }
        },
        {
            "name": "zed:variable.parameter",
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#e16a1b", "fontStyle": "italic" }
        },
        {
            "name": "zed:variable.special",
            "scope": ["variable.language"],
            "settings": { "foreground": "#7053e2", "fontStyle": "italic" }
        },
        {
            "name": "zed:label",
            "scope": ["entity.name.label"],
            "settings": { "foreground": "#c3c3c3" }
        },
        {
            "name": "zed:title",
            "scope": ["entity.name.section"],
            "settings": { "foreground": "#7053e2", "fontStyle": "bold" }
        },
        {
            "name": "zed:punctuation",
            "scope": ["punctuation"],
            "settings": { "foreground": "#e11b6a" }
        },
        {
            "name": "zed:punctuation.bracket",
            "scope": ["punctuation.bracket"],
            "settings": { "foreground": "#c3c3c3" }
        },
        {
            "name": "zed:punctuation.delimiter",
            "scope": ["punctuation.separator"],
            "settings": { "foreground": "#e11b6a" }
        },
        {
            "name": "zed:punctuation.special",
            "scope": ["punctuation.definition.tag"],
            "settings": { "foreground": "#e11b6a" }
        },
        {
            "name": "zed:preproc",
            "scope": ["meta.preprocessor"],
            "settings": { "foreground": "#9189de" }
        },
        {
            "name": "zed:emphasis",
            "scope": ["markup.italic"],
            "settings": { "foreground": "#d9b522", "fontStyle": "italic" }
        },
        {
            "name": "zed:emphasis.strong",
            "scope": ["markup.bold"],
            "settings": { "foreground": "#e16a1b", "fontStyle": "bold" }
        }
    ],
    "semanticTokenColors": {
        "comment": "#9189de",
        "keyword": "#e11b6a",
        "function": "#24cd12",
        "method": "#24cd12",
        "type": "#049dde",
        "class": "#049dde",
        "interface": "#049dde",
        "enum": "#7053e2",
        "enumMember": "#7053e2",
        "variable": "#c3c3c3",
        "parameter": "#e16a1b",
        "property": "#049dde",
        "string": "#d9b522",
        "number": "#7053e2",
        "regexp": "#e4412f",
        "operator": "#e11b6a"
    }
}
