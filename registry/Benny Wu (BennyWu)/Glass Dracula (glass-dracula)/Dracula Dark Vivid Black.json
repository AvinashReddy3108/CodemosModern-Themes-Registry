{
    "$schema": "vscode://schemas/color-theme",
    "name": "Dracula Dark Vivid Black",
    "type": "dark",
    "semanticHighlighting": true,
    "colors": {
        "foreground": "#FFFFFF",
        "focusBorder": "#8B73EE",
        "widget.border": "#FFFFFF24",
        "widget.shadow": "#00000040",
        "selection.background": "#FFFFFF2E",
        "editor.background": "#232326ff",
        "editor.foreground": "#FFFFFF",
        "editorLineNumber.foreground": "#FFFFFF80",
        "editorLineNumber.activeForeground": "#FFFFFF",
        "editorLineHighlightBackground": "#FFFFFF12",
        "editorCursor.foreground": "#A493E8FF",
        "editor.selectionBackground": "#FFFFFF2E",
        "editor.selectionHighlightBackground": "#33A7DB25",
        "editor.wordHighlightBackground": "#33A7DB25",
        "editor.wordHighlightStrongBackground": "#8B73EE20",
        "editorBracketMatch.background": "#8B73EE18",
        "editorWhitespace.foreground": "#FFFFFF30",
        "editorIndentGuide.background1": "#FFFFFF22",
        "editorIndentGuide.activeBackground1": "#8B73EE50",
        "editorGutter.background": "#232326ff",
        "activityBar.background": "#232326ff",
        "activityBar.foreground": "#FFFFFF",
        "activityBar.inactiveForeground": "#FFFFFF9A",
        "activityBarBadge.background": "#A493E8FF",
        "activityBarBadge.foreground": "#FFFFFF",
        "sideBar.background": "#232326ff",
        "sideBar.foreground": "#FFFFFF",
        "sideBar.border": "#FFFFFF24",
        "titleBar.activeBackground": "#232326ff",
        "titleBar.inactiveBackground": "#313137ff",
        "titleBar.activeForeground": "#FFFFFF",
        "tab.activeBackground": "#232326ff",
        "tab.inactiveBackground": "#FFFFFF14",
        "tab.activeForeground": "#FFFFFF",
        "tab.inactiveForeground": "#FFFFFFB8",
        "tab.border": "#FFFFFF1D",
        "tab.activeBorderTop": "#8B73EE",
        "statusBar.background": "#232326ff",
        "statusBar.foreground": "#FFFFFF",
        "statusBar.border": "#FFFFFF24",
        "panel.background": "#232326ff",
        "panel.border": "#FFFFFF24",
        "input.background": "#232326ff",
        "input.foreground": "#FFFFFF",
        "input.placeholderForeground": "#FFFFFF78",
        "input.border": "#FFFFFF1D",
        "dropdown.background": "#232326ff",
        "dropdown.foreground": "#FFFFFF",
        "dropdown.border": "#FFFFFF1D",
        "list.hoverBackground": "#FFFFFF14",
        "list.activeSelectionBackground": "#FFFFFF2E",
        "list.inactiveSelectionBackground": "#FFFFFF2E",
        "list.activeSelectionForeground": "#FFFFFF",
        "list.inactiveSelectionForeground": "#FFFFFF",
        "scrollbarSlider.background": "#FFFFFF22",
        "scrollbarSlider.hoverBackground": "#FFFFFF42",
        "terminal.background": "#232326ff",
        "terminal.foreground": "#FFFFFF",
        "terminalCursor.foreground": "#FFFFFF",
        "terminal.ansiBlack": "#2c2c2e",
        "terminal.ansiRed": "#E05D4F",
        "terminal.ansiGreen": "#55C449",
        "terminal.ansiYellow": "#D2B13A",
        "terminal.ansiBlue": "#8B73EE",
        "terminal.ansiMagenta": "#D93D7F",
        "terminal.ansiCyan": "#33A7DB",
        "terminal.ansiWhite": "#FFFFFF",
        "terminal.ansiBrightBlack": "#8e8e93",
        "terminal.ansiBrightRed": "#F17367",
        "terminal.ansiBrightGreen": "#7DE06E",
        "terminal.ansiBrightYellow": "#F1CF52",
        "terminal.ansiBrightBlue": "#A58FFF",
        "terminal.ansiBrightMagenta": "#F06AA3",
        "terminal.ansiBrightCyan": "#62C7F2",
        "terminal.ansiBrightWhite": "#FFFFFF"
    },
    "tokenColors": [
        {
            "name": "zed:comment",
            "scope": ["comment"],
            "settings": { "foreground": "#AFA2FF" }
        },
        {
            "name": "zed:comment.doc",
            "scope": ["comment.block.documentation"],
            "settings": { "foreground": "#FF4F9A" }
        },
        {
            "name": "zed:keyword",
            "scope": ["keyword", "storage", "storage.type"],
            "settings": { "foreground": "#FF4F9A" }
        },
        {
            "name": "zed:operator",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#FF4F9A" }
        },
        {
            "name": "zed:attribute",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#FF4F9A" }
        },
        {
            "name": "zed:function",
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#66D85A" }
        },
        {
            "name": "zed:constructor",
            "scope": ["entity.name.type.class"],
            "settings": { "foreground": "#FF4F9A" }
        },
        {
            "name": "zed:type",
            "scope": ["entity.name.type", "support.type"],
            "settings": { "foreground": "#35D7FF" }
        },
        {
            "name": "zed:type.interface",
            "scope": ["entity.name.type.interface"],
            "settings": { "foreground": "#35D7FF", "fontStyle": "italic" }
        },
        {
            "name": "zed:type.super",
            "scope": ["entity.other.inherited-class"],
            "settings": { "foreground": "#35D7FF", "fontStyle": "italic" }
        },
        {
            "name": "zed:constant",
            "scope": ["constant"],
            "settings": { "foreground": "#FFFFFF" }
        },
        {
            "name": "zed:enum",
            "scope": ["entity.name.type.enum"],
            "settings": { "foreground": "#FFFFFF" }
        },
        {
            "name": "zed:number",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#FFFFFF" }
        },
        {
            "name": "zed:boolean",
            "scope": ["constant.language.boolean"],
            "settings": { "foreground": "#FF4F9A" }
        },
        {
            "name": "zed:string",
            "scope": ["string"],
            "settings": { "foreground": "#FFE85A" }
        },
        {
            "name": "zed:string.escape",
            "scope": ["constant.character.escape"],
            "settings": { "foreground": "#FF4F9A" }
        },
        {
            "name": "zed:string.regex",
            "scope": ["string.regexp"],
            "settings": { "foreground": "#FF6B5E" }
        },
        {
            "name": "zed:string.special",
            "scope": ["string.other"],
            "settings": { "foreground": "#FF4F9A" }
        },
        {
            "name": "zed:string.special.symbol",
            "scope": ["constant.other.symbol"],
            "settings": { "foreground": "#B894FF" }
        },
        {
            "name": "zed:text.literal",
            "scope": ["markup.raw", "markup.inline.raw"],
            "settings": { "foreground": "#66D85A" }
        },
        {
            "name": "zed:link_uri",
            "scope": ["markup.underline.link"],
            "settings": { "foreground": "#35D7FF" }
        },
        {
            "name": "zed:link_text",
            "scope": ["string.other.link.title"],
            "settings": { "foreground": "#FF4F9A" }
        },
        {
            "name": "zed:tag",
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#FF4F9A" }
        },
        {
            "name": "zed:property",
            "scope": ["variable.other.property"],
            "settings": { "foreground": "#35D7FF" }
        },
        {
            "name": "zed:variable",
            "scope": ["variable"],
            "settings": { "foreground": "#FFFFFF" }
        },
        {
            "name": "zed:variable.member",
            "scope": ["variable.other.member"],
            "settings": { "foreground": "#FFFFFF" }
        },
        {
            "name": "zed:variable.parameter",
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#FFFFFF", "fontStyle": "italic" }
        },
        {
            "name": "zed:variable.special",
            "scope": ["variable.language"],
            "settings": { "foreground": "#FFFFFF", "fontStyle": "italic" }
        },
        {
            "name": "zed:label",
            "scope": ["entity.name.label"],
            "settings": { "foreground": "#FFFFFF" }
        },
        {
            "name": "zed:title",
            "scope": ["entity.name.section"],
            "settings": { "foreground": "#9E78FF", "fontStyle": "bold" }
        },
        {
            "name": "zed:punctuation",
            "scope": ["punctuation"],
            "settings": { "foreground": "#FF4F9A" }
        },
        {
            "name": "zed:punctuation.bracket",
            "scope": ["punctuation.bracket"],
            "settings": { "foreground": "#35D7FF" }
        },
        {
            "name": "zed:punctuation.delimiter",
            "scope": ["punctuation.separator"],
            "settings": { "foreground": "#FF4F9A" }
        },
        {
            "name": "zed:punctuation.special",
            "scope": ["punctuation.definition.tag"],
            "settings": { "foreground": "#FF4F9A" }
        },
        {
            "name": "zed:preproc",
            "scope": ["meta.preprocessor"],
            "settings": { "foreground": "#AFA2FF" }
        },
        {
            "name": "zed:emphasis",
            "scope": ["markup.italic"],
            "settings": { "foreground": "#FFE85A", "fontStyle": "italic" }
        },
        {
            "name": "zed:emphasis.strong",
            "scope": ["markup.bold"],
            "settings": { "foreground": "#FF9A3D", "fontStyle": "bold" }
        }
    ],
    "semanticTokenColors": {
        "comment": "#AFA2FF",
        "keyword": "#FF4F9A",
        "function": "#66D85A",
        "method": "#66D85A",
        "type": "#35D7FF",
        "class": "#35D7FF",
        "interface": "#35D7FF",
        "enum": "#FFFFFF",
        "enumMember": "#FFFFFF",
        "variable": "#FFFFFF",
        "parameter": "#FFFFFF",
        "property": "#35D7FF",
        "string": "#FFE85A",
        "number": "#FFFFFF",
        "regexp": "#FF6B5E",
        "operator": "#FF4F9A"
    }
}
