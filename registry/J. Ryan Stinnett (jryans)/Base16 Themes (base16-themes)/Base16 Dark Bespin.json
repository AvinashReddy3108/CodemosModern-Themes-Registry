{
    "name": "Base16 Dark Bespin",
    "type": "dark",
    "tokenColors": [
        { "settings": { "background": "#28211c", "foreground": "#8a8986" } },
        {
            "name": "Text",
            "scope": "variable.parameter.function",
            "settings": { "foreground": "#8a8986" }
        },
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#666666" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation.definition.string",
                "punctuation.definition.variable",
                "punctuation.definition.string",
                "punctuation.definition.parameters",
                "punctuation.definition.string",
                "punctuation.definition.array"
            ],
            "settings": { "foreground": "#8a8986" }
        },
        {
            "name": "Delimiters",
            "scope": "none",
            "settings": { "foreground": "#8a8986" }
        },
        {
            "name": "Operators",
            "scope": "keyword.operator",
            "settings": { "foreground": "#8a8986" }
        },
        {
            "name": "Keywords",
            "scope": "keyword",
            "settings": { "foreground": "#9b859d" }
        },
        {
            "name": "Variables",
            "scope": "variable",
            "settings": { "foreground": "#cf6a4c" }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "meta.require",
                "support.function.any-method"
            ],
            "settings": { "foreground": "#5ea6ea" }
        },
        {
            "name": "Classes",
            "scope": [
                "support.class",
                "entity.name.class",
                "entity.name.type.class"
            ],
            "settings": { "foreground": "#f9ee98" }
        },
        {
            "name": "Classes",
            "scope": "meta.class",
            "settings": { "foreground": "#baae9e" }
        },
        {
            "name": "Methods",
            "scope": "keyword.other.special-method",
            "settings": { "foreground": "#5ea6ea" }
        },
        {
            "name": "Storage",
            "scope": "storage",
            "settings": { "foreground": "#9b859d" }
        },
        {
            "name": "Support",
            "scope": "support.function",
            "settings": { "foreground": "#afc4db" }
        },
        {
            "name": "Strings, Inherited Class",
            "scope": [
                "string",
                "constant.other.symbol",
                "entity.other.inherited-class"
            ],
            "settings": { "foreground": "#54be0d" }
        },
        {
            "name": "Integers",
            "scope": "constant.numeric",
            "settings": { "foreground": "#cf7d34" }
        },
        {
            "name": "Floats",
            "scope": "none",
            "settings": { "foreground": "#cf7d34" }
        },
        {
            "name": "Boolean",
            "scope": "none",
            "settings": { "foreground": "#cf7d34" }
        },
        {
            "name": "Constants",
            "scope": "constant",
            "settings": { "foreground": "#cf7d34" }
        },
        {
            "name": "Tags",
            "scope": "entity.name.tag",
            "settings": { "foreground": "#cf6a4c" }
        },
        {
            "name": "Attributes",
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#cf7d34" }
        },
        {
            "name": "Attribute IDs",
            "scope": [
                "entity.other.attribute-name.id",
                "punctuation.definition.entity"
            ],
            "settings": { "foreground": "#5ea6ea" }
        },
        {
            "name": "Selector",
            "scope": "meta.selector",
            "settings": { "foreground": "#9b859d" }
        },
        {
            "name": "Values",
            "scope": "none",
            "settings": { "foreground": "#cf7d34" }
        },
        {
            "name": "Headings",
            "scope": [
                "markup.heading punctuation.definition.heading",
                "entity.name.section"
            ],
            "settings": { "fontStyle": "", "foreground": "#5ea6ea" }
        },
        {
            "name": "Units",
            "scope": "keyword.other.unit",
            "settings": { "foreground": "#cf7d34" }
        },
        {
            "name": "Bold",
            "scope": ["markup.bold", "punctuation.definition.bold"],
            "settings": { "fontStyle": "bold", "foreground": "#f9ee98" }
        },
        {
            "name": "Italic",
            "scope": ["markup.italic", "punctuation.definition.italic"],
            "settings": { "fontStyle": "italic", "foreground": "#9b859d" }
        },
        {
            "name": "Code",
            "scope": "markup.raw.inline",
            "settings": { "foreground": "#54be0d" }
        },
        {
            "name": "Link Text",
            "scope": [
                "string.other.link",
                "punctuation.definition.string.end.markdown"
            ],
            "settings": { "foreground": "#cf6a4c" }
        },
        {
            "name": "Link Url",
            "scope": "meta.link",
            "settings": { "foreground": "#cf7d34" }
        },
        {
            "name": "Lists",
            "scope": "markup.list",
            "settings": { "foreground": "#cf6a4c" }
        },
        {
            "name": "Quotes",
            "scope": "markup.quote",
            "settings": { "foreground": "#cf7d34" }
        },
        {
            "name": "Separator",
            "scope": "meta.separator",
            "settings": { "background": "#5e5d5c", "foreground": "#8a8986" }
        },
        {
            "name": "Inserted",
            "scope": "markup.inserted",
            "settings": { "foreground": "#54be0d" }
        },
        {
            "name": "Deleted",
            "scope": "markup.deleted",
            "settings": { "foreground": "#cf6a4c" }
        },
        {
            "name": "Changed",
            "scope": "markup.changed",
            "settings": { "foreground": "#9b859d" }
        },
        {
            "name": "Colors",
            "scope": "constant.other.color",
            "settings": { "foreground": "#afc4db" }
        },
        {
            "name": "Regular Expressions",
            "scope": "string.regexp",
            "settings": { "foreground": "#afc4db" }
        },
        {
            "name": "Escape Characters",
            "scope": "constant.character.escape",
            "settings": { "foreground": "#afc4db" }
        },
        {
            "name": "Embedded",
            "scope": ["punctuation.section.embedded", "variable.interpolation"],
            "settings": { "foreground": "#937121" }
        },
        {
            "name": "Illegal",
            "scope": "invalid.illegal",
            "settings": { "background": "#cf6a4c", "foreground": "#baae9e" }
        },
        {
            "name": "Broken",
            "scope": "invalid.broken",
            "settings": { "background": "#cf7d34", "foreground": "#28211c" }
        },
        {
            "name": "Deprecated",
            "scope": "invalid.deprecated",
            "settings": { "background": "#937121", "foreground": "#baae9e" }
        },
        {
            "name": "Unimplemented",
            "scope": "invalid.unimplemented",
            "settings": { "background": "#666666", "foreground": "#baae9e" }
        }
    ],
    "colors": {
        "editor.background": "#28211c",
        "editorCursor.foreground": "#8a8986",
        "editor.foreground": "#8a8986",
        "editorWhitespace.foreground": "#666666",
        "editor.lineHighlightBackground": "#66666655",
        "editor.selectionBackground": "#5e5d5c",
        "sideBar.background": "#241d19",
        "sideBarTitle.foreground": "#8a8986",
        "activityBar.foreground": "#8a8986",
        "activityBar.background": "#3d3732",
        "activityBarBadge.background": "#7e7976",
        "statusBar.foreground": "#8a8986",
        "statusBar.background": "#3d3732",
        "statusBar.debuggingBackground": "#7e7976",
        "statusBar.noFolderBackground": "#7e7976",
        "statusBarItem.prominentBackground": "#a9a6a4",
        "statusBarItem.prominentHoverBackground": "#a9a6a499",
        "editorGroup.background": "#3d3732",
        "editorGroup.border": "#8a8986",
        "editorGroup.dropBackground": "#4a4543",
        "editorGroupHeader.tabsBackground": "#3d3732",
        "tab.activeBackground": "#28211c",
        "tab.inactiveBackground": "#3d3732",
        "notification.background": "#6b6766",
        "dropdown.background": "#a5a2a2",
        "dropdown.foreground": "#241d19",
        "button.background": "#4a4543",
        "button.foreground": "#8a8986",
        "list.activeSelectionBackground": "#3d3732",
        "list.dropBackground": "#3d3732",
        "list.focusBackground": "#3d3732",
        "list.hoverBackground": "#3d3732",
        "list.inactiveSelectionBackground": "#3d3732"
    },
    "$schema": "vscode://schemas/color-theme"
}
