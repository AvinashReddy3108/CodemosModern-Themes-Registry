{
    "name": "Dark Earth",
    "tokenColors": [
        { "settings": { "background": "#1e1e1e", "foreground": "#919191" } },
        {
            "scope": ["meta.embedded", "source.groovy.embedded"],
            "settings": { "background": "#1e1e1e", "foreground": "#919191" }
        },
        {
            "name": "Comment",
            "scope": "comment",
            "settings": { "fontStyle": "italic", "foreground": "#6a6a6a" }
        },
        {
            "name": "String",
            "scope": "string",
            "settings": { "foreground": "#859900" }
        },
        {
            "name": "Regexp",
            "scope": "string.regexp",
            "settings": { "foreground": "#dc322f" }
        },
        {
            "name": "Number",
            "scope": "constant.numeric",
            "settings": { "foreground": "#859900" }
        },
        {
            "name": "Variable",
            "scope": ["variable.language", "variable.other"],
            "settings": { "foreground": "#9e9e9e" }
        },
        {
            "name": "Keyword",
            "scope": ["keyword", "keyword.operator.word"],
            "settings": { "foreground": "#2aa198" }
        },
        {
            "name": "Operators",
            "scope": "keyword.operator",
            "settings": { "foreground": "#93a1a1" }
        },
        {
            "name": "Storage",
            "scope": "storage",
            "settings": { "foreground": "#2aa198" }
        },
        {
            "name": "Class name",
            "scope": ["entity.name.class", "entity.name.type"],
            "settings": { "fontStyle": "", "foreground": "#cc9a00" }
        },
        {
            "name": "Function name",
            "scope": "entity.name.function",
            "settings": { "foreground": "#cb6116" }
        },
        {
            "name": "Variable start",
            "scope": "punctuation.definition.variable",
            "settings": { "foreground": "#9e9e9e" }
        },
        {
            "name": "Embedded code markers",
            "scope": [
                "punctuation.section.embedded.begin",
                "punctuation.section.embedded.end"
            ],
            "settings": { "foreground": "#9e9e9e" }
        },
        {
            "name": "Built-in constant",
            "scope": ["constant.language", "meta.preprocessor"],
            "settings": { "foreground": "#6c71c4" }
        },
        {
            "name": "Preprocessor keyword",
            "scope": "keyword.control.directive",
            "settings": { "foreground": "#6a6a6a" }
        },
        {
            "name": "Support.construct",
            "scope": ["support.function.construct", "keyword.other.new"],
            "settings": { "foreground": "##268bd2" }
        },
        {
            "name": "User-defined constant",
            "scope": ["constant.character", "constant.other"],
            "settings": { "foreground": "#6c71c4" }
        },
        {
            "name": "Inherited class",
            "scope": "entity.other.inherited-class",
            "settings": { "foreground": "#cc9a00" }
        },
        {
            "name": "Function argument",
            "scope": "variable.parameter",
            "settings": { "foreground": "#9e9e9e" }
        },
        {
            "name": "Tag name",
            "scope": "entity.name.tag",
            "settings": { "foreground": "#268bd2" }
        },
        {
            "name": "Tag start/end",
            "scope": "punctuation.definition.tag",
            "settings": { "foreground": "#919191" }
        },
        {
            "name": "Tag attribute",
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#268bd2" }
        },
        {
            "name": "Library function",
            "scope": "support.function",
            "settings": { "foreground": "#cb6116" }
        },
        {
            "name": "Continuation",
            "scope": "punctuation.separator.continuation",
            "settings": { "foreground": "#6a6a6a" }
        },
        {
            "name": "Library constant",
            "scope": "support.constant",
            "settings": { "foreground": "#6c71c4" }
        },
        {
            "name": "Library class/type",
            "scope": ["support.type", "support.class"],
            "settings": { "foreground": "#cc9a00" }
        },
        {
            "name": "Library Exception",
            "scope": "support.type.exception",
            "settings": { "foreground": "#cc9a00" }
        },
        {
            "name": "Library variable",
            "scope": "support.other.variable",
            "settings": { "foreground": "#9e9e9e" }
        },
        {
            "name": "Invalid",
            "scope": "invalid",
            "settings": { "foreground": "#dc322f" }
        },
        {
            "name": "diff: header",
            "scope": ["meta.diff", "meta.diff.header"],
            "settings": {
                "background": "#cc9a00",
                "fontStyle": "italic",
                "foreground": "#e8e8e8"
            }
        },
        {
            "name": "diff: deleted",
            "scope": "markup.deleted",
            "settings": {
                "background": "#e8e8e8",
                "fontStyle": "",
                "foreground": "#dc322f"
            }
        },
        {
            "name": "diff: changed",
            "scope": "markup.changed",
            "settings": {
                "background": "#e8e8e8",
                "fontStyle": "",
                "foreground": "#cb6116"
            }
        },
        {
            "name": "diff: inserted",
            "scope": "markup.inserted",
            "settings": { "background": "#e8e8e8", "foreground": "#2aa198" }
        },
        {
            "name": "Markup Quote",
            "scope": "markup.quote",
            "settings": { "foreground": "#859900" }
        },
        {
            "name": "Markup Lists",
            "scope": "markup.list",
            "settings": { "foreground": "#cc9a00" }
        },
        {
            "name": "Markup Styling",
            "scope": ["markup.bold", "markup.italic"],
            "settings": { "foreground": "#d33682" }
        },
        {
            "name": "Markup Inline",
            "scope": "markup.inline.raw",
            "settings": { "fontStyle": "", "foreground": "#2aa198" }
        },
        {
            "name": "Markup Headings",
            "scope": "markup.heading",
            "settings": { "foreground": "#268bd2" }
        },
        {
            "name": "Markup Setext Header",
            "scope": "markup.heading.setext",
            "settings": { "fontStyle": "", "foreground": "#268bd2" }
        }
    ],
    "colors": {
        "focusBorder": "#2aa19899",
        "selection.background": "#268bd299",
        "input.background": "#252525",
        "input.foreground": "#9e9e9e",
        "input.placeholderForeground": "#9e9e9eAA",
        "inputOption.activeBorder": "#2aa19899",
        "errorForeground": "#e8e8e8",
        "dropdown.border": "#2aa19899",
        "button.background": "#2aa19899",
        "editor.background": "#1e1e1e",
        "editorCursor.foreground": "#e8e8e8",
        "editorWhitespace.foreground": "#9e9e9e30",
        "editor.lineHighlightBackground": "#252525",
        "editorLineNumber.foreground": "#6a6a6a",
        "editorActiveLineNumber.foreground": "#777777",
        "editor.selectionBackground": "#268bd299",
        "editor.selectionHighlightBackground": "#6a6a6a66",
        "editor.wordHighlightBackground": "#6a6a6a66",
        "editor.wordHighlightStrongBackground": "#6a6a6aAA",
        "sideBarTitle.foreground": "#9e9e9e",
        "statusBar.foreground": "#e8e8e8",
        "pickerGroup.foreground": "#2aa19899",
        "pickerGroup.border": "#2aa19899",
        "terminal.ansiBlack": "#252525",
        "terminal.ansiRed": "#dc322f",
        "terminal.ansiGreen": "#859900",
        "terminal.ansiYellow": "#cc9a00",
        "terminal.ansiBlue": "#268bd2",
        "terminal.ansiMagenta": "#d33682",
        "terminal.ansiCyan": "#2aa198",
        "terminal.ansiWhite": "#e8e8e8",
        "terminal.ansiBrightBlack": "#6a6a6a",
        "terminal.ansiBrightRed": "#cb6116",
        "terminal.ansiBrightGreen": "#6a6a6a",
        "terminal.ansiBrightYellow": "#777777",
        "terminal.ansiBrightBlue": "#919191",
        "terminal.ansiBrightMagenta": "#6c71c4",
        "terminal.ansiBrightCyan": "#9e9e9e",
        "terminal.ansiBrightWhite": "#f6f6f6"
    },
    "$schema": "vscode://schemas/color-theme"
}
