{"$schema":"vscode://schemas/color-theme","name":"Uniface Classic Dark","type":"dark","colors":{"editor.background":"#1E1E1E","editor.foreground":"#D4D4D4","editorLineNumber.foreground":"#5A9BD5","editorLineNumber.activeForeground":"#FFFFFF","editor.selectionBackground":"#264F78","editor.inactiveSelectionBackground":"#3A3D41","editorCursor.foreground":"#FFFFFF","editor.lineHighlightBackground":"#2A2A2A","editorGutter.background":"#252526","sideBar.background":"#252526","sideBar.foreground":"#CCCCCC","sideBarSectionHeader.background":"#0078D4","sideBarSectionHeader.foreground":"#FFFFFF","tab.activeBackground":"#1E1E1E","tab.inactiveBackground":"#2D2D2D","activityBar.background":"#333333","activityBar.foreground":"#FFFFFF","statusBar.background":"#007ACC","statusBar.foreground":"#FFFFFF"},"tokenColors":[{"name":"Comments - Light Green (readable on dark)","scope":["comment","comment.line.semicolon.uniface","comment.block.xml.uniface"],"settings":{"foreground":"#6A9955","fontStyle":""}},{"name":"Comment Markers (#Comment) - Cyan","scope":["keyword.other.comment-marker.uniface"],"settings":{"foreground":"#4EC9B0","fontStyle":""}},{"name":"Strings in ProcScript - Light Purple/Orchid","scope":["string.quoted.double.uniface","string.quoted.single.uniface"],"settings":{"foreground":"#CE9178"}},{"name":"Strings in XML attributes - Orange","scope":["string","string.quoted.xml.uniface","string.quoted.double.xml.uniface"],"settings":{"foreground":"#CE9178"}},{"name":"Section Headers (Declarations, Script) - Light Blue Bold","scope":["keyword.other.section.uniface"],"settings":{"foreground":"#569CD6","fontStyle":"bold"}},{"name":"Keywords - Operation - Light Blue Bold","scope":["keyword.control.operation.uniface"],"settings":{"foreground":"#569CD6","fontStyle":"bold"}},{"name":"Keywords - Entry/End - Light Blue Bold","scope":["keyword.control.entry.uniface"],"settings":{"foreground":"#569CD6","fontStyle":"bold"}},{"name":"Keywords - Block (params, variables, triggers) - Light Blu