{
    "name": "Qubik Dark",
    "type": "dark",
    "semanticHighlighting": true,
    "colors": {
        "editor.background": "#0B0B0F",
        "editor.foreground": "#E6E6E6",
        "editorLineNumber.foreground": "#32333B",
        "editorLineNumber.activeForeground": "#E6E6E6",
        "editor.selectionBackground": "#FFFFFF10",
        "editor.inactiveSelectionBackground": "#FFFFFF10",
        "editor.lineHighlightBackground": "#FFFFFF08",
        "editor.lineHighlightBorder": "#00000000",
        "editorCursor.foreground": "#E6E6E6",
        "editorWhitespace.foreground": "#32333B",
        "editorIndentGuide.background": "#32333B",
        "editorIndentGuide.activeBackground": "#46474F",
        "editorGutter.background": "#0B0B0F",
        "terminal.background": "#0B0B0F",
        "terminal.foreground": "#E6E6E6",
        "terminal.ansiBlack": "#0B0B0F",
        "terminal.ansiRed": "#D84F68",
        "terminal.ansiGreen": "#54C0A3",
        "terminal.ansiYellow": "#E6E7A3",
        "terminal.ansiBlue": "#479FFA",
        "terminal.ansiMagenta": "#9592A4",
        "terminal.ansiCyan": "#54C0A3",
        "terminal.ansiWhite": "#E6E6E6",
        "terminal.ansiBrightBlack": "#46474F",
        "terminal.ansiBrightRed": "#FF5C5C",
        "terminal.ansiBrightGreen": "#54C0A3",
        "terminal.ansiBrightYellow": "#F9B98C",
        "terminal.ansiBrightBlue": "#479FFA",
        "terminal.ansiBrightMagenta": "#9592A4",
        "terminal.ansiBrightCyan": "#54C0A3",
        "terminal.ansiBrightWhite": "#FFFFFF",
        "activityBar.background": "#0B0B0F",
        "sideBar.background": "#0B0B0F",
        "panel.background": "#0B0B0F",
        "statusBar.background": "#0B0B0F",
        "statusBar.foreground": "#E6E6E6",
        "titleBar.activeBackground": "#0B0B0F",
        "titleBar.activeForeground": "#E6E6E6",
        "list.hoverBackground": "#FFFFFF08",
        "list.activeSelectionBackground": "#FFFFFF10",
        "list.inactiveSelectionBackground": "#FFFFFF08",
        "list.highlightForeground": "#E6E6E6",
        "scrollbarSlider.background": "#2A2A2F80",
        "scrollbarSlider.hoverBackground": "#2A2A2F",
        "scrollbarSlider.activeBackground": "#2A2A2F",
        "button.background": "#2C2C33",
        "button.hoverBackground": "#FFFFFF10",
        "button.foreground": "#E6E6E6",
        "badge.background": "#2C2C33",
        "badge.foreground": "#E6E6E6",
        "input.background": "#2C2C33",
        "input.foreground": "#E6E6E6",
        "focusBorder": "#E6E6E670",
        "editorWidget.background": "#161616",
        "editor.findMatchBackground": "#FFFFFF16",
        "editor.findMatchHighlightBackground": "#FFFFFF10"
    },
    "semanticTokenColors": {
        "comment": { "foreground": "#5A5C65" },
        "keyword": { "foreground": "#00AEEF" },
        "string": { "foreground": "#F9C68A" },
        "variable": { "foreground": "#D7D7DF" },
        "property": { "foreground": "#E6E6E6" },
        "number": { "foreground": "#FD756C" },
        "boolean": { "foreground": "#F9B98C" },
        "type": { "foreground": "#E48842" },
        "class": { "foreground": "#E48842" },
        "function": { "foreground": "#D07A3B" },
        "function.method": { "foreground": "#E48842" },
        "operator": { "foreground": "#9099A1" },
        "namespace": { "foreground": "#00AEEF" },
        "macro": { "foreground": "#9592A4" },
        "string.escape": { "foreground": "#9592A4" },
        "punctuation": { "foreground": "#5C6974" },
        "tag": { "foreground": "#E48842" },
        "attribute": { "foreground": "#00AEEF" }
    },
    "tokenColors": [
        {
            "name": "Comment",
            "scope": "comment",
            "settings": { "foreground": "#5A5C65" }
        },
        {
            "name": "String",
            "scope": "string",
            "settings": { "foreground": "#F9C68A" }
        },
        {
            "name": "Keyword",
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#00AEEF" }
        },
        {
            "name": "Number",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#FD756C" }
        },
        {
            "name": "Boolean",
            "scope": ["constant.language.boolean"],
            "settings": { "foreground": "#F9B98C" }
        },
        {
            "name": "Function",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call"
            ],
            "settings": { "foreground": "#D07A3B" }
        },
        {
            "name": "Method",
            "scope": ["entity.name.function.method"],
            "settings": { "foreground": "#E48842" }
        },
        {
            "name": "Type",
            "scope": [
                "storage.type",
                "entity.name.type",
                "support.class",
                "support.type"
            ],
            "settings": { "foreground": "#E48842" }
        },
        {
            "name": "Variable",
            "scope": "variable",
            "settings": { "foreground": "#D7D7DF" }
        },
        {
            "name": "Property",
            "scope": "variable.other.property",
            "settings": { "foreground": "#E6E6E6" }
        },
        {
            "name": "Namespace",
            "scope": "entity.name.namespace",
            "settings": { "foreground": "#00AEEF" }
        },
        {
            "name": "Operator",
            "scope": "keyword.operator",
            "settings": { "foreground": "#9099A1" }
        },
        {
            "name": "Punctuation",
            "scope": ["punctuation", "meta.brace"],
            "settings": { "foreground": "#5C6974" }
        },
        {
            "name": "Tag",
            "scope": "entity.name.tag",
            "settings": { "foreground": "#E48842" }
        },
        {
            "name": "Attribute",
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#00AEEF" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
