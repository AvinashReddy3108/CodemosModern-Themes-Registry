        "minimapSlider.background": "#9000AC80",
        "minimapSlider.hoverBackground": "#9000ACa0",
        "notificationLink.foreground": "#3333EE",
        "notifications.background": "#000000",
        "notifications.foreground": "#ECECF5",
        "panel.background": "#000000",
        "panel.border": "#00000060",
        "panelTitle.activeBorder": "#3333EE",
        "panelTitle.activeForeground": "#F6F6FF",
        "panelTitle.inactiveForeground": "#ECECF5",
        "peekView.border": "#00000030",
        "peekViewEditor.background": "#ECECF505",
