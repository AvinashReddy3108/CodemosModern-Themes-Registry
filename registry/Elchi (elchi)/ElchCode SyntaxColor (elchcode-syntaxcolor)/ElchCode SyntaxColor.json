{
    "name": "ElchCode SyntaxColor",
    "type": "dark",
    "colors": {
        "editor.background": "#0a0a0a",
        "editor.foreground": "#ffffff"
    },
    "tokenColors": [
        {
            "scope": "entity.name.function.write.elch",
            "settings": { "foreground": "#ff5555", "fontStyle": "bold" }
        },
        {
            "scope": "support.function.var.elch",
            "settings": { "foreground": "#f1fa8c" }
        },
        {
            "scope": "keyword.control.conditional.if.elch",
            "settings": { "foreground": "#6272a4", "fontStyle": "italic" }
        },
        {
            "scope": "keyword.control.loop.while.elch",
            "settings": { "foreground": "#00aaff", "fontStyle": "italic" }
        },
        {
            "scope": "storage.type.variable.let.elch",
            "settings": { "foreground": "#ffb86c" }
        },
        {
            "scope": "string.quoted.double.elch",
            "settings": { "foreground": "#50fa7b" }
        },
        {
            "scope": "comment.line.double-slash.elch",
            "settings": { "foreground": "#888888", "fontStyle": "italic" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
