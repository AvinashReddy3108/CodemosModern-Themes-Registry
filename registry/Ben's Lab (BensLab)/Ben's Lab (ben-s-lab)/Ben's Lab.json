{
    "name": "Ben's Lab",
    "type": "dark",
    "colors": {
        "editor.background": "#3A0D0D",
        "editor.foreground": "#F5EDE2",
        "editorCursor.foreground": "#FFD166",
        "editor.lineHighlightBackground": "#4A1010AA",
        "editor.selectionBackground": "#6E1E1E88",
        "editor.selectionHighlightBackground": "#55111155",
        "editorBracketMatch.background": "#FFD16633",
        "editorBracketMatch.border": "#FFD166",
        "editorGutter.background": "#3A0D0D",
        "activityBar.background": "#2F0606",
        "activityBar.foreground": "#FFD166",
        "sideBar.background": "#2B0505",
        "sideBar.foreground": "#F5EDE2",
        "statusBar.background": "#1F0303",
        "statusBar.foreground": "#FFD166",
        "tab.activeBackground": "#3A0D0D",
        "tab.inactiveBackground": "#2B0505",
        "tab.activeForeground": "#FFD166",
        "tab.inactiveForeground": "#F5EDE2"
    },
    "tokenColors": [
        {
            "scope": "comment",
            "settings": { "foreground": "#B07777", "fontStyle": "italic" }
        },
        {
            "scope": "keyword",
            "settings": { "foreground": "#FF6F61", "fontStyle": "bold" }
        },
        { "scope": "string", "settings": { "foreground": "#FF9FA3" } },
        { "scope": "variable", "settings": { "foreground": "#F5EDE2" } },
        {
            "scope": "function",
            "settings": { "foreground": "#FFB380", "fontStyle": "bold" }
        },
        { "scope": "constant", "settings": { "foreground": "#FFD166" } },
        {
            "scope": "type",
            "settings": { "foreground": "#FF8C61", "fontStyle": "italic" }
        },
        { "scope": "storage", "settings": { "foreground": "#FF6F61" } },
        { "scope": "operator", "settings": { "foreground": "#FFB380" } },
        { "scope": "number", "settings": { "foreground": "#FFDD99" } },
        {
            "scope": "support.function",
            "settings": { "foreground": "#9C88FF" }
        },
        {
            "scope": "entity.name.class",
            "settings": { "foreground": "#61FFCB" }
        },
        { "scope": "entity.name.type", "settings": { "foreground": "#FF61C3" } }
    ],
    "$schema": "vscode://schemas/color-theme"
}
