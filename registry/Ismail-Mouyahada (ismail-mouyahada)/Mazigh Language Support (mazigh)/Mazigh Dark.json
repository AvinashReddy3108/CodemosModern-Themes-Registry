{
    "$schema": "vscode://schemas/color-theme",
    "name": "Mazigh Dark",
    "type": "dark",
    "colors": {
        "editor.background": "#1E1E1E",
        "editor.foreground": "#D4D4D4",
        "activityBarBadge.background": "#007ACC",
        "sideBarTitle.foreground": "#BBBBBB"
    },
    "tokenColors": [
        {
            "name": "Comments",
            "scope": [
                "comment.line.double-slash.mazigh",
                "comment.block.mazigh"
            ],
            "settings": { "foreground": "#6A9955" }
        },
        {
            "name": "Keywords",
            "scope": "keyword.control.mazigh",
            "settings": { "foreground": "#C586C0", "fontStyle": "bold" }
        },
        {
            "name": "Types",
            "scope": "storage.type.mazigh",
            "settings": { "foreground": "#569CD6" }
        },
        {
            "name": "Constants",
            "scope": "constant.language.mazigh",
            "settings": { "foreground": "#4EC9B0" }
        },
        {
            "name": "Strings",
            "scope": "string.quoted.double.mazigh",
            "settings": { "foreground": "#CE9178" }
        },
        {
            "name": "Numbers",
            "scope": "constant.numeric.mazigh",
            "settings": { "foreground": "#B5CEA8" }
        },
        {
            "name": "Functions",
            "scope": "entity.name.function.mazigh",
            "settings": { "foreground": "#DCDCAA" }
        }
    ]
}
