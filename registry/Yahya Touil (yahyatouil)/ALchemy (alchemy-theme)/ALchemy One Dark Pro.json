{
    "name": "ALchemy One Dark Pro",
    "type": "vs-dark",
    "colors": {
        "editor.background": "#282C34",
        "editor.foreground": "#ABB2BF",
        "editor.lineHighlightBackground": "#2C313C",
        "editor.selectionBackground": "#3E4451",
        "editor.wordHighlightBackground": "#61AFEF15",
        "editor.findMatchBackground": "#E5C07B50",
        "editor.hoverHighlightBackground": "#56B6C222",
        "editorCursor.foreground": "#56B6C2",
        "editorLineNumber.foreground": "#495162",
        "editorLineNumber.activeForeground": "#ABB2BF",
        "editorBracketMatch.border": "#56B6C2",
        "editorBracketMatch.background": "#56B6C220",
        "editorGutter.background": "#282C34",
        "editorGutter.addedBackground": "#98C379",
        "editorGutter.deletedBackground": "#E06C75",
        "editorGutter.modifiedBackground": "#E5C07B",
        "editorIndentGuide.background": "#2C313C88",
        "editorRuler.foreground": "#2C313C",
        "editorSuggestWidget.foreground": "#ABB2BF",
        "editorSuggestWidget.highlightForeground": "#56B6C2",
        "editorSuggestWidget.selectedBackground": "#3E4451",
        "editorLink.activeForeground": "#61AFEF",
        "activityBar.background": "#21252B",
        "activityBar.foreground": "#D7DAE0",
        "activityBar.inactiveForeground": "#4B5263",
        "activityBar.border": "#181A1F",
        "activityBarBadge.background": "#56B6C2",
        "activityBarBadge.foreground": "#21252B",
        "sideBar.background": "#21252B",
        "sideBar.foreground": "#9DA5B4",
        "sideBar.border": "#181A1F",
        "list.activeSelectionBackground": "#3E4451",
        "list.hoverBackground": "#2C313C",
        "list.highlightForeground": "#56B6C2",
        "statusBar.background": "#21252B",
        "statusBar.foreground": "#ABB2BF",
        "statusBar.border": "#181A1F",
        "statusBarItem.remoteBackground": "#56B6C2",
        "statusBarItem.remoteForeground": "#21252B",
        "titleBar.activeBackground": "#21252B",
        "titleBar.activeForeground": "#9DA5B4",
        "titleBar.border": "#181A1F",
        "tab.activeBackground": "#282C34",
        "tab.activeForeground": "#D7DAE0",
        "tab.inactiveBackground": "#21252B",
        "tab.inactiveForeground": "#5C6370",
        "tab.activeBorderTop": "#56B6C2",
        "tab.border": "#181A1F",
        "editorGroupHeader.tabsBackground": "#21252B",
        "panel.background": "#21252B",
        "panel.border": "#181A1F",
        "panelTitle.activeBorder": "#56B6C2",
        "panelTitle.activeForeground": "#ABB2BF",
        "terminal.background": "#21252B",
        "terminal.foreground": "#ABB2BF",
        "terminal.ansiBlack": "#2D3139",
        "terminal.ansiRed": "#E06C75",
        "terminal.ansiGreen": "#98C379",
        "terminal.ansiYellow": "#E5C07B",
        "terminal.ansiBlue": "#61AFEF",
        "terminal.ansiMagenta": "#C678DD",
        "terminal.ansiCyan": "#56B6C2",
        "terminal.ansiWhite": "#ABB2BF",
        "terminal.ansiBrightBlack": "#5C6370",
        "terminal.ansiBrightWhite": "#FFFFFF",
        "terminal.selectionBackground": "#3E4451",
        "scrollbarSlider.background": "#4B526380",
        "input.background": "#1D2026",
        "input.border": "#3E4451",
        "input.foreground": "#ABB2BF",
        "button.background": "#56B6C2",
        "button.foreground": "#21252B",
        "badge.background": "#56B6C2",
        "badge.foreground": "#21252B",
        "focusBorder": "#56B6C2",
        "foreground": "#ABB2BF",
        "widget.shadow": "#00000060",
        "gitDecoration.addedResourceForeground": "#98C379",
        "gitDecoration.modifiedResourceForeground": "#61AFEF",
        "gitDecoration.deletedResourceForeground": "#E06C75",
        "gitDecoration.ignoredResourceForeground": "#4B5263",
        "diffEditor.insertedTextBackground": "#98C37915",
        "diffEditor.removedTextBackground": "#E06C7515",
        "menu.background": "#21252B",
        "menu.foreground": "#ABB2BF",
        "menu.selectionBackground": "#3E4451",
        "menu.border": "#181A1F",
        "peekViewEditor.background": "#1D2026",
        "peekViewResult.background": "#21252B",
        "peekViewTitle.background": "#1D2026"
    },
    "tokenColors": [
        {
            "scope": [
                "comment",
                "comment.block",
                "comment.line",
                "punctuation.definition.comment"
            ],
            "settings": { "foreground": "#5C6370", "fontStyle": "italic" }
        },
        {
            "scope": [
                "string",
                "string.quoted",
                "string.quoted.single",
                "string.quoted.double",
                "punctuation.definition.string"
            ],
            "settings": { "foreground": "#98C379" }
        },
        {
            "scope": "constant.character.escape",
            "settings": { "foreground": "#98C379" }
        },
        {
            "scope": "constant.numeric",
            "settings": { "foreground": "#D19A66" }
        },
        {
            "scope": "constant.language",
            "settings": { "foreground": "#D19A66", "fontStyle": "italic" }
        },
        {
            "scope": ["constant.character", "constant.other"],
            "settings": { "foreground": "#D19A66" }
        },
        {
            "scope": [
                "keyword.other.table.al",
                "keyword.other.page.al",
                "keyword.other.codeunit.al",
                "keyword.other.report.al",
                "keyword.other.xmlport.al",
                "keyword.other.enum.al",
                "keyword.other.interface.al",
                "keyword.other.permissionset.al",
                "keyword.other.object.al",
                "storage.type.object.al",
                "keyword.other.query.al",
                "keyword.other.controladdin.al",
                "keyword.other.entitlement.al",
                "keyword.other.profile.al",
                "keyword.other.requestpage.al"
            ],
            "settings": { "foreground": "#C678DD", "fontStyle": "bold" }
        },
        {
            "scope": [
                "keyword.other.tableextension.al",
                "keyword.other.pageextension.al",
                "keyword.other.reportextension.al",
                "keyword.other.enumextension.al",
                "keyword.other.interfaceextension.al",
                "keyword.other.permissionsetextension.al"
            ],
            "settings": { "foreground": "#C678DD", "fontStyle": "bold italic" }
        },
        {
            "scope": [
                "entity.name.type.al",
                "entity.name.class.al",
                "entity.name.object.al"
            ],
            "settings": { "foreground": "#98C379", "fontStyle": "bold" }
        },
        {
            "scope": [
                "entity.name.function.al",
                "meta.function.al entity.name.function"
            ],
            "settings": { "foreground": "#61AFEF", "fontStyle": "bold" }
        },
        {
            "scope": [
                "entity.name.function.trigger.al",
                "entity.name.trigger.al",
                "support.function.trigger.al"
            ],
            "settings": { "foreground": "#56B6C2", "fontStyle": "italic" }
        },
        {
            "scope": [
                "keyword.other.event.al",
                "storage.type.event.al",
                "keyword.other.eventsubscriber.al"
            ],
            "settings": { "foreground": "#56B6C2", "fontStyle": "bold italic" }
        },
        {
            "scope": ["entity.name.field.al", "variable.other.field.al"],
            "settings": { "foreground": "#56B6C2" }
        },
        {
            "scope": [
                "support.type.property-name.al",
                "entity.other.attribute-name.al"
            ],
            "settings": { "foreground": "#ABB2BF" }
        },
        {
            "scope": [
                "variable.language.rec.al",
                "variable.other.rec.al",
                "variable.language.al"
            ],
            "settings": { "foreground": "#98C379", "fontStyle": "bold" }
        },
        {
            "scope": ["support.type.al", "storage.type.primitive.al"],
            "settings": { "foreground": "#E5C07B" }
        },
        {
            "scope": ["constant.other.enum.al", "variable.other.enummember.al"],
            "settings": { "foreground": "#D19A66" }
        },
        {
            "scope": ["storage.modifier.al", "keyword.other.local.al"],
            "settings": { "foreground": "#C678DD", "fontStyle": "italic" }
        },
        {
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.other",
                "storage.type",
                "storage.modifier"
            ],
            "settings": { "foreground": "#C678DD" }
        },
        {
            "scope": "keyword.operator",
            "settings": { "foreground": "#56B6C2" }
        },
        {
            "scope": [
                "keyword.operator.assignment",
                "keyword.operator.arithmetic",
                "keyword.operator.logical",
                "keyword.operator.comparison",
                "keyword.operator.relational"
            ],
            "settings": { "foreground": "#56B6C2" }
        },
        { "scope": "punctuation", "settings": { "foreground": "#5C6370" } },
        { "scope": "variable.other", "settings": { "foreground": "#ABB2BF" } },
        {
            "scope": "variable.language.this",
            "settings": { "foreground": "#98C379" }
        },
        {
            "scope": "variable.parameter",
            "settings": { "foreground": "#E06C75" }
        },
        {
            "scope": [
                "entity.name.function",
                "support.function.any-method",
                "variable.function"
            ],
            "settings": { "foreground": "#61AFEF", "fontStyle": "bold" }
        },
        {
            "scope": "support.function",
            "settings": { "foreground": "#61AFEF" }
        },
        {
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.class",
                "entity.other.inherited-class"
            ],
            "settings": { "foreground": "#E5C07B" }
        },
        {
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#ABB2BF" }
        },
        {
            "scope": "support.type.property-name.json",
            "settings": { "foreground": "#C678DD" }
        },
        {
            "scope": "entity.name.tag.yaml",
            "settings": { "foreground": "#C678DD" }
        },
        {
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#C678DD" }
        },
        {
            "scope": ["entity.name.namespace", "entity.name.module"],
            "settings": { "foreground": "#E5C07B" }
        },
        {
            "scope": "invalid",
            "settings": { "foreground": "#F87171", "fontStyle": "underline" }
        },
        {
            "scope": "markup.heading",
            "settings": { "foreground": "#C678DD", "fontStyle": "bold" }
        },
        {
            "scope": "markup.underline.link",
            "settings": { "foreground": "#61AFEF" }
        },
        { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
        { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } }
    ],
    "$schema": "vscode://schemas/color-theme"
}
