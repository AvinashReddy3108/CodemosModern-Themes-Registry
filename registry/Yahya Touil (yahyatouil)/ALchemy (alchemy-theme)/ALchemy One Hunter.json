{
    "name": "ALchemy One Hunter",
    "type": "vs-dark",
    "colors": {
        "editor.background": "#1A1B26",
        "editor.foreground": "#C0CAF5",
        "editor.lineHighlightBackground": "#1F213222",
        "editor.selectionBackground": "#364A82",
        "editor.wordHighlightBackground": "#7AA2F720",
        "editor.findMatchBackground": "#E0AF6840",
        "editor.hoverHighlightBackground": "#E0AF6822",
        "editorCursor.foreground": "#E0AF68",
        "editorLineNumber.foreground": "#3B4261",
        "editorLineNumber.activeForeground": "#737AA2",
        "editorBracketMatch.border": "#E0AF68",
        "editorBracketMatch.background": "#E0AF6825",
        "editorGutter.background": "#1A1B26",
        "editorGutter.addedBackground": "#9ECE6A",
        "editorGutter.deletedBackground": "#F7768E",
        "editorGutter.modifiedBackground": "#E0AF68",
        "editorIndentGuide.background": "#1F213288",
        "editorRuler.foreground": "#1F2132",
        "editorSuggestWidget.foreground": "#C0CAF5",
        "editorSuggestWidget.highlightForeground": "#E0AF68",
        "editorSuggestWidget.selectedBackground": "#283457",
        "editorLink.activeForeground": "#7AA2F7",
        "activityBar.background": "#16161E",
        "activityBar.foreground": "#C0CAF5",
        "activityBar.inactiveForeground": "#3B4261",
        "activityBar.border": "#101014",
        "activityBarBadge.background": "#E0AF68",
        "activityBarBadge.foreground": "#16161E",
        "sideBar.background": "#16161E",
        "sideBar.foreground": "#A9B1D6",
        "sideBar.border": "#101014",
        "sideBarTitle.foreground": "#3B4261",
        "sideBarSectionHeader.background": "#16161E",
        "sideBarSectionHeader.border": "#101014",
        "list.activeSelectionBackground": "#283457",
        "list.activeSelectionForeground": "#C0CAF5",
        "list.hoverBackground": "#1F2132",
        "list.highlightForeground": "#E0AF68",
        "statusBar.background": "#16161E",
        "statusBar.foreground": "#A9B1D6",
        "statusBar.border": "#101014",
        "statusBarItem.remoteBackground": "#E0AF68",
        "statusBarItem.remoteForeground": "#16161E",
        "titleBar.activeBackground": "#16161E",
        "titleBar.activeForeground": "#A9B1D6",
        "titleBar.border": "#101014",
        "tab.activeBackground": "#1A1B26",
        "tab.activeForeground": "#C0CAF5",
        "tab.inactiveBackground": "#16161E",
        "tab.inactiveForeground": "#3B4261",
        "tab.activeBorderTop": "#E0AF68",
        "tab.border": "#101014",
        "editorGroupHeader.tabsBackground": "#16161E",
        "panel.background": "#16161E",
        "panel.border": "#101014",
        "panelTitle.activeBorder": "#E0AF68",
        "panelTitle.activeForeground": "#C0CAF5",
        "terminal.background": "#16161E",
        "terminal.foreground": "#A9B1D6",
        "terminal.ansiBlack": "#1D202F",
        "terminal.ansiRed": "#F7768E",
        "terminal.ansiGreen": "#9ECE6A",
        "terminal.ansiYellow": "#E0AF68",
        "terminal.ansiBlue": "#7AA2F7",
        "terminal.ansiMagenta": "#BB9AF7",
        "terminal.ansiCyan": "#7DCFFF",
        "terminal.ansiWhite": "#A9B1D6",
        "terminal.ansiBrightBlack": "#414868",
        "terminal.ansiBrightWhite": "#C0CAF5",
        "terminal.selectionBackground": "#364A82",
        "scrollbarSlider.background": "#3B426180",
        "input.background": "#101014",
        "input.border": "#3B4261",
        "input.foreground": "#C0CAF5",
        "button.background": "#E0AF68",
        "button.foreground": "#16161E",
        "badge.background": "#E0AF68",
        "badge.foreground": "#16161E",
        "focusBorder": "#E0AF68",
        "foreground": "#A9B1D6",
        "widget.shadow": "#00000060",
        "gitDecoration.addedResourceForeground": "#9ECE6A",
        "gitDecoration.modifiedResourceForeground": "#7AA2F7",
        "gitDecoration.deletedResourceForeground": "#F7768E",
        "gitDecoration.ignoredResourceForeground": "#3B4261",
        "diffEditor.insertedTextBackground": "#9ECE6A15",
        "diffEditor.removedTextBackground": "#F7768E15",
        "menu.background": "#16161E",
        "menu.foreground": "#A9B1D6",
        "menu.selectionBackground": "#283457",
        "menu.border": "#101014",
        "peekViewEditor.background": "#101014",
        "peekViewResult.background": "#16161E",
        "peekViewTitle.background": "#101014"
    },
    "tokenColors": [
        {
            "scope": [
                "comment",
                "comment.block",
                "comment.line",
                "punctuation.definition.comment"
            ],
            "settings": { "foreground": "#414868", "fontStyle": "italic" }
        },
        {
            "scope": [
                "string",
                "string.quoted",
                "string.quoted.single",
                "string.quoted.double",
                "punctuation.definition.string"
            ],
            "settings": { "foreground": "#9ECE6A" }
        },
        {
            "scope": "constant.character.escape",
            "settings": { "foreground": "#9ECE6A" }
        },
        {
            "scope": "constant.numeric",
            "settings": { "foreground": "#E0AF68" }
        },
        {
            "scope": "constant.language",
            "settings": { "foreground": "#E0AF68", "fontStyle": "italic" }
        },
        {
            "scope": ["constant.character", "constant.other"],
            "settings": { "foreground": "#E0AF68" }
        },
        {
            "scope": [
                "keyword.other.table.al",
                "keyword.other.page.al",
                "keyword.other.codeunit.al",
                "keyword.other.report.al",
                "keyword.other.xmlport.al",
                "keyword.other.enum.al",
                "keyword.other.interface.al",
                "keyword.other.permissionset.al",
                "keyword.other.object.al",
                "storage.type.object.al",
                "keyword.other.query.al",
                "keyword.other.controladdin.al",
                "keyword.other.entitlement.al",
                "keyword.other.profile.al",
                "keyword.other.requestpage.al"
            ],
            "settings": { "foreground": "#BB9AF7", "fontStyle": "bold" }
        },
        {
            "scope": [
                "keyword.other.tableextension.al",
                "keyword.other.pageextension.al",
                "keyword.other.reportextension.al",
                "keyword.other.enumextension.al",
                "keyword.other.interfaceextension.al",
                "keyword.other.permissionsetextension.al"
            ],
            "settings": { "foreground": "#BB9AF7", "fontStyle": "bold italic" }
        },
        {
            "scope": [
                "entity.name.type.al",
                "entity.name.class.al",
                "entity.name.object.al"
            ],
            "settings": { "foreground": "#9ECE6A", "fontStyle": "bold" }
        },
        {
            "scope": [
                "entity.name.function.al",
                "meta.function.al entity.name.function"
            ],
            "settings": { "foreground": "#7AA2F7", "fontStyle": "bold" }
        },
        {
            "scope": [
                "entity.name.function.trigger.al",
                "entity.name.trigger.al",
                "support.function.trigger.al"
            ],
            "settings": { "foreground": "#7DCFFF", "fontStyle": "italic" }
        },
        {
            "scope": [
                "keyword.other.event.al",
                "storage.type.event.al",
                "keyword.other.eventsubscriber.al"
            ],
            "settings": { "foreground": "#7DCFFF", "fontStyle": "bold italic" }
        },
        {
            "scope": ["entity.name.field.al", "variable.other.field.al"],
            "settings": { "foreground": "#73DACA" }
        },
        {
            "scope": [
                "support.type.property-name.al",
                "entity.other.attribute-name.al"
            ],
            "settings": { "foreground": "#A9B1D6" }
        },
        {
            "scope": [
                "variable.language.rec.al",
                "variable.other.rec.al",
                "variable.language.al"
            ],
            "settings": { "foreground": "#9ECE6A", "fontStyle": "bold" }
        },
        {
            "scope": ["support.type.al", "storage.type.primitive.al"],
            "settings": { "foreground": "#FF9E64" }
        },
        {
            "scope": ["constant.other.enum.al", "variable.other.enummember.al"],
            "settings": { "foreground": "#E0AF68" }
        },
        {
            "scope": ["storage.modifier.al", "keyword.other.local.al"],
            "settings": { "foreground": "#BB9AF7", "fontStyle": "italic" }
        },
        {
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.other",
                "storage.type",
                "storage.modifier"
            ],
            "settings": { "foreground": "#BB9AF7" }
        },
        {
            "scope": "keyword.operator",
            "settings": { "foreground": "#89DDFF" }
        },
        {
            "scope": [
                "keyword.operator.assignment",
                "keyword.operator.arithmetic",
                "keyword.operator.logical",
                "keyword.operator.comparison",
                "keyword.operator.relational"
            ],
            "settings": { "foreground": "#89DDFF" }
        },
        { "scope": "punctuation", "settings": { "foreground": "#3B4261" } },
        { "scope": "variable.other", "settings": { "foreground": "#C0CAF5" } },
        {
            "scope": "variable.language.this",
            "settings": { "foreground": "#9ECE6A" }
        },
        {
            "scope": "variable.parameter",
            "settings": { "foreground": "#F7768E" }
        },
        {
            "scope": [
                "entity.name.function",
                "support.function.any-method",
                "variable.function"
            ],
            "settings": { "foreground": "#7AA2F7", "fontStyle": "bold" }
        },
        {
            "scope": "support.function",
            "settings": { "foreground": "#7AA2F7" }
        },
        {
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.class",
                "entity.other.inherited-class"
            ],
            "settings": { "foreground": "#FF9E64" }
        },
        {
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#A9B1D6" }
        },
        {
            "scope": "support.type.property-name.json",
            "settings": { "foreground": "#BB9AF7" }
        },
        {
            "scope": "entity.name.tag.yaml",
            "settings": { "foreground": "#BB9AF7" }
        },
        {
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#BB9AF7" }
        },
        {
            "scope": ["entity.name.namespace", "entity.name.module"],
            "settings": { "foreground": "#FF9E64" }
        },
        {
            "scope": "invalid",
            "settings": { "foreground": "#F87171", "fontStyle": "underline" }
        },
        {
            "scope": "markup.heading",
            "settings": { "foreground": "#BB9AF7", "fontStyle": "bold" }
        },
        {
            "scope": "markup.underline.link",
            "settings": { "foreground": "#7AA2F7" }
        },
        { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
        { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } }
    ],
    "$schema": "vscode://schemas/color-theme"
}
