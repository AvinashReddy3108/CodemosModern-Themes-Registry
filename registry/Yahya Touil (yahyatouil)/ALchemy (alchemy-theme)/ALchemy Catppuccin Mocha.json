{
    "name": "ALchemy Catppuccin Mocha",
    "type": "vs-dark",
    "colors": {
        "editor.background": "#1E1E2E",
        "editor.foreground": "#CDD6F4",
        "editor.lineHighlightBackground": "#313244",
        "editor.selectionBackground": "#45475A",
        "editor.wordHighlightBackground": "#89B4FA15",
        "editor.findMatchBackground": "#F9E2AF40",
        "editor.hoverHighlightBackground": "#89B4FA22",
        "editorCursor.foreground": "#F5C2E7",
        "editorLineNumber.foreground": "#585B70",
        "editorLineNumber.activeForeground": "#CDD6F4",
        "editorBracketMatch.border": "#89B4FA",
        "editorBracketMatch.background": "#89B4FA20",
        "editorGutter.background": "#1E1E2E",
        "editorGutter.addedBackground": "#A6E3A1",
        "editorGutter.deletedBackground": "#F38BA8",
        "editorGutter.modifiedBackground": "#F9E2AF",
        "editorIndentGuide.background": "#31324488",
        "editorRuler.foreground": "#313244",
        "editorSuggestWidget.foreground": "#CDD6F4",
        "editorSuggestWidget.highlightForeground": "#89B4FA",
        "editorSuggestWidget.selectedBackground": "#313244",
        "editorLink.activeForeground": "#89B4FA",
        "activityBar.background": "#181825",
        "activityBar.foreground": "#CDD6F4",
        "activityBar.inactiveForeground": "#585B70",
        "activityBar.border": "#11111B",
        "activityBarBadge.background": "#89B4FA",
        "activityBarBadge.foreground": "#1E1E2E",
        "sideBar.background": "#181825",
        "sideBar.foreground": "#CDD6F4",
        "sideBar.border": "#11111B",
        "sideBarTitle.foreground": "#585B70",
        "sideBarSectionHeader.background": "#181825",
        "sideBarSectionHeader.border": "#11111B",
        "list.activeSelectionBackground": "#313244",
        "list.activeSelectionForeground": "#CDD6F4",
        "list.hoverBackground": "#313244",
        "list.highlightForeground": "#89B4FA",
        "statusBar.background": "#181825",
        "statusBar.foreground": "#CDD6F4",
        "statusBar.border": "#11111B",
        "statusBarItem.remoteBackground": "#89B4FA",
        "statusBarItem.remoteForeground": "#1E1E2E",
        "titleBar.activeBackground": "#181825",
        "titleBar.activeForeground": "#CDD6F4",
        "titleBar.border": "#11111B",
        "tab.activeBackground": "#1E1E2E",
        "tab.activeForeground": "#CDD6F4",
        "tab.inactiveBackground": "#181825",
        "tab.inactiveForeground": "#585B70",
        "tab.activeBorderTop": "#89B4FA",
        "tab.border": "#11111B",
        "editorGroupHeader.tabsBackground": "#181825",
        "panel.background": "#181825",
        "panel.border": "#11111B",
        "panelTitle.activeBorder": "#89B4FA",
        "panelTitle.activeForeground": "#CDD6F4",
        "terminal.background": "#181825",
        "terminal.foreground": "#CDD6F4",
        "terminal.ansiBlack": "#45475A",
        "terminal.ansiRed": "#F38BA8",
        "terminal.ansiGreen": "#A6E3A1",
        "terminal.ansiYellow": "#F9E2AF",
        "terminal.ansiBlue": "#89B4FA",
        "terminal.ansiMagenta": "#CBA6F7",
        "terminal.ansiCyan": "#89DCEB",
        "terminal.ansiWhite": "#BAC2DE",
        "terminal.ansiBrightBlack": "#585B70",
        "terminal.ansiBrightWhite": "#CDD6F4",
        "terminal.selectionBackground": "#45475A",
        "scrollbarSlider.background": "#45475A80",
        "input.background": "#11111B",
        "input.border": "#45475A",
        "input.foreground": "#CDD6F4",
        "button.background": "#89B4FA",
        "button.foreground": "#1E1E2E",
        "badge.background": "#89B4FA",
        "badge.foreground": "#1E1E2E",
        "focusBorder": "#89B4FA",
        "foreground": "#CDD6F4",
        "widget.shadow": "#00000060",
        "gitDecoration.addedResourceForeground": "#A6E3A1",
        "gitDecoration.modifiedResourceForeground": "#89B4FA",
        "gitDecoration.deletedResourceForeground": "#F38BA8",
        "gitDecoration.ignoredResourceForeground": "#585B70",
        "diffEditor.insertedTextBackground": "#A6E3A115",
        "diffEditor.removedTextBackground": "#F38BA815",
        "menu.background": "#181825",
        "menu.foreground": "#CDD6F4",
        "menu.selectionBackground": "#313244",
        "menu.border": "#11111B",
        "peekViewEditor.background": "#11111B",
        "peekViewResult.background": "#181825",
        "peekViewTitle.background": "#11111B"
    },
    "tokenColors": [
        {
            "scope": [
                "comment",
                "comment.block",
                "comment.line",
                "punctuation.definition.comment"
            ],
            "settings": { "foreground": "#585B70", "fontStyle": "italic" }
        },
        {
            "scope": [
                "string",
                "string.quoted",
                "string.quoted.single",
                "string.quoted.double",
                "punctuation.definition.string"
            ],
            "settings": { "foreground": "#A6E3A1" }
        },
        {
            "scope": "constant.character.escape",
            "settings": { "foreground": "#A6E3A1" }
        },
        {
            "scope": "constant.numeric",
            "settings": { "foreground": "#FAB387" }
        },
        {
            "scope": "constant.language",
            "settings": { "foreground": "#FAB387", "fontStyle": "italic" }
        },
        {
            "scope": ["constant.character", "constant.other"],
            "settings": { "foreground": "#FAB387" }
        },
        {
            "scope": [
                "keyword.other.table.al",
                "keyword.other.page.al",
                "keyword.other.codeunit.al",
                "keyword.other.report.al",
                "keyword.other.xmlport.al",
                "keyword.other.enum.al",
                "keyword.other.interface.al",
                "keyword.other.permissionset.al",
                "keyword.other.object.al",
                "storage.type.object.al",
                "keyword.other.query.al",
                "keyword.other.controladdin.al",
                "keyword.other.entitlement.al",
                "keyword.other.profile.al",
                "keyword.other.requestpage.al"
            ],
            "settings": { "foreground": "#CBA6F7", "fontStyle": "bold" }
        },
        {
            "scope": [
                "keyword.other.tableextension.al",
                "keyword.other.pageextension.al",
                "keyword.other.reportextension.al",
                "keyword.other.enumextension.al",
                "keyword.other.interfaceextension.al",
                "keyword.other.permissionsetextension.al"
            ],
            "settings": { "foreground": "#CBA6F7", "fontStyle": "bold italic" }
        },
        {
            "scope": [
                "entity.name.type.al",
                "entity.name.class.al",
                "entity.name.object.al"
            ],
            "settings": { "foreground": "#A6E3A1", "fontStyle": "bold" }
        },
        {
            "scope": [
                "entity.name.function.al",
                "meta.function.al entity.name.function"
            ],
            "settings": { "foreground": "#89B4FA", "fontStyle": "bold" }
        },
        {
            "scope": [
                "entity.name.function.trigger.al",
                "entity.name.trigger.al",
                "support.function.trigger.al"
            ],
            "settings": { "foreground": "#89DCEB", "fontStyle": "italic" }
        },
        {
            "scope": [
                "keyword.other.event.al",
                "storage.type.event.al",
                "keyword.other.eventsubscriber.al"
            ],
            "settings": { "foreground": "#89DCEB", "fontStyle": "bold italic" }
        },
        {
            "scope": ["entity.name.field.al", "variable.other.field.al"],
            "settings": { "foreground": "#94E2D5" }
        },
        {
            "scope": [
                "support.type.property-name.al",
                "entity.other.attribute-name.al"
            ],
            "settings": { "foreground": "#CDD6F4" }
        },
        {
            "scope": [
                "variable.language.rec.al",
                "variable.other.rec.al",
                "variable.language.al"
            ],
            "settings": { "foreground": "#A6E3A1", "fontStyle": "bold" }
        },
        {
            "scope": ["support.type.al", "storage.type.primitive.al"],
            "settings": { "foreground": "#F9E2AF" }
        },
        {
            "scope": ["constant.other.enum.al", "variable.other.enummember.al"],
            "settings": { "foreground": "#FAB387" }
        },
        {
            "scope": ["storage.modifier.al", "keyword.other.local.al"],
            "settings": { "foreground": "#CBA6F7", "fontStyle": "italic" }
        },
        {
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.other",
                "storage.type",
                "storage.modifier"
            ],
            "settings": { "foreground": "#CBA6F7" }
        },
        {
            "scope": "keyword.operator",
            "settings": { "foreground": "#BAC2DE" }
        },
        {
            "scope": [
                "keyword.operator.assignment",
                "keyword.operator.arithmetic",
                "keyword.operator.logical",
                "keyword.operator.comparison",
                "keyword.operator.relational"
            ],
            "settings": { "foreground": "#BAC2DE" }
        },
        { "scope": "punctuation", "settings": { "foreground": "#6C7086" } },
        { "scope": "variable.other", "settings": { "foreground": "#CDD6F4" } },
        {
            "scope": "variable.language.this",
            "settings": { "foreground": "#A6E3A1" }
        },
        {
            "scope": "variable.parameter",
            "settings": { "foreground": "#F38BA8" }
        },
        {
            "scope": [
                "entity.name.function",
                "support.function.any-method",
                "variable.function"
            ],
            "settings": { "foreground": "#89B4FA", "fontStyle": "bold" }
        },
        {
            "scope": "support.function",
            "settings": { "foreground": "#89B4FA" }
        },
        {
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.class",
                "entity.other.inherited-class"
            ],
            "settings": { "foreground": "#F9E2AF" }
        },
        {
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#CDD6F4" }
        },
        {
            "scope": "support.type.property-name.json",
            "settings": { "foreground": "#CBA6F7" }
        },
        {
            "scope": "entity.name.tag.yaml",
            "settings": { "foreground": "#CBA6F7" }
        },
        {
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#CBA6F7" }
        },
        {
            "scope": ["entity.name.namespace", "entity.name.module"],
            "settings": { "foreground": "#F9E2AF" }
        },
        {
            "scope": "invalid",
            "settings": { "foreground": "#F87171", "fontStyle": "underline" }
        },
        {
            "scope": "markup.heading",
            "settings": { "foreground": "#CBA6F7", "fontStyle": "bold" }
        },
        {
            "scope": "markup.underline.link",
            "settings": { "foreground": "#89B4FA" }
        },
        { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
        { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } }
    ],
    "$schema": "vscode://schemas/color-theme"
}
