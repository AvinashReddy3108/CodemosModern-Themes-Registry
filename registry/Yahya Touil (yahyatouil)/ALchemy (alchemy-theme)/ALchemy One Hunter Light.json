{
    "name": "ALchemy One Hunter Light",
    "type": "vs",
    "colors": {
        "editor.background": "#F5F5F5",
        "editor.foreground": "#343B58",
        "editor.lineHighlightBackground": "#EAEAEA",
        "editor.selectionBackground": "#B6C3E8",
        "editorCursor.foreground": "#8C4351",
        "editorLineNumber.foreground": "#9699A3",
        "editorLineNumber.activeForeground": "#343B58",
        "editorBracketMatch.border": "#8C4351",
        "editorBracketMatch.background": "#8C435120",
        "editorGutter.background": "#F5F5F5",
        "editorGutter.addedBackground": "#485E30",
        "editorGutter.deletedBackground": "#8C4351",
        "editorGutter.modifiedBackground": "#965027",
        "editorIndentGuide.background": "#EAEAEA",
        "activityBar.background": "#EAEAEA",
        "activityBar.foreground": "#343B58",
        "activityBar.inactiveForeground": "#9699A3",
        "activityBarBadge.background": "#8C4351",
        "activityBarBadge.foreground": "#F5F5F5",
        "sideBar.background": "#EAEAEA",
        "sideBar.foreground": "#343B58",
        "sideBar.border": "#D5D6D8",
        "list.activeSelectionBackground": "#B6C3E8",
        "list.hoverBackground": "#EAEAEA",
        "list.highlightForeground": "#8C4351",
        "statusBar.background": "#EAEAEA",
        "statusBar.foreground": "#343B58",
        "statusBar.border": "#D5D6D8",
        "statusBarItem.remoteBackground": "#8C4351",
        "statusBarItem.remoteForeground": "#F5F5F5",
        "titleBar.activeBackground": "#EAEAEA",
        "titleBar.activeForeground": "#343B58",
        "tab.activeBackground": "#F5F5F5",
        "tab.activeForeground": "#343B58",
        "tab.inactiveBackground": "#EAEAEA",
        "tab.inactiveForeground": "#9699A3",
        "tab.activeBorderTop": "#8C4351",
        "tab.border": "#D5D6D8",
        "editorGroupHeader.tabsBackground": "#EAEAEA",
        "panel.background": "#EAEAEA",
        "panel.border": "#D5D6D8",
        "panelTitle.activeBorder": "#8C4351",
        "terminal.background": "#EAEAEA",
        "terminal.foreground": "#343B58",
        "scrollbarSlider.background": "#D5D6D880",
        "input.background": "#FFF",
        "input.border": "#D5D6D8",
        "input.foreground": "#343B58",
        "button.background": "#8C4351",
        "button.foreground": "#FFF",
        "badge.background": "#8C4351",
        "badge.foreground": "#FFF",
        "focusBorder": "#8C4351",
        "foreground": "#343B58",
        "gitDecoration.addedResourceForeground": "#485E30",
        "gitDecoration.modifiedResourceForeground": "#34548A",
        "gitDecoration.deletedResourceForeground": "#8C4351",
        "gitDecoration.ignoredResourceForeground": "#9699A3",
        "menu.background": "#FFF",
        "menu.foreground": "#343B58",
        "menu.selectionBackground": "#B6C3E8"
    },
    "tokenColors": [
        {
            "scope": [
                "comment",
                "comment.block",
                "comment.line",
                "punctuation.definition.comment"
            ],
            "settings": { "foreground": "#9699A3", "fontStyle": "italic" }
        },
        {
            "scope": [
                "string",
                "string.quoted",
                "string.quoted.single",
                "string.quoted.double",
                "punctuation.definition.string"
            ],
            "settings": { "foreground": "#485E30" }
        },
        {
            "scope": "constant.character.escape",
            "settings": { "foreground": "#485E30" }
        },
        {
            "scope": "constant.numeric",
            "settings": { "foreground": "#965027" }
        },
        {
            "scope": "constant.language",
            "settings": { "foreground": "#965027", "fontStyle": "italic" }
        },
        {
            "scope": ["constant.character", "constant.other"],
            "settings": { "foreground": "#965027" }
        },
        {
            "scope": [
                "keyword.other.table.al",
                "keyword.other.page.al",
                "keyword.other.codeunit.al",
                "keyword.other.report.al",
                "keyword.other.xmlport.al",
                "keyword.other.enum.al",
                "keyword.other.interface.al",
                "keyword.other.permissionset.al",
                "keyword.other.object.al",
                "storage.type.object.al",
                "keyword.other.query.al",
                "keyword.other.controladdin.al",
                "keyword.other.entitlement.al",
                "keyword.other.profile.al",
                "keyword.other.requestpage.al"
            ],
            "settings": { "foreground": "#5A4A78", "fontStyle": "bold" }
        },
        {
            "scope": [
                "keyword.other.tableextension.al",
                "keyword.other.pageextension.al",
                "keyword.other.reportextension.al",
                "keyword.other.enumextension.al",
                "keyword.other.interfaceextension.al",
                "keyword.other.permissionsetextension.al"
            ],
            "settings": { "foreground": "#5A4A78", "fontStyle": "bold italic" }
        },
        {
            "scope": [
                "entity.name.type.al",
                "entity.name.class.al",
                "entity.name.object.al"
            ],
            "settings": { "foreground": "#485E30", "fontStyle": "bold" }
        },
        {
            "scope": [
                "entity.name.function.al",
                "meta.function.al entity.name.function"
            ],
            "settings": { "foreground": "#34548A", "fontStyle": "bold" }
        },
        {
            "scope": [
                "entity.name.function.trigger.al",
                "entity.name.trigger.al",
                "support.function.trigger.al"
            ],
            "settings": { "foreground": "#0F4B6E", "fontStyle": "italic" }
        },
        {
            "scope": [
                "keyword.other.event.al",
                "storage.type.event.al",
                "keyword.other.eventsubscriber.al"
            ],
            "settings": { "foreground": "#0F4B6E", "fontStyle": "bold italic" }
        },
        {
            "scope": ["entity.name.field.al", "variable.other.field.al"],
            "settings": { "foreground": "#0F4B6E" }
        },
        {
            "scope": [
                "support.type.property-name.al",
                "entity.other.attribute-name.al"
            ],
            "settings": { "foreground": "#343B58" }
        },
        {
            "scope": [
                "variable.language.rec.al",
                "variable.other.rec.al",
                "variable.language.al"
            ],
            "settings": { "foreground": "#485E30", "fontStyle": "bold" }
        },
        {
            "scope": ["support.type.al", "storage.type.primitive.al"],
            "settings": { "foreground": "#8C4351" }
        },
        {
            "scope": ["constant.other.enum.al", "variable.other.enummember.al"],
            "settings": { "foreground": "#965027" }
        },
        {
            "scope": ["storage.modifier.al", "keyword.other.local.al"],
            "settings": { "foreground": "#5A4A78", "fontStyle": "italic" }
        },
        {
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.other",
                "storage.type",
                "storage.modifier"
            ],
            "settings": { "foreground": "#5A4A78" }
        },
        {
            "scope": "keyword.operator",
            "settings": { "foreground": "#343B58" }
        },
        {
            "scope": [
                "keyword.operator.assignment",
                "keyword.operator.arithmetic",
                "keyword.operator.logical",
                "keyword.operator.comparison",
                "keyword.operator.relational"
            ],
            "settings": { "foreground": "#343B58" }
        },
        { "scope": "punctuation", "settings": { "foreground": "#9699A3" } },
        { "scope": "variable.other", "settings": { "foreground": "#343B58" } },
        {
            "scope": "variable.language.this",
            "settings": { "foreground": "#485E30" }
        },
        {
            "scope": "variable.parameter",
            "settings": { "foreground": "#8C4351" }
        },
        {
            "scope": [
                "entity.name.function",
                "support.function.any-method",
                "variable.function"
            ],
            "settings": { "foreground": "#34548A", "fontStyle": "bold" }
        },
        {
            "scope": "support.function",
            "settings": { "foreground": "#34548A" }
        },
        {
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.class",
                "entity.other.inherited-class"
            ],
            "settings": { "foreground": "#8C4351" }
        },
        {
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#343B58" }
        },
        {
            "scope": "support.type.property-name.json",
            "settings": { "foreground": "#5A4A78" }
        },
        {
            "scope": "entity.name.tag.yaml",
            "settings": { "foreground": "#5A4A78" }
        },
        {
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#5A4A78" }
        },
        {
            "scope": ["entity.name.namespace", "entity.name.module"],
            "settings": { "foreground": "#8C4351" }
        },
        {
            "scope": "invalid",
            "settings": { "foreground": "#F87171", "fontStyle": "underline" }
        },
        {
            "scope": "markup.heading",
            "settings": { "foreground": "#5A4A78", "fontStyle": "bold" }
        },
        {
            "scope": "markup.underline.link",
            "settings": { "foreground": "#34548A" }
        },
        { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
        { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } }
    ],
    "$schema": "vscode://schemas/color-theme"
}
