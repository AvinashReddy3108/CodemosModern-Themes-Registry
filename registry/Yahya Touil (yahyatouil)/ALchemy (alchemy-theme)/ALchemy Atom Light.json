{
    "name": "ALchemy Atom Light",
    "type": "vs",
    "colors": {
        "editor.background": "#FAFAFA",
        "editor.foreground": "#383A42",
        "editor.lineHighlightBackground": "#E5E5E6",
        "editor.selectionBackground": "#CDD2E0",
        "editor.wordHighlightBackground": "#526FFF15",
        "editor.hoverHighlightBackground": "#526FFF15",
        "editorCursor.foreground": "#526FFF",
        "editorLineNumber.foreground": "#9D9D9F",
        "editorLineNumber.activeForeground": "#383A42",
        "editorBracketMatch.border": "#526FFF",
        "editorBracketMatch.background": "#526FFF20",
        "editorGutter.background": "#FAFAFA",
        "editorGutter.addedBackground": "#50A14F",
        "editorGutter.deletedBackground": "#E45649",
        "editorGutter.modifiedBackground": "#C18401",
        "editorIndentGuide.background": "#E5E5E6",
        "editorRuler.foreground": "#E5E5E6",
        "editorSuggestWidget.foreground": "#383A42",
        "editorSuggestWidget.highlightForeground": "#526FFF",
        "editorSuggestWidget.selectedBackground": "#D0D5E3",
        "activityBar.background": "#EFEFEF",
        "activityBar.foreground": "#494B52",
        "activityBar.inactiveForeground": "#9D9D9F",
        "activityBarBadge.background": "#526FFF",
        "activityBarBadge.foreground": "#FFF",
        "sideBar.background": "#F2F2F2",
        "sideBar.foreground": "#494B52",
        "sideBar.border": "#E0E0E0",
        "list.activeSelectionBackground": "#D0D5E3",
        "list.hoverBackground": "#E5E5E6",
        "list.highlightForeground": "#526FFF",
        "statusBar.background": "#EFEFEF",
        "statusBar.foreground": "#494B52",
        "statusBar.border": "#E0E0E0",
        "statusBarItem.remoteBackground": "#526FFF",
        "statusBarItem.remoteForeground": "#FFF",
        "titleBar.activeBackground": "#EFEFEF",
        "titleBar.activeForeground": "#494B52",
        "tab.activeBackground": "#FAFAFA",
        "tab.activeForeground": "#383A42",
        "tab.inactiveBackground": "#EFEFEF",
        "tab.inactiveForeground": "#9D9D9F",
        "tab.activeBorderTop": "#526FFF",
        "tab.border": "#E0E0E0",
        "editorGroupHeader.tabsBackground": "#EFEFEF",
        "panel.background": "#EFEFEF",
        "panel.border": "#E0E0E0",
        "panelTitle.activeBorder": "#526FFF",
        "terminal.background": "#F2F2F2",
        "terminal.foreground": "#383A42",
        "scrollbarSlider.background": "#CBCBCB80",
        "input.background": "#FFF",
        "input.border": "#CBCBCB",
        "input.foreground": "#383A42",
        "button.background": "#526FFF",
        "button.foreground": "#FFF",
        "badge.background": "#526FFF",
        "badge.foreground": "#FFF",
        "focusBorder": "#526FFF",
        "foreground": "#383A42",
        "gitDecoration.addedResourceForeground": "#50A14F",
        "gitDecoration.modifiedResourceForeground": "#526FFF",
        "gitDecoration.deletedResourceForeground": "#E45649",
        "gitDecoration.ignoredResourceForeground": "#9D9D9F",
        "menu.background": "#FFF",
        "menu.foreground": "#383A42",
        "menu.selectionBackground": "#D0D5E3"
    },
    "tokenColors": [
        {
            "scope": [
                "comment",
                "comment.block",
                "comment.line",
                "punctuation.definition.comment"
            ],
            "settings": { "foreground": "#A0A1A7", "fontStyle": "italic" }
        },
        {
            "scope": [
                "string",
                "string.quoted",
                "string.quoted.single",
                "string.quoted.double",
                "punctuation.definition.string"
            ],
            "settings": { "foreground": "#50A14F" }
        },
        {
            "scope": "constant.character.escape",
            "settings": { "foreground": "#50A14F" }
        },
        {
            "scope": "constant.numeric",
            "settings": { "foreground": "#986801" }
        },
        {
            "scope": "constant.language",
            "settings": { "foreground": "#986801", "fontStyle": "italic" }
        },
        {
            "scope": ["constant.character", "constant.other"],
            "settings": { "foreground": "#986801" }
        },
        {
            "scope": [
                "keyword.other.table.al",
                "keyword.other.page.al",
                "keyword.other.codeunit.al",
                "keyword.other.report.al",
                "keyword.other.xmlport.al",
                "keyword.other.enum.al",
                "keyword.other.interface.al",
                "keyword.other.permissionset.al",
                "keyword.other.object.al",
                "storage.type.object.al",
                "keyword.other.query.al",
                "keyword.other.controladdin.al",
                "keyword.other.entitlement.al",
                "keyword.other.profile.al",
                "keyword.other.requestpage.al"
            ],
            "settings": { "foreground": "#A626A4", "fontStyle": "bold" }
        },
        {
            "scope": [
                "keyword.other.tableextension.al",
                "keyword.other.pageextension.al",
                "keyword.other.reportextension.al",
                "keyword.other.enumextension.al",
                "keyword.other.interfaceextension.al",
                "keyword.other.permissionsetextension.al"
            ],
            "settings": { "foreground": "#A626A4", "fontStyle": "bold italic" }
        },
        {
            "scope": [
                "entity.name.type.al",
                "entity.name.class.al",
                "entity.name.object.al"
            ],
            "settings": { "foreground": "#50A14F", "fontStyle": "bold" }
        },
        {
            "scope": [
                "entity.name.function.al",
                "meta.function.al entity.name.function"
            ],
            "settings": { "foreground": "#4078F2", "fontStyle": "bold" }
        },
        {
            "scope": [
                "entity.name.function.trigger.al",
                "entity.name.trigger.al",
                "support.function.trigger.al"
            ],
            "settings": { "foreground": "#0184BC", "fontStyle": "italic" }
        },
        {
            "scope": [
                "keyword.other.event.al",
                "storage.type.event.al",
                "keyword.other.eventsubscriber.al"
            ],
            "settings": { "foreground": "#0184BC", "fontStyle": "bold italic" }
        },
        {
            "scope": ["entity.name.field.al", "variable.other.field.al"],
            "settings": { "foreground": "#0184BC" }
        },
        {
            "scope": [
                "support.type.property-name.al",
                "entity.other.attribute-name.al"
            ],
            "settings": { "foreground": "#383A42" }
        },
        {
            "scope": [
                "variable.language.rec.al",
                "variable.other.rec.al",
                "variable.language.al"
            ],
            "settings": { "foreground": "#50A14F", "fontStyle": "bold" }
        },
        {
            "scope": ["support.type.al", "storage.type.primitive.al"],
            "settings": { "foreground": "#C18401" }
        },
        {
            "scope": ["constant.other.enum.al", "variable.other.enummember.al"],
            "settings": { "foreground": "#986801" }
        },
        {
            "scope": ["storage.modifier.al", "keyword.other.local.al"],
            "settings": { "foreground": "#A626A4", "fontStyle": "italic" }
        },
        {
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.other",
                "storage.type",
                "storage.modifier"
            ],
            "settings": { "foreground": "#A626A4" }
        },
        {
            "scope": "keyword.operator",
            "settings": { "foreground": "#383A42" }
        },
        {
            "scope": [
                "keyword.operator.assignment",
                "keyword.operator.arithmetic",
                "keyword.operator.logical",
                "keyword.operator.comparison",
                "keyword.operator.relational"
            ],
            "settings": { "foreground": "#383A42" }
        },
        { "scope": "punctuation", "settings": { "foreground": "#A0A1A7" } },
        { "scope": "variable.other", "settings": { "foreground": "#383A42" } },
        {
            "scope": "variable.language.this",
            "settings": { "foreground": "#50A14F" }
        },
        {
            "scope": "variable.parameter",
            "settings": { "foreground": "#E45649" }
        },
        {
            "scope": [
                "entity.name.function",
                "support.function.any-method",
                "variable.function"
            ],
            "settings": { "foreground": "#4078F2", "fontStyle": "bold" }
        },
        {
            "scope": "support.function",
            "settings": { "foreground": "#4078F2" }
        },
        {
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.class",
                "entity.other.inherited-class"
            ],
            "settings": { "foreground": "#C18401" }
        },
        {
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#383A42" }
        },
        {
            "scope": "support.type.property-name.json",
            "settings": { "foreground": "#A626A4" }
        },
        {
            "scope": "entity.name.tag.yaml",
            "settings": { "foreground": "#A626A4" }
        },
        {
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#A626A4" }
        },
        {
            "scope": ["entity.name.namespace", "entity.name.module"],
            "settings": { "foreground": "#C18401" }
        },
        {
            "scope": "invalid",
            "settings": { "foreground": "#F87171", "fontStyle": "underline" }
        },
        {
            "scope": "markup.heading",
            "settings": { "foreground": "#A626A4", "fontStyle": "bold" }
        },
        {
            "scope": "markup.underline.link",
            "settings": { "foreground": "#4078F2" }
        },
        { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
        { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } }
    ],
    "$schema": "vscode://schemas/color-theme"
}
