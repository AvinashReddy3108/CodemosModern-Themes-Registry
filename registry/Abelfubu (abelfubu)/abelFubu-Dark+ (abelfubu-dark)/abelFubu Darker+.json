        "list.activeSelectionBackground": "#75beff30",
        "list.activeSelectionForeground": "#ffffffee",
        "list.dropBackground": "#383b3d",
        "list.filterMatchBackground": "#75beff60",
        "list.focusBackground": "#75beff60",
        "list.focusForeground": "#ffffff",
        "list.highlightForeground": "#75beff50",
        "list.hoverBackground": "#75beff30",
        "list.hoverForeground": "#ffffff",
        "list.inactiveSelectionBackground": "#75beff50",
        "list.inactiveSelectionForeground": "#ffffff",
        "listFilterWidget.background": "#75beff60",
        "menu.background": "#1a1f24",
        "menu.foreground": "#cccccc",
        "menu.selectionBackground": "#75beff50",
        "menubar.selectionBackground": "#1a1f24",
        "menubar.selectionBorder": "#373241",
        "menubar.selectionForeground": "#ffffff",
        "minimap.selectionHighlight": "#75beff50",
        "minimapGutter.modifiedBackground": "#75beff50",
        "notebook.cellInsertionIndicator": "#75beff99",
        "notebook.focusedEditorBorder": "#75beff50",
        "notificationLink.foreground": "#75beff50",
        "notifications.background": "#1a1f24",
        "panel.background": "#1a1f24",
