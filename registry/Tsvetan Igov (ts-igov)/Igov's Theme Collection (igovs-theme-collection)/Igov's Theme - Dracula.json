    "tokenColors": [
        {
            "scope": [
                "entity.other.attribute-name.html",
                "support.type.property-name",
                "punctuation.support.type.property-name.begin",
                "punctuation.support.type.property-name.end"
            ],
            "settings": { "foreground": "#bd93f9" }
        },
        {
            "scope": [
                "keyword",
                "keyword.operator.new",
                "storage",
                "punctuation.definition.keyword"
            ],
            "settings": { "foreground": "#ff79c6" }
        },
        {
            "scope": [
                "keyword.operator",
                "punctuation",
                "meta.selector.pseudo-class",
                "entity.other.attribute-name.pseudo-class"
            ],
            "settings": { "foreground": "#ff79c6" }
        },
        { "scope": ["constant"], "settings": { "foreground": "#50fa7b" } },
        {
            "scope": [
                "string",
                "punctuation.definition.string",
                "string.other.link.title.markdown",
                "meta.at-rule.apply.tailwind"
            ],
            "settings": { "foreground": "#50fa7b" }
        },
        {
            "scope": [
                "comment",
                "punctuation.definition.comment",
                "markup.fenced_code.block.markdown"
            ],
            "settings": { "foreground": "#6272a4" }
        },
        {
            "scope": ["meta.selector", "punctuation.definition.entity"],
            "settings": { "foreground": "#f1fa8c" }
        },
        { "scope": "entity.name.tag", "settings": { "foreground": "#ffb86c" } },
        { "scope": ["meta.function"], "settings": { "foreground": "#8be9fd" } },
        {
            "scope": "markup.italic.markdown",
            "settings": { "foreground": "#50fa7b", "fontStyle": "italic" }
        },
        {
            "scope": "markup.strikethrough.markdown",
            "settings": {
                "foreground": "#bd93f9",
                "fontStyle": "strikethrough"
            }
        },
        {
            "scope": "markup.underline.link",
            "settings": { "foreground": "#8be9fd", "fontStyle": "underline" }
        },
        {
            "scope": "markup.bold.markdown",
            "settings": { "foreground": "#ffb86c", "fontStyle": "bold" }
        },
        {
            "scope": ["markup.heading.markdown", "meta.separator.markdown"],
            "settings": { "foreground": "#ffb86c", "fontStyle": "bold" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
