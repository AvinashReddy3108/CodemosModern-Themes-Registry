{
    "$schema": "vscode://schemas/color-theme",
    "name": "Inkglow Storm",
    "type": "light",
    "colors": {
        "editor.background": "#faf8f5",
        "editor.foreground": "#2d2a26",
        "editorCursor.foreground": "#2255aa",
        "editor.lineHighlightBackground": "#f0ede8",
        "editor.selectionBackground": "#d4e5ff",
        "editorIndentGuide.background1": "#e0ddd8",
        "editorIndentGuide.activeBackground1": "#c0bdb8",
        "editorLineNumber.foreground": "#a0a0a0",
        "editorLineNumber.activeForeground": "#606060",
        "editorRuler.foreground": "#e0ddd8",
        "editorBracketMatch.background": "#d4e5ff",
        "editorBracketMatch.border": "#2266aa",
        "activityBar.background": "#f5f3f0",
        "activityBarBadge.background": "#2255aa",
        "sideBarTitle.foreground": "#606060",
        "tab.activeBackground": "#faf8f5",
        "tab.inactiveBackground": "#f5f3f0",
        "editorBracketHighlight.foreground1": "#cc6622",
        "editorBracketHighlight.foreground2": "#2266aa",
        "editorBracketHighlight.foreground3": "#884488",
        "editorBracketHighlight.foreground4": "#228855",
        "editorBracketHighlight.foreground5": "#cc4422",
        "editorBracketHighlight.foreground6": "#5544aa",
        "editorBracketHighlight.unexpectedBracket.foreground": "#cc2222",
        "sideBar.background": "#f5f3f0",
        "statusBar.background": "#f5f3f0",
        "titleBar.activeBackground": "#f5f3f0"
    },
    "tokenColors": [
        {
            "name": "comment",
            "scope": [
                "comment",
                "comment.line",
                "comment.line.double-slash",
                "comment.line.number-sign",
                "comment.line.semicolon",
                "comment.block",
                "comment.block.documentation",
                "punctuation.definition.comment",
                "string.comment"
            ],
            "settings": { "foreground": "#887799", "fontStyle": "italic" }
        },
        {
            "name": "keyword",
            "scope": ["keyword", "storage.type", "storage", "storage.modifier"],
            "settings": { "foreground": "#cc6622" }
        },
        {
            "name": "keyword.control",
            "scope": [
                "keyword.control",
                "keyword.control.loop",
                "keyword.control.conditional",
                "keyword.control.flow",
                "keyword.control.import",
                "keyword.control.export",
                "keyword.control.trycatch",
                "keyword.control.exception"
            ],
            "settings": { "foreground": "#2255aa" }
        },
        {
            "name": "operator",
            "scope": [
                "keyword.operator",
                "keyword.operator.arrow",
                "keyword.operator.assignment",
                "keyword.operator.comparison",
                "keyword.operator.logical",
                "keyword.operator.arithmetic",
                "keyword.operator.bitwise",
                "keyword.operator.ternary",
                "keyword.operator.spread",
                "keyword.operator.rest",
                "keyword.operator.typeof",
                "keyword.operator.instanceof",
                "keyword.operator.expression",
                "keyword.operator.new",
                "keyword.operator.delete",
                "keyword.operator.cast",
                "keyword.operator.sizeof",
                "keyword.operator.alignof",
                "keyword.operator.wordlike"
            ],
            "settings": { "foreground": "#bb5533" }
        },
        {
            "name": "string",
            "scope": [
                "string",
                "string.quoted",
                "string.quoted.double",
                "string.quoted.single",
                "string.quoted.other",
                "string.quoted.triple",
                "string.template",
                "meta.embedded.assembly"
            ],
            "settings": { "foreground": "#228855" }
        },
        {
            "name": "string.regexp",
            "scope": [
                "string.regexp",
                "source.regexp",
                "constant.regexp",
                "string.regexp.character-class",
                "string.regexp.arbitrary-repitition"
            ],
            "settings": { "foreground": "#228855" }
        },
        {
            "name": "escape",
            "scope": [
                "constant.character.escape",
                "string.regexp constant.character.escape"
            ],
            "settings": { "foreground": "#3a9a68", "fontStyle": "bold" }
        },
        {
            "name": "interpolation",
            "scope": [
                "punctuation.definition.template-expression.begin",
                "punctuation.definition.template-expression.end",
                "punctuation.section.embedded",
                "punctuation.section.embedded.begin",
                "punctuation.section.embedded.end"
            ],
            "settings": { "foreground": "#cc6622" }
        },
        {
            "name": "number",
            "scope": [
                "constant.numeric",
                "constant.numeric.decimal",
                "constant.numeric.integer",
                "constant.numeric.float",
                "constant.numeric.hex",
                "constant.numeric.binary",
                "constant.numeric.octal",
                "constant.numeric.dozenal",
                "keyword.other.unit"
            ],
            "settings": { "foreground": "#996622" }
        },
        {
            "name": "constant",
            "scope": ["constant.language", "variable.language"],
            "settings": { "foreground": "#5544aa", "fontStyle": "italic" }
        },
        {
            "name": "boolean",
            "scope": ["constant.language.boolean"],
            "settings": { "foreground": "#5544aa", "fontStyle": "italic" }
        },
        {
            "name": "type",
            "scope": [
                "entity.name.type",
                "support.type.builtin",
                "support.type.primitive"
            ],
            "settings": { "foreground": "#227799" }
        },
        {
            "name": "type.user",
            "scope": [
                "support.type",
                "entity.name.type.class",
                "entity.name.type.struct",
                "entity.name.type.enum",
                "entity.name.type.interface",
                "entity.name.type.alias",
                "entity.name.type.module",
                "entity.name.namespace",
                "entity.other.inherited-class",
                "support.class"
            ],
            "settings": { "foreground": "#227799" }
        },
        {
            "name": "type.nominal",
            "scope": ["support.type.nominal"],
            "settings": { "foreground": "#884488", "fontStyle": "italic" }
        },
        {
            "name": "type.comptime",
            "scope": ["support.type.comptime"],
            "settings": { "foreground": "#775522", "fontStyle": "italic" }
        },
        {
            "name": "typeParameter",
            "scope": ["entity.name.type.parameter", "support.type.parameter"],
            "settings": { "foreground": "#227799", "fontStyle": "italic" }
        },
        {
            "name": "function",
            "scope": [
                "entity.name.function",
                "support.function",
                "entity.name.operator.custom-literal",
                "support.constant.handlebars"
            ],
            "settings": { "foreground": "#338833" }
        },
        {
            "name": "variable",
            "scope": [
                "variable",
                "variable.other",
                "meta.definition.variable.name",
                "entity.name.variable"
            ],
            "settings": { "foreground": "#335588" }
        },
        {
            "name": "variable.constant",
            "scope": [
                "variable.other.constant",
                "variable.other.enummember",
                "entity.name.constant"
            ],
            "settings": { "foreground": "#224477", "fontStyle": "bold" }
        },
        {
            "name": "parameter",
            "scope": ["variable.parameter", "variable.parameter.function"],
            "settings": { "foreground": "#2266aa", "fontStyle": "italic" }
        },
        {
            "name": "parameter.output",
            "scope": ["variable.parameter.output"],
            "settings": { "foreground": "#cc4422", "fontStyle": "italic bold" }
        },
        {
            "name": "variable.global",
            "scope": ["variable.other.global"],
            "settings": { "foreground": "#aa4466" }
        },
        {
            "name": "property",
            "scope": [
                "variable.other.property",
                "variable.other.object.property",
                "support.variable",
                "meta.object-literal.key",
                "meta.property-name",
                "support.type.vendored.property-name",
                "support.type.property-name"
            ],
            "settings": { "foreground": "#335588" }
        },
        {
            "name": "tag",
            "scope": ["entity.name.tag", "support.class.component"],
            "settings": { "foreground": "#228855" }
        },
        {
            "name": "tag.punctuation",
            "scope": [
                "punctuation.definition.tag",
                "punctuation.definition.tag.begin",
                "punctuation.definition.tag.end"
            ],
            "settings": { "foreground": "#667788" }
        },
        {
            "name": "attribute",
            "scope": [
                "entity.other.attribute-name",
                "entity.name.decorator",
                "meta.decorator",
                "entity.name.function.decorator"
            ],
            "settings": { "foreground": "#995566" }
        },
        {
            "name": "accessor",
            "scope": [
                "punctuation.accessor",
                "punctuation.accessor.property",
                "punctuation.accessor.tuple",
                "punctuation.separator.dot-access"
            ],
            "settings": { "foreground": "#556677" }
        },
        {
            "name": "bracket",
            "scope": [
                "punctuation.bracket",
                "keyword.operator.bracket",
                "punctuation.definition.block",
                "punctuation.definition.parameters",
                "punctuation.definition.arguments"
            ],
            "settings": { "foreground": "#667788" }
        },
        {
            "name": "pointer",
            "scope": ["punctuation.accessor.pointer"],
            "settings": { "foreground": "#2277aa" }
        },
        {
            "name": "typepun",
            "scope": ["punctuation.accessor.typepun"],
            "settings": { "foreground": "#996622" }
        },
        {
            "name": "punctuation",
            "scope": [
                "punctuation.separator",
                "punctuation.separator.comma",
                "punctuation.terminator",
                "punctuation.terminator.statement"
            ],
            "settings": { "foreground": "#667788" }
        },
        {
            "name": "invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#cc2222" }
        },
        {
            "name": "deprecated",
            "scope": ["invalid.deprecated"],
            "settings": { "foreground": "#cc2222", "fontStyle": "italic" }
        },
        {
            "name": "support",
            "scope": ["support", "support.constant", "support.other"],
            "settings": { "foreground": "#335588" }
        },
        {
            "name": "meta.embedded",
            "scope": [
                "meta.embedded",
                "source.groovy.embedded",
                "meta.template.expression"
            ],
            "settings": { "foreground": "#2d2a26" }
        },
        {
            "name": "label",
            "scope": ["entity.name.label"],
            "settings": { "foreground": "#2d2a26" }
        },
        {
            "name": "preprocessor",
            "scope": [
                "meta.preprocessor",
                "entity.name.function.preprocessor",
                "keyword.control.directive"
            ],
            "settings": { "foreground": "#cc6622" }
        },
        {
            "name": "link",
            "scope": ["constant.other.reference.link", "string.other.link"],
            "settings": { "foreground": "#228855" }
        },
        {
            "name": "markup.heading",
            "scope": [
                "markup.heading",
                "heading.1.markdown",
                "heading.2.markdown",
                "heading.3.markdown",
                "heading.4.markdown",
                "heading.5.markdown",
                "heading.6.markdown",
                "entity.name.section",
                "entity.name.section.markdown",
                "markup.heading entity.name"
            ],
            "settings": { "foreground": "#2255aa", "fontStyle": "bold" }
        },
        {
            "name": "markup.heading.punctuation",
            "scope": ["punctuation.definition.heading.markdown"],
            "settings": { "foreground": "#3366aa" }
        },
        {
            "name": "markup.bold",
            "scope": ["markup.bold", "markup.bold.markdown"],
            "settings": { "foreground": "#cc6622", "fontStyle": "bold" }
        },
        {
            "name": "markup.italic",
            "scope": ["markup.italic", "markup.italic.markdown"],
            "settings": { "foreground": "#884488", "fontStyle": "italic" }
        },
        {
            "name": "markup.boldItalic",
            "scope": ["markup.bold markup.italic", "markup.italic markup.bold"],
            "settings": { "foreground": "#995577", "fontStyle": "bold italic" }
        },
        {
            "name": "markup.underline",
            "scope": ["markup.underline"],
            "settings": { "foreground": "#228855", "fontStyle": "underline" }
        },
        {
            "name": "markup.strikethrough",
            "scope": ["markup.strikethrough", "markup.strikethrough.markdown"],
            "settings": {
                "foreground": "#909090",
                "fontStyle": "strikethrough"
            }
        },
        {
            "name": "markup.link",
            "scope": [
                "markup.underline.link",
                "markup.underline.link.markdown",
                "markup.underline.link.image.markdown",
                "string.other.link.description.markdown"
            ],
            "settings": { "foreground": "#228855" }
        },
        {
            "name": "markup.link.text",
            "scope": ["string.other.link.title.markdown"],
            "settings": { "foreground": "#2266aa" }
        },
        {
            "name": "markup.code.inline",
            "scope": [
                "markup.inline.raw",
                "markup.inline.raw.string.markdown",
                "markup.raw.inline.markdown"
            ],
            "settings": { "foreground": "#996622" }
        },
        {
            "name": "markup.code.block",
            "scope": [
                "markup.fenced_code.block.markdown",
                "markup.raw.block.markdown"
            ],
            "settings": { "foreground": "#2d2a26" }
        },
        {
            "name": "markup.code.language",
            "scope": ["fenced_code.block.language.markdown"],
            "settings": { "foreground": "#227799" }
        },
        {
            "name": "markup.quote",
            "scope": [
                "markup.quote",
                "markup.quote.markdown",
                "punctuation.definition.quote.begin.markdown"
            ],
            "settings": { "foreground": "#887799", "fontStyle": "italic" }
        },
        {
            "name": "markup.list",
            "scope": [
                "punctuation.definition.list.begin.markdown",
                "beginning.punctuation.definition.list.markdown"
            ],
            "settings": { "foreground": "#bb5533" }
        },
        {
            "name": "markup.separator",
            "scope": ["meta.separator", "meta.separator.markdown"],
            "settings": { "foreground": "#c0bdb8" }
        },
        {
            "name": "markup.inserted",
            "scope": [
                "markup.inserted",
                "meta.diff.header.to-file",
                "punctuation.definition.inserted"
            ],
            "settings": { "foreground": "#228855" }
        },
        {
            "name": "markup.deleted",
            "scope": [
                "markup.deleted",
                "meta.diff.header.from-file",
                "punctuation.definition.deleted"
            ],
            "settings": { "foreground": "#cc2222" }
        },
        {
            "name": "markup.changed",
            "scope": ["markup.changed", "punctuation.definition.changed"],
            "settings": { "foreground": "#996622" }
        },
        {
            "name": "diff.range",
            "scope": ["meta.diff.range"],
            "settings": { "foreground": "#884488", "fontStyle": "bold" }
        },
        {
            "name": "diff.header",
            "scope": ["meta.diff.header"],
            "settings": { "foreground": "#2255aa" }
        },
        {
            "name": "json.property",
            "scope": [
                "support.type.property-name.json",
                "support.type.property-name.json.comments"
            ],
            "settings": { "foreground": "#228855" }
        },
        {
            "name": "css.property",
            "scope": [
                "support.type.property-name.css",
                "support.type.property-name.less",
                "support.type.property-name.scss"
            ],
            "settings": { "foreground": "#335588" }
        },
        {
            "name": "css.selector",
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css",
                "entity.other.attribute-name.pseudo-class.css",
                "entity.other.attribute-name.pseudo-element.css",
                "entity.other.attribute-name.scss",
                "entity.name.tag.css",
                "entity.name.tag.less"
            ],
            "settings": { "foreground": "#996622" }
        },
        {
            "name": "css.value",
            "scope": [
                "support.constant.property-value",
                "support.constant.color",
                "support.constant.font-name",
                "support.constant.media-type",
                "support.constant.media",
                "constant.other.color.rgb-value",
                "constant.other.rgb-value"
            ],
            "settings": { "foreground": "#228855" }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "parameter": { "foreground": "#2266aa", "fontStyle": "italic" },
        "parameter.output": {
            "foreground": "#cc4422",
            "fontStyle": "italic bold"
        },
        "variable": "#335588",
        "variable.readonly": { "foreground": "#224477", "fontStyle": "bold" },
        "variable.static": "#2255aa",
        "variable.static.readonly": {
            "foreground": "#334499",
            "fontStyle": "bold"
        },
        "function": "#338833",
        "function.declaration": {
            "foreground": "#338833",
            "fontStyle": "bold"
        },
        "type": "#227799",
        "type.declaration": { "foreground": "#227799", "fontStyle": "bold" }
    }
}
