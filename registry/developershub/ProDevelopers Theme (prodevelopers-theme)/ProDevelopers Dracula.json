{
    "name": "ProDevelopers Dracula Theme",
    "type": "dark",
    "colors": {
        "editor.background": "#282a36",
        "editor.foreground": "#f8f8f2",
        "editorLineNumber.foreground": "#44475a",
        "editorLineNumber.activeForeground": "#6272a4",
        "editorCursor.foreground": "#f8f8f0",
        "editor.selectionBackground": "#44475a",
        "editor.inactiveSelectionBackground": "#44475a80",
        "editor.lineHighlightBackground": "#3a3c4e",
        "activityBar.background": "#21222c",
        "activityBar.foreground": "#f8f8f2",
        "activityBar.activeBorder": "#ff79c6",
        "activityBar.inactiveForeground": "#6272a4",
        "sideBar.background": "#21222c",
        "sideBar.foreground": "#f8f8f2",
        "sideBar.border": "#3a3c4e",
        "sideBarTitle.foreground": "#bd93f9",
        "list.activeSelectionBackground": "#44475a",
        "list.activeSelectionForeground": "#f8f8f2",
        "list.hoverBackground": "#3a3c4e",
        "list.hoverForeground": "#f8f8f2",
        "list.inactiveSelectionBackground": "#3a3c4e",
        "list.inactiveSelectionForeground": "#ccceda",
        "statusBar.background": "#191a21",
        "statusBar.foreground": "#f8f8f2",
        "statusBar.border": "#3a3c4e",
        "tab.activeBackground": "#282a36",
        "tab.activeForeground": "#f8f8f2",
        "tab.inactiveBackground": "#21222c",
        "tab.inactiveForeground": "#6272a4",
        "tab.border": "#3a3c4e40",
        "tab.activeBorderTop": "#ff79c6",
        "panel.background": "#21222c",
        "panel.border": "#3a3c4e",
        "panelTitle.activeForeground": "#f8f8f2",
        "panelTitle.inactiveForeground": "#6272a4",
        "terminal.background": "#282a36",
        "terminal.foreground": "#f8f8f2",
        "terminal.ansiBlue": "#6272a4",
        "terminal.ansiCyan": "#8be9fd",
        "terminal.ansiGreen": "#50fa7b",
        "terminal.ansiRed": "#ff5555",
        "terminal.ansiYellow": "#f1fa8c",
        "titleBar.activeBackground": "#21222c",
        "titleBar.activeForeground": "#f8f8f2",
        "titleBar.border": "#3a3c4e",
        "badge.background": "#bd93f9",
        "badge.foreground": "#21222c",
        "button.background": "#44475a",
        "button.foreground": "#f8f8f2",
        "button.hoverBackground": "#6272a4",
        "input.background": "#21222c",
        "input.foreground": "#f8f8f2",
        "input.border": "#44475a",
        "focusBorder": "#bd93f9",
        "scrollbarSlider.background": "#44475a40",
        "scrollbarSlider.hoverBackground": "#6272a460",
        "scrollbarSlider.activeBackground": "#bd93f930",
        "editorGroupHeader.tabsBackground": "#21222c",
        "editorGroup.border": "#44475a",
        "tree.indentGuidesStroke": "#44475a"
    },
    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#6272a4", "fontStyle": "italic" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "string constant.other.placeholder"],
            "settings": { "foreground": "#f8f8f2" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#ff5555" }
        },
        {
            "name": "Keyword, Storage",
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#ff79c6" }
        },
        {
            "name": "Operator, Misc",
            "scope": [
                "keyword.control",
                "constant.other.color",
                "punctuation",
                "meta.tag",
                "punctuation.definition.tag",
                "punctuation.definition.tag.html",
                "punctuation.section.embedded",
                "keyword.other.template",
                "keyword.other.substitution"
            ],
            "settings": { "foreground": "#f8f8f2" }
        },
        {
            "name": "Tag",
            "scope": ["entity.name.tag", "meta.tag.sgml"],
            "settings": { "foreground": "#ff79c6" }
        },
        {
            "name": "Function, Special Method",
            "scope": [
                "entity.name.function",
                "meta.function-call",
                "variable.function",
                "support.function",
                "keyword.other.special-method"
            ],
            "settings": { "foreground": "#50fa7b" }
        },
        {
            "name": "Number, Constant",
            "scope": [
                "constant.numeric",
                "constant.language",
                "support.constant",
                "constant.character",
                "variable.parameter",
                "keyword.other.unit"
            ],
            "settings": { "foreground": "#bd93f9" }
        },
        {
            "name": "String, Symbols, Inherited Class",
            "scope": [
                "string",
                "constant.other.symbol",
                "constant.other.key",
                "entity.other.inherited-class",
                "markup.heading"
            ],
            "settings": { "foreground": "#f1fa8c" }
        },
        {
            "name": "Class, Support",
            "scope": ["entity.name", "support.type", "support.class"],
            "settings": { "foreground": "#8be9fd" }
        },
        {
            "name": "Attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#50fa7b" }
        },
        {
            "name": "HTML Attributes",
            "scope": ["text.html.basic entity.other.attribute-name"],
            "settings": { "fontStyle": "italic", "foreground": "#ffb86c" }
        },
        {
            "name": "CSS Classes",
            "scope": ["entity.other.attribute-name.class"],
            "settings": { "foreground": "#ffb86c" }
        },
        {
            "name": "Inserted",
            "scope": ["markup.inserted"],
            "settings": { "foreground": "#50fa7b" }
        },
        {
            "name": "Deleted",
            "scope": ["markup.deleted"],
            "settings": { "foreground": "#ff5555" }
        },
        {
            "name": "Changed",
            "scope": ["markup.changed"],
            "settings": { "foreground": "#ffb86c" }
        },
        {
            "name": "Regular Expressions",
            "scope": ["string.regexp"],
            "settings": { "foreground": "#8be9fd" }
        },
        {
            "name": "Escape Characters",
            "scope": ["constant.character.escape"],
            "settings": { "foreground": "#8be9fd" }
        },
        {
            "name": "URL",
            "scope": ["*url*", "*link*", "*uri*"],
            "settings": { "fontStyle": "underline" }
        },
        {
            "name": "Language methods",
            "scope": ["variable.language"],
            "settings": { "fontStyle": "italic", "foreground": "#ff5555" }
        },
        {
            "name": "Decorators",
            "scope": ["tag.decorator.js entity.name.tag.js"],
            "settings": { "fontStyle": "italic", "foreground": "#50fa7b" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
