ider.activeBackground":"#4caf5030","editorGroupHeader.tabsBackground":"#090f08","editorGroup.border":"#1a3018","tree.indentGuidesStroke":"#1e3a1c"},"tokenColors":[{"name":"Comment","scope":["comment","punctuation.definition.comment"],"settings":{"foreground":"#2e4a2e","fontStyle":"italic"}},{"name":"Variables","scope":["variable","string constant.other.placeholder"],"settings":{"foreground":"#c8e6c9"}},{"name":"Invalid","scope":["invalid","invalid.illegal"],"settings":{"foreground":"#e57373"}},{"name":"Keyword, Storage","scope":["keyword","storage.type","storage.modifier"],"settings":{"foreground":"#66bb6a"}},{"name":"Operator, Misc","scope":["keyword.control","constant.other.color","punctuation","meta.tag","punctuation.definition.tag","punctuation.definition.tag.html","punctuation.section.embedded","keyword.other.template","keyword.other.substitution"],"settings":{"foreground":"#81c784"}},{"name":"Tag","scope":["entity.name.tag","meta.tag.sgml"],"settings":{"foreground":"#a5d6a7"}},{"name":"Function, Special Method","scope":["entity.name.function","meta.function-call","variable.function","support.function","keyword.other.special-method"],"settings":{"foreground":"#4caf50"}},{"name":"Number, Constant","scope":["constant.numeric","constant.language","support.constant","constant.character","variable.parameter","keyword.other.unit"],"settings":{"foreground":"#ffcc80"}},{"name":"String, Symbols, Inherited Class","scope":["string","constant.other.symbol","constant.other.key","entity.other.inherited-class","markup.heading"],"settings":{"foreground":"#a5d6a7"}},{"name":"Class, Support","scope":["entity.name","support.type","support.class"],"settings":{"foreground":"#ffe082"}},{"name":"Attributes","scope":["entity.other.attribute-name"],"settings":{"foreground":"#66bb6a"}},{"name":"HTML Attributes","scope":["text.html.basic entity.other.attribute-name"],"settings":{"fontStyle":"italic","foreground":"#ffcc80"}},{"name":"CSS Classes","scope":["entity.other.attribute-name.clas