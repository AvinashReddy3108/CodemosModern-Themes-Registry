{
    "name": "Colorful Dark Theme",
    "type": "dark",
    "colors": {
        "editor.background": "#303d41",
        "editor.foreground": "#92bfbf",
        "editor.lineHighlightBackground": "#252525",
        "selection.background": "#4c4c4c",
        "editor.inactiveSelectionBackground": "#3c3c3c",
        "editor.findMatchHighlightBackground": "#f18260"
    },
    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "fontStyle": "italic", "foreground": "#777777" }
        },
        {
            "name": "Keywords and Part of punctuation",
            "scope": [
                "storage",
                "storage.type",
                "keyword",
                "constant",
                "variable.language.this",
                "variable.language.super",
                "punctuation.accessor",
                "punctuation.definition.tag",
                "punctuation.separator.key-value",
                "punctuation.decorator",
                "meta.tag",
                "entity.name.tag",
                "entity.other.attribute-name.pseudo-element.css",
                "entity.other.attribute-name.pseudo-class.css"
            ],
            "settings": { "foreground": "#ffdf81" }
        },
        {
            "name": "Variables",
            "scope": [
                "variable",
                "support.variable.property",
                "meta.brace.round.jsx",
                "meta.embedded.expression"
            ],
            "settings": { "foreground": "#92bfbf" }
        },
        {
            "name": "Class name",
            "scope": [
                "entity.name.function",
                "entity.name.type.js",
                "entity.name.type.ts",
                "entity.name.type.class",
                "entity.toher.inherited-class",
                "entity.name.type.interface.ts",
                "punctuation.definition.template-expression",
                "punctuation.section.embedded",
                "meta.tag.attribute-name",
                "keyword.other.unit",
                "entity.other.attribute-name.html"
            ],
            "settings": { "foreground": "#f49d62" }
        },
        {
            "name": "String",
            "scope": [
                "string",
                "support.type.property-name",
                "meta.object-literal.key",
                "support.type.vendored.property-name.css",
                "support.constant.propety-value.css",
                "meta.property-value.css"
            ],
            "settings": { "foreground": "#98c379" }
        },
        {
            "name": "ID",
            "scope": [
                "support",
                "entity.other.attribute-name.id",
                "meta.directive.vue entity.other.attribute-name.html"
            ],
            "settings": { "foreground": "#ee6666" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
