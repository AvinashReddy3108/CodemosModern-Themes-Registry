    "tokenColors": [
        {
            "scope": "comment",
            "settings": { "foreground": "#7FBF7F", "fontStyle": "italic" }
        },
        {
            "scope": "comment.block.documentation",
            "settings": { "foreground": "#8FD68F", "fontStyle": "italic" }
        },
        {
            "scope": ["keyword", "keyword.control", "storage", "storage.type"],
            "settings": { "foreground": "#C586FF" }
        },
        {
            "scope": "keyword.operator",
            "settings": { "foreground": "#FF79C6" }
        },
        {
            "scope": "keyword.operator.new",
            "settings": { "foreground": "#C586FF" }
        },
        {
            "scope": ["string", "string.quoted"],
            "settings": { "foreground": "#4FC1FF" }
        },
        {
            "scope": "string.regexp",
            "settings": { "foreground": "#50FA7B", "fontStyle": "bold" }
        },
        { "scope": "string.template", "settings": { "foreground": "#4FC1FF" } },
        {
            "scope": "punctuation.definition.string.begin.regexp",
            "settings": { "foreground": "#FF79C6" }
        },
        {
            "scope": "punctuation.definition.string.end.regexp",
            "settings": { "foreground": "#FF79C6" }
        },
        {
            "scope": "keyword.operator.quantifier.regexp",
            "settings": { "foreground": "#FFB86C" }
        },
        {
            "scope": "constant.character.escape.regexp",
