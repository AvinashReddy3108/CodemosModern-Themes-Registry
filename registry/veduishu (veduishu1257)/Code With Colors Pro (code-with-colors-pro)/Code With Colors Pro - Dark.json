        {
            "scope": "support.class.component.tsx",
            "settings": { "foreground": "#3ECF8E" }
        },
        {
            "scope": "entity.name.tag.jsx",
            "settings": { "foreground": "#FF5370" }
        },
        {
            "scope": "entity.name.tag.tsx",
            "settings": { "foreground": "#FF5370" }
