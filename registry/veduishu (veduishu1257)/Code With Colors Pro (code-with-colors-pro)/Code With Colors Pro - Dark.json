        "parameter": { "foreground": "#FFCB6B" },
        "namespace": { "foreground": "#4FC1FF" },
        "decorator": { "foreground": "#FF79C6" },
        "macro": { "foreground": "#FF79C6" },
        "string": { "foreground": "#4FC1FF" },
        "number": { "foreground": "#FFB86C" },
        "boolean": { "foreground": "#FF79C6" },
        "keyword": { "foreground": "#C586FF" },
        "operator": { "foreground": "#FF79C6" },
