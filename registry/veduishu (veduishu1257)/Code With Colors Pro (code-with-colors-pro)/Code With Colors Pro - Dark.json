    "semanticTokenColors": {
        "variable": { "foreground": "#FFD700" },
        "variable.readonly": { "foreground": "#FFB86C" },
        "property": { "foreground": "#82AAFF" },
        "property.readonly": { "foreground": "#82AAFF", "fontStyle": "italic" },
        "function": { "foreground": "#56B6FF" },
        "method": { "foreground": "#61AFEF" },
        "class": { "foreground": "#3ECF8E" },
        "interface": { "foreground": "#3ECF8E", "fontStyle": "italic" },
