{
    "name": "Code With Colors Pro - Neon Night",
    "type": "dark",
    "semanticHighlighting": true,
    "colors": {
        "focusBorder": "#C77DFF",
        "editor.background": "#0A0A0F",
        "editor.foreground": "#D8D8E8",
        "editorCursor.foreground": "#7DD3FC",
        "editor.lineHighlightBackground": "#1A1A2E",
        "editor.selectionBackground": "#C77DFF40",
        "editorLineNumber.foreground": "#4A4A6A",
        "editorLineNumber.activeForeground": "#7DD3FC",
        "editorIndentGuide.activeBackground1": "#C77DFF",
        "editorBracketHighlight.foreground1": "#7DD3FC",
        "editorBracketHighlight.foreground2": "#C77DFF",
        "editorBracketHighlight.foreground3": "#4ADE80",
        "editorBracketHighlight.foreground4": "#FACC15",
        "editorBracketHighlight.foreground5": "#F472B6",
        "editorBracketHighlight.foreground6": "#34D399",
        "activityBar.background": "#16213E",
        "activityBar.foreground": "#7DD3FC",
        "activityBar.inactiveForeground": "#4A4A6A",
        "activityBar.border": "#C77DFF30",
        "activityBarBadge.background": "#C77DFF",
        "activityBarBadge.foreground": "#FFFFFF",
        "sideBar.background": "#0F1624",
        "sideBar.foreground": "#D8D8E8",
        "sideBarTitle.foreground": "#7DD3FC",
        "sideBarSectionHeader.background": "#16213E",
        "sideBarSectionHeader.foreground": "#7DD3FC",
        "statusBar.background": "#C77DFF",
        "statusBar.foreground": "#FFFFFF",
        "tab.activeBackground": "#0A0A0F",
        "tab.activeForeground": "#7DD3FC",
        "tab.activeBorder": "#C77DFF",
        "tab.inactiveBackground": "#16213E",
        "tab.inactiveForeground": "#7A7A9A",
        "terminal.ansiCyan": "#7DD3FC",
        "terminal.ansiMagenta": "#C77DFF",
        "terminal.ansiGreen": "#4ADE80",
        "terminal.ansiYellow": "#FACC15",
        "gitDecoration.addedResourceForeground": "#4ADE80",
        "gitDecoration.modifiedResourceForeground": "#FACC15",
        "gitDecoration.deletedResourceForeground": "#F87171"
    },
    "tokenColors": [
        {
            "scope": "comment",
            "settings": { "foreground": "#7A7ACA", "fontStyle": "italic" }
        },
        {
            "scope": ["keyword", "storage"],
            "settings": { "foreground": "#C77DFF" }
        },
        { "scope": "string", "settings": { "foreground": "#4ADE80" } },
        {
            "scope": "constant.numeric",
            "settings": { "foreground": "#FACC15" }
        },
        { "scope": "variable", "settings": { "foreground": "#7DD3FC" } },
        {
            "scope": "entity.name.function",
            "settings": { "foreground": "#34D399" }
        },
        {
            "scope": "entity.name.type.class",
            "settings": { "foreground": "#A78BFA" }
        },
        { "scope": "entity.name.tag", "settings": { "foreground": "#F472B6" } },
        { "scope": "keyword.operator", "settings": { "foreground": "#FB923C" } }
    ],
    "semanticTokenColors": {
        "variable": { "foreground": "#7DD3FC" },
        "function": { "foreground": "#34D399" },
        "class": { "foreground": "#A78BFA" },
        "string": { "foreground": "#4ADE80" },
        "number": { "foreground": "#FACC15" }
    },
    "$schema": "vscode://schemas/color-theme"
}
