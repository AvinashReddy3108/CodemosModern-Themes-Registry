{
    "name": "Code With Colors Pro - Warm Sunset",
    "type": "dark",
    "semanticHighlighting": true,
    "colors": {
        "focusBorder": "#FF6188",
        "editor.background": "#2D2A2E",
        "editor.foreground": "#FCFCFA",
        "editorCursor.foreground": "#FFD866",
        "editor.lineHighlightBackground": "#3E3B40",
        "editor.selectionBackground": "#FF618840",
        "editorLineNumber.foreground": "#5B595C",
        "editorLineNumber.activeForeground": "#FFD866",
        "editorIndentGuide.activeBackground1": "#FF6188",
        "editorBracketHighlight.foreground1": "#FFD866",
        "editorBracketHighlight.foreground2": "#FF6188",
        "editorBracketHighlight.foreground3": "#FC9867",
        "editorBracketHighlight.foreground4": "#A9DC76",
        "editorBracketHighlight.foreground5": "#78DCE8",
        "editorBracketHighlight.foreground6": "#AB9DF2",
        "activityBar.background": "#1A1416",
        "activityBar.foreground": "#FF6188",
        "activityBar.inactiveForeground": "#8B7A7E",
        "activityBar.border": "#FF618840",
        "activityBarBadge.background": "#FF6188",
        "activityBarBadge.foreground": "#FFFFFF",
        "sideBar.background": "#221F22",
        "sideBar.foreground": "#C1C0C0",
        "sideBarTitle.foreground": "#FFD866",
        "sideBarSectionHeader.background": "#1A1416",
        "sideBarSectionHeader.foreground": "#FFD866",
        "statusBar.background": "#FF6188",
        "statusBar.foreground": "#FFFFFF",
        "tab.activeBackground": "#2D2A2E",
        "tab.activeForeground": "#FFD866",
        "tab.activeBorder": "#FF6188",
        "tab.inactiveBackground": "#221F22",
        "tab.inactiveForeground": "#727072",
        "terminal.ansiRed": "#FF6188",
        "terminal.ansiGreen": "#A9DC76",
        "terminal.ansiYellow": "#FFD866",
        "terminal.ansiBlue": "#78DCE8",
        "terminal.ansiMagenta": "#AB9DF2",
        "gitDecoration.addedResourceForeground": "#A9DC76",
        "gitDecoration.modifiedResourceForeground": "#FFD866",
        "gitDecoration.deletedResourceForeground": "#FF6188"
    },
    "tokenColors": [
        {
            "scope": "comment",
            "settings": { "foreground": "#727072", "fontStyle": "italic" }
        },
        {
            "scope": ["keyword", "storage"],
            "settings": { "foreground": "#FF6188" }
        },
        { "scope": "string", "settings": { "foreground": "#FFD866" } },
        {
            "scope": "constant.numeric",
            "settings": { "foreground": "#AB9DF2" }
        },
        { "scope": "variable", "settings": { "foreground": "#FCFCFA" } },
        {
            "scope": "entity.name.function",
            "settings": { "foreground": "#A9DC76" }
        },
        {
            "scope": "entity.name.type.class",
            "settings": { "foreground": "#78DCE8" }
        },
        { "scope": "entity.name.tag", "settings": { "foreground": "#FF6188" } },
        { "scope": "keyword.operator", "settings": { "foreground": "#FF6188" } }
    ],
    "semanticTokenColors": {
        "variable": { "foreground": "#FCFCFA" },
        "function": { "foreground": "#A9DC76" },
        "class": { "foreground": "#78DCE8" },
        "string": { "foreground": "#FFD866" },
        "number": { "foreground": "#AB9DF2" }
    },
    "$schema": "vscode://schemas/color-theme"
}
