{
    "type": "dark",
    "colors": {
        "input.background": "#180418",
        "input.border": "#240625",
        "inputOption.activeBorder": "#240625",
        "dropdown.background": "#180418",
        "dropdown.listBackground": "#180418",
        "list.focusBackground": "#0e020e",
        "list.activeSelectionBackground": "#0e020e",
        "list.inactiveSelectionBackground": "#0e020e",
        "list.inactiveSelectionForeground": "#5fdbce",
        "list.hoverBackground": "#0e020e",
        "button.background": "#0e020e",
        "button.hoverBackground": "#240625",
        "editor.background": "#240625",
        "editor.foreground": "#5fdbce",
        "editor.selectionBackground": "#490b4a",
        "editor.lineHighlightBackground": "#0e020e",
        "editor.hoverHighlightBackground": "#240625",
        "editorCursor.foreground": "#f3f2f4",
        "editorWhitespace.foreground": "#5fdbce",
        "editorWidget.foreground": "#5fdbce",
        "editorWidget.background": "#240625",
        "editorWidget.resizeBorder": "#180418",
        "editorHoverWidget.foreground": "#5fdbce",
        "editorHoverWidget.background": "#240625",
        "peekViewTitle.background": "#240625",
        "peekViewResult.background": "#240625",
        "peekViewEditor.background": "#180418",
        "tab.activeBackground": "#240625",
        "tab.inactiveBackground": "#180418",
        "tab.border": "#0e020e",
        "editorGroupHeader.tabsBackground": "#180418",
        "statusBar.background": "#180418",
        "statusBar.noFolderBackground": "#180418",
        "activityBar.background": "#180418",
        "activityBarBadge.background": "#240625",
        "sideBar.background": "#180418",
        "sideBar.foreground": "#5a7690",
        "sideBarSectionHeader.background": "#240625",
        "titleBar.activeBackground": "#180418",
        "statusBar.debuggingBackground": "#fd971f",
        "notifications.background": "#240625"
    },
    "tokenColors": [
        { "settings": { "foreground": "#5fdbce" } },
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#5a7690" }
        },
        {
            "name": "String",
            "scope": "string",
            "settings": { "foreground": "#ffdb89" }
        },
        {
            "name": "Number",
            "scope": "constant.numeric",
            "settings": { "foreground": "#b094de" }
        },
        {
            "name": "Built-in constant",
            "scope": "constant.language",
            "settings": { "foreground": "#b094de" }
        },
        {
            "name": "User-defined constant",
            "scope": ["constant.character", "constant.other"],
            "settings": { "foreground": "#b094de" }
        },
        {
            "name": "Variable",
            "scope": "variable",
            "settings": { "fontStyle": "" }
        },
        {
            "name": "Keyword",
            "scope": "keyword",
            "settings": { "foreground": "#e81266" }
        },
        {
            "name": "Storage",
            "scope": "storage",
            "settings": { "foreground": "#e81266" }
        },
        {
            "name": "Imports",
            "scope": ["keyword.control.import", "keyword.control.from"],
            "settings": { "foreground": "#e81266", "fontStyle": "italic" }
        },
        {
            "name": "Python Doc Strings",
            "scope": [
                "string.quoted.docstring.multi.python punctuation.definition.string.begin.python",
                "string.quoted.docstring.multi.python punctuation.definition.string.end.python",
                "string.quoted.docstring.multi.python"
            ],
            "settings": { "foreground": "#5a7690" }
        },
        {
            "name": "Python self as param",
            "scope": [
                "variable.parameter.function.language.special.self.python",
                "variable.parameter.function.language.special.cls.python"
            ],
            "settings": { "foreground": "#e81266", "fontStyle": "italic" }
        },
        {
            "name": "Python self - in function",
            "scope": [
                "variable.language.special.self.python",
                "variable.language.special.cls.python"
            ],
            "settings": { "foreground": "#e81266" }
        },
        {
            "name": "Python decorators",
            "scope": [
                "punctuation.definition.decorator.python",
                "meta.function.decorator.python",
                "support.type.python"
            ],
            "settings": { "foreground": "#45e36d" }
        },
        {
            "name": "Storage type",
            "scope": "storage.type",
            "settings": { "foreground": "#e81266", "fontStyle": "italic" }
        },
        {
            "name": "Class name",
            "scope": "entity.name.class",
            "settings": { "foreground": "#45e36d" }
        },
        {
            "name": "Inherited class",
            "scope": [
                "entity.other.inherited-class",
                "keyword.control.flow.js"
            ],
            "settings": { "foreground": "#45e36d" }
        },
        {
            "name": "Function name/call",
            "scope": [
                "entity.name.function",
                "meta.function-call.generic",
                "meta.function-call.js"
            ],
            "settings": { "fontStyle": "", "foreground": "#45e36d" }
        },
        {
            "name": "Function argument",
            "scope": "variable.parameter",
            "settings": { "foreground": "#fd971f" }
        },
        {
            "name": "Arguments",
            "scope": "variable.parameter.function",
            "settings": { "foreground": "#fd971f" }
        },
        {
            "name": "Tag name",
            "scope": [
                "entity.name.tag",
                "support.type.property-name.json",
                "keyword.control.flow.js"
            ],
            "settings": { "fontStyle": "", "foreground": "#e81266" }
        },
        {
            "name": "Tag attribute",
            "scope": [
                "entity.other.attribute-name",
                "variable.language.this.js"
            ],
            "settings": { "fontStyle": "", "foreground": "#45e36d" }
        },
        {
            "name": "Library function",
            "scope": "support.function",
            "settings": { "fontStyle": "", "foreground": "#45e36d" }
        },
        {
            "name": "Library constant",
            "scope": "support.constant",
            "settings": { "fontStyle": "", "foreground": "#45e36d" }
        },
        {
            "name": "Library class/type",
            "scope": ["support.type", "support.class"],
            "settings": { "foreground": "#e81266" }
        },
        {
            "name": "Library variable",
            "scope": "support.other.variable",
            "settings": { "fontStyle": "", "foreground": "#2980b9" }
        },
        {
            "name": "Invalid",
            "scope": "invalid",
            "settings": {
                "background": "#e81266",
                "fontStyle": "",
                "foreground": "#8cc8ec"
            }
        },
        {
            "name": "Invalid deprecated",
            "scope": "invalid.deprecated",
            "settings": { "background": "#b094de", "foreground": "#8cc8ec" }
        },
        {
            "name": "JSON String",
            "scope": "meta.structure.dictionary.json string.quoted.double.json",
            "settings": { "foreground": "#ffdb89" }
        },
        {
            "name": "JSON String",
            "scope": "meta.property-name.dictionary.json",
            "settings": { "foreground": "#e81266" }
        },
        {
            "name": "diff.header",
            "scope": ["meta.diff", "meta.diff.header"],
            "settings": { "foreground": "#75715e" }
        },
        {
            "name": "diff.deleted",
            "scope": "markup.deleted",
            "settings": { "foreground": "#e81266" }
        },
        {
            "name": "diff.inserted",
            "scope": "markup.inserted",
            "settings": { "foreground": "#45e36d" }
        },
        {
            "name": "diff.changed",
            "scope": "markup.changed",
            "settings": { "foreground": "#ffdb89" }
        },
        {
            "scope": "constant.numeric.line-number.find-in-files - match",
            "settings": { "foreground": "#b094de" }
        },
        {
            "scope": "entity.name.filename.find-in-files",
            "settings": { "foreground": "#e6db74" }
        },
        {
            "name": "Decorators",
            "scope": "tag.decorator.js tag.decorator.js punctuation.definition.tag.js",
            "settings": { "foreground": "#e6db74" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation.definition.array",
                "punctuation.definition.structure"
            ],
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Punctuation",
            "scope": ["punctuation.definition.string"],
            "settings": { "foreground": "#ffdb89" }
        },
        {
            "name": "ES7 Bind Operator",
            "scope": "source.js constant.other.object.key.js string.unquoted.label.js",
            "settings": { "foreground": "#e81266" }
        },
        {
            "name": "js string template variable",
            "scope": [
                "meta.template.expression variable",
                "meta.template.expression meta.brace.round",
                "meta.template.expression punctuation.accessor"
            ],
            "settings": { "fontStyle": "", "foreground": "#5fdbce" }
        },
        {
            "name": "js string template brackets",
            "scope": "meta.template.expression punctuation.definition.template-expression",
            "settings": { "fontStyle": "", "foreground": "#45e36d" }
        },
        {
            "name": "SASS name",
            "scope": "entity.name.selector",
            "settings": { "foreground": "#e81266" }
        },
        {
            "name": "SASS LESS variables",
            "scope": [
                "variable.less",
                "variable.ref.sass",
                "variable.decl.sass"
            ],
            "settings": { "foreground": "#ffdb89" }
        },
        {
            "name": "TS annotations",
            "scope": "annotation.parameters.ts",
            "settings": { "foreground": "#45e36d", "fontStyle": "" }
        },
        {
            "name": "TS annotations",
            "scope": [
                "annotation.function.name.ts",
                "annotation.function.primitive.support.ts",
                "annotation.entity.parameters.ts"
            ],
            "settings": { "foreground": "#e81266", "fontStyle": "" }
        },
        {
            "name": "Object keys, TS grammar specific",
            "scope": [
                "meta.object-literal.key",
                "meta.object-literal.key entity.name.function"
            ],
            "settings": { "foreground": "#e81266" }
        },
        {
            "name": "Markup Quote",
            "scope": ["markup.quote", "markup.bold.markdown"],
            "settings": { "foreground": "#45e36d" }
        },
        {
            "name": "Markup Quote",
            "scope": [
                "punctuation.definition.string.begin.markdown",
                "punctuation.definition.string.end.markdown",
                "punctuation.definition.metadata.markdown"
            ],
            "settings": { "foreground": "#5fdbce" }
        },
        {
            "name": "Markup Quote",
            "scope": [
                "string.other.link.description.markdown",
                "string.other.link.title.markdown"
            ],
            "settings": { "foreground": "#e81266" }
        },
        {
            "name": "Markup Lists",
            "scope": "markup.list",
            "settings": { "foreground": "#ffdb89" }
        },
        {
            "name": "code",
            "scope": [
                "fenced_code.block.language",
                "punctuation.definition.markdown"
            ],
            "settings": { "foreground": "#fd971f" }
        },
        {
            "name": "Markup Styling",
            "scope": "markup.bold, markup.italic",
            "settings": { "foreground": "#66d9ef" }
        },
        {
            "name": "Markup Inline",
            "scope": "markup.inline.raw",
            "settings": { "fontStyle": "", "foreground": "#fd971f" }
        },
        {
            "name": "Markup Setext Header",
            "scope": "markup.heading.setext",
            "settings": { "fontStyle": "", "foreground": "#e81266" }
        },
        {
            "name": "Markup Setext Header",
            "scope": [
                "markup.underline.link.image.markdown",
                "markup.underline.link.markdown"
            ],
            "settings": { "fontStyle": "", "foreground": "#e81266" }
        },
        {
            "name": "Markup Setext Header",
            "scope": "markup.heading",
            "settings": { "fontStyle": "", "foreground": "#e81266" }
        },
        {
            "scope": "token.info-token",
            "settings": { "foreground": "#6796e6" }
        },
        {
            "scope": "token.warn-token",
            "settings": { "foreground": "#cd9731" }
        },
        {
            "scope": "token.error-token",
            "settings": { "foreground": "#f44747" }
        },
        {
            "scope": "token.debug-token",
            "settings": { "foreground": "#b094de" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
