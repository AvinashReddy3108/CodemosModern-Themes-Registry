{
    "name": "Sun Rays",
    "colors": {
        "editor.background": "#FFF9E5",
        "editor.foreground": "#333333",
        "list.activeSelectionIconForeground": "#F0F8FF",
        "editor.selectionBackground": "#E3D9B0",
        "editor.lineHighlightBackground": "#F3ECD7",
        "editorCursor.foreground": "#666666",
        "terminal.background": "#e0dfdf",
        "terminal.foreground": "#333333",
        "terminal.ansiBlack": "#2E2E2E",
        "terminal.ansiRed": "#D16969",
        "terminal.ansiGreen": "#6A9955",
        "terminal.ansiYellow": "#D7BA7D",
        "terminal.ansiBlue": "#569CD6",
        "terminal.ansiMagenta": "#C586C0",
        "terminal.ansiCyan": "#4EC9B0",
        "terminal.ansiWhite": "#D4D4D4",
        "terminal.ansiBrightBlack": "#666666",
        "terminal.ansiBrightRed": "#F44747",
        "terminal.ansiBrightGreen": "#B5CEA8",
        "terminal.ansiBrightYellow": "#FFEB95",
        "terminal.ansiBrightBlue": "#9CDCFE",
        "terminal.ansiBrightMagenta": "#D19A66",
        "terminal.ansiBrightCyan": "#4EC9B0",
        "terminal.ansiBrightWhite": "#FFFFFF",
        "statusBar.background": "#FFD700",
        "statusBar.foreground": "#333333",
        "statusBar.noFolderBackground": "#FFEB95",
        "statusBar.debuggingBackground": "#FF4500",
        "statusBarItem.hoverBackground": "#FFD700"
    },
    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "fontStyle": "italic", "foreground": "#808080" }
        },
        {
            "name": "Documentation Comments",
            "scope": ["comment.documentation"],
            "settings": { "fontStyle": "italic", "foreground": "#7C8A7A" }
        },
        {
            "name": "Keywords",
            "scope": ["keyword", "storage"],
            "settings": { "fontStyle": "bold", "foreground": "#FF5733" }
        },
        {
            "name": "Functions",
            "scope": ["entity.name.function", "support.function"],
            "settings": { "fontStyle": "bold", "foreground": "#008080" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "support.variable"],
            "settings": { "fontStyle": "underline", "foreground": "#1f43b0" }
        },
        {
            "name": "Types",
            "scope": ["storage.type", "support.type"],
            "settings": { "fontStyle": "italic", "foreground": "#9932CC" }
        },
        {
            "name": "Strings",
            "scope": "string",
            "settings": { "fontStyle": "italic", "foreground": "#32CD32" }
        },
        {
            "name": "Numbers",
            "scope": ["constant.numeric"],
            "settings": { "fontStyle": "bold", "foreground": "#DAA520" }
        },
        {
            "name": "Punctuation",
            "scope": "punctuation",
            "settings": { "foreground": "#FF6347" }
        },
        {
            "name": "Operators",
            "scope": "keyword.operator",
            "settings": { "fontStyle": "bold", "foreground": "#FF4500" }
        },
        {
            "name": "Constants",
            "scope": ["constant.language", "support.constant"],
            "settings": { "foreground": "#B22222" }
        },
        {
            "name": "Classes",
            "scope": ["entity.name.type", "support.class"],
            "settings": { "fontStyle": "bold italic", "foreground": "#9370DB" }
        },
        {
            "name": "Parameters",
            "scope": "variable.parameter",
            "settings": { "fontStyle": "italic", "foreground": "#D2691E" }
        },
        {
            "name": "Invalid",
            "scope": "invalid.illegal",
            "settings": { "foreground": "#DC143C", "fontStyle": "underline" }
        },
        {
            "name": "Diff Range",
            "scope": ["meta.diff.range", "meta.diff.index", "meta.separator"],
            "settings": { "foreground": "#606060" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
