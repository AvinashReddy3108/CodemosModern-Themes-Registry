{
    "name": "Synergy DBL Theme",
    "type": "dark",
    "colors": {
        "editor.background": "#1E1E1E",
        "editor.foreground": "#9CDCFE"
    },
    "tokenColors": [
        {
            "scope": "keyword.control.dbl",
            "settings": { "foreground": "#C586C0" }
        },
        {
            "scope": "storage.type.dbl",
            "settings": { "foreground": "#4EC9B0" }
        },
        {
            "scope": ["storage.modifier.dbl", "storage.modifier.parameter.dbl"],
            "settings": { "foreground": "#569CD6" }
        },
        {
            "scope": "keyword.other.call.dbl",
            "settings": { "foreground": "#DCDCAA" }
        },
        {
            "scope": "keyword.other.size.dbl",
            "settings": { "foreground": "#569CD6" }
        },
        {
            "scope": "keyword.operator.at.dbl",
            "settings": { "foreground": "#569CD6" }
        },
        {
            "scope": "keyword.control.goto.dbl",
            "settings": { "foreground": "#D16969" }
        },
        {
            "scope": "variable.language.dbl",
            "settings": { "foreground": "#9CDCFE" }
        },
        {
            "scope": "support.function.dbl",
            "settings": { "foreground": "#4EC9B0" }
        },
        {
            "scope": "comment.line.semicolon.dbl",
            "settings": { "foreground": "#6A9955" }
        },
        {
            "scope": "constant.numeric.dbl",
            "settings": { "foreground": "#B5CEA8" }
        },
        {
            "scope": "entity.name.tag.directive.dbl",
            "settings": { "foreground": "#C586C0" }
        },
        {
            "scope": ["string.quoted.double.dbl", "string.quoted.single.dbl"],
            "settings": { "foreground": "#CE9178" }
        },
        {
            "scope": "constant.character.escape.dbl",
            "settings": { "foreground": "#D7BA7D" }
        },
        {
            "scope": "variable.other.dbl",
            "settings": { "foreground": "#D4D4D4" }
        },
        {
            "scope": "variable.other.member.dbl",
            "settings": { "foreground": "#9CDCFE" }
        },
        {
            "scope": "entity.name.type.record.dbl",
            "settings": { "foreground": "#4EC9B0" }
        },
        {
            "scope": "punctuation.definition.dbl",
            "settings": { "foreground": "#D4D4D4" }
        },
        {
            "scope": "keyword.operator.logical.dbl",
            "settings": { "foreground": "#569CD6" }
        },
        {
            "scope": "keyword.operator.arithmetic.dbl",
            "settings": { "foreground": "#D4D4D4" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
