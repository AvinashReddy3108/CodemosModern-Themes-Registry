    "tokenColors": [
        {
            "name": "Global settings",
            "settings": { "background": "#050301", "foreground": "#cdcdcd" }
        },
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#606079", "fontStyle": "italic" }
        },
        {
            "name": "Strings",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#e8b589" }
        },
        {
            "name": "String escapes",
            "scope": ["constant.character.escape", "string.regexp"],
            "settings": { "foreground": "#b4d4cf" }
        },
        {
            "name": "Numbers",
            "scope": [
                "constant.numeric",
                "constant.numeric.integer",
                "constant.numeric.float",
                "constant.numeric.hex",
                "constant.numeric.octal"
            ],
            "settings": { "foreground": "#e0a363" }
        },
        {
            "name": "Boolean / Built-in constants",
            "scope": [
                "constant.language",
                "constant.language.boolean",
                "constant.language.null",
                "constant.language.undefined"
            ],
            "settings": { "foreground": "#aeaed1", "fontStyle": "italic" }
        },
        {
            "name": "Other constants",
            "scope": ["constant.other", "constant.character"],
            "settings": { "foreground": "#aeaed1" }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.control.flow",
                "keyword.control.conditional",
                "keyword.control.loop",
                "keyword.control.import",
                "keyword.control.export",
                "keyword.control.from",
                "keyword.control.as",
                "keyword.operator.new",
                "keyword.operator.delete",
                "keyword.operator.typeof",
                "keyword.operator.void",
                "keyword.operator.instanceof",
                "keyword.operator.in"
            ],
            "settings": { "foreground": "#6e94b2", "fontStyle": "italic" }
        },
        {
            "name": "Keyword return / yield",
            "scope": ["keyword.control.return", "keyword.control.yield"],
            "settings": { "foreground": "#d8647e", "fontStyle": "italic" }
        },
        {
            "name": "Operators",
            "scope": [
                "keyword.operator",
                "keyword.operator.arithmetic",
                "keyword.operator.assignment",
                "keyword.operator.comparison",
                "keyword.operator.logical",
                "keyword.operator.bitwise",
                "keyword.operator.spread",
                "keyword.operator.rest",
                "keyword.operator.ternary",
                "keyword.operator.optional"
            ],
            "settings": { "foreground": "#90a0b5" }
        },
        {
            "name": "Storage types",
            "scope": [
                "storage",
                "storage.type",
                "storage.type.function",
                "storage.type.class",
                "storage.type.interface",
                "storage.type.enum",
                "storage.type.namespace",
                "storage.type.module",
                "storage.type.var",
                "storage.type.let",
                "storage.type.const",
                "storage.type.async",
                "storage.modifier"
            ],
            "settings": { "foreground": "#6e94b2", "fontStyle": "italic" }
        },
        {
            "name": "Function declarations",
            "scope": [
                "entity.name.function",
                "meta.function entity.name.function",
                "support.function"
            ],
            "settings": { "foreground": "#c48282" }
        },
        {
            "name": "Function calls",
            "scope": [
                "meta.function-call entity.name.function",
                "meta.function-call.generic",
                "meta.method-call entity.name.function"
            ],
            "settings": { "foreground": "#c48282" }
        },
        {
            "name": "Class names",
            "scope": [
                "entity.name.class",
                "entity.name.type.class",
                "entity.name.type.interface",
                "entity.name.type.enum",
                "entity.name.type.namespace",
                "entity.name.type"
            ],
            "settings": { "foreground": "#9bb4bc" }
        },
        {
            "name": "Inherited class",
            "scope": ["entity.other.inherited-class"],
            "settings": { "foreground": "#e8b589", "fontStyle": "italic" }
        },
        {
            "name": "Function parameters",
            "scope": ["variable.parameter", "meta.function.parameter"],
            "settings": { "foreground": "#bb9dbd", "fontStyle": "italic" }
        },
        {
            "name": "Variables",
            "scope": [
                "variable",
                "variable.other",
                "variable.other.readwrite",
                "variable.other.object"
            ],
            "settings": { "foreground": "#cdcdcd" }
        },
        {
            "name": "Variable — this / self / super",
            "scope": [
                "variable.language.this",
                "variable.language.self",
                "variable.language.super"
            ],
            "settings": { "foreground": "#d8647e", "fontStyle": "italic" }
        },
        {
            "name": "Object properties / member access",
            "scope": [
                "variable.other.property",
                "variable.other.object.property",
                "support.variable.property",
                "meta.property.object"
            ],
            "settings": { "foreground": "#c3c3d5" }
        },
        {
            "name": "Type annotations",
            "scope": [
                "meta.type.annotation",
                "meta.type.parameters",
                "entity.name.type.primitive",
                "support.type.primitive",
                "support.type.builtin"
            ],
            "settings": { "foreground": "#9bb4bc", "fontStyle": "italic" }
        },
        {
            "name": "Decorators / Annotations",
            "scope": [
                "meta.decorator",
                "punctuation.decorator",
                "entity.name.function.decorator",
                "meta.annotation"
            ],
            "settings": { "foreground": "#bb9dbd", "fontStyle": "italic" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation",
                "punctuation.definition",
                "punctuation.separator",
                "punctuation.terminator",
                "punctuation.accessor",
                "punctuation.section"
            ],
            "settings": { "foreground": "#90a0b5" }
        },
        {
            "name": "Brackets",
            "scope": [
                "punctuation.definition.bracket",
                "meta.brace",
                "punctuation.definition.block",
                "punctuation.definition.array",
                "punctuation.definition.parameters",
                "punctuation.definition.arguments"
            ],
            "settings": { "foreground": "#90a0b5" }
        },
        {
            "name": "Import paths",
            "scope": [
                "string.quoted.double.import",
                "string.quoted.single.import",
                "meta.import string"
            ],
            "settings": { "foreground": "#e8b589" }
        },
        {
            "name": "Object keys",
            "scope": [
                "meta.object-literal.key",
                "meta.objectliteral entity.name.function",
                "string.quoted.json support.type.property-name"
            ],
            "settings": { "foreground": "#c3c3d5" }
        },
        {
            "name": "Tag names (HTML/JSX)",
            "scope": ["entity.name.tag", "meta.tag entity.name.tag"],
            "settings": { "foreground": "#d8647e" }
        },
        {
            "name": "Tag attributes (HTML/JSX)",
            "scope": [
                "entity.other.attribute-name",
                "meta.tag entity.other.attribute-name"
            ],
            "settings": { "foreground": "#aeaed1" }
        },
        {
            "name": "HTML attribute values",
            "scope": [
                "meta.attribute-with-value string",
                "meta.tag.inline string",
                "meta.attribute string.quoted"
            ],
            "settings": { "foreground": "#e8b589" }
        },
        {
            "name": "CSS property names",
            "scope": [
                "support.type.property-name.css",
                "meta.property-name",
                "support.type.property-name"
            ],
            "settings": { "foreground": "#b4d4cf" }
        },
        {
            "name": "CSS property values",
            "scope": [
                "meta.property-value",
                "support.constant.property-value",
                "support.constant.color",
                "support.constant.font-name",
                "support.constant.media-type"
            ],
            "settings": { "foreground": "#e8b589" }
        },
        {
            "name": "CSS selectors",
            "scope": [
                "entity.name.tag.css",
                "meta.selector",
                "entity.other.pseudo-class.css",
                "entity.other.pseudo-element.css"
            ],
            "settings": { "foreground": "#e0a363" }
        },
        {
            "name": "CSS class / id selectors",
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css"
            ],
            "settings": { "foreground": "#9bb4bc" }
        },
        {
            "name": "CSS @ rules",
            "scope": [
                "keyword.control.at-rule",
                "keyword.control.at-rule.media",
                "keyword.control.at-rule.keyframes",
                "keyword.control.at-rule.import"
            ],
            "settings": { "foreground": "#6e94b2", "fontStyle": "italic" }
        },
        {
            "name": "Markdown headings",
            "scope": [
                "markup.heading",
                "markup.heading.setext",
                "entity.name.section.markdown",
                "punctuation.definition.heading.markdown"
            ],
            "settings": { "foreground": "#e8b589", "fontStyle": "bold" }
        },
        {
            "name": "Markdown bold",
            "scope": ["markup.bold", "punctuation.definition.bold"],
            "settings": { "foreground": "#e0a363", "fontStyle": "bold" }
        },
        {
            "name": "Markdown italic",
            "scope": ["markup.italic", "punctuation.definition.italic"],
            "settings": { "foreground": "#e8b589", "fontStyle": "italic" }
        },
        {
            "name": "Markdown links",
            "scope": ["markup.underline.link", "markup.underline.link.image"],
            "settings": { "foreground": "#b4d4cf", "fontStyle": "underline" }
        },
        {
            "name": "Markdown link text",
            "scope": [
                "string.other.link.title.markdown",
                "string.other.link.description.markdown"
            ],
            "settings": { "foreground": "#9bb4bc" }
        },
        {
            "name": "Markdown code",
            "scope": [
                "markup.raw.inline",
                "markup.raw.block",
                "markup.fenced_code.block"
            ],
            "settings": { "foreground": "#b4d4cf" }
        },
        {
            "name": "Markdown list markers",
            "scope": [
                "punctuation.definition.list.begin.markdown",
                "beginning.punctuation.definition.list.markdown"
            ],
            "settings": { "foreground": "#d8647e" }
        },
        {
            "name": "Markdown blockquote",
            "scope": [
                "markup.quote",
                "punctuation.definition.quote.begin.markdown"
            ],
            "settings": { "foreground": "#606079", "fontStyle": "italic" }
        },
        {
            "name": "JSON keys",
            "scope": ["source.json support.type.property-name"],
            "settings": { "foreground": "#c3c3d5" }
        },
        {
            "name": "Python builtins / special",
            "scope": ["support.function.builtin.python", "support.type.python"],
            "settings": { "foreground": "#b4d4cf", "fontStyle": "italic" }
        },
        {
            "name": "Python magic methods / dunder",
            "scope": ["support.function.magic.python"],
            "settings": { "foreground": "#c48282", "fontStyle": "italic" }
        },
        {
            "name": "Python decorator",
            "scope": [
                "entity.name.function.decorator.python",
                "meta.function.decorator.python"
            ],
            "settings": { "foreground": "#bb9dbd", "fontStyle": "italic" }
        },
        {
            "name": "Rust lifetime / labels",
            "scope": [
                "entity.name.lifetime.rust",
                "storage.modifier.lifetime.rust",
                "punctuation.definition.lifetime.rust"
            ],
            "settings": { "foreground": "#d8647e", "fontStyle": "italic" }
        },
        {
            "name": "Rust macro",
            "scope": ["entity.name.function.macro.rust", "meta.macro.rust"],
            "settings": { "foreground": "#b4d4cf" }
        },
        {
            "name": "Go package name",
            "scope": ["entity.name.package.go"],
            "settings": { "foreground": "#9bb4bc" }
        },
        {
            "name": "Shell variable",
            "scope": [
                "variable.other.normal.shell",
                "variable.other.special.shell",
                "variable.other.positional.shell",
                "variable.other.bracket.shell"
            ],
            "settings": { "foreground": "#e8b589" }
        },
        {
            "name": "Invalid / deprecated",
            "scope": ["invalid", "invalid.illegal", "invalid.deprecated"],
            "settings": {
                "foreground": "#d8647e",
                "fontStyle": "strikethrough"
            }
        },
        {
            "name": "Support — library functions",
            "scope": [
                "support.function",
                "support.class",
                "support.other.module"
            ],
            "settings": { "foreground": "#b4d4cf" }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "namespace": "#9bb4bc",
        "class": "#9bb4bc",
        "interface": { "foreground": "#9bb4bc", "italic": true },
        "enum": "#9bb4bc",
        "enumMember": "#aeaed1",
        "typeParameter": { "foreground": "#9bb4bc", "italic": true },
        "type": { "foreground": "#9bb4bc", "italic": true },
        "function": "#c48282",
        "method": "#c48282",
        "property": "#c3c3d5",
        "variable": "#cdcdcd",
        "variable.readonly": "#aeaed1",
        "parameter": { "foreground": "#bb9dbd", "italic": true },
        "keyword": { "foreground": "#6e94b2", "italic": true },
        "modifier": { "foreground": "#6e94b2", "italic": true },
        "comment": { "foreground": "#606079", "italic": true },
        "string": "#e8b589",
        "number": "#e0a363",
        "regexp": "#b4d4cf",
        "operator": "#90a0b5",
        "decorator": { "foreground": "#bb9dbd", "italic": true },
        "macro": "#b4d4cf",
