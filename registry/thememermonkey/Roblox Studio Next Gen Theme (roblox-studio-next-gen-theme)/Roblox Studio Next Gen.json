{
    "name": "Roblox Studio Refresh",
    "colors": {
        "editor.foreground": "#BCBEC8",
        "editor.background": "#202227",
        "activityBarBadge.background": "#007acc",
        "activityBar.background": "#212326",
        "sideBarTitle.foreground": "#bbbbbb",
        "sideBar.background": "#19191D",
        "list.activeSelectionBackground": "#1A24A9",
        "list.dropBackground": "#161A35",
        "list.hoverBackground": "#222326",
        "tree.indentGuidesStroke": "#2B2A2E",
        "statusBar.background": "#335FFF",
        "statusBar.debuggingBackground": "#F57630",
        "statusBarItem.remoteBackground": "#00B864",
        "titleBar.activeBackground": "#313030",
        "menu.selectionBackground": "#1A24A9",
        "button.background": "#3F54F7",
        "button.foreground": "#FFFFFF",
        "button.hoverBackground": "#5D7FF8",
        "button.secondaryBackground": "#19191D",
        "button.secondaryForeground": "#FFFFFF",
        "button.secondaryHoverBackground": "#27262B",
        "input.background": "#27292C",
        "input.foreground": "#B5B6C1",
        "input.placeholderForeground": "#B5B6C1",
        "inputOption.activeBorder": "#3F54F7",
        "panel.border": "#353740",
        "terminal.background": "#181B1F",
        "terminal.foreground": "#BCBEC8",
        "terminal.border": "#353740",
        "terminalCursor.background": "#13225C",
        "terminalCursor.foreground": "#FFFFFF",
        "tab.activeBackground": "#212326",
        "tab.activeForeground": "#BCBEC8",
        "tab.hoverBackground": "#212326",
        "tab.hoverForeground": "#BCBEC8",
        "tab.inactiveBackground": "#181B1F",
        "tab.inactiveForeground": "#BCBEC8",
        "tab.border": "#353740",
        "scrollbarSlider.background": "#606575",
        "scrollbarSlider.hoverBackground": "#606575",
        "scrollbarSlider.activeBackground": "#606575"
    },
    "tokenColors": [
        {
            "name": "Operator",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#BCBEC8" }
        },
        {
            "name": "Number",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#F2BA2A" }
        },
        {
            "name": "String",
            "scope": ["string"],
            "settings": { "foreground": "#8EE9B6" }
        },
        {
            "name": "Comment",
            "scope": ["comment"],
            "settings": { "foreground": "#6A6F81" }
        },
        {
            "name": "Keyword",
            "scope": ["keyword"],
            "settings": { "foreground": "#EB7973" }
        },
        {
            "name": "Error",
            "scope": ["invalid", "invalid.deprecated"],
            "settings": { "foreground": "#DF281F" }
        },
        {
            "name": "Warning",
            "scope": ["warning"],
            "settings": { "foreground": "#F57630" }
        },
        {
            "name": "Information",
            "scope": ["info"],
            "settings": { "foreground": "#494D5A" }
        },
        {
            "name": "Hint",
            "scope": ["hint"],
            "settings": { "foreground": "#335FFF" }
        },
        {
            "name": "Built-in Function",
            "scope": ["constant.language", "support.function"],
            "settings": { "foreground": "#8FB4FF" }
        },
        {
            "name": "Local Method Color",
            "scope": ["entity.name.function"],
            "settings": { "foreground": "#FAE4AA" }
        },
        {
            "name": "Local Property Color",
            "scope": ["variable.other.property"],
            "settings": { "foreground": "#70A0FF" }
        },
        {
            "name": "nil",
            "scope": ["constant.language.nil"],
            "settings": { "foreground": "#F2BA2A" }
        },
        {
            "name": "Bool",
            "scope": ["constant.language.boolean"],
            "settings": { "foreground": "#F2BA2A" }
        },
        {
            "name": "control",
            "scope": ["keyword.control"],
            "settings": { "foreground": "#EB7973" }
        },
        {
            "name": "local",
            "scope": ["storage.modifier.local"],
            "settings": { "foreground": "#EB7973" }
        },
        {
            "name": "self",
            "scope": ["variable.language.self"],
            "settings": { "foreground": "#EB7973" }
        },
        {
            "name": "not",
            "scope": ["keyword.operator.wordlike"],
            "settings": { "foreground": "#EB7973" }
        },
        {
            "name": "export, type",
            "scope": ["storage.modifier.visibility", "storage.type"],
            "settings": { "foreground": "#EB7973" }
        },
        {
            "name": "Function name",
            "scope": ["entity.name.function"],
            "settings": { "foreground": "#FAE4AA" }
        },
        {
            "name": "Type",
            "scope": ["support.type", "entity.name.type", "storage.type.class"],
            "settings": { "foreground": "#528BFF" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
