{
    "name": "Verdant Focus",
    "type": "dark",
    "colors": {
        "editor.background": "#0F5132",
        "editor.foreground": "#E2F0E8",
        "editorCursor.foreground": "#B5E3C8",
        "editor.selectionBackground": "#000000",
        "editor.selectionForeground": "#FFFFFF",
        "editor.lineHighlightBackground": "#000000",
        "editorLineNumber.foreground": "#9BCFB8",
        "sideBar.background": "#0a3c24",
        "sideBar.foreground": "#CDEDE0",
        "activityBar.background": "#0a3c24",
        "activityBar.foreground": "#CDEDE0",
        "tab.activeBackground": "#145C3A",
        "tab.activeForeground": "#E2F0E8",
        "statusBar.background": "#0A3C24",
        "statusBar.foreground": "#B5E3C8",
        "titleBar.activeBackground": "#0a3c24",
        "titleBar.activeForeground": "#CDEDE0",
        "tab.inactiveBackground": "#0a3c24",
        "tab.inactiveForeground": "#7FB8A4",
        "panel.background": "#0F5132",
        "panel.border": "#145C3A",
        "terminal.background": "#0F5132",
        "terminal.foreground": "#E2F0E8",
        "button.background": "#145C3A",
        "button.foreground": "#E2F0E8",
        "input.background": "#0a3c24",
        "input.foreground": "#E2F0E8",
        "input.border": "#145C3A",
        "dropdown.background": "#0a3c24",
        "dropdown.foreground": "#E2F0E8",
        "dropdown.border": "#145C3A",
        "list.activeSelectionBackground": "#000000",
        "list.activeSelectionForeground": "#FFFFFF",
        "list.hoverBackground": "#0F5132",
        "list.hoverForeground": "#E2F0E8",
        "scrollbar.shadow": "#000000",
        "scrollbarSlider.background": "#145C3A80",
        "scrollbarSlider.hoverBackground": "#145C3AA0",
        "scrollbarSlider.activeBackground": "#145C3AC0",
        "editorWidget.background": "#0a3c24",
        "editorWidget.border": "#145C3A",
        "editorSuggestWidget.background": "#0a3c24",
        "editorSuggestWidget.foreground": "#E2F0E8",
        "editorSuggestWidget.border": "#145C3A",
        "editorSuggestWidget.selectedBackground": "#145C3A",
        "editorHoverWidget.background": "#0a3c24",
        "editorHoverWidget.border": "#145C3A",
        "peekView.background": "#0a3c24",
        "peekViewEditor.background": "#0F5132",
        "peekViewResult.background": "#0a3c24",
        "menu.background": "#0a3c24",
        "menu.foreground": "#E2F0E8",
        "menubar.selectionBackground": "#000000",
        "menubar.selectionForeground": "#FFFFFF",
        "notificationCenter.border": "#145C3A",
        "notifications.background": "#0a3c24",
        "notifications.foreground": "#E2F0E8",
        "notifications.border": "#145C3A"
    },
    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#9BCFB8", "fontStyle": "italic" }
        },
        {
            "name": "Keywords",
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#FFD580", "fontStyle": "bold" }
        },
        {
            "name": "Control Keywords",
            "scope": ["keyword.control", "keyword.control.flow"],
            "settings": { "foreground": "#FF9F9B", "fontStyle": "bold" }
        },
        {
            "name": "Operators",
            "scope": [
                "keyword.operator",
                "punctuation.separator",
                "punctuation.terminator"
            ],
            "settings": { "foreground": "#FCE38A" }
        },
        {
            "name": "Strings",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#C3F584" }
        },
        {
            "name": "String Interpolation",
            "scope": [
                "string.template.js",
                "string.interpolated",
                "punctuation.definition.template-expression"
            ],
            "settings": { "foreground": "#B8F2B8" }
        },
        {
            "name": "Numbers",
            "scope": [
                "constant.numeric",
                "constant.numeric.integer",
                "constant.numeric.float"
            ],
            "settings": { "foreground": "#FFB6B9" }
        },
        {
            "name": "Booleans and Constants",
            "scope": [
                "constant.language",
                "constant.language.boolean",
                "constant.language.null"
            ],
            "settings": { "foreground": "#FFDAC1" }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "meta.function-call",
                "support.function"
            ],
            "settings": { "foreground": "#A0E7E5" }
        },
        {
            "name": "Function Parameters",
            "scope": ["variable.parameter", "meta.function.parameters"],
            "settings": { "foreground": "#F7D6E0", "fontStyle": "italic" }
        },
        {
            "name": "Classes and Types",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.class",
                "support.type"
            ],
            "settings": { "foreground": "#C4B7FF", "fontStyle": "bold" }
        },
        {
            "name": "Interfaces",
            "scope": ["entity.name.type.interface"],
            "settings": { "foreground": "#D4C7FF", "fontStyle": "italic" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "variable.other"],
            "settings": { "foreground": "#F7D6E0" }
        },
        {
            "name": "Properties",
            "scope": ["variable.other.property", "support.variable.property"],
            "settings": { "foreground": "#E8C5E8" }
        },
        {
            "name": "Object Keys",
            "scope": ["meta.object-literal.key", "string.unquoted"],
            "settings": { "foreground": "#B8E6B8" }
        },
        {
            "name": "HTML Tags",
            "scope": ["entity.name.tag", "punctuation.definition.tag"],
            "settings": { "foreground": "#FF9F9B" }
        },
        {
            "name": "HTML Attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#FFD580" }
        },
        {
            "name": "CSS Selectors",
            "scope": [
                "entity.name.tag.css",
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css"
            ],
            "settings": { "foreground": "#A0E7E5" }
        },
        {
            "name": "CSS Properties",
            "scope": ["support.type.property-name.css"],
            "settings": { "foreground": "#C4B7FF" }
        },
        {
            "name": "CSS Values",
            "scope": [
                "support.constant.property-value.css",
                "constant.numeric.css"
            ],
            "settings": { "foreground": "#C3F584" }
        },
        {
            "name": "JSON Keys",
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#A0E7E5" }
        },
        {
            "name": "Markdown Headings",
            "scope": ["markup.heading", "entity.name.section.markdown"],
            "settings": { "foreground": "#FFD580", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Bold",
            "scope": ["markup.bold"],
            "settings": { "foreground": "#FF9F9B", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Italic",
            "scope": ["markup.italic"],
            "settings": { "foreground": "#F7D6E0", "fontStyle": "italic" }
        },
        {
            "name": "Markdown Code",
            "scope": ["markup.inline.raw", "markup.fenced_code"],
            "settings": { "foreground": "#C3F584" }
        },
        {
            "name": "Markdown Links",
            "scope": ["markup.underline.link"],
            "settings": { "foreground": "#A0E7E5", "fontStyle": "underline" }
        },
        {
            "name": "Invalid/Error",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#FF6B6B", "background": "#4A1A1A" }
        },
        {
            "name": "Deprecated",
            "scope": ["invalid.deprecated"],
            "settings": {
                "foreground": "#FFB347",
                "fontStyle": "strikethrough"
            }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "variable": "#F7D6E0",
        "variable.readonly": "#E8C5E8",
        "parameter": "#F7D6E0",
        "function": "#A0E7E5",
        "method": "#A0E7E5",
        "class": "#C4B7FF",
        "interface": "#D4C7FF",
        "enum": "#C4B7FF",
        "type": "#C4B7FF",
        "namespace": "#FFD580",
        "property": "#E8C5E8",
        "enumMember": "#FFDAC1",
        "macro": "#FF9F9B",
        "keyword": "#FFD580",
        "comment": "#9BCFB8",
        "string": "#C3F584",
        "number": "#FFB6B9"
    },
    "$schema": "vscode://schemas/color-theme"
}
