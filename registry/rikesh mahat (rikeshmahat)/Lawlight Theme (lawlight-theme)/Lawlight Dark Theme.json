        "tab.inactiveBackground": "#FF1ECB20",
        "tab.inactiveForeground": "#2583B6af",
        "tab.unfocusedActiveBorder": "#FF1ECB",
        "tab.unfocusedActiveBackground": "#FF1ECB40",
        "tab.unfocusedActiveForeground": "#2583B6",
        "tab.unfocusedInactiveBackground": "#FF1ECB10",
        "tab.unfocusedInactiveForeground": "#2583B67f",
        "terminal.ansiBlack": "#000000",
        "terminal.ansiBlue": "#B0F7FF",
        "terminal.ansiBrightBlack": "#FF1ECB",
        "terminal.ansiBrightBlue": "#B0F7FF",
        "terminal.ansiBrightCyan": "#CED3FF",
        "terminal.ansiBrightGreen": "#D6F0FF",
        "terminal.ansiBrightMagenta": "#C2E4FF",
        "terminal.ansiBrightRed": "#75FF66",
        "terminal.ansiBrightWhite": "#2583B6",
        "terminal.ansiBrightYellow": "#C2E4FF",
        "terminal.ansiCyan": "#CED3FF",
        "terminal.ansiGreen": "#D6F0FF",
        "terminal.ansiMagenta": "#C2E4FF",
        "terminal.ansiRed": "#75FF66",
        "terminal.ansiWhite": "#2583B6",
