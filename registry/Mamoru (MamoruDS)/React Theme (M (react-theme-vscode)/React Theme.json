    "tokenColors": [
        {
            "name": "Comments",
            "scope": [
                "comment",
                "punctuation.definition.comment",
                "string.quoted.docstring"
            ],
            "settings": { "foreground": "#ffffff40" }
        },
        {
            "name": "keywords",
            "scope": ["keyword", "storage.type.class"],
            "settings": { "foreground": "#c5a5c5" }
        },
        {
            "name": "strings",
            "scope": "string",
            "settings": { "foreground": "#8dc891" }
        },
        {
            "name": "functions",
            "scope": "function",
            "settings": { "foreground": "#79b6f2" }
        },
        {
            "name": "variables",
            "scope": ["variable", "meta.jsx.children"],
            "settings": { "foreground": "#fff" }
        },
        {
            "name": "types",
            "scope": [
                "type",
                "support.type",
                "support.type.property-name.json.comments"
            ],
            "settings": { "foreground": "#fac863" }
        },
        {
            "name": "Name.Constant",
            "scope": "variable.other.constant",
            "settings": { "foreground": "#8be9ee" }
        },
        {
            "name": "Generic: Heading (multi line)",
            "scope": "markup.heading.1 punctuation.definition.heading",
            "settings": { "foreground": "#ff0000" }
        },
        {
            "name": "Name.Entity",
            "scope": "constant.character.entity",
            "settings": { "foreground": "#d67c9b" }
        },
        {
            "name": "Name.Exception",
            "scope": "entity.name.exception",
            "settings": { "foreground": "#d67c9b" }
        },
        {
            "name": "Name.Function",
            "scope": [
                "entity.name.function",
                "support.function",
                "support.class.builtin",
                "keyword.other.name-of-parameter"
            ],
            "settings": { "foreground": "#79b6f2" }
        },
        {
            "name": "Name.Tag",
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#fc929e" }
        },
        {
            "name": "Support.Class",
            "scope": [
                "support.class",
                "support.class.component",
                "constant.numeric",
                "punctuation.terminator.statement",
                "support.variable.property.dom"
            ],
            "settings": { "foreground": "#fc929e" }
        },
        {
            "name": "Component",
            "scope": ["entity.other.inherited-class", "entity.name.type"],
            "settings": { "foreground": "#fac863" }
        },
        {
            "name": "Storage.Modifier",
            "scope": ["storage.modifier", "storage.type"],
            "settings": { "foreground": "#c5a5c5" }
        },
        {
            "name": "Storage.Type",
            "scope": ["constructor"],
            "settings": { "foreground": "#79b6f2" }
        },
        {
            "name": "Variable.Language",
            "scope": [
                "variable.language",
                "entity.other.attribute-name",
                "constant.language.undefined",
                "constant.language.null"
            ],
            "settings": { "foreground": "#c5a5c5", "fontStyle": "" }
        },
        {
            "name": "Constant.Boolean",
            "scope": ["constant.language.boolean"],
            "settings": { "foreground": "#ff8b50" }
        },
        {
            "name": "Variable.Parameter",
            "scope": [
                "variable.parameter",
                "variable.other.constant",
                "variable.other.readwrite",
                "meta.object-literal.key"
            ],
            "settings": { "foreground": "#fff" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation",
                "punctuation.definition.tag",
                "punctuation.section.embedded",
                "meta.brace.round",
                "meta.array.literal"
            ],
            "settings": { "foreground": "#88c6be" }
        },
        {
            "name": "Operator",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#d7deea" }
        },
        {
            "name": "Python Variable",
            "scope": "source.python",
            "settings": { "foreground": "#ffffff" }
        },
        {
            "name": "Python Constant.Boolean",
            "scope": "constant.language.python",
            "settings": { "foreground": "#f99157" }
        },
        {
            "name": "Lua Variable",
            "scope": "source.lua",
            "settings": { "foreground": "#ffffff" }
        },
        {
            "scope": [
                "support.constant.json.js",
                "constant.language.null.js",
                "support.variable.property.js"
            ],
            "settings": { "foreground": "#f99157" }
        },
        {
            "scope": ["variable.other.property.js"],
            "settings": { "foreground": "#c5c5c5" }
        },
        {
            "scope": ["constant.other.character-class.regexp"],
            "settings": { "foreground": "#fac863" }
        },
        {
            "scope": ["string.unquoted.plain.out.yaml"],
            "settings": { "foreground": "#ffffff" }
        },
        {
            "scope": ["punctuation.separator.key-value.mapping.yaml"],
            "settings": { "foreground": "#c5a5c5" }
        },
        {
            "scope": ["entity.name.tag.yaml"],
            "settings": { "foreground": "#f99157" }
        },
        {
            "scope": [
                "punctuation.separator.dictionary.key-value.json",
                "constant.language.json"
            ],
            "settings": { "foreground": "#f99157" }
        },
        {
            "scope": [
                "entity.name.type.ts",
                "meta.type.annotation.ts",
                "support.type.primitive.ts"
            ],
            "settings": { "foreground": "#79b6f2" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
