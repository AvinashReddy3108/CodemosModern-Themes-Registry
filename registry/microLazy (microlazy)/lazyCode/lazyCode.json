{
    "name": "lazyCode",
    "type": "dark",
    "colors": {
        "editor.background": "#141F2E",
        "editor.foreground": "#D0D0D0",
        "tab.activeBackground": "#141F2E",
        "tab.inactiveBackground": "#0A101D",
        "activityBarBadge.background": "#007acc",
        "sideBarTitle.foreground": "#bbbbbb",
        "editor.lineHighlightBackground": "#406186bb",
        "editorLineNumber.foreground": "#cccccc",
        "editorBracketMatch.background": "#4f6d93",
        "editorBracketMatch.border": "#4f6d93",
        "editor.selectionForeground": "#ffffff",
        "editor.selectionBackground": "#4c74a8"
    },
    "tokenColors": [
        {
            "name": "default colors",
            "scope": ["variable.other.class", "variable.other.property"],
            "settings": { "foreground": "#D0D0D0" }
        },
        {
            "name": "Comments",
            "scope": [
                "comment",
                "keyword.other.phpdoc.php",
                "keyword.other.type.php",
                "punctuation.definition.comment"
            ],
            "settings": { "foreground": "#75715E" }
        },
        {
            "name": "String",
            "scope": ["string", "constant.css"],
            "settings": { "foreground": "#E6DB74" }
        },
        {
            "name": "Number Boolean NULL",
            "scope": [
                "constant.numeric",
                "constant.language",
                "constant.character.escape"
            ],
            "settings": { "foreground": "#AE81FF" }
        },
        {
            "name": "Constant",
            "scope": ["constant"],
            "settings": { "foreground": "#A41DFF", "fontStyle": "bold" }
        },
        {
            "name": "constant.other",
            "scope": ["constant.other"],
            "settings": { "foreground": "#FCC95A" }
        },
        {
            "name": "Variables",
            "scope": ["variable.other", "constant.other.placeholder"],
            "settings": { "foreground": "#37C6C0" }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "storage.type",
                "storage.modifier",
                "variable.language",
                "support.function"
            ],
            "settings": { "foreground": "#0099FF", "fontStyle": "bold" }
        },
        {
            "name": "Function name",
            "scope": [
                "entity.name.type",
                "entity.other.inherited-class",
                "entity.name.function",
                "support.function.magic",
                "meta.property-name.css",
                "entity.other.attribute-name"
            ],
            "settings": { "foreground": "#A6E22E" }
        },
        {
            "name": "Operator",
            "scope": [
                "keyword.operator",
                "entity.other.attribute-name.class.css",
                "punctuation.section.embedded.begin.php",
                "punctuation.section.embedded.end.php",
                "entity.name.tag",
                "entity.other.attribute-name.id.css"
            ],
            "settings": { "foreground": "#F92672" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
