    "semanticHighlighting": true,
    "semanticTokenColors": {
        "namespace": "#db889a",
        "property": "#b8a965",
        "interface": "#5d99a9",
        "type": "#5d99a9",
        "class": "#6872ab",
        "newOperator": "#ed9cc2",
        "stringLiteral": "#74ccaa",
        "customLiteral": "#f6c177",
        "numberLiteral": "#f6c177"
    },
    "tokenColors": [
        {
            "name": "String",
            "scope": [
                "string",
                "string punctuation.section.embedded source",
                "attribute.value"
            ],
            "settings": { "foreground": "#c98a7d" }
        },
        {
            "name": "Number",
            "scope": [
                "keyword.operator.quantifier.regexp",
                "constant.numeric",
                "number"
            ],
            "settings": { "foreground": "#f6c177" }
        },
        {
            "name": "Boolean",
            "scope": ["constant.language.boolean"],
            "settings": { "foreground": "#74ccaa" }
        },
        {
            "name": "Namespace",
            "scope": ["namespace"],
            "settings": { "foreground": "#db889a" }
        },
        {
            "name": "Identifier",
            "scope": [
                "variable",
                "identifier",
                "support.variable",
                "support.class",
                "constant.language",
                "meta.definition.variable entity.name.function"
            ],
            "settings": { "foreground": "#bd976a" }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "storage.type.class.jsdoc ",
                "punctuation.definition.template-expression",
                "modifier",
                "variable.language.this",
                "support.type.object"
            ],
            "settings": { "foreground": "#4d9375", "fontStyle": "bold" }
        },
        {
            "name": "Function",
            "scope": ["variable.function"],
            "settings": { "foreground": "#80a665" }
        },
        {
            "name": "Function call",
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#80a665" }
        },
        {
            "name": "Storage",
            "scope": [
                "storage",
                "storage.type",
                "storage.modifier",
                "support.type.builtin",
                "constant.language.undefined",
                "constant.language.null",
                "constant.language.import-export-all.ts"
            ],
            "settings": { "foreground": "#cb7676" }
        },
        {
            "name": "Modules",
            "scope": ["support.module", "support.node"],
            "settings": { "foreground": "#bd976a", "fontStyle": "italic" }
        },
        {
            "name": "Type",
            "scope": [
                "support.type",
                "entity.name.type",
                "entity.other.inherited-class",
                "support.type.primitive",
                "entity.name.type"
            ],
            "settings": { "foreground": "#5DA994" }
        },
        {
            "name": "Comment",
            "scope": [
                "comment",
                "punctuation.definition.comment",
                "string.comment"
            ],
            "settings": { "foreground": "#758575dd", "fontStyle": "italic" }
        },
        {
            "name": "Class",
            "scope": ["entity.name.type.class"],
            "settings": { "foreground": "#6872ab", "fontStyle": "underline" }
        },
        {
            "name": "Class variable",
            "scope": [
                "variable.object.property",
                "meta.field.declaration entity.name.function"
            ],
            "settings": { "foreground": "#a0a5d6" }
        },
        {
            "name": "Class method",
            "scope": ["meta.definition.method entity.name.function"],
            "settings": { "foreground": "#80a665" }
        },
        {
            "name": "Function definition",
            "scope": ["meta.function entity.name.function"],
            "settings": { "foreground": "#80a665" }
        },
        {
            "name": "Function call",
            "scope": ["meta.function-call entity.name.function"],
            "settings": { "foreground": "#80a665" }
        },
        {
            "name": "Constant",
            "scope": [
                "constant",
                "entity.name.constant",
                "variable.language",
                "meta.definition.variable"
            ],
            "settings": { "foreground": "#c77dbb" }
        },
        {
            "name": "Template expression",
            "scope": [
                "template.expression.begin",
                "template.expression.end",
                "punctuation.definition.template-expression.begin",
                "punctuation.definition.template-expression.end"
            ],
            "settings": { "foreground": "#c4704f" }
        },
        {
            "name": "YAML Key",
            "scope": ["entity.name.tag.yaml"],
            "settings": { "foreground": "#bd976a" }
        },
        {
            "name": "JSON key",
            "scope": [
                "meta.object-literal.key",
                "meta.object-literal.key string",
                "support.type.property-name.json"
            ],
            "settings": { "foreground": "#bd976a" }
        },
        {
            "name": "JSON constant",
            "scope": ["constant.language.json"],
            "settings": { "foreground": "#c77dbb" }
        },
        {
            "name": "CSS tag",
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#4d9375" }
        },
        {
            "name": "CSS class",
            "scope": ["entity.other.attribute-name.class"],
            "settings": { "foreground": "#6872ab" }
        },
        {
            "name": "CSS id",
            "scope": ["entity.other.attribute-name.id"],
            "settings": { "foreground": "#5d99a9" }
        },
        {
            "name": "HTML tag outline",
            "scope": ["meta.tag", "punctuation.definition.tag"],
            "settings": { "foreground": "#4d9375" }
        },
        {
            "name": "HTML tag inner",
            "scope": ["entity.name.tag", "tag.html"],
            "settings": { "foreground": "#5DA994" }
        },
        {
            "name": "HTML attribute",
            "scope": [
                "entity.other.attribute-name",
                "invalid.deprecated.entity.other.attribute-name.html"
            ],
            "settings": { "foreground": "#bd976a" }
        },
        {
            "name": "punctuation",
            "scope": [
                "delimiter.bracket",
                "delimiter",
                "invalid.illegal.character-not-allowed-here.html",
                "keyword.operator.rest",
                "keyword.operator.spread",
                "keyword.operator.type.annotation",
                "keyword.operator.relational",
                "keyword.operator.assignment",
                "keyword.operator.type",
                "meta.brace",
                "meta.tag.block.any.html",
                "meta.tag.inline.any.html",
                "meta.tag.structure.input.void.html",
                "meta.type.annotation",
                "meta.embedded.block.github-actions-expression",
                "storage.type.function.arrow",
                "meta.objectliteral.ts",
                "punctuation",
                "punctuation.definition.string.begin.html.vue",
                "punctuation.definition.string.end.html.vue"
            ],
            "settings": { "foreground": "#666666" }
        },
        {
            "name": "",
            "scope": ["variable.parameter.function"],
            "settings": { "foreground": "#dbd7caee" }
        },
        {
            "name": "",
            "scope": [
                "text.html.derivative",
                "storage.modifier.package",
                "storage.modifier.import",
                "storage.type.java"
            ],
            "settings": { "foreground": "#dbd7caee" }
        },
        {
            "name": "",
            "scope": ["punctuation.definition.string"],
            "settings": { "foreground": "#c98a7d77" }
        },
        {
            "name": "",
            "scope": ["punctuation.support.type.property-name"],
            "settings": { "foreground": "#b8a96577" }
        },
        {
            "name": "",
            "scope": ["support"],
            "settings": { "foreground": "#b8a965" }
        },
        {
            "name": "",
            "scope": [
                "property",
                "meta.property-name",
                "meta.object-literal.key",
                "entity.name.tag.yaml",
                "attribute.name"
            ],
            "settings": { "foreground": "#b8a965" }
        },
        {
            "name": "",
            "scope": [
                "keyword.operator",
                "keyword.operator.assignment.compound",
                "meta.var.expr.ts"
            ],
            "settings": { "foreground": "#cb7676" }
        },
        {
            "name": "",
            "scope": ["invalid.broken"],
            "settings": { "foreground": "#FBB0A7", "fontStyle": "italic" }
        },
        {
            "name": "",
            "scope": ["invalid.deprecated"],
            "settings": { "foreground": "#FBB0A7", "fontStyle": "italic" }
        },
        {
            "name": "",
            "scope": ["invalid.illegal"],
            "settings": { "foreground": "#FBB0A7", "fontStyle": "italic" }
        },
        {
            "name": "",
            "scope": ["invalid.unimplemented"],
            "settings": { "foreground": "#FBB0A7", "fontStyle": "italic" }
        },
        {
            "name": "",
            "scope": ["carriage-return"],
            "settings": {
                "foreground": "#f7f8fa",
                "fontStyle": "italic underline"
            }
        },
        {
            "name": "",
            "scope": ["message.error"],
            "settings": { "foreground": "#CB2E34", "fontStyle": "italic" }
        },
        {
            "name": "",
            "scope": ["source.regexp", "string.regexp"],
            "settings": { "foreground": "#c4704f", "fontStyle": "italic" }
        },
        {
            "name": "",
            "scope": [
                "string.regexp.character-class",
                "string.regexp.source.ruby.embedded",
                "string.regexp.string.regexp.arbitrary-repitition"
            ],
            "settings": { "foreground": "#c98a7d" }
        },
        {
            "name": "",
            "scope": ["string.regexp constant.character.escape"],
            "settings": { "foreground": "#e6cc77" }
        },
        {
            "name": "Constant",
            "scope": ["support.constant"],
            "settings": { "foreground": "#c77dbb" }
        },
        {
            "name": "",
            "scope": ["keyword.other.unit"],
            "settings": { "foreground": "#cb7676" }
        },
        {
            "name": "",
            "scope": ["meta.module-reference"],
            "settings": { "foreground": "#4d9375" }
        },
        {
            "name": "",
            "scope": ["punctuation.definition.list.begin.markdown"],
            "settings": { "foreground": "#d4976c" }
        },
        {
            "name": "",
            "scope": ["markup.heading", "markup.heading entity.name"],
            "settings": { "foreground": "#4d9375", "fontStyle": "bold" }
        },
        {
            "name": "",
            "scope": ["markup.quote"],
            "settings": { "foreground": "#5d99a9" }
        },
        {
            "name": "",
            "scope": ["markup.italic"],
            "settings": { "foreground": "#dbd7caee", "fontStyle": "italic" }
        },
        {
            "name": "",
            "scope": ["markup.bold"],
            "settings": { "foreground": "#dbd7caee", "fontStyle": "bold" }
        },
        {
            "name": "",
            "scope": ["markup.raw"],
            "settings": { "foreground": "#4d9375" }
        },
        {
            "name": "",
            "scope": [
                "markup.deleted",
                "meta.diff.header.from-file",
                "punctuation.definition.deleted"
            ],
            "settings": { "foreground": "#FBB0A7" }
        },
        {
            "name": "",
            "scope": [
                "markup.inserted",
                "meta.diff.header.to-file",
                "punctuation.definition.inserted"
            ],
            "settings": { "foreground": "#50D266" }
        },
        {
            "name": "",
            "scope": ["markup.changed", "punctuation.definition.changed"],
            "settings": { "foreground": "#FFB357" }
        },
        {
            "name": "",
            "scope": ["markup.ignored", "markup.untracked"],
            "settings": { "foreground": "#f2f3f5" }
        },
        {
            "name": "",
            "scope": ["meta.diff.range"],
            "settings": { "foreground": "#A974E3", "fontStyle": "bold" }
        },
        {
            "name": "",
            "scope": ["meta.diff.header"],
            "settings": { "foreground": "#689FFF" }
        },
        {
            "name": "",
            "scope": ["meta.separator"],
            "settings": { "foreground": "#689FFF", "fontStyle": "bold" }
        },
