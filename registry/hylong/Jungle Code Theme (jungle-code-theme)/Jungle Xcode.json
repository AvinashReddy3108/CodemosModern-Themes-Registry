{
    "type": "dark",
    "tokenColors": [
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#7F8C98" }
        },
        { "scope": ["string"], "settings": { "foreground": "#FF8170" } },
        {
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#78C2B3", "fontStyle": "" }
        },
        {
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#D9C97C" }
        },
        {
            "scope": [
                "constant.other.placeholder",
                "constant.character.escape"
            ],
            "settings": { "foreground": "#C7C3C3D8" }
        },
        {
            "scope": [
                "keyword",
                "keyword.operator.new",
                "keyword.operator.wordlike",
                "keyword.operator.logical.and",
                "keyword.operator.sizeof",
                "storage",
                "variable.language",
                "constant.language"
            ],
            "settings": { "foreground": "#FF7AB2", "fontStyle": "" }
        },
        {
            "scope": [
                "keyword.control.directive",
                "punctuation.definition.directive"
            ],
            "settings": { "foreground": "#FFA14F", "fontStyle": "" }
        },
        {
            "scope": ["entity.name.type.class.php"],
            "settings": { "foreground": "#6BDFFF" }
        },
        {
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#4EB0CC" }
        },
        {
            "scope": [
                "entity.name.type",
                "entity.other.inherited-class",
                "storage.type.haskell"
            ],
            "settings": { "foreground": "#ACF2E4" }
        },
        {
            "scope": ["support.class", "entity.other.inherited-class.php"],
            "settings": { "foreground": "#6BDFFF" }
        },
        {
            "scope": [
                "keyword.type.cs",
                "storage.type.numeric.go",
                "storage.type.byte.go",
                "storage.type.boolean.go",
                "storage.type.string.go",
                "storage.type.uintptr.go",
                "storage.type.error.go",
                "storage.type.rune.go"
            ],
            "settings": { "foreground": "#DABAFF", "fontStyle": "" }
        },
        {
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#78C2B3" }
        },
        {
            "scope": ["support.function"],
            "settings": { "foreground": "#B281EB" }
        },
        {
            "scope": ["constant.other"],
            "settings": { "foreground": "#B281EB" }
        },
        {
            "scope": [
                "variable.other.property",
                "variable.other.object.property",
                "entity.name.variable.field"
            ],
            "settings": { "foreground": "#78C2B3" }
        },
        {
            "scope": ["entity.name.function.preprocessor"],
            "settings": { "foreground": "#FFA14F", "fontStyle": "" }
        },
        {
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#FF7AB2" }
        },
        {
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#ffc77d", "fontStyle": "" }
        },
        {
            "scope": [
                "support.type.property-name.css",
                "support.type.property-name.media.css"
            ],
            "settings": { "foreground": "#78c2b3" }
        },
        {
            "scope": [
                "constant.other.color",
                "support.constant.color",
                "punctuation.definition.constant.css",
                "keyword.other.unit"
            ],
            "settings": { "foreground": "#D9C97C" }
        },
        {
            "scope": [
                "support.constant.property-value",
                "support.constant.font-name"
            ],
            "settings": { "foreground": "#FF7AB2", "fontStyle": "" }
        },
        {
            "scope": ["support.constant.media.css"],
            "settings": { "foreground": "#78C2B3" }
        },
        {
            "scope": [
                "punctuation.definition.heading.markdown",
                "meta.separator.markdown",
                "punctuation.definition.markdown",
                "punctuation.definition.list.begin.markdown",
                "punctuation.definition.italic.markdown",
                "punctuation.definition.bold.markdown",
                "punctuation.definition.quote.begin.markdown",
                "punctuation.definition.raw.markdown",
                "fenced_code.block.language.markdown",
                "markup.heading.marker.asciidoc",
                "markup.heading.block-attribute.asciidoc",
                "punctuation.separator.asciidoc",
                "constant.asciidoc",
                "punctuation.definition.asciidoc"
            ],
            "settings": { "foreground": "#78C2B3" }
        },
        { "scope": ["markup.heading"], "settings": { "fontStyle": "bold" } },
        { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
        { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
        { "scope": ["magit.header"], "settings": { "foreground": "#DABAFF" } },
        {
            "scope": ["magit.subheader"],
            "settings": { "foreground": "#B281EB" }
        },
        { "scope": ["magit.entity"], "settings": { "foreground": "#D9C97C" } },
        {
            "scope": [
                "meta.diff.range.unified",
                "punctuation.definition.range.diff"
            ],
            "settings": { "foreground": "#7F8C98" }
        },
        {
            "scope": ["markup.inserted", "punctuation.definition.inserted"],
            "settings": { "foreground": "#ACF2E4" }
        },
        {
            "scope": ["markup.deleted", "punctuation.definition.deleted"],
            "settings": { "foreground": "#FF8170" }
        },
        { "scope": ["variable"], "settings": { "foreground": "#C7C3C3D8" } },
        {
            "scope": ["keyword.operator", "storage.modifier.pointer"],
            "settings": { "foreground": "#C7C3C3D8", "fontStyle": "" }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "comment": { "foreground": "#7F8C98" },
        "string": { "foreground": "#FF8170" },
        "character": { "foreground": "#D9C97C" },
        "number": { "foreground": "#D9C97C" },
        "formatSpecifier": { "foreground": "#C7C3C3D8" },
        "escapeSequence": { "foreground": "#C7C3C3D8" },
        "keyword": { "foreground": "#FF7AB2" },
        "type.declaration": { "foreground": "#6BDFFF" },
        "class.declaration": { "foreground": "#6BDFFF" },
        "struct.declaration": { "foreground": "#6BDFFF" },
        "enum.declaration": { "foreground": "#6BDFFF" },
        "union.declaration": { "foreground": "#6BDFFF" },
        "interface.declaration": { "foreground": "#6BDFFF" },
        "typeParameter.declaration": { "foreground": "#6BDFFF" },
        "typeAlias.declaration": { "foreground": "#6BDFFF" },
        "namespace.declaration": { "foreground": "#6BDFFF" },
        "variable.declaration": { "foreground": "#4EB0CC" },
        "variable.globalScope.declaration:c": { "foreground": "#4EB0CC" },
        "parameter.declaration": { "foreground": "#4EB0CC" },
        "variable.constant.declaration": { "foreground": "#4EB0CC" },
        "variable.static.declaration": { "foreground": "#4EB0CC" },
        "enumMember.declaration": { "foreground": "#4EB0CC" },
        "lifetime.declaration": { "foreground": "#4EB0CC" },
        "property.declaration": { "foreground": "#4EB0CC" },
        "function.declaration": { "foreground": "#4EB0CC" },
        "function.globalScope.declaration:c": { "foreground": "#4EB0CC" },
        "method.declaration": { "foreground": "#4EB0CC" },
        "constParameter.declaration": { "foreground": "#4EB0CC" },
        "type": { "foreground": "#ACF2E4" },
        "class": { "foreground": "#ACF2E4" },
        "struct": { "foreground": "#ACF2E4" },
        "enum": { "foreground": "#ACF2E4" },
        "union": { "foreground": "#ACF2E4" },
        "interface": { "foreground": "#ACF2E4" },
        "typeParameter": { "foreground": "#ACF2E4" },
        "typeAlias": { "foreground": "#ACF2E4" },
        "namespace": { "foreground": "#ACF2E4" },
        "type.library": { "foreground": "#DABAFF" },
        "class.library": { "foreground": "#DABAFF" },
        "struct.library": { "foreground": "#DABAFF" },
        "enum.library": { "foreground": "#DABAFF" },
        "union.library": { "foreground": "#DABAFF" },
        "interface.library": { "foreground": "#DABAFF" },
        "typeParameter.library": { "foreground": "#DABAFF" },
        "typeAlias.library": { "foreground": "#DABAFF" },
        "namespace.library": { "foreground": "#DABAFF" },
        "builtinType": { "foreground": "#DABAFF" },
        "type:c": { "foreground": "#DABAFF" },
        "class:c": { "foreground": "#DABAFF" },
        "enum:c": { "foreground": "#DABAFF" },
        "union:c": { "foreground": "#DABAFF" },
        "function": { "foreground": "#78C2B3" },
        "method": { "foreground": "#78C2B3" },
        "function.library": { "foreground": "#B281EB" },
        "method.library": { "foreground": "#B281EB" },
        "function.globalScope:c": { "foreground": "#B281EB" },
        "arithmetic": { "foreground": "#B281EB" },
        "bitwise": { "foreground": "#B281EB" },
        "logical": { "foreground": "#B281EB" },
        "comparison": { "foreground": "#B281EB" },
        "variable.constant": { "foreground": "#78C2B3" },
        "variable.static": { "foreground": "#78C2B3" },
        "enumMember": { "foreground": "#78C2B3" },
        "constParameter": { "foreground": "#78C2B3" },
        "variable.fileScope:c": { "foreground": "#78C2B3" },
        "lifetime": {
            "foreground": "#78C2B3",
            "bold": false,
            "italic": false,
            "underline": false
        },
        "variable.constant.library": { "foreground": "#B281EB" },
        "variable.static.library": { "foreground": "#B281EB" },
        "enumMember.library": { "foreground": "#B281EB" },
        "variable.globalScope:c": { "foreground": "#B281EB" },
        "enumMember:c": { "foreground": "#B281EB" },
        "property": { "foreground": "#78C2B3" },
        "property.library": { "foreground": "#B281EB" },
        "property:c": { "foreground": "#B281EB" },
        "macro": {
            "foreground": "#FFA14F",
            "bold": false,
            "italic": false,
            "underline": false
        },
        "derive": {
            "foreground": "#FFA14F",
            "bold": false,
            "italic": false,
            "underline": false
        },
        "macro.library": {
            "foreground": "#FFA14F",
            "bold": false,
            "italic": false,
            "underline": false
        },
        "derive.library": {
            "foreground": "#FFA14F",
            "bold": false,
            "italic": false,
            "underline": false
        },
        "macro.globalScope:c": {
            "foreground": "#FFA14F",
            "bold": false,
            "italic": false,
            "underline": false
        },
        "magit-ref-name": { "foreground": "#78C2B3" },
        "magit-remote-ref-name": { "foreground": "#ACF2E4" },
        "unresolvedReference": {
            "foreground": "#F32C2C",
            "bold": false,
            "italic": false,
            "underline": false
        },
        "variable": { "foreground": "#C7C3C3D8" },
        "parameter": { "foreground": "#C7C3C3D8" },
        "macroBang": { "foreground": "#C7C3C3D8" },
        "*.mutable": { "underline": true }
    },
