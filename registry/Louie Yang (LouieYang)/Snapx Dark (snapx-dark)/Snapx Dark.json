{
    "name": "Snapx",
    "tokenColors": [
        {
            "name": "Global settings",
            "settings": { "background": "#12191D", "foreground": "#FFFFFF" }
        },
        {
            "name": "String",
            "scope": "string",
            "settings": { "foreground": "#17cb83" }
        },
        {
            "name": "String Escape",
            "scope": "constant.character.escape, text.html constant.character.entity.named, punctuation.definition.entity.html",
            "settings": { "foreground": "#1efaa2" }
        },
        {
            "name": "Boolean",
            "scope": "constant.language.boolean",
            "settings": { "foreground": "#89ff2f" }
        },
        {
            "name": "Number",
            "scope": "constant.numeric",
            "settings": { "foreground": "#0088ff" }
        },
        {
            "name": "Identifier",
            "scope": "variable, support.variable, support.class, support.constant, meta.definition.variable, entity.name.function",
            "settings": { "foreground": "#b5b0ff" }
        },
        {
            "name": "Constant",
            "scope": "variable.other.constant",
            "settings": { "foreground": "#ff5177" }
        },
        {
            "name": "Keyword",
            "scope": "keyword, modifier, variable.language.this, support.type.object, constant.language",
            "settings": { "foreground": "#5eb7ee" }
        },
        {
            "name": "Keyword",
            "scope": "keyword.control.flow.js",
            "settings": { "foreground": "#FFE400" }
        },
        {
            "name": "Function call",
            "scope": "entity.name.function, support.function",
            "settings": { "foreground": "#FFE400" }
        },
        {
            "name": "Storage",
            "scope": "storage.type, storage.modifier, keyword.operator.expression",
            "settings": { "foreground": "#a1ff2f" }
        },
        {
            "name": "Modules",
            "scope": "support.module, support.node",
            "settings": { "foreground": "#b2ff46", "fontStyle": "italic" }
        },
        {
            "name": "Type",
            "scope": "support.type",
            "settings": { "foreground": "#8cff00" }
        },
        {
            "name": "Type",
            "scope": "entity.name.type, entity.other.inherited-class",
            "settings": { "foreground": "#aeff00" }
        },
        {
            "name": "Comment",
            "scope": "comment, comment.block.js",
            "settings": { "foreground": "#576f97", "fontStyle": "italic" }
        },
        {
            "name": "Class",
            "scope": "entity.name.type.class",
            "settings": { "foreground": "#009dff", "fontStyle": "underline" }
        },
        {
            "name": "Class variable",
            "scope": "variable.object.property, meta.field.declaration entity.name.function",
            "settings": { "foreground": "#5eb7ee" }
        },
        {
            "name": "Class method",
            "scope": "meta.definition.method entity.name.function",
            "settings": { "foreground": "#5eb7ee" }
        },
        {
            "name": "Function definition",
            "scope": "meta.function, entity.name.function",
            "settings": { "foreground": "#5eb7ee" }
        },
        {
            "name": "Template expression",
            "scope": "template.expression.begin, template.expression.end, punctuation.definition.template-expression.begin, punctuation.definition.template-expression.end",
            "settings": { "foreground": "#2f9eff" }
        },
        {
            "name": "Reset embedded/template expression colors",
            "scope": "meta.embedded, source.groovy.embedded, meta.template.expression",
            "settings": { "foreground": "#FFFFFF" }
        },
        {
            "name": "YAML key",
            "scope": "entity.name.tag.yaml",
            "settings": { "foreground": "#46d4ff" }
        },
        {
            "name": "JSON key",
            "scope": "meta.object-literal.key, meta.object-literal.key string, support.type.property-name.json",
            "settings": { "foreground": "#5eb7ee" }
        },
        {
            "name": "JSON constant",
            "scope": "constant.language.json",
            "settings": { "foreground": "#2f9eff" }
        },
        {
            "name": "CSS class",
            "scope": "entity.other.attribute-name.class",
            "settings": { "foreground": "#2f9eff" }
        },
        {
            "name": "CSS ID",
            "scope": "entity.other.attribute-name.id",
            "settings": { "foreground": "#14A76C" }
        },
        {
            "name": "CSS tag",
            "scope": "source.css entity.name.tag",
            "settings": { "foreground": "#5eb7ee" }
        },
        {
            "name": "HTML tag outer",
            "scope": "meta.tag, punctuation.definition.tag",
            "settings": { "foreground": "#2facff" }
        },
        {
            "name": "HTML tag inner",
            "scope": "entity.name.tag",
            "settings": { "foreground": "#98eeff" }
        },
        {
            "name": "HTML tag attribute",
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#a2ff00" }
        },
        {
            "name": "Markdown heading",
            "scope": "markup.heading",
            "settings": { "foreground": "#2f9eff" }
        },
        {
            "name": "Markdown link text",
            "scope": "text.html.markdown meta.link.inline, meta.link.reference",
            "settings": { "foreground": "#46d4ff" }
        },
        {
            "name": "Markdown list item",
            "scope": "text.html.markdown beginning.punctuation.definition.list",
            "settings": { "foreground": "#2f9eff" }
        },
        {
            "name": "Markdown italic",
            "scope": "markup.italic",
            "settings": { "foreground": "#46d4ff", "fontStyle": "italic" }
        },
        {
            "name": "Markdown bold",
            "scope": "markup.bold",
            "settings": { "foreground": "#46d4ff", "fontStyle": "bold" }
        },
        {
            "name": "Markdown bold italic",
            "scope": "markup.bold markup.italic, markup.italic markup.bold",
            "settings": { "foreground": "#46d4ff", "fontStyle": "italic bold" }
        },
        {
            "name": "Markdown code block",
            "scope": "markup.fenced_code.block.markdown punctuation.definition.markdown",
            "settings": { "foreground": "#14A76C" }
        },
        {
            "name": "Markdown inline code",
            "scope": "markup.inline.raw.string.markdown",
            "settings": { "foreground": "#14A76C" }
        },
        {
            "name": "Markdown Punctuation",
            "scope": [
                "punctuation.definition.heading.markdown",
                "punctuation.definition.string.begin.markdown",
                "punctuation.definition.string.end.markdown",
                "punctuation.definition.quote.begin.markdown",
                "punctuation.definition.list.begin.markdown",
                "markup.fenced_code.block.markdown",
                "meta.separator.markdown"
            ],
            "settings": { "foreground": "#356ea0" }
        },
        {
            "name": "INI property name",
            "scope": "keyword.other.definition.ini",
            "settings": { "foreground": "#46ffb5" }
        },
        {
            "name": "INI section title",
            "scope": "entity.name.section.group-title.ini",
            "settings": { "foreground": "#2f9eff" }
        },
        {
            "name": "C# class",
            "scope": "source.cs meta.class.identifier storage.type",
            "settings": { "foreground": "#5eb7ee", "fontStyle": "underline" }
        },
        {
            "name": "C# class method",
            "scope": "source.cs meta.method.identifier entity.name.function",
            "settings": { "foreground": "#5eb7ee" }
        },
        {
            "name": "C# function call",
            "scope": "source.cs meta.method-call meta.method, source.cs entity.name.function",
            "settings": { "foreground": "#0077ff" }
        },
        {
            "name": "C# type",
            "scope": "source.cs storage.type",
            "settings": { "foreground": "#5eb7ee" }
        },
        {
            "name": "C# return type",
            "scope": "source.cs meta.method.return-type",
            "settings": { "foreground": "#5eb7ee" }
        },
        {
            "name": "C# preprocessor",
            "scope": "source.cs meta.preprocessor",
            "settings": { "foreground": "#1b3951" }
        },
        {
            "name": "C# namespace",
            "scope": "source.cs entity.name.type.namespace",
            "settings": { "foreground": "#FFFFFF" }
        },
        {
            "name": "Global settings",
            "settings": { "background": "#061826", "foreground": "#FFFFFF" }
        },
        {
            "name": "Cursive Italic Font",
            "scope": [
                "modifier",
                "this",
                "comment",
                "storage.modifier.js",
                "storage.modifier.ts",
                "storage.modifier.tsx",
                "entity.other.attribute-name.js",
                "entity.other.attribute-name.ts",
                "entity.other.attribute-name.tsx",
                "entity.other.attribute-name.html",
                "keyword.control.flow.js"
            ],
            "settings": { "fontStyle": "italic" }
        }
    ],
    "colors": {
        "focusBorder": "#00507e",
        "foreground": "#FFFFFF",
        "button.background": "#2f59ff",
        "button.foreground": "#ffffff",
        "dropdown.background": "#0e1e2b",
        "input.background": "#0e1e2b",
        "inputOption.activeBorder": "#2fbdff",
        "list.activeSelectionBackground": "#2feaff80",
        "list.activeSelectionForeground": "#FFFFFF",
        "list.dropBackground": "#2f93ff80",
        "list.focusBackground": "#2f97ff80",
        "list.focusForeground": "#FFFFFF",
        "list.highlightForeground": "#2fffe7",
        "list.hoverBackground": "#FFFFFF1a",
        "list.inactiveSelectionBackground": "#FFFFFF33",
        "activityBar.background": "#0c1a25",
        "activityBar.dropBackground": "#2f9eff80",
        "activityBarBadge.background": "#2f47ff",
        "activityBarBadge.foreground": "#ffffff",
        "badge.background": "#2f55ff",
        "badge.foreground": "#ffffff",
        "sideBar.background": "#0E1316",
        "sideBarSectionHeader.background": "#0c1a25",
        "editorGroup.dropBackground": "#322fff80",
        "editorGroup.focusedEmptyBorder": "#2fffcb",
        "editorGroupHeader.tabsBackground": "#0E1316",
        "tab.border": "#00000033",
        "tab.activeBorder": "#2f9eff",
        "tab.lastPinnedBorder": "#2f9eff",
        "tab.inactiveBackground": "#0c1a25",
        "tab.activeModifiedBorder": "#2f9eff",
        "tab.inactiveModifiedBorder": "#993c1c",
        "tab.unfocusedActiveModifiedBorder": "#cc5025",
        "tab.unfocusedInactiveModifiedBorder": "#993c1c",
        "editor.background": "#061826",
        "editor.foreground": "#FFFFFF",
        "editorLineNumber.foreground": "#FFFFFF4d",
        "editorLineNumber.activeForeground": "#2f9eff",
        "editorCursor.foreground": "#FFE400",
        "editor.lineHighlightBorder": "#FFFFFF1a",
        "editor.rangeHighlightBackground": "#FFFFFF0d",
        "editorWidget.background": "#0E1316",
        "editorHoverWidget.background": "#0E1316",
        "editorMarkerNavigation.background": "#0E1316",
        "peekView.border": "#2f9eff",
        "peekViewEditor.background": "#070f15",
        "peekViewResult.background": "#0E1316",
        "peekViewTitle.background": "#061826",
        "panel.background": "#0E1316",
        "panel.border": "#FFFFFF1a",
        "panelTitle.activeBorder": "#FFFFFF80",
        "panelTitle.inactiveForeground": "#FFFFFF80",
        "statusBar.background": "#070f15",
        "statusBar.debuggingBackground": "#2f9eff",
        "statusBar.debuggingForeground": "#ffffff",
        "statusBar.noFolderBackground": "#070f15",
        "statusBarItem.activeBackground": "#2f9eff80",
        "statusBarItem.hoverBackground": "#FFFFFF1a",
        "statusBarItem.remoteBackground": "#2f9eff",
        "statusBarItem.remoteForeground": "#ffffff",
        "titleBar.activeBackground": "#070f15",
        "pickerGroup.border": "#FFFFFF1a",
        "debugToolBar.background": "#0c1a25",
        "selection.background": "#2f9eff",
        "sash.hoverBorder": "#2f9eff"
    },
    "$schema": "vscode://schemas/color-theme"
}
