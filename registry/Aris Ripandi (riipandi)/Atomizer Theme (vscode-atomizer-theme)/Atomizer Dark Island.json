    "tokenColors": [
        {
            "name": "Strings",
            "scope": [
                "string",
                "string.quoted",
                "string.template",
                "string.quoted.single",
                "string.quoted.double",
                "string.quoted.triple"
            ],
            "settings": { "foreground": "#6aab73" }
        },
        {
            "name": "String interpolation",
            "scope": [
                "punctuation.definition.template-expression.begin",
                "punctuation.definition.template-expression.end",
                "punctuation.section.embedded"
            ],
            "settings": { "foreground": "#cf8e6d" }
        },
        {
            "name": "New keyword, logical operator keyword",
            "scope": ["keyword.operator.new", "keyword.operator.logical"],
            "settings": { "foreground": "#ba8ef7" }
        },
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#7F838C", "fontStyle": "italic" }
        },
        {
            "name": "Documentation comments",
            "scope": ["comment.block.documentation", "comment.block.javadoc"],
            "settings": { "foreground": "#7F838C", "fontStyle": "italic" }
        },
        {
            "name": "Comment Shebang",
            "scope": ["comment.line.shebang"],
            "settings": { "foreground": "#ff8ad1" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "string constant.other.placeholder"],
            "settings": { "foreground": "#14b8a6" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#f43f5e" }
        },
        {
            "name": "Keyword, Storage",
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#ba8ef7" }
        },
        {
            "name": "Operators",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#14b8a6" }
        },
        {
            "name": "Operator, Misc",
            "scope": ["keyword.control"],
            "settings": { "foreground": "#ba8ef7" }
        },
        {
            "name": "Constant",
            "scope": ["constant.language", "variable.other.property"],
            "settings": { "foreground": "#ffa763" }
        },
        {
            "name": "Punctuation template expression",
            "scope": [
                "punctuation.definition.template-expression",
                "punctuation.definition.typeparameters",
                "meta.template.expression"
            ],
            "settings": { "foreground": "#14b8a6" }
        },
        {
            "name": "Tag, Misc",
            "scope": [
                "punctuation.definition.tag",
                "punctuation.separator.inheritance.php",
                "punctuation.definition.tag.html",
                "punctuation.definition.tag.begin.html",
                "punctuation.definition.tag.end.html"
            ],
            "settings": { "foreground": "#14b8a6" }
        },
        {
            "name": "Builtin function",
            "scope": ["support.function.builtin"],
            "settings": { "foreground": "#56a8f5" }
        },
        {
            "name": "Tag",
            "scope": [
                "entity.name.tag",
                "meta.tag.sgml",
                "markup.deleted.git_gutter"
            ],
            "settings": { "foreground": "#f43f5e" }
        },
        {
            "name": "Component Tag",
            "scope": ["support.class.component"],
            "settings": { "foreground": "#ba8ef7" }
        },
        {
            "name": "Function, Special Method",
            "scope": [
                "entity.name.function",
                "meta.function-call",
                "variable.function",
                "support.function",
                "keyword.other.special-method"
            ],
            "settings": { "foreground": "#f7768e" }
        },
        {
            "name": "Function, Special Method",
            "scope": ["punctuation.definition.arguments", "meta.function-call"],
            "settings": { "foreground": "#14b8a6" }
        },
        {
            "name": "punctuation.accessor.js",
            "scope": ["punctuation.accessor.js", "punctuation.parenthesis"],
            "settings": { "foreground": "#14b8a6" }
        },
        {
            "name": "Block Level Variables",
            "scope": ["variable.other"],
            "settings": { "foreground": "#14b8a6" }
        },
        {
            "name": "Number",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#56a8f5" }
        },
        {
            "name": "Constant, Function Argument, Tag Attribute, Embedded",
            "scope": [
                "support.constant",
                "constant.character",
                "constant.escape",
                "keyword.other.unit",
                "keyword.other",
                "variable.parameter"
            ],
            "settings": { "foreground": "#14b8a6" }
        },
        {
            "name": "Variable parameter",
            "scope": ["support.variable.property"],
            "settings": { "foreground": "#ffa763" }
        },
        {
            "name": "String, Symbols, Inherited Class, Markup Heading",
            "scope": [
                "string",
                "markup.heading",
                "markup.inserted.git_gutter",
                "string.unquoted.label.js"
            ],
            "settings": { "foreground": "#81CA91" }
        },
        {
            "name": "Entity name",
            "scope": ["meta.return.type"],
            "settings": { "foreground": "#f7768e" }
        },
        {
            "name": "Entity Types",
            "scope": ["support.type"],
            "settings": { "foreground": "#14b8a6" }
        },
        {
            "name": "CSS unit",
            "scope": [
                "keyword.other.unit.px.css",
                "support.constant.color.w3c-standard-color-name.css",
                "keyword.other.unit.s.css",
                "support.constant.property-value.css",
                "meta.property-value.css"
            ],
            "settings": { "foreground": "#ffa763" }
        },
        {
            "name": "CSS Class and Support",
            "scope": [
                "source.css support.type.property-name",
                "source.sass support.type.property-name",
                "source.scss support.type.property-name",
                "source.less support.type.property-name",
                "source.stylus support.type.property-name",
                "source.postcss support.type.property-name"
            ],
            "settings": { "foreground": "#14b8a6" }
        },
        {
            "name": "Sub-methods",
            "scope": [
                "entity.name.module.js",
                "variable.import.parameter.js",
                "variable.other.class.js"
            ],
            "settings": { "foreground": "#14b8a6" }
        },
        {
            "name": "Language methods",
            "scope": ["variable.language"],
            "settings": { "foreground": "#14b8a6" }
        },
        {
            "name": "entity.name.method.js",
            "scope": ["entity.name.method.js"],
            "settings": { "foreground": "#14b8a6" }
        },
        {
            "name": "meta.method.js",
            "scope": [
                "meta.class-method.js entity.name.function.js",
                "variable.function.constructor"
            ],
            "settings": { "foreground": "#f7768e" }
        },
        {
            "name": "function arrow",
            "scope": ["storage.type.function.arrow"],
            "settings": { "foreground": "#14b8a6" }
        },
        {
            "name": "Type",
            "scope": [
                "support.type",
