{
    "name": "Vanilla Truffle",
    "type": "light",
    "colors": {
        "editor.background": "#FDFBF7",
        "editor.foreground": "#3D312A",
        "activityBar.background": "#EAE0D5",
        "activityBar.foreground": "#000000",
        "sideBar.background": "#F5EFE6",
        "sideBar.foreground": "#3D312A",
        "titleBar.activeBackground": "#EAE0D5",
        "titleBar.activeForeground": "#000000",
        "statusBar.background": "#EAE0D5",
        "statusBar.foreground": "#000000",
        "terminal.background": "#FDFBF7",
        "terminal.foreground": "#3D312A",
        "editor.selectionBackground": "#DCD0C0",
        "editorCursor.foreground": "#D68C45",
        "editorLineNumber.foreground": "#998E82",
        "editorIndentGuide.background": "#DCD0C0",
        "tab.activeBackground": "#FDFBF7",
        "tab.inactiveBackground": "#F5EFE6",
        "tab.activeForeground": "#3D312A",
        "tab.inactiveForeground": "#998E82"
    },
    "tokenColors": [
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#998E82", "fontStyle": "italic" }
        },
        {
            "scope": ["keyword", "storage", "variable.language"],
            "settings": { "foreground": "#FFD700" }
        },
        {
            "scope": ["string", "punctuation.definition.string"],
            "settings": { "foreground": "#E24E6B" }
        },
        {
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call"
            ],
            "settings": { "foreground": "#42B883" }
        },
        {
            "scope": ["constant.numeric", "constant.language"],
            "settings": { "foreground": "#D68C45" }
        },
        {
            "scope": ["variable", "support.variable", "entity.name.type"],
            "settings": { "foreground": "#3D312A" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
