{
    "name": "Dark Chocolate",
    "type": "dark",
    "colors": {
        "editor.background": "#261A15",
        "editor.foreground": "#E8D8D0",
        "activityBar.background": "#1C120E",
        "activityBar.foreground": "#FFFFFF",
        "sideBar.background": "#221612",
        "sideBar.foreground": "#E8D8D0",
        "titleBar.activeBackground": "#1C120E",
        "titleBar.activeForeground": "#FFFFFF",
        "statusBar.background": "#1C120E",
        "statusBar.foreground": "#FFFFFF",
        "terminal.background": "#261A15",
        "terminal.foreground": "#E8D8D0",
        "editor.selectionBackground": "#402D24",
        "editorCursor.foreground": "#D68C45",
        "editorLineNumber.foreground": "#80665A",
        "editorIndentGuide.background": "#402D24",
        "tab.activeBackground": "#261A15",
        "tab.inactiveBackground": "#221612",
        "tab.activeForeground": "#E8D8D0",
        "tab.inactiveForeground": "#80665A"
    },
    "tokenColors": [
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#80665A", "fontStyle": "italic" }
        },
        {
            "scope": ["keyword", "storage", "variable.language"],
            "settings": { "foreground": "#FFD700" }
        },
        {
            "scope": ["string", "punctuation.definition.string"],
            "settings": { "foreground": "#E24E6B" }
        },
        {
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call"
            ],
            "settings": { "foreground": "#42B883" }
        },
        {
            "scope": ["constant.numeric", "constant.language"],
            "settings": { "foreground": "#D68C45" }
        },
        {
            "scope": ["variable", "support.variable", "entity.name.type"],
            "settings": { "foreground": "#E8D8D0" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
