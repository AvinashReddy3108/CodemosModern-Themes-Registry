{
    "name": "Milkybar White Light",
    "type": "light",
    "colors": {
        "editor.background": "#FFFFFF",
        "editor.foreground": "#2A231C",
        "activityBar.background": "#F3EEDD",
        "activityBar.foreground": "#000000",
        "sideBar.background": "#FAFAF5",
        "sideBar.foreground": "#2A231C",
        "titleBar.activeBackground": "#F3EEDD",
        "titleBar.activeForeground": "#000000",
        "statusBar.background": "#F3EEDD",
        "statusBar.foreground": "#000000",
        "terminal.background": "#FFFFFF",
        "terminal.foreground": "#2A231C",
        "editor.selectionBackground": "#E6DFCD",
        "editorCursor.foreground": "#D68C45",
        "editorLineNumber.foreground": "#A19989",
        "editorIndentGuide.background": "#E6DFCD",
        "tab.activeBackground": "#FFFFFF",
        "tab.inactiveBackground": "#FAFAF5",
        "tab.activeForeground": "#2A231C",
        "tab.inactiveForeground": "#A19989"
    },
    "tokenColors": [
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#A19989", "fontStyle": "italic" }
        },
        {
            "scope": ["keyword", "storage", "variable.language"],
            "settings": { "foreground": "#FFD700" }
        },
        {
            "scope": ["string", "punctuation.definition.string"],
            "settings": { "foreground": "#E24E6B" }
        },
        {
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call"
            ],
            "settings": { "foreground": "#42B883" }
        },
        {
            "scope": ["constant.numeric", "constant.language"],
            "settings": { "foreground": "#D68C45" }
        },
        {
            "scope": ["variable", "support.variable", "entity.name.type"],
            "settings": { "foreground": "#2A231C" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
