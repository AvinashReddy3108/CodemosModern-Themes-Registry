{
    "name": "PromptScript Light",
    "type": "light",
    "colors": {
        "editor.background": "#ffffff",
        "editor.foreground": "#000000",
        "editorLineNumber.foreground": "#237893",
        "editorCursor.foreground": "#000000",
        "editor.selectionBackground": "#add6ff",
        "editor.inactiveSelectionBackground": "#e5ebf1"
    },
    "tokenColors": [
        {
            "scope": "keyword.control.version.promptscript",
            "settings": { "foreground": "#af00db", "fontStyle": "bold" }
        },
        {
            "scope": "entity.name.function.promptscript",
            "settings": { "foreground": "#267f99", "fontStyle": "bold" }
        },
        {
            "scope": "variable.parameter.flag.promptscript",
            "settings": { "foreground": "#001080", "fontStyle": "italic" }
        },
        {
            "scope": "variable.other.reference.promptscript",
            "settings": { "foreground": "#a31515", "fontStyle": "bold" }
        },
        {
            "scope": "variable.other.constant.promptscript",
            "settings": { "foreground": "#0070c1" }
        },
        {
            "scope": "keyword.control.promptscript",
            "settings": { "foreground": "#af00db" }
        },
        {
            "scope": "keyword.other.promptscript",
            "settings": { "foreground": "#0000ff" }
        },
        {
            "scope": "storage.modifier.promptscript",
            "settings": { "foreground": "#0000ff" }
        },
        { "scope": "string.quoted", "settings": { "foreground": "#a31515" } },
        {
            "scope": "constant.numeric",
            "settings": { "foreground": "#098658" }
        },
        {
            "scope": "constant.language",
            "settings": { "foreground": "#0000ff" }
        },
        {
            "scope": "keyword.operator",
            "settings": { "foreground": "#000000" }
        },
        {
            "scope": "comment",
            "settings": { "foreground": "#008000", "fontStyle": "italic" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
