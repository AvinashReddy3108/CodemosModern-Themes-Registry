{
    "name": "Rage",
    "settings": [
        {
            "settings": {
                "guide": "#333333",
                "selection": "#3f7fbf7f",
                "inactiveSelection": "#003f7f3f",
                "lineHighlight": "#003f7f3f",
                "findRangeHighlight": "#003f7f3f",
                "rangeHighlight": "#003f7f3f",
                "findMatchHighlight": "#3fbf3f3f",
                "currentFindMatchHighlight": "#3fbf3f3f",
                "selectionHighlight": "#3fbf3f3f",
                "referenceHighlight": "#3fbf3f3f",
                "wordHighlight": "#3fbf3f3f",
                "wordHighlightStrong": "#bf3f3f3f"
            }
        },
        { "scope": "invalid", "settings": { "foreground": "#bf7f7f" } },
        {
            "scope": "invalid.deprecated",
            "settings": { "foreground": "#bf7fbf" }
        },
        {
            "scope": "comment, punctuation.definition.comment",
            "settings": { "foreground": "#3fbf3f7f" }
        },
        { "scope": "punctuation", "settings": { "foreground": "#7f7f7f" } },
        { "scope": "constant", "settings": { "foreground": "#bfbf7f" } },
        { "scope": "string", "settings": { "foreground": "#bf7f7f" } },
        {
            "scope": "keyword, variable.language",
            "settings": { "foreground": "#7f7fbf" }
        },
        { "scope": "storage", "settings": { "foreground": "#3fbfbf" } },
        {
            "scope": "variable, support.variable, entity.name, meta",
            "settings": { "foreground": "#569cd6" }
        },
        {
            "scope": "entity.name.function, support.function",
            "settings": { "foreground": "#bf7fbf" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
