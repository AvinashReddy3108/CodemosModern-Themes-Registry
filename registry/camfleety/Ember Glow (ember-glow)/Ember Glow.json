    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#6b5d52", "fontStyle": "italic" }
        },
        {
            "name": "Keywords",
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#e8834a" }
        },
        {
            "name": "Control Keywords",
            "scope": [
                "keyword.control",
                "keyword.operator.new",
                "keyword.operator.expression"
            ],
            "settings": { "foreground": "#cf6a3c" }
        },
        {
            "name": "Operators",
            "scope": ["keyword.operator", "punctuation.accessor"],
            "settings": { "foreground": "#c4b8ac" }
        },
        {
            "name": "Strings",
            "scope": ["string", "string.quoted"],
            "settings": { "foreground": "#a3b38c" }
        },
        {
            "name": "Template Strings",
            "scope": [
                "string.template",
                "punctuation.definition.string.template"
            ],
            "settings": { "foreground": "#a3b38c" }
        },
        {
            "name": "String Interpolation",
            "scope": [
                "punctuation.definition.template-expression",
                "punctuation.section.embedded"
            ],
            "settings": { "foreground": "#e8834a" }
        },
        {
            "name": "Numbers",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#daa090" }
        },
        {
            "name": "Constants",
            "scope": [
                "constant.language",
                "constant.character",
                "constant.other"
            ],
            "settings": { "foreground": "#daa090" }
        },
        {
            "name": "Boolean",
            "scope": ["constant.language.boolean"],
            "settings": { "foreground": "#e8834a" }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call"
            ],
            "settings": { "foreground": "#d4a656" }
        },
        {
            "name": "Function Parameters",
            "scope": ["variable.parameter", "meta.parameter"],
            "settings": { "foreground": "#c9856a" }
        },
        {
            "name": "Classes and Types",
            "scope": [
                "entity.name.class",
                "entity.name.type",
                "support.class",
                "support.type"
            ],
            "settings": { "foreground": "#c9856a" }
        },
        {
            "name": "Interfaces",
            "scope": ["entity.name.type.interface"],
            "settings": { "foreground": "#c9856a", "fontStyle": "italic" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "variable.other"],
            "settings": { "foreground": "#e0d6cc" }
        },
        {
            "name": "Variable Properties",
            "scope": [
                "variable.other.property",
                "variable.other.object.property"
            ],
            "settings": { "foreground": "#c4b8ac" }
        },
        {
            "name": "This/Self",
            "scope": [
                "variable.language.this",
                "variable.language.self",
                "variable.language.super"
            ],
            "settings": { "foreground": "#e8834a", "fontStyle": "italic" }
        },
        {
            "name": "Tags (HTML/JSX)",
            "scope": ["entity.name.tag", "punctuation.definition.tag"],
            "settings": { "foreground": "#cf6a3c" }
        },
        {
            "name": "Tag Attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#d4a656" }
        },
        {
            "name": "Component Tags (JSX)",
            "scope": ["support.class.component"],
            "settings": { "foreground": "#c9856a" }
        },
        {
            "name": "CSS Properties",
            "scope": ["support.type.property-name.css"],
            "settings": { "foreground": "#7a9ec2" }
        },
        {
            "name": "CSS Values",
            "scope": ["support.constant.property-value.css"],
            "settings": { "foreground": "#a3b38c" }
        },
        {
            "name": "CSS Selectors",
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css"
            ],
            "settings": { "foreground": "#d4a656" }
        },
        {
            "name": "Regex",
            "scope": ["string.regexp"],
            "settings": { "foreground": "#7eb8a8" }
        },
        {
            "name": "Escape Characters",
            "scope": ["constant.character.escape"],
            "settings": { "foreground": "#7eb8a8" }
        },
        {
            "name": "JSON Keys",
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#c9856a" }
        },
        {
            "name": "Markdown Headings",
            "scope": ["markup.heading", "entity.name.section.markdown"],
            "settings": { "foreground": "#e8834a", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Bold",
            "scope": ["markup.bold"],
            "settings": { "foreground": "#d4a656", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Italic",
            "scope": ["markup.italic"],
            "settings": { "foreground": "#c9856a", "fontStyle": "italic" }
        },
        {
            "name": "Markdown Links",
            "scope": ["markup.underline.link"],
            "settings": { "foreground": "#7a9ec2" }
        },
        {
            "name": "Markdown Code",
            "scope": ["markup.inline.raw", "markup.fenced_code"],
            "settings": { "foreground": "#a3b38c" }
        },
        {
            "name": "Markdown Lists",
            "scope": ["punctuation.definition.list.begin.markdown"],
            "settings": { "foreground": "#e8834a" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation.definition",
                "punctuation.separator",
                "punctuation.terminator"
            ],
            "settings": { "foreground": "#8a7e72" }
        },
        {
            "name": "Brackets",
            "scope": ["punctuation.section", "meta.brace"],
            "settings": { "foreground": "#8a7e72" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#d35d4c" }
        },
        {
            "name": "Deprecated",
            "scope": ["invalid.deprecated"],
            "settings": {
                "foreground": "#d35d4c",
                "fontStyle": "strikethrough"
            }
        },
        {
            "name": "Decorators",
            "scope": ["meta.decorator", "punctuation.decorator"],
            "settings": { "foreground": "#d4a656" }
        },
        {
            "name": "Import/Export",
            "scope": [
                "keyword.control.import",
                "keyword.control.export",
                "keyword.control.from"
            ],
            "settings": { "foreground": "#cf6a3c" }
        },
        {
            "name": "Module Names",
            "scope": ["entity.name.type.module"],
            "settings": { "foreground": "#a3b38c" }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "variable.readonly": "#daa090",
        "property.readonly": "#daa090",
        "enumMember": "#daa090",
        "namespace": "#c9856a",
        "interface": { "foreground": "#c9856a", "fontStyle": "italic" },
        "typeParameter": "#7eb8a8"
    },
    "$schema": "vscode://schemas/color-theme"
}
