    "semanticHighlighting": true,
    "tokenColors": [
        {
            "scope": [
                "comment",
                "punctuation.definition.comment",
                "string.comment"
            ],
            "settings": { "foreground": "#727169", "fontStyle": "italic" }
        },
        {
            "scope": [
                "constant",
                "entity.name.constant",
                "variable.other.constant",
                "variable.other.enummember"
            ],
            "settings": { "foreground": "#7FB4CA" }
        },
        {
            "scope": "variable.language",
            "settings": { "foreground": "#FF5D62" }
        },
        { "scope": ["entity.name"], "settings": { "foreground": "#7AA89F" } },
        {
            "scope": "entity.name.type",
            "settings": { "foreground": "#7AA89F" }
        },
        {
            "scope": "entity.name.function",
            "settings": { "foreground": "#7E9CD8" }
        },
        {
            "scope": "entity.name.namespace",
            "settings": { "foreground": "#DCD7BA" }
        },
        {
            "scope": "variable.parameter.function",
            "settings": { "foreground": "#DCD7BA" }
        },
        { "scope": "entity.name.tag", "settings": { "foreground": "#E6C384" } },
        {
            "scope": "entity.name.tag.html",
            "settings": { "foreground": "#957FB8" }
        },
        { "scope": "keyword", "settings": { "foreground": "#957FB8" } },
        {
            "scope": "keyword.control.flow",
            "settings": { "foreground": "#957FB8", "fontStyle": "bold" }
        },
        {
            "scope": "keyword.operator",
            "settings": { "foreground": "#C0A36E" }
        },
        {
            "scope": ["storage", "storage.type"],
            "settings": { "foreground": "#957FB8" }
        },
        {
            "scope": [
                "storage.modifier.package",
                "storage.modifier.import",
                "storage.type.java"
            ],
            "settings": { "foreground": "#DCD7BA" }
        },
        {
            "scope": [
                "string",
                "punctuation.definition.string",
                "string punctuation.section.embedded source",
                "markup.inline.raw.string"
            ],
            "settings": { "foreground": "#98BB6C" }
        },
        { "scope": "support", "settings": { "foreground": "#7E9CD8" } },
        { "scope": "support.type", "settings": { "foreground": "#7AA89F" } },
        {
            "scope": "support.function",
            "settings": { "foreground": "#7E9CD8" }
        },
        {
            "scope": "meta.property-name",
            "settings": { "foreground": "#E6C384" }
        },
        { "scope": "variable", "settings": { "foreground": "#DCD7BA" } },
        { "scope": "variable.other", "settings": { "foreground": "#DCD7BA" } },
        {
            "scope": "variable.other.property",
            "settings": { "foreground": "#E6C384" }
        },
        {
            "scope": "variable.other.readwrite",
            "settings": { "foreground": "#FFA066" }
        },
        { "scope": "punctuation", "settings": { "foreground": "#9CABCA" } },
        {
            "scope": "invalid.broken",
            "settings": { "fontStyle": "italic", "foreground": "#FF5D62" }
        },
        {
            "scope": "invalid.deprecated",
            "settings": { "fontStyle": "italic", "foreground": "#FF5D62" }
        },
        {
            "scope": "invalid.illegal",
            "settings": { "fontStyle": "italic", "foreground": "#FF5D62" }
        },
        {
            "scope": "invalid.unimplemented",
            "settings": { "fontStyle": "italic", "foreground": "#FF5D62" }
        },
        {
            "scope": "carriage-return",
            "settings": {
                "fontStyle": "italic underline",
                "background": "#E82424",
                "foreground": "#DCD7BA",
                "content": "^M"
            }
        },
        { "scope": "message.error", "settings": { "foreground": "#E82424" } },
        { "scope": "string variable", "settings": { "foreground": "#7E9CD8" } },
        {
            "scope": ["source.regexp", "string.regexp"],
            "settings": { "foreground": "#7FB4CA" }
        },
        {
            "scope": [
                "string.regexp.character-class",
                "string.regexp constant.character.escape",
                "string.regexp source.ruby.embedded",
                "string.regexp string.regexp.arbitrary-repitition"
            ],
            "settings": { "foreground": "#7FB4CA" }
        },
        {
            "scope": "string.regexp constant.character.escape",
            "settings": { "fontStyle": "bold", "foreground": "#7FB4CA" }
        },
        {
            "scope": "constant.character.escape",
            "settings": { "foreground": "#7FB4CA" }
        },
        {
            "scope": "support.constant",
            "settings": { "foreground": "#7E9CD8" }
        },
        {
            "scope": "support.variable",
            "settings": { "foreground": "#DCD7BA" }
        },
        {
            "scope": "meta.module-reference",
            "settings": { "foreground": "#7E9CD8" }
        },
        {
            "scope": "punctuation.definition.list.begin.markdown",
            "settings": { "foreground": "#FFA066" }
        },
        {
            "scope": ["markup.heading", "markup.heading entity.name"],
            "settings": { "fontStyle": "bold", "foreground": "#7E9CD8" }
        },
        {
            "scope": "markup.quote",
            "settings": { "foreground": "#727169", "fontStyle": "italic" }
        },
        {
            "scope": "markup.italic",
            "settings": { "fontStyle": "italic", "foreground": "#E46876" }
        },
        {
            "scope": "markup.bold",
            "settings": { "fontStyle": "bold", "foreground": "#DCD7BA" }
        },
        {
            "scope": ["markup.underline"],
            "settings": { "fontStyle": "underline", "foreground": "#7FB4CA" }
        },
        {
            "scope": ["markup.strikethrough"],
            "settings": { "fontStyle": "strikethrough" }
        },
        {
            "scope": "markup.inline.raw",
            "settings": { "foreground": "#957FB8" }
        },
        {
            "scope": [
                "markup.deleted",
                "meta.diff.header.from-file",
                "punctuation.definition.deleted"
            ],
            "settings": { "background": "#43242488", "foreground": "#C34043" }
        },
        {
            "scope": [
                "markup.inserted",
                "meta.diff.header.to-file",
                "punctuation.definition.inserted"
            ],
            "settings": { "background": "#2B332888", "foreground": "#76946A" }
        },
        {
            "scope": ["markup.changed", "punctuation.definition.changed"],
            "settings": { "background": "#3d2a1088", "foreground": "#DCA561" }
        },
        {
            "scope": ["markup.ignored", "markup.untracked"],
            "settings": { "foreground": "#727169", "background": "#7E9CD8" }
        },
        {
            "scope": "meta.diff.range",
            "settings": { "foreground": "#957FB8", "fontStyle": "bold" }
        },
        {
            "scope": "meta.diff.header",
            "settings": { "foreground": "#7E9CD8" }
        },
        {
            "scope": "meta.separator",
            "settings": { "fontStyle": "bold", "foreground": "#9CABCA" }
        },
        { "scope": "meta.output", "settings": { "foreground": "#7E9CD8" } },
        {
            "scope": [
                "brackethighlighter.tag",
                "brackethighlighter.curly",
                "brackethighlighter.round",
                "brackethighlighter.square",
                "brackethighlighter.angle",
                "brackethighlighter.quote"
            ],
            "settings": { "foreground": "#DCD7BA" }
        },
        {
            "scope": "brackethighlighter.unmatched",
            "settings": { "foreground": "#E82424" }
        },
        {
            "scope": ["constant.other.reference.link", "string.other.link"],
            "settings": { "foreground": "#98BB6C", "fontStyle": "underline" }
        },
        {
            "scope": "constant.numeric",
            "settings": { "foreground": "#D27E99" }
        },
        {
            "scope": "constant.language.boolean",
            "settings": { "foreground": "#FFA066" }
        },
        {
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#957FB8" }
        },
        {
            "scope": "entity.other.attribute-name.html",
            "settings": { "foreground": "#E6C384" }
        },
        {
            "scope": "entity.other.attribute-name.class",
            "settings": { "foreground": "#E6C384" }
        },
        {
            "scope": "entity.name.function.macro",
            "settings": { "foreground": "#FFA066" }
        }
    ],
    "semanticTokenColors": {
        "parameter": "#E6C384",
        "variable": "#DCD7BA",
        "arithmetic": "#C0A36E",
        "method": "#7E9CD8",
        "function": "#7E9CD8",
        "operator": "#C0A36E",
        "parameter.declaration": "#E6C384",
        "parameter.definition": "#E6C384",
        "variable.readonly": "#FFA066",
        "variable.readonly.local": "#DCD7BA",
        "variable.readonly.defaultLibrary": "#7FB4CA",
        "macro": "#FFA066",
        "keyword.controlFlow": { "foreground": "#957FB8", "fontStyle": "bold" }
    },
    "$schema": "vscode://schemas/color-theme"
}
