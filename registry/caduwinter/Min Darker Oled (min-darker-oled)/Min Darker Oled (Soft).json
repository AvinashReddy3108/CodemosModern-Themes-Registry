    "tokenColors": [
        { "settings": { "foreground": "#a89dd4" } },
        {
            "scope": [
                "support.function",
                "keyword.operator.accessor",
                "meta.group.braces.round.function.arguments",
                "meta.template.expression",
                "markup.fenced_code meta.embedded.block"
            ],
            "settings": { "foreground": "#a89dd4" }
        },
        { "scope": "emphasis", "settings": { "fontStyle": "italic" } },
        {
            "scope": [
                "strong",
                "markup.heading.markdown",
                "markup.bold.markdown"
            ],
            "settings": { "fontStyle": "bold", "foreground": "#c28a8d" }
        },
        {
            "scope": ["markup.italic.markdown"],
            "settings": { "fontStyle": "italic" }
        },
        {
            "scope": "meta.link.inline.markdown",
            "settings": { "fontStyle": "underline", "foreground": "#4a7eaa" }
        },
        {
            "scope": ["string", "markup.fenced_code", "markup.inline"],
            "settings": { "foreground": "#8ea3b3" }
        },
        {
            "scope": ["comment", "string.quoted.docstring.multi"],
            "settings": { "foreground": "#747b83" }
        },
        {
            "scope": [
                "constant.language",
                "variable.language.this",
                "variable.other.object",
                "variable.other.class",
                "variable.other.constant",
                "meta.property-name",
                "support",
                "string.other.link.title.markdown"
            ],
            "settings": { "foreground": "#8aaac7" }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.other.placeholder",
                "constant.character.format.placeholder",
                "meta.property-value",
                "keyword.other.unit",
                "keyword.other.template",
                "entity.name.tag.yaml",
                "entity.other.attribute-name",
                "support.type.property-name.json"
            ],
            "settings": { "foreground": "#c0c0c0" }
        },
        {
            "scope": [
                "keyword",
                "storage.modifier",
                "storage.type",
                "storage.control.clojure",
                "entity.name.function.clojure",
                "support.function.node",
                "punctuation.separator.key-value",
                "punctuation.definition.template-expression"
            ],
            "settings": { "foreground": "#c28a8f" }
        },
        {
            "scope": "variable.parameter.function",
            "settings": { "foreground": "#c49456" }
        },
        {
            "scope": [
                "entity.name.type",
                "entity.other.inherited-class",
                "meta.function-call",
                "meta.instance.constructor",
                "entity.other.attribute-name",
                "entity.name.function",
                "constant.keyword.clojure"
            ],
            "settings": { "foreground": "#a89dd4" }
        },
        {
            "scope": [
                "entity.name.tag",
                "string.quoted",
                "string.regexp",
                "string.interpolated",
                "string.template",
                "string.unquoted.plain.out.yaml",
                "keyword.other.template"
            ],
            "settings": { "foreground": "#c4a47e" }
        },
        {
            "scope": "token.info-token",
            "settings": { "foreground": "#5a82b0" }
        },
        {
            "scope": "token.warn-token",
            "settings": { "foreground": "#a88040" }
        },
        {
            "scope": "token.error-token",
            "settings": { "foreground": "#a85050" }
        },
        {
            "scope": "token.debug-token",
            "settings": { "foreground": "#7a5a7a" }
        },
        {
            "scope": [
                "punctuation.definition.arguments",
                "punctuation.definition.dict",
                "punctuation.separator",
                "meta.function-call.arguments"
            ],
            "settings": { "foreground": "#909090" }
        },
        {
            "name": "[Custom] Markdown links",
            "scope": "markup.underline.link",
            "settings": { "foreground": "#c4a47e" }
        },
        {
            "name": "[Custom] Markdown list",
            "scope": ["beginning.punctuation.definition.list.markdown"],
            "settings": { "foreground": "#c28a8d" }
        },
        {
            "name": "[Custom] Markdown punctuation definition",
            "scope": "punctuation.definition.metadata.markdown",
            "settings": { "foreground": "#c4a47e" }
        },
        {
            "name": "[Custom] Markdown punctuation definition brackets",
            "scope": [
                "punctuation.definition.string.begin.markdown",
                "punctuation.definition.string.end.markdown"
            ],
            "settings": { "foreground": "#8aaac7" }
        }
    ],
    "semanticHighlighting": true,
    "$schema": "vscode://schemas/color-theme"
}
