        },
        {
            "name": "string",
            "scope": "string",
            "settings": { "foreground": "#D69A00" }
        },
        {
            "name": "keyword",
            "scope": "keyword,keyword.control,keyword.operator,storage,storage.modifier,storage.type",
            "settings": { "foreground": "#F85552" }
        },
        {
            "name": "operator",
            "scope": "keyword.operator",
            "settings": { "foreground": "#F57D26" }
        },
        {
            "name": "const",
