    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "fontStyle": "italic", "foreground": "#68777D" }
        },
        {
            "name": "Variables",
            "scope": [
                "variable",
                "string constant.other.placeholder",
                "punctuation.definition.tag.end",
                "punctuation.definition.tag.begin",
                "punctuation.terminator.statement",
                "punctuation.separator.comma",
                "keyword.operator.rest",
                "punctuation.definition.typeparameters.begin",
                "punctuation.definition.typeparameters.end",
                "meta.object-literal.key",
                "text.html.derivative"
            ],
            "settings": { "foreground": "#EEFFFF" }
        },
        {
            "name": "Colors",
            "scope": ["constant.other.color"],
            "settings": { "foreground": "#ffffff" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#FF5370" }
        },
        {
            "name": "Keyword, Storage",
            "scope": [
                "keyword",
                "storage.type",
                "storage.modifier",
                "keyword.other.template",
                "keyword.other.substitution"
            ],
            "settings": { "foreground": "#6875E5" }
        },
        {
            "name": "Operator, Misc",
            "scope": [
                "keyword.control.import",
                "keyword.control",
                "constant.other.color",
                "entity.name.tag",
                "punctuation.definition.tag",
                "punctuation.separator.inheritance.php",
                "punctuation.definition.tag.html",
                "punctuation.definition.tag.begin.html",
                "punctuation.definition.tag.end.html",
                "punctuation.section.embedded"
            ],
            "settings": { "foreground": "#6875E5" }
        },
        {
            "name": "Tag",
            "scope": [
                "support.class.component",
                "keyword.operator.assignment",
                "storage.type.function.arrow",
                "meta.tag.sgml",
                "markup.deleted.git_gutter",
                "keyword.control.conditional",
                "keyword.control.flow",
                "keyword.operator.type.annotation",
                "punctuation.accessor",
                "entity.name.type.interface",
                "entity.name.type",
                "punctuation.terminator.rule",
                "punctuation.separator.key-value",
                "keyword.operator.arithmetic",
                "variable.language.super"
            ],
            "settings": { "foreground": "#EF81C0" }
        },
        {
            "name": "Function, Special Method",
            "scope": [
                "entity.name.function",
                "meta.function-call",
                "variable.function",
                "support.function",
                "keyword.other.special-method"
            ],
            "settings": { "foreground": "#5DEE9F" }
        },
        {
            "name": "Block Level Variables",
            "scope": [
                "meta.block variable.other",
                "meta.jsx.children",
                "punctuation.separator.parameter"
            ],
            "settings": { "foreground": "#EEFFFF" }
        },
        {
            "name": "Other Variable, String Link",
            "scope": ["support.other.variable", "string.other.link"],
            "settings": { "foreground": "#f07178" }
        },
        {
            "name": "Number, Constant, Function Argument, Tag Attribute, Embedded",
            "scope": [
                "constant.numeric",
                "constant.language",
                "support.constant",
                "constant.character",
                "constant.escape",
                "variable.parameter",
                "keyword.other.unit",
                "keyword.other"
            ],
            "settings": { "foreground": "#F78C6C" }
        },
        {
            "name": "String, Symbols, Inherited Class, Markup Heading",
            "scope": [
                "string",
                "constant.other.symbol",
                "constant.other.key",
                "entity.other.inherited-class",
                "markup.heading",
                "markup.inserted.git_gutter",
                "meta.group.braces.curly constant.other.object.key.js string.unquoted.label.js"
            ],
            "settings": { "foreground": "#5DEE9F" }
        },
        {
            "name": "Class, Support",
            "scope": [
                "entity.name",
                "support.type",
                "support.class",
                "support.orther.namespace.use.php",
                "meta.use.php",
                "support.other.namespace.php",
                "markup.changed.git_gutter",
                "support.type.sys-types",
                "support.type.primitive",
                "constant.numeric.decimal",
                "meta.brace.square"
            ],
            "settings": { "foreground": "#84C7F8" }
        },
        {
            "name": "Entity Types",
            "scope": ["support.type"],
            "settings": { "foreground": "#B2CCD6" }
