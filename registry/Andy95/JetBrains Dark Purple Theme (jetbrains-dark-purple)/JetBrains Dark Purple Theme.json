    "tokenColors": [
        {
            "name": "Text",
            "scope": ["source", "text"],
            "settings": { "foreground": "#C9C9D1" }
        },
        {
            "name": "Comment",
            "scope": [
                "comment",
                "comment.line",
                "punctuation.definition.comment"
            ],
            "settings": { "foreground": "#676773" }
        },
        {
            "name": "Block Comment",
            "scope": ["comment.block"],
            "settings": { "foreground": "#676773" }
        },
        {
            "name": "Doc Comment",
            "scope": [
                "comment.block.documentation",
                "comment.block.javadoc",
                "comment.block.documentation.js",
                "comment.block.documentation.ts"
            ],
            "settings": { "foreground": "#5A6E5A", "fontStyle": "italic" }
        },
        {
            "name": "Doc Comment Tag",
            "scope": [
                "comment.block.documentation storage.type.class.jsdoc",
                "comment.block.documentation entity.name.tag",
                "storage.type.class.jsdoc",
                "entity.name.tag.inline.jsdoc"
            ],
            "settings": { "foreground": "#5A6E5A", "fontStyle": "italic" }
        },
        {
            "name": "Doc Comment Tag Value",
            "scope": ["comment.block.documentation variable.other"],
            "settings": { "foreground": "#8C6154" }
        },
        {
            "name": "Keyword",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.new",
                "keyword.operator.delete",
                "keyword.operator.typeof",
                "keyword.operator.void",
                "keyword.operator.in",
                "keyword.operator.instanceof",
                "keyword.other.unit"
            ],
            "settings": { "foreground": "#E6967A" }
        },
        {
            "name": "Storage type",
            "scope": [
                "storage.type",
                "storage.modifier",
                "keyword.declaration"
            ],
            "settings": { "foreground": "#E6967A" }
        },
        {
            "name": "Async / await",
            "scope": [
                "keyword.control.async",
                "keyword.control.await",
                "keyword.control.from",
                "keyword.control.import",
                "keyword.control.export",
                "keyword.control.as"
            ],
            "settings": { "foreground": "#E6967A" }
        },
        {
            "name": "String",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#62A362" }
        },
        {
            "name": "String escape — valid",
            "scope": [
                "constant.character.escape",
                "string.regexp constant.character.escape"
            ],
            "settings": { "foreground": "#E0957B" }
        },
        {
            "name": "String escape — invalid",
            "scope": ["invalid.illegal.bad-ampersand", "invalid.illegal"],
            "settings": { "foreground": "#F23F6C" }
        },
        {
            "name": "Template expression",
            "scope": [
