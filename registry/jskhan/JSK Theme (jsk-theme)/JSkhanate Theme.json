{
    "name": "JSkhanate Theme",
    "colors": {
        "terminal.background": "#222831",
        "terminal.foreground": "#d2d3d3",
        "terminal.selectionBackground": "#4E535A",
        "terminal.selectionForeground": "#EFEFEF",
        "terminalCursor.background": "#1F242C",
        "terminalCursor.foreground": "#03C4A1",
        "terminal.ansiBlack": "#1F242C",
        "terminal.ansiBrightBlack": "#222831",
        "terminal.ansiBlue": "#919498",
        "terminal.ansiBrightBlue": "#D2D3D3",
        "terminal.ansiCyan": "#44BF92",
        "terminal.ansiBrightCyan": "#4CD4A2",
        "terminal.ansiGreen": "#027661",
        "terminal.ansiBrightGreen": "#03C4A1",
        "terminal.ansiMagenta": "#AC6A47",
        "terminal.ansiBrightMagenta": "#F69765",
        "terminal.ansiRed": "#A24657",
        "terminal.ansiBrightRed": "#E8647C",
        "terminal.ansiWhite": "#D2D3D3",
        "terminal.ansiBrightWhite": "#EFEFEF",
        "terminal.ansiYellow": "#A3A453",
        "terminal.ansiBrightYellow": "#E9EA77",
        "editor.background": "#222831",
        "editor.foreground": "#d2d3d3",
        "editor.selectionBackground": "#383e46",
        "activityBar.background": "#383e46",
        "activityBar.foreground": "#d2d3d3",
        "activityBar.border": "#03c4a1",
        "activityBarBadge.background": "#03c4a1",
        "activityBarBadge.foreground": "#ffffff",
        "sideBar.background": "#1f242c",
        "sideBarTitle.foreground": "#d2d3d3",
        "tab.activeBackground": "#222831",
        "tab.activeForeground": "#d2d3d3",
        "tab.inactiveBackground": "#1f242c",
        "tab.inactiveForeground": "#919498",
        "tab.activeBorder": "#03c4a1",
        "tab.hoverBackground": "#383e46",
        "statusBar.background": "#1f242c",
        "statusBar.foreground": "#03c4a1",
        "statusBar.border": "#383e46",
        "titleBar.activeBackground": "#222831",
        "titleBar.border": "#383e46",
        "titleBar.inactiveBackground": "#1f242c"
    },
    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#4E5A65" }
        },
        {
            "name": "Function Name",
            "scope": ["entity.name.function"],
            "settings": { "foreground": "#03C4A1" }
        },
        {
            "name": "Language Syntax",
            "scope": "storage.type",
            "settings": { "foreground": "#027661" }
        },
        {
            "name": "Import, Export",
            "scope": [
                "keyword.control.import",
                "keyword.control.from",
                "keyword.control.as",
                "keyword.control.export",
                "keyword.control.default"
            ],
            "settings": { "foreground": "#027661" }
        },
        {
            "name": "Import String",
            "scope": "meta.import",
            "settings": { "foreground": "#919498" }
        },
        {
            "name": "Import Variable",
            "scope": "variable.other.readwrite.alias",
            "settings": { "foreground": "#D2D3D3" }
        },
        {
            "name": "Parameter",
            "scope": "variable.parameter",
            "settings": { "foreground": "#D2D3D3" }
        },
        {
            "name": "Boolean && Integer",
            "scope": ["constant.language.boolean", "constant.numeric"],
            "settings": { "foreground": "#AC6A47" }
        },
        {
            "name": "String",
            "scope": ["string", "string.quoted"],
            "settings": { "foreground": "#919498" }
        },
        {
            "name": "String Bracket",
            "scope": [
                "punctuation.definition.string.begin",
                "punctuation.definition.string.end"
            ],
            "settings": { "foreground": "#E9EA77" }
        },
        {
            "name": "Operator",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#4CD4A2" }
        },
        {
            "name": "Conditional",
            "scope": ["keyword.control.conditional"],
            "settings": { "foreground": "#F69765" }
        },
        {
            "name": "Return Statement",
            "scope": ["keyword.control.flow"],
            "settings": { "foreground": "#F69765" }
        },
        {
            "name": "Async",
            "scope": ["storage.modifier.async", "keyword.control.trycatch"],
            "settings": { "foreground": "#F69765" }
        },
        {
            "name": "Readwrite",
            "scope": ["variable.other.readwrite"],
            "settings": { "foreground": "#D2D3D3" }
        },
        {
            "name": "Object Name",
            "scope": "variable.other.object",
            "settings": { "foreground": "#919498" }
        },
        {
            "name": "Object Property",
            "scope": ["variable.other.property"],
            "settings": { "foreground": "#D2D3D3" }
        },
        {
            "name": "Object Literal",
            "scope": ["meta.object-literal"],
            "settings": { "foreground": "#919498" }
        },
        {
            "name": "Brackets",
            "scope": [
                "punctuation.definition.block",
                "punctuation.definition.parameters.begin",
                "punctuation.definition.parameters.end"
            ],
            "settings": { "foreground": "#919498" }
        },
        {
            "name": "Braces",
            "scope": ["meta.brace.round", "meta.brace.square"],
            "settings": { "foreground": "#64696F" }
        },
        {
            "name": "Object Destructuring",
            "scope": "punctuation.definition.binding-pattern.object",
            "settings": { "foreground": "#F69765" }
        },
        {
            "name": "Hook Bracket",
            "scope": ["punctuation.definition.binding-pattern.array"],
            "settings": { "foreground": "#4CD4A2" }
        },
        {
            "name": "Seperator Comma",
            "scope": [
                "punctuation.separator.comma",
                "punctuation.terminator.statement"
            ],
            "settings": { "foreground": "#919498" }
        },
        {
            "name": "Escape Backslash",
            "scope": "constant.character.escape.backslash",
            "settings": { "foreground": "#919498" }
        },
        {
            "name": "Tag Brackets",
            "scope": [
                "punctuation.definition.tag.begin",
                "punctuation.definition.tag.end"
            ],
            "settings": { "foreground": "#64696F" }
        },
        {
            "name": "Embed Brackets",
            "scope": [
                "punctuation.section.embedded.begin",
                "punctuation.section.embedded.end"
            ],
            "settings": { "foreground": "#64696F" }
        },
        {
            "name": "Component",
            "scope": "support.class.component",
            "settings": { "foreground": "#03C4A1" }
        },
        {
            "name": "HTML Tag",
            "scope": "entity.name.tag",
            "settings": { "foreground": "#027661" }
        },
        {
            "name": "HTML Attribute",
            "scope": "meta.tag.attributes",
            "settings": { "foreground": "#D2D3D3" }
        },
        {
            "name": "JSX Children",
            "scope": "meta.jsx.children",
            "settings": { "foreground": "#919498" }
        },
        {
            "name": "import",
            "scope": [
                "keyword.control.at-rule.import",
                "keyword.control.at-rule.include"
            ],
            "settings": { "foreground": "#027661" }
        },
        {
            "name": "Id",
            "scope": "entity.other.attribute-name.id",
            "settings": { "foreground": "#A24657" }
        },
        {
            "name": "Class",
            "scope": "entity.other.attribute-name.class",
            "settings": { "foreground": "#d2d3d3" }
        },
        {
            "name": "Pseudo Element",
            "scope": [
                "entity.other.attribute-name.pseudo-element",
                "entity.other.attribute-name.pseudo-class"
            ],
            "settings": { "foreground": "#919498" }
        },
        {
            "name": "Block Curly",
            "scope": "punctuation.section.property-list.begin.bracket.curly",
            "settings": { "foreground": "#919498" }
        },
        {
            "name": "Variable",
            "scope": "variable",
            "settings": { "foreground": "#03C4A1" }
        },
        {
            "name": "Property",
            "scope": "support.type.property-name",
            "settings": { "foreground": "#64696F" }
        },
        {
            "name": "Value",
            "scope": "support.constant.property-value",
            "settings": { "foreground": "#919498" }
        },
        {
            "name": "Function",
            "scope": "support.function.misc",
            "settings": { "foreground": "#03C4A1" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
