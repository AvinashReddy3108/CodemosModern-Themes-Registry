    "semanticHighlighting": false,
    "tokenColors": [
        {
            "scope": [
                "comment",
                "punctuation.definition.comment",
                "string.comment"
            ],
            "settings": { "foreground": "#a1a7b2" }
        },
        {
            "scope": ["constant.other.placeholder", "constant.character"],
            "settings": { "foreground": "#bf616a" }
        },
        {
            "scope": [
                "constant",
                "entity.name.constant",
                "variable.other.constant",
                "variable.other.enummember",
                "variable.language",
                "entity"
            ],
            "settings": { "foreground": "#5e81ac" }
        },
        {
            "scope": [
                "entity.name",
                "meta.export.default",
                "meta.definition.variable"
            ],
            "settings": { "foreground": "#96b5b4" }
        },
        {
            "scope": [
                "variable.parameter.function",
                "meta.jsx.children",
                "meta.block",
                "meta.tag.attributes",
                "entity.name.constant",
                "meta.object.member",
                "meta.embedded.expression"
            ],
            "settings": { "foreground": "#2b303b" }
        },
        {
            "scope": "entity.name.function",
            "settings": { "foreground": "#b48ead" }
        },
        {
            "scope": ["entity.name.tag", "support.class.component"],
            "settings": { "foreground": "#a3be8c" }
        },
        { "scope": "keyword", "settings": { "foreground": "#bf616a" } },
        {
            "scope": ["storage", "storage.type"],
            "settings": { "foreground": "#bf616a" }
        },
        {
            "scope": [
                "storage.modifier.package",
                "storage.modifier.import",
                "storage.type.java"
            ],
            "settings": { "foreground": "#2b303b" }
        },
        {
            "scope": ["string", "string punctuation.section.embedded source"],
            "settings": { "foreground": "#243447" }
        },
        { "scope": "support", "settings": { "foreground": "#5e81ac" } },
        {
            "scope": "meta.property-name",
            "settings": { "foreground": "#5e81ac" }
        },
        { "scope": "variable", "settings": { "foreground": "#96b5b4" } },
        { "scope": "variable.other", "settings": { "foreground": "#2b303b" } },
        {
            "scope": "invalid.broken",
            "settings": { "fontStyle": "italic", "foreground": "#7b3239" }
        },
        {
            "scope": "invalid.deprecated",
            "settings": { "fontStyle": "italic", "foreground": "#7b3239" }
        },
        {
            "scope": "invalid.illegal",
            "settings": { "fontStyle": "italic", "foreground": "#7b3239" }
        },
        {
            "scope": "invalid.unimplemented",
            "settings": { "fontStyle": "italic", "foreground": "#7b3239" }
        },
        {
            "scope": "carriage-return",
            "settings": {
                "fontStyle": "italic underline",
                "background": "#bf616a",
                "foreground": "#e4e7eb",
                "content": "^M"
            }
        },
        { "scope": "message.error", "settings": { "foreground": "#7b3239" } },
        { "scope": "string variable", "settings": { "foreground": "#5e81ac" } },
        {
            "scope": ["source.regexp", "string.regexp"],
            "settings": { "foreground": "#243447" }
        },
        {
            "scope": [
                "string.regexp.character-class",
                "string.regexp constant.character.escape",
                "string.regexp source.ruby.embedded",
                "string.regexp string.regexp.arbitrary-repitition"
            ],
            "settings": { "foreground": "#243447" }
        },
