            "settings": { "foreground": "#ffee59" }
        },
        {
            "name": "Number, Constant, Function Argument, Tag Attribute, Embedded",
            "scope": [
                "constant.numeric",
                "constant.language",
                "support.constant",
                "constant.character",
                "constant.escape",
                "variable.parameter",
                "keyword.other.unit",
                "keyword.other",
                "meta.item-access.arguments.python",
                ""
            ],
            "settings": { "foreground": "#ff95fa" }
        },
        {
            "name": "Class, Support",
            "scope": [
                "entity.name",
                "support.type",
                "support.class",
                "support.orther.namespace.use.php",
                "meta.use.php",
                "support.other.namespace.php",
                "markup.changed.git_gutter",
                "support.type.sys-types",
                "variable.object.property.ts"
            ],
            "settings": { "foreground": "#ff5faa" }
        },
        {
            "name": "Class, Support Special Case Python Function Call",
            "scope": "meta.function-call.generic.python",
            "settings": { "foreground": "#c300ff" }
        },
        {
            "name": "Entity Types",
            "scope": ["support.type"],
            "settings": { "foreground": "#eb5299" }
        },
        {
            "name": "Escape Characters",
            "scope": ["constant.character.escape"],
            "settings": { "foreground": "#f3cce9" }
        },
        {
            "name": "Language methods",
            "scope": ["variable.language"],
            "settings": { "fontStyle": "italic", "foreground": "#a12f68" }
        },
        {
            "name": "Single and Triple Quote String",
            "scope": ["string.quoted.single", "string.quoted.triple"],
            "settings": { "foreground": "#861e8a", "fontStyle": "bold" }
        },
        {
            "scope": [
                "support.variable",
                "constant.numeric",
                "support.constant"
            ],
            "settings": { "foreground": "#ffffff", "fontStyle": "bold" }
        },
        {
            "name": "Variable and parameter name",
            "scope": [
                "variable",
                "meta.definition.variable.name",
                "support.variable"
            ],
            "settings": { "foreground": "#fa5eb9" }
        },
        {
            "name": "Library Exception",
            "scope": "support.type.exception",
            "settings": { "foreground": "#ff0000" }
        },
        {
            "name": "Comments",
            "scope": [
                "comment.line.double-slash.cs",
                "comment.block.cs",
                "punctuation.definition.comment.json.comments",
                "comment.line.double-slash.js",
                "meta.structure.array.json.comments",
                "meta.structure.dictionary.value.json.comments",
                "meta.structure.dictionary.json.comments",
                "source.json.comments",
                "comment.block.css",
                "comment.block.html",
                "meta.property-list.css",
                "comment.line.number-sign.python",
                "punctuation.definition.comment.cs",
                "comment.block.documentation.cs",
                "punctuation.definition.comment.ts",
                "comment.line.double-slash.ts",
                "comment.line.scss",
                "comment.block.ts",
                "comment.block.scss",
                "comment.block.documentation.ts",
                "comment.line.double-slash.tsx",
                "comment.block.tsx"
            ],
            "settings": { "foreground": "#868b96" }
        }
