{
    "name": "Herrscher of Thunder",
    "tokenColors": [
        { "scope": "emphasis", "settings": { "fontStyle": "italic" } },
        { "scope": "strong", "settings": { "fontStyle": "bold" } },
        {
            "scope": "meta.diff.header",
            "settings": { "foreground": "#df0c0c" }
        },
        { "scope": "comment", "settings": { "foreground": "#868b96" } },
        { "scope": "constant.regexp", "settings": { "foreground": "#8e09a8" } },
        { "scope": "entity.name.tag", "settings": { "foreground": "#9649ee" } },
        {
            "scope": "entity.name.tag.css",
            "settings": { "foreground": "#dab2f1" }
        },
        {
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#ff7df9" }
        },
        {
            "scope": [
                "source.css entity.other.attribute-name",
                "source.css.less entity.other.attribute-name.id",
                "source.scss entity.other.attribute-name"
            ],
            "settings": { "foreground": "#e60baf" }
        },
        { "scope": "invalid", "settings": { "foreground": "#f50000" } },
        {
            "scope": "markup.underline",
            "settings": { "fontStyle": "underline" }
        },
        { "scope": "markup.bold", "settings": { "fontStyle": "bold" } },
        { "scope": "markup.heading", "settings": { "foreground": "#ffffff" } },
        { "scope": "markup.italic", "settings": { "fontStyle": "italic" } },
        { "scope": "markup.inserted", "settings": { "foreground": "#ffffff" } },
        { "scope": "markup.deleted", "settings": { "foreground": "#fd4040" } },
        { "scope": "markup.changed", "settings": { "foreground": "#d8db17" } },
        { "scope": "meta.selector", "settings": { "foreground": "#e92abf" } },
        {
            "name": "brackets of XML/HTML tags",
            "scope": ["punctuation.definition.tag"],
            "settings": { "foreground": "#e236f1" }
        },
        {
            "scope": "meta.preprocessor",
            "settings": { "foreground": "#ad0057" }
        },
        {
            "scope": "meta.preprocessor.string",
            "settings": { "foreground": "#d015ff" }
        },
        {
            "scope": "meta.preprocessor.numeric",
            "settings": { "foreground": "#7700d8" }
        },
        {
            "scope": "meta.structure.dictionary.key.python",
            "settings": { "foreground": "#cb19e2" }
        },
        { "scope": "storage", "settings": { "foreground": "#c21cd1" } },
        { "scope": "storage.type", "settings": { "foreground": "#ffffff" } },
        {
            "scope": "storage.modifier",
            "settings": { "foreground": "#e408e4e5" }
