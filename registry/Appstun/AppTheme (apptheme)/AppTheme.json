        "editor.selectionBackground": "#f1c40fb7",
        "editor.selectionHighlightBackground": "#fff4ad26",
        "editor.snippetFinalTabstopHighlightBorder": "#f1c40fcc",
        "editor.wordHighlightStrongBackground": "#726800b8",
        "editorBracketMatch.border": "#f1c40fcc",
        "editorCursor.foreground": "#f1c40f",
        "editorGroup.border": "#f1c40fcc",
        "editorGroup.dropBackground": "#ffd00022",
        "editorGroupHeader.noTabsBackground": "#090909",
        "editorGroupHeader.tabsBackground": "#111111",
        "editorGutter.background": "#090909",
        "editorHoverWidget.background": "#111111",
