{
    "$schema": "vscode://schemas/color-theme",
    "type": "dark",
    "colors": {
        "activityBar.foreground": "#d9dacc",
        "editor.background": "#272325",
        "editor.foreground": "#d9dacc",
        "editor.inactiveSelectionBackground": "#402725",
        "editor.lineHighlightBackground": "#34312f",
        "editor.selectionBackground": "#6d5a5580",
        "editorCursor.foreground": "#d9dacc",
        "editorIndentGuide.background": "#3a3a3b",
        "editorWhitespace.foreground": "#3a3a3b",
        "editor.wordHighlightBackground": "#6d5a5526",
        "editor.wordHighlightStrongBackground": "#75707026",
        "editorLineNumber.activeForeground": "#e9eadc",
        "textLink.foreground": "#61afef",
        "terminal.ansiBlack": "#2d3139",
        "terminal.ansiBlue": "#61afef",
        "terminal.ansiBrightBlack": "#7f848e",
        "terminal.ansiBrightBlue": "#528bff",
        "terminal.ansiBrightCyan": "#56b6c2",
        "terminal.ansiBrightGreen": "#98c379",
        "terminal.ansiBrightMagenta": "#7e0097",
        "terminal.ansiBrightRed": "#f44747",
        "terminal.ansiBrightWhite": "#d9dacc",
        "terminal.ansiBrightYellow": "#e5c07b",
        "terminal.ansiCyan": "#56b6c2",
        "terminal.ansiGreen": "#98c379",
        "terminal.ansiMagenta": "#c678dd",
        "terminal.ansiRed": "#e06c75",
        "terminal.ansiWhite": "#d9dacc",
        "terminal.ansiYellow": "#e5c07b",
        "terminal.foreground": "#c8c8c8"
    },
    "tokenColors": [
        {
            "name": "Normal",
            "scope": "entity.name.function.preprocessor, meta.preprocessor.macro, storage.modifier.import, storage.type.generic, variable.other",
            "settings": { "foreground": "#d9dacc" }
        },
        {
            "name": "Comment",
            "scope": "comment",
            "settings": { "foreground": "#696d70" }
        },
        {
            "name": "String",
            "scope": "string",
            "settings": { "foreground": "#e6db74cc" }
        },
        {
            "name": "Regexp",
            "scope": "string.regexp",
            "settings": { "foreground": "#ffa632dd" }
        },
        {
            "name": "Language constant",
            "scope": "constant.language, constant.numeric",
            "settings": { "foreground": "#ae81ff" }
        },
        {
            "name": "Escape/constant",
            "scope": "constant.character, constant.other.placeholder, support.other.escape.special.regexp",
            "settings": { "foreground": "#e62a19dd" }
        },
        {
            "name": "Other constant",
            "scope": "constant.other",
            "settings": { "foreground": "#fd971fdd" }
        },
        {
            "name": "Keyword",
            "scope": "entity.name.variable.property, keyword, meta.preprocessor",
            "settings": { "foreground": "#f92672dd" }
        },
        {
            "name": "Keyword",
            "scope": "constant.other.symbol.prolog, support.function.be.latex, support.function.general.tex, support.function.section.latex, punctuation.dollar.js, punctuation.separator.parameters.python, support.function.definition.latex, constant.language.module.events, constant.language.module.http, constant.language.directive.module.main, constant.language.directive.module.events, constant.language.directive.module.http",
            "settings": { "foreground": "#f92672dd", "fontStyle": "italic" }
        },
        {
            "scope": "keyword - keyword.operator",
            "settings": { "foreground": "#f92672dd" }
        },
        {
            "name": "Data modifier",
            "scope": "storage, support.constant, punctuation.section.class",
            "settings": { "foreground": "#42bebedd" }
        },
        {
            "name": "Data modifier",
            "scope": "entity.name.type.go, entity.name.type.namespace.php, meta.import.scala, punctuation.separator.inheritance.php, storage.type.js, support.other.module.haskell, support.other.namespace.use.php, variable.other.constant.ruby, entity.name.section.puppet, entity.name.function.decorator.python",
            "settings": { "foreground": "#42bebedd" }
        },
        {
            "name": "Data type",
            "scope": "keyword.type, storage.type, support.class, support.type",
            "settings": { "foreground": "#329e9e" }
        },
        {
            "name": "Member variables/functions",
            "scope": "variable.language, variable.other.member, variable.parameter, variable.other.readwrite.member",
            "settings": { "foreground": "#fd971f" }
        },
        {
            "name": "Member variables/functions",
            "scope": "meta.function-call.object.php, meta.function-call.static.php, variable.other.makefile, variable.other.prolog, variable.other.property.js, support.variable.property.dom.js",
            "settings": { "foreground": "#fd971f" }
        },
        {
            "name": "Functions",
            "scope": "meta.function-call.php,support.function, support.function.builtin.rust, support.function.C99, support.function.core.ruby, support.function.go, support.function.js, support.function.log.rust, support.function.magic.php, support.function.std.rust, support.function.builtin.python, support.function.builtin.go, support.function.builtin.shell, meta.function-call.js",
            "settings": { "foreground": "#4dc6c8ee" }
        },
        {
            "name": "Functions",
            "scope": "variable.function, meta.function-call.generic, meta.function-call.method, support.function.any-method, support.function.misc",
            "settings": { "foreground": "#fd971f", "fontStyle": "bold" }
        },
        {
            "name": "Functions",
            "scope": "entity.name.function",
            "settings": { "foreground": "#4dc6c8ee", "fontStyle": "bold" }
        },
        {
            "name": "Punctuation",
            "scope": "punctuation.accessor, punctuation.section.embedded, punctuation.separator, storage.type.function.arrow",
            "settings": { "foreground": "#f92672dd" }
        },
        {
            "name": "Punctuation in parameters",
            "scope": "punctuation.separator.parameters",
            "settings": { "foreground": "#fd971f" }
        },
        {
            "name": "Tags",
            "scope": "entity.name.tag, entity.other.attribute-name",
            "settings": { "foreground": "#f92672dd" }
        },
        {
            "name": "Markup header",
            "scope": "markup.heading",
            "settings": { "fontStyle": "bold", "foreground": "#f92672dd" }
        },
        {
            "name": "Markup bold",
            "scope": "markup.bold",
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Markup italic",
            "scope": "markup.italic",
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "Markup underline",
            "scope": "markup.underline",
            "settings": { "fontStyle": "underline" }
        },
        {
            "name": "Markup quote",
            "scope": "markup.quote",
            "settings": { "foreground": "#696d70" }
        },
        {
            "name": "Markup inline",
            "scope": "markup.inline, markup.raw.inline",
            "settings": { "foreground": "#ae81ff" }
        },
        {
            "name": "Normal",
            "scope": "keyword.operator.dereference.java, meta.preprocessor.haskell, punctuation.separator.java, variable.parameter.java, variable.parameter.js, meta.group.js, meta.group.go, punctuation.section.class.begin.python, support.variable.dom.js, constant.character.brace, constant.character.end, constant.character.paren, constant.character.quote",
            "settings": { "foreground": "#cccccc" }
        },
        {
            "name": "Data type",
            "scope": "keyword.control.def.ruby, keyword.declaration.scala, keyword.declaration.stable.scala, keyword.declaration.volatile.scala, keyword.other.fn.rust, keyword.other.rust, meta.structure.dictionary.key.json",
            "settings": { "foreground": "#2be98a" }
        },
        {
            "name": "Markdown link",
            "scope": "string.other.link.title.markdown, string.other.link.description.markdown",
            "settings": { "foreground": "#49e0fd" }
        },
        {
            "name": "Markdown fade",
            "scope": "beginning.punctuation.definition.list.markdown, punctuation.definition.list_item.markdown, punctuation.definition.list.markdown, punctuation.definition.heading.markdown, punctuation.definition.bold.markdown, punctuation.definition.italic.markdown, punctuation.definition.string.begin.markdown, punctuation.definition.string.end.markdown, punctuation.definition.bold.begin.markdown, punctuation.definition.bold.end.markdown, punctuation.definition.italic.begin.markdown, punctuation.definition.italic.end.markdown, punctuation.definition.heading.begin.markdown, punctuation.definition.heading.end.markdown, punctuation.definition.raw.begin.markdown, punctuation.definition.raw.end.markdown, punctuation.definition.metadata.markdown, punctuation.definition.raw.markdown, markup.underline.link.image.markdown, markup.underline.link.markdown",
            "settings": { "fontStyle": "normal", "foreground": "#696d70" }
        },
        {
            "name": "GitGutter deleted",
            "scope": "markup.deleted.git_gutter",
            "settings": { "foreground": "#f92672dd" }
        },
        {
            "name": "GitGutter inserted",
            "scope": "markup.inserted.git_gutter",
            "settings": { "foreground": "#2be98a" }
        },
        {
            "name": "GitGutter changed",
            "scope": "markup.changed.git_gutter",
            "settings": { "foreground": "#ae81ff" }
        },
        {
            "name": "GitGutter ignored",
            "scope": "markup.ignored.git_gutter",
            "settings": { "foreground": "#696d70" }
        },
        {
            "name": "GitGutter untracked",
            "scope": "markup.untracked.git_gutter",
            "settings": { "foreground": "#696d70" }
        },
        {
            "scope": "token.info-token",
            "settings": { "foreground": "#6796e6" }
        },
        {
            "scope": "token.warn-token",
            "settings": { "foreground": "#cd9731" }
        },
        {
            "scope": "token.error-token",
            "settings": { "foreground": "#f44747" }
        },
        {
            "scope": "token.debug-token",
            "settings": { "foreground": "#b267e6" }
        },
        { "scope": "keyword.control", "settings": { "foreground": "#329e9e" } },
        { "scope": "storage", "settings": { "foreground": "#329e9e" } },
        { "scope": "storage.type", "settings": { "foreground": "#329e9e" } },
        {
            "scope": "constant.numeric",
            "settings": { "foreground": "#ae81ff" }
        },
        {
            "scope": "entity.name.type",
            "settings": { "foreground": "#329e9e" }
        },
        {
            "scope": "entity.name.class",
            "settings": { "foreground": "#329e9e" }
        },
        { "scope": "support.type", "settings": { "foreground": "#329e9e" } },
        { "scope": "support.class", "settings": { "foreground": "#329e9e" } },
        {
            "scope": "keyword.control",
            "settings": { "foreground": "#f92672dd", "fontStyle": "italic" }
        },
        { "scope": "storage", "settings": { "foreground": "#f92672dd" } },
        { "scope": "storage.type", "settings": { "foreground": "#f92672dd" } },
        {
            "scope": "constant.numeric",
            "settings": { "foreground": "#ae81ff" }
        },
        {
            "scope": "entity.name.type",
            "settings": { "foreground": "#329e9e" }
        },
        {
            "scope": "entity.name.class",
            "settings": { "foreground": "#329e9e" }
        },
        { "scope": "support.type", "settings": { "foreground": "#329e9e" } },
        { "scope": "support.class", "settings": { "foreground": "#329e9e" } }
    ]
}
