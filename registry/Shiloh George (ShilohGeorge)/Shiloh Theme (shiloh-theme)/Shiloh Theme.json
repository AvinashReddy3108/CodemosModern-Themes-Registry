        "tab.inactiveForeground": "#14FF19af",
        "tab.unfocusedActiveBorder": "#56FF14",
        "tab.unfocusedActiveBackground": "#56FF1440",
        "tab.unfocusedActiveForeground": "#14FF19",
        "tab.unfocusedInactiveBackground": "#56FF1410",
        "tab.unfocusedInactiveForeground": "#14FF197f",
        "terminal.ansiBlack": "#7D7D7D",
        "terminal.ansiBlue": "#2FFF15",
        "terminal.ansiBrightBlack": "#56FF14",
        "terminal.ansiBrightBlue": "#2FFF15",
        "terminal.ansiBrightCyan": "#67FF03",
        "terminal.ansiBrightGreen": "#9F08E9",
        "terminal.ansiBrightMagenta": "#C513FF",
        "terminal.ansiBrightRed": "#CB0DFF",
        "terminal.ansiBrightWhite": "#12FF12",
        "terminal.ansiBrightYellow": "#C513FF",
        "terminal.ansiCyan": "#67FF03",
        "terminal.ansiGreen": "#9F08E9",
        "terminal.ansiMagenta": "#C513FF",
        "terminal.ansiRed": "#CB0DFF",
        "terminal.ansiWhite": "#12FF12",
        "terminal.ansiYellow": "#C513FF",
