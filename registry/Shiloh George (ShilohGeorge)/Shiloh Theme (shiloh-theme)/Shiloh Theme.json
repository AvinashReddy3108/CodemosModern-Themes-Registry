        "titleBar.border": "#7D7D7D60",
        "titleBar.inactiveBackground": "#7D7D7D",
        "titleBar.inactiveForeground": "#56FF14",
        "tree.indentGuidesStroke": "#1AF216",
        "widget.shadow": "#7D7D7D30"
