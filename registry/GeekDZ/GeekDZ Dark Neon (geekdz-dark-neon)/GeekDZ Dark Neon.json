    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "fontStyle": "italic", "foreground": "#5f6a8a" }
        },
        {
            "name": "Variables",
            "scope": [
                "variable",
                "variable.other",
                "variable.parameter",
                "variable.language",
                "string constant.other.placeholder"
            ],
            "settings": { "foreground": "#ffffff" }
        },
        {
            "name": "Constants",
            "scope": [
                "constant",
                "constant.other.color",
                "constant.other.symbol",
                "constant.other.key",
                "support.constant"
            ],
            "settings": { "foreground": "#00ffff" }
        },
        {
            "name": "Numbers",
            "scope": ["constant.numeric", "constant.language.numeric"],
            "settings": { "foreground": "#ff8c00" }
        },
        {
            "name": "Boolean",
            "scope": ["constant.language.boolean"],
            "settings": { "foreground": "#ff8c00" }
        },
        {
            "name": "Null",
            "scope": ["constant.language.null", "constant.language.undefined"],
            "settings": { "foreground": "#ff8c00" }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "storage.type",
                "storage.modifier",
                "keyword.control",
                "keyword.operator.new",
                "keyword.operator.delete",
                "keyword.other.using",
                "keyword.other.typedef"
            ],
            "settings": { "fontStyle": "bold", "foreground": "#00bfff" }
        },
        {
            "name": "Operators",
            "scope": [
                "keyword.operator",
                "keyword.operator.assignment",
                "keyword.operator.arithmetic",
                "keyword.operator.comparison",
                "keyword.operator.logical"
            ],
            "settings": { "foreground": "#00bfff" }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "meta.function-call",
                "variable.function",
                "support.function",
                "keyword.other.special-method",
                "entity.name.method"
            ],
            "settings": { "foreground": "#bf00ff" }
        },
        {
            "name": "Function Parameters",
            "scope": ["variable.parameter", "meta.parameters variable.other"],
            "settings": { "foreground": "#ffffff", "fontStyle": "italic" }
        },
        {
            "name": "Classes",
            "scope": [
                "entity.name.class",
                "entity.other.inherited-class",
                "support.class",
                "entity.name.type"
            ],
            "settings": { "foreground": "#a020f0" }
        },
        {
            "name": "Interfaces",
            "scope": ["entity.name.interface"],
            "settings": { "foreground": "#a020f0", "fontStyle": "italic" }
        },
        {
            "name": "Types",
            "scope": [
                "support.type",
                "entity.name.type",
                "storage.type.primitive"
            ],
            "settings": { "foreground": "#a020f0" }
        },
        {
            "name": "Strings",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#39ff14" }
        },
        {
            "name": "Template Literals",
            "scope": [
                "string.template",
                "punctuation.definition.string.template"
            ],
            "settings": { "foreground": "#39ff14" }
        },
        {
            "name": "Template Expression",
            "scope": [
                "meta.template.expression",
                "punctuation.definition.template-expression"
            ],
            "settings": { "foreground": "#00bfff" }
        },
        {
            "name": "Regular Expressions",
            "scope": ["string.regexp"],
            "settings": { "foreground": "#00ffff" }
        },
        {
            "name": "Escape Characters",
            "scope": ["constant.character.escape"],
            "settings": { "foreground": "#00ffff" }
        },
        {
            "name": "Tags",
            "scope": [
                "entity.name.tag",
                "meta.tag.sgml",
                "markup.deleted.git_gutter"
            ],
            "settings": { "foreground": "#00bfff" }
        },
        {
            "name": "Tag Attributes",
            "scope": [
                "entity.other.attribute-name",
                "text.html.basic entity.other.attribute-name.html",
                "text.html.basic entity.other.attribute-name"
            ],
            "settings": { "foreground": "#a020f0", "fontStyle": "italic" }
        },
        {
            "name": "Tag Punctuation",
            "scope": [
                "punctuation.definition.tag",
                "punctuation.definition.tag.html",
                "punctuation.definition.tag.begin.html",
                "punctuation.definition.tag.end.html"
            ],
            "settings": { "foreground": "#00bfff" }
        },
        {
            "name": "CSS Selectors",
            "scope": [
                "entity.name.tag.css",
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css"
            ],
            "settings": { "foreground": "#00bfff" }
        },
        {
            "name": "CSS Properties",
            "scope": [
                "support.type.property-name.css",
                "support.type.property-name.scss",
                "support.type.property-name.sass",
                "support.type.property-name.less"
            ],
            "settings": { "foreground": "#00ffff" }
        },
        {
            "name": "CSS Values",
            "scope": [
                "support.constant.property-value.css",
                "support.constant.color.css"
            ],
            "settings": { "foreground": "#39ff14" }
        },
        {
            "name": "CSS Units",
            "scope": ["keyword.other.unit.css"],
            "settings": { "foreground": "#ff8c00" }
        },
        {
            "name": "JSON Keys",
            "scope": [
                "support.type.property-name.json",
                "meta.structure.dictionary.json support.type.property-name.json"
            ],
            "settings": { "foreground": "#00ffff" }
        },
        {
            "name": "JSON Values",
            "scope": [
                "meta.structure.dictionary.value.json string.quoted.double.json"
            ],
            "settings": { "foreground": "#39ff14" }
        },
        {
            "name": "Markdown Headings",
            "scope": [
                "markup.heading",
                "markup.heading entity.name",
                "markup.heading.markdown punctuation.definition.heading.markdown"
            ],
            "settings": { "foreground": "#00bfff", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Bold",
            "scope": ["markup.bold", "markup.bold string"],
            "settings": { "fontStyle": "bold", "foreground": "#ffffff" }
        },
        {
            "name": "Markdown Italic",
            "scope": ["markup.italic"],
            "settings": { "fontStyle": "italic", "foreground": "#ffffff" }
        },
        {
            "name": "Markdown Code",
            "scope": [
                "markup.inline.raw.markdown",
                "markup.raw.block.markdown"
            ],
            "settings": { "foreground": "#39ff14" }
        },
        {
            "name": "Markdown Links",
            "scope": [
                "string.other.link.title.markdown",
                "markup.underline.link.markdown"
            ],
            "settings": { "foreground": "#00bfff" }
        },
        {
            "name": "Markdown Link Text",
            "scope": ["string.other.link.description.title.markdown"],
            "settings": { "foreground": "#00ffff" }
        },
        {
            "name": "Markdown Quotes",
            "scope": ["markup.quote"],
            "settings": { "fontStyle": "italic", "foreground": "#5f6a8a" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation",
                "punctuation.separator",
                "punctuation.terminator",
                "punctuation.accessor"
            ],
            "settings": { "foreground": "#00bfff" }
        },
        {
            "name": "Brackets",
            "scope": [
                "punctuation.section.brackets",
                "punctuation.section.parens",
                "punctuation.section.braces"
            ],
            "settings": { "foreground": "#00bfff" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#ff1744", "fontStyle": "underline" }
        },
        {
            "name": "Deprecated",
            "scope": ["invalid.deprecated"],
            "settings": {
                "foreground": "#ffa500",
                "fontStyle": "strikethrough"
            }
        },
        {
            "name": "Diff Inserted",
            "scope": ["markup.inserted", "markup.inserted.git_gutter"],
            "settings": { "foreground": "#39ff14" }
        },
        {
            "name": "Diff Deleted",
            "scope": ["markup.deleted", "markup.deleted.git_gutter"],
            "settings": { "foreground": "#ff1744" }
        },
        {
            "name": "Diff Changed",
            "scope": ["markup.changed", "markup.changed.git_gutter"],
            "settings": { "foreground": "#ffa500" }
        },
        {
            "name": "Python Decorators",
            "scope": [
                "meta.function.decorator.python",
                "entity.name.function.decorator.python"
            ],
            "settings": { "foreground": "#a020f0", "fontStyle": "italic" }
        },
        {
            "name": "Python Self",
            "scope": [
                "variable.parameter.function.language.special.self.python"
            ],
            "settings": { "foreground": "#00bfff", "fontStyle": "italic" }
        },
        {
            "name": "JavaScript This",
            "scope": ["variable.language.this.js", "variable.language.this.ts"],
            "settings": { "foreground": "#00bfff", "fontStyle": "italic" }
        },
        {
            "name": "Imports",
            "scope": [
                "meta.import",
                "keyword.control.import",
                "keyword.control.from",
                "keyword.control.export"
            ],
            "settings": { "foreground": "#a020f0" }
        },
        {
            "name": "Module Names",
            "scope": ["entity.name.import", "entity.name.namespace"],
            "settings": { "foreground": "#00ffff" }
        },
        {
            "name": "Annotations",
            "scope": ["meta.annotation", "punctuation.definition.annotation"],
            "settings": { "foreground": "#a020f0" }
        },
        {
            "name": "Labels",
            "scope": ["entity.name.label"],
            "settings": { "foreground": "#ffa500" }
        },
        {
            "name": "URL",
            "scope": ["*url*", "*link*", "*uri*"],
            "settings": { "fontStyle": "underline", "foreground": "#00bfff" }
        },
        {
            "name": "YAML Keys",
            "scope": ["entity.name.tag.yaml"],
            "settings": { "foreground": "#00ffff" }
        },
        {
            "name": "YAML Values",
            "scope": ["string.unquoted.plain.out.yaml"],
            "settings": { "foreground": "#39ff14" }
        },
        {
            "name": "YAML Anchors",
            "scope": [
                "punctuation.definition.anchor.yaml",
                "variable.other.alias.yaml"
            ],
            "settings": { "foreground": "#a020f0" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
