    "tokenColors": [
        {
            "scope": [
                "bold",
                "markup.bold",
                "markup.heading",
                "markup.strong",
                "strong"
            ],
            "settings": { "fontStyle": "bold" }
        },
        {
            "scope": [
                "emphasis",
                "italic",
                "keyword.control",
                "markup.italic.markdown"
            ],
            "settings": { "fontStyle": "italic" }
        },
        {
            "scope": ["markup.underline"],
            "settings": { "fontStyle": "underline" }
        },
        {
            "scope": ["markup.strikethrough"],
            "settings": { "fontStyle": "strikethrough" }
        },
        {
            "scope": ["comment"],
            "settings": { "foreground": "#787b72", "fontStyle": "italic" }
        },
        {
            "scope": [
                "entity.name.filename.find-in-files",
                "markup.changed",
                "markup.list",
                "markup.underline.link.image.markdown",
                "markup.underline.link.markdown",
                "string"
            ],
            "settings": { "foreground": "#e6db74" }
        },
        {
            "scope": [
                "punctuation.definition.template-expression",
                "punctuation.section.embedded"
            ],
            "settings": { "foreground": "#f92672" }
        },
        {
            "scope": [
                "markup.list.numbered.markdown",
                "markup.list.unnumbered.markdown",
                "meta.template.expression"
            ],
            "settings": { "foreground": "#f5f4f1" }
        },
        {
            "scope": ["variable"],
            "settings": { "foreground": "#f5f4f1", "fontStyle": "" }
        },
        {
            "scope": [
                "constant.character",
                "constant.language",
                "constant.numeric",
                "constant.other",
                "string.other.link.description.markdown",
                "string.other.link.title.markdown"
            ],
            "settings": { "foreground": "#ae81ff" }
        },
        {
            "scope": ["entity.name.tag", "storage"],
            "settings": { "foreground": "#f92672", "fontStyle": "" }
        },
        {
            "scope": ["keyword", "markup.deleted", "markup.quote"],
            "settings": { "foreground": "#f92672" }
        },
        {
            "scope": ["storage.type", "variable.language"],
            "settings": { "foreground": "#66d9ef", "fontStyle": "italic" }
        },
        {
            "scope": [
                "support.class",
                "support.constant",
                "support.function",
                "support.type"
            ],
            "settings": { "foreground": "#66d9ef", "fontStyle": "" }
        },
        {
            "scope": ["markup.bold", "markup.italic"],
            "settings": { "foreground": "#66d9ef" }
        },
        {
            "scope": ["storage.modifier"],
            "settings": { "fontStyle": "italic" }
        },
        {
            "scope": [
                "entity.name.class",
                "entity.name.function",
                "entity.name.namespace",
                "entity.name.scope-resolution",
                "entity.name.type",
                "markup.heading.setext"
            ],
            "settings": { "foreground": "#a6e22e", "fontStyle": "" }
        },
        {
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#a6e22e", "fontStyle": "italic" }
        },
        {
            "scope": [
                "entity.other.inherited-class",
                "markup.heading",
                "markup.inserted",
                "punctuation.definition.list.begin.markdown"
            ],
            "settings": { "foreground": "#a6e22e" }
        },
        {
            "scope": ["markup.inline.raw", "variable.parameter"],
            "settings": { "foreground": "#fd971f", "fontStyle": "" }
        },
        {
            "scope": ["support.other.variable"],
            "settings": { "fontStyle": "" }
        },
        {
            "scope": [
                "meta.structure.dictionary.json",
                "string.quoted.double.json"
            ],
            "settings": { "foreground": "#c2c2bf" }
        },
        { "scope": ["meta.diff"], "settings": { "foreground": "#969791" } },
        {
            "scope": ["markup.quote.markdown"],
            "settings": { "foreground": "#969791", "fontStyle": "italic" }
        },
        {
            "scope": ["token.info-token"],
            "settings": { "foreground": "#7297ea" }
        },
        {
            "scope": ["token.warn-token"],
            "settings": { "foreground": "#fd971f" }
        },
        {
            "scope": ["invalid", "token.error-token"],
            "settings": { "foreground": "#f44747" }
        },
        {
            "scope": ["token.debug-token"],
            "settings": { "foreground": "#ae81ff" }
        }
    ]
}
