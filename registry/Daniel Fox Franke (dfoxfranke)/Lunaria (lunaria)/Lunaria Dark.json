    "tokenColors": [
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#78828A" }
        },
        { "scope": "string", "settings": { "foreground": "#82A284" } },
        { "scope": "string.regexp", "settings": { "foreground": "#BE8A7E" } },
        {
            "scope": [
                "entity.name.class",
                "entity.name.struct",
                "entity.name.enum",
                "entity.name.union",
                "entity.name.trait",
                "entity.name.interface",
                "entity.name.impl",
                "entity.name.type -variable.other.enumMember",
                "entity.other.inherited-class",
                "support.type",
                "storage.type -storage.type.js"
            ],
            "settings": { "foreground": "#9693C2" }
        },
        {
            "scope": [
                "entity.name.namespace",
                "entity.other.attribute-name.namespace"
            ],
            "settings": { "foreground": "#A89769" }
        },
        {
            "scope": [
                "keyword",
                "storage.modifier",
                "constant.language",
                "storage.type.js",
                "storage.type.function.js"
            ],
            "settings": { "fontStyle": "bold" }
        },
        {
            "scope": [
                "variable.other -variable.other.property -entity.name",
                "variable.language",
                "variable.parameter"
            ],
            "settings": { "fontStyle": "italic" }
        },
        {
            "scope": "invalid",
            "settings": {
                "foreground": "#FF9A7B",
                "fontStyle": "bold underline"
            }
        },
        {
            "scope": "invalid.deprecated",
            "settings": {
                "foreground": "#F1CA59",
                "fontStyle": "bold underline"
            }
        },
        {
            "scope": ["meta.embedded", "source.groovy.embedded"],
            "settings": { "foreground": "#CACED8" }
        },
        { "scope": "emphasis", "settings": { "fontStyle": "italic" } },
        { "scope": "strong", "settings": { "fontStyle": "bold" } },
        {
            "scope": "meta.diff.header",
            "settings": { "foreground": "#4189B6" }
        },
        {
            "scope": "markup.underline",
            "settings": { "fontStyle": "underline" }
        },
        {
            "scope": "markup.underline.link",
            "settings": { "foreground": "#9F94EC" }
        },
        { "scope": "markup.bold", "settings": { "fontStyle": "bold" } },
        {
            "scope": "markup.heading",
            "settings": { "fontStyle": "bold underline" }
        },
        { "scope": "markup.italic", "settings": { "fontStyle": "italic" } },
        { "scope": "markup.inserted", "settings": { "foreground": "#419278" } },
        { "scope": "markup.deleted", "settings": { "foreground": "#B3686D" } },
        { "scope": "markup.changed", "settings": { "foreground": "#4189B6" } },
        { "scope": "markup.quote", "settings": { "fontStyle": "italic" } },
        { "scope": "markup.raw", "settings": { "foreground": "#82A284" } },
        {
            "scope": "entity.name.section",
            "settings": { "foreground": "#DFE2ED", "fontStyle": "bold" }
        },
        { "scope": "entity.name.tag", "settings": { "foreground": "#9693C2" } },
        {
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#B38AAA" }
        },
        {
            "scope": "punctuation.separator.namespace",
            "settings": { "foreground": "#CACED8" }
        },
        {
            "scope": ["meta.preprocessor", "entity.name.function.preprocessor"],
            "settings": { "foreground": "#799DC0" }
        },
        {
            "scope": "meta.preprocessor.string",
            "settings": { "foreground": "#82A284" }
        },
        {
            "scope": "token.info-token",
            "settings": { "foreground": "#8ACC86" }
        },
        {
            "scope": "token.warn-token",
            "settings": { "foreground": "#F1CA59" }
        },
        {
            "scope": "token.error-token",
            "settings": { "foreground": "#FF9A7B" }
        },
        {
            "scope": "token.debug-token",
            "settings": { "foreground": "#DF8CC7" }
        },
        {
            "scope": "string support.type.property-name",
            "settings": { "foreground": "#9693C2" }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "*.mutable:rust": { "fontStyle": "" },
        "variable.mutable:rust": { "fontStyle": "italic" },
        "parameter.mutable:rust": { "fontStyle": "italic" },
        "variable.static:rust": { "fontStyle": "" },
        "selfKeyword:rust": { "fontStyle": "bold italic" },
        "*.unsafe:rust": { "foreground": "#BE8A7E" }
    }
}
