{
    "name": "Rust Dark Professional",
    "type": "dark",
    "colors": {
        "activityBar.background": "#1E1A19",
        "activityBar.foreground": "#FFFFFF",
        "activityBarBadge.background": "#B7410E",
        "activityBarBadge.foreground": "#FFFFFF",
        "titleBar.activeBackground": "#1A1614",
        "titleBar.activeForeground": "#FFFFFF",
        "titleBar.inactiveBackground": "#1A161499",
        "titleBar.inactiveForeground": "#FFFFFF99",
        "statusBar.background": "#B7410E",
        "statusBar.foreground": "#FFFFFF",
        "statusBarItem.hoverBackground": "#8B3005",
        "statusBarItem.remoteBackground": "#1E1A19",
        "sideBar.background": "#211C1A",
        "sideBar.foreground": "#FFFFFF",
        "sideBarSectionHeader.background": "#1E1A19",
        "sideBarTitle.foreground": "#FFFFFF",
        "editor.background": "#191512",
        "editor.foreground": "#F0E0D0",
        "editor.lineHighlightBackground": "#2A211A",
        "editorCursor.foreground": "#F74C00",
        "editorWhitespace.foreground": "#2A211A",
        "editor.selectionBackground": "#B7410E40",
        "editor.inactiveSelectionBackground": "#8B300530",
        "editorGroupHeader.tabsBackground": "#1E1A19",
        "tab.activeBackground": "#191512",
        "tab.activeForeground": "#FFFFFF",
        "tab.inactiveBackground": "#1E1A19",
        "tab.inactiveForeground": "#FFFFFF80",
        "tab.border": "#1E1A19",
        "panel.background": "#191512",
        "panelTitle.activeForeground": "#FFFFFF",
        "panelTitle.inactiveForeground": "#FFFFFF80",
        "input.background": "#1E1A19",
        "input.foreground": "#FFFFFF",
        "input.border": "#32231A",
        "inputOption.activeBorder": "#F74C00",
        "dropdown.background": "#1E1A19",
        "dropdown.foreground": "#FFFFFF",
        "dropdown.border": "#32231A",
        "button.background": "#B7410E",
        "button.foreground": "#FFFFFF",
        "button.hoverBackground": "#8B3005",
        "terminal.background": "#191512",
        "terminal.foreground": "#F0E0D0",
        "terminal.ansiRed": "#E54D42",
        "terminal.ansiBlue": "#64A1ED",
        "terminal.ansiGreen": "#107C10",
        "terminal.ansiYellow": "#DEA909",
        "terminal.ansiCyan": "#56C0E0",
        "terminal.ansiMagenta": "#BC78D7",
        "terminal.ansiBrightRed": "#FF6C60",
        "terminal.ansiBrightGreen": "#48D848",
        "terminal.ansiBrightYellow": "#F0A240",
        "terminal.ansiBrightBlue": "#61AFEF",
        "terminal.ansiBrightMagenta": "#D7A5F9",
        "terminal.ansiBrightCyan": "#9CDCFE",
        "terminal.ansiBrightWhite": "#FBF1E4",
        "scrollbarSlider.background": "#2A211A70",
        "scrollbarSlider.hoverBackground": "#B7410E40",
        "scrollbarSlider.activeBackground": "#8B300560",
        "minimap.background": "#19151280",
        "minimapSlider.background": "#2A211A40",
        "minimapSlider.hoverBackground": "#2A211A60",
        "minimapSlider.activeBackground": "#B7410E60"
    },
    "tokenColors": [
        {
            "name": "Rust Keywords",
            "scope": [
                "keyword.control.rust",
                "storage.type.rust",
                "keyword.operator.logical.rust",
                "storage.modifier.lifetime.rust",
                "keyword.other.rust"
            ],
            "settings": { "foreground": "#F74C00", "fontStyle": "bold" }
        },
        {
            "name": "Rust Functions",
            "scope": ["entity.name.function.rust", "support.function.rust"],
            "settings": { "foreground": "#DDBF8E", "fontStyle": "italic" }
        },
        {
            "name": "Rust Macros",
            "scope": ["entity.name.function.macro.rust", "meta.macro.rust"],
            "settings": { "foreground": "#F0A240", "fontStyle": "bold" }
        },
        {
            "name": "Rust Lifetimes",
            "scope": [
                "entity.name.lifetime.rust",
                "punctuation.definition.lifetime.rust"
            ],
            "settings": { "foreground": "#E5AA8B", "fontStyle": "italic" }
        },
        {
            "name": "Rust Traits and Structs",
            "scope": [
                "entity.name.type.rust",
                "storage.type.struct.rust",
                "storage.type.trait.rust",
                "entity.name.type.struct.rust",
                "entity.name.type.trait.rust"
            ],
            "settings": { "foreground": "#C28F5C", "fontStyle": "bold" }
        },
        {
            "name": "Rust Self Parameter",
            "scope": ["variable.language.self.rust"],
            "settings": { "foreground": "#D16969", "fontStyle": "italic" }
        },
        {
            "name": "Rust Strings",
            "scope": ["string.quoted.single.rust", "string.quoted.double.rust"],
            "settings": { "foreground": "#A9BD6E" }
        },
        {
            "name": "Rust Raw Strings",
            "scope": ["string.quoted.raw.rust"],
            "settings": { "foreground": "#CE9178" }
        },
        {
            "name": "Rust Numbers",
            "scope": [
                "constant.numeric.decimal.rust",
                "constant.numeric.float.rust",
                "constant.numeric.bin.rust",
                "constant.numeric.hex.rust",
                "constant.numeric.oct.rust"
            ],
            "settings": { "foreground": "#B5CEA8" }
        },
        {
            "name": "Rust Comments",
            "scope": ["comment.line.double-slash.rust", "comment.block.rust"],
            "settings": { "foreground": "#7D7367", "fontStyle": "italic" }
        },
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "fontStyle": "italic", "foreground": "#7D7367" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "string constant.other.placeholder"],
            "settings": { "foreground": "#EEFFFF" }
        },
        {
            "name": "Colors",
            "scope": ["constant.other.color"],
            "settings": { "foreground": "#ffffff" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#FF5370" }
        },
        {
            "name": "Keyword, Storage",
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#C792EA" }
        },
        {
            "name": "Operator, Misc",
            "scope": [
                "keyword.control",
                "constant.other.color",
                "punctuation",
                "meta.tag",
                "punctuation.definition.tag",
                "punctuation.separator.inheritance.php",
                "punctuation.definition.tag.html",
                "punctuation.definition.tag.begin.html",
                "punctuation.definition.tag.end.html",
                "punctuation.section.embedded",
                "keyword.other.template",
                "keyword.other.substitution"
            ],
            "settings": { "foreground": "#89DDFF" }
        },
        {
            "name": "Tag",
            "scope": [
                "entity.name.tag",
                "meta.tag.sgml",
                "markup.deleted.git_gutter"
            ],
            "settings": { "foreground": "#f07178" }
        },
        {
            "name": "Function, Special Method",
            "scope": [
                "entity.name.function",
                "meta.function-call",
                "variable.function",
                "support.function",
                "keyword.other.special-method"
            ],
            "settings": { "foreground": "#52ADF2", "fontStyle": "bold" }
        },
        {
            "name": "Block Level Variables",
            "scope": ["meta.block variable.other"],
            "settings": { "foreground": "#8FBCBB" }
        },
        {
            "name": "Other Variable, String Link",
            "scope": ["support.other.variable", "string.other.link"],
            "settings": { "foreground": "#FF8A65" }
        },
        {
            "name": "Number, Constant, Function Argument, Tag Attribute, Embedded",
            "scope": [
                "constant.numeric",
                "constant.language",
                "support.constant",
                "constant.character",
                "constant.escape",
                "variable.parameter",
                "keyword.other.unit",
                "keyword.other"
            ],
            "settings": { "foreground": "#F78C6C" }
        },
        {
            "name": "String, Symbols, Inherited Class, Markup Heading",
            "scope": [
                "string",
                "constant.other.symbol",
                "constant.other.key",
                "entity.other.inherited-class",
                "markup.heading",
                "markup.inserted.git_gutter",
                "meta.group.braces.curly constant.other.object.key.js string.unquoted.label.js"
            ],
            "settings": { "foreground": "#C3E88D" }
        },
        {
            "name": "Class, Support",
            "scope": [
                "entity.name",
                "support.type",
                "support.class",
                "support.other.namespace.use.php",
                "meta.use.php",
                "support.other.namespace.php",
                "markup.changed.git_gutter",
                "support.type.sys-types"
            ],
            "settings": { "foreground": "#FFCB6B" }
        },
        {
            "name": "Entity Types",
            "scope": ["support.type"],
            "settings": { "foreground": "#B2CCD6" }
        },
        {
            "name": "CSS Class and Support",
            "scope": [
                "source.css support.type.property-name",
                "source.sass support.type.property-name",
                "source.scss support.type.property-name",
                "source.less support.type.property-name",
                "source.stylus support.type.property-name",
                "source.postcss support.type.property-name"
            ],
            "settings": { "foreground": "#B2CCD6" }
        },
        {
            "name": "Language methods",
            "scope": ["variable.language"],
            "settings": { "fontStyle": "italic", "foreground": "#FF5370" }
        },
        {
            "name": "Attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#FF8A65" }
        },
        {
            "name": "HTML Attributes",
            "scope": [
                "text.html.basic entity.other.attribute-name.html",
                "text.html.basic entity.other.attribute-name"
            ],
            "settings": { "fontStyle": "italic", "foreground": "#FFAB91" }
        },
        {
            "name": "CSS Classes",
            "scope": ["entity.other.attribute-name.class"],
            "settings": { "foreground": "#FFCB6B" }
        },
        {
            "name": "Inserted",
            "scope": ["markup.inserted"],
            "settings": { "foreground": "#C3E88D" }
        },
        {
            "name": "Deleted",
            "scope": ["markup.deleted"],
            "settings": { "foreground": "#FF5370" }
        },
        {
            "name": "Changed",
            "scope": ["markup.changed"],
            "settings": { "foreground": "#C792EA" }
        },
        {
            "name": "Regular Expressions",
            "scope": ["string.regexp"],
            "settings": { "foreground": "#89DDFF" }
        },
        {
            "name": "Escape Characters",
            "scope": ["constant.character.escape"],
            "settings": { "foreground": "#89DDFF" }
        },
        {
            "name": "URL",
            "scope": ["*url*", "*link*", "*uri*"],
            "settings": { "fontStyle": "underline" }
        },
        {
            "name": "JSON Key - Level 0",
            "scope": [
                "source.json meta.structure.dictionary.json support.type.property-name.json"
            ],
            "settings": { "foreground": "#A5D6F7" }
        },
        {
            "name": "JSON Key - Level 1",
            "scope": [
                "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
            ],
            "settings": { "foreground": "#81C4F7" }
        },
        {
            "name": "JSON Key - Level 2",
            "scope": [
                "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
            ],
            "settings": { "foreground": "#F78C6C" }
        },
        {
            "name": "JSON Key - Level 3",
            "scope": [
                "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
            ],
            "settings": { "foreground": "#FF5370" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
