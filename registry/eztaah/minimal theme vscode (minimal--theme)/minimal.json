{
    "name": "minimal",
    "type": "dark",
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "enumMember": { "foreground": "#bfbb71" },
        "macro": { "foreground": "#bfbb71" }
    },
    "tokenColors": [
        {
            "name": "Base",
            "scope": [
                "source",
                "text",
                "storage.modifier.array",
                "support.type.property-name.json.comments",
                "punctuation.definition.dictionnary",
                "storage.modifier.reference.cpp",
                "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json",
                "text.html.markdown string.quoted.double.html"
            ],
            "settings": { "foreground": "#cccccc" }
        },
        {
            "name": "Comments",
            "scope": "comment",
            "settings": { "foreground": "#85857a" }
        },
        {
            "name": "Keywords ",
            "scope": [
                "keyword.control",
                "keyword.other",
                "storage.modifier",
                "storage.type",
                "keyword.operator.sizeof.c",
                "variable.parameter.function.language.special.self.python",
                "variable.language.special.self.python"
            ],
            "settings": { "foreground": "#f76a6a" }
        },
        {
            "name": "Type",
            "scope": ["storage.type.built-in", "entity.name.type"],
            "settings": { "foreground": "#98c379" }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "meta.function-call.generic.python",
                "support.function.magic.python",
                "entity.name.type.class.python"
            ],
            "settings": { "foreground": "#61afef" }
        },
        {
            "name": "Constant",
            "scope": [
                "constant",
                "macro",
                "string.quoted",
                "keyword.other.unit"
            ],
            "settings": { "foreground": "#bfbb71" }
        },
        {
            "name": "Markdown headings",
            "scope": "markup.heading.markdown, entity.name.section.markdown",
            "settings": { "foreground": "#f76a6a", "fontStyle": "bold" }
        },
        {
            "name": "Markdown text",
            "scope": "meta.paragraph.markdown",
            "settings": { "foreground": "#cccccc" }
        },
        {
            "name": "Bash script default",
            "scope": [
                "source.shell",
                "source.shell.bash",
                "source.shell.sh",
                "entity.name.command.shell",
                "meta.argument.shell",
                "meta.statement.shell",
                "meta.statement.command.shell",
                "string.unquoted.argument",
                "constant.other.option"
            ],
            "settings": { "foreground": "#cccccc" }
        }
    ],
