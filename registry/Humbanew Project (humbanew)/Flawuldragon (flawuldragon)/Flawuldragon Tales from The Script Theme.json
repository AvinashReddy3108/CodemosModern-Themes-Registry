            "settings": { "foreground": "#ffffff", "fontStyle": "italic" }
        },
        {
            "scope": ["punctuation.section.embedded.end.php"],
            "settings": { "foreground": "#ffffff" }
        },
        {
            "scope": "support.function.git-rebase",
            "settings": { "foreground": "#ffffff" }
        },
        {
            "scope": "constant.sha.git-rebase",
            "settings": { "foreground": "#ffffff" }
