        {
            "scope": "meta.preprocessor.numeric",
            "settings": { "foreground": "#ffffff" }
        },
        {
            "scope": "meta.structure.dictionary.key.python",
            "settings": { "foreground": "#ffffff" }
        },
        {
            "scope": "storage",
            "settings": { "foreground": "#ffffff", "fontStyle": "bold italic" }
