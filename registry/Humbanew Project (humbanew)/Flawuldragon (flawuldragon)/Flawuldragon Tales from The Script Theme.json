                "source.coffee.embedded"
            ],
            "settings": { "foreground": "#ffffff" }
        },
        {
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#ffffff" }
        },
        {
            "scope": "keyword",
            "settings": { "foreground": "#ffffff", "fontStyle": "bold" }
        },
        {
            "scope": "keyword.control",
            "settings": { "foreground": "#ffffff", "fontStyle": "bold" }
        },
        {
            "scope": "keyword.operator",
            "settings": { "foreground": "#ffffff" }
