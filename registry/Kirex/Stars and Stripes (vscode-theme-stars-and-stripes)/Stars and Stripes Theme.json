{
    "$schema": "vscode://schemas/color-theme",
    "name": "Stars and Stripes",
    "type": "light",
    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#ADADAD" }
        },
        {
            "name": "Comments: Preprocessor",
            "scope": "comment.block.preprocessor",
            "settings": { "fontStyle": "", "foreground": "#448C27" }
        },
        {
            "name": "Comments: Documentation",
            "scope": ["comment.documentation", "comment.block.documentation"],
            "settings": { "foreground": "#448C27" }
        },
        {
            "name": "Invalid - Illegal",
            "scope": "invalid.illegal",
            "settings": { "foreground": "#FFA500", "fontStyle": "bold" }
        },
        {
            "name": "Operators",
            "scope": "keyword.operator",
            "settings": { "foreground": "#0000AA", "fontStyle": "bold" }
        },
        {
            "name": "Keywords",
            "scope": ["keyword", "storage"],
            "settings": { "foreground": "#C96916" }
        },
        {
            "name": "Keywords Control",
            "scope": ["keyword.control"],
            "settings": { "foreground": "#aa0000" }
        },
        {
            "name": "Types",
            "scope": ["storage.type", "support.type"],
            "settings": { "foreground": "#AA2063" }
        },
        {
            "name": "Language Constants",
            "scope": [
                "constant.language",
                "support.constant",
                "variable.language"
            ],
            "settings": { "foreground": "#000000", "fontStyle": "italic" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "support.variable"],
            "settings": { "foreground": "#000000", "fontStyle": "bold" }
        },
        {
            "name": "Variables Parameter",
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#C96916", "fontStyle": "bold" }
        },
        {
            "name": "Functions",
            "scope": ["entity.name.function", "support.function"],
            "settings": { "fontStyle": "bold", "foreground": "#0000FF" }
        },
        {
            "name": "Classes",
            "scope": [
                "entity.name.type",
                "entity.other.inherited-class",
                "support.class"
            ],
            "settings": { "fontStyle": "bold", "foreground": "#0000FF" }
        },
        {
            "name": "Exceptions",
            "scope": "entity.name.exception",
            "settings": { "foreground": "#FF0000" }
        },
        {
            "name": "Sections",
            "scope": "entity.name.section",
            "settings": { "fontStyle": "bold", "foreground": "#81a2be" }
        },
        {
            "name": "Numbers, Characters",
            "scope": ["constant.numeric", "constant.character", "constant"],
            "settings": { "foreground": "#aa0000", "fontStyle": "bold" }
        },
        {
            "name": "Strings",
            "scope": "string",
            "settings": { "foreground": "#00894D" }
        },
        {
            "name": "Strings: Escape Sequences",
            "scope": "constant.character.escape",
            "settings": { "foreground": "#FFA500" }
        },
        {
            "name": "Strings: Regular Expressions",
            "scope": "string.regexp",
            "settings": { "foreground": "#000000" }
        },
        {
            "name": "Strings: Symbols",
            "scope": "constant.other.symbol",
            "settings": { "foreground": "#aa0000" }
        },
        {
            "name": "Punctuation",
            "scope": "punctuation",
            "settings": { "foreground": "#ADADAD" }
        }
    ],
    "semanticHighlighting": false,
    "semanticTokenColors": {
        "*.declaration": "#ff0000",
        "*.readonly": "#ff0000",
        "*.static": "#ff0000",
        "*.deprecated": "#ff0000",
        "*.abstract": "#ff0000",
        "*.async": "#ff0000",
        "*.modification": "#ff0000",
        "*.documentation": "#ff0000",
        "*.defaultLibrary": "#ff0000",
        "*.annotation": "#ff0000",
        "namespace": "#000000",
        "type": { "foreground": "#0000ff", "fontStyle": "bold" },
        "struct": { "foreground": "#0000ff", "fontStyle": "bold" },
        "class": { "foreground": "#0000ff" },
        "class.constructor": { "fontStyle": "bold" },
        "class.declaration": { "fontStyle": "bold" },
        "class.readonly": {
            "foreground": "#0000ff",
            "fontStyle": "bold italic"
        },
        "method": { "foreground": "#0000ff" },
        "method.instance": { "foreground": "#000" },
        "method.declaration": { "foreground": "#f00" },
        "method.static": { "foreground": "#000", "fontStyle": "bold" },
        "enum": "#0000ff",
        "interface": "#0000ff",
        "typeParameter": "#00894D",
        "parameter": { "foreground": "#000", "fontStyle": "" },
        "parameter.label": { "foreground": "#4444ff", "fontStyle": "" },
        "parameter.declaration": { "fontStyle": "" },
        "variable": { "foreground": "#000000" },
        "property": "#000000",
        "property.instance": { "foreground": "#AD4011", "fontStyle": "bold" },
        "property.declaration": {
            "foreground": "#AD4011",
            "fontStyle": "bold"
        },
        "storage": "#0000ff",
        "enumMember": "#0000ff",
        "event": "#0000ff",
        "function": { "fontStyle": "bold", "foreground": "#0000FF" },
        "macro": "#0000ff",
        "label": "#0000ff",
        "comment": "#ADADAD",
        "comment.documentation": {
            "foreground": "#008000",
            "fontStyle": "bold"
        },
        "string": { "foreground": "#008080" },
        "keyword": { "foreground": "#0000AA", "fontStyle": "bold" },
        "number": { "foreground": "#AD4011", "fontStyle": "bold" },
        "boolean": { "foreground": "#AD4011", "fontStyle": "bold" },
        "regexp": "#FFA500",
        "operator": { "foreground": "#0000AA", "fontStyle": "bold" },
        "annotation": { "foreground": "#666" },
        "property.annotation": { "foreground": "#666" }
    },
    "colors": {
        "list.activeSelectionBackground": "#FFFF00",
        "list.activeSelectionForeground": "#000000",
        "list.inactiveSelectionBackground": "#FFFF00",
        "list.inactiveSelectionForeground": "#000000",
        "list.hoverBackground": "#FFFF66",
        "list.highlightForeground": "#000000",
        "list.focusOutline": "#ffaaaa",
        "editor.selectionBackground": "#ffeeee",
        "editor.inactiveSelectionBackground": "#ffaaaa",
        "editor.selectionForeground": "#000000",
        "editor.lineHighlightBackground": "#ffeeee",
        "editor.lineHighlightBorder": "#ffeeee",
        "editor.selectionHighlightBackground": "#eeeeeeee",
        "editor.selectionHighlightBorder": "#aaa",
        "editorCursor.foreground": "#FF0000",
        "editorCursor.background": "#ffffff",
        "editorWhitespace.foreground": "#eeeeee",
        "editor.findRangeHighlightBorder": "#FFBC5D",
        "editor.findRangeHighlightBackground": "#00000000",
        "editorLineNumber.foreground": "#000000",
        "editorLineNumber.activeForeground": "#FF0000",
        "editorBracketHighlight.foreground1": "#ff0000",
        "editorBracketHighlight.foreground2": "#ff0000",
        "editorBracketHighlight.foreground3": "#ff0000",
        "editorBracketHighlight.foreground4": "#ff0000",
        "editorBracketHighlight.foreground5": "#ff0000",
        "editorBracketHighlight.foreground6": "#ff0000",
        "editorBracketHighlight.unexpectedBracket.foreground": "#ff00bf",
        "editorBracketMatch.background": "#ff000033",
        "editorBracketMatch.border": "#ff0000",
        "editorGutter.background": "#ffffff",
        "editor.foldBackground": "#ffa",
        "editorGutter.foldingControlForeground": "#ff0000",
        "editorUnnecessaryCode.opacity": "#000000c0"
    }
}
