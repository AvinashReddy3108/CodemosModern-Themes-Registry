        "minimap.background": "#0d1115",
        "textBlockQuote.background": "#141a21",
        "textCodeBlock.background": "#141a21"
    },
    "tokenColors": [
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#68727e" }
        },
        {
            "scope": [
                "string",
                "string.quoted",
                "string.template",
                "string.regexp"
            ],
            "settings": { "foreground": "#8fcb6c" }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.language.boolean",
                "constant.language.null",
                "constant.language.undefined"
            ],
            "settings": { "foreground": "#de7c2c" }
        },
        {
            "scope": ["keyword", "storage", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#4f79b7" }
        },
        {
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call",
                "variable.function"
            ],
            "settings": { "foreground": "#62b4d8" }
        },
        {
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.class",
                "support.type",
                "entity.name.namespace"
            ],
            "settings": { "foreground": "#9db2c8" }
        },
        {
            "scope": [
                "variable",
                "meta.definition.variable.name",
                "support.variable"
            ],
            "settings": { "foreground": "#d1d8e0" }
        },
        {
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#bcc7d2" }
        },
        {
            "scope": [
                "entity.name.tag",
                "meta.tag",
                "punctuation.definition.tag"
            ],
            "settings": { "foreground": "#4f79b7" }
        },
        {
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#62b4d8" }
        },
        {
            "scope": [
                "keyword.operator",
                "punctuation.separator",
                "punctuation.terminator"
            ],
            "settings": { "foreground": "#8fa0b3" }
        },
        {
            "scope": [
                "constant.character.escape",
                "string.regexp.character-class",
                "string.regexp constant.character.escape"
            ],
            "settings": { "foreground": "#d7b65f" }
        },
        {
            "scope": ["invalid", "invalid.illegal", "invalid.deprecated"],
            "settings": { "foreground": "#d14d57" }
        },
        {
            "scope": ["markup.heading", "markup.bold", "markup.italic"],
            "settings": { "foreground": "#8fa9c2" }
        },
        {
            "scope": ["markup.inline.raw", "markup.fenced_code.block"],
            "settings": { "foreground": "#8fcb6c" }
        }
    ],
    "semanticTokenColors": {
        "namespace": "#9db2c8",
        "class": "#9db2c8",
        "enum": "#9db2c8",
        "interface": "#9db2c8",
        "struct": "#9db2c8",
        "typeParameter": "#9db2c8",
        "type": "#9db2c8",
        "parameter": "#bcc7d2",
        "variable": "#d1d8e0",
        "property": "#d1d8e0",
        "enumMember": "#de7c2c",
        "function": "#62b4d8",
        "method": "#62b4d8",
        "macro": "#62b4d8",
        "decorator": "#d7b65f",
        "keyword": "#4f79b7",
        "comment": "#68727e",
        "string": "#8fcb6c",
        "number": "#de7c2c",
        "regexp": "#8fcb6c",
        "operator": "#8fa0b3"
    }
}
