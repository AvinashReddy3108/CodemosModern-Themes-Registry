{
    "name": "Monokai Light",
    "type": "light",
    "colors": {
        "editor.background": "#fff",
        "editor.foreground": "#3a3739",
        "editor.selectionBackground": "#d7d7d7"
    },
    "tokenColors": [
        {
            "name": "Comment",
            "scope": "comment",
            "settings": { "foreground": "#565554" }
        },
        {
            "name": "Constants",
            "scope": [
                "constant.character",
                "constant.numeric",
                "constant.other"
            ],
            "settings": { "foreground": "#8b4dff" }
        },
        {
            "name": "Class",
            "scope": "entity.name.class",
            "settings": { "foreground": "#0f8a15" }
        },
        {
            "name": "Function",
            "scope": "entity.name.function",
            "settings": { "foreground": "#0f8a15" }
        },
        {
            "name": "Tag",
            "scope": ["entity.name.tag", "meta.tag"],
            "settings": { "foreground": "#db0400" }
        },
        {
            "name": "Attributes",
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#0f8a15" }
        },
        {
            "name": "Inherited Class",
            "scope": "entity.other.inherited-class",
            "settings": { "fontStyle": "italic", "foreground": "#0f8a15" }
        },
        {
            "name": "Invalid",
            "scope": "invalid",
            "settings": { "foreground": "#db0400" }
        },
        {
            "name": "Keyword",
            "scope": "keyword",
            "settings": { "foreground": "#db0400" }
        },
        {
            "name": "Storage",
            "scope": "storage",
            "settings": { "foreground": "#db0400" }
        },
        {
            "name": "Type",
            "scope": "storage.type",
            "settings": { "fontStyle": "italic", "foreground": "#1c7e92" }
        },
        {
            "name": "String",
            "scope": "string",
            "settings": { "foreground": "#caa512" }
        },
        {
            "name": "Support",
            "scope": ["support.constant", "support.function"],
            "settings": { "foreground": "#1c7e92" }
        },
        {
            "name": "Support",
            "scope": ["support.class", "support.type"],
            "settings": { "fontStyle": "italic", "foreground": "#1c7e92" }
        },
        {
            "name": "Variable",
            "scope": "variable",
            "settings": { "foreground": "#3a3739b3" }
        },
        {
            "name": "Parameter",
            "scope": "variable.parameter",
            "settings": { "foreground": "#e05600" }
        },
        {
            "name": "CSS Unit",
            "scope": "source.css keyword.other.unit",
            "settings": { "foreground": "#8b4dff" }
        },
        {
            "name": "THis",
            "scope": "variable.language.this.js",
            "settings": { "foreground": "#db0400" }
        },
        {
            "name": "self",
            "scope": "variable.parameter.function.language.special.self.python",
            "settings": { "foreground": "#db0400" }
        },
        {
            "name": "Markdown - Heading",
            "scope": "markup.heading.markdown",
            "settings": { "foreground": "#0f8a15" }
        },
        {
            "name": "Markdown - Link URL",
            "scope": "markup.underline.link.markdown",
            "settings": { "foreground": "#caa512" }
        },
        {
            "name": "Markdown - Link Name",
            "scope": "string.other.link.title.markdown",
            "settings": { "foreground": "#8b4dff" }
        },
        {
            "name": "Markdown - Bold",
            "scope": "markup.bold.markdown",
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Markdown - Italic",
            "scope": "markup.italic.markdown",
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "Markdown - Code",
            "scope": [
                "markup.inline.raw.string.markdown",
                "markup.fenced_code.block.markdown"
            ],
            "settings": { "foreground": "#1c7e92" }
        },
        {
            "name": "Markdown - List",
            "scope": "punctuation.definition.list.begin.markdown",
            "settings": { "foreground": "#db0400" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
