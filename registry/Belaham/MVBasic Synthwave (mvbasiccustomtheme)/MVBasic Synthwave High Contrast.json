{
    "name": "MVBasic Synthwave High Contrast",
    "type": "hc-black",
    "colors": {
        "editor.background": "#000000",
        "editor.foreground": "#FFFFFF",
        "editorCursor.foreground": "#00FFFF",
        "editorLineNumber.foreground": "#808080",
        "editorLineNumber.activeForeground": "#00FFFF",
        "editor.selectionBackground": "#404040",
        "editor.selectionHighlightBackground": "#606060",
        "editor.lineHighlightBackground": "#1A1A1A",
        "editor.wordHighlightBackground": "#404040",
        "editor.wordHighlightStrongBackground": "#606060",
        "editorIndentGuide.background": "#404040",
        "editorIndentGuide.activeBackground": "#00FFFF",
        "editorWhitespace.foreground": "#808080",
        "editorRuler.foreground": "#404040",
        "editorBracketMatch.background": "#00FFFF80",
        "editorBracketMatch.border": "#00FFFF",
        "activityBar.background": "#000000",
        "activityBar.foreground": "#FFFFFF",
        "activityBar.inactiveForeground": "#808080",
        "activityBar.border": "#404040",
        "activityBarBadge.background": "#00FFFF",
        "activityBarBadge.foreground": "#000000",
        "sideBar.background": "#000000",
        "sideBar.foreground": "#FFFFFF",
        "sideBar.border": "#404040",
        "sideBarTitle.foreground": "#00FFFF",
        "sideBarSectionHeader.background": "#1A1A1A",
        "sideBarSectionHeader.foreground": "#FFFFFF",
        "statusBar.background": "#000000",
        "statusBar.foreground": "#FFFFFF",
        "statusBar.border": "#404040",
        "tab.activeBackground": "#000000",
        "tab.activeForeground": "#FFFFFF",
        "tab.activeBorder": "#00FFFF",
        "tab.inactiveBackground": "#000000",
        "tab.inactiveForeground": "#808080",
        "tab.border": "#404040",
        "panel.background": "#000000",
        "panel.foreground": "#FFFFFF",
        "panel.border": "#404040",
        "panelTitle.activeBorder": "#00FFFF",
        "terminal.background": "#000000",
        "terminal.foreground": "#FFFFFF",
        "terminal.ansiBlack": "#000000",
        "terminal.ansiRed": "#FF0000",
        "terminal.ansiGreen": "#00FF00",
        "terminal.ansiYellow": "#FFFF00",
        "terminal.ansiBlue": "#0000FF",
        "terminal.ansiMagenta": "#FF00FF",
        "terminal.ansiCyan": "#00FFFF",
        "terminal.ansiWhite": "#FFFFFF",
        "focusBorder": "#00FFFF",
        "contrastBorder": "#FFFFFF",
        "contrastActiveBorder": "#00FFFF"
    },
    "semanticTokenColors": {
        "namespace": { "foreground": "#FFFF00", "fontStyle": "bold" },
        "string": { "foreground": "#00FF00" },
        "macro": { "foreground": "#FF00FF", "fontStyle": "bold" }
    },
    "tokenColors": [
        {
            "scope": "keyword.control.mvbasic, keyword.control.flow.mvbasic, keyword.control.conditional.flow.mvbasic",
            "settings": { "foreground": "#00FFFF", "fontStyle": "bold" }
        },
        {
            "scope": "keyword.other.mvbasic, storage.type.mvbasic, keyword.declaration.mvbasic",
            "settings": { "foreground": "#FF00FF", "fontStyle": "bold" }
        },
        {
            "scope": "keyword.operator.mvbasic, keyword.operator.logical.mvbasic",
            "settings": { "foreground": "#FF0000", "fontStyle": "bold" }
        },
        {
            "scope": "support.function.builtin.relational.mvbasic",
            "settings": { "foreground": "#FF0000", "fontStyle": "bold" }
        },
        {
            "scope": "variable.mvbasic",
            "settings": { "foreground": "#FFFFFF" }
        },
        {
            "scope": "variable.parameter.mvbasic",
            "settings": { "foreground": "#FF00FF", "fontStyle": "bold" }
        },
        {
            "scope": "variable.other.constant.atvar.mvbasic, constant.language.mvbasic",
            "settings": { "foreground": "#FF0000", "fontStyle": "bold" }
        },
        {
            "scope": "constant.language.system-variable.mvbasic",
            "settings": { "foreground": "#FF0000", "fontStyle": "bold" }
        },
        {
            "scope": "punctuation.definition.mvbasic",
            "settings": { "foreground": "#00FFFF", "fontStyle": "bold" }
        },
        {
            "scope": "constant.numeric.mvbasic",
            "settings": { "foreground": "#00AAFF", "fontStyle": "bold" }
        },
        {
            "scope": "entity.name.function.mvbasic",
            "settings": { "foreground": "#FFAA00", "fontStyle": "bold" }
        },
        {
            "name": "Complete function calls only",
            "scope": "meta.function-call.mvbasic entity.name.function",
            "settings": { "foreground": "#FFAA00", "fontStyle": "bold" }
        },
        {
            "name": "GOSUB label references - match label color without underline",
            "scope": "meta.function-call.gosub.mvbasic, support.function.gosub.mvbasic variable.other.label.mvbasic, keyword.control.gosub.mvbasic + variable.other.mvbasic",
            "settings": { "foreground": "#FF00FF", "fontStyle": "bold italic" }
        },
        {
            "name": "GOSUB references - custom regex capture",
            "scope": "entity.name.function.gosub-reference.mvbasic",
            "settings": { "foreground": "#FF00FF", "fontStyle": "bold italic" }
        },
        {
            "scope": "entity.name.label.mvbasic, meta.label.mvbasic",
            "settings": {
                "foreground": "#FF00FF",
                "fontStyle": "bold italic underline"
            }
        },
        {
            "scope": "string.quoted.mvbasic",
            "settings": { "foreground": "#FFFF00", "fontStyle": "bold" }
        },
        {
            "scope": "string.quoted.single.mvbasic, string.quoted.double.mvbasic",
            "settings": { "foreground": "#FFFF00", "fontStyle": "bold" }
        },
        {
            "scope": "comment.line.mvbasic",
            "settings": { "foreground": "#808080", "fontStyle": "italic" }
        },
        {
            "scope": "support.function.system.mvbasic, variable.other.system.mvbasic",
            "settings": { "foreground": "#FF0000", "fontStyle": "bold" }
        },
        {
            "scope": "punctuation.definition.system.mvbasic",
            "settings": { "foreground": "#00FFFF", "fontStyle": "bold" }
        },
        {
            "scope": "keyword.operator.at.mvbasic",
            "settings": { "foreground": "#FF00FF", "fontStyle": "bold" }
        },
        {
            "scope": "meta.function-call.system.mvbasic, support.function.at-function.mvbasic",
            "settings": {
                "foreground": "#00FFFF",
                "fontStyle": "bold underline"
            }
        },
        {
            "scope": "punctuation.section.function.begin.mvbasic, punctuation.section.parens.begin.mvbasic",
            "settings": { "foreground": "#00AAFF" }
        },
        {
            "scope": "punctuation.separator.mvbasic, punctuation.terminator.mvbasic",
            "settings": { "foreground": "#FF00FF" }
        },
        {
            "scope": "keyword.operator.mvbasic.at",
            "settings": { "foreground": "#FF0000", "fontStyle": "bold" }
        },
        {
            "scope": "keyword.control.directive.mvbasic",
            "settings": { "foreground": "#FFFF00", "fontStyle": "bold italic" }
        },
        {
            "scope": "entity.name.type.file-handle.mvbasic",
            "settings": {
                "foreground": "#FFFF00",
                "fontStyle": "bold underline"
            }
        },
        {
            "name": "FINAL OVERRIDE - GOSUB label references (no underline)",
            "scope": "variable.other.label-reference.mvbasic, entity.name.function.label-reference.mvbasic, meta.gosub.mvbasic variable.other.mvbasic, support.function.gosub.mvbasic variable.other.mvbasic",
            "settings": { "foreground": "#FF00FF", "fontStyle": "bold italic" }
        },
        {
            "name": "FINAL OVERRIDE - Labels and Tags",
            "scope": "entity.name.label.mvbasic, meta.label.mvbasic, entity.name.tag.mvbasic, variable.other.tag.mvbasic",
            "settings": {
                "foreground": "#FF00FF",
                "fontStyle": "bold italic underline"
            }
        },
        {
            "name": "FINAL OVERRIDE - External subroutine calls",
            "scope": "meta.function-call.external.mvbasic, entity.name.function.external.mvbasic, support.function.external.mvbasic",
            "settings": { "foreground": "#FFAA00", "fontStyle": "bold" }
        },
        {
            "name": "FINAL OVERRIDE - System variables and functions",
            "scope": "variable.other.system.mvbasic, support.function.system.mvbasic, variable.language.mvbasic",
            "settings": { "foreground": "#FF0000", "fontStyle": "bold" }
        },
        {
            "name": "FINAL OVERRIDE - File handles",
            "scope": "entity.name.type.file-handle.mvbasic, variable.other.file-handle.mvbasic, constant.other.file-handle.mvbasic",
            "settings": {
                "foreground": "#FFFF00",
                "fontStyle": "bold underline"
            }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
