{
    "name": "MVBasic Synthwave Light",
    "type": "light",
    "colors": {
        "editor.background": "#FAFAFA",
        "editor.foreground": "#2E3440",
        "editorCursor.foreground": "#0066CC",
        "editorLineNumber.foreground": "#A3A3A3",
        "editorLineNumber.activeForeground": "#0066CC",
        "editor.selectionBackground": "#E5E7EB",
        "editor.selectionHighlightBackground": "#E5E7EB75",
        "editor.lineHighlightBackground": "#F3F4F6",
        "editor.wordHighlightBackground": "#E5E7EB50",
        "editor.wordHighlightStrongBackground": "#E5E7EB75",
        "editorIndentGuide.background": "#E5E7EB",
        "editorIndentGuide.activeBackground": "#0066CC",
        "editorWhitespace.foreground": "#9CA3AF",
        "editorRuler.foreground": "#E5E7EB",
        "editorBracketMatch.background": "#0066CC30",
        "editorBracketMatch.border": "#0066CC",
        "activityBar.background": "#F3F4F6",
        "activityBar.foreground": "#2E3440",
        "activityBar.inactiveForeground": "#9CA3AF",
        "activityBar.border": "#E5E7EB",
        "activityBarBadge.background": "#0066CC",
        "activityBarBadge.foreground": "#FAFAFA",
        "sideBar.background": "#F3F4F6",
        "sideBar.foreground": "#2E3440",
        "sideBar.border": "#E5E7EB",
        "sideBarTitle.foreground": "#0066CC",
        "sideBarSectionHeader.background": "#E5E7EB",
        "sideBarSectionHeader.foreground": "#2E3440",
        "sideBarSectionHeader.border": "#D1D5DB",
        "statusBar.background": "#F3F4F6",
        "statusBar.foreground": "#2E3440",
        "statusBar.border": "#E5E7EB",
        "statusBarItem.hoverBackground": "#E5E7EB",
        "statusBarItem.activeBackground": "#D1D5DB",
        "titleBar.activeBackground": "#F3F4F6",
        "titleBar.activeForeground": "#2E3440",
        "titleBar.inactiveBackground": "#F3F4F6",
        "titleBar.inactiveForeground": "#9CA3AF",
        "titleBar.border": "#E5E7EB",
        "tab.activeBackground": "#FAFAFA",
        "tab.activeForeground": "#2E3440",
        "tab.activeBorder": "#0066CC",
        "tab.inactiveBackground": "#F3F4F6",
        "tab.inactiveForeground": "#9CA3AF",
        "tab.border": "#E5E7EB",
        "tab.hoverBackground": "#E5E7EB",
        "panel.background": "#FAFAFA",
        "panel.foreground": "#2E3440",
        "panel.border": "#E5E7EB",
        "panelTitle.activeBorder": "#0066CC",
        "panelTitle.activeForeground": "#2E3440",
        "panelTitle.inactiveForeground": "#9CA3AF",
        "terminal.background": "#FAFAFA",
        "terminal.foreground": "#2E3440",
        "focusBorder": "#0066CC",
        "button.background": "#0066CC",
        "button.foreground": "#FAFAFA",
        "button.hoverBackground": "#0052A3",
        "input.background": "#FFFFFF",
        "input.foreground": "#2E3440",
        "input.border": "#E5E7EB",
        "input.placeholderForeground": "#9CA3AF",
        "dropdown.background": "#FFFFFF",
        "dropdown.foreground": "#2E3440",
        "dropdown.border": "#E5E7EB",
        "list.activeSelectionBackground": "#0066CC20",
        "list.activeSelectionForeground": "#2E3440",
        "list.hoverBackground": "#F3F4F6",
        "list.inactiveSelectionBackground": "#E5E7EB",
        "list.focusBackground": "#0066CC30"
    },
    "semanticTokenColors": {
        "namespace": { "foreground": "#B8860B", "fontStyle": "bold underline" },
        "string": { "foreground": "#CC8500" },
        "macro": { "foreground": "#D65D8E", "fontStyle": "bold" }
    },
    "tokenColors": [
        {
            "scope": "keyword.control.mvbasic, keyword.control.flow.mvbasic, keyword.control.conditional.flow.mvbasic",
            "settings": { "foreground": "#0066CC", "fontStyle": "bold" }
        },
        {
            "scope": "keyword.other.mvbasic, storage.type.mvbasic, keyword.declaration.mvbasic",
            "settings": { "foreground": "#8B4B9C", "fontStyle": "bold" }
        },
        {
            "scope": "keyword.operator.mvbasic, keyword.operator.logical.mvbasic",
            "settings": { "foreground": "#C44569", "fontStyle": "bold" }
        },
        {
            "scope": "support.function.builtin.relational.mvbasic",
            "settings": { "foreground": "#C44569", "fontStyle": "bold" }
        },
        {
            "scope": "variable.mvbasic",
            "settings": { "foreground": "#007D7A" }
        },
        {
            "scope": "variable.parameter.mvbasic",
            "settings": { "foreground": "#8B4B9C" }
        },
        {
            "scope": "variable.other.constant.atvar.mvbasic, constant.language.mvbasic",
            "settings": { "foreground": "#C44569", "fontStyle": "bold" }
        },
        {
            "scope": "constant.language.system-variable.mvbasic",
            "settings": { "foreground": "#C44569", "fontStyle": "bold" }
        },
        {
            "scope": "punctuation.definition.mvbasic",
            "settings": { "foreground": "#0066CC" }
        },
        {
            "scope": "constant.numeric.mvbasic",
            "settings": { "foreground": "#0076A8", "fontStyle": "bold" }
        },
        {
            "scope": "entity.name.function.mvbasic",
            "settings": { "foreground": "#7F47B8", "fontStyle": "bold" }
        },
        {
            "name": "Complete function calls only",
            "scope": "meta.function-call.mvbasic entity.name.function",
            "settings": { "foreground": "#7F47B8", "fontStyle": "bold" }
        },
        {
            "name": "GOSUB label references - match label color without underline",
            "scope": "meta.function-call.gosub.mvbasic, support.function.gosub.mvbasic variable.other.label.mvbasic, keyword.control.gosub.mvbasic + variable.other.mvbasic",
            "settings": { "foreground": "#DC2F7B", "fontStyle": "bold italic" }
        },
        {
            "name": "GOSUB references - custom regex capture",
            "scope": "entity.name.function.gosub-reference.mvbasic",
            "settings": { "foreground": "#DC2F7B", "fontStyle": "bold italic" }
        },
        {
            "scope": "entity.name.label.mvbasic, meta.label.mvbasic",
            "settings": {
                "foreground": "#DC2F7B",
                "fontStyle": "bold italic underline"
            }
        },
        {
            "scope": "string.quoted.mvbasic",
            "settings": { "foreground": "#CC8500" }
        },
        {
            "scope": "string.quoted.single.mvbasic",
            "settings": { "foreground": "#CC8500", "fontStyle": "bold" }
        },
        {
            "scope": "comment.line.mvbasic",
            "settings": { "foreground": "#6B7280", "fontStyle": "italic" }
        },
        {
            "scope": "support.function.system.mvbasic, variable.other.system.mvbasic",
            "settings": { "foreground": "#C44569", "fontStyle": "bold" }
        },
        {
            "scope": "punctuation.definition.system.mvbasic",
            "settings": { "foreground": "#0066CC", "fontStyle": "bold" }
        },
        {
            "scope": "keyword.operator.at.mvbasic",
            "settings": { "foreground": "#8B4B9C", "fontStyle": "bold" }
        },
        {
            "scope": "meta.function-call.system.mvbasic, support.function.at-function.mvbasic",
            "settings": {
                "foreground": "#007D7A",
                "fontStyle": "bold underline"
            }
        },
        {
            "scope": "punctuation.section.function.begin.mvbasic, punctuation.section.parens.begin.mvbasic",
            "settings": { "foreground": "#0076A8" }
        },
        {
            "scope": "punctuation.separator.mvbasic, punctuation.terminator.mvbasic",
            "settings": { "foreground": "#8B4B9C" }
        },
        {
            "scope": "keyword.operator.mvbasic.at",
            "settings": { "foreground": "#C44569", "fontStyle": "bold" }
        },
        {
            "scope": "keyword.control.directive.mvbasic",
            "settings": { "foreground": "#CC8500", "fontStyle": "bold italic" }
        },
        {
            "scope": "entity.name.type.file-handle.mvbasic",
            "settings": {
                "foreground": "#CC8500",
                "fontStyle": "bold underline"
            }
        },
        {
            "name": "FINAL OVERRIDE - GOSUB label references (no underline)",
            "scope": "variable.other.label-reference.mvbasic, entity.name.function.label-reference.mvbasic, meta.gosub.mvbasic variable.other.mvbasic, support.function.gosub.mvbasic variable.other.mvbasic",
            "settings": { "foreground": "#DC2F7B", "fontStyle": "bold italic" }
        },
        {
            "name": "FINAL OVERRIDE - Labels and Tags",
            "scope": "entity.name.label.mvbasic, meta.label.mvbasic, entity.name.tag.mvbasic, variable.other.tag.mvbasic",
            "settings": {
                "foreground": "#DC2F7B",
                "fontStyle": "bold italic underline"
            }
        },
        {
            "name": "FINAL OVERRIDE - External subroutine calls",
            "scope": "meta.function-call.external.mvbasic, entity.name.function.external.mvbasic, support.function.external.mvbasic",
            "settings": { "foreground": "#7F47B8", "fontStyle": "bold" }
        },
        {
            "name": "FINAL OVERRIDE - System variables and functions",
            "scope": "variable.other.system.mvbasic, support.function.system.mvbasic, variable.language.mvbasic",
            "settings": { "foreground": "#C44569", "fontStyle": "bold" }
        },
        {
            "name": "FINAL OVERRIDE - File handles",
            "scope": "entity.name.type.file-handle.mvbasic, variable.other.file-handle.mvbasic, constant.other.file-handle.mvbasic",
            "settings": {
                "foreground": "#CC8500",
                "fontStyle": "bold underline"
            }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
