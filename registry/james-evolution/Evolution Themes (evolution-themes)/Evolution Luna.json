        "settings.numberInputBackground": "#0f1a27",
        "settings.numberInputBorder": "#1c2e42"
    },
    "semanticHighlighting": true,
    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#6A9955" }
        },
        {
            "name": "String",
            "scope": ["string", "string.template"],
            "settings": { "foreground": "#CE9178" }
        },
        {
            "name": "String escape",
            "scope": "constant.character.escape",
            "settings": { "foreground": "#D7BA7D" }
        },
        {
            "name": "Number",
            "scope": "constant.numeric",
            "settings": { "foreground": "#B5CEA8" }
        },
        {
            "name": "Boolean / null",
            "scope": "constant.language",
            "settings": { "foreground": "#569CD6" }
        },
        {
            "name": "Keyword",
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#569CD6" }
        },
        {
            "name": "Control flow keyword",
            "scope": "keyword.control",
            "settings": { "foreground": "#C586C0" }
        },
        {
            "name": "Operator keyword",
            "scope": [
                "keyword.operator.new",
                "keyword.operator.delete",
                "keyword.other.using",
                "keyword.other.operator",
                "keyword.operator.expression",
                "keyword.operator.instanceof",
                "keyword.operator.logical.python",
                "keyword.operator.wordlike"
            ],
            "settings": { "foreground": "#569CD6" }
        },
        {
            "name": "Operator",
            "scope": "keyword.operator",
            "settings": { "foreground": "#D4D4D4" }
        },
        {
            "name": "Type / class name",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "entity.name.namespace",
                "entity.name.scope-resolution",
                "support.class",
                "support.type"
            ],
            "settings": { "foreground": "#4EC9B0" }
        },
        {
            "name": "Function / method name",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.object-literal.key entity.name.function",
                "source.powershell variable.other.member",
                "entity.name.operator.custom-literal"
            ],
            "settings": { "foreground": "#DCDCAA" }
        },
        {
            "name": "Variable",
            "scope": [
                "variable",
                "variable.other",
                "variable.other.readwrite",
                "variable.object.property",
                "meta.object-literal.key",
                "support.variable"
            ],
            "settings": { "foreground": "#9CDCFE" }
        },
        {
            "name": "Function parameter",
            "scope": "variable.parameter",
            "settings": { "foreground": "#9CDCFE" }
        },
        {
            "name": "Constant / enum member",
            "scope": [
                "variable.other.constant",
                "variable.other.enummember",
                "entity.name.constant"
            ],
            "settings": { "foreground": "#4FC1FF" }
        },
        {
            "name": "Language variable (this, self, super)",
            "scope": "variable.language",
            "settings": { "foreground": "#569CD6" }
        },
        {
            "name": "Entity name (generic)",
            "scope": ["entity", "entity.name"],
            "settings": { "foreground": "#DCDCAA" }
        },
        {
            "name": "Tag name",
            "scope": "entity.name.tag",
            "settings": { "foreground": "#569CD6" }
        },
        {
            "name": "Tag attribute",
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#9CDCFE" }
        },
        {
            "name": "Tag punctuation",
            "scope": [
                "punctuation.definition.tag",
                "punctuation.definition.tag.begin",
                "punctuation.definition.tag.end",
                "punctuation.separator.inheritance.php",
                "punctuation.definition.tag.html"
            ],
            "settings": { "foreground": "#808080" }
        },
        {
            "name": "Regexp",
            "scope": "string.regexp",
            "settings": { "foreground": "#D16969" }
        },
        {
            "name": "CSS class / id / pseudo selector",
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css",
                "entity.other.attribute-name.pseudo-class.css",
                "entity.other.attribute-name.pseudo-element.css",
                "meta.selector"
            ],
            "settings": { "foreground": "#D7BA7D" }
        },
        {
            "name": "CSS property name",
            "scope": "support.type.property-name.css",
            "settings": { "foreground": "#9CDCFE" }
        },
        {
            "name": "Support constant",
            "scope": "support.constant",
            "settings": { "foreground": "#4FC1FF" }
        },
        {
            "name": "Preprocessor directive",
            "scope": [
                "meta.tag.preprocessor",
                "entity.name.function.preprocessor"
            ],
            "settings": { "foreground": "#569CD6" }
        },
        {
            "name": "Markdown heading",
            "scope": "markup.heading",
            "settings": { "foreground": "#569CD6", "fontStyle": "bold" }
        },
        {
            "name": "Markdown inline code",
            "scope": "markup.inline.raw",
            "settings": { "foreground": "#CE9178" }
        },
        {
            "name": "Markdown bold",
            "scope": "markup.bold",
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Markdown italic",
            "scope": "markup.italic",
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "Markdown strikethrough",
            "scope": "markup.strikethrough",
            "settings": { "fontStyle": "strikethrough" }
        },
        {
            "name": "Markdown blockquote",
            "scope": "punctuation.definition.quote.begin.markdown",
            "settings": { "foreground": "#6A9955" }
        },
        {
            "name": "Markdown list bullet",
            "scope": "punctuation.definition.list.begin.markdown",
            "settings": { "foreground": "#6796E6" }
        },
        {
            "name": "Diff inserted",
            "scope": "markup.inserted",
            "settings": { "foreground": "#B5CEA8" }
        },
        {
            "name": "Diff deleted",
            "scope": "markup.deleted",
            "settings": { "foreground": "#CE9178" }
        },
        {
            "name": "Diff changed",
            "scope": "markup.changed",
            "settings": { "foreground": "#569CD6" }
        },
        {
            "name": "Invalid",
            "scope": "invalid",
            "settings": { "foreground": "#F44747" }
        },
        {
            "name": "Debug token",
            "scope": "token.debug-token",
            "settings": { "foreground": "#B267E6" }
        }
    ]
}
