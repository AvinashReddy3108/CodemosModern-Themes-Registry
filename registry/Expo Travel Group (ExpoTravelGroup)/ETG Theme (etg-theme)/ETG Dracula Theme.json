            "settings": { "foreground": "#9876AA", "fontStyle": "" }
        },
        {
            "scope": [
                "entity.name.function.python",
                "meta.function-call.generic.python"
            ],
            "settings": { "foreground": "#FFC66D" }
        },
        {
            "scope": [
                "entity.name.function",
