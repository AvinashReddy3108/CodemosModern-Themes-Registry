    "tokenColors": [
        {
            "name": "Plain text / fallback",
            "scope": ["source", "text"],
            "settings": { "foreground": "#D4DEC8" }
        },
        {
            "name": "Comments",
            "scope": [
                "comment",
                "punctuation.definition.comment",
                "comment.block",
                "comment.line"
            ],
            "settings": { "foreground": "#6A8A58", "fontStyle": "italic" }
        },
        {
            "name": "Doc comments",
            "scope": [
                "comment.block.documentation",
                "comment.line.double-slash.documentation"
            ],
            "settings": { "foreground": "#7AA068", "fontStyle": "italic" }
        },
        {
            "name": "Keywords — control flow",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.control.flow",
                "keyword.control.conditional",
                "keyword.control.loop",
                "keyword.control.import",
                "keyword.control.export",
                "keyword.control.return",
                "keyword.control.trycatch",
                "keyword.control.exception",
                "keyword.other.using",
                "keyword.other.import",
                "keyword.operator.new",
                "keyword.operator.delete",
                "keyword.operator.typeof",
                "keyword.operator.void",
                "keyword.operator.instanceof",
                "keyword.operator.in",
                "keyword.operator.of"
            ],
            "settings": { "foreground": "#9B6FE8", "fontStyle": "bold" }
        },
        {
            "name": "Storage keywords (var/let/const/function/class)",
            "scope": ["storage.type", "storage.modifier"],
            "settings": { "foreground": "#9B6FE8", "fontStyle": "bold" }
        },
        {
            "name": "Types and Classes — definition",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "entity.name.namespace",
                "entity.name.scope-resolution",
                "entity.name.enum"
            ],
            "settings": { "foreground": "#4A9FD4", "fontStyle": "bold" }
        },
        {
            "name": "Types — usage (support)",
            "scope": [
                "support.class",
                "support.type",
                "meta.type.annotation",
                "meta.type.parameters",
                "entity.other.inherited-class"
            ],
            "settings": { "foreground": "#4A9FD4" }
        },
        {
            "name": "Built-in types (C# / Java / TS primitives)",
            "scope": [
                "keyword.type",
                "support.type.primitive",
                "storage.type.primitive",
                "storage.type.numeric",
                "storage.type.string",
                "storage.type.boolean",
                "storage.type.object",
                "storage.type.void",
                "storage.type.cs"
            ],
            "settings": { "foreground": "#4A9FD4" }
        },
        {
            "name": "Function / method — definition",
            "scope": [
                "entity.name.function",
                "entity.name.method",
                "entity.name.member"
            ],
            "settings": { "foreground": "#E07030", "fontStyle": "bold" }
        },
        {
            "name": "Function / method — call",
            "scope": [
                "meta.function-call entity.name.function",
                "meta.method-call entity.name.function",
                "support.function",
                "support.function.builtin"
            ],
            "settings": { "foreground": "#E07030" }
        },
        {
            "name": "Function parameters",
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#C09070", "fontStyle": "italic" }
        },
        {
            "name": "Variables",
            "scope": [
                "variable",
                "variable.other",
                "variable.other.readwrite",
                "variable.other.object",
                "variable.other.object.property"
            ],
            "settings": { "foreground": "#D4DEC8" }
        },
        {
            "name": "Variable — this / self / base",
            "scope": ["variable.language"],
            "settings": { "foreground": "#9B6FE8", "fontStyle": "italic" }
        },
        {
            "name": "Properties / member access",
            "scope": [
                "variable.other.property",
                "variable.other.member",
                "support.variable.property"
            ],
            "settings": { "foreground": "#6ABCF0" }
        },
        {
            "name": "Strings",
            "scope": [
                "string",
                "string.quoted",
                "string.quoted.single",
                "string.quoted.double",
                "string.quoted.triple",
                "string.template",
                "string.interpolated"
            ],
            "settings": { "foreground": "#7EC820" }
        },
        {
            "name": "String escape sequences (\\n, \\t, etc.)",
            "scope": ["constant.character.escape", "constant.character.entity"],
            "settings": { "foreground": "#C89030", "fontStyle": "bold" }
        },
        {
            "name": "Template literal / interpolation ${}",
            "scope": [
                "punctuation.definition.template-expression",
                "punctuation.section.embedded"
            ],
            "settings": { "foreground": "#E07030", "fontStyle": "bold" }
        },
        {
            "name": "Numbers",
            "scope": [
                "constant.numeric",
                "constant.numeric.integer",
                "constant.numeric.float",
                "constant.numeric.hex",
                "constant.numeric.octal",
                "constant.numeric.binary"
            ],
            "settings": { "foreground": "#E07060" }
        },
        {
            "name": "Language constants (true/false/null/undefined)",
            "scope": [
                "constant.language",
                "constant.language.boolean",
                "constant.language.null",
                "constant.language.undefined",
                "constant.language.none"
            ],
            "settings": { "foreground": "#E07060", "fontStyle": "bold" }
        },
        {
            "name": "Other named constants",
            "scope": ["constant.other"],
            "settings": { "foreground": "#C89030" }
        },
        {
            "name": "Operators",
            "scope": [
                "keyword.operator",
                "keyword.operator.arithmetic",
                "keyword.operator.assignment",
                "keyword.operator.comparison",
                "keyword.operator.logical",
                "keyword.operator.bitwise",
                "keyword.operator.ternary",
                "keyword.operator.spread",
                "keyword.operator.optional",
                "keyword.operator.nullish",
                "keyword.operator.arrow"
            ],
            "settings": { "foreground": "#8A9A9C" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation",
                "punctuation.separator",
                "punctuation.terminator",
                "punctuation.accessor",
                "punctuation.definition.block",
                "punctuation.definition.parameters",
                "meta.brace",
                "meta.delimiter"
            ],
            "settings": { "foreground": "#6A8A7A" }
        },
        {
            "name": "Regular expressions",
            "scope": [
                "string.regexp",
                "constant.other.character-class.regexp",
                "constant.character.regexp",
                "keyword.operator.quantifier.regexp",
                "keyword.operator.or.regexp",
                "punctuation.definition.group.regexp",
                "punctuation.definition.character-class.regexp"
            ],
            "settings": { "foreground": "#2AC890" }
        },
        {
            "name": "Decorators and annotations",
            "scope": [
                "meta.decorator",
                "punctuation.decorator",
                "entity.name.function.decorator",
                "storage.type.annotation"
            ],
            "settings": { "foreground": "#C89030", "fontStyle": "italic" }
        },
        {
            "name": "C# / Java attributes",
            "scope": [
                "entity.name.type.attribute.cs",
                "support.type.attribute"
            ],
            "settings": { "foreground": "#C89030" }
        },
        {
            "name": "XML/HTML — tag names",
            "scope": [
                "entity.name.tag",
                "entity.name.tag.xml",
                "entity.name.tag.html",
                "meta.tag.xml entity.name.tag"
            ],
            "settings": { "foreground": "#4A9FD4", "fontStyle": "bold" }
        },
        {
            "name": "XML/HTML — attribute names",
            "scope": [
                "entity.other.attribute-name",
                "entity.other.attribute-name.xml",
                "entity.other.attribute-name.html"
            ],
            "settings": { "foreground": "#C89030" }
        },
        {
            "name": "XML/HTML — attribute values",
            "scope": [
                "string.quoted.double.html",
                "string.quoted.single.html",
                "string.quoted.double.xml",
                "string.quoted.single.xml"
            ],
            "settings": { "foreground": "#7EC820" }
        },
        {
            "name": "XML/HTML — punctuation (< > / =)",
            "scope": [
                "punctuation.definition.tag",
                "punctuation.definition.tag.begin",
                "punctuation.definition.tag.end",
                "meta.tag punctuation"
            ],
            "settings": { "foreground": "#8A9A9C" }
        },
        {
            "name": "XML/HTML — CDATA",
            "scope": ["string.unquoted.cdata.xml"],
            "settings": { "foreground": "#7EC820", "fontStyle": "italic" }
        },
        {
            "name": "XML/HTML — DOCTYPE / processing instructions",
            "scope": ["meta.tag.sgml.doctype", "meta.tag.preprocessor.xml"],
            "settings": { "foreground": "#6A8A58", "fontStyle": "italic" }
        },
        {
            "name": "XML — namespace prefix",
            "scope": ["entity.name.tag.namespace.xml"],
            "settings": { "foreground": "#9B6FE8" }
        },
        {
            "name": "CSS — selectors (tag names)",
            "scope": ["entity.name.tag.css"],
            "settings": { "foreground": "#4A9FD4" }
        },
        {
            "name": "CSS — class and ID selectors",
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css"
            ],
            "settings": { "foreground": "#9B6FE8" }
        },
        {
            "name": "CSS — property names",
            "scope": [
                "support.type.property-name.css",
                "support.type.property-name.scss",
                "support.type.property-name.less"
            ],
            "settings": { "foreground": "#C89030" }
        },
        {
            "name": "CSS — property values",
            "scope": [
                "support.constant.property-value.css",
                "meta.property-value.css"
            ],
            "settings": { "foreground": "#7EC820" }
        },
        {
            "name": "CSS — units and numbers",
            "scope": ["keyword.other.unit.css"],
            "settings": { "foreground": "#E07060" }
        },
        {
            "name": "CSS — pseudo-class / pseudo-element",
            "scope": [
                "entity.other.attribute-name.pseudo-class.css",
                "entity.other.attribute-name.pseudo-element.css"
            ],
            "settings": { "foreground": "#2AC890" }
        },
        {
            "name": "JSON — keys",
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#C89030", "fontStyle": "bold" }
        },
        {
            "name": "JSON — string values",
            "scope": ["string.quoted.double.json"],
            "settings": { "foreground": "#7EC820" }
        },
        {
            "name": "JSON — numbers",
            "scope": ["constant.numeric.json"],
            "settings": { "foreground": "#E07060" }
        },
        {
            "name": "JSON — boolean / null",
            "scope": ["constant.language.json"],
            "settings": { "foreground": "#E07060", "fontStyle": "bold" }
        },
        {
            "name": "Markdown — headings",
            "scope": [
                "markup.heading",
                "entity.name.section.markdown",
                "punctuation.definition.heading.markdown"
            ],
            "settings": { "foreground": "#9B6FE8", "fontStyle": "bold" }
        },
        {
            "name": "Markdown — bold",
            "scope": ["markup.bold", "punctuation.definition.bold.markdown"],
            "settings": { "foreground": "#E07030", "fontStyle": "bold" }
        },
        {
            "name": "Markdown — italic",
            "scope": [
                "markup.italic",
                "punctuation.definition.italic.markdown"
            ],
            "settings": { "foreground": "#4A9FD4", "fontStyle": "italic" }
        },
        {
            "name": "Markdown — inline code",
            "scope": ["markup.inline.raw", "markup.fenced_code.block"],
            "settings": { "foreground": "#2AC890" }
        },
        {
            "name": "Markdown — links",
            "scope": ["markup.underline.link", "string.other.link"],
            "settings": { "foreground": "#2AC890", "fontStyle": "underline" }
        },
        {
            "name": "Markdown — list bullets",
            "scope": ["punctuation.definition.list.begin.markdown"],
            "settings": { "foreground": "#E07030" }
        },
        {
            "name": "Markdown — blockquote",
            "scope": [
                "markup.quote",
                "punctuation.definition.quote.begin.markdown"
            ],
            "settings": { "foreground": "#6A8A58", "fontStyle": "italic" }
        },
        {
            "name": "Invalid / Errors",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#F0EAD8", "background": "#E05040" }
        },
        {
            "name": "Deprecated",
            "scope": ["invalid.deprecated"],
            "settings": {
                "foreground": "#E05040",
                "fontStyle": "strikethrough"
            }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "namespace": "#4A9FD4",
        "namespace.declaration": {
            "foreground": "#4A9FD4",
            "fontStyle": "bold"
        },
        "class": { "foreground": "#4A9FD4", "fontStyle": "bold" },
        "class.declaration": { "foreground": "#4A9FD4", "fontStyle": "bold" },
        "struct": { "foreground": "#4A9FD4", "fontStyle": "bold" },
        "interface": { "foreground": "#4A9FD4", "fontStyle": "italic" },
        "enum": { "foreground": "#4A9FD4", "fontStyle": "bold" },
        "enumMember": "#E07060",
        "type": "#4A9FD4",
        "typeParameter": { "foreground": "#4A9FD4", "fontStyle": "italic" },
        "function": { "foreground": "#E07030", "fontStyle": "bold" },
        "function.declaration": {
            "foreground": "#E07030",
            "fontStyle": "bold"
        },
        "method": { "foreground": "#E07030", "fontStyle": "bold" },
