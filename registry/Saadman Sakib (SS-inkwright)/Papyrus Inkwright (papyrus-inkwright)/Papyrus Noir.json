d","scope":["markup.bold"],"settings":{"foreground":"#EDE2C6","fontStyle":"bold"}},{"name":"Markdown italic","scope":["markup.italic"],"settings":{"foreground":"#AAA088","fontStyle":"italic"}},{"name":"Markdown links","scope":["markup.underline.link","string.other.link"],"settings":{"foreground":"#3FC8AE"}},{"name":"Markdown code","scope":["markup.inline.raw","markup.fenced_code.block"],"settings":{"foreground":"#C9A86A"}},{"name":"Markdown blockquote","scope":["markup.quote"],"settings":{"foreground":"#7E7460","fontStyle":"italic"}},{"name":"Python self","scope":["variable.parameter.function.language.python"],"settings":{"foreground":"#FF8814","fontStyle":"italic"}},{"name":"Python builtins","scope":["support.function.builtin.python"],"settings":{"foreground":"#3FC8AE"}},{"name":"JSON keys","scope":["support.type.property-name.json"],"settings":{"foreground":"#3FC8AE"}},{"name":"YAML keys","scope":["entity.name.tag.yaml"],"settings":{"foreground":"#3FC8AE"}},{"name":"Invalid","scope":["invalid","invalid.illegal"],"settings":{"foreground":"#D26A55","fontStyle":"underline"}},{"name":"Deprecated","scope":["invalid.deprecated"],"settings":{"foreground":"#DDA065","fontStyle":"strikethrough"}}]}