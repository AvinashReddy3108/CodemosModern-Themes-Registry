        "editorStickyScroll.background": "#181410",
        "editorStickyScrollHover.background": "#0C0A06",
        "symbolIcon.classForeground": "#B5C078",
        "symbolIcon.functionForeground": "#80B89A",
        "symbolIcon.variableForeground": "#CFC4A8",
        "symbolIcon.constantForeground": "#DDA065",
        "symbolIcon.keywordForeground": "#D89060",
        "symbolIcon.stringForeground": "#D4B068",
        "symbolIcon.numberForeground": "#DDA065",
        "symbolIcon.propertyForeground": "#B59868"
    },
    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#6E644E", "fontStyle": "italic" }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.new",
                "keyword.operator.delete",
                "keyword.operator.typeof",
                "keyword.operator.void",
                "storage.modifier"
            ],
            "settings": { "foreground": "#D89060", "fontStyle": "bold" }
        },
        {
            "name": "Storage types",
            "scope": ["storage.type"],
            "settings": { "foreground": "#D89060" }
        },
        {
            "name": "Strings",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#D4B068" }
        },
        {
            "name": "String escape sequences",
            "scope": ["constant.character.escape", "string.regexp"],
            "settings": { "foreground": "#E4C078" }
        },
        {
            "name": "Template expression",
            "scope": [
                "punctuation.definition.template-expression",
                "punctuation.section.embedded"
            ],
            "settings": { "foreground": "#E4C078" }
        },
        {
            "name": "Numbers",
            "scope": ["constant.numeric", "constant.language.numeric"],
            "settings": { "foreground": "#DDA065" }
        },
        {
            "name": "Language constants",
            "scope": [
                "constant.language",
                "constant.language.boolean",
                "constant.language.null",
                "constant.language.undefined"
            ],
            "settings": { "foreground": "#DDA065", "fontStyle": "italic" }
        },
        {
            "name": "Constants",
            "scope": ["constant.other"],
            "settings": { "foreground": "#DDA065" }
        },
        {
            "name": "Functions / Methods",
            "scope": [
                "entity.name.function",
                "meta.function-call entity.name.function",
                "support.function",
                "meta.require"
            ],
            "settings": { "foreground": "#80B89A" }
        },
        {
            "name": "Decorators / Annotations",
            "scope": [
                "meta.decorator",
                "punctuation.decorator",
                "entity.name.function.decorator"
            ],
            "settings": { "foreground": "#D89060", "fontStyle": "italic" }
        },
        {
            "name": "Class names / Types",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.class",
                "entity.other.inherited-class"
            ],
            "settings": { "foreground": "#B5C078" }
        },
        {
            "name": "Interfaces",
            "scope": ["entity.name.type.interface"],
            "settings": { "foreground": "#B5C078", "fontStyle": "italic" }
        },
        {
            "name": "Type annotations",
            "scope": [
                "meta.type.annotation",
                "support.type",
                "entity.name.type.alias"
            ],
            "settings": { "foreground": "#B5C078" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "variable.other", "variable.other.readwrite"],
            "settings": { "foreground": "#CFC4A8" }
        },
        {
            "name": "Parameters",
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#AAA088", "fontStyle": "italic" }
        },
        {
            "name": "Object properties",
            "scope": [
                "variable.other.property",
                "support.variable.property",
                "meta.object-literal.key"
            ],
            "settings": { "foreground": "#B59868" }
        },
        {
            "name": "Self / This",
            "scope": [
                "variable.language.self",
                "variable.language.this",
                "variable.language.super"
            ],
            "settings": { "foreground": "#D89060", "fontStyle": "italic" }
        },
        {
            "name": "Import / Module names",
            "scope": [
                "entity.name.module",
                "entity.name.namespace",
                "variable.other.module"
            ],
            "settings": { "foreground": "#AAA088" }
        },
        {
            "name": "Operators",
            "scope": [
                "keyword.operator",
                "keyword.operator.arithmetic",
                "keyword.operator.comparison",
                "keyword.operator.logical",
                "keyword.operator.assignment"
            ],
            "settings": { "foreground": "#9A8F70" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation",
                "meta.brace",
                "punctuation.separator",
                "punctuation.terminator"
            ],
            "settings": { "foreground": "#7A7058" }
        },
        {
            "name": "HTML Tags",
            "scope": ["entity.name.tag", "meta.tag"],
            "settings": { "foreground": "#B5C078" }
        },
        {
            "name": "HTML Attributes",
            "scope": ["entity.other.attribute-name", "meta.tag.attributes"],
            "settings": { "foreground": "#D89060" }
        },
        {
            "name": "CSS Properties",
            "scope": [
                "support.type.property-name.css",
                "entity.name.tag.css",
                "support.constant.property-value.css"
            ],
            "settings": { "foreground": "#B59868" }
        },
        {
            "name": "CSS Selectors",
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css"
            ],
            "settings": { "foreground": "#B5C078" }
        },
        {
            "name": "CSS Values / Units",
            "scope": ["constant.numeric.css", "keyword.other.unit.css"],
            "settings": { "foreground": "#DDA065" }
        },
        {
            "name": "Markdown headings",
            "scope": ["markup.heading", "entity.name.section.markdown"],
            "settings": { "foreground": "#D89060", "fontStyle": "bold" }
        },
        {
            "name": "Markdown bold",
            "scope": ["markup.bold"],
            "settings": { "foreground": "#CFC4A8", "fontStyle": "bold" }
        },
        {
            "name": "Markdown italic",
            "scope": ["markup.italic"],
            "settings": { "foreground": "#AAA088", "fontStyle": "italic" }
        },
        {
            "name": "Markdown links",
            "scope": ["markup.underline.link", "string.other.link"],
            "settings": { "foreground": "#D89060" }
        },
        {
            "name": "Markdown code",
            "scope": ["markup.inline.raw", "markup.fenced_code.block"],
            "settings": { "foreground": "#D4B068" }
        },
        {
            "name": "Markdown blockquote",
            "scope": ["markup.quote"],
            "settings": { "foreground": "#7E7460", "fontStyle": "italic" }
        },
        {
            "name": "Python self",
            "scope": ["variable.parameter.function.language.python"],
            "settings": { "foreground": "#D89060", "fontStyle": "italic" }
        },
        {
            "name": "Python builtins",
            "scope": ["support.function.builtin.python"],
            "settings": { "foreground": "#80B89A" }
        },
        {
            "name": "JSON keys",
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#B59868" }
        },
        {
            "name": "YAML keys",
            "scope": ["entity.name.tag.yaml"],
            "settings": { "foreground": "#B59868" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#D26A55", "fontStyle": "underline" }
        },
        {
            "name": "Deprecated",
            "scope": ["invalid.deprecated"],
            "settings": {
                "foreground": "#D89060",
                "fontStyle": "strikethrough"
            }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
