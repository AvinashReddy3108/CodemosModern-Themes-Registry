        "editorStickyScroll.background": "#241C16",
        "editorStickyScrollHover.background": "#1F1814",
        "symbolIcon.classForeground": "#C8C078",
        "symbolIcon.functionForeground": "#9ACBA8",
        "symbolIcon.variableForeground": "#E8D8B5",
        "symbolIcon.constantForeground": "#E8B080",
        "symbolIcon.keywordForeground": "#E8A878",
        "symbolIcon.stringForeground": "#D4B878",
        "symbolIcon.numberForeground": "#E8B080",
        "symbolIcon.propertyForeground": "#C0A878"
    },
    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#7A6A52", "fontStyle": "italic" }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.new",
                "keyword.operator.delete",
                "keyword.operator.typeof",
                "keyword.operator.void",
                "storage.modifier"
            ],
            "settings": { "foreground": "#E8A878", "fontStyle": "bold" }
        },
        {
            "name": "Storage types",
            "scope": ["storage.type"],
            "settings": { "foreground": "#E8A878" }
        },
        {
            "name": "Strings",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#D4B878" }
        },
        {
            "name": "String escape sequences",
            "scope": ["constant.character.escape", "string.regexp"],
            "settings": { "foreground": "#E0C488" }
        },
        {
            "name": "Template expression",
            "scope": [
                "punctuation.definition.template-expression",
                "punctuation.section.embedded"
            ],
            "settings": { "foreground": "#E0C488" }
        },
        {
            "name": "Numbers",
            "scope": ["constant.numeric", "constant.language.numeric"],
            "settings": { "foreground": "#E8B080" }
        },
        {
            "name": "Language constants",
            "scope": [
                "constant.language",
                "constant.language.boolean",
                "constant.language.null",
                "constant.language.undefined"
            ],
            "settings": { "foreground": "#E8B080", "fontStyle": "italic" }
        },
        {
            "name": "Constants",
            "scope": ["constant.other"],
            "settings": { "foreground": "#E8B080" }
        },
        {
            "name": "Functions / Methods",
            "scope": [
                "entity.name.function",
                "meta.function-call entity.name.function",
                "support.function",
                "meta.require"
            ],
            "settings": { "foreground": "#9ACBA8" }
        },
        {
            "name": "Decorators / Annotations",
            "scope": [
                "meta.decorator",
                "punctuation.decorator",
                "entity.name.function.decorator"
            ],
            "settings": { "foreground": "#E8A878", "fontStyle": "italic" }
        },
        {
            "name": "Class names / Types",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.class",
                "entity.other.inherited-class"
            ],
            "settings": { "foreground": "#C8C078" }
        },
        {
            "name": "Interfaces",
            "scope": ["entity.name.type.interface"],
            "settings": { "foreground": "#C8C078", "fontStyle": "italic" }
        },
        {
            "name": "Type annotations",
            "scope": [
                "meta.type.annotation",
                "support.type",
                "entity.name.type.alias"
            ],
            "settings": { "foreground": "#C8C078" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "variable.other", "variable.other.readwrite"],
            "settings": { "foreground": "#E8D8B5" }
        },
        {
            "name": "Parameters",
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#C0AE88", "fontStyle": "italic" }
        },
        {
            "name": "Object properties",
            "scope": [
                "variable.other.property",
                "support.variable.property",
                "meta.object-literal.key"
            ],
            "settings": { "foreground": "#C0A878" }
        },
        {
            "name": "Self / This",
            "scope": [
                "variable.language.self",
                "variable.language.this",
                "variable.language.super"
            ],
            "settings": { "foreground": "#E8A878", "fontStyle": "italic" }
        },
        {
            "name": "Import / Module names",
            "scope": [
                "entity.name.module",
                "entity.name.namespace",
                "variable.other.module"
            ],
            "settings": { "foreground": "#C0AE88" }
        },
        {
            "name": "Operators",
            "scope": [
                "keyword.operator",
                "keyword.operator.arithmetic",
                "keyword.operator.comparison",
                "keyword.operator.logical",
                "keyword.operator.assignment"
            ],
            "settings": { "foreground": "#A89878" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation",
                "meta.brace",
                "punctuation.separator",
                "punctuation.terminator"
            ],
            "settings": { "foreground": "#897860" }
        },
        {
            "name": "HTML Tags",
            "scope": ["entity.name.tag", "meta.tag"],
            "settings": { "foreground": "#C8C078" }
        },
        {
            "name": "HTML Attributes",
            "scope": ["entity.other.attribute-name", "meta.tag.attributes"],
            "settings": { "foreground": "#E8A878" }
        },
        {
            "name": "CSS Properties",
            "scope": [
                "support.type.property-name.css",
                "entity.name.tag.css",
                "support.constant.property-value.css"
            ],
            "settings": { "foreground": "#C0A878" }
        },
        {
            "name": "CSS Selectors",
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css"
            ],
            "settings": { "foreground": "#C8C078" }
        },
        {
            "name": "CSS Values / Units",
            "scope": ["constant.numeric.css", "keyword.other.unit.css"],
            "settings": { "foreground": "#E8B080" }
        },
        {
            "name": "Markdown headings",
            "scope": ["markup.heading", "entity.name.section.markdown"],
            "settings": { "foreground": "#E8A878", "fontStyle": "bold" }
        },
        {
            "name": "Markdown bold",
            "scope": ["markup.bold"],
            "settings": { "foreground": "#E8D8B5", "fontStyle": "bold" }
        },
        {
            "name": "Markdown italic",
            "scope": ["markup.italic"],
            "settings": { "foreground": "#C0AE88", "fontStyle": "italic" }
        },
        {
            "name": "Markdown links",
            "scope": ["markup.underline.link", "string.other.link"],
            "settings": { "foreground": "#E8A878" }
        },
        {
            "name": "Markdown code",
            "scope": ["markup.inline.raw", "markup.fenced_code.block"],
            "settings": { "foreground": "#D4B878" }
        },
        {
            "name": "Markdown blockquote",
            "scope": ["markup.quote"],
            "settings": { "foreground": "#897860", "fontStyle": "italic" }
        },
        {
            "name": "Python self",
            "scope": ["variable.parameter.function.language.python"],
            "settings": { "foreground": "#E8A878", "fontStyle": "italic" }
        },
        {
            "name": "Python builtins",
            "scope": ["support.function.builtin.python"],
            "settings": { "foreground": "#9ACBA8" }
        },
        {
            "name": "JSON keys",
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#C0A878" }
        },
        {
            "name": "YAML keys",
            "scope": ["entity.name.tag.yaml"],
            "settings": { "foreground": "#C0A878" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#E08068", "fontStyle": "underline" }
        },
        {
            "name": "Deprecated",
            "scope": ["invalid.deprecated"],
            "settings": {
                "foreground": "#E8A878",
                "fontStyle": "strikethrough"
            }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
