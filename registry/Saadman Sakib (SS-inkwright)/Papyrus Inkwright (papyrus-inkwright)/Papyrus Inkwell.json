        "editorStickyScrollHover.background": "#F4EFDA",
        "symbolIcon.classForeground": "#3A2E1F",
        "symbolIcon.functionForeground": "#1F3A40",
        "symbolIcon.variableForeground": "#1F2428",
        "symbolIcon.constantForeground": "#5C3A1F",
        "symbolIcon.keywordForeground": "#1F2428",
        "symbolIcon.stringForeground": "#3D4A2E",
        "symbolIcon.numberForeground": "#5C3A1F",
        "symbolIcon.propertyForeground": "#1F2428"
    },
    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#9A9684", "fontStyle": "italic" }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.new",
                "keyword.operator.delete",
                "keyword.operator.typeof",
                "keyword.operator.void",
                "storage.modifier"
            ],
            "settings": { "foreground": "#1F2428", "fontStyle": "bold" }
        },
        {
            "name": "Storage types",
            "scope": ["storage.type"],
            "settings": { "foreground": "#1F2428" }
        },
        {
            "name": "Strings",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#3D4A2E" }
        },
        {
            "name": "String escape sequences",
            "scope": ["constant.character.escape", "string.regexp"],
            "settings": { "foreground": "#5C6A48" }
        },
        {
            "name": "Template expression",
            "scope": [
                "punctuation.definition.template-expression",
                "punctuation.section.embedded"
            ],
            "settings": { "foreground": "#5C6A48" }
        },
        {
            "name": "Numbers",
            "scope": ["constant.numeric", "constant.language.numeric"],
            "settings": { "foreground": "#5C3A1F" }
        },
        {
            "name": "Language constants",
            "scope": [
                "constant.language",
                "constant.language.boolean",
                "constant.language.null",
                "constant.language.undefined"
            ],
            "settings": { "foreground": "#5C3A1F", "fontStyle": "italic" }
        },
        {
            "name": "Constants",
            "scope": ["constant.other"],
            "settings": { "foreground": "#5C3A1F" }
        },
        {
            "name": "Functions / Methods",
            "scope": [
                "entity.name.function",
                "meta.function-call entity.name.function",
                "support.function",
                "meta.require"
            ],
            "settings": { "foreground": "#1F3A40" }
        },
        {
            "name": "Decorators / Annotations",
            "scope": [
                "meta.decorator",
                "punctuation.decorator",
                "entity.name.function.decorator"
            ],
            "settings": { "foreground": "#1F3A40", "fontStyle": "italic" }
        },
        {
            "name": "Class names / Types",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.class",
                "entity.other.inherited-class"
            ],
            "settings": { "foreground": "#3A2E1F" }
        },
        {
            "name": "Interfaces",
            "scope": ["entity.name.type.interface"],
            "settings": { "foreground": "#3A2E1F", "fontStyle": "italic" }
        },
        {
            "name": "Type annotations",
            "scope": [
                "meta.type.annotation",
                "support.type",
                "entity.name.type.alias"
            ],
            "settings": { "foreground": "#3A2E1F" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "variable.other", "variable.other.readwrite"],
            "settings": { "foreground": "#1F2428" }
        },
        {
            "name": "Parameters",
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#3A4148", "fontStyle": "italic" }
        },
        {
            "name": "Object properties",
            "scope": [
                "variable.other.property",
                "support.variable.property",
                "meta.object-literal.key"
            ],
            "settings": { "foreground": "#1F2428" }
        },
        {
            "name": "Self / This",
            "scope": [
                "variable.language.self",
                "variable.language.this",
                "variable.language.super"
            ],
            "settings": { "foreground": "#5C3A1F", "fontStyle": "italic" }
        },
        {
            "name": "Import / Module names",
            "scope": [
                "entity.name.module",
                "entity.name.namespace",
                "variable.other.module"
            ],
            "settings": { "foreground": "#3A4148" }
        },
        {
            "name": "Operators",
            "scope": [
                "keyword.operator",
                "keyword.operator.arithmetic",
                "keyword.operator.comparison",
                "keyword.operator.logical",
                "keyword.operator.assignment"
            ],
            "settings": { "foreground": "#454A45" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation",
                "meta.brace",
                "punctuation.separator",
                "punctuation.terminator"
            ],
            "settings": { "foreground": "#7C7868" }
        },
        {
            "name": "HTML Tags",
            "scope": ["entity.name.tag", "meta.tag"],
            "settings": { "foreground": "#3A2E1F" }
        },
        {
            "name": "HTML Attributes",
            "scope": ["entity.other.attribute-name", "meta.tag.attributes"],
            "settings": { "foreground": "#1F3A40" }
        },
        {
            "name": "CSS Properties",
            "scope": [
                "support.type.property-name.css",
                "entity.name.tag.css",
                "support.constant.property-value.css"
            ],
            "settings": { "foreground": "#1F2428" }
        },
        {
            "name": "CSS Selectors",
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css"
            ],
            "settings": { "foreground": "#3A2E1F" }
        },
        {
            "name": "CSS Values / Units",
            "scope": ["constant.numeric.css", "keyword.other.unit.css"],
            "settings": { "foreground": "#5C3A1F" }
        },
        {
            "name": "Markdown headings",
            "scope": ["markup.heading", "entity.name.section.markdown"],
            "settings": { "foreground": "#1F2428", "fontStyle": "bold" }
        },
        {
            "name": "Markdown bold",
            "scope": ["markup.bold"],
            "settings": { "foreground": "#1F2428", "fontStyle": "bold" }
        },
        {
            "name": "Markdown italic",
            "scope": ["markup.italic"],
            "settings": { "foreground": "#3A4148", "fontStyle": "italic" }
        },
        {
            "name": "Markdown links",
            "scope": ["markup.underline.link", "string.other.link"],
            "settings": { "foreground": "#5C3A1F" }
        },
        {
            "name": "Markdown code",
            "scope": ["markup.inline.raw", "markup.fenced_code.block"],
            "settings": { "foreground": "#3D4A2E" }
        },
        {
            "name": "Markdown blockquote",
            "scope": ["markup.quote"],
            "settings": { "foreground": "#6E6F62", "fontStyle": "italic" }
        },
        {
            "name": "Python self",
            "scope": ["variable.parameter.function.language.python"],
            "settings": { "foreground": "#5C3A1F", "fontStyle": "italic" }
        },
        {
            "name": "Python builtins",
            "scope": ["support.function.builtin.python"],
            "settings": { "foreground": "#1F3A40" }
        },
        {
            "name": "JSON keys",
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#1F2428" }
        },
        {
            "name": "YAML keys",
            "scope": ["entity.name.tag.yaml"],
            "settings": { "foreground": "#1F2428" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#7A2E1F", "fontStyle": "underline" }
        },
        {
            "name": "Deprecated",
            "scope": ["invalid.deprecated"],
            "settings": {
                "foreground": "#8A5818",
                "fontStyle": "strikethrough"
            }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
