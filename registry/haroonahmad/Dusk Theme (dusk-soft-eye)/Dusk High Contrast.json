    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#9E9185", "fontStyle": "italic" }
        },
        {
            "name": "Doc Comments",
            "scope": [
                "comment.block.documentation",
                "comment.line.documentation"
            ],
            "settings": { "foreground": "#AEA090", "fontStyle": "italic" }
        },
        {
            "name": "Doc comment tags",
            "scope": [
                "storage.type.class.jsdoc",
                "punctuation.definition.block.tag.jsdoc",
                "entity.name.type.instance.jsdoc"
            ],
            "settings": { "foreground": "#BEB890", "fontStyle": "italic" }
        },
        {
            "name": "Strings — all",
            "scope": [
                "string",
                "string.quoted",
                "string.quoted.single",
                "string.quoted.double",
                "string.quoted.triple",
                "string.other"
            ],
            "settings": { "foreground": "#FFC870" }
        },
        {
            "name": "Template literals",
            "scope": ["string.template", "string.interpolated"],
            "settings": { "foreground": "#FFD880" }
        },
        {
            "name": "Template literal expressions",
            "scope": [
                "meta.template.expression",
                "punctuation.definition.template-expression"
            ],
            "settings": { "foreground": "#FFF8F0" }
        },
        {
            "name": "Regex literals",
            "scope": ["string.regexp", "constant.regexp"],
            "settings": { "foreground": "#FFE870" }
        },
        {
            "name": "Regex groups and quantifiers",
            "scope": [
                "punctuation.definition.group.regexp",
                "keyword.operator.quantifier.regexp",
                "keyword.operator.or.regexp"
            ],
            "settings": { "foreground": "#F0D050" }
        },
        {
            "name": "Escape sequences",
            "scope": "constant.character.escape",
            "settings": { "foreground": "#FFD060" }
        },
        {
            "name": "String punctuation (quotes)",
            "scope": "punctuation.definition.string",
            "settings": { "foreground": "#E8A850" }
        },
        {
