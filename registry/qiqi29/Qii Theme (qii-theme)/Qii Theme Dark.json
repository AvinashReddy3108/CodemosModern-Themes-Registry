{
    "name": "Qii Theme Dark",
    "type": "dark",
    "colors": {
        "foreground": "#CACBD4",
        "disabledForeground": "#61646E",
        "focusBorder": "#65BD9CA0",
        "icon.foreground": "#F0F6FFA0",
        "editor.background": "#18191B",
        "editorGroup.emptyBackground": "#18191B",
        "editor.foreground": "#CACBD4",
        "editorGroup.border": "#101011",
        "editorGroup.dropBackground": "#cddeff15",
        "editorCursor.foreground": "#65BD9C",
        "editorWhitespace.foreground": "#376e5f",
        "editorIndentGuide.background1": "#FFFFFF0C",
        "editorLineNumber.foreground": "#57585c",
        "editorLineNumber.activeForeground": "#CACBD4",
        "editor.selectionBackground": "#23483c",
        "editor.lineHighlightBackground": "#27282D",
        "editor.selectionHighlightBackground": "#FFFFFF15",
        "editor.selectionHighlightBorder": "#FFFFFF80",
        "editor.wordHighlightTextBackground": "#FFFFFF15",
        "editor.hoverHighlightBackground": "#36484580",
        "editor.wordHighlightBackground": "#FFFFFF20",
        "editor.wordHighlightBorder": "#FFFFFF80",
        "editorHoverWidget.background": "#090909",
        "editorHoverWidget.border": "#363739",
        "editorWidget.background": "#202125",
        "editorSuggestWidget.background": "#202125",
        "editor.foldBackground": "#27282D80",
        "sash.hoverBorder": "#65BD9CF0",
        "titleBar.activeBackground": "#090909",
        "titleBar.activeForeground": "#CACBD4",
        "titleBar.inactiveBackground": "#090909",
        "titleBar.inactiveForeground": "#6E6F72",
        "titleBar.border": "#090909",
        "editorGroupHeader.tabsBackground": "#18191B",
        "editorGroupHeader.tabsBorder": "#18191B",
        "tab.hoverBackground": "#28292B",
        "tab.inactiveBackground": "#FFFFFF00",
        "tab.activeBackground": "#0f261d",
        "tab.border": "#FFFFFF00",
        "tab.activeBorder": "#65BD9CA0",
        "list.activeSelectionBackground": "#9c9fc01A",
        "list.inactiveSelectionBackground": "#9c9fc01A",
        "list.activeSelectionForeground": "#FFFFFF",
        "list.inactiveSelectionForeground": "#FFFFFF",
        "list.dropBackground": "#9c9fc01A",
        "list.focusBackground": "#9c9fc01A",
        "list.focusForeground": "#FFFFFF",
        "list.focusOutline": "#65BD9CA0",
        "list.hoverBackground": "#9c9fc020",
        "list.hoverForeground": "#FFFFFF",
        "list.highlightForeground": "#FFFFFF",
        "tree.indentGuidesStroke": "#FFFFFF00",
        "activityBar.background": "#090909",
        "activityBar.activeBackground": "#090909",
        "activityBar.foreground": "#E0E1E4",
        "activityBar.inactiveForeground": "#6b6b6d",
        "activityBar.border": "#090909",
        "activityBar.activeBorder": "#65BD9C",
        "activityBarBadge.background": "#65BD9C",
        "activityBarBadge.foreground": "#050505",
        "sideBar.background": "#141516",
        "sideBar.border": "#090909",
        "sideBarSectionHeader.background": "#18191B",
        "menu.background": "#202125",
        "menu.foreground": "#CACBD4",
        "menu.border": "#2f3136",
        "menu.selectionBackground": "#65BD9C",
        "menu.selectionForeground": "#000000",
        "menu.separatorBackground": "#2f3136",
        "statusBar.background": "#090909",
        "statusBar.foreground": "#9da1ab",
        "statusBar.border": "#090909",
        "statusBar.debuggingBackground": "#65BD9C",
        "statusBar.debuggingForeground": "#050505",
        "statusBar.noFolderBackground": "#090909",
        "statusBar.noFolderForeground": "#CACBD4",
        "panel.background": "#141516",
        "panel.border": "#090909",
        "badge.background": "#090909",
        "badge.foreground": "#FFFFFF",
        "dropdown.background": "#202125",
        "dropdown.foreground": "#CACBD4",
        "dropdown.border": "#2f3136",
        "scrollbarSlider.background": "#E0E4FF20",
        "scrollbarSlider.hoverBackground": "#E0E4FF20",
        "scrollbarSlider.activeBackground": "#E0E4FF30",
        "editorOverviewRuler.border": "#18191B",
        "scrollbar.shadow": "#101011c2",
        "minimap.background": "#18191BEF",
        "minimapSlider.background": "#E0E4FF20",
        "minimapSlider.hoverBackground": "#E0E4FF20",
        "minimapSlider.activeBackground": "#E0E4FF30",
        "minimap.findMatchHighlight": "#3da27df0",
        "minimap.selectionHighlight": "#3da27dA0",
        "button.background": "#65BD9C",
        "button.hoverBackground": "#5bae8f",
        "button.border": "#64caa5",
        "button.foreground": "#000000",
        "input.background": "#1c1d20",
        "input.foreground": "#D7D8E2",
        "input.border": "#8490aa30",
        "terminal.foreground": "#CACBD4",
        "terminal.ansiBlack": "#2d3139",
        "terminal.ansiBlue": "#82b8fa",
        "terminal.ansiGreen": "#a7e28b",
        "terminal.ansiYellow": "#e2b77e",
        "terminal.ansiCyan": "#75cad3",
        "terminal.ansiMagenta": "#c589e0",
        "terminal.ansiRed": "#E68096",
        "terminal.ansiWhite": "#CACBD4",
        "terminal.ansiBrightBlack": "#7f848e",
        "terminal.ansiBrightBlue": "#82b8fa",
        "terminal.ansiBrightGreen": "#a7e28b",
        "terminal.ansiBrightYellow": "#e2b77e",
        "terminal.ansiBrightCyan": "#75cad3",
        "terminal.ansiBrightMagenta": "#c589e0",
        "terminal.ansiBrightRed": "#E68096",
        "terminal.ansiBrightWhite": "#CACBD4",
        "editorBracketHighlight.foreground1": "#9cceec",
        "editorBracketHighlight.foreground2": "#ecbb96",
        "editorBracketHighlight.foreground3": "#bbe097",
        "editorBracketHighlight.foreground4": "#89d9d4",
        "editorBracketHighlight.foreground5": "#e9d281",
        "editorBracketHighlight.foreground6": "#e1aafa",
        "editorInfo.foreground": "#83c5ff",
        "editorError.foreground": "#ff7e7e",
        "editorWarning.foreground": "#f0d46e"
    },
    "tokenColors": [
        {
            "name": "注释 / 注释符号",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#6d707a" }
        },
        {
            "name": "字符串 / 模板字符串",
            "scope": ["string", "string.quoted"],
            "settings": { "foreground": "#B0D69E" }
        },
        {
            "name": "数字",
            "scope": "constant.numeric",
            "settings": { "foreground": "#76C4C4" }
        },
        {
            "name": "数学符号 / Math",
            "scope": "support.constant.math",
            "settings": { "foreground": "#76C4C4" }
        },
        {
            "name": "类型 / const let function class",
            "scope": "storage.type",
            "settings": { "foreground": "#76C4C4" }
        },
        {
            "name": "内置常数 / true false null..",
            "scope": "constant.language",
            "settings": { "foreground": "#76C4C4" }
        },
        {
            "name": "关键词 / if for return import export try await",
            "scope": ["keyword", "keyword.operator.constructor"],
            "settings": { "foreground": "#E394DC" }
        },
        {
            "name": "扩展 / async extends",
            "scope": "storage",
            "settings": { "foreground": "#E394DC" }
        },
        {
            "name": "与或非 / && || !",
            "scope": ["keyword.operator.logical"],
            "settings": { "foreground": "#E68096" }
        },
        {
            "name": "语言变量 / this super",
            "scope": "variable.language",
            "settings": { "foreground": "#E68096" }
        },
        {
            "name": "运算符 / + - * == typeof new",
            "scope": "keyword.operator",
            "settings": { "foreground": "#E68096" }
        },
        {
            "name": "类 名称 / Class",
            "scope": ["entity.name.type"],
            "settings": { "foreground": "#E6C28D" }
        },
        {
            "name": "继承的类",
            "scope": "entity.other.inherited-class",
            "settings": { "foreground": "#E6C28D" }
        },
        {
            "name": "内置类名 / Promise Object",
            "scope": [
                "entity.name.class",
                "entity.name.module",
                "storage.identifier",
                "support.class",
                "meta.function-call.arguments.python"
            ],
            "settings": { "foreground": "#E6C28D" }
        },
        {
            "name": "定义常量",
            "scope": ["variable.other.constant"],
            "settings": { "foreground": "#82b8fa" }
        },
        {
            "name": "调用常量",
            "scope": [
                "variable.other.object",
                "variable.other.global",
                "variable.other.readwrite.class",
                "variable.other.readwrite.instance",
                "variable.other.readwrite.batchfile",
                "variable.readwrite",
                "variable.readwrite.other.block"
            ],
            "settings": { "foreground": "#CACBD4" }
        },
        {
            "name": "其他变量",
            "scope": ["variable.other"],
            "settings": { "foreground": "#CACBD4" }
        },
        {
            "name": "其他变量",
            "scope": [
                "variable.other.property",
                "variable.other.block",
                "meta.function-call.python"
            ],
            "settings": { "foreground": "#82b8fa" }
        },
        {
            "name": "其他变量",
            "scope": [
                "variable.other.object.property",
                "meta.attribute.python"
            ],
            "settings": { "foreground": "#CACBD4" }
        },
        {
            "name": "用户定义常量 / CSS颜色 正则",
            "scope": ["constant.character", "constant.other"],
            "settings": { "foreground": "#76C4C4" }
        },
        {
            "name": "转义字符 / \n \t",
            "scope": ["constant.character.escape"],
            "settings": { "foreground": "#82b8fa" }
        },
        {
            "name": "正则表达式",
            "scope": ["string.regexp"],
            "settings": { "foreground": "#B2DC9F" }
        },
        {
            "name": "正则表达式匹配符 / i g",
            "scope": ["string.regexp keyword.other"],
            "settings": { "foreground": "#E68096" }
        },
        {
            "name": "模板字符串符号 / ${..}",
            "scope": [
                "string.embedded.begin",
                "string.embedded.end",
                "punctuation.definition.template-expression",
                "punctuation.section.embedded"
            ],
            "settings": { "foreground": "#76C4C4" }
        },
        {
            "name": "嵌入式代码符号 / . ? :",
            "scope": [
                "punctuation.section.embedded.begin.js",
                "punctuation.section.embedded.end.js",
                "punctuation.section.embedded.begin.erb",
                "punctuation.section.embedded.end.erb",
                "source.elixir.embedded",
                "punctuation.separator",
                "punctuation.accessor",
                "meta.brace"
            ],
            "settings": { "foreground": "#989CA6" }
        },
        {
            "name": "包导入 java",
            "scope": ["storage.modifier.import", "storage.modifier.package"],
            "settings": { "foreground": "#82b8fa" }
        },
        {
            "name": "内置函数",
            "scope": ["function.support.builtin", "function.support.core"],
            "settings": { "foreground": "#82b8fa" }
        },
        {
            "name": "函数名 / CSS函数",
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#e6c28d" }
        },
        {
            "name": "函数参数",
            "scope": [
                "variable.parameter",
                "entity.name.variable.parameter",
                "parameter.variable"
            ],
            "settings": { "foreground": "#CACBD4", "fontStyle": "italic" }
        },
        {
            "name": "对象键",
            "scope": ["meta.tag"],
            "settings": { "foreground": "#CACBD4" }
        },
        {
            "name": "对象字面量键",
            "scope": [
                "meta.object-literal.key.js",
                "meta.object-literal.key.ts"
            ],
            "settings": { "foreground": "#CACBD4" }
        },
        {
            "name": "html 标签名称",
            "scope": ["entity.name.tag", "entity.name.tag.class.js"],
            "settings": { "foreground": "#7cbcf4", "fontStyle": "bold" }
        },
        {
            "name": "html 标签属性 / CSS 选择器",
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#bda3ff" }
        },
        {
            "name": "HTML 标签括号",
            "scope": ["punctuation.definition.tag"],
            "settings": { "foreground": "#989CA6" }
        },
        {
            "name": "CSS属性名称",
            "scope": [
                "support.type.property-name.css",
                "support.type.property-name.scss",
                "support.type.property-name.less",
                "support.type.property-name.sass"
            ],
            "settings": { "foreground": "#CACBD4" }
        },
        {
            "name": "CSS伪属性名称",
            "scope": [
                "entity.other.attribute-name.pseudo-class.css",
                "entity.other.attribute-name.pseudo-class.scss",
                "entity.other.attribute-name.pseudo-class.less",
                "entity.other.attribute-name.pseudo-class.sass",
                "entity.other.attribute-name.pseudo-element.css",
                "entity.other.attribute-name.pseudo-element.scss",
                "entity.other.attribute-name.pseudo-element.less",
                "entity.other.attribute-name.pseudo-element.sass"
            ],
            "settings": { "foreground": "#76C4C4" }
        },
        {
            "name": "CSS属性值",
            "scope": [
                "support.constant.css",
                "support.constant.scss",
                "support.constant.less",
                "support.constant.sass"
            ],
            "settings": { "foreground": "#B0D69E" }
        },
        {
            "name": "CSS变量",
            "scope": [
                "variable.css",
                "variable.scss",
                "variable.less",
                "variable.sass"
            ],
            "settings": { "foreground": "#B0D69E" }
        },
        {
            "name": "CSS变量字符串",
            "scope": [
                "variable.css.string",
                "variable.scss.string",
                "variable.less.string",
                "variable.sass.string"
            ],
            "settings": { "foreground": "#E0B16A" }
        },
        {
            "name": "CSS数值单位 / rpx",
            "scope": ["meta.property-value.css"],
            "settings": { "foreground": "#E394DC" }
        },
        {
            "name": "JSON 键",
            "scope": "support.type.property-name.json",
            "settings": { "foreground": "#82b8fa" }
        },
        {
            "name": "库常数 JSON",
            "scope": "support.constant",
            "settings": { "foreground": "#82b8fa" }
        },
        {
            "name": "库 类/类型",
            "scope": ["support.type", "support.variable"],
            "settings": { "foreground": "#82b8fa" }
        },
        {
            "name": "Json 字段",
            "scope": "support.dictionary.json",
            "settings": { "foreground": "#82b8fa" }
        },
        {
            "name": "库变量",
            "scope": "support.other.variable",
            "settings": { "fontStyle": "" }
        },
        {
            "name": "无效",
            "scope": "invalid",
            "settings": { "foreground": "#CACBD4" }
        },
        {
            "name": "无效已弃用",
            "scope": "invalid.deprecated",
            "settings": { "foreground": "#CACBD4" }
        },
        {
            "name": "链接",
            "scope": "string.detected-link",
            "settings": { "foreground": "#82b8fa" }
        },
        {
            "name": "差异: 标题",
            "scope": ["meta.diff", "meta.diff.header"],
            "settings": { "foreground": "#82b8fa" }
        },
        {
            "name": "差异: 删除",
            "scope": "markup.deleted",
            "settings": { "foreground": "#E68096" }
        },
        {
            "name": "差异: 插入",
            "scope": "markup.inserted",
            "settings": { "foreground": "#B0D69E" }
        },
        {
            "name": "差异: 变化",
            "scope": "markup.changed",
            "settings": { "foreground": "#E0B16A" }
        },
        {
            "name": "Markdown: 标点符号 / #",
            "scope": [
                "punctuation.definition.italic.markdown",
                "punctuation.definition.bold.markdown",
                "punctuation.definition.heading.markdown"
            ],
            "settings": { "foreground": "#676f7d" }
        },
        {
            "name": "Markdown: 强调标点符号",
            "scope": "punctuation.definition.italic.markdown",
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "Markdown: 链接",
            "scope": "markup.underline.link.markdown",
            "settings": { "foreground": "#82b8fa" }
        },
        {
            "name": "Markdown: 加粗",
            "scope": "markup.bold.markdown",
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Markdown: 标题",
            "scope": "markup.heading.markdown",
            "settings": { "fontStyle": "bold", "foreground": "#82b8fa" }
        },
        {
            "name": "Markdown: 引用",
            "scope": "markup.quote.markdown",
            "settings": { "foreground": "#9d9fa5" }
        },
        {
            "name": "Markdown: 分隔符",
            "scope": "meta.separator.markdown",
            "settings": { "foreground": "#E68096", "fontStyle": "bold" }
        },
        {
            "name": "Markdown: 富文本",
            "scope": [
                "markup.raw.inline.markdown",
                "markup.raw.block.markdown"
            ],
            "settings": { "foreground": "#76C4C4" }
        },
        {
            "name": "Markdown: 列表标点符号",
            "scope": "punctuation.definition.list_item.markdown",
            "settings": { "fontStyle": "bold", "foreground": "#82b8fa" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
