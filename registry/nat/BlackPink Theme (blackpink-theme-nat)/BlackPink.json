        "breadcrumbPicker.background": "#232530",
        "button.background": "#614d85",
        "debugToolBar.background": "#463465",
        "diffEditor.insertedTextBackground": "#c60beb35",
        "diffEditor.removedTextBackground": "#fe449e35",
        "dropdown.background": "#232530",
