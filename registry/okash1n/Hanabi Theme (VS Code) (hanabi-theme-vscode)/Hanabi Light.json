    "tokenColors": [
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#5F6D8C", "fontStyle": "italic" }
        },
        {
            "scope": ["string", "string.quoted"],
            "settings": { "foreground": "#2E8A52" }
        },
        {
            "scope": ["constant.numeric", "constant.language.boolean"],
            "settings": { "foreground": "#A35D00" }
        },
        {
            "scope": ["keyword", "keyword.control", "storage"],
            "settings": { "foreground": "#B73A78" }
        },
        {
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call"
            ],
            "settings": { "foreground": "#007E8A" }
        },
        {
            "scope": ["variable", "variable.parameter"],
            "settings": { "foreground": "#1C2233" }
        },
        {
            "scope": ["entity.name.type", "support.type", "storage.type"],
            "settings": { "foreground": "#345FC7" }
        },
        {
            "scope": ["entity.name.class", "entity.other.inherited-class"],
            "settings": { "foreground": "#5E84DD" }
        },
        {
            "scope": ["constant", "support.constant"],
            "settings": { "foreground": "#8E7300" }
        },
        {
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#1F2537", "background": "#BF3D58" }
        },
        {
            "scope": ["markup.heading", "entity.name.section"],
            "settings": { "foreground": "#977200", "fontStyle": "bold" }
        },
        { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
        { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
        {
            "scope": ["markup.inline.raw", "markup.raw.inline"],
            "settings": { "foreground": "#4EA7B0", "background": "#D9DFF6" }
        },
        {
            "scope": ["markup.deleted"],
            "settings": { "foreground": "#C44A65" }
        },
        {
            "scope": ["markup.inserted"],
            "settings": { "foreground": "#3D925A" }
        },
        {
            "scope": ["markup.changed"],
            "settings": { "foreground": "#977200" }
        },
        {
            "scope": ["meta.diff.header"],
            "settings": { "foreground": "#345FC7" }
        },
        {
            "scope": ["punctuation", "meta.brace", "meta.delimiter"],
            "settings": { "foreground": "#5F6D8C" }
        },
        {
            "scope": [
                "text.html.basic entity.other.attribute-name",
                "entity.other.attribute-name"
            ],
            "settings": { "foreground": "#C06B99" }
        }
    ],
    "semanticTokenColors": {
        "comment": "#5F6D8C",
        "string": "#2E8A52",
        "number": "#A35D00",
        "keyword": "#B73A78",
        "function": "#007E8A",
        "variable": "#1C2233",
        "type": "#345FC7",
        "class": "#5E84DD",
        "property": "#4EA7B0",
        "enumMember": "#8E7300",
        "operator": "#5F6D8C",
        "namespace": "#C06B99"
    },
    "$schema": "vscode://schemas/color-theme"
}
