    "tokenColors": [
        { "scope": "comment", "settings": { "foreground": "#b8b8b8" } },
        {
            "scope": ["constant", "variable.other.constant"],
            "settings": { "foreground": "#E84A5F" }
        },
        {
            "scope": "constant.character.escape",
            "settings": { "foreground": "#2b6460b6" }
        },
        {
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#E84A5F" }
        },
        { "scope": "entity.name.tag", "settings": { "foreground": "#00A3A3" } },
        {
            "scope": ["entity.name.type", "support.type"],
            "settings": { "foreground": "#E84A5F" }
        },
        {
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#007A4D" }
        },
        {
            "scope": "entity.other.attribute-name.class",
            "settings": { "foreground": "#E84A5F" }
        },
        {
            "scope": "entity.other.attribute-name.id",
            "settings": { "foreground": "#FF6B6B" }
        },
        { "scope": "keyword", "settings": { "foreground": "#FF6B6B" } },
        { "scope": "keyword.control", "settings": { "foreground": "#C1666B" } },
        {
            "scope": "keyword.operator",
            "settings": { "foreground": "#2b4d61d9" }
        },
        {
            "scope": "markup.bold",
            "settings": { "foreground": "#E84A5F", "fontStyle": "bold" }
        },
        {
            "scope": "markup.italic",
            "settings": { "foreground": "#FF8C42", "fontStyle": "italic" }
        },
        {
            "scope": ["markup.inline.raw", "markup.fenced_code.block.markdown"],
            "settings": { "foreground": "#FF4500" }
        },
        {
            "scope": "markup.heading",
            "settings": { "foreground": "#FF1493", "fontStyle": "bold" }
        },
        { "scope": "markup.quote", "settings": { "foreground": "#FF6B6B" } },
        { "scope": "markup.list", "settings": { "foreground": "#E84A5F" } },
        { "scope": "markup.link", "settings": { "foreground": "#008B8B" } },
        {
            "scope": [
                "punctuation.definition.string",
                "punctuation.definition.tag"
            ],
            "settings": { "foreground": "#2b2e2cd9" }
        },
        { "scope": "storage", "settings": { "foreground": "#E84A5F" } },
        { "scope": "string", "settings": { "foreground": "#FF6B6B" } },
        { "scope": "support", "settings": { "foreground": "#2b2b2bd9" } },
        { "scope": "variable", "settings": { "foreground": "#009688" } },
        {
            "scope": "variable.parameter",
            "settings": { "foreground": "#007A7A" }
        },
        {
            "scope": "support.constant",
            "settings": { "foreground": "#007A7A" }
        },
        {
            "scope": "constant.numeric",
            "settings": { "foreground": "#FF8C42" }
        },
        {
            "scope": "keyword.other.unit",
            "settings": { "foreground": "#E84A5F" }
        },
        {
            "scope": "punctuation.definition.entity",
            "settings": { "foreground": "#2b2e2cd9" }
        },
        {
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#007A4D" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
