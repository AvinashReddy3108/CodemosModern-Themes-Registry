    "tokenColors": [
        {
            "name": "Comentarios",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#6a9955", "fontStyle": "italic" }
        },
        {
            "name": "Comentarios de documentación",
            "scope": "comment.block.documentation",
            "settings": { "foreground": "#6a9955", "fontStyle": "italic" }
        },
        {
            "name": "Strings",
            "scope": [
                "string",
                "string.quoted.single",
                "string.quoted.double",
                "string.template"
            ],
            "settings": { "foreground": "#ce9178" }
        },
        {
            "name": "Regex",
            "scope": ["string.regexp", "constant.regexp"],
            "settings": { "foreground": "#d16969" }
        },
        {
            "name": "Caracteres de escape",
            "scope": "constant.character.escape",
            "settings": { "foreground": "#d7ba7d" }
        },
        {
            "name": "Números",
            "scope": "constant.numeric",
            "settings": { "foreground": "#b5cea8" }
        },
        {
            "name": "Constantes del lenguaje (true, false, null)",
            "scope": "constant.language",
            "settings": { "foreground": "#4fc1ff" }
        },
        {
            "name": "Keywords (var, let, const, function, class)",
            "scope": ["keyword", "storage", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#569cd6" }
        },
        {
            "name": "Control flow (if, else, return, import, export)",
            "scope": [
                "keyword.control",
                "keyword.control.import",
                "keyword.control.export",
                "keyword.control.from",
                "keyword.control.flow",
                "keyword.control.conditional",
                "keyword.control.loop"
            ],
            "settings": { "foreground": "#c586c0" }
        },
        {
            "name": "Operador new",
            "scope": "keyword.operator.new",
            "settings": { "foreground": "#569cd6" }
        },
        {
            "name": "Operadores de expresión (typeof, instanceof)",
            "scope": "keyword.operator.expression",
            "settings": { "foreground": "#569cd6" }
        },
        {
            "name": "Unidades (px, em, rem, %)",
            "scope": "keyword.other.unit",
            "settings": { "foreground": "#b5cea8" }
        },
        {
            "name": "Nombres de función (declaración y llamada)",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call entity.name.function"
            ],
            "settings": { "foreground": "#dcdcaa" }
        },
        {
            "name": "Variables y parámetros",
            "scope": [
                "variable",
                "variable.parameter",
                "variable.other.readwrite"
            ],
            "settings": { "foreground": "#9cdcfe" }
        },
        {
            "name": "Variables del lenguaje (this, self, super)",
            "scope": "variable.language",
            "settings": { "foreground": "#569cd6", "fontStyle": "italic" }
        },
        {
            "name": "Constantes (UPPER_CASE)",
            "scope": "variable.other.constant",
            "settings": { "foreground": "#4fc1ff" }
        },
        {
            "name": "Propiedades de objeto",
            "scope": [
                "variable.other.property",
                "support.variable.property",
                "variable.other.object.property"
            ],
            "settings": { "foreground": "#9cdcfe" }
        },
        {
            "name": "Tipos, clases e interfaces",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.class",
                "support.type",
                "entity.other.inherited-class"
            ],
            "settings": { "foreground": "#4ec9b0" }
        },
        {
            "name": "Type parameters (<T>)",
            "scope": "entity.name.type.parameter",
            "settings": { "foreground": "#4ec9b0", "fontStyle": "italic" }
        },
        {
            "name": "Tags HTML/XML/JSX",
            "scope": [
                "entity.name.tag",
                "punctuation.definition.tag",
                "punctuation.definition.tag.begin",
                "punctuation.definition.tag.end"
            ],
            "settings": { "foreground": "#569cd6" }
        },
        {
            "name": "Atributos HTML/XML",
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#9cdcfe" }
        },
        {
            "name": "Operadores",
            "scope": ["keyword.operator", "keyword.operator.assignment"],
            "settings": { "foreground": "#d4d4d4" }
        },
        {
            "name": "Puntuación",
            "scope": [
                "punctuation",
                "punctuation.separator",
                "punctuation.terminator",
                "meta.brace"
            ],
            "settings": { "foreground": "#808080" }
        },
        {
            "name": "Template literals ${}",
            "scope": [
                "punctuation.definition.template-expression.begin",
                "punctuation.definition.template-expression.end"
            ],
            "settings": { "foreground": "#c586c0" }
        },
        {
            "name": "Decoradores (@)",
            "scope": [
                "meta.decorator",
                "meta.decorator entity.name.function",
                "punctuation.decorator"
            ],
            "settings": { "foreground": "#dcdcaa", "fontStyle": "italic" }
        },
        {
            "name": "CSS property names",
            "scope": "support.type.property-name.css",
            "settings": { "foreground": "#9cdcfe" }
        },
        {
            "name": "CSS property values",
            "scope": "support.constant.property-value.css",
            "settings": { "foreground": "#4fc1ff" }
        },
        {
            "name": "CSS selectores de clase",
            "scope": "entity.other.attribute-name.class.css",
            "settings": { "foreground": "#4ec9b0" }
        },
        {
            "name": "CSS selectores de ID",
            "scope": "entity.other.attribute-name.id.css",
            "settings": { "foreground": "#dcdcaa" }
        },
        {
            "name": "CSS pseudo-clases y pseudo-elementos",
            "scope": [
                "entity.other.attribute-name.pseudo-class.css",
                "entity.other.attribute-name.pseudo-element.css"
            ],
            "settings": { "foreground": "#c586c0" }
        },
        {
            "name": "CSS variables",
            "scope": "variable.css",
            "settings": { "foreground": "#9cdcfe" }
        },
        {
            "name": "JSON keys",
            "scope": "support.type.property-name.json",
            "settings": { "foreground": "#9cdcfe" }
        },
        {
            "name": "Markdown headings",
            "scope": ["markup.heading", "entity.name.section"],
            "settings": { "foreground": "#569cd6", "fontStyle": "bold" }
        },
        {
            "name": "Markdown bold",
            "scope": "markup.bold",
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Markdown italic",
            "scope": "markup.italic",
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "Markdown inline code",
            "scope": "markup.inline.raw",
            "settings": { "foreground": "#ce9178" }
        },
        {
            "name": "Markdown link",
            "scope": ["markup.underline.link", "string.other.link"],
            "settings": { "foreground": "#4ec9b0" }
        },
        {
            "name": "Markdown quote",
            "scope": "markup.quote",
            "settings": { "foreground": "#6a9955", "fontStyle": "italic" }
        },
        {
            "name": "Markdown inserted (diff)",
            "scope": "markup.inserted",
            "settings": { "foreground": "#6fcf50" }
        },
        {
            "name": "Markdown deleted (diff)",
            "scope": "markup.deleted",
            "settings": { "foreground": "#f44747" }
        },
        {
            "name": "Markdown changed (diff)",
            "scope": "markup.changed",
            "settings": { "foreground": "#e8a830" }
        },
        {
            "name": "Código inválido",
            "scope": "invalid",
            "settings": { "foreground": "#f44747" }
        },
        {
            "name": "Código deprecado",
            "scope": "invalid.deprecated",
            "settings": {
                "foreground": "#e8a830",
                "fontStyle": "strikethrough"
            }
        },
        {
            "name": "Código embebido",
            "scope": ["meta.embedded", "source.groovy.embedded"],
            "settings": { "foreground": "#d4d4d4" }
        }
    ],
    "semanticTokenColors": {
        "namespace": "#4ec9b0",
        "class": "#4ec9b0",
        "enum": "#4ec9b0",
        "interface": "#4ec9b0",
        "struct": "#4ec9b0",
        "typeParameter": { "foreground": "#4ec9b0", "fontStyle": "italic" },
        "type": "#4ec9b0",
        "parameter": "#9cdcfe",
        "variable": "#9cdcfe",
        "property": "#9cdcfe",
        "enumMember": "#4fc1ff",
        "function": "#dcdcaa",
        "method": "#dcdcaa",
        "macro": "#dcdcaa",
        "decorator": { "foreground": "#dcdcaa", "fontStyle": "italic" },
        "event": "#dcdcaa",
        "label": "#9cdcfe",
        "comment": { "foreground": "#6a9955", "fontStyle": "italic" },
        "string": "#ce9178",
        "keyword": "#569cd6",
        "number": "#b5cea8",
        "regexp": "#d16969",
        "operator": "#d4d4d4",
        "*.declaration": { "foreground": "#9cdcfe", "fontStyle": "bold" },
        "*.readonly": "#4fc1ff",
        "*.static": { "foreground": "#4ec9b0", "fontStyle": "italic" },
        "*.deprecated": {
            "foreground": "#e8a830",
            "fontStyle": "strikethrough"
        },
        "*.async": { "foreground": "#c586c0", "fontStyle": "italic" },
        "*.defaultLibrary": "#4ec9b0",
        "*.modification": { "foreground": "#9cdcfe", "fontStyle": "underline" },
        "*.documentation": { "foreground": "#6a9955", "fontStyle": "italic" }
    },
    "$schema": "vscode://schemas/color-theme"
}
