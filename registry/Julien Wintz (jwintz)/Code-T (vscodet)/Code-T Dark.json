{
    "name": "Code:T Dark",
    "type": "dark",
    "colors": {
        "activityBar.foreground": "#ffffff",
        "activityBar.background": "#262626",
        "activityBar.border": "#363636",
        "badge.background": "#A68AF9",
        "button.background": "#A68AF9",
