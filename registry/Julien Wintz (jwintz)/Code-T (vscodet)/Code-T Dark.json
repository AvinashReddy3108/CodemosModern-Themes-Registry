        "editorCursor.foreground": "#A68AF9",
        "editorGutter.addedBackground": "#a6e3a1",
        "editorGutter.modifiedBackground": "#f9e2af",
        "editorGutter.deletedBackground": "#f38ba8",
        "editorGroup.border": "#363636",
        "editorGroupHeader.border": "#363636",
        "editorLineNumber.foreground": "#808080",
        "editorLink.activeForeground": "#89b4fa",
        "editorOverviewRuler.border": "#363636",
        "errorForeground": "#f38ba8",
        "explorer.iconForeground": "#ffffff",
        "focusBorder": "#A68AF9",
        "gitDecoration.addedResourceForeground": "#a6e3a1",
        "gitDecoration.modifiedResourceForeground": "#f9e2af",
        "gitDecoration.deletedResourceForeground": "#f38ba8",
        "gitDecoration.renamedResourceForeground": "#f9e2af",
        "gitDecoration.conflictingResourceForeground": "#f38ba8",
        "gitDecoration.untrackedResourceForeground": "#a6e3a1",
        "gitDecoration.ignoredResourceForeground": "#808080",
        "gitDecoration.submoduleResourceForeground": "#dcd3f8",
        "gitDecoration.stageModifiedResourceForeground": "#f9e2af",
        "gitDecoration.stageDeletedResourceForeground": "#f38ba8",
        "inlineChat.border": "#A68AF9",
        "inlineChatInput.border": "#A68AF9",
        "inlineChatInput.focusBorder": "#A68AF9",
        "input.background": "#262626",
        "input.border": "#363636",
        "list.activeSelectionBackground": "#655594",
        "list.activeSelectionForeground": "#ffffff",
        "list.activeSelectionIconForeground": "#ffffff",
        "list.focusBackground": "#655594",
        "list.focusForeground": "#ffffff",
        "list.focusIconForeground": "#ffffff",
        "list.highlightForeground": "#ffffff",
        "list.iconForeground": "#ffffff",
        "list.inactiveSelectionBackground": "#655594",
        "list.inactiveSelectionForeground": "#f6f6f6",
        "list.inactiveSelectionIconForeground": "#f6f6f6",
        "list.errorForeground": "#f38ba8",
        "list.warningForeground": "#f9e2af",
        "list.infoForeground": "#89b4fa",
        "minimap.selectionHighlight": "#655594",
        "minimap.selectionOccurrenceHighlight": "#655594",
        "panel.background": "#1e1e1e",
        "panel.border": "#363636",
        "panelTitle.activeBorder": "#A68AF9",
        "panelTitleBadge.background": "#A68AF9",
        "pickerGroup.border": "#363636",
        "pickerGroup.foreground": "#A68AF9",
        "quickInput.background": "#262626",
        "quickInput.foreground": "#f6f6f6",
        "quickInputList.focusBackground": "#A68AF9",
        "quickInputList.focusForeground": "#1e1e1e",
        "quickInputList.focusIconForeground": "#1e1e1e",
        "quickInputList.focusMatchHighlight": "#ffffff",
        "quickInputList.matchHighlight": "#A68AF9",
        "quickInputTitle.background": "#262626",
        "scmGraph.historyItemRefColor": "#A68AF9",
        "sideBar.background": "#262626",
        "sideBar.border": "#363636",
        "sideBar.foreground": "#ffffff",
        "sideBar.iconForeground": "#ffffff",
        "sideBarSectionHeader.background": "#262626",
        "sideBarSectionHeader.border": "#363636",
        "statusBar.background": "#1e1e1e",
        "statusBar.border": "#363636",
        "statusBar.debuggingBackground": "#eba0ac",
        "statusBar.debuggingForeground": "#f6f6f6",
        "statusBar.foreground": "#f6f6f6",
        "statusBar.noFolderBackground": "#1e1e1e",
        "statusBarItem.errorBackground": "#f38ba8",
        "statusBarItem.errorForeground": "#f6f6f6",
        "statusBarItem.infoBackground": "#89b4fa",
        "statusBarItem.infoForeground": "#f6f6f6",
        "statusBarItem.remoteBackground": "#A68AF9",
        "statusBarItem.remoteForeground": "#f6f6f6",
        "statusBarItem.remoteHoverBackground": "#b8a2fa",
        "statusBarItem.remoteHoverForeground": "#1e1e1e",
        "statusBarItem.warningBackground": "#f9e2af",
        "statusBarItem.warningForeground": "#f6f6f6",
        "tab.inactiveBackground": "#262626",
        "textLink.foreground": "#89b4fa",
        "textLink.activeForeground": "#89b4fa",
        "terminal.background": "#1e1e1e",
        "titleBar.activeBackground": "#262626",
        "titleBar.border": "#363636",
        "workbench.list.activeSelectionIconForeground": "#1e1e1e",
        "workbench.tree.iconForeground": "#ffffff"
    },
    "tokenColors": [
        {
            "scope": [
                "entity.name.function",
                "entity.name.class",
                "entity.name.type",
                "entity.name.namespace",
                "entity.name.tag",
                "meta.function-call.generic.python",
                "support.function",
                "keyword.control",
                "keyword.operator.new",
                "storage.type.function",
                "storage.type.class",
                "storage.modifier"
            ],
            "settings": { "foreground": "#ffffff", "fontStyle": "bold" }
        },
        {
            "scope": [
                "entity.name.type.class",
                "entity.name.type.interface",
                "entity.name.type.enum",
                "support.type",
                "support.class",
                "variable.language.this",
                "variable.language.super",
                "constant.language",
                "meta.import",
                "meta.export"
            ],
            "settings": { "foreground": "#dcd3f8" }
        },
        {
            "scope": [
                "string",
                "string.quoted",
                "string.template",
                "constant.character.escape",
                "markup.quote",
                "markup.bold",
                "entity.name.tag.yaml"
            ],
            "settings": { "foreground": "#ede8fc" }
        },
        {
            "scope": [
                "invalid",
                "invalid.illegal",
                "invalid.deprecated",
                "markup.deleted",
                "markup.error",
                "diff.removed",
                "diff.deleted",
                "git.deleted",
                "error",
                "diagnostic.error"
            ],
            "settings": { "foreground": "#f38ba8" }
        },
        {
            "scope": [
                "markup.inserted",
                "markup.inserted.diff",
                "diff.inserted",
                "diff.added",
                "git.inserted",
                "git.added",
                "meta.diff.header.to-file",
                "meta.diff.range.added",
                "punctuation.definition.inserted",
                "token.info-token"
            ],
            "settings": { "foreground": "#a6e3a1" }
        },
        {
            "scope": [
                "markup.changed",
                "markup.changed.diff",
                "diff.changed",
                "diff.modified",
                "git.modified",
                "meta.diff.range.changed",
                "punctuation.definition.changed"
            ],
            "settings": { "foreground": "#dcd3f8" }
        },
        {
            "scope": [
                "comment",
                "comment.line",
                "comment.block",
                "punctuation.definition.comment"
            ],
            "settings": { "foreground": "#808080", "fontStyle": "italic" }
        },
        {
            "scope": [
                "markup.quote",
                "meta.preprocessor",
                "entity.other.attribute-name.html",
                "entity.other.attribute-name.class.css",
                "punctuation.separator",
                "punctuation.terminator",
                "punctuation.accessor"
            ],
            "settings": { "foreground": "#808080" }
        },
        {
            "scope": [
                "variable",
                "variable.other",
                "variable.parameter",
                "variable.object.property",
                "meta.object-literal.key",
                "entity.name.variable",
                "constant.numeric",
                "constant.language.boolean",
                "support.variable"
            ],
            "settings": { "foreground": "#ffffff" }
        },
        {
            "scope": [
                "keyword.operator",
                "keyword.operator.arithmetic",
                "keyword.operator.comparison",
                "keyword.operator.logical",
                "keyword.operator.assignment",
                "punctuation.definition.string.begin",
                "punctuation.definition.string.end"
            ],
            "settings": { "foreground": "#ffffff", "fontStyle": "bold" }
        },
        {
            "scope": [
                "keyword",
                "keyword.control.flow",
                "keyword.control.conditional",
                "keyword.control.loop",
                "keyword.control.import",
                "keyword.control.export",
                "storage.type",
                "storage.modifier.async",
                "storage.modifier.static"
            ],
            "settings": { "foreground": "#dcd3f8", "fontStyle": "bold" }
        },
        {
            "scope": [
                "entity.name.type",
                "support.type.primitive",
                "support.type.builtin",
                "support.class.builtin",
                "entity.other.inherited-class"
            ],
            "settings": { "foreground": "#dcd3f8" }
        },
        {
            "scope": [
                "entity.name.function.decorator",
                "meta.decorator",
                "punctuation.decorator"
            ],
            "settings": { "foreground": "#ede8fc" }
        },
        {
            "scope": ["markup.heading", "entity.name.section"],
            "settings": { "foreground": "#ffffff", "fontStyle": "bold" }
        },
        {
            "scope": ["markup.underline.link", "string.other.link"],
            "settings": { "foreground": "#dcd3f8" }
        },
        {
            "scope": ["markup.fenced_code", "markup.inline.raw"],
            "settings": { "foreground": "#ffffff", "background": "#232323" }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "namespace": { "foreground": "#ffffff", "fontStyle": "bold" },
        "class": { "foreground": "#ffffff", "fontStyle": "bold" },
        "function": { "foreground": "#ffffff", "fontStyle": "bold" },
        "method": { "foreground": "#ffffff" },
        "interface": { "foreground": "#dcd3f8", "fontStyle": "bold" },
        "struct": { "foreground": "#dcd3f8", "fontStyle": "bold" },
        "enum": { "foreground": "#dcd3f8", "fontStyle": "bold" },
        "type": { "foreground": "#dcd3f8" },
        "typeParameter": { "foreground": "#dcd3f8" },
        "keyword": { "foreground": "#dcd3f8", "fontStyle": "bold" },
        "macro": { "foreground": "#dcd3f8", "fontStyle": "bold" },
        "variable": { "foreground": "#ffffff" },
        "parameter": { "foreground": "#ffffff" },
        "property": { "foreground": "#ffffff" },
        "enumMember": { "foreground": "#dcd3f8" },
        "operator": { "foreground": "#ffffff", "fontStyle": "bold" },
        "string": { "foreground": "#ede8fc" },
        "number": { "foreground": "#ffffff" },
        "regexp": { "foreground": "#ede8fc" },
        "decorator": { "foreground": "#ede8fc" },
        "event": { "foreground": "#dcd3f8" },
        "label": { "foreground": "#ffffff", "fontStyle": "bold" },
        "comment": { "foreground": "#808080", "fontStyle": "italic" },
        "*.declaration": { "fontStyle": "bold" },
        "*.definition": { "fontStyle": "bold" },
        "*.readonly": { "foreground": "#dcd3f8" },
        "*.deprecated": {
            "foreground": "#808080",
            "fontStyle": "strikethrough"
        },
        "*.modification": { "fontStyle": "bold" },
        "*.documentation": { "foreground": "#808080" },
        "*.defaultLibrary": { "foreground": "#dcd3f8" },
        "class.declaration": { "foreground": "#ffffff", "fontStyle": "bold" },
        "function.declaration": {
            "foreground": "#ffffff",
            "fontStyle": "bold"
        },
        "method.static": { "foreground": "#ffffff" },
        "function.static": { "foreground": "#ffffff", "fontStyle": "bold" },
        "variable.readonly": { "foreground": "#dcd3f8" },
        "property.readonly": { "foreground": "#dcd3f8" },
        "parameter.readonly": { "foreground": "#dcd3f8" },
        "class.abstract": { "foreground": "#dcd3f8", "fontStyle": "bold" },
        "method.abstract": { "foreground": "#ffffff" },
        "function.async": { "foreground": "#ffffff", "fontStyle": "bold" },
        "method.async": { "foreground": "#ffffff" }
    },
    "$schema": "vscode://schemas/color-theme"
}
