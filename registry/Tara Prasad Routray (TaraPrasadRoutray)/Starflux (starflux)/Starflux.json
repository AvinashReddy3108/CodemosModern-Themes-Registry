{
    "name": "Starflux",
    "type": "light",
    "colors": {
        "editor.background": "#F1EFEC",
        "editor.foreground": "#001C2B",
        "editor.selectionBackground": "#E1D9D2",
        "editor.selectionForeground": "#001C2B",
        "editor.lineHighlightBackground": "#E1D9D2",
        "editorCursor.foreground": "#001C2B",
        "editorWhitespace.foreground": "#B0B0B0",
        "editorIndentGuide.background1": "#D4C9BE",
        "editorIndentGuide.activeBackground1": "#014971",
        "editor.selectionHighlightBackground": "#D4C9BE40",
        "editor.findMatchBackground": "#015c8f",
        "editor.findMatchForeground": "#F1EFEC",
        "editor.findMatchHighlightBackground": "#2a9d8fE5",
        "editor.findMatchHighlightForeground": "#F1EFECE5",
        "editor.hoverHighlightBackground": "#ccdee950",
        "editorLink.activeForeground": "#014971",
        "activityBar.background": "#001C2B",
        "activityBar.foreground": "#F1EFEC",
        "activityBarBadge.background": "#001C2B",
        "activityBarBadge.foreground": "#F1EFEC",
        "sideBar.border": "#cbc3bd",
        "editorGroup.border": "#cbc3bd",
        "panel.border": "#cbc3bd",
        "panel.background": "#eae4e0",
        "panelTitle.activeBorder": "#015c8f",
        "panelTitle.activeForeground": "#0f172a",
        "panelTitle.inactiveForeground": "#52689c",
        "sideBar.background": "#eae4e0",
        "sideBar.foreground": "#0f172a",
        "sideBarSectionHeader.background": "#e1d9d2",
        "sideBarSectionHeader.foreground": "#0f172a",
        "statusBar.background": "#014971",
        "statusBar.foreground": "#F1EFEC",
        "statusBarItem.hoverBackground": "#001C2B",
        "titleBar.activeBackground": "#014971",
        "titleBar.activeForeground": "#F1EFEC",
        "titleBar.inactiveBackground": "#001C2B",
        "editorGutter.background": "#F1EFEC",
        "editorGutter.modifiedBackground": "#004e89",
        "editorGutter.addedBackground": "#008000",
        "editorGutter.deletedBackground": "#d31a1a",
        "button.background": "#015C8F",
        "button.foreground": "#F1EFEC",
        "input.background": "#D4C9BE",
        "input.foreground": "#001C2B",
        "input.border": "#B0B0B0",
        "input.placeholderForeground": "#52689c",
        "scrollbar.shadow": "#B0B0B0",
        "scrollbarSlider.background": "#B0B0B0",
        "scrollbarSlider.hoverBackground": "#B0B0B0",
        "scrollbarSlider.activeBackground": "#B0B0B0",
        "terminal.background": "#E3DDD9",
        "terminal.border": "#001C2B",
        "terminal.foreground": "#001C2B",
        "list.activeSelectionBackground": "#E1D9D2",
        "list.activeSelectionForeground": "#015c8f",
        "list.inactiveSelectionBackground": "#E1D9D2",
        "list.inactiveSelectionForeground": "#001C2B",
        "sideBarTitle.foreground": "#001C2B",
        "activityBar.activeBackground": "#013553",
        "list.hoverBackground": "#e1d9d2",
        "list.hoverForeground": "#015c8f",
        "editorSuggestWidget.background": "#eae4e0",
        "editorSuggestWidget.foreground": "#001C2B",
        "editorSuggestWidget.selectedBackground": "#e1d9d2",
        "editorSuggestWidget.selectedForeground": "#015c8f",
        "editorSuggestWidget.highlightForeground": "#008000",
        "editorSuggestWidget.focusHighlightForeground": "#015c8f"
    },
    "tokenColors": [
        {
            "scope": [
                "variable",
                "variable.other",
                "variable.other.local",
                "variable.other.readwrite",
                "variable.language",
                "variable.parameter"
            ],
            "settings": { "foreground": "#001C2B" }
        },
        {
            "scope": [
                "keyword.control",
                "keyword.control.flow",
                "keyword.control.return",
                "keyword.control.break",
                "keyword.control.continue"
            ],
            "settings": { "foreground": "#d33500", "fontStyle": "bold" }
        },
        {
            "scope": ["keyword.control.conditional", "keyword.control.loop"],
            "settings": { "foreground": "#015c8f", "fontStyle": "bold" }
        },
        {
            "scope": [
                "constant",
                "constant.numeric",
                "constant.language",
                "constant.character",
                "constant.other"
            ],
            "settings": { "foreground": "#001C2B", "fontStyle": "bold" }
        },
        {
            "scope": [
                "string",
                "string.quoted",
                "string.quoted.single",
                "string.quoted.double",
                "string.template"
            ],
            "settings": { "foreground": "#008000" }
        },
        {
            "scope": ["comment", "comment.block", "comment.line"],
            "settings": { "foreground": "#667780" }
        },
        {
            "scope": [
                "punctuation.definition.comment",
                "comment.block.documentation"
            ],
            "settings": { "foreground": "#667780" }
        },
        {
            "scope": ["support", "support.function", "support.class"],
            "settings": { "foreground": "#015c8f", "fontStyle": "bold" }
        },
        {
            "scope": [
                "entity.name.function",
                "entity.name.class",
                "entity.name.type"
            ],
            "settings": { "foreground": "#015c8f", "fontStyle": "bold" }
        },
        {
            "scope": ["meta", "meta.definition"],
            "settings": { "foreground": "#001C2B" }
        },
        {
            "scope": [
                "punctuation",
                "punctuation.definition.string",
                "punctuation.definition.comment",
                "punctuation.separator"
            ],
            "settings": { "foreground": "#014971" }
        },
        {
            "scope": ["invalid", "invalid.deprecated"],
            "settings": { "foreground": "#d31a1a" }
        },
        {
            "scope": ["variable.other.key.json", "variable.other.json"],
            "settings": { "foreground": "#014971" }
        },
        {
            "scope": ["string.quoted.double.json", "string.quoted.single.json"],
            "settings": { "foreground": "#014971" }
        },
        {
            "scope": ["storage.modifier", "keyword.access", "storage"],
            "settings": { "foreground": "#8f250c", "fontStyle": "bold" }
        },
        {
            "scope": "gitlens.blame.annotation.author",
            "settings": { "foreground": "#8f250c" }
        },
        {
            "scope": "gitlens.blame.annotation.age",
            "settings": { "foreground": "#8f250c" }
        },
        {
            "scope": "gitlens.blame.annotation.changes",
            "settings": { "foreground": "#8f250c" }
        },
        {
            "scope": "entity.name.tag.html",
            "settings": { "foreground": "#015c8f", "fontStyle": "bold" }
        },
        {
            "scope": "entity.other.attribute-name.html",
            "settings": { "foreground": "#007f5f", "fontStyle": "bold" }
        },
        {
            "scope": "string.quoted.double.html",
            "settings": { "foreground": "#833f13" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
