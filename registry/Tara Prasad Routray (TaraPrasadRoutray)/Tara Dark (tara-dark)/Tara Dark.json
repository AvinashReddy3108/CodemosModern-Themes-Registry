        },
        {
            "name": "Markup - Table",
            "scope": ["markup.table"],
            "settings": { "foreground": "#EEFFFF" }
        },
        {
            "name": "Import",
            "scope": ["keyword.control.import"],
            "settings": { "foreground": "#00a2ff" }
        },
        {
            "name": "Alias For Import",
            "scope": ["storage.modifier.ts"],
