{
    "name": "Oranji",
    "type": "light",
    "colors": {
        "focusBorder": "#ff9940cc",
        "foreground": "#3f4551",
        "selection.background": "#ff994033",
        "textLink.activeForeground": "#ff9940",
        "textLink.foreground": "#ff9940",
        "button.background": "#ff9940cc",
        "button.foreground": "#fffffd",
        "button.hoverBackground": "#cfd5e2",
        "dropdown.background": "#fffffd",
        "dropdown.listBackground": "#fffffd",
        "dropdown.foreground": "#3f4551bf",
        "input.background": "#fffffd",
        "input.foreground": "#3f4551bf",
        "input.placeholderForeground": "#3f455180",
        "scrollbarSlider.activeBackground": "#3f455180",
        "scrollbarSlider.hoverBackground": "#3f455166",
        "scrollbarSlider.background": "#3f45514d",
        "badge.background": "#ff9940cc",
        "badge.foreground": "#fffffd",
        "progressBar.background": "#ff9940cc",
        "list.activeSelectionBackground": "#ff994099",
        "list.activeSelectionForeground": "#fffffd",
        "list.dropBackground": "#ff994099",
        "list.focusBackground": "#ff994099",
        "list.focusForeground": "#3f4551",
        "list.hoverBackground": "#ff994033",
        "list.inactiveSelectionBackground": "#ff994033",
        "list.inactiveSelectionForeground": "#3f4551",
        "listFilterWidget.outline": "#ff9940cc",
        "listFilterWidget.noMatchesOutline": "#8aa2d3cc",
        "listFilterWidget.background": "#fffffd",
        "list.filterMatchBackground": "#8aa2d366",
        "activityBar.background": "#f3f3f3",
        "activityBar.foreground": "#ff9940",
        "activityBar.inactiveForeground": "#3f4551bf",
        "activityBar.activeBorder": "#ff9940",
        "activityBarBadge.background": "#ff9940",
        "activityBarBadge.foreground": "#fffffd",
        "sideBar.background": "#fafafa",
        "sideBarSectionHeader.foreground": "#3f4551bf",
        "sideBarSectionHeader.background": "#f3f3f3",
        "editorGroup.border": "#3f45514d",
        "editorGroupHeader.noTabsBackground": "#f3f3f3",
        "editorGroupHeader.tabsBackground": "#f3f3f3",
        "tab.border": "#f3f3f3",
        "tab.inactiveBackground": "#f3f3f3",
        "tab.hoverBorder": "#ff9940",
        "editor.background": "#fffffd",
        "editor.foreground": "#3f4551d0",
        "editorLineNumber.foreground": "#3f455166",
        "editorLineNumber.activeForeground": "#ff9940",
        "editorCursor.foreground": "#3f4551",
        "editor.selectionBackground": "#ff994033",
        "editor.inactiveSelectionBackground": "#f3f3f3aa",
        "editor.findMatchBackground": "#8aa2d399",
        "editor.findMatchHighlightBackground": "#8aa2d366",
        "editor.hoverHighlightBackground": "#ff994066",
        "editor.lineHighlightBackground": "#f3f3f3",
        "editorLink.activeForeground": "#ff9940",
        "editorBracketMatch.background": "#8aa2d366",
        "editorBracketMatch.border": "#ffffff00",
        "editorUnnecessaryCode.opacity": "#ffffff99",
        "editorWidget.background": "#fafafa",
        "editorSuggestWidget.foreground": "#3f4551d0",
        "editorSuggestWidget.selectedBackground": "#ff994066",
        "editorSuggestWidget.selectedForeground": "#3f4551d0",
        "editorSuggestWidget.highlightForeground": "#3f4551d0",
        "editorSuggestWidget.focusHighlightForeground": "#3f4551d0",
        "titleBar.activeBackground": "#f3f3f3",
        "titleBar.inactiveBackground": "#f3f3f3",
        "statusBar.background": "#f3f3f3",
        "statusBar.foreground": "#3f4551",
        "statusBar.debuggingBackground": "#ff9940",
        "statusBar.debuggingForeground": "#fffffd",
        "statusBar.noFolderBackground": "#f3f3f3",
        "statusBar.noFolderForeground": "#3f4551",
        "panel.background": "#f3f3f3",
        "panel.border": "#ffffff00",
        "terminal.background": "#f3f3f3"
    },
    "tokenColors": [
        {
            "name": "comment",
            "scope": ["comment"],
            "settings": { "foreground": "#8d9297", "fontStyle": "italic" }
        },
        {
            "name": "string",
            "scope": ["string"],
            "settings": { "foreground": "#f97e25" }
        },
        {
            "name": "template string reset",
            "scope": ["meta.template.expression"],
            "settings": { "foreground": "#3f4551d0" }
        },
        {
            "name": "keyword",
            "scope": ["keyword"],
            "settings": { "foreground": "#ee6565" }
        },
        {
            "name": "variable language",
            "scope": ["variable.language"],
            "settings": { "foreground": "#ee6565" }
        },
        {
            "name": "storage type",
            "scope": ["storage.type"],
            "settings": { "foreground": "#6484c5" }
        },
        {
            "name": "storage modifier",
            "scope": ["storage.modifier"],
            "settings": { "foreground": "#ee6565" }
        },
        {
            "name": "regexp",
            "scope": ["string.regexp"],
            "settings": { "foreground": "#6484c5" }
        },
        {
            "name": "numbers and escape characters",
            "scope": [
                "constant.numeric",
                "constant.character",
                "constant.other"
            ],
            "settings": { "foreground": "#9668c5" }
        },
        {
            "name": "functions",
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#2cb300" }
        },
        {
            "name": "functions params",
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#9668c5" }
        },
        {
            "name": "types",
            "scope": [
                "entity.name.type",
                "support.type.primitive",
                "support.class",
                "support.constant"
            ],
            "settings": { "foreground": "#2293e3" }
        },
        {
            "name": "template string",
            "scope": ["punctuation.definition.template-expression"],
            "settings": { "foreground": "#9668c5" }
        },
        {
            "name": "language constant",
            "scope": ["constant.language"],
            "settings": { "foreground": "#9668c5" }
        },
        {
            "name": "css tag name",
            "scope": [
                "source.css entity.name.tag",
                "source.sass entity.name.tag",
                "source.scss entity.name.tag",
                "source.less entity.name.tag",
                "source.stylus entity.name.tag"
            ],
            "settings": { "foreground": "#ee6565" }
        },
        {
            "name": "css constant",
            "scope": [
                "source.css support.constant",
                "source.sass support.constant",
                "source.scss support.constant",
                "source.less support.constant",
                "source.stylus support.constant"
            ],
            "settings": { "foreground": "#2293e3" }
        },
        {
            "name": "css function",
            "scope": [
                "source.css support.function",
                "source.sass support.function",
                "source.scss support.function",
                "source.less support.function",
                "source.stylus support.function"
            ],
            "settings": { "foreground": "#2cb300" }
        },
        {
            "name": "css variable",
            "scope": [
                "source.css variable",
                "source.sass variable",
                "source.scss variable",
                "source.less variable",
                "source.stylus variable"
            ],
            "settings": { "foreground": "#7793cc" }
        },
        {
            "name": "css variable",
            "scope": [
                "source.css entity.other.attribute-name",
                "source.sass entity.other.attribute-name",
                "source.scss entity.other.attribute-name",
                "source.less entity.other.attribute-name",
                "source.stylus entity.other.attribute-name"
            ],
            "settings": { "foreground": "#6484c5" }
        },
        {
            "name": "tag",
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#7793cc" }
        },
        {
            "name": "attr",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#2cb300" }
        },
        {
            "name": "component",
            "scope": ["support.class.component"],
            "settings": { "foreground": "#2293e3" }
        },
        {
            "name": "json propname",
            "scope": ["source.json support.type.property-name"],
            "settings": { "foreground": "#6484c5" }
        },
        {
            "name": "yaml propname",
            "scope": ["source.yaml entity.name.tag"],
            "settings": { "foreground": "#6484c5" }
        },
        {
            "name": "markup heading",
            "scope": ["markup.heading", "markup.heading entity.name"],
            "settings": { "fontStyle": "bold", "foreground": "#7793cc" }
        },
        {
            "name": "markup links",
            "scope": ["markup.underline.link", "string.other.link"],
            "settings": { "foreground": "#2293e3" }
        },
        {
            "name": "markup italic",
            "scope": ["markup.italic"],
            "settings": { "fontStyle": "italic", "foreground": "#6484c5" }
        },
        {
            "name": "markup bold",
            "scope": ["markup.bold"],
            "settings": { "fontStyle": "bold", "foreground": "#6484c5" }
        },
        {
            "name": "markup bold and italic",
            "scope": ["markup.italic markup.bold", "markup.bold markup.italic"],
            "settings": { "fontStyle": "bold italic" }
        },
        {
            "name": "markup code",
            "scope": ["markup.raw", "markup.inline.raw"],
            "settings": { "foreground": "#9668c5" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
