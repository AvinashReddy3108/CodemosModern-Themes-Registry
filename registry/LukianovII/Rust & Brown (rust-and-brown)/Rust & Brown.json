        "quickInput.background": "#221e1a",
        "quickInput.foreground": "#fffbf5",
        "quickInputList.focusBackground": "#3d352e",
        "quickInputTitle.background": "#2a241f",
        "settings.headerForeground": "#f0e5d9",
        "settings.modifiedItemIndicator": "#ff8860",
        "editorBracketHighlight.foreground1": "#ff8860",
        "editorBracketHighlight.foreground2": "#ffe8b8",
        "editorBracketHighlight.foreground3": "#a8c8e8",
        "editorBracketHighlight.foreground4": "#b8e0a8",
        "editorBracketHighlight.foreground5": "#ffa8d0",
        "editorBracketHighlight.foreground6": "#a8e0d0"
    },
    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#8a7d72", "fontStyle": "italic" }
        },
        {
            "name": "Documentation Comments",
            "scope": [
                "comment.block.documentation",
                "comment.line.documentation",
                "string.quoted.docstring"
            ],
            "settings": { "foreground": "#a09080", "fontStyle": "italic" }
        },
        {
            "name": "Comment Keywords (TODO, FIXME, etc.)",
            "scope": [
                "comment.line.todo",
                "keyword.todo",
                "keyword.codetag.notation"
            ],
            "settings": { "foreground": "#ffa860", "fontStyle": "bold" }
        },
        {
            "name": "Comment Note",
            "scope": ["comment.line.note", "keyword.note"],
            "settings": { "foreground": "#a8c8e8", "fontStyle": "bold" }
        },
        {
            "name": "Strings",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#ffb89d" }
        },
        {
            "name": "String Escape Sequences",
            "scope": ["constant.character.escape", "string.escape"],
            "settings": { "foreground": "#ffc8b8" }
        },
        {
            "name": "Regular Expressions",
            "scope": ["string.regexp", "string.regex"],
            "settings": { "foreground": "#ffa8d0" }
        },
        {
            "name": "String Special (URLs, paths)",
            "scope": ["string.other.link", "markup.underline.link"],
            "settings": { "foreground": "#a8c8e8" }
        },
        {
            "name": "Numbers",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#ffc8b8" }
        },
        {
            "name": "Boolean",
            "scope": [
                "constant.language.boolean",
                "constant.language.true",
                "constant.language.false"
            ],
            "settings": { "foreground": "#ffc8b8" }
        },
        {
            "name": "Language Constants",
            "scope": ["constant.language", "constant.character"],
            "settings": { "foreground": "#ffc8b8" }
        },
        {
            "name": "Character",
            "scope": ["constant.character", "constant.character.literal"],
            "settings": { "foreground": "#ffc8b8" }
        },
        {
            "name": "Keywords",
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#ff8860", "fontStyle": "bold" }
        },
        {
            "name": "Keyword Modifier",
            "scope": ["storage.modifier", "keyword.modifier"],
            "settings": { "foreground": "#ff8860" }
        },
        {
            "name": "Keyword Control Flow",
            "scope": [
                "keyword.control",
                "keyword.control.flow",
                "keyword.control.return",
                "keyword.control.conditional",
                "keyword.control.loop"
            ],
            "settings": { "foreground": "#ff8860", "fontStyle": "bold" }
        },
        {
            "name": "Keyword Import/Export",
            "scope": [
                "keyword.control.import",
                "keyword.control.export",
                "keyword.control.from",
                "keyword.control.as"
            ],
            "settings": { "foreground": "#ff8860" }
        },
        {
            "name": "Keyword Exception",
            "scope": ["keyword.control.exception", "keyword.control.trycatch"],
            "settings": { "foreground": "#ff9090" }
        },
        {
            "name": "Keyword Async",
            "scope": [
                "keyword.control.async",
                "keyword.control.await",
                "storage.modifier.async"
            ],
            "settings": { "foreground": "#ffa8d0" }
        },
        {
            "name": "Operators",
            "scope": [
                "keyword.operator",
                "keyword.operator.new",
                "keyword.operator.expression"
            ],
            "settings": { "foreground": "#ffb090" }
        },
        {
            "name": "Ternary Operator",
            "scope": ["keyword.operator.ternary"],
            "settings": { "foreground": "#ffb090" }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "meta.function-call",
                "support.function"
            ],
            "settings": { "foreground": "#ffe8b8" }
        },
        {
            "name": "Function Declaration",
            "scope": [
                "entity.name.function.definition",
                "meta.function entity.name.function"
            ],
            "settings": { "foreground": "#ffe8b8" }
        },
        {
            "name": "Method",
            "scope": [
                "entity.name.function.member",
                "meta.method.declaration entity.name.function"
            ],
            "settings": { "foreground": "#ffe8b8" }
        },
        {
            "name": "Macros",
            "scope": [
                "entity.name.function.macro",
                "meta.preprocessor.macro",
                "support.function.macro"
            ],
            "settings": { "foreground": "#ffa8d0" }
        },
        {
            "name": "Decorators/Attributes",
            "scope": [
                "entity.name.function.decorator",
                "meta.decorator",
                "punctuation.decorator"
            ],
            "settings": { "foreground": "#ffa8d0" }
        },
        {
            "name": "Types",
            "scope": ["entity.name.type", "support.type"],
            "settings": { "foreground": "#b8e0a8" }
        },
        {
            "name": "Classes",
            "scope": [
                "entity.name.class",
                "support.class",
                "entity.name.type.class"
            ],
            "settings": { "foreground": "#b8e0a8" }
        },
        {
            "name": "Type Definition",
            "scope": ["entity.name.type.definition", "entity.name.type.alias"],
            "settings": { "foreground": "#b8e0a8", "fontStyle": "bold" }
        },
        {
            "name": "Interface",
            "scope": ["entity.name.type.interface", "support.type.interface"],
            "settings": { "foreground": "#a8e0d0" }
        },
        {
            "name": "Inherited Class",
            "scope": ["entity.other.inherited-class"],
            "settings": { "foreground": "#b8e0a8", "fontStyle": "italic" }
        },
        {
            "name": "Constructor",
            "scope": [
                "entity.name.function.constructor",
                "support.function.constructor"
            ],
            "settings": { "foreground": "#b8e0a8" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "variable.other", "variable.parameter"],
            "settings": { "foreground": "#a8c8e8" }
        },
        {
            "name": "Variable Builtin",
            "scope": [
                "variable.language",
                "variable.language.this",
                "variable.language.self",
                "variable.language.super"
            ],
            "settings": { "foreground": "#98d0e8" }
        },
        {
            "name": "Variable Special",
            "scope": ["variable.other.special"],
            "settings": { "foreground": "#a8e0d0" }
        },
        {
            "name": "Properties",
            "scope": [
                "variable.other.property",
                "variable.other.object.property",
                "support.type.property-name"
            ],
            "settings": { "foreground": "#98d0e8" }
        },
        {
            "name": "Field",
            "scope": ["variable.other.member", "variable.other.field"],
            "settings": { "foreground": "#98d0e8" }
        },
        {
            "name": "Constants",
            "scope": ["variable.other.constant", "constant.other"],
            "settings": { "foreground": "#ffc8b8" }
        },
        {
            "name": "Enum",
            "scope": ["entity.name.type.enum", "support.type.enum"],
            "settings": { "foreground": "#a8e0d0" }
        },
        {
            "name": "Enum Member",
            "scope": ["variable.other.enummember", "constant.other.enum"],
            "settings": { "foreground": "#a8e0d0" }
        },
        {
            "name": "Namespace",
            "scope": ["entity.name.namespace", "entity.name.type.namespace"],
            "settings": { "foreground": "#d4c5b9" }
        },
        {
            "name": "Module",
            "scope": ["entity.name.type.module", "support.module"],
            "settings": { "foreground": "#d4c5b9" }
        },
        {
            "name": "HTML/XML Tags",
            "scope": ["entity.name.tag", "punctuation.definition.tag"],
            "settings": { "foreground": "#ff8860" }
        },
        {
            "name": "HTML/XML Attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#ffe8b8" }
        },
        {
            "name": "Tag Delimiter",
            "scope": [
                "punctuation.definition.tag.begin",
                "punctuation.definition.tag.end"
            ],
            "settings": { "foreground": "#d4c5b9" }
        },
        {
            "name": "Doctype",
            "scope": ["meta.tag.sgml.doctype", "entity.name.tag.doctype"],
            "settings": { "foreground": "#8a7d72", "fontStyle": "italic" }
        },
        {
            "name": "CSS Classes & IDs",
            "scope": [
                "entity.other.attribute-name.class",
                "entity.other.attribute-name.id"
            ],
            "settings": { "foreground": "#b8e0a8" }
        },
        {
            "name": "CSS Properties",
            "scope": ["support.type.property-name.css"],
            "settings": { "foreground": "#98d0e8" }
        },
        {
            "name": "JSON Keys",
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#a8c8e8" }
        },
        {
            "name": "Markdown Headings",
            "scope": ["markup.heading", "entity.name.section"],
            "settings": { "foreground": "#ff8860", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Bold",
            "scope": ["markup.bold"],
            "settings": { "foreground": "#ffe8b8", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Italic",
            "scope": ["markup.italic"],
            "settings": { "foreground": "#ffb89d", "fontStyle": "italic" }
        },
        {
            "name": "Markdown Links",
            "scope": ["markup.underline.link"],
            "settings": { "foreground": "#a8c8e8", "fontStyle": "underline" }
        },
        {
            "name": "Markdown Code",
            "scope": ["markup.inline.raw", "markup.fenced_code", "markup.raw"],
            "settings": { "foreground": "#a8e0d0" }
        },
        {
            "name": "Markdown List Marker",
            "scope": [
                "punctuation.definition.list.begin",
                "markup.list.numbered",
                "markup.list.unnumbered"
            ],
            "settings": { "foreground": "#ff8860" }
        },
        {
            "name": "Diff Added",
            "scope": [
                "markup.inserted",
                "meta.diff.header.to-file",
                "punctuation.definition.inserted"
            ],
            "settings": { "foreground": "#b8e0a8" }
        },
        {
            "name": "Diff Removed",
            "scope": [
                "markup.deleted",
                "meta.diff.header.from-file",
                "punctuation.definition.deleted"
            ],
            "settings": { "foreground": "#ff9090" }
        },
        {
            "name": "Diff Changed",
            "scope": ["markup.changed", "punctuation.definition.changed"],
            "settings": { "foreground": "#ffe8b8" }
        },
        {
            "name": "Preprocessor",
            "scope": [
                "meta.preprocessor",
                "keyword.control.directive",
                "punctuation.definition.directive"
            ],
            "settings": { "foreground": "#ffa8d0" }
        },
        {
            "name": "Errors",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#ff9090" }
        },
        {
            "name": "Deprecated",
            "scope": ["invalid.deprecated"],
            "settings": {
                "foreground": "#8a7d72",
                "fontStyle": "strikethrough"
            }
        },
        {
            "name": "Punctuation",
            "scope": ["punctuation"],
            "settings": { "foreground": "#d4c5b9" }
        },
        {
            "name": "Punctuation Brackets",
            "scope": [
                "punctuation.brackets",
                "punctuation.section",
                "punctuation.parenthesis"
            ],
            "settings": { "foreground": "#d4c5b9" }
        },
        {
            "name": "Punctuation Special",
            "scope": ["punctuation.special", "punctuation.section.embedded"],
            "settings": { "foreground": "#ffb090" }
        },
        {
            "name": "Labels",
            "scope": ["entity.name.label"],
            "settings": { "foreground": "#ff8860" }
        },
        {
            "name": "Symbol",
            "scope": ["constant.other.symbol"],
            "settings": { "foreground": "#ffc8b8" }
        },
        {
            "name": "Embedded",
            "scope": ["meta.embedded", "source.embedded"],
            "settings": { "foreground": "#ffb090" }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "namespace": "#d4c5b9",
        "type": "#b8e0a8",
        "type.declaration": { "foreground": "#b8e0a8", "bold": true },
        "class": "#b8e0a8",
        "class.declaration": { "foreground": "#b8e0a8", "bold": true },
        "interface": "#a8e0d0",
        "enum": "#a8e0d0",
        "enumMember": "#a8e0d0",
        "struct": "#b8e0a8",
        "typeParameter": "#b8e0a8",
        "function": "#ffe8b8",
        "function.declaration": "#ffe8b8",
        "method": "#ffe8b8",
        "method.declaration": "#ffe8b8",
        "macro": "#ffa8d0",
        "variable": "#a8c8e8",
        "variable.readonly": "#ffc8b8",
        "variable.static": "#a8c8e8",
        "parameter": "#a8c8e8",
        "property": "#98d0e8",
        "property.readonly": "#98d0e8",
        "property.static": "#98d0e8",
        "keyword": { "foreground": "#ff8860", "bold": true },
        "modifier": "#ff8860",
        "comment": { "foreground": "#8a7d72", "italic": true },
        "string": "#ffb89d",
        "number": "#ffc8b8",
        "regexp": "#ffa8d0",
        "operator": "#ffb090",
        "decorator": "#ffa8d0",
        "label": "#ff8860"
    },
    "$schema": "vscode://schemas/color-theme"
}
