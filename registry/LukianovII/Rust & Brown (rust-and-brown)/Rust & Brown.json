        "notificationsInfoIcon.foreground": "#a8c8e8",
        "breadcrumb.background": "#1a1612",
        "breadcrumb.foreground": "#8a7d72",
        "breadcrumb.focusForeground": "#f0e5d9",
        "breadcrumb.activeSelectionForeground": "#ff8860",
        "breadcrumbPicker.background": "#221e1a",
        "welcomePage.background": "#1a1612",
