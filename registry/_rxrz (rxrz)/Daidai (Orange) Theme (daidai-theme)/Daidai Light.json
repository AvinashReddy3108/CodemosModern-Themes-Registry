    "tokenColors": [
        {
            "name": "Qualified namespaces / modules",
            "scope": [
                "entity.name.namespace",
                "support.namespace",
                "entity.name.type.module",
                "support.module",
                "variable.other.object",
                "variable.other.object.ts",
                "variable.other.object.tsx",
                "variable.other.object.js",
                "variable.other.object.jsx"
            ],
            "settings": { "foreground": "#b263f6" }
        },
        {
            "name": "Qualified members after dot",
            "scope": [
                "variable.other.property",
                "variable.other.object.property",
                "support.variable.property",
                "meta.property.object",
                "meta.member.access",
                "meta.member.access.ts",
                "meta.member.access.tsx",
                "meta.member.access.js",
                "meta.member.access.jsx",
                "support.type.property-name",
                "support.type.property-name.ts",
                "support.type.property-name.tsx",
                "entity.name.type.property",
                "entity.name.type.property.ts",
                "entity.name.type.property.tsx"
            ],
            "settings": { "foreground": "#77b4fa" }
        },
        {
            "name": "React namespaced type members",
            "scope": [
                "meta.type.annotation.ts meta.member.access.ts entity.name.type.ts",
                "meta.type.annotation.tsx meta.member.access.tsx entity.name.type.tsx",
                "meta.type.annotation.ts support.type",
                "meta.type.annotation.tsx support.type"
            ],
            "settings": { "foreground": "#77b4fa" }
        },
        {
            "name": "Comments",
            "scope": [
                "comment",
                "comment.block",
                "comment.line",
                "punctuation.definition.comment"
            ],
            "settings": { "foreground": "#a09b96", "fontStyle": "italic" }
        },
        {
            "name": "Keywords — control flow, declarations",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.new",
                "keyword.other",
                "storage",
                "storage.type",
                "storage.modifier"
            ],
            "settings": { "foreground": "#d95a1e" }
        },
        {
            "name": "Import / export / from / as",
            "scope": [
                "keyword.control.import",
                "keyword.control.export",
                "keyword.control.from",
                "keyword.control.as",
                "keyword.control.default"
            ],
            "settings": { "foreground": "#d95a1e" }
        },
        {
            "name": "Types, classes, interfaces, enums",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "entity.name.interface",
                "entity.name.enum",
                "entity.other.inherited-class",
                "support.class",
                "support.type",
                "meta.type.annotation",
                "meta.type.parameters"
            ],
            "settings": { "foreground": "#b263f6" }
        },
        {
            "name": "Type primitives (string, number, boolean…)",
            "scope": [
                "support.type.primitive",
                "keyword.type",
                "storage.type.primitive"
            ],
            "settings": { "foreground": "#b263f6" }
        },
        {
            "name": "Functions — declarations & calls",
            "scope": [
                "entity.name.function",
                "meta.function-call",
                "meta.function-call entity.name.function",
                "support.function"
            ],
            "settings": { "foreground": "#5f93d3" }
        },
        {
            "name": "Properties & object members",
            "scope": [
                "variable.other.property",
                "variable.other.object.property",
                "support.variable.property"
            ],
            "settings": { "foreground": "#77b4fa" }
        },
        {
            "name": "Object literal keys",
            "scope": "meta.object-literal.key",
            "settings": { "foreground": "#7a6a5a" }
        },
        {
            "name": "Variables",
            "scope": [
                "variable",
                "variable.other",
                "variable.other.readwrite",
                "variable.other.constant"
            ],
            "settings": { "foreground": "#3f6fb5" }
        },
        {
            "name": "Parameters",
            "scope": ["variable.parameter", "meta.parameters variable.other"],
            "settings": { "foreground": "#77b4fa" }
        },
        {
            "name": "Strings",
            "scope": [
                "string",
                "string.quoted",
                "string.template",
                "string.interpolated"
            ],
            "settings": { "foreground": "#7a6a5a" }
        },
        {
            "name": "Template literal punctuation ${}",
            "scope": ["punctuation.definition.template-expression"],
            "settings": { "foreground": "#d95a1e" }
        },
        {
            "name": "Numbers",
            "scope": [
                "constant.numeric",
                "constant.numeric.hex",
                "constant.numeric.octal",
                "constant.numeric.binary"
            ],
            "settings": { "foreground": "#1a1816", "fontStyle": "bold" }
        },
        {
            "name": "Booleans & null/undefined",
            "scope": [
                "constant.language.boolean",
                "constant.language.null",
                "constant.language.undefined",
                "constant.language"
            ],
            "settings": { "foreground": "#d95a1e" }
        },
        {
            "name": "Operators",
            "scope": [
                "keyword.operator",
                "keyword.operator.arithmetic",
                "keyword.operator.comparison",
                "keyword.operator.logical",
                "keyword.operator.assignment",
                "keyword.operator.ternary",
                "keyword.operator.spread",
                "keyword.operator.optional"
            ],
            "settings": { "foreground": "#a09b96" }
        },
        {
            "name": "Punctuation — brackets, braces, parens, commas",
            "scope": [
                "punctuation",
                "punctuation.definition",
                "punctuation.separator",
                "punctuation.terminator",
                "meta.brace",
                "meta.bracket"
            ],
            "settings": { "foreground": "#a09b96" }
        },
        {
            "name": "Decorators / annotations",
            "scope": [
                "meta.decorator",
                "punctuation.decorator",
                "entity.name.function.decorator"
            ],
            "settings": { "foreground": "#b263f6", "fontStyle": "italic" }
        },
        {
            "name": "Regex",
            "scope": ["string.regexp", "constant.character.escape"],
            "settings": { "foreground": "#d95a1e" }
        },
        {
            "name": "HTML / JSX tags",
            "scope": ["entity.name.tag", "meta.tag", "support.class.component"],
            "settings": { "foreground": "#d95a1e" }
        },
        {
            "name": "HTML / JSX attributes",
            "scope": ["entity.other.attribute-name", "meta.jsx.children"],
            "settings": { "foreground": "#77b4fa" }
        },
        {
            "name": "CSS property names",
            "scope": ["support.type.property-name.css", "meta.property-name"],
            "settings": { "foreground": "#77b4fa" }
        },
        {
            "name": "CSS values & units",
            "scope": [
                "support.constant.property-value",
                "constant.numeric.css",
                "keyword.other.unit"
            ],
            "settings": { "foreground": "#7a6a5a" }
        },
        {
            "name": "CSS selectors",
            "scope": [
                "entity.name.tag.css",
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css"
            ],
            "settings": { "foreground": "#b263f6" }
        },
        {
            "name": "Markdown headings",
            "scope": ["markup.heading", "entity.name.section"],
            "settings": { "foreground": "#2a2422", "fontStyle": "bold" }
        },
        {
            "name": "Markdown bold",
            "scope": "markup.bold",
            "settings": { "foreground": "#2a2422", "fontStyle": "bold" }
        },
        {
            "name": "Markdown italic",
            "scope": "markup.italic",
            "settings": { "foreground": "#2a2422", "fontStyle": "italic" }
        },
        {
            "name": "Markdown links",
            "scope": ["markup.underline.link", "string.other.link"],
            "settings": { "foreground": "#5f93d3" }
        },
        {
            "name": "Markdown code",
            "scope": ["markup.inline.raw", "markup.fenced_code.block"],
            "settings": { "foreground": "#7a6a5a" }
        },
        {
            "name": "Markdown blockquote",
            "scope": "markup.quote",
            "settings": { "foreground": "#a09b96", "fontStyle": "italic" }
        },
        {
            "name": "JSON keys",
            "scope": "support.type.property-name.json",
            "settings": { "foreground": "#7a6a5a" }
        },
        {
            "name": "YAML keys",
            "scope": "entity.name.tag.yaml",
            "settings": { "foreground": "#7a6a5a" }
        },
        {
            "name": "Invalid / deprecated",
            "scope": ["invalid", "invalid.illegal", "invalid.deprecated"],
            "settings": { "foreground": "#cc3333" }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "class": "#b263f6",
        "interface": "#b263f6",
        "enum": "#b263f6",
        "enumMember": "#5f93d3",
        "type": "#b263f6",
        "typeParameter": "#b263f6",
        "function": "#5f93d3",
        "method": "#5f93d3",
        "decorator": { "foreground": "#b263f6", "italic": true },
        "macro": "#8b3fd9",
        "variable": "#3f6fb5",
        "variable.readonly": "#3f6fb5",
        "variable.defaultLibrary": "#5f93d3",
        "parameter": "#77b4fa",
        "property": "#77b4fa",
        "property.declaration": "#7a6a5a",
        "namespace": "#b263f6",
        "module": "#b263f6",
        "keyword": "#d95a1e",
        "string": "#7a6a5a",
        "number": "#1a1816",
        "regexp": "#d95a1e",
        "comment": { "foreground": "#a09b96", "italic": true },
        "label": "#a09b96",
        "namespace.defaultLibrary": "#b263f6",
        "module.defaultLibrary": "#b263f6",
        "type.defaultLibrary": "#77b4fa",
        "interface.defaultLibrary": "#77b4fa",
        "property.readonly": "#77b4fa",
        "member": "#77b4fa"
    },
    "$schema": "vscode://schemas/color-theme"
}
