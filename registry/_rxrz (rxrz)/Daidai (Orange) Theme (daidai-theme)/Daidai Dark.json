    "tokenColors": [
        {
            "name": "Qualified namespaces / modules",
            "scope": [
                "entity.name.namespace",
                "support.namespace",
                "entity.name.type.module",
                "support.module",
                "variable.other.object",
                "variable.other.object.ts",
                "variable.other.object.tsx",
                "variable.other.object.js",
                "variable.other.object.jsx"
            ],
            "settings": { "foreground": "#b263f6" }
        },
        {
            "name": "Qualified members after dot",
            "scope": [
                "variable.other.property",
                "variable.other.object.property",
                "support.variable.property",
                "meta.property.object",
                "meta.member.access",
                "meta.member.access.ts",
                "meta.member.access.tsx",
                "meta.member.access.js",
                "meta.member.access.jsx",
                "support.type.property-name",
                "support.type.property-name.ts",
                "support.type.property-name.tsx",
                "entity.name.type.property",
                "entity.name.type.property.ts",
                "entity.name.type.property.tsx"
            ],
            "settings": { "foreground": "#77b4fa" }
        },
        {
            "name": "React namespaced type members",
            "scope": [
                "meta.type.annotation.ts meta.member.access.ts entity.name.type.ts",
                "meta.type.annotation.tsx meta.member.access.tsx entity.name.type.tsx",
                "meta.type.annotation.ts support.type",
                "meta.type.annotation.tsx support.type"
            ],
            "settings": { "foreground": "#77b4fa" }
        },
        {
            "name": "Comments",
            "scope": [
                "comment",
                "comment.block",
                "comment.line",
                "punctuation.definition.comment"
            ],
            "settings": { "foreground": "#807976", "fontStyle": "italic" }
        },
        {
            "name": "Keywords — control flow, declarations",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.new",
                "keyword.other",
                "storage",
                "storage.type",
                "storage.modifier"
            ],
            "settings": { "foreground": "#ff7038" }
        },
        {
            "name": "Import / export / from / as",
            "scope": [
                "keyword.control.import",
                "keyword.control.export",
                "keyword.control.from",
                "keyword.control.as",
                "keyword.control.default"
            ],
            "settings": { "foreground": "#ff7038" }
        },
        {
            "name": "Types, classes, interfaces, enums",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "entity.name.interface",
                "entity.name.enum",
                "entity.other.inherited-class",
                "support.class",
                "support.type",
                "meta.type.annotation",
                "meta.type.parameters"
            ],
            "settings": { "foreground": "#b263f6" }
        },
        {
            "name": "Type primitives (string, number, boolean…)",
            "scope": [
                "support.type.primitive",
                "keyword.type",
                "storage.type.primitive"
            ],
            "settings": { "foreground": "#b263f6" }
        },
        {
            "name": "Functions — declarations & calls",
            "scope": [
                "entity.name.function",
                "meta.function-call",
                "meta.function-call entity.name.function",
                "support.function"
            ],
            "settings": { "foreground": "#89aee0" }
        },
        {
            "name": "Properties & object members",
            "scope": [
                "variable.other.property",
                "variable.other.object.property",
                "support.variable.property"
            ],
            "settings": { "foreground": "#77b4fa" }
        },
        {
            "name": "Object literal keys",
            "scope": "meta.object-literal.key",
            "settings": { "foreground": "#d4cfc9" }
        },
        {
            "name": "Variables",
            "scope": [
                "variable",
                "variable.other",
                "variable.other.readwrite",
                "variable.other.constant"
            ],
            "settings": { "foreground": "#e8e6e3" }
        },
        {
            "name": "Parameters",
            "scope": ["variable.parameter", "meta.parameters variable.other"],
            "settings": { "foreground": "#77b4fa" }
        },
        {
            "name": "Strings",
            "scope": [
                "string",
                "string.quoted",
                "string.template",
                "string.interpolated"
            ],
            "settings": { "foreground": "#d4cfc9" }
        },
        {
            "name": "Template literal punctuation ${}",
            "scope": ["punctuation.definition.template-expression"],
            "settings": { "foreground": "#ff7038" }
        },
        {
            "name": "Numbers",
            "scope": [
                "constant.numeric",
                "constant.numeric.hex",
                "constant.numeric.octal",
                "constant.numeric.binary"
            ],
            "settings": { "foreground": "#f0eeeb" }
        },
        {
            "name": "Booleans & null/undefined",
            "scope": [
                "constant.language.boolean",
                "constant.language.null",
                "constant.language.undefined",
                "constant.language"
            ],
            "settings": { "foreground": "#ff7038" }
        },
        {
            "name": "Operators",
            "scope": [
                "keyword.operator",
                "keyword.operator.arithmetic",
                "keyword.operator.comparison",
                "keyword.operator.logical",
                "keyword.operator.assignment",
                "keyword.operator.ternary",
                "keyword.operator.spread",
                "keyword.operator.optional"
            ],
            "settings": { "foreground": "#807976" }
        },
        {
            "name": "Punctuation — brackets, braces, parens, commas",
            "scope": [
                "punctuation",
                "punctuation.definition",
                "punctuation.separator",
                "punctuation.terminator",
                "meta.brace",
                "meta.bracket"
            ],
            "settings": { "foreground": "#807976" }
        },
        {
            "name": "Decorators / annotations",
            "scope": [
                "meta.decorator",
                "punctuation.decorator",
                "entity.name.function.decorator"
            ],
            "settings": { "foreground": "#b263f6", "fontStyle": "italic" }
        },
        {
            "name": "Regex",
            "scope": ["string.regexp", "constant.character.escape"],
            "settings": { "foreground": "#ff7038" }
        },
        {
            "name": "HTML / JSX tags",
            "scope": ["entity.name.tag", "meta.tag", "support.class.component"],
            "settings": { "foreground": "#ff7038" }
        },
        {
            "name": "HTML / JSX attributes",
            "scope": ["entity.other.attribute-name", "meta.jsx.children"],
            "settings": { "foreground": "#77b4fa" }
        },
        {
            "name": "CSS property names",
            "scope": ["support.type.property-name.css", "meta.property-name"],
            "settings": { "foreground": "#77b4fa" }
        },
        {
            "name": "CSS values & units",
            "scope": [
                "support.constant.property-value",
                "constant.numeric.css",
                "keyword.other.unit"
            ],
            "settings": { "foreground": "#d4cfc9" }
        },
        {
            "name": "CSS selectors",
            "scope": [
                "entity.name.tag.css",
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css"
            ],
            "settings": { "foreground": "#b263f6" }
        },
        {
            "name": "Markdown headings",
            "scope": ["markup.heading", "entity.name.section"],
            "settings": { "foreground": "#e8e6e3", "fontStyle": "bold" }
        },
        {
            "name": "Markdown bold",
            "scope": "markup.bold",
            "settings": { "foreground": "#e8e6e3", "fontStyle": "bold" }
        },
        {
            "name": "Markdown italic",
            "scope": "markup.italic",
            "settings": { "foreground": "#e8e6e3", "fontStyle": "italic" }
        },
        {
            "name": "Markdown links",
            "scope": ["markup.underline.link", "string.other.link"],
            "settings": { "foreground": "#89aee0" }
        },
        {
            "name": "Markdown code",
            "scope": ["markup.inline.raw", "markup.fenced_code.block"],
            "settings": { "foreground": "#d4cfc9" }
        },
        {
            "name": "Markdown blockquote",
            "scope": "markup.quote",
            "settings": { "foreground": "#807976", "fontStyle": "italic" }
        },
        {
            "name": "JSON keys",
            "scope": "support.type.property-name.json",
            "settings": { "foreground": "#d4cfc9" }
        },
        {
            "name": "YAML keys",
            "scope": "entity.name.tag.yaml",
            "settings": { "foreground": "#d4cfc9" }
        },
        {
            "name": "Invalid / deprecated",
            "scope": ["invalid", "invalid.illegal", "invalid.deprecated"],
            "settings": { "foreground": "#ff5555" }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "class": "#b263f6",
        "interface": "#b263f6",
        "enum": "#b263f6",
        "enumMember": "#89aee0",
        "type": "#b263f6",
        "typeParameter": "#b263f6",
        "function": "#89aee0",
        "decorator": { "foreground": "#b263f6", "italic": true },
        "macro": "#b263f6",
        "variable": "#5d8fd6",
        "variable.readonly": "#5d8fd6",
        "variable.defaultLibrary": "#89aee0",
        "parameter": "#77b4fa",
        "property": "#77b4fa",
        "property.declaration": "#d4cfc9",
        "namespace": "#b263f6",
        "module": "#b263f6",
        "keyword": "#ff7038",
        "string": "#d4cfc9",
        "number": "#f0eeeb",
        "regexp": "#ff7038",
        "comment": { "foreground": "#807976", "italic": true },
        "label": "#807976",
        "namespace.defaultLibrary": "#b263f6",
        "module.defaultLibrary": "#b263f6",
        "type.defaultLibrary": "#77b4fa",
        "interface.defaultLibrary": "#77b4fa",
        "property.readonly": "#77b4fa",
        "method": "#77b4fa"
    },
    "$schema": "vscode://schemas/color-theme"
}
