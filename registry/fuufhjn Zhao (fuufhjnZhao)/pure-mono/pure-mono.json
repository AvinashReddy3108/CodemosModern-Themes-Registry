    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "fontStyle": "italic", "foreground": "#616E88" }
        },
        {
            "name": "Control Keywords",
            "scope": [
                "keyword.control",
                "keyword.control.conditional",
                "keyword.control.loop",
                "keyword.control.return",
                "keyword.control.trycatch",
                "keyword.control.import"
            ],
            "settings": { "foreground": "#B48EAD" }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "keyword.operator.new",
                "storage.type",
                "storage.modifier"
            ],
            "settings": { "foreground": "#D8DEE9" }
        },
        {
            "name": "Strings",
            "scope": [
                "string",
                "constant.other.symbol",
                "constant.other.key",
                "string.regexp"
            ],
            "settings": { "foreground": "#88C0D0" }
        },
        {
            "name": "Numbers & Constants",
            "scope": [
                "constant.numeric",
                "constant.language",
                "constant.character",
                "constant.escape",
                "keyword.other.unit"
            ],
            "settings": { "foreground": "#88C0D0" }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "meta.function-call",
                "variable.function",
                "support.function",
                "keyword.other.special-method",
                "entity.name.method"
            ],
            "settings": { "foreground": "#D8DEE9" }
        },
        {
            "name": "Types & Classes",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "entity.other.inherited-class",
                "support.type",
                "support.class",
                "support.type.sys-types"
            ],
            "settings": { "foreground": "#88C0D0" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "variable.other", "variable.parameter"],
            "settings": { "foreground": "#D8DEE9" }
        },
        {
            "name": "Language Variables",
            "scope": ["variable.language"],
            "settings": { "fontStyle": "italic", "foreground": "#88C0D0" }
        },
        {
            "name": "Tags",
            "scope": [
                "entity.name.tag",
                "meta.tag",
                "punctuation.definition.tag"
            ],
            "settings": { "foreground": "#D8DEE9" }
        },
        {
            "name": "Attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#D8DEE9" }
        },
        {
            "name": "Decorators",
            "scope": [
                "meta.decorator",
                "punctuation.decorator",
                "tag.decorator.js entity.name.tag.js",
                "tag.decorator.js punctuation.definition.tag.js"
            ],
            "settings": { "foreground": "#B48EAD" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation.accessor",
                "punctuation.separator",
                "punctuation.terminator"
            ],
            "settings": { "foreground": "#A8AEB9" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#B48EAD" }
        },
        {
            "name": "URL & Links",
            "scope": ["*url*", "*link*", "*uri*"],
            "settings": { "fontStyle": "underline", "foreground": "#D8DEE9" }
        },
        {
            "name": "JSON Property Key",
            "scope": [
                "source.json support.type.property-name",
                "source.json meta.structure.dictionary.json support.type.property-name.json",
                "source.json meta.object-literal.key"
            ],
            "settings": { "foreground": "#88C0D0" }
        },
        {
            "name": "JSON String Values",
            "scope": [
                "source.json meta.structure.dictionary.value.json string.quoted",
                "source.json meta.structure.dictionary.value.json string.quoted punctuation.definition.string",
                "source.json meta.structure.array.json string.quoted",
                "source.json meta.structure.array.json string.quoted punctuation.definition.string"
            ],
            "settings": { "foreground": "#D8DEE9" }
        },
        {
            "name": "Markdown Headings",
            "scope": [
                "markup.heading",
                "markup.heading entity.name",
                "punctuation.definition.heading.markdown"
            ],
            "settings": { "foreground": "#B48EAD" }
        },
        {
            "name": "Markdown Bold",
            "scope": ["markup.bold"],
            "settings": { "fontStyle": "bold", "foreground": "#D8DEE9" }
        },
        {
            "name": "Markdown Italic",
            "scope": ["markup.italic"],
            "settings": { "fontStyle": "italic", "foreground": "#D8DEE9" }
        },
        {
            "name": "Markdown Code",
            "scope": ["markup.raw.inline", "markup.raw.block"],
            "settings": { "foreground": "#88C0D0" }
        },
        {
            "name": "Markdown Blockquote",
            "scope": ["markup.quote"],
            "settings": { "fontStyle": "italic", "foreground": "#616E88" }
        },
        {
            "name": "Markdown Link",
            "scope": ["string.other.link.title.markdown"],
            "settings": { "foreground": "#B48EAD" }
        },
        {
            "name": "Markup Inserted",
            "scope": ["markup.inserted"],
            "settings": { "foreground": "#D8DEE9" }
        },
        {
            "name": "Markup Deleted",
            "scope": ["markup.deleted"],
            "settings": { "foreground": "#D8DEE9" }
        },
        {
            "name": "Markup Changed",
            "scope": ["markup.changed"],
            "settings": { "foreground": "#D8DEE9" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
