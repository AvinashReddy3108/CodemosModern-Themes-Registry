    "tokenColors": [
        {
            "name": "Plain Text / Default",
            "scope": ["source", "text"],
            "settings": { "foreground": "#8892B2" }
        },
        {
            "name": "Comment",
            "scope": [
                "comment",
                "comment.line",
                "comment.block",
                "punctuation.definition.comment"
            ],
            "settings": { "foreground": "#697098", "fontStyle": "italic" }
        },
        {
            "name": "XML / Doc Comment (all parts)",
            "scope": [
                "comment.block.documentation",
                "comment.line.documentation",
                "punctuation.definition.comment.documentation"
            ],
            "settings": { "foreground": "#697098", "fontStyle": "italic" }
        },
        {
            "name": "Keyword",
            "scope": [
                "keyword",
                "keyword.other",
                "keyword.operator.new",
                "keyword.operator.delete",
                "storage.modifier",
                "storage.type"
            ],
            "settings": { "foreground": "#C792EA" }
        },
        {
            "name": "Keyword - Control / Flow",
            "scope": [
                "keyword.control",
                "keyword.control.flow",
                "keyword.control.conditional",
                "keyword.control.loop",
                "keyword.control.return",
                "keyword.control.import",
                "keyword.control.from",
                "keyword.control.as",
                "keyword.control.async",
                "keyword.control.await",
                "keyword.control.yield",
                "keyword.control.trycatch",
                "keyword.control.throw"
            ],
            "settings": { "foreground": "#C792EA" }
        },
        {
            "name": "Preprocessor / Macro Keyword",
            "scope": [
                "keyword.preprocessor",
                "keyword.control.directive",
                "keyword.control.import.define",
                "keyword.control.import.include",
                "meta.preprocessor",
                "meta.preprocessor.string",
                "meta.preprocessor.numeric"
            ],
            "settings": { "foreground": "#E77369" }
        },
        {
            "name": "Preprocessor Text",
            "scope": [
                "meta.preprocessor.string source",
                "meta.preprocessor source"
            ],
            "settings": { "foreground": "#DCDCDC" }
        },
        {
            "name": "Operator",
            "scope": [
                "keyword.operator",
                "keyword.operator.arithmetic",
                "keyword.operator.assignment",
                "keyword.operator.comparison",
                "keyword.operator.logical",
                "keyword.operator.bitwise",
                "keyword.operator.ternary"
            ],
            "settings": { "foreground": "#B687DC" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation",
                "punctuation.separator",
                "punctuation.terminator",
                "punctuation.accessor",
                "punctuation.definition.block",
                "punctuation.definition.parameters",
                "punctuation.section"
            ],
            "settings": { "foreground": "#DCDCDC" }
        },
        {
            "name": "String",
            "scope": [
                "string",
                "string.quoted",
                "string.quoted.single",
                "string.quoted.double",
                "string.quoted.triple",
                "string.template",
                "string.unquoted"
            ],
            "settings": { "foreground": "#9BDD8D" }
        },
        {
            "name": "String Verbatim / Raw",
            "scope": ["string.quoted.other", "string.regexp"],
            "settings": { "foreground": "#9BDD8D" }
        },
        {
            "name": "String Escape Character",
            "scope": [
                "constant.character.escape",
                "string.escape",
                "punctuation.definition.escape"
            ],
            "settings": { "foreground": "#B776FB" }
        },
        {
            "name": "Number / Numeric Literal",
            "scope": [
                "constant.numeric",
                "constant.numeric.integer",
                "constant.numeric.float",
                "constant.numeric.hex",
                "constant.numeric.octal",
                "constant.numeric.binary"
            ],
            "settings": { "foreground": "#EB7669" }
        },
        {
            "name": "Boolean / Null / Undefined",
            "scope": [
                "constant.language.boolean",
                "constant.language.null",
                "constant.language.undefined",
                "constant.language.nan",
                "constant.language"
            ],
            "settings": { "foreground": "#EB7669" }
        },
        {
            "name": "Constant / Literal",
            "scope": ["constant", "constant.other"],
            "settings": { "foreground": "#DADADA" }
        },
        {
            "name": "Type Name (generic)",
            "scope": ["entity.name.type", "support.type"],
            "settings": { "foreground": "#ffcb6b" }
        },
        {
            "name": "Class Name",
            "scope": [
                "entity.name.class",
                "entity.name.type.class",
                "support.class"
            ],
            "settings": { "foreground": "#FFCB6B" }
        },
        {
            "name": "Struct Name",
            "scope": ["entity.name.type.struct", "storage.type.struct"],
            "settings": { "foreground": "#E0BE8B" }
        },
        {
            "name": "Interface Name",
            "scope": [
                "entity.name.type.interface",
                "entity.other.inherited-class"
            ],
            "settings": { "foreground": "#F28B82" }
        },
        {
            "name": "Enum Name",
            "scope": ["entity.name.type.enum"],
            "settings": { "foreground": "#FFCB68" }
        },
        {
            "name": "Module / Namespace Name",
            "scope": [
                "entity.name.module",
                "entity.name.namespace",
                "entity.name.type.module",
                "entity.name.type.namespace"
            ],
            "settings": { "foreground": "#ffcb6b" }
        },
        {
            "name": "Delegate Name",
            "scope": ["entity.name.type.delegate"],
            "settings": { "foreground": "#7FAAFB" }
        },
        {
            "name": "Type Parameter / Generic",
            "scope": [
                "entity.name.type.parameter",
                "entity.name.type.type-parameter"
            ],
            "settings": { "foreground": "#B8D7A3" }
        },
        {
            "name": "Namespace Usage",
            "scope": [
                "entity.name.namespace",
                "entity.name.type.namespace",
                "meta.namespace"
            ],
            "settings": { "foreground": "#8892B2" }
        },
        {
            "name": "Function / Method Name Definition",
            "scope": [
                "entity.name.function",
                "entity.name.method",
                "meta.definition.method entity.name.function",
                "meta.function entity.name.function"
            ],
            "settings": { "foreground": "#82AAFF" }
        },
        {
            "name": "Function / Method Call",
            "scope": [
                "meta.function-call",
                "meta.method-call",
                "variable.function",
                "support.function"
            ],
            "settings": { "foreground": "#82AAFF" }
        },
        {
            "name": "Constructor",
            "scope": ["entity.name.function.constructor"],
            "settings": { "foreground": "#82AAFF" }
        },
        {
            "name": "Variable",
            "scope": ["variable", "variable.other", "variable.other.readwrite"],
            "settings": { "foreground": "#89DDFF" }
        },
        {
            "name": "Local Variable",
            "scope": ["variable.other.local", "variable.other.block"],
            "settings": { "foreground": "#89DDFF" }
        },
        {
            "name": "Parameter",
            "scope": [
                "variable.parameter",
                "meta.function.parameters variable"
            ],
            "settings": { "foreground": "#89DDFF" }
        },
        {
            "name": "Property / Field",
            "scope": [
                "variable.other.property",
                "variable.other.member",
                "variable.other.object.property",
                "support.variable.property",
                "meta.property-name"
            ],
            "settings": { "foreground": "#8892B2" }
        },
        {
            "name": "This / Self",
            "scope": [
                "variable.language.this",
                "variable.language.self",
                "variable.language.super"
            ],
            "settings": { "foreground": "#C792EA", "fontStyle": "italic" }
        },
        {
            "name": "Identifier (general)",
            "scope": ["meta.definition variable", "meta.var.expr entity.name"],
            "settings": { "foreground": "#B3B9D4" }
        },
        {
            "name": "HTML / XML Tag Name",
            "scope": ["entity.name.tag", "meta.tag entity.name.tag"],
            "settings": { "foreground": "#7FAAFB" }
        },
        {
            "name": "HTML / XML Tag Delimiter / Punctuation",
            "scope": [
                "punctuation.definition.tag",
                "meta.tag punctuation.definition.tag"
            ],
            "settings": { "foreground": "#89DDFF" }
        },
        {
            "name": "HTML / XML Attribute Name",
            "scope": [
                "entity.other.attribute-name",
                "meta.tag entity.other.attribute-name"
            ],
            "settings": { "foreground": "#E06C75" }
        },
        {
            "name": "XML Attribute Name (Local)",
            "scope": [
                "entity.other.attribute-name.localname.xml",
                "entity.other.attribute-name.xml"
            ],
            "settings": { "foreground": "#ffcb6b" }
        },
        {
            "name": "HTML / XML Attribute Value (string part)",
            "scope": [
                "string.quoted.double.html",
                "string.quoted.single.html",
                "meta.attribute string"
            ],
            "settings": { "foreground": "#9BDD8D" }
        },
        {
            "name": "HTML Entity",
            "scope": [
                "constant.character.entity",
                "punctuation.definition.entity"
            ],
            "settings": { "foreground": "#FF9D3A" }
        },
        {
            "name": "HTML Operator",
            "scope": [
                "keyword.operator.html",
                "punctuation.separator.key-value.html"
            ],
            "settings": { "foreground": "#BDC1D4" }
        },
        {
            "name": "Markup Node (XML tag keyword)",
            "scope": [
                "support.class.component",
                "entity.name.tag.tsx",
                "entity.name.tag.jsx"
            ],
            "settings": { "foreground": "#569CD6" }
        },
        {
            "name": "Markup Attribute (non-HTML)",
