{
    "$schema": "vscode://schemas/color-theme",
    "name": "OLED EyeEase TriLang",
    "type": "dark",
    "colors": {
        "editor.background": "#000000",
        "editor.foreground": "#D4D4D4",
        "editorLineNumber.foreground": "#4A535A",
        "editorLineNumber.activeForeground": "#9CB6C5",
        "editorCursor.foreground": "#79C0FF",
        "editor.selectionBackground": "#113042",
        "editor.inactiveSelectionBackground": "#0A1F2C99",
        "editor.wordHighlightBackground": "#1E364466",
        "editor.wordHighlightStrongBackground": "#2A4B6199",
        "editor.findMatchBackground": "#254C63",
        "editor.findMatchHighlightBackground": "#1A334280",
        "editorBracketMatch.background": "#132531",
        "editorBracketMatch.border": "#4CA6D9",
        "sideBar.background": "#050505",
        "activityBar.background": "#050505",
        "titleBar.activeBackground": "#000000",
        "statusBar.background": "#03131B",
        "panel.background": "#040404",
        "tab.activeBackground": "#000000",
        "tab.inactiveBackground": "#070707"
    },
    "tokenColors": [
        {
            "name": "Default",
            "scope": ["source", "text"],
            "settings": { "foreground": "#D4D4D4" }
        },
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#8B9EB0", "fontStyle": "italic" }
        },
        {
            "name": "Keywords",
            "scope": ["keyword", "storage.type"],
            "settings": { "foreground": "#79C0FF" }
        },
        {
            "name": "Operators",
            "scope": [
                "keyword.operator",
                "punctuation.separator",
                "punctuation.terminator"
            ],
            "settings": { "foreground": "#8AB9D1" }
        },
        {
            "name": "Strings",
            "scope": ["string", "punctuation.definition.string"],
            "settings": { "foreground": "#8DD28A" }
        },
        {
            "name": "Numbers and constants",
            "scope": [
                "constant.numeric",
                "constant.language",
                "constant.character"
            ],
            "settings": { "foreground": "#E5C07B" }
        },
        {
            "name": "Functions and methods",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call"
            ],
            "settings": { "foreground": "#F0C674" }
        },
        {
            "name": "Variables",
            "scope": [
                "variable",
                "meta.definition.variable.name",
                "variable.other.readwrite"
            ],
            "settings": { "foreground": "#D4D4D4" }
        },
        {
            "name": "Python Properties and Submodules (e.g., nn in torch.nn)",
            "scope": [
                "variable.other.property.python",
                "variable.other.object.property.python"
            ],
            "settings": { "foreground": "#56B6C2" }
        },
        {
            "name": "Types and classes",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.class",
                "support.type"
            ],
            "settings": { "foreground": "#4EC9B0" }
        },
        {
            "name": "Python keywords",
            "scope": [
                "keyword.control.import.python",
                "keyword.control.flow.python",
                "storage.type.function.python"
            ],
            "settings": { "foreground": "#569CD6" }
        },
        {
            "name": "Python not operator",
            "scope": [
                "keyword.operator.logical.not.python",
                "keyword.operator.logical.not",
                "keyword.operator.wordlike.not.python",
                "keyword.operator.wordlike.not"
            ],
            "settings": { "foreground": "#FF7B72" }
        },
        {
            "name": "Python logical operator",
            "scope": ["keyword.operator.logical.python"],
            "settings": { "foreground": "#D2A8FF" }
        },
        {
            "name": "Python decorators",
            "scope": [
                "meta.function.decorator.python",
                "entity.name.function.decorator.python",
                "punctuation.definition.decorator.python"
            ],
            "settings": { "foreground": "#D2A8FF" }
        },
        {
            "name": "Python self and cls",
            "scope": [
                "variable.parameter.function.language.special.self.python",
                "variable.language.special.self.python",
                "variable.language.special.cls.python"
            ],
            "settings": { "foreground": "#79C0FF" }
        },
        {
            "name": "Python Base Import Module (e.g., torchvision)",
            "scope": [
                "meta.import.python entity.name.namespace.python",
                "meta.import.python support.module.python",
                "support.module.python",
                "entity.name.namespace.python"
            ],
            "settings": { "foreground": "#C678DD" }
        },
        {
            "name": "Python Imported Items (e.g., datasets, transforms)",
            "scope": [
                "meta.import.python variable.other.normal.python",
                "meta.import.python variable.other.readwrite.python",
                "meta.import.python variable.other.readwrite.alias.python",
                "meta.import.python variable.other.alias.python",
                "meta.import.python support.class.python"
            ],
            "settings": { "foreground": "#98C379" }
        },
        {
            "name": "JSON property keys",
            "scope": [
                "support.type.property-name.json",
                "meta.object-literal.key.json string.quoted.double.json",
                "meta.object.member.json string.quoted.double.json"
            ],
            "settings": { "foreground": "#56B6C2" }
        },
        {
            "name": "JSON punctuation",
            "scope": [
                "punctuation.separator.key-value.json",
                "punctuation.separator.dictionary.key-value.json",
                "punctuation.separator.comma.json"
            ],
            "settings": { "foreground": "#8B9EB0" }
        },
        {
            "name": "JSON booleans and null",
            "scope": [
                "constant.language.boolean.json",
                "constant.language.null.json"
            ],
            "settings": { "foreground": "#D19A66" }
        },
        {
            "name": "YAML keys",
            "scope": [
                "entity.name.tag.yaml",
                "entity.name.tag.yaml punctuation.definition.tag.yaml"
            ],
            "settings": { "foreground": "#56B6C2" }
        },
        {
            "name": "YAML strings and scalars",
            "scope": [
                "string.unquoted.yaml",
                "string.quoted.single.yaml",
                "string.quoted.double.yaml"
            ],
            "settings": { "foreground": "#8DD28A" }
        },
        {
            "name": "YAML anchors and aliases",
            "scope": [
                "constant.other.anchor.yaml",
                "variable.other.alias.yaml"
            ],
            "settings": { "foreground": "#C678DD" }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "comment": "#8B9EB0",
        "keyword": "#79C0FF",
        "string": "#8DD28A",
        "number": "#E5C07B",
        "function": "#F0C674",
        "function.defaultLibrary": "#98C379",
        "method": "#F0C674",
        "namespace": "#C678DD",
        "namespace.defaultLibrary": "#C678DD",
        "module": "#C678DD",
        "variable": "#D4D4D4",
        "variable.readonly": "#D4D4D4",
        "variable.defaultLibrary": "#D4D4D4",
        "parameter": "#79C0FF",
        "type": "#4EC9B0",
        "class": "#4EC9B0",
        "property": "#56B6C2",
        "decorator": "#D2A8FF"
    }
}
