{
    "name": "BRB-Theme",
    "settings": [
        {
            "settings": {
                "background": "#000000",
                "caret": "#C7C7C7",
                "foreground": "#C7C7C7",
                "invisibles": "#3B3A32",
                "lineHighlight": "#46525C54",
                "selection": "#49483E"
            }
        },
        {
            "name": "Comment",
            "scope": "comment",
            "settings": { "foreground": "#8A8A8A75", "background": "#9C9C9C1F" }
        },
        {
            "name": "String",
            "scope": "string",
            "settings": { "foreground": "#007c00ff" }
        },
        {
            "name": "Number",
            "scope": "constant.numeric",
            "settings": { "foreground": "#006affff" }
        },
        {
            "name": "Built-in constant",
            "scope": "constant.language",
            "settings": { "foreground": "#006affff" }
        },
        {
            "name": "User-defined constant",
            "scope": ["constant.character", "constant.other"],
            "settings": { "foreground": "#006affff" }
        },
        {
            "name": "Variable",
            "scope": "variable",
            "settings": { "fontStyle": "", "foreground": "#0080ffff" }
        },
        {
            "name": "Keyword",
            "scope": "keyword",
            "settings": { "foreground": "#ff0000ff" }
        },
        {
            "name": "Storage",
            "scope": "storage",
            "settings": { "fontStyle": "", "foreground": "#ff0054ff" }
        },
        {
            "name": "Storage type",
            "scope": "storage.type",
            "settings": { "fontStyle": "italic", "foreground": "#ff7c00ff" }
        },
        {
            "name": "Class name",
            "scope": "entity.name.class",
            "settings": { "foreground": "#00bc1dff" }
        },
        {
            "name": "Inherited class",
            "scope": "entity.other.inherited-class",
            "settings": { "fontStyle": "italic ", "foreground": "#008d00ff" }
        },
        {
            "name": "Function name",
            "scope": "entity.name.function",
            "settings": { "foreground": "#009effff" }
        },
        {
            "name": "Function argument",
            "scope": "variable.parameter",
            "settings": { "fontStyle": "italic  ", "foreground": "#009effff" }
        },
        {
            "name": "Tag name",
            "scope": "entity.name.tag",
            "settings": { "foreground": "#ff0079ff" }
        },
        {
            "name": "Tag attribute",
            "scope": "entity.other.attribute-name",
            "settings": { "fontStyle": "", "foreground": "#e4ff00ff" }
        },
        {
            "name": "Library function",
            "scope": "support.function",
            "settings": { "fontStyle": "", "foreground": "#00c7ffff" }
        },
        {
            "name": "Library constant",
            "scope": "support.constant",
            "settings": { "fontStyle": "", "foreground": "#0090ffff" }
        },
        {
            "name": "Library class/type",
            "scope": ["support.type", "support.class"],
            "settings": { "fontStyle": "italic", "foreground": "#00c4eaff" }
        },
        {
            "name": "Library variable",
            "scope": "support.other.variable",
            "settings": { "fontStyle": "", "foreground": "#ffffffc4" }
        },
        {
            "name": "Invalid",
            "scope": "invalid",
            "settings": {
                "background": "#ff000087",
                "fontStyle": "",
                "foreground": "#000000ff"
            }
        },
        {
            "name": "Invalid deprecated",
            "scope": "invalid.deprecated",
            "settings": { "background": "#df8bffad", "foreground": "#000000ff" }
        }
    ],
    "uuid": "D8D5E82E-3D5B-46B5-B38E-8C841C21347D",
    "colorSpaceName": "sRGB",
    "semanticClass": "theme.dark.brb_theme",
    "author": "Chris M",
    "$schema": "vscode://schemas/color-theme"
