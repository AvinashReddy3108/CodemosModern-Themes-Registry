{
    "name": "Windows 12 Concept",
    "type": "light",
    "colors": {
        "editor.background": "#ffffff",
        "editor.foreground": "#012a8a",
        "activityBar.background": "#b5bbe7",
        "activityBar.foreground": "#262734",
        "activityBar.inactiveForeground": "#262734",
        "activityBar.activeBackground": "#969fe0",
        "activityBarBadge.background": "#cdcfec",
        "activityBarBadge.foreground": "#000000",
        "statusBar.foreground": "#ffffff",
        "statusBar.background": "#7378d6",
        "editorSuggestWidget.selectedIconForeground": "#0ca7ea",
        "editorSuggestWidget.selectedBackground": "#ccdaf9",
        "sideBar.background": "#fafafa",
        "sideBar.foreground": "#000000",
        "sideBarSectionHeader.background": "#cdcffa",
        "titleBar.activeBackground": "#f5f8ff",
        "tab.inactiveBackground": "#ebf1ff"
    },
    "tokenColors": [
        {
            "scope": ["comment"],
            "settings": { "foreground": "#7e7e7e", "fontStyle": "italic" }
        },
        {
            "scope": [
                "variable",
                "support.type.property-name.css",
                "support.type.property-name.json",
                "support.function.builtin",
                "markup.underline.link.markdown"
            ],
            "settings": { "foreground": "#e88803" }
        },
        {
            "scope": ["string", "constant", "support.constant"],
            "settings": { "foreground": "#25c505" }
        },
        {
            "scope": [
                "keyword",
                "constant.numeric.css",
                "entity.other.attribute-name.html"
            ],
            "settings": { "foreground": "#0592de" }
        },
        { "scope": "storage", "settings": { "foreground": "#a306b8" } },
        {
            "scope": [
                "entity",
                "punctuation.definition.tag",
                "markup.heading.markdown"
            ],
            "settings": { "foreground": "#ef1010" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
