    "tokenColors": [
        {
            "scope": [
                "meta.embedded",
                "source.groovy.embedded",
                "string meta.image.inline.markdown"
            ],
            "settings": { "foreground": "#DEE0E3" }
        },
        { "scope": "emphasis", "settings": { "fontStyle": "italic" } },
        { "scope": "strong", "settings": { "fontStyle": "bold" } },
        { "scope": "header", "settings": { "foreground": "#000080" } },
        { "scope": "comment", "settings": { "foreground": "#6272A4" } },
        {
            "scope": "constant.language",
            "settings": { "foreground": "#F3AFE6" }
        },
        {
            "scope": [
                "constant.numeric",
                "variable.other.enummember",
                "keyword.operator.plus.exponent",
                "keyword.operator.minus.exponent"
            ],
            "settings": { "foreground": "#C8F1BA" }
        },
        { "scope": "constant.regexp", "settings": { "foreground": "#646695" } },
        { "scope": "entity.name.tag", "settings": { "foreground": "#F3AFE6" } },
        {
            "scope": "entity.name.tag.css",
            "settings": { "foreground": "#F3AFE6" }
        },
        {
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#B6F6FD" }
        },
        {
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.class.mixin.css",
                "entity.other.attribute-name.id.css",
                "entity.other.attribute-name.parent-selector.css",
                "entity.other.attribute-name.pseudo-class.css",
                "entity.other.attribute-name.pseudo-element.css",
                "source.css.less entity.other.attribute-name.id",
                "entity.other.attribute-name.scss"
            ],
            "settings": { "foreground": "#F3AFE6" }
        },
        { "scope": "invalid", "settings": { "foreground": "#F09489" } },
        {
            "scope": "markup.italic",
            "settings": { "foreground": "#FFCA92", "fontStyle": "italic" }
        },
        {
            "scope": "markup.strikethrough",
            "settings": { "fontStyle": "strikethrough" }
        },
        {
            "scope": "markup.underline",
            "settings": { "foreground": "#FFCA92", "fontStyle": "underline" }
        },
        {
            "scope": "markup.bold",
            "settings": { "foreground": "#FFCA92", "fontStyle": "bold" }
        },
        {
            "scope": "markup.heading",
            "settings": { "foreground": "#F3AFE6", "fontStyle": "bold" }
        },
        { "scope": "markup.inserted", "settings": { "foreground": "#C8F1BA" } },
        {
            "scope": ["markup.deleted", "markup.inline.raw"],
            "settings": { "foreground": "#F6FACA" }
        },
        { "scope": "markup.changed", "settings": { "foreground": "#F3AFE6" } },
        {
            "scope": [
                "punctuation.definition.list.begin.markdown",
                "punctuation.definition.quote.begin.markdown"
            ],
            "settings": { "foreground": "#CAA9FA" }
        },
        {
            "scope": "punctuation.definition.tag",
            "settings": { "foreground": "#676E79" }
        },
        {
            "scope": ["meta.preprocessor", "entity.name.function.preprocessor"],
            "settings": { "foreground": "#F3AFE6" }
        },
        {
            "scope": "meta.preprocessor.string",
            "settings": { "foreground": "#F6FACA" }
        },
        {
            "scope": "meta.preprocessor.numeric",
            "settings": { "foreground": "#C8F1BA" }
        },
        {
            "scope": "meta.structure.dictionary.key.python",
