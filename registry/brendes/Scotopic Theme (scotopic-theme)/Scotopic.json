{
    "$schema": "vscode://schemas/color-theme",
    "name": "Scotopic",
    "type": "dark",
    "tokenColors": [
        {
            "name": "Keywords and Operators",
            "scope": ["keyword", "storage.modifier"],
            "settings": { "foreground": "#ee8888" }
        },
        {
            "name": "Strings, constants, numbers, characters",
            "scope": ["string", "markup.inline.raw"],
            "settings": { "foreground": "#ee8888c8" }
        },
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#ee88889b" }
        },
        {
            "name": "Errors",
            "scope": "invalid.illegal",
            "settings": { "foreground": "#ee8888" }
        },
        {
            "name": "Sections and headings",
            "scope": "entity.name.section.markdown",
            "settings": { "foreground": "#ee8888", "fontStyle": "bold" }
        },
        {
            "name": "Uncolored overrides",
            "scope": [
                "entity.name.tag.yaml",
                "punctuation.section.block",
                "support.type.property-name.json"
            ],
            "settings": { "foreground": "#ee8888" }
        }
    ],
