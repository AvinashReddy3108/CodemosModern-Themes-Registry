{
    "$schema": "vscode://schemas/color-theme",
    "name": "Logos Nord",
    "type": "dark",
    "tokenColors": [
        {
            "name": "Keywords and Operators",
            "scope": ["keyword", "storage.modifier"],
            "settings": { "foreground": "#d8dee9" }
        },
        {
            "name": "Strings",
            "scope": ["string"],
            "settings": { "foreground": "#d8dee9a8" }
        },
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#d8dee978" }
        },
        {
            "name": "Errors",
            "scope": ["invalid.illegal"],
            "settings": { "foreground": "#bf616a" }
        },
        {
            "name": "Sections and headings",
            "scope": [
                "entity.name.section.markdown",
                "heading",
                "markup.heading"
            ],
            "settings": { "foreground": "#d8dee9", "fontStyle": "bold" }
        },
        {
            "name": "Inline code",
            "scope": ["markup.inline"],
            "settings": { "foreground": "#b48ead" }
        },
        {
            "name": "Uncolored overrides",
            "scope": [
                "entity.name.tag.yaml",
                "punctuation.section.block",
                "support.type.property-name.json"
            ],
            "settings": { "foreground": "#d8dee9" }
        }
    ],
