{
    "$schema": "vscode://schemas/color-theme",
    "name": "Logos Acme",
    "type": "light",
    "tokenColors": [
        {
            "name": "Keywords and Operators",
            "scope": ["keyword", "storage.modifier"],
            "settings": { "foreground": "#000000" }
        },
        {
            "name": "Strings",
            "scope": ["string"],
            "settings": { "foreground": "#00000098" }
        },
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#00000068" }
        },
        {
            "name": "Errors",
            "scope": ["invalid.illegal"],
            "settings": { "foreground": "#bb5d5d" }
        },
        {
            "name": "Sections and headings",
            "scope": [
                "entity.name.section.markdown",
                "heading",
                "markup.heading"
            ],
            "settings": { "foreground": "#000000", "fontStyle": "bold" }
        },
        {
            "name": "Inline code",
            "scope": ["markup.inline"],
            "settings": { "foreground": "#bb6677" }
        },
        {
            "name": "Uncolored overrides",
            "scope": [
                "entity.name.tag.yaml",
                "punctuation.section.block",
                "support.type.property-name.json"
            ],
            "settings": { "foreground": "#000000" }
        }
    ],
