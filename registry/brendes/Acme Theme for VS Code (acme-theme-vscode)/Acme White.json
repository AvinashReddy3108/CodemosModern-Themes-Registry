{
    "$schema": "vscode://schemas/color-theme",
    "name": "Acme White",
    "type": "light",
    "semanticHighlighting": true,
    "tokenColors": [
        {
            "name": "Comments",
            "scope": [
                "comment",
                "punctuation.definition.comment",
                "string.quoted.docstring"
            ],
            "settings": { "foreground": "#00000078" }
        },
        {
            "name": "No highlighting",
            "scope": [
                "constant",
                "constant.character.escape",
                "entity.other.attribute-name.id",
                "support.constant",
                "string"
            ],
            "settings": { "foreground": "#000000" }
        },
        {
            "name": "Errors",
            "scope": ["entity.name.exception", "invalid.illegal"],
            "settings": { "foreground": "#bb5d5d" }
        },
        {
            "name": "Sections and headings",
            "scope": ["entity.name.section.markdown"],
            "settings": { "foreground": "#000000", "fontStyle": "bold" }
        }
    ],
    "colors": {
        "descriptionForeground": "#000000",
        "disabledForeground": "#00000078",
