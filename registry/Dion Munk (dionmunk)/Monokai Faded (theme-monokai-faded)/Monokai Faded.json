    "tokenColors": [
        { "settings": { "background": "#282828", "foreground": "#f8f8f8" } },
        {
            "scope": ["meta.embedded", "source.groovy.embedded"],
            "settings": { "background": "#282828", "foreground": "#f8f8f8" }
        },
        {
            "name": "Comment",
            "scope": "comment",
            "settings": { "foreground": "#666666" }
        },
        {
            "name": "String",
            "scope": "string",
            "settings": { "foreground": "#e0d77b" }
        },
        {
            "name": "Template Definition",
            "scope": [
                "punctuation.definition.template-expression",
                "punctuation.section.embedded"
            ],
            "settings": { "foreground": "#df5077" }
        },
        {
            "name": "Reset JavaScript string interpolation expression",
            "scope": ["meta.template.expression"],
            "settings": { "foreground": "#f8f8f8" }
        },
        {
            "name": "Built-in constant",
            "scope": "constant.language",
            "settings": { "foreground": "#7d72c8" }
        },
        {
            "name": "User-defined constant",
            "scope": "constant.character, constant.other",
            "settings": { "foreground": "#7d72c8" }
        },
        {
            "name": "Numeric suffix",
            "scope": "numeric-suffix",
            "settings": { "fontStyle": "italic", "foreground": "#74c5d9" }
        },
        {
            "name": "Number",
            "scope": "constant.numeric",
            "settings": { "foreground": "#7d72c8" }
        },
        {
            "name": "Variable",
            "scope": "variable",
            "settings": { "fontStyle": "", "foreground": "#f8f8f8" }
        },
        {
            "name": "Punctuation tilde ~",
            "scope": "punctuation.tilde",
            "settings": { "fontStyle": "", "foreground": "#b5d93f" }
        },
        {
            "name": "Punctuation brackets attribute",
            "scope": "punctuation.squarebracket-attribute",
            "settings": { "fontStyle": "", "foreground": "#df5077" }
        },
        {
            "name": "Keyword type",
            "scope": "keyword.type",
            "settings": { "fontStyle": "italic", "foreground": "#74c5d9" }
        },
        {
            "name": "Keyword",
            "scope": "keyword",
            "settings": { "fontStyle": "", "foreground": "#df5077" }
        },
        {
            "name": "Keyword other class",
            "scope": "keyword.other.class",
            "settings": { "fontStyle": "italic", "foreground": "#74c5d9" }
        },
        {
            "name": "Storage",
            "scope": "storage",
            "settings": { "fontStyle": "", "foreground": "#df5077" }
        },
        {
            "name": "Function call",
            "scope": "meta.function-call",
            "settings": { "fontStyle": "", "foreground": "#74c5d9" }
        },
        {
            "name": "Meta function call and type-parameter",
            "scope": "storage.type, entity.name.type.type-parameter",
            "settings": { "fontStyle": "italic", "foreground": "#74c5d9" }
        },
        {
            "name": "La f del 10.0f",
            "scope": "storage.type.numeric",
            "settings": { "fontStyle": "italic", "foreground": "#74c5d9" }
        },
        {
            "name": "Class name",
            "scope": "entity.name.type, entity.name.class",
            "settings": { "foreground": "#b5d93f" }
        },
        {
            "name": "Parameters and this",
            "scope": "entity.name.variable.parameter, keyword.other.this, keyword.other.base",
            "settings": { "fontStyle": "italic", "foreground": "#ea9b40" }
        },
        {
            "name": "Class name",
            "scope": "entity.name.type.namespace",
            "settings": { "foreground": "#ffffff" }
        },
        {
            "name": "Inherited class",
            "scope": "entity.other.inherited-class",
            "settings": {
                "fontStyle": "italic underline",
                "foreground": "#b5d93f"
            }
        },
        {
            "name": "Function name",
            "scope": "entity.name.function",
            "settings": { "fontStyle": "", "foreground": "#b5d93f" }
        },
        {
            "name": "Inheritance",
            "scope": "inherit-class",
            "settings": { "fontStyle": "", "foreground": "#b5d93f" }
        },
        {
            "name": "Function argument",
            "scope": "variable.parameter",
            "settings": { "fontStyle": "italic", "foreground": "#ea9b40" }
        },
        {
            "name": "Tag name",
            "scope": "entity.name.tag",
            "settings": { "fontStyle": "", "foreground": "#df5077" }
        },
        {
            "name": "Tag attribute",
            "scope": "entity.other.attribute-name",
            "settings": { "fontStyle": "", "foreground": "#b5d93f" }
        },
        {
            "name": "Library function",
            "scope": "support.function",
            "settings": { "fontStyle": "", "foreground": "#74c5d9" }
        },
        {
            "name": "Library constant",
            "scope": "support.constant",
            "settings": { "fontStyle": "", "foreground": "#74c5d9" }
        },
        {
            "name": "Library class/type",
            "scope": "support.type, support.class",
            "settings": { "fontStyle": "italic", "foreground": "#74c5d9" }
        },
        {
            "name": "Library variable",
            "scope": "support.other.variable",
            "settings": { "fontStyle": "" }
        },
        {
            "name": "Invalid",
            "scope": "invalid",
            "settings": {
                "background": "#df5077",
                "fontStyle": "",
                "foreground": "#f8f8f8"
            }
        },
        {
            "name": "Invalid deprecated",
            "scope": "invalid.deprecated",
            "settings": { "background": "#7d72c8", "foreground": "#f8f8f8" }
        },
        {
            "name": "JSON String",
            "scope": "meta.structure.dictionary.json string.quoted.double.json",
            "settings": { "foreground": "#CFCFC2" }
        },
        {
            "name": "diff.header",
            "scope": "meta.diff, meta.diff.header",
            "settings": { "foreground": "#75715e" }
        },
        {
            "name": "diff.deleted",
            "scope": "markup.deleted",
            "settings": { "foreground": "#df5077" }
        },
        {
            "name": "diff.inserted",
            "scope": "markup.inserted",
            "settings": { "foreground": "#b5d93f" }
        },
        {
            "name": "diff.changed",
            "scope": "markup.changed",
            "settings": { "foreground": "#e0d77b" }
        },
        {
            "scope": "constant.numeric.line-number.find-in-files - match",
            "settings": { "foreground": "#7d72c8A0" }
        },
        {
            "scope": "entity.name.filename.find-in-files",
            "settings": { "foreground": "#e0d77b" }
        },
        {
            "name": "Markup Quote",
            "scope": "markup.quote",
            "settings": { "foreground": "#df5077" }
        },
        {
            "name": "Markup Lists",
            "scope": "markup.list",
            "settings": { "foreground": "#e0d77b" }
        },
        {
            "name": "Markup Styling",
            "scope": "markup.bold, markup.italic",
            "settings": { "foreground": "#74c5d9" }
        },
        {
            "name": "Markup Inline",
            "scope": "markup.inline.raw",
            "settings": { "fontStyle": "", "foreground": "#ea9b40" }
        },
        {
            "name": "Markup Headings",
            "scope": "markup.heading",
            "settings": { "foreground": "#b5d93f" }
        },
        {
            "name": "Markup Setext Header",
            "scope": "markup.heading.setext",
            "settings": { "fontStyle": "", "foreground": "#b5d93f" }
        },
        {
            "scope": "token.info-token",
            "settings": { "foreground": "#74c5d9" }
        },
        {
            "scope": "token.warn-token",
            "settings": { "foreground": "#ea9b40" }
        },
        {
            "scope": "token.error-token",
            "settings": { "foreground": "#d13b2e" }
        },
        {
            "scope": "token.debug-token",
            "settings": { "foreground": "#7d72c8" }
        },
        {
            "name": "this.self",
            "scope": "variable.language",
            "settings": { "foreground": "#ea9b40" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
