    "tokenColors": [
        {
            "name": "Comment",
            "scope": [
                "comment",
                "comment.block",
                "comment.block.documentation",
                "comment.line",
                "comment.line.double-slash",
                "comment.single",
                "punctuation.definition.comment",
                "storage.type.class.jsdoc"
            ],
            "settings": { "foreground": "#8B2D7Abf", "fontStyle": "italic" }
        },
        {
            "name": "Built-in Constants",
            "scope": [
                "constant.language",
                "constant.language.boolean",
                "constant.language.import-export-all",
                "constant.language.null",
                "constant.language.symbol"
            ],
            "settings": { "foreground": "#47C431", "fontStyle": "bold" }
        },
        {
            "name": "Constant",
            "scope": [
                "constant",
                "constant.character",
                "constant.character.escpae",
                "constant.numeric",
                "constant.numeric.complex",
                "constant.numeric.float",
                "constant.numeric.integer",
                "constant.other",
                "constant.other.placeholder"
            ],
            "settings": { "foreground": "#41A030", "fontStyle": "bold" }
        },
        {
            "name": "Property Name",
            "scope": [
                "support.type.property-name",
                "support.type.property-name.class"
            ],
            "settings": { "foreground": "#2D8B5D", "fontStyle": "bold" }
        },
        {
            "name": "Interpolated and Regex",
            "scope": [
                "string.interpolated",
                "string.regexp",
                "string.template"
            ],
            "settings": { "background": "#47C43180", "fontStyle": "underline" }
        },
        {
            "name": "String",
            "scope": [
                "string",
                "string.literal",
                "string.other",
                "string.quoted",
                "string.quoted.double",
                "string.quoted.other",
                "string.quoted.single",
                "string.quoted.triple",
                "string.unquoted"
            ],
            "settings": { "foreground": "#31C44C" }
        },
        {
            "name": "Interpolation",
            "scope": [
                "meta.interpolation",
                "meta.template",
                "meta.template.expression"
            ],
            "settings": { "background": "#47C431", "fontStyle": "underline" }
        },
        {
            "name": "Language Variable",
            "scope": [
                "variable.language",
                "variable.language.super",
                "variable.language.this",
                "variable.other.object.property"
            ],
            "settings": { "foreground": "#41A030", "fontStyle": "italic" }
        },
        {
            "name": "Variable",
            "scope": [
                "variable",
                "variable.annotation",
                "variable.function",
                "variable.member",
                "variable.other.constant",
                "variable.other.readwrite",
                "variable.other.readwrite.alias",
                "variable.parameter"
            ],
            "settings": { "foreground": "#30A044" }
        },
        {
            "name": "Storage",
            "scope": [
                "storage",
                "storage.modifier",
                "storage.type",
                "storage.type.function"
            ],
            "settings": { "foreground": "#41A030", "fontStyle": "bold" }
        },
        {
            "name": "Operator",
            "scope": [
                "keyword.operator",
                "keyword.operator.arithmetic",
                "keyword.operator.assignment",
                "keyword.operator.bitwise",
                "keyword.operator.logical",
                "keyword.operator.word"
            ],
            "settings": { "foreground": "#47C431" }
        },
        {
            "name": "Keyword",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.control.conditional",
                "keyword.control.export",
                "keyword.control.flow",
                "keyword.control.from",
                "keyword.control.import",
                "keyword.other"
            ],
            "settings": { "foreground": "#47C431", "fontStyle": "bold" }
        },
        {
            "name": "Seperators and Terminators",
            "scope": [
                "punctuation.separator",
                "punctuation.separator.array",
                "punctuation.separator.continuation",
                "punctuation.separator.dictionary",
                "punctuation.terminator",
                "punctuation.terminator.array",
                "punctuation.terminator.dictionary"
            ],
            "settings": { "foreground": "#8B2D7Abf", "fontStyle": "bold" }
        },
        {
            "name": "Tag start/end",
            "scope": [
                "punctuation.definition.tag",
                "punctuation.definition.tag.begin",
                "punctuation.definition.tag.end"
            ],
            "settings": { "foreground": "#8B2D7A80" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation",
                "punctuation.accessor",
                "punctuation.definition",
                "punctuation.definition.array",
                "punctuation.definition.block",
                "punctuation.definition.dictionary",
                "punctuation.definition.heading",
                "punctuation.definition.list",
                "punctuation.definition.parameters",
                "punctuation.definition.quote",
                "punctuation.definition.string",
                "punctuation.definition.string.begin",
                "punctuation.definition.string.end",
                "punctuation.definition.template-expression",
                "punctuation.definition.template-expression.begin",
                "punctuation.definition.template-expression.end",
                "punctuation.definition.typeparameters",
                "punctuation.definition.variable",
                "punctuation.section",
                "punctuation.section.interpolation",
                "punctuation.section.interpolation.begin",
                "punctuation.section.interpolation.end"
            ],
            "settings": { "foreground": "#8B2D7A", "fontStyle": "bold" }
        },
        {
            "name": "Markup Bold and Headings",
            "scope": ["markup.bold", "markup.heading"],
            "settings": { "foreground": "#8B2D7A", "fontStyle": "bold" }
        },
        {
            "name": "Markup Italic and Quotes",
            "scope": ["markup.italic", "markup.quote"],
            "settings": { "foreground": "#8B2D7A", "fontStyle": "italic" }
        },
        {
            "name": "Markup",
            "scope": [
                "markup",
                "markup.fenced_code",
                "markup.underline",
                "markup.underline.link"
            ],
            "settings": { "foreground": "#8B2D7A" }
        },
        {
            "name": "Class inheritance",
            "scope": ["entity.other.inherited-class"],
            "settings": { "foreground": "#357629", "fontStyle": "underline" }
        },
        {
            "name": "Entity 1",
            "scope": [
                "entity.other",
                "entity.other.attribute-name",
                "entity.other.attribute-name.class",
                "entity.other.attribute-name.id"
            ],
            "settings": { "foreground": "#357629" }
        },
        {
            "name": "Entity 2",
            "scope": [
                "entity",
                "entity.name",
                "entity.name.class",
                "entity.name.enum",
                "entity.name.function",
                "entity.name.function.constructor",
                "entity.name.function.destructor",
                "entity.name.impl",
                "entity.name.interface",
                "entity.name.section",
                "entity.name.struct",
                "entity.name.tag",
                "entity.name.tag.reference",
                "entity.name.tag.yaml",
                "entity.name.trait",
                "entity.name.type",
                "entity.name.type.module",
                "entity.name.union"
            ],
            "settings": { "foreground": "#3B8B2D" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.deprecated", "invalid.illegal"],
            "settings": { "foreground": "#A03043", "fontStyle": "bold" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
