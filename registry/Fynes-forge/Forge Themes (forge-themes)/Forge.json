    },
    "semanticTokenColors": {
        "variable": "#B7C3F3",
        "variable.readonly": "#AED6F1",
        "parameter": "#AED6F1",
        "function": "#63C5EA",
        "method": "#63C5EA",
        "class": "#ECDA90",
        "interface": "#ECDA90",
        "type": "#ECDA90",
        "enum": "#ECDA90",
        "enumMember": "#D05786",
        "property": "#ECDA90",
        "namespace": "#B7C3F3",
        "keyword": "#DD7596",
        "modifier": "#DD7596",
        "string": "#83AFDF",
        "number": "#D05786",
        "regexp": "#63C5EA",
        "operator": "#9F7EBE",
        "decorator": "#ECDA90",
        "comment": { "foreground": "#4F6272CC", "fontStyle": "italic" },
        "selfParameter": { "foreground": "#DD7596", "fontStyle": "italic" },
        "builtinType": { "foreground": "#ECDA90", "fontStyle": "italic" }
    },
    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#4F6272CC", "fontStyle": "italic" }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.new",
                "keyword.operator.delete",
                "keyword.operator.typeof",
                "keyword.operator.void",
                "storage.type.class",
                "storage.type.function",
                "storage.type.interface",
                "storage.modifier"
            ],
            "settings": { "foreground": "#DD7596" }
        },
        {
            "name": "Storage types (const, let, var, type)",
            "scope": ["storage.type", "keyword.operator.type.annotation"],
            "settings": { "foreground": "#DD7596", "fontStyle": "italic" }
        },
        {
            "name": "Strings",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#83AFDF" }
        },
        {
            "name": "Template literal expressions",
            "scope": [
                "punctuation.definition.template-expression",
                "string.template punctuation"
            ],
            "settings": { "foreground": "#9F7EBE" }
        },
        {
            "name": "Numbers",
            "scope": [
                "constant.numeric",
                "constant.numeric.decimal",
                "constant.numeric.hex"
            ],
            "settings": { "foreground": "#D05786" }
        },
        {
            "name": "Constants & language literals",
            "scope": [
                "constant.language",
                "constant.language.boolean",
                "constant.language.null",
                "constant.language.undefined"
            ],
            "settings": { "foreground": "#D05786", "fontStyle": "italic" }
        },
        {
            "name": "Named constants (ALL_CAPS)",
            "scope": ["variable.other.constant", "constant.other"],
            "settings": { "foreground": "#D05786" }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call entity.name.function",
                "meta.method-call entity.name.function"
            ],
            "settings": { "foreground": "#63C5EA" }
        },
        {
            "name": "Function parameters",
            "scope": ["variable.parameter", "meta.parameters variable.other"],
            "settings": { "foreground": "#AED6F1" }
        },
        {
            "name": "Classes & constructors",
            "scope": [
                "entity.name.class",
                "entity.name.type.class",
                "support.class",
                "new.expr entity.name.class"
            ],
            "settings": { "foreground": "#ECDA90" }
        },
        {
            "name": "Interfaces & types (TypeScript)",
            "scope": [
                "entity.name.type.interface",
                "entity.name.type.alias",
                "entity.name.type",
                "support.type"
            ],
            "settings": { "foreground": "#ECDA90", "fontStyle": "italic" }
        },
        {
            "name": "Type annotations (: Type)",
            "scope": [
                "meta.type.annotation",
                "meta.type.parameters",
                "meta.return.type"
            ],
            "settings": { "foreground": "#ECDA90D9" }
        },
        {
            "name": "Generics angle brackets",
            "scope": [
                "punctuation.definition.typeparameters",
                "meta.type.parameters punctuation"
            ],
            "settings": { "foreground": "#9F7EBE" }
        },
        {
            "name": "Object properties / JSON keys",
            "scope": [
                "support.type.property-name",
                "variable.other.property",
                "meta.object-literal.key",
                "meta.object.member entity.name.tag"
            ],
            "settings": { "foreground": "#ECDA90" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation",
                "meta.brace",
                "punctuation.separator",
                "punctuation.terminator",
                "punctuation.accessor"
            ],
            "settings": { "foreground": "#9F7EBE" }
        },
        {
            "name": "Operators",
            "scope": [
                "keyword.operator",
                "keyword.operator.arithmetic",
                "keyword.operator.comparison",
                "keyword.operator.logical",
                "keyword.operator.assignment"
            ],
            "settings": { "foreground": "#9F7EBE" }
        },
        {
            "name": "Imports & modules",
            "scope": [
                "keyword.control.import",
                "keyword.control.export",
                "keyword.control.from"
            ],
            "settings": { "foreground": "#DD7596" }
        },
        {
            "name": "This / self",
            "scope": ["variable.language.this", "variable.language.self"],
            "settings": { "foreground": "#DD7596", "fontStyle": "italic" }
        },
        {
            "name": "Decorators / annotations",
            "scope": [
                "punctuation.decorator",
                "meta.decorator",
                "entity.name.function.decorator"
            ],
            "settings": { "foreground": "#ECDA90", "fontStyle": "italic" }
        },
        {
            "name": "Enums",
            "scope": ["entity.name.type.enum", "constant.other.enum"],
            "settings": { "foreground": "#ECDA90" }
        },
        {
            "name": "Enum members",
            "scope": ["variable.other.enummember"],
            "settings": { "foreground": "#D05786" }
        },
        {
            "name": "Regex",
            "scope": ["string.regexp", "constant.other.character-class.regexp"],
            "settings": { "foreground": "#63C5EA" }
        },
        {
            "name": "HTML tags",
            "scope": ["entity.name.tag", "meta.tag entity.name.tag"],
            "settings": { "foreground": "#DD7596" }
        },
        {
            "name": "HTML/JSX attributes",
            "scope": [
                "entity.other.attribute-name",
                "meta.tag entity.other.attribute-name"
            ],
            "settings": { "foreground": "#ECDA90" }
        },
        {
            "name": "CSS selectors",
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css"
            ],
            "settings": { "foreground": "#ECDA90" }
        },
        {
            "name": "CSS properties",
            "scope": ["support.type.property-name.css", "meta.property-name"],
            "settings": { "foreground": "#63C5EA" }
        },
        {
            "name": "CSS values",
            "scope": [
                "support.constant.property-value",
                "meta.property-value constant"
            ],
            "settings": { "foreground": "#83AFDF" }
        },
        {
            "name": "Markdown headings",
            "scope": ["markup.heading", "entity.name.section"],
            "settings": { "foreground": "#ECDA90", "fontStyle": "bold" }
        },
        {
            "name": "Markdown bold",
            "scope": ["markup.bold", "punctuation.definition.bold"],
            "settings": { "foreground": "#B7C3F3", "fontStyle": "bold" }
        },
        {
            "name": "Markdown italic",
            "scope": ["markup.italic", "punctuation.definition.italic"],
            "settings": { "foreground": "#B7C3F3", "fontStyle": "italic" }
        },
        {
            "name": "Markdown code",
            "scope": ["markup.inline.raw", "markup.raw"],
            "settings": { "foreground": "#63C5EA" }
        },
        {
            "name": "Markdown links",
            "scope": ["markup.underline.link", "meta.link"],
            "settings": { "foreground": "#83AFDF" }
        },
        {
            "name": "Invalid / deprecated",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#E06C75" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
