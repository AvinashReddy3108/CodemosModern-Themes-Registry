    "tokenColors": [
        { "settings": { "background": "#232530", "foreground": "#EDEFFC" } },
        { "scope": "source", "settings": { "foreground": "#EDEFFC" } },
        {
            "name": "Braces",
            "scope": [
                "meta.brace.curly",
                "meta.brace.round",
                "meta.brace.square",
                "meta.block",
                "meta.structure.dictionary",
                "punctuation.section",
                "punctuation.definition.block",
                "punctuation.definition.parameters",
                "meta.var.expr punctuation.definition.binding-pattern",
                "meta.var.expr meta.object-binding-pattern-variable",
                "punctuation.definition.arguments",
                "punctuation.definition.inheritance",
                "punctuation.definition.list",
                "punctuation.parenthesis",
                "punctuation.definition.dict",
                "meta.function.decorator meta.function-call punctuation.definition.arguments"
            ],
            "settings": { "foreground": "#4DC7FF" }
        },
        {
            "name": "Fix JSX string children",
            "scope": ["meta.block meta.jsx.children"],
            "settings": { "foreground": "#EDEFFC" }
        },
        {
            "name": "Comment",
            "scope": ["comment"],
            "settings": { "fontStyle": "italic", "foreground": "#6A708C" }
        },
        {
            "name": "String",
            "scope": [
                "string",
                "constant.other.symbol",
                "constant.character.format.placeholder"
            ],
            "settings": { "foreground": "#E8A3FE" }
        },
        {
            "name": "Quotes",
            "scope": [
                "punctuation.definition.string",
                "punctuation.support.type.property-name",
                "punctuation.definition.string string.quoted.single"
            ],
            "settings": { "foreground": "#4DC7FF", "fontStyle": "bold" }
        },
        {
            "name": "String Regexp",
            "scope": ["string.regexp"],
            "settings": { "foreground": "#E8A3FE" }
        },
        {
            "name": "Regular Expressions",
            "scope": [
                "constant.character",
                "constant.other",
                "punctuation.definition.group.regexp"
            ],
            "settings": { "foreground": "#84F5E5" }
        },
        {
            "name": "Escape Characters",
            "scope": ["constant.character.escape.backslash.regexp"],
            "settings": { "foreground": "#FF8FEC" }
        },
        {
            "name": "Anchor Escape Characters",
            "scope": ["keyword.control.anchor.regexp"],
            "settings": {}
        },
        {
            "name": "Number, Boolean, Undefined, Null",
            "scope": [
                "punctuation.definition.constant",
                "constant.language",
                "constant.numeric",
                "support.constant",
                "constant.language.null",
                "constant.language.undefined",
                "constant.language.go",
                "constant.language.boolean",
                "constant.language.json",
                "constant.language.infinity",
                "constant.language.nan"
            ],
            "settings": { "foreground": "#FF8FEC" }
        },
        {
            "name": "Variable",
            "scope": ["variable"],
            "settings": { "foreground": "#EDEFFC" }
        },
        {
            "name": "Member Variable",
            "scope": ["variable.member"],
            "settings": { "foreground": "#4DC7FF" }
        },
        {
            "name": "Language variable",
            "scope": ["variable.language"],
            "settings": { "fontStyle": "italic", "foreground": "#5FE8FA" }
        },
        {
            "name": "Storage",
            "scope": ["storage"],
            "settings": { "foreground": "#4DC7FF" }
        },
        {
            "name": "Keyword",
            "scope": ["keyword"],
            "settings": { "foreground": "#4DC7FF" }
        },
        {
            "name": "Operators",
            "scope": [
                "keyword.operator",
                "text.xml meta.tag.xml",
                "text.html.derivative punctuation.separator",
                "text.html.dust punctuation.separator"
            ],
            "settings": { "foreground": "#4DC7FF" }
        },
        {
            "name": "Separators like ; or ,",
            "scope": [
                "punctuation.separator",
                "punctuation.terminator",
                "meta.delimiter.comma"
            ],
            "settings": { "foreground": "#4DC7FF" }
        },
        {
            "name": "Accessor",
            "scope": ["punctuation.accessor"],
            "settings": { "foreground": "#4DC7FF" }
        },
        {
            "name": "Types fixes",
            "scope": [
                "source.java storage.type",
                "source.haskell storage.type",
                "source.c storage.type",
                "meta.type.parameters"
            ],
            "settings": { "foreground": "#4DC7FF" }
        },
        {
            "name": "Inherited class type",
            "scope": ["entity.other.inherited-class"],
            "settings": { "foreground": "#5FE8FA" }
        },
        {
            "name": "Lambda arrow",
            "scope": ["storage.type.function"],
            "settings": { "foreground": "#4DC7FF", "fontStyle": "bold" }
        },
        {
            "name": "Java primitive variable types",
            "scope": ["source.java storage.type.primitive"],
            "settings": { "foreground": "#5FE8FA" }
        },
        {
            "name": "Function name",
            "scope": [
                "meta.function entity.name.function",
                "entity.name.function.member",
                "meta.function-call entity.name.function",
                "entity.name.function"
            ],
            "settings": { "foreground": "#37B9F2" }
        },
