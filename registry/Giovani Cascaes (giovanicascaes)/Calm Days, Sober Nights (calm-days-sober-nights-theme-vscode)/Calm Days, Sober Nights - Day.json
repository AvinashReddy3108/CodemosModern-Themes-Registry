    "tokenColors": [
        { "settings": { "background": "#F0F4F7", "foreground": "#687685" } },
        { "scope": "source", "settings": { "foreground": "#687685" } },
        {
            "name": "Braces",
            "scope": [
                "meta.brace.curly",
                "meta.brace.round",
                "meta.brace.square",
                "meta.block",
                "meta.structure.dictionary",
                "punctuation.section",
                "punctuation.definition.block",
                "punctuation.definition.parameters",
                "meta.var.expr punctuation.definition.binding-pattern",
                "meta.var.expr meta.object-binding-pattern-variable",
                "meta.var.expr meta.object-binding-pattern-variable",
                "punctuation.definition.arguments",
                "punctuation.definition.inheritance",
                "punctuation.definition.list",
                "punctuation.parenthesis",
                "punctuation.definition.dict",
                "meta.function.decorator meta.function-call punctuation.definition.arguments"
            ],
            "settings": { "foreground": "#48A2C9" }
        },
        {
            "name": "Fix JSX string children",
            "scope": ["meta.block meta.jsx.children"],
            "settings": { "foreground": "#687685" }
        },
        {
            "name": "Comment",
            "scope": ["comment"],
            "settings": { "fontStyle": "italic", "foreground": "#9FB3C7" }
        },
        {
            "name": "String",
            "scope": [
                "string",
                "constant.other.symbol",
                "constant.character.format.placeholder"
            ],
            "settings": { "foreground": "#744682" }
        },
        {
            "name": "Quotes",
            "scope": [
                "punctuation.definition.string",
                "punctuation.support.type.property-name",
                "punctuation.definition.string string.quoted.single"
            ],
            "settings": { "foreground": "#48A2C9", "fontStyle": "bold" }
        },
        {
            "name": "String Regexp",
            "scope": ["string.regexp"],
            "settings": { "foreground": "#744682" }
        },
        {
            "name": "Regular Expressions",
            "scope": [
                "constant.character",
                "constant.other",
                "punctuation.definition.group.regexp"
            ],
            "settings": { "foreground": "#00A890" }
        },
        {
            "name": "Escape Characters",
            "scope": ["constant.character.escape.backslash.regexp"],
            "settings": { "foreground": "#994D8C" }
        },
        {
            "name": "Anchor Escape Characters",
            "scope": ["keyword.control.anchor.regexp"],
            "settings": {}
        },
        {
            "name": "Number, Boolean, Undefined, Null",
            "scope": [
                "punctuation.definition.constant",
                "constant.language",
                "constant.numeric",
                "support.constant",
                "constant.language.null",
                "constant.language.undefined",
                "constant.language.go",
                "constant.language.boolean",
                "constant.language.json",
                "constant.language.infinity",
                "constant.language.nan"
            ],
            "settings": { "foreground": "#994D8C" }
        },
        {
            "name": "Variable",
            "scope": ["variable"],
            "settings": { "foreground": "#687685" }
        },
        {
            "name": "Member Variable",
            "scope": ["variable.member"],
            "settings": { "foreground": "#48A2C9" }
        },
        {
            "name": "Storage",
            "scope": ["storage"],
            "settings": { "foreground": "#48A2C9" }
        },
        {
            "name": "Keyword",
            "scope": ["keyword"],
            "settings": { "foreground": "#48A2C9" }
        },
        {
            "name": "Operators",
            "scope": [
                "keyword.operator",
                "text.xml meta.tag.xml",
                "text.html.derivative punctuation.separator",
                "text.html.dust punctuation.separator"
            ],
            "settings": { "foreground": "#48A2C9" }
        },
        {
            "name": "Separators like ; or ,",
            "scope": [
                "punctuation.separator",
                "punctuation.terminator",
                "meta.delimiter.comma"
            ],
            "settings": { "foreground": "#48A2C9" }
        },
        {
            "name": "Accessor",
            "scope": ["punctuation.accessor"],
            "settings": { "foreground": "#48A2C9" }
        },
        {
            "name": "Types fixes",
            "scope": [
                "source.java storage.type",
                "source.haskell storage.type",
                "source.c storage.type",
                "meta.type.parameters"
            ],
            "settings": { "foreground": "#48A2C9" }
        },
        {
            "name": "Inherited class type",
            "scope": ["entity.other.inherited-class"],
            "settings": { "foreground": "#1AAABD" }
        },
        {
            "name": "Lambda arrow",
            "scope": ["storage.type.function"],
            "settings": { "foreground": "#48A2C9", "fontStyle": "bold" }
        },
        {
            "name": "Java primitive variable types",
            "scope": ["source.java storage.type.primitive"],
            "settings": { "foreground": "#1AAABD" }
        },
        {
            "name": "Function name",
            "scope": [
                "meta.function entity.name.function",
                "entity.name.function.member",
                "meta.function-call entity.name.function",
                "entity.name.function"
            ],
            "settings": { "foreground": "#0070A1" }
        },
        {
            "name": "Function arguments",
            "scope": [
                "variable.parameter",
                "meta.parameter",
                "meta.parameters punctuation.definition.binding-pattern"
            ],
            "settings": { "fontStyle": "italic", "foreground": "#7B4BAB" }
        },
        {
            "name": "Function call",
            "scope": [
                "variable.function",
                "variable.annotation",
                "meta.function-call.generic",
