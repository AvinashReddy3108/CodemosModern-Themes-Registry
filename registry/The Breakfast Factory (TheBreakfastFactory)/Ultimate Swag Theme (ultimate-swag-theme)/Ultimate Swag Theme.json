    "tokenColors": [
        {
            "name": "Entity name",
            "scope": ["entity.name"],
            "settings": { "foreground": "#E3DFFF" }
        },
        {
            "name": "Function name",
            "scope": ["entity.name.function"],
            "settings": { "foreground": "#B796F3" }
        },
        {
            "name": "Other object",
            "scope": ["variable.other.object"],
            "settings": { "foreground": "#E3B378" }
        },
        {
            "name": "Other object property",
            "scope": ["variable.other.object.property"],
            "settings": { "foreground": "#DCCCA3" }
        },
        {
            "name": "Comment",
            "scope": ["comment", "comment.block.documentation"],
            "settings": { "fontStyle": "italic", "foreground": "#758C4B" }
        },
        {
            "name": "Punctuation Default",
            "scope": ["punctuation.definition"],
            "settings": { "foreground": "#758C4B" }
        },
        {
            "name": "Separators like ; or ,",
            "scope": ["punctuation.separator", "punctuation.terminator"],
            "settings": { "foreground": "#ee68af" }
        },
        {
            "name": "Punctuation",
            "scope": ["punctuation.section"],
            "settings": { "foreground": "#F3D8C7" }
        },
        {
            "name": "Accessor",
            "scope": ["punctuation.accessor"],
            "settings": { "foreground": "#ee68af" }
        },
        {
            "name": "Quastion mark",
            "scope": ["punctuation.separator.question-mark"],
            "settings": { "foreground": "#ee68af" }
        },
        {
            "name": "Angle Brackets Generic",
            "scope": [
                "punctuation.definition.typeparameters.begin",
                "punctuation.definition.typeparameters.end"
            ],
            "settings": { "fontStyle": "bold", "foreground": "#ee68af" }
        },
        {
            "name": "Other Brackets",
            "scope": [
                "punctuation.curlybrace.open",
                "punctuation.curlybrace.close",
                "punctuation.parenthesis.open",
                "punctuation.parenthesis.close",
                "punctuation.squarebracket.open",
                "punctuation.squarebracket.close",
                "punctuation.definition.begin.bracket.square",
                "punctuation.definition.end.bracket.square",
                "punctuation.definition.interpolation.begin",
                "punctuation.definition.interpolation.end",
                "punctuation.definition.block",
                "meta.brace.round",
                "meta.brace.square",
                "punctuation.definition.parameters.begin",
                "punctuation.definition.parameters.end"
            ],
            "settings": { "foreground": "#FFC9B5" }
        },
        {
            "name": "Double Quotes",
            "scope": [
                "punctuation.definition.string.begin",
                "punctuation.definition.string.end",
                "punctuation.definition.char.begin",
                "punctuation.definition.char.end"
            ],
            "settings": { "fontStyle": "bold", "foreground": "#B8B8FF" }
        },
        {
            "name": "String",
            "scope": ["string", "constant.other.symbol"],
            "settings": { "fontStyle": "italic", "foreground": "#B8B8FF" }
        },
        {
            "name": "Built-in constants",
            "scope": ["constant.language"],
            "settings": { "foreground": "#f27983" }
        },
        {
            "name": "Number",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#B8B8FF" }
        },
        {
            "name": "Built-in constants Boolean",
            "scope": ["constant.language.boolean"],
            "settings": { "foreground": "#B8B8FF" }
        },
        {
            "name": "Variable",
            "scope": ["variable"],
            "settings": { "foreground": "#F3D8C7" }
        },
        {
            "name": "Variable CONSTANT",
            "scope": ["variable.other.constant"],
            "settings": { "foreground": "#d693f8" }
        },
        {
            "name": "Language CONSTANT",
            "scope": ["constant.language"],
            "settings": { "foreground": "#b796f3" }
        },
        {
            "name": "Member Variable",
            "scope": ["variable.member"],
            "settings": { "foreground": "#ee625c" }
        },
        {
            "name": "Language variable",
            "scope": ["variable.language"],
            "settings": { "fontStyle": "italic", "foreground": "#d495f6" }
        },
        {
            "name": "Language variable This",
            "scope": ["variable.language.this"],
            "settings": { "fontStyle": "italic", "foreground": "#d495f6" }
        },
        {
            "name": "Language TypeScript Variable Support",
            "scope": ["support.variable"],
            "settings": { "foreground": "#f5ba78" }
        },
        {
            "name": "Storage",
            "scope": ["storage"],
            "settings": { "foreground": "#f5ba78" }
        },
        {
            "name": "Storage LET CONST",
            "scope": ["storage.type"],
            "settings": { "foreground": "#ee68af", "fontStyle": "italic" }
        },
        {
            "name": "Storage MOFIFIER",
            "scope": ["storage.modifier"],
            "settings": { "foreground": "#ee68af", "fontStyle": "italic" }
        },
        {
            "name": "Storage ASYNC",
            "scope": ["storage.modifier.async"],
            "settings": { "foreground": "#ee68af", "fontStyle": "italic" }
        },
        {
            "name": "Storage CLASS",
            "scope": ["storage.type.class"],
            "settings": { "foreground": "#ee68af", "fontStyle": "italic" }
        },
        {
            "name": "Keyword",
            "scope": ["keyword"],
            "settings": { "foreground": "#ee68af" }
        },
        {
            "name": "Primitive",
            "scope": ["keyword.type"],
            "settings": { "foreground": "#D097D8" }
        },
        {
            "name": "Keyword Control",
            "scope": ["keyword.control"],
            "settings": { "foreground": "#ee68af" }
        },
        {
            "name": "Operators",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#ee68af" }
        },
        {
            "name": "Operators New",
            "scope": ["keyword.operator.new"],
            "settings": { "foreground": "#f088bd" }
        },
        {
            "name": "Types fixes",
            "scope": [
                "source.java storage.type",
                "source.haskell storage.type",
                "source.c storage.type"
            ],
            "settings": { "foreground": "#ef82c3" }
        },
        {
            "name": "Lambda arrow",
            "scope": ["storage.type.function"],
            "settings": { "foreground": "#f088bd" }
        },
        {
            "name": "JavaScript Lambda arrow",
            "scope": ["storage.type.function.arrow"],
            "settings": { "foreground": "#ee68af", "fontStyle": "" }
        },
        {
            "name": "Function arguments",
            "scope": ["variable.parameter", "meta.parameter"],
            "settings": { "foreground": "#f7cb8b", "fontStyle": "italic" }
        },
        {
            "name": "Function call",
            "scope": [
                "variable.function",
                "variable.annotation",
                "meta.function-call.generic",
                "support.function.go"
            ],
            "settings": { "foreground": "#f6bf6c" }
        },
        {
            "name": "Library function",
            "scope": ["support.function", "support.macro"],
            "settings": { "foreground": "#B796F3" }
        },
        {
            "name": "Library function console",
            "scope": ["support.function.console"],
            "settings": { "foreground": "#f6bf6c" }
        },
        {
            "name": "Imports and packages",
            "scope": ["entity.name.import", "entity.name.package"],
            "settings": { "foreground": "#a4fb8e" }
        },
        {
            "name": "Operator Overload",
            "scope": [
                "entity.name.function.operator",
                "entity.name.function.operator.member"
            ],
            "settings": { "foreground": "#ee68af" }
        },
        {
            "name": "Macro",
            "scope": ["entity.name.function.preprocessor"],
            "settings": { "foreground": "#f088bd" }
        },
        {
            "name": "Region",
            "scope": [
                "keyword.preprocessor.region",
                "keyword.preprocessor.endregion"
            ],
            "settings": { "fontStyle": "italic", "foreground": "#758C4B" }
        },
        {
            "name": "Region Text",
            "scope": ["string.unquoted.preprocessor.message"],
            "settings": { "foreground": "#CFFFB3" }
        },
        {
            "name": "Hash",
            "scope": [
                "punctuation.separator.hash",
                "punctuation.definition.directive"
            ],
            "settings": { "foreground": "#ee68af" }
        },
        {
            "name": "Entity name Class ES6",
            "scope": ["entity.name.class"],
            "settings": { "foreground": "#f5ba78" }
        },
        {
            "name": "Library constant",
            "scope": ["support.constant"],
            "settings": { "fontStyle": "italic", "foreground": "#d693f8" }
        },
        {
            "name": "Decorators/annotation",
            "scope": [
                "meta.decorator variable.other",
                "meta.decorator punctuation.decorator",
                "storage.type.annotation"
            ],
            "settings": { "foreground": "#F3D8C7" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid"],
            "settings": { "foreground": "#FF1654" }
        },
        {
            "name": "diff.header",
            "scope": ["meta.diff", "meta.diff.header"],
            "settings": { "foreground": "#c594c5" }
        },
        {
            "name": "Ruby class methods",
            "scope": ["source.ruby variable.other.readwrite"],
            "settings": { "foreground": "#FFD866" }
        },
        {
            "name": "Powershell function",
            "scope": ["support.function.powershell"],
            "settings": { "foreground": "#B796F3" }
        },
        {
            "name": "Powershell dollar sign variable",
            "scope": ["punctuation.definition.variable.powershell"],
            "settings": { "foreground": "#ff7097" }
        },
        {
            "name": "Powershell variable",
            "scope": ["variable.other.readwrite.powershell"],
            "settings": { "foreground": "#CFFFB3" }
        },
        {
            "name": "Powershell source",
            "scope": [
                "source.powershell",
                "punctuation.section.group.begin.powershell",
                "punctuation.section.group.end.powershell",
                "punctuation.section.bracket.begin.powershell",
                "punctuation.section.bracket.end.powershell",
                "punctuation.section.braces.begin.powershell",
                "punctuation.section.braces.end.powershell"
            ],
            "settings": { "foreground": "#DCCCA3" }
        },
        {
            "name": "Tag",
            "scope": ["entity.name.tag", "meta.tag.sgml"],
            "settings": { "foreground": "#CFFFB3" }
        },
        {
            "name": "Tag start/end",
            "scope": [
                "punctuation.definition.tag.end",
                "punctuation.definition.tag.begin",
                "punctuation.definition.tag"
