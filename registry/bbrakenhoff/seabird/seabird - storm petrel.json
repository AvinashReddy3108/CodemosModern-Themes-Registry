{
    "type": "dark",
    "colors": {
        "test": false,
        "foreground": "#6d767d",
        "input.border": "#5f829930",
        "input.foreground": "#6d767d",
        "inputOption.activeBorder": "#5f829930",
        "list.activeSelectionBackground": "#5f8299",
        "list.activeSelectionForeground": "#ffffff",
        "list.hoverBackground": "#5f829905",
        "list.inactiveSelectionBackground": "#5f829915",
        "list.highlightForeground": "#e6eaed",
        "scrollbarSlider.background": "#808487",
        "scrollbarSlider.hoverBackground": "#6d767d",
        "editor.background": "#0b141a",
        "editor.foreground": "#787e82",
        "editorWidget.background": "#1d252b",
        "editorCursor.foreground": "#ffffff",
        "editor.lineHighlightBackground": "#e6eaed10",
        "editorIndentGuide.background": "#e6eaed",
        "editorLineNumber.foreground": "#808487",
        "titleBar.activeBackground": "#1d252b",
        "editorGroupHeader.tabsBackground": "#1d252b",
        "tab.inactiveBackground": "#e6eaed10",
        "activityBar.background": "#0b141a",
        "activityBar.foreground": "#6d767d",
        "activityBarBadge.background": "#ba656d",
        "activityBarBadge.foreground": "#ffffff",
        "sideBar.background": "#1d252b",
        "statusBar.background": "#5f8299",
        "debugToolBar.background": "#e6eaed",
        "terminal.ansiBlack": "#6d767d",
        "terminal.ansiBlue": "#5f8299",
        "terminal.ansiCyan": "#548587",
        "terminal.ansiGreen": "#5b8a55",
        "terminal.ansiMagenta": "#997383",
        "terminal.ansiRed": "#ba656d",
        "terminal.ansiWhite": "#ffffff",
        "terminal.ansiYellow": "#8a7c55"
    },
    "tokenColors": [
        {
            "name": "Comment",
            "scope": "comment",
            "settings": { "foreground": "#61707a", "fontStyle": "italic" }
        },
        {
            "name": "Doc comment tag",
            "scope": "keyword.other.phpdoc.php, storage.type.class.jsdoc",
            "settings": { "foreground": "#61707a", "fontStyle": "bold" }
        },
        {
            "name": "Keyword",
            "scope": "keyword",
            "settings": { "foreground": "#9e7276" }
        },
        {
            "name": "Storage",
            "scope": "storage, variable.language.this.ts",
            "settings": { "foreground": "#9c7760" }
        },
        {
            "name": "Function",
            "scope": "entity.name.function.ts",
            "settings": { "foreground": "#5f8299" }
        },
        {
            "name": "Support function",
            "scope": "support.function",
            "settings": { "foreground": "#5f8299", "fontStyle": "italic" }
        },
        {
            "name": "String",
            "scope": "string",
            "settings": { "foreground": "#548587" }
        },
        {
            "name": "Number",
            "scope": "constant.numeric",
            "settings": { "foreground": "#86779e" }
        },
        {
            "name": "Class",
            "scope": "entity.name.type.class.ts, entity.name.type.ts, entity.name.type.class.php, entity.other.inherited-class.php, support.class.php, support.class.exception.php, storage.type.java, entity.name.type.class.java, entity.other.inherited-class.java",
            "settings": { "foreground": "#8a7c55" }
        },
        {
            "name": "TS: Primitive type",
            "scope": "support.type.primitive.ts",
            "settings": { "foreground": "#5b8a55" }
        },
        {
            "name": "Member field",
            "scope": "variable.other.property.ts",
            "settings": { "foreground": "#86779e" }
        },
        {
            "name": "Language constant",
            "scope": "constant.language.boolean.true.ts, constant.language.null.ts, constant.language.php, constant.other.class.php",
            "settings": { "foreground": "#997383" }
        },
        {
            "name": "PHP: Opening tag",
            "scope": "punctuation.section.embedded.begin.php, punctuation.section.embedded.end.php",
            "settings": { "foreground": "#5b8a55" }
        },
        {
            "name": "PHP: Curly braces",
            "scope": "punctuation.section.scope.begin.php, punctuation.section.scope.end.php",
            "settings": { "foreground": "#e6eaed" }
        },
        {
            "name": "PHP: Function",
            "scope": "entity.name.function.php",
            "settings": { "foreground": "#5f8299" }
        },
        {
            "name": "PHP: member field",
            "scope": "variable.other.property.php",
            "settings": { "foreground": "#86779e" }
        },
        {
            "name": "TS: Curly braces",
            "scope": "punctuation.definition.block.ts",
            "settings": { "foreground": "#e6eaed" }
        },
        {
            "name": "TS: Parentheses",
            "scope": "meta.brace.round.ts",
            "settings": { "foreground": "#e6eaed" }
        },
        {
            "name": "TS: Dot",
            "scope": "punctuation.accessor.ts",
            "settings": { "foreground": "#1d252b" }
        },
        {
            "name": "TS: Semicolon",
            "scope": "punctuation.terminator.statement.ts",
            "settings": { "foreground": "#1d252b" }
        },
        {
            "name": "HTML: Tag",
            "scope": "punctuation.definition.tag.html,meta.tag.inline.any.html, meta.tag.any.html, entity.name.tag.html, meta.tag.block.any.html",
            "settings": { "foreground": "#5f8299" }
        },
        {
            "name": "HTML: Attribute",
            "scope": "entity.other.attribute-name.html",
            "settings": { "foreground": "#9e7276" }
        },
        {
            "name": "HTML: Attribute value",
            "scope": "string.quoted.double.html",
            "settings": { "foreground": "#5b8a55" }
        },
        {
            "name": "HTML: Entity",
            "scope": "constant.character.entity.html",
            "settings": { "foreground": "#86779e" }
        },
        {
            "name": "SCSS: Brackets",
            "scope": "punctuation.section.property-list.begin.bracket.curly.scss, punctuation.section.property-list.end.bracket.curly.scss",
            "settings": { "foreground": "#e6eaed" }
        },
        {
            "name": "(S)CSS: Property value constant",
            "scope": "support.constant.property-value.css",
            "settings": { "foreground": "#8a7c55" }
        },
        {
            "name": "(S)CSS: Tag",
            "scope": "entity.name.tag.css, entity.name.tag.wildcard.scss",
            "settings": { "foreground": "#997383" }
        },
        {
            "name": "(S)CSS: Class",
            "scope": "entity.other.attribute-name.class.css, entity.other.attribute-name.parent-selector-suffix.css",
            "settings": { "foreground": "#5f8299" }
        },
        {
            "name": "(S)CSS: Pseudo selector",
            "scope": "entity.other.attribute-name.pseudo-class.css, entity.other.attribute-name.pseudo-element.css",
            "settings": { "foreground": "#997383", "fontStyle": "italic" }
        },
        {
            "name": "SCSS: Parent selector",
            "scope": "entity.name.tag.reference.scss",
            "settings": { "foreground": "#9c7760" }
        },
        {
            "name": "SCSS: Important",
            "scope": "keyword.other.important.scss",
            "settings": { "foreground": "#9c7760", "fontStyle": "bold" }
        },
        {
            "name": "SCSS: Function/Mixin",
            "scope": "entity.name.function.scss, support.function.misc.scss",
            "settings": { "foreground": "#5f8299", "fontStyle": "italic" }
        },
        {
            "name": "SCSS: Variable",
            "scope": "variable.scss",
            "settings": { "foreground": "#5b8a55" }
        },
        {
            "name": "JSON: Property name",
            "scope": "support.type.property-name.json",
            "settings": { "foreground": "#9c7760" }
        },
        {
            "name": "JSON: Property value",
            "scope": "string.quoted.double.json",
            "settings": { "foreground": "#5b8a55" }
        },
        {
            "name": "Java: Annotation",
            "scope": "storage.type.annotation.java",
            "settings": { "foreground": "#5b8a55" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
