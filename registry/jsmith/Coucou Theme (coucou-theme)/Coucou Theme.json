    "tokenColors": [
        {
            "scope": ["meta.embedded", "source.groovy.embedded"],
            "settings": { "foreground": "#7dafff" }
        },
        {
            "scope": "comment, punctuation.definition.comment",
            "settings": { "foreground": "#7d7064" }
        },
        { "scope": "string", "settings": { "foreground": "#f0d7aa" } },
        {
            "scope": "keyword.operator, meta.property-value.css",
            "settings": { "foreground": "#fc5432" }
        },
        {
            "scope": "punctuation.definition, punctuation.section.property-list, punctuation.separator",
            "settings": { "foreground": "#bfd9ff" }
        },
        {
            "scope": "punctuation.terminator",
            "settings": { "foreground": "#fff" }
        },
        {
            "scope": "punctuation.section.embedded",
            "settings": { "foreground": "#fc8d4c" }
        },
        {
            "scope": "punctuation.section",
            "settings": { "foreground": "#bfd9ff" }
        },
        {
            "scope": "punctuation.definition.keyword",
            "settings": { "foreground": "#fc5432" }
        },
        {
            "scope": ["meta.template.expression"],
            "settings": { "foreground": "#7dafff" }
        },
        {
            "scope": ["meta.attribute-selector"],
            "settings": { "foreground": "#f0d7aa" }
        },
        {
            "scope": "constant.numeric",
            "settings": { "foreground": "#00c896" }
        },
        {
            "scope": "constant.language",
            "settings": { "foreground": "#8de1eb" }
        },
        {
            "scope": "constant.character, constant.other",
            "settings": { "foreground": "#7dafff" }
        },
        {
            "scope": "variable",
            "settings": { "foreground": "#fff", "fontStyle": "" }
        },
        { "scope": "keyword", "settings": { "foreground": "#fc8d4c" } },
        {
            "scope": "storage",
            "settings": { "foreground": "#fc5432", "fontStyle": "" }
        },
        {
            "scope": "storage.type",
            "settings": { "foreground": "#bfd9ff", "fontStyle": "italic" }
        },
        {
            "scope": "entity.name.type, entity.name.class, entity.name.namespace, entity.name.scope-resolution",
            "settings": { "foreground": "#bfd9ff", "fontStyle": "underline" }
        },
        {
            "scope": "entity.other.inherited-class",
            "settings": {
                "foreground": "#bfd9ff",
                "fontStyle": "italic underline"
            }
        },
        {
            "scope": "entity.name.function",
            "settings": { "foreground": "#7dafff", "fontStyle": "" }
        },
        {
            "scope": "variable.parameter, variable.other.object, variable.scss",
            "settings": { "foreground": "#bfd9ff", "fontStyle": "italic" }
        },
        {
            "scope": "entity.name.tag",
            "settings": { "foreground": "#7dafff", "fontStyle": "" }
        },
        {
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#bfd9ff", "fontStyle": "" }
        },
        {
            "scope": "support.function",
            "settings": { "foreground": "#8de1eb", "fontStyle": "" }
        },
        {
            "scope": "support.constant",
            "settings": { "foreground": "#8de1eb", "fontStyle": "" }
        },
        {
            "scope": "support.type",
            "settings": { "foreground": "#fff", "fontStyle": "italic" }
        },
        {
            "scope": "support.class",
            "settings": { "foreground": "#7dafff", "fontStyle": "italic" }
        },
        { "scope": "support.other.variable", "settings": { "fontStyle": "" } },
        {
            "scope": "invalid",
            "settings": { "foreground": "#f0d7aa", "fontStyle": "" }
        },
        {
            "scope": "invalid.deprecated",
            "settings": { "foreground": "#f0d7aa" }
        },
        {
            "scope": "string.quoted, punctuation.definition.string",
            "settings": { "foreground": "#f0d7aa" }
        },
        {
            "scope": "meta.diff, meta.diff.header",
            "settings": { "foreground": "#7d7064" }
        },
        { "scope": "markup.deleted", "settings": { "foreground": "#fc5432" } },
        { "scope": "markup.inserted", "settings": { "foreground": "#00c896" } },
        { "scope": "markup.changed", "settings": { "foreground": "#E6DB74" } },
        {
            "scope": "constant.numeric.line-number.find-in-files - match",
            "settings": { "foreground": "#7dafffA0" }
        },
        {
            "scope": "entity.name.filename.find-in-files",
            "settings": { "foreground": "#E6DB74" }
        },
        { "scope": "markup.quote", "settings": { "foreground": "#fc5432" } },
        { "scope": "markup.list", "settings": { "foreground": "#E6DB74" } },
        {
            "scope": "markup.bold, markup.italic",
            "settings": { "foreground": "#8de1eb" }
        },
        {
            "scope": "markup.inline.raw",
            "settings": { "foreground": "#FD971F", "fontStyle": "" }
        },
        { "scope": "markup.heading", "settings": { "foreground": "#00c896" } },
        {
            "scope": "markup.heading.setext",
            "settings": { "foreground": "#00c896", "fontStyle": "bold" }
        },
        {
            "scope": "markup.heading.markdown",
            "settings": { "fontStyle": "bold" }
        },
        {
            "scope": "markup.quote.markdown",
            "settings": { "foreground": "#7d7064", "fontStyle": "italic" }
        },
        {
            "scope": "markup.bold.markdown",
            "settings": { "fontStyle": "bold" }
        },
        {
            "scope": "string.other.link.title.markdown,string.other.link.description.markdown",
            "settings": { "foreground": "#7dafff" }
        },
        {
            "scope": "markup.underline.link.markdown,markup.underline.link.image.markdown",
            "settings": { "foreground": "#E6DB74" }
        },
        {
            "scope": "markup.italic.markdown",
            "settings": { "fontStyle": "italic" }
        },
        {
            "scope": "markup.list.unnumbered.markdown, markup.list.numbered.markdown",
            "settings": { "foreground": "#bfd9ff" }
        },
        {
            "scope": ["punctuation.definition.list.begin.markdown"],
            "settings": { "foreground": "#00c896" }
        },
        {
            "scope": "token.info-token",
            "settings": { "foreground": "#7dafff" }
        },
        {
            "scope": "token.warn-token",
            "settings": { "foreground": "#FD971F" }
        },
        {
            "scope": "token.error-token",
            "settings": { "foreground": "#F44747" }
        },
        {
            "scope": "token.debug-token",
            "settings": { "foreground": "#B267E6" }
        },
        {
            "scope": "variable.language",
            "settings": { "foreground": "#FD971F" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
