    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "fontStyle": "italic", "foreground": "#AAAAAA" }
        },
        {
            "name": "Comments: Preprocessor",
            "scope": "comment.block.preprocessor",
            "settings": { "fontStyle": "", "foreground": "#AAAAAA" }
        },
        {
            "name": "Comments: Documentation",
            "scope": ["comment.documentation", "comment.block.documentation"],
            "settings": { "foreground": "#71fff1" }
        },
        {
            "name": "Invalid - Illegal",
            "scope": "invalid.illegal",
            "settings": { "foreground": "#ff6f6f" }
        },
        {
            "name": "Operators",
            "scope": "keyword.operator",
            "settings": { "foreground": "#777777" }
        },
        {
            "name": "Keywords",
            "scope": ["keyword", "storage"],
            "settings": { "foreground": "#77a9ff" }
        },
        {
            "name": "Types",
            "scope": ["storage.type", "support.type"],
            "settings": { "foreground": "#db86ff" }
        },
        {
            "name": "Language Constants",
            "scope": [
                "constant.language",
                "support.constant",
                "variable.language"
            ],
            "settings": { "foreground": "#ff9771" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "support.variable"],
            "settings": { "foreground": "#db86ff" }
        },
        {
            "name": "Functions",
            "scope": ["entity.name.function", "support.function"],
            "settings": { "fontStyle": "bold", "foreground": "#ff9973" }
        },
        {
            "name": "Classes",
            "scope": [
                "entity.name.type",
                "entity.other.inherited-class",
                "support.class"
            ],
            "settings": { "fontStyle": "bold", "foreground": "#d77bff" }
        },
        {
            "name": "Exceptions",
            "scope": "entity.name.exception",
            "settings": { "foreground": "#ff6969" }
        },
        {
            "name": "Sections",
            "scope": "entity.name.section",
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Numbers, Characters",
            "scope": ["constant.numeric", "constant.character", "constant"],
            "settings": { "foreground": "#8fdaff" }
        },
        {
            "name": "Strings",
            "scope": "string",
            "settings": { "foreground": "#ff6565" }
        },
        {
            "name": "Strings: Escape Sequences",
            "scope": "constant.character.escape",
            "settings": { "foreground": "#787878" }
        },
        {
            "name": "Strings: Regular Expressions",
            "scope": "string.regexp",
            "settings": { "foreground": "#649dff" }
        },
        {
            "name": "Strings: Symbols",
            "scope": "constant.other.symbol",
            "settings": { "foreground": "#ff8559" }
        },
        {
            "name": "Punctuation",
            "scope": "punctuation",
            "settings": { "foreground": "#787878" }
        },
        {
            "name": "HTML: Doctype Declaration",
            "scope": [
                "meta.tag.sgml.doctype",
                "meta.tag.sgml.doctype string",
                "meta.tag.sgml.doctype entity.name.tag",
                "meta.tag.sgml punctuation.definition.tag.html"
            ],
            "settings": { "foreground": "#AAAAAA" }
        },
        {
            "name": "HTML: Tags",
            "scope": [
                "meta.tag",
                "punctuation.definition.tag.html",
                "punctuation.definition.tag.begin.html",
                "punctuation.definition.tag.end.html"
            ],
            "settings": { "foreground": "#60d7cb" }
        },
        {
            "name": "HTML: Tag Names",
            "scope": "entity.name.tag",
            "settings": { "foreground": "#7c92ff" }
        },
        {
            "name": "HTML: Attribute Names",
            "scope": [
                "meta.tag entity.other.attribute-name",
                "entity.other.attribute-name.html"
            ],
            "settings": { "fontStyle": "italic", "foreground": "#e37900" }
        },
        {
            "name": "HTML: Entities",
            "scope": [
                "constant.character.entity",
                "punctuation.definition.entity"
            ],
            "settings": { "foreground": "#ffb69b" }
        },
        {
            "name": "CSS: Selectors",
            "scope": [
                "meta.selector",
                "meta.selector entity",
                "meta.selector entity punctuation",
                "entity.name.tag.css"
            ],
            "settings": { "foreground": "#7dabfb" }
        },
        {
            "name": "CSS: Property Names",
            "scope": ["meta.property-name", "support.type.property-name"],
            "settings": { "foreground": "#ffb69b" }
        },
        {
            "name": "CSS: Property Values",
            "scope": [
                "meta.property-value",
                "meta.property-value constant.other",
                "support.constant.property-value"
            ],
            "settings": { "foreground": "#009688" }
        },
        {
            "name": "CSS: Important Keyword",
            "scope": "keyword.other.important",
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Markup: Changed",
            "scope": "markup.changed",
            "settings": { "foreground": "#fff" }
        },
        {
            "name": "Markup: Deletion",
            "scope": "markup.deleted",
            "settings": { "foreground": "#fff" }
        },
        {
            "name": "Markup: Emphasis",
            "scope": "markup.italic",
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "Markup: Error",
            "scope": "markup.error",
            "settings": { "foreground": "#ff7575" }
        },
        {
            "name": "Markup: Insertion",
            "scope": "markup.inserted",
            "settings": { "foreground": "#fff" }
        },
        {
            "name": "Markup: Link",
            "scope": "meta.link",
            "settings": { "foreground": "#3360ad" }
        },
        {
            "name": "Markup: Output",
            "scope": ["markup.output", "markup.raw"],
            "settings": { "foreground": "#787878" }
        },
        {
            "name": "Markup: Prompt",
            "scope": "markup.prompt",
            "settings": { "foreground": "#787878" }
        },
        {
            "name": "Markup: Heading",
            "scope": "markup.heading",
            "settings": { "foreground": "#e67f59" }
        },
        {
            "name": "Markup: Strong",
            "scope": "markup.bold",
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Markup: Traceback",
            "scope": "markup.traceback",
            "settings": { "foreground": "#e67f59" }
        },
        {
            "name": "Markup: Underline",
            "scope": "markup.underline",
            "settings": { "fontStyle": "underline" }
        },
        {
            "name": "Markup Quote",
            "scope": "markup.quote",
            "settings": { "foreground": "#c183e4" }
        },
        {
            "name": "Markup Lists",
            "scope": "markup.list",
            "settings": { "foreground": "#7dabfb" }
        },
        {
            "name": "Markup Styling",
            "scope": ["markup.bold", "markup.italic"],
            "settings": { "foreground": "#48d8ca" }
        },
        {
            "name": "Markup Inline",
            "scope": "markup.inline.raw",
            "settings": { "fontStyle": "", "foreground": "#e67f59" }
        },
        {
            "name": "Extra: Diff Range",
            "scope": ["meta.diff.range", "meta.diff.index", "meta.separator"],
            "settings": { "foreground": "#cbcbcb" }
        },
        {
            "name": "Extra: Diff From",
            "scope": "meta.diff.header.from-file",
            "settings": { "foreground": "#cbcbcb" }
        },
        {
            "name": "Extra: Diff To",
            "scope": "meta.diff.header.to-file",
            "settings": { "foreground": "#cbcbcb" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
