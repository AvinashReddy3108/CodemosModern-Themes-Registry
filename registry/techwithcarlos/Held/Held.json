    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "fontStyle": "italic", "foreground": "#5273a5" }
        },
        {
            "name": "Error from classes",
            "scope": ["support.class.error"],
            "settings": { "foreground": "#e46961" }
        },
        {
            "name": "JSX js brackets",
            "scope": [
                "punctuation.section.embedded.begin",
                "punctuation.section.embedded.end"
            ],
            "settings": { "foreground": "#F9794A" }
        },
        {
            "name": "JSX js in backticks",
            "scope": [
                "punctuation.definition.template-expression.begin",
                "punctuation.definition.template-expression.end"
            ],
            "settings": { "foreground": "#ea4ef8" }
        },
        {
            "name": "Comment",
            "scope": ["meta.jsx.children"],
            "settings": { "foreground": "#C792EA" }
        },
        {
            "name": "Functions",
            "scope": ["entity.name.function"],
            "settings": { "fontStyle": "italic", "foreground": "#87AFF4" }
        },
        {
            "name": "Functions parameter",
            "scope": ["variable.other.readwrite"],
            "settings": { "foreground": "#8059b6" }
        },
        {
            "name": "Arrow function",
            "scope": ["storage.type.function.arrow"],
            "settings": { "fontStyle": "italic", "foreground": "#C792EA" }
        },
        {
            "name": "braces, blocks",
            "scope": [
                "meta.brace.round",
                "punctuation.definition.block",
                "meta.brace.square",
                "punctuation.accessor",
                "punctuation.terminator.statement",
                "punctuation.separator.key-value",
                "punctuation.definition.string.begin",
                "punctuation.definition.string.end",
                "punctuation.definition.parameters.end",
                "punctuation.definition.parameters.begin",
                "punctuation.separator.comma"
            ],
            "settings": { "foreground": "#D7DBE0" }
        },
        {
            "name": "parameter brace",
            "scope": [
                "punctuation.definition.parameters.end",
                "punctuation.definition.parameters.begin"
            ],
            "settings": { "foreground": "#A7DBF7" }
        },
        {
            "name": "Logical operators",
            "scope": [
                "keyword.operator.logical",
                "keyword.operator.comparison",
                "keyword.operator.relational",
                "keyword"
            ],
            "settings": { "foreground": "#C792EA" }
        },
        {
            "name": "Strings",
            "scope": [
                "string.quoted.single",
                "string.quoted.double",
                "meta.jsx"
            ],
            "settings": { "foreground": "#76d197" }
        },
        {
            "name": "JSON value",
            "scope": ["string.quoted.double.json"],
            "settings": { "foreground": "#bef7a4" }
        },
        {
            "name": "React components",
            "scope": ["support.class.component"],
            "settings": { "foreground": "#67d0fa" }
        },
        {
            "name": "Numbers",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#F78C6C" }
        },
        {
            "name": "import export",
            "scope": [
                "keyword.control.import",
                "keyword.control.export",
                "keyword.control.from"
            ],
            "settings": { "foreground": "#C792EA" }
