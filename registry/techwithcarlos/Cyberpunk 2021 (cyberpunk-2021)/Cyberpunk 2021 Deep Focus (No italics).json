    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "fontStyle": "", "foreground": "#6272A4" }
        },
        {
            "name": "Error from classes",
            "scope": ["support.class.error"],
            "settings": { "foreground": "#eb4949" }
        },
        {
            "name": "Functions",
            "scope": ["entity.name.function"],
            "settings": { "fontStyle": "", "foreground": "#71B1FE" }
        },
        {
            "name": "Functions parameter",
            "scope": ["variable.other.readwrite"],
            "settings": { "foreground": "#60BAA8" }
        },
        {
            "name": "braces, blocks",
            "scope": [
                "meta.brace.round",
                "punctuation.definition.block",
                "meta.brace.square",
                "punctuation.accessor",
                "punctuation.terminator.statement",
                "punctuation.separator.key-value",
                "punctuation.definition.string.begin",
                "punctuation.definition.string.end",
                "punctuation.definition.parameters.end",
                "punctuation.definition.parameters.begin",
                "punctuation.separator.comma"
            ],
            "settings": { "foreground": "#fff" }
        },
        {
            "name": "parameter brace",
            "scope": [
                "punctuation.definition.parameters.end",
                "punctuation.definition.parameters.begin"
            ],
            "settings": { "foreground": "#A7DBF7" }
        },
        {
            "name": "Logical operators",
            "scope": [
                "keyword.operator.logical",
                "keyword.operator.comparison",
                "keyword.operator.relational",
                "keyword"
            ],
            "settings": { "foreground": "#CC9FF0", "fontStyle": "" }
        },
        {
            "name": "Arrow function",
            "scope": ["storage.type.function.arrow"],
            "settings": { "fontStyle": "", "foreground": "#CC9FF0" }
        },
        {
            "name": "Strings",
            "scope": [
                "string.quoted.single",
                "string.quoted.double",
                "meta.jsx"
            ],
            "settings": { "foreground": "#0397C4" }
        },
        {
            "name": "Global Single and Double Quotes",
            "scope": [
                "punctuation.definition.string.begin.js",
                "punctuation.definition.string.end.js",
                "punctuation.definition.string.begin.jsx",
                "punctuation.definition.string.end.jsx",
                "punctuation.definition.string.begin.ts",
                "punctuation.definition.string.end.ts",
                "punctuation.definition.string.begin.tsx",
                "punctuation.definition.string.end.tsx",
                "punctuation.definition.string.begin.json",
                "punctuation.definition.string.end.json",
                "punctuation.definition.string.begin.python",
                "punctuation.definition.string.end.python",
                "punctuation.definition.string.begin.css",
                "punctuation.definition.string.end.css",
                "punctuation.definition.string.begin.html",
                "punctuation.definition.string.end.html",
                "punctuation.definition.string.begin.go",
                "punctuation.definition.string.end.go",
                "punctuation.other.period.go"
            ],
            "settings": { "foreground": "#fff", "fontStyle": "" }
        },
        {
            "name": "JSON value",
            "scope": [
                "string.quoted.double.json",
                "punctuation.definition.string.end.json",
                "punctuation.definition.string.begin.json"
            ],
            "settings": { "foreground": "#56ac98" }
        },
        {
            "name": "Numbers",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#d29785" }
        },
        {
            "name": "Object keys",
            "scope": ["meta.object-literal.key"],
            "settings": { "foreground": "#4DB1D8" }
        },
        {
            "name": "Object keys",
            "scope": ["variable.other.object"],
            "settings": { "foreground": "#5477ff" }
        },
        {
            "name": "keyword.control.conditional",
            "scope": ["keyword.control.conditional"],
            "settings": { "foreground": "#43dee1" }
        },
        {
            "name": "Object keys",
            "scope": ["keyword.control.flow"],
            "settings": { "fontStyle": "", "foreground": "#D59DF6" }
        },
        {
            "name": "Async keyword",
            "scope": ["storage.modifier.async"],
            "settings": { "fontStyle": "", "foreground": "#8D83F1" }
        },
        {
            "name": "Object keys",
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#c2bc71" }
        },
        {
            "name": "Object other properties",
            "scope": ["variable.other.property"],
            "settings": { "foreground": "#6ac4b3" }
        },
        {
            "name": "Object properties",
            "scope": ["variable.other.object.property"],
            "settings": { "foreground": "#afa44f" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "string constant.other.placeholder"],
            "settings": { "foreground": "#e0d7d7" }
        },
        {
            "name": "Colors",
            "scope": ["constant.other.color"],
            "settings": { "foreground": "#D7DBE0" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#FF5370" }
        },
        {
            "name": "Keyword, Storage",
            "scope": ["storage.type", "storage.modifier"],
            "settings": { "fontStyle": "", "foreground": "#D59DF6" }
        },
        {
            "name": "Const name",
            "scope": ["variable.other.constant"],
            "settings": { "foreground": "#9c77f2" }
        },
        {
            "name": "Object key like a destructuring",
            "scope": ["variable.object.property"],
            "settings": { "foreground": "#54b1a3" }
        },
        {
            "name": "JS Builtin properties",
            "scope": ["support.variable.property"],
            "settings": { "foreground": "#318d58" }
        },
        {
            "name": "JS Builtin classes/methods",
            "scope": ["support.class.builtin"],
            "settings": { "foreground": "#89c058" }
        },
        {
            "name": "Tag",
            "scope": ["meta.tag.sgml", "markup.deleted.git_gutter"],
            "settings": { "foreground": "#f07178" }
        },
        {
            "name": "Try catch keywords",
            "scope": ["keyword.control"],
            "settings": { "fontStyle": "", "foreground": "#0696f0" }
        },
        {
            "name": "Function, Special Method",
            "scope": [
                "meta.function-call",
                "variable.function",
                "support.function",
                "keyword.other.special-method"
            ],
            "settings": { "foreground": "#82AAFF" }
        },
        {
            "name": "Block Level Variables",
            "scope": ["meta.block variable.other"],
            "settings": { "foreground": "#f07178" }
        },
        {
            "name": "Other Variable, String Link",
            "scope": ["support.other.variable", "string.other.link"],
            "settings": { "foreground": "#f07178" }
        },
        {
            "name": "Constant, Function Argument, Tag Attribute, Embedded",
            "scope": [
                "constant.language",
                "support.constant",
                "constant.character",
                "constant.escape",
                "keyword.other.unit",
                "keyword.other"
            ],
            "settings": { "foreground": "#26cfbe" }
        },
        {
            "name": "String, Symbols, Inherited Class, Markup Heading",
            "scope": [
                "string",
                "constant.other.symbol",
                "constant.other.key",
                "entity.other.inherited-class",
                "markup.heading",
                "markup.inserted.git_gutter",
                "meta.group.braces.curly constant.other.object.key.js string.unquoted.label.js"
            ],
            "settings": { "foreground": "#a7c47c" }
        },
        {
            "name": "Class, Support",
            "scope": [
                "support.type",
                "support.class",
                "support.other.namespace.use.php",
                "meta.use.php",
                "support.other.namespace.php",
                "markup.changed.git_gutter",
                "support.type.sys-types"
            ],
            "settings": { "foreground": "#ffca67" }
        },
        {
            "name": "Entity Types",
            "scope": ["support.type"],
            "settings": { "foreground": "#B2CCD6" }
        },
        {
            "name": "CSS Class and Support",
            "scope": [
                "source.css support.type.property-name",
                "source.sass support.type.property-name",
                "source.scss support.type.property-name",
                "source.less support.type.property-name",
                "source.stylus support.type.property-name",
                "source.postcss support.type.property-name"
            ],
            "settings": { "foreground": "#B2CCD6" }
        },
        {
            "name": "Sub-methods",
            "scope": [
                "entity.name.module.js",
                "variable.import.parameter.js",
                "variable.other.class.js"
            ],
            "settings": { "foreground": "#FF5370" }
        },
        {
            "name": "Language methods",
            "scope": ["variable.language"],
            "settings": { "foreground": "#00BFF9" }
        },
        {
            "name": "Method Names",
            "scope": ["entity.name.method.js"],
            "settings": { "fontStyle": "", "foreground": "#82AAFF" }
        },
        {
            "name": "Class Method Names",
            "scope": [
                "meta.class-method.js entity.name.function.js",
                "variable.function.constructor"
            ],
            "settings": { "foreground": "#82AAFF" }
        },
        {
            "name": "Attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#a562bf" }
        },
        {
