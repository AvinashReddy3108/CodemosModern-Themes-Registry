        "extensionButton.prominentBackground": "#783078",
        "extensionButton.prominentHoverBackground": "#781860",
        "focusBorder": "#783078",
        "gitDecoration.conflictingResourceForeground": "#b3ff55",
        "gitDecoration.deletedResourceForeground": "#ED4245",
        "gitDecoration.ignoredResourceForeground": "#FFFF7f",
        "gitDecoration.modifiedResourceForeground": "#783078",
        "gitDecoration.untrackedResourceForeground": "#555555",
        "input.background": "#1818487f",
        "input.border": "#783078",
        "input.foreground": "#FFFFFF",
        "input.placeholderForeground": "#FFFFFF60",
        "inputOption.activeBackground": "#FFFFFF30",
        "inputOption.activeBorder": "#783078",
        "inputValidation.errorBorder": "#ED4245",
        "inputValidation.infoBorder": "#FEE75C",
        "inputValidation.warningBorder": "#5865f2",
        "list.activeSelectionBackground": "#000018",
        "list.activeSelectionForeground": "#783078",
        "list.focusBackground": "#181848",
        "list.focusForeground": "#FFFFFF",
        "list.highlightForeground": "#eb459e",
        "list.hoverBackground": "#1818487f",
        "list.hoverForeground": "#FFEFEB",
        "list.inactiveSelectionBackground": "#00001830",
        "list.inactiveSelectionForeground": "#7830787f",
        "list.warningForeground": "#5865F2",
        "listFilterWidget.background": "#00001830",
        "listFilterWidget.noMatchesOutline": "#00001830",
        "listFilterWidget.outline": "#00001830",
        "menu.background": "#000018",
        "menu.border": "#783078",
        "menu.foreground": "#781860",
        "menu.selectionBackground": "#181848",
        "menu.selectionBorder": "#783078",
        "menu.selectionForeground": "#FFFFFF",
        "menu.separatorBackground": "#49b1c9",
        "menubar.selectionBackground": "#1818487f",
        "menubar.selectionBorder": "#783078",
        "menubar.selectionForeground": "#FFFFFF",
        "minimap.background": "#000018",
        "minimapGutter.addedBackground": "#57f2873f",
        "minimapGutter.deletedBackground": "#ED42453f",
        "minimapGutter.modifiedBackground": "#7830783f",
        "minimapSlider.activeBackground": "#9238ed3f",
        "minimapSlider.background": "#181848",
        "minimapSlider.hoverBackground": "#1818303f",
        "notificationLink.foreground": "#00d0ff",
        "notifications.background": "#000018",
        "notifications.foreground": "#FFFFFF",
        "panel.background": "#000018",
        "panel.border": "#783078",
        "panelTitle.activeBorder": "#783078",
        "panelTitle.activeForeground": "#FFFFFF",
        "panelTitle.inactiveForeground": "#98847e",
        "peekView.border": "#783078",
        "peekViewEditor.background": "#FFFFFF05",
        "peekViewEditor.matchHighlightBackground": "#eb459ecf",
        "peekViewEditorGutter.background": "#FFFFFF05",
        "peekViewResult.background": "#FFFFFF05",
        "peekViewResult.matchHighlightBackground": "#eb459ecf",
        "peekViewResult.selectionBackground": "#181848",
        "peekViewTitle.background": "#EB459E05",
        "peekViewTitleDescription.foreground": "#FFFFFF60",
        "pickerGroup.foreground": "#FFFFFF",
        "progressBar.background": "#EB459e",
        "scrollbar.shadow": "#0000187f",
        "scrollbarSlider.activeBackground": "#783078",
        "scrollbarSlider.background": "#783078bb",
        "scrollbarSlider.hoverBackground": "#783078ee",
        "selection.background": "#783078",
        "settings.checkboxBackground": "#000018",
        "settings.checkboxForeground": "#FFFFFF",
        "settings.dropdownBackground": "#000018",
        "settings.dropdownForeground": "#FFFFFF",
        "settings.headerForeground": "#783078",
        "settings.modifiedItemIndicator": "#4D1940",
        "settings.numberInputBackground": "#000018",
        "settings.numberInputForeground": "#FFFFFF",
        "settings.textInputBackground": "#000018",
        "settings.textInputForeground": "#FFFFFF",
        "sideBar.background": "#000018",
        "sideBar.border": "#783078",
        "sideBar.foreground": "#FFEFEB",
        "sideBarSectionHeader.background": "#000018",
        "sideBarSectionHeader.border": "#783078",
        "sideBarSectionHeader.foreground": "#80D7F2",
        "sideBarTitle.foreground": "#FFFFFF",
        "statusBar.background": "#6100c2",
        "statusBar.border": "#783078",
        "statusBar.debuggingBackground": "#9048D8",
        "statusBar.debuggingForeground": "#FFEFEB",
        "statusBar.foreground": "#FFFFFF",
        "statusBar.noFolderBackground": "#6100c2",
        "statusBarItem.hoverBackground": "#6100c220",
        "statusBarItem.remoteBackground": "#783078",
        "statusBarItem.remoteForeground": "#6100c2",
        "tab.activeBackground": "#78307850",
        "tab.activeBorder": "#783078",
        "tab.activeForeground": "#FFEFEB",
        "tab.activeModifiedBorder": "#783078",
        "tab.border": "#783078",
        "tab.inactiveBackground": "#4D194020",
        "tab.inactiveForeground": "#FFFFFFaf",
        "tab.unfocusedActiveBorder": "#783078",
        "tab.unfocusedActiveBackground": "#4D194040",
        "tab.unfocusedActiveForeground": "#FFFFFF",
        "tab.unfocusedInactiveBackground": "#4D194010",
        "tab.unfocusedInactiveForeground": "#FFFFFF7f",
        "terminal.ansiBlack": "#000",
        "terminal.ansiBlue": "#00AAFF",
        "terminal.ansiBrightBlack": "#777",
        "terminal.ansiBrightBlue": "#0077FF",
        "terminal.ansiBrightCyan": "#007777",
        "terminal.ansiBrightGreen": "#77FF77",
        "terminal.ansiBrightMagenta": "#FF0074",
        "terminal.ansiBrightRed": "#FF7777",
        "terminal.ansiBrightWhite": "#FFFFFF",
        "terminal.ansiBrightYellow": "#FFFF77",
        "terminal.ansiCyan": "#00FFFF",
        "terminal.ansiGreen": "#00FF00",
        "terminal.ansiMagenta": "#FF00FF",
        "terminal.ansiRed": "#FF0000",
        "terminal.ansiWhite": "#878787",
        "terminal.ansiYellow": "#FFFFFF00",
        "terminalCursor.background": "#181848",
        "terminalCursor.foreground": "#783078",
        "textLink.activeForeground": "#FFFFFF",
        "textLink.foreground": "#00d0ff",
        "titleBar.activeBackground": "#000018",
        "titleBar.activeForeground": "#783078",
        "titleBar.border": "#783078",
        "titleBar.inactiveBackground": "#000018",
        "titleBar.inactiveForeground": "#783078",
        "tree.indentGuidesStroke": "#181848",
        "widget.shadow": "#00001830"
    },
    "tokenColors": [
        {
            "scope": [
                "variable",
                "string constant.other.placeholder",
                "invalid.deprecated",
                "keyword",
                "storage.type",
                "storage.modifier"
            ],
            "settings": { "foreground": "#ff00f2" }
        },
        {
            "scope": [
                "variable",
                "string constant.other.placeholder",
                "entity.name.function",
                "punctuation.definition.interpolation.end.bracket.curly.scss",
                "punctuation.definition.interpolation.begin.bracket.curly.scss"
            ],
            "settings": { "fontStyle": "italic" }
        },
        {
            "scope": [
                "punctuation.definition.interpolation.end.bracket.curly.scss",
                "punctuation.definition.interpolation.begin.bracket.curly.scss"
            ],
            "settings": { "foreground": "#c800be" }
        },
        {
            "scope": ["constant.other.php"],
            "settings": { "foreground": "#ff00f2" }
        },
        {
            "scope": ["constant.other.color"],
            "settings": { "foreground": "#FFFFFF" }
        },
        {
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#01d648" }
        },
        {
            "scope": ["Keyword", "Storage"],
            "settings": { "fontStyle": "italic" }
        },
        {
            "scope": [
                "keyword.control",
                "constant.other.color",
                "punctuation.definition.tag",
                "punctuation",
                "punctuation.separator.inheritance.php",
                "punctuation.definition.tag.html",
                "punctuation.section.embedded",
                "keyword.other.template",
                "keyword.other.substitution",
                "entity.name.tag.reference.scss"
            ],
            "settings": { "foreground": "#a7a8af" }
        },
        {
            "scope": [
                "punctuation.definition.tag.begin.html",
                "punctuation.definition.tag.end.html"
            ],
            "settings": { "foreground": "#6d6f7c" }
        },
        {
            "scope": [
                "keyword.control.at-rule",
                "punctuation.terminator.rule.css",
                "keyword.control.operator",
                "punctuation.definition.entity.css",
                "keyword.operator.assignment.js",
                "punctuation.separator.comma.js",
                "punctuation.definition.string.begin.js",
                "punctuation.definition.string.end.js",
                "punctuation.definition.binding-pattern.object.js"
            ],
            "settings": { "foreground": "#dddfe9" }
        },
        {
            "scope": ["punctuation.definition", "string.quoted.single.scss"],
            "settings": { "foreground": "#a7a8af" }
        },
        { "scope": ["keyword.control"], "settings": { "fontStyle": "bold" } },
        {
            "scope": [
                "comment.line.scss",
                "comment.line.double-slash.js",
                "punctuation.definition.comment.scss",
                "punctuation.definition.comment.js",
                "punctuation.definition.comment.html",
                "comment.block.html"
            ],
            "settings": { "foreground": "#7124a7" }
        },
        {
            "scope": ["text.html.derivative"],
            "settings": { "foreground": "#a7a8af" }
        },
        {
            "scope": [
                "entity.name.tag",
                "meta.tag.sgml",
                "markup.deleted.git_gutter"
            ],
            "settings": { "foreground": "#dddfe9" }
        },
        {
            "scope": ["entity.name.tag.html"],
            "settings": { "fontStyle": "bold" }
        },
        {
            "scope": [
                "variable.parameter.js",
                "variable.parameter.keyframe-list.css"
            ],
            "settings": { "foreground": "#ff00f2" }
        },
        {
            "scope": ["variable.other.object.js"],
            "settings": { "foreground": "#0fd3c0de" }
        },
        {
            "scope": [
                "storage.type.js",
                "string.other.link.title.markdown",
                "variable.other.readwrite.js",
                "variable.other.property.js",
                "entity.name.type.module.js"
            ],
            "settings": { "foreground": "#8271d5", "fontStyle": "" }
        },
        {
            "scope": [
                "string",
                "string.quoted.double.html",
                "variable.other.constant.js",
                "variable.other.object.property.js",
                "string.quoted.double.json",
                "markup.fenced_code.block.markdown",
                "markup.inline.raw.string.markdown",
                "variable.function",
                "keyword.other.special-method",
                "entity.name.function",
                "markup.bold",
                "markup.bold.markdown",
                "markup.italic.markdown",
                "meta.class-method.js entity.name.function.js",
                "variable.function.constructor",
                "entity.name.tag.other.html",
                "entity.name.tag.block.any.html",
                "source.sass keyword.control"
            ],
            "settings": { "foreground": "#2d5ee6" }
        },
        {
            "scope": [
                "punctuation.definition.string.begin.html",
                "punctuation.definition.string.end.html"
            ],
            "settings": { "foreground": "#c4cbff" }
        },
        {
            "scope": [
                "support.other.variable",
                "string.other.link",
                "markup.table"
            ],
            "settings": { "foreground": "#dddfe9" }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.language",
                "constant.character",
                "constant.escape",
                "keyword.other.unit",
                "keyword.other",
                "punctuation.separator.key-value.html"
            ],
            "settings": { "foreground": "#ff00f2" }
        },
        {
            "scope": [
                "variable.parameter.function.language.special",
                "variable.parameter"
            ],
            "settings": { "foreground": "#01d648" }
        },
        {
            "scope": [
                "constant.other.symbol",
                "constant.other.key",
                "entity.other.inherited-class",
                "keyword.other.unit",
                "markup.heading",
                "markup.inserted.git_gutter",
                "meta.group.braces.curly constant.other.object.key.js string.unquoted.label.js"
            ],
            "settings": { "foreground": "#c800be", "fontStyle": "" }
        },
        {
            "scope": [
                "entity.name",
                "support.type",
                "support.class",
                "support.orther.namespace.use.php",
                "meta.use.php",
                "support.other.namespace.php",
                "markup.changed.git_gutter",
                "support.type.sys-types",
                "entity.other.attribute-name.html"
            ],
            "settings": { "foreground": "#FF00F2" }
        },
        { "scope": ["support.type"], "settings": { "foreground": "#01b0f5" } },
        {
            "scope": [
                "source.css support.type.property-name",
                "source.sass support.type.property-name",
                "source.scss support.type.property-name",
                "source.less support.type.property-name",
                "source.stylus support.type.property-name",
                "source.postcss support.type.property-name"
            ],
            "settings": { "foreground": "#6a77d8" }
        },
        {
            "scope": [
                "entity.name.module.js",
                "variable.import.parameter.js",
                "variable.other.class.js"
            ],
            "settings": { "foreground": "#01d648" }
        },
        {
            "scope": [
                "entity.name.method.js",
                "tag.decorator.js entity.name.tag.js",
                "tag.decorator.js punctuation.definition.tag.js"
            ],
            "settings": { "foreground": "#8c97ea", "fontStyle": "italic" }
        },
        {
            "scope": ["entity.other.attribute-name", "support.function"],
            "settings": { "foreground": "#ff00f2" }
        },
        {
            "scope": [
                "entity.other.attribute-name.id",
                "entity.other.attribute-name.class",
                "entity.other.attribute-name.pseudo-class",
                "entity.name.tag.css",
                "keyword.control.conditional.js",
                "support.constant",
                "entity.other.attribute-name.html",
                "string.quoted.single.js",
                "storage.type.function.js",
                "meta.object-literal.key"
            ],
            "settings": { "foreground": "#dddfe9" }
        },
        {
            "scope": ["source.scss keyword.control"],
            "settings": { "foreground": "#ff0000" }
        },
        {
            "scope": ["markup.inserted"],
            "settings": { "foreground": "#c800be" }
        },
        {
            "scope": ["markup.deleted"],
            "settings": { "foreground": "#01d648" }
        },
        {
            "scope": ["markup.changed"],
            "settings": { "foreground": "#ff00f2" }
        },
        { "scope": ["string.regexp"], "settings": { "foreground": "#c4cbff" } },
        {
            "scope": ["constant.character.escape"],
            "settings": { "foreground": "#c4cbff" }
        },
        {
            "scope": ["*url*", "*link*", "*uri*"],
            "settings": { "fontStyle": "underline" }
        },
        {
            "scope": [
                "source.js constant.other.object.key.js string.unquoted.label.js"
            ],
            "settings": { "foreground": "#dddfe9", "fontStyle": "italic" }
        },
        {
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#dddfe9" }
        },
        {
            "scope": [
                "text.html.markdown",
                "punctuation.definition.list_item.markdown"
            ],
            "settings": { "foreground": "#dddfe9" }
        },
        {
            "scope": ["text.html.markdown markup.inline.raw.markdown"],
            "settings": { "foreground": "#ff00f2" }
        },
        {
            "scope": [
                "text.html.markdown markup.inline.raw.markdown punctuation.definition.raw.markdown"
            ],
            "settings": { "foreground": "#5966cc50" }
        },
        {
            "scope": ["text.html.markdown meta.dummy.line-break"],
            "settings": {}
        },
        {
            "scope": [
                "markdown.heading",
                "markup.heading | markup.heading entity.name",
                "markup.heading.markdown punctuation.definition.heading.markdown",
                "entity.name.section.markdown"
            ],
            "settings": { "foreground": "#6a77d8", "fontStyle": "bold" }
        },
        {
            "scope": ["markup.underline"],
            "settings": { "foreground": "#8c97ea", "fontStyle": "underline" }
        },
        { "scope": ["markup.strike"], "settings": { "fontStyle": "" } },
        {
            "scope": [
                "markup.quote punctuation.definition.blockquote.markdown"
            ],
            "settings": { "foreground": "#5966cc50" }
        },
        { "scope": ["markup.quote"], "settings": { "fontStyle": "italic" } },
        {
            "scope": ["string.other.link.description.title.markdown"],
            "settings": { "foreground": "#ff00f2" }
        },
        {
            "scope": ["constant.other.reference.link.markdown"],
            "settings": { "foreground": "#ff00f2" }
        },
        {
            "scope": ["markup.raw.block"],
            "settings": { "foreground": "#ff00f2" }
        },
        {
            "scope": [
                "punctuation.definition.raw.markdown",
                "punctuation.definition.markdown"
            ],
            "settings": { "foreground": "#c4cbff" }
        },
        {
            "scope": ["variable.language.fenced.markdown"],
            "settings": { "foreground": "#5966cc" }
        },
        {
            "scope": ["meta.separator"],
            "settings": { "foreground": "#a7a8af", "fontStyle": "bold" }
        },
        {
            "scope": "token.info-token",
            "settings": { "foreground": "#5966cc" }
        },
        {
            "scope": "token.warn-token",
            "settings": { "foreground": "#ff00f2" }
        },
        {
            "scope": "token.error-token",
            "settings": { "foreground": "#ff293b" }
        },
        {
            "scope": "token.debug-token",
            "settings": { "foreground": "#c4cbff" }
        }
    ]
}
