{
    "name": "Perfect Dark Pro",
    "type": "dark",
    "settings": [
        { "settings": { "lineHighlight": "#183d51", "foreground": "#E0E0D0" } },
        { "scope": "emphasis", "settings": { "fontStyle": "italic" } },
        { "scope": "strong", "settings": { "fontStyle": "bold" } },
        { "scope": "header", "settings": { "foreground": "#000080" } },
        { "scope": "source.python", "settings": { "foreground": "#45AA73" } },
