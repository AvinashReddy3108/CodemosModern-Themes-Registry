    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#6e6a86", "fontStyle": "italic" }
        },
        {
            "name": "String",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#f6c177" }
        },
        {
            "name": "String escape",
            "scope": ["constant.character.escape", "string.regexp"],
            "settings": { "foreground": "#ebbcba" }
        },
        {
            "name": "Number",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#ebbcba" }
        },
        {
            "name": "Boolean / Null",
            "scope": ["constant.language"],
            "settings": { "foreground": "#ebbcba" }
        },
        {
            "name": "Constant",
            "scope": ["constant", "variable.other.constant"],
            "settings": { "foreground": "#ebbcba" }
        },
        {
            "name": "Keyword",
            "scope": ["keyword", "keyword.control", "keyword.operator.new"],
            "settings": { "foreground": "#c4a7e7" }
        },
        {
            "name": "Operator",
            "scope": [
                "keyword.operator",
                "punctuation.separator",
                "punctuation.terminator"
            ],
            "settings": { "foreground": "#908caa" }
        },
        {
            "name": "Storage",
            "scope": ["storage", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#c4a7e7" }
        },
        {
            "name": "Function",
            "scope": [
                "entity.name.function",
                "meta.function-call.generic",
                "support.function"
            ],
            "settings": { "foreground": "#9ccfd8" }
        },
        {
            "name": "Function parameter",
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#e0def4" }
        },
        {
            "name": "Class / Type",
            "scope": [
                "entity.name.class",
                "entity.name.type",
                "entity.name.namespace",
                "support.class",
                "support.type"
            ],
            "settings": { "foreground": "#ebbcba" }
        },
        {
            "name": "Interface",
            "scope": ["entity.name.interface"],
            "settings": { "foreground": "#9ccfd8" }
        },
        {
            "name": "Enum",
            "scope": ["entity.name.enum"],
            "settings": { "foreground": "#ebbcba" }
        },
        {
            "name": "Variable",
            "scope": ["variable", "variable.other", "variable.other.readwrite"],
            "settings": { "foreground": "#e0def4" }
        },
        {
            "name": "Property",
            "scope": [
                "variable.other.property",
                "variable.other.object.property",
                "support.variable.property",
                "meta.object-literal.key"
            ],
            "settings": { "foreground": "#e0def4" }
        },
        {
            "name": "Tag",
            "scope": ["entity.name.tag", "meta.tag"],
            "settings": { "foreground": "#9ccfd8" }
        },
        {
            "name": "Tag attribute",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#ebbcba" }
        },
        {
            "name": "Punctuation",
            "scope": ["punctuation", "meta.brace", "punctuation.definition"],
            "settings": { "foreground": "#908caa" }
        },
        {
            "name": "Import / Include",
            "scope": [
                "keyword.control.import",
                "keyword.control.from",
                "keyword.other.using"
            ],
            "settings": { "foreground": "#c4a7e7" }
        },
        {
            "name": "Decorator / Annotation",
            "scope": [
                "meta.decorator",
                "entity.name.function.decorator",
                "punctuation.decorator"
            ],
            "settings": { "foreground": "#f6c177" }
        },
        {
            "name": "CSS property",
            "scope": ["support.type.property-name.css", "entity.name.tag.css"],
            "settings": { "foreground": "#ebbcba" }
        },
        {
            "name": "CSS value",
            "scope": [
                "support.constant.property-value.css",
                "constant.other.color"
            ],
            "settings": { "foreground": "#9ccfd8" }
        },
        {
            "name": "Markdown heading",
            "scope": ["markup.heading", "entity.name.section"],
            "settings": { "foreground": "#f6c177", "fontStyle": "bold" }
        },
        {
            "name": "Markdown bold",
            "scope": ["markup.bold"],
            "settings": { "foreground": "#ebbcba", "fontStyle": "bold" }
        },
        {
            "name": "Markdown italic",
            "scope": ["markup.italic"],
            "settings": { "foreground": "#e0def4", "fontStyle": "italic" }
        },
        {
            "name": "Markdown link",
            "scope": ["markup.underline.link"],
            "settings": { "foreground": "#c4a7e7" }
        },
        {
            "name": "Markdown code",
            "scope": ["markup.inline.raw", "markup.fenced_code"],
            "settings": { "foreground": "#ebbcba" }
        },
        {
            "name": "Invalid / Deprecated",
            "scope": ["invalid", "invalid.deprecated"],
            "settings": { "foreground": "#eb6f92" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
