{
    "name": "C Theme",
    "type": "dark",
    "colors": {
        "editor.background": "#1b1c1f",
        "editor.foreground": "#eeffff",
        "sideBarTitle.foreground": "#bbbbbb",
        "contrastBorder": "#1f1f1f",
        "sideBar.background": "#202024",
        "sideBar.foreground": "#dddddd",
        "sideBar.border": "#1f1f1f",
        "sideBarSectionHeader.background": "#2a2a2e",
        "editorGroup.border": "#1f1f1f",
        "activityBar.background": "#2c2c30",
        "editor.wordHighlightBackground": "#2c2c30",
        "editor.wordHighlightStrongBackground": "#2c2c30",
        "editor.hoverHighlightBackground": "#2c2c30",
        "titleBar.activeBackground": "#2c2c30",
        "editorGroupHeader.tabsBackground": "#202024",
        "tab.inactiveBackground": "#232326",
        "menubar.selectionBackground": "#323236",
        "menu.background": "#323236",
        "notifications.background": "#1e1e21",
        "terminal.background": "#1b1c1f",
        "panel.background": "#202024"
    },
    "tokenColors": [
        {
            "name": "Comments",
            "scope": [
                "comment",
                "punctuation.definition.comment",
                "punctuation.definition.comment.begin",
                "punctuation.definition.comment.end"
            ],
            "settings": { "fontStyle": "", "foreground": "#80bf6b" }
        },
        {
            "name": "Pre-Processor Function Names",
            "scope": ["entity.name.function.preprocessor"],
            "settings": { "foreground": "#d7adf7" }
        },
        {
            "name": "Pre-Processor Other 1",
            "scope": [
                "punctuation.definition.directive",
                "keyword.control.directive"
            ],
            "settings": { "foreground": "#a8a8a8" }
        },
        {
            "name": "String End/Begin Characters",
            "scope": [
                "punctuation.definition.string.begin",
                "punctuation.definition.string.end"
            ],
            "settings": { "foreground": "#ffcd87" }
        },
        {
            "name": "Strings",
            "scope": [
                "string.quoted.double",
                "string.quoted.single.c",
                "string.quoted.other.lt-gt"
            ],
            "settings": { "foreground": "#fcb583" }
        },
        {
            "name": "Strings Escape Characters",
            "scope": ["constant.character.escape"],
            "settings": { "foreground": "#fc8391" }
        },
        {
            "name": "String Other 1",
            "scope": ["constant.other.placeholder"],
            "settings": { "foreground": "#fcd483" }
        },
        {
            "name": "Integers",
            "scope": [
                "constant.numeric.decimal",
                "variable.other.enummember",
                "keyword.other.unit.hexadecimal.c",
                "constant.numeric.hexadecimal.c"
            ],
            "settings": { "foreground": "#B5CEA8" }
        },
        {
            "name": "Functions",
            "scope": ["entity.name.function"],
            "settings": { "foreground": "#dede9b" }
        },
        {
            "name": "Types and Other",
            "scope": [
                "keyword.other",
                "storage.modifier",
                "storage.type",
                "keyword.operator.sizeof.c"
            ],
            "settings": { "foreground": "#569CD6" }
        },
        {
            "name": "Custom Types",
            "scope": ["entity.name.type"],
            "settings": { "foreground": "#56d6b8" }
        },
        {
            "name": "Control",
            "scope": ["keyword.control"],
            "settings": { "foreground": "#ce7bd1" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation",
                "storage.modifier.array.bracket.square.c",
                "storage.modifier.pointer.cpp",
                "punctuation.separator.pointer-access.c"
            ],
            "settings": { "foreground": "#D4D4D4" }
        },
        {
            "name": "Variables",
            "scope": ["variable"],
            "settings": { "foreground": "#d1d1d1" }
        },
        {
            "name": "Function Parameters",
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#bababa" }
        },
        {
            "name": "Struct Members",
            "scope": ["variable.other.property"],
            "settings": { "foreground": "#fafafa" }
        },
        {
            "name": "EEFFFF Color things",
            "scope": ["punctuation.separator.pointer-access.c"],
            "settings": { "foreground": "#eeffff" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
