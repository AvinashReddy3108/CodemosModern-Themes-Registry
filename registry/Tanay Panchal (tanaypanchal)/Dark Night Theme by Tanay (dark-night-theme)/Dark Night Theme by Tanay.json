{
    "name": "Midnight Ember",
    "type": "dark",
    "colors": {
        "editor.background": "#292929",
        "editor.foreground": "#e8e8e8",
        "editorCursor.foreground": "#FFCB6B",
        "editor.lineHighlightBackground": "#5454549c",
        "editor.selectionBackground": "#264f78",
        "editor.inactiveSelectionBackground": "#3a3d41",
        "editorIndentGuide.background": "#444444",
        "editorIndentGuide.activeBackground": "#888888",
        "editorWhitespace.foreground": "#3B3A32",
        "editorBracketMatch.background": "#515A6B",
        "editorBracketMatch.border": "#2c2d2eb0",
        "editorGutter.background": "#292929",
        "editorOverviewRuler.border": "#00000000",
        "scrollbarSlider.background": "#6a6a6aa9",
        "scrollbarSlider.hoverBackground": "#6A6A6A88",
        "scrollbarSlider.activeBackground": "#6A6A6AAA",
        "titleBar.activeBackground": "#1a1a1a",
        "titleBar.inactiveBackground": "#2a2a2a",
        "titleBar.activeForeground": "#ffffff",
        "titleBar.inactiveForeground": "#aaaaaa",
        "titleBar.border": "#333333",
        "activityBar.background": "#1a1a1a",
        "activityBar.foreground": "#ffffff",
        "activityBar.inactiveForeground": "#888888",
        "activityBarBadge.background": "#2baeeb",
        "activityBarBadge.foreground": "#ffffff",
        "activityBar.border": "#333333",
        "sideBar.background": "#1a1a1a",
        "sideBar.foreground": "#ffffff",
        "sideBarSectionHeader.background": "#1a1a1a",
        "sideBarSectionHeader.foreground": "#ffffff",
        "sideBar.border": "#444444",
        "tab.activeBackground": "#2c2d2e",
        "tab.inactiveBackground": "#1a1a1a",
        "tab.activeForeground": "#ffffff",
        "tab.inactiveForeground": "#888888",
        "tab.border": "#424141",
        "tab.activeBorderTop": "#53f1ff",
        "editorGroupHeader.tabsBackground": "#1a1a1a"
    },
    "tokenColors": [
        {
            "name": "Keywords",
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#FF5370", "fontStyle": "bold" }
        },
        {
            "name": "Strings",
            "scope": [
                "string",
                "constant.other.symbol",
                "constant.character.escape"
            ],
            "settings": { "foreground": "#df8063" }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call"
            ],
            "settings": { "foreground": "#82AAFF" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "variable.parameter", "entity.name.variable"],
            "settings": { "foreground": "#FFCB6B" }
        },
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#62ab0e", "fontStyle": "italic" }
        },
        {
            "name": "Numbers",
            "scope": ["constant.numeric", "constant.language.numeric"],
            "settings": { "foreground": "#F78C6C" }
        },
        {
            "name": "Operators",
            "scope": [
                "keyword.operator",
                "punctuation.separator",
                "punctuation.terminator"
            ],
            "settings": { "foreground": "#89DDFF" }
        },
        {
            "name": "Types",
            "scope": ["support.type", "entity.name.type"],
            "settings": { "foreground": "#C792EA" }
        },
        {
            "name": "Tags",
            "scope": [
                "entity.name.tag",
                "markup.deleted.git_gutter",
                "markup.changed.git_gutter",
                "markup.inserted.git_gutter"
            ],
            "settings": { "foreground": "#FFCB6B" }
        },
        {
            "name": "Attributes",
            "scope": ["entity.other.attribute-name", "entity.name.attribute"],
            "settings": { "foreground": "#82AAFF" }
        },
        {
            "name": "Constants",
            "scope": ["constant.language", "constant.character"],
            "settings": { "foreground": "#FF5370", "fontStyle": "bold" }
        },
        {
            "name": "Markdown - Headings",
            "scope": ["markup.heading.markdown", "markup.heading entity.name"],
            "settings": { "foreground": "#C3E88D", "fontStyle": "bold" }
        },
        {
            "name": "Markdown - Bold",
            "scope": ["markup.bold", "markup.bold string"],
            "settings": { "foreground": "#FF5370", "fontStyle": "bold" }
        },
        {
            "name": "Markdown - Italic",
            "scope": ["markup.italic"],
            "settings": { "foreground": "#F78C6C", "fontStyle": "italic" }
        },
        {
            "name": "Markdown - Blockquote",
            "scope": ["markup.quote"],
            "settings": { "foreground": "#65737E", "fontStyle": "italic" }
        },
        {
            "name": "Markdown - Links",
            "scope": ["string.other.link.title.markdown"],
            "settings": { "foreground": "#82AAFF", "fontStyle": "underline" }
        },
        {
            "name": "Markdown - Fenced Code Block",
            "scope": ["markup.raw.block.fenced.markdown"],
            "settings": { "foreground": "#FFCB6B", "fontStyle": "bold" }
        },
        {
            "name": "JSON - Property names",
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#FFCB6B" }
        },
        {
            "name": "JSON - Brackets and punctuation",
            "scope": [
                "punctuation.definition.array.begin.json",
                "punctuation.definition.array.end.json",
                "punctuation.definition.object.begin.json",
                "punctuation.definition.object.end.json",
                "punctuation.separator.key-value.json",
                "punctuation.separator.array.json"
            ],
            "settings": { "foreground": "#89DDFF" }
        },
        {
            "name": "CSS - Property names",
            "scope": ["support.type.property-name.css"],
            "settings": { "foreground": "#FFCB6B" }
        },
        {
            "name": "CSS - Selectors",
            "scope": ["entity.name.tag.css"],
            "settings": { "foreground": "#FF5370" }
        },
        {
            "name": "CSS - Pseudo selectors",
            "scope": [
                "entity.other.attribute-name.pseudo-element.css",
                "entity.other.attribute-name.pseudo-class.css"
            ],
            "settings": { "foreground": "#C792EA" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
