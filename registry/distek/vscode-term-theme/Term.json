        "editorSuggestWidget.highlightForeground": "#689DC0",
        "editorSuggestWidget.selectedBackground": "#49515f",
        "editorSuggestWidget.selectedForeground": "#b5b4d9",
        "editorWidget.background": "#20242a",
        "input.background": "#2f343e",
        "input.foreground": "#b5b4d9",
        "list.activeSelectionBackground": "#ceb855",
        "list.activeSelectionForeground": "#181b20",
        "list.focusOutline": "#b5b4d9",
        "list.inactiveSelectionBackground": "#a69546",
        "list.inactiveSelectionForeground": "#181b20",
        "menu.background": "#2f343e",
        "panel.background": "#101419",
        "peekView.border": "#3e4553",
        "peekViewEditor.background": "#23272e",
        "peekViewEditor.matchHighlightBackground": "#6f632e",
        "peekViewEditorGutter.background": "#2f343e",
        "peekViewResult.background": "#2f343e",
        "peekViewResult.matchHighlightBackground": "#6f632e",
        "quickInput.background": "#2f343e",
        "quickInput.foreground": "#b5b4d9",
        "quickInputList.focusBackground": "#424957",
        "quickInputList.focusForeground": "#c0bfe7",
        "settings.modifiedItemIndicator": "#A483B9",
        "sideBar.background": "#393f4a",
        "sideBar.border": "#485261",
        "sideBar.foreground": "#b5b4d9",
        "sideBarSectionHeader.background": "#242930",
        "sideBarSectionHeader.border": "#424b56",
        "sideBarTitle.foreground": "#b5b4d9",
        "statusBar.background": "#1e2126",
        "statusBar.debuggingBackground": "#AF6A6A",
        "statusBar.debuggingForeground": "#181b20",
        "statusBar.foreground": "#b5b4d9",
        "statusBar.noFolderBackground": "#1e2126",
        "statusBar.noFolderForeground": "#b5b4d9",
        "tab.activeBackground": "#181b20",
        "tab.activeBorderTop": "#b5b4d9",
        "tab.activeForeground": "#b5b4d9",
        "tab.border": "#181b20",
        "tab.inactiveBackground": "#343b46",
        "terminal.ansiBlack": "#485261",
        "terminal.ansiBlue": "#689DC0",
        "terminal.ansiBrightBlack": "#576375",
        "terminal.ansiBrightBlue": "#76A6C6",
        "terminal.ansiBrightCyan": "#7AB8A5",
        "terminal.ansiBrightGreen": "#B3C86F",
        "terminal.ansiBrightMagenta": "#A483B9",
        "terminal.ansiBrightRed": "#B87A7A",
        "terminal.ansiBrightWhite": "#D3D8DE",
        "terminal.ansiBrightYellow": "#D3C069",
        "terminal.ansiCyan": "#6AAF9A",
        "terminal.ansiGreen": "#AAC15C",
        "terminal.ansiMagenta": "#9773B0",
        "terminal.ansiRed": "#AF6A6A",
        "terminal.ansiWhite": "#CDD3DA",
        "terminal.ansiYellow": "#CEB855",
        "textLink.activeForeground": "#7AB8A5",
        "textLink.foreground": "#76A6C6",
        "titleBar.activeBackground": "#576375",
        "titleBar.activeForeground": "#dcdbff"
