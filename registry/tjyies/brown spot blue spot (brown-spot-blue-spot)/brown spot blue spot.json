    "semanticHighlighting": true,
    "semanticTokenColors": {
        "property": "#9af8ff",
        "parameter": "#3cf2ff",
        "variable": "#3cf2ff",
        "variable.readonly": "#3cf2ff",
        "variable.readonly.defaultLibrary": "#5fbfff",
        "property.readonly": "#5fbfff",
        "type": "#35f099da",
        "type.defaultLibrary": "#35f099da",
        "enum": "#4FC1FF",
        "enumMember": "#9af8ff",
        "string": "#ffb167",
        "comment": "#96e073",
        "method": "#ffff83",
        "method.defaultLibrary": "#ffff83",
        "function": "#ffff83",
        "function.defaultLibrary": "#ffff83",
        "class": "#35f099da",
        "class.defaultLibrary": "#35f099da",
        "interface": "#35f099da",
        "namespace": "#ffaad5",
        "macro": "#3cb1ff",
        "event": "#ff0000"
    },
    "tokenColors": [
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#a5ff7c" }
        },
        {
            "scope": ["punctuation", "meta.brace"],
            "settings": { "foreground": "#ffffff" }
        },
        {
            "scope": [
                "string",
                "punctuation.definition.string.begin",
                "punctuation.definition.string.end",
                "punctuation.definition.string.template.begin",
                "punctuation.definition.string.template.end"
            ],
            "settings": { "foreground": "#ffb167" }
        },
        {
            "scope": ["support.type.primitive.ts"],
            "settings": { "foreground": "#35f099da" }
        },
        {
            "scope": [
                "storage.type",
                "constant.language.boolean",
                "storage.modifier",
                "variable.language.this.ts"
            ],
            "settings": { "foreground": "#3cb1ff" }
        },
        {
            "scope": ["keyword.control", "storage.modifier.async.ts"],
            "settings": { "foreground": "#f479ffe8" }
        },
        {
            "scope": "constant.numeric",
            "settings": { "foreground": "#f6afffef" }
        },
        {
            "scope": "constant.boolean",
            "settings": { "foreground": "#FF0000" }
        },
        {
            "scope": "entity.name.function.c",
            "settings": { "foreground": "#ffff83" }
        },
        {
            "scope": [
                "variable.other",
                "support.type.property-name.css",
                "entity.other.attribute-name.html"
            ],
            "settings": { "foreground": "#3cf2ff" }
        },
        {
            "scope": [
                "entity.name.tag.css",
                "entity.other.attribute-name.class.css"
            ],
            "settings": { "foreground": "#D7BA7D" }
        },
        {
            "scope": [
                "support.constant.property-value.css",
                "support.constant.color.w3c-extended-color-name",
                "support.constant.color.w3c-standard-color-name.css",
                "string.quoted.double.css"
            ],
            "settings": { "foreground": "#ff976e" }
        },
        {
            "scope": ["entity.name.tag.html"],
            "settings": { "foreground": "#ffff83" }
        },
        {
            "scope": [
                "punctuation.definition.tag.end.html",
                "punctuation.definition.tag.begin.html"
            ],
            "settings": { "foreground": "#c0c056" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
