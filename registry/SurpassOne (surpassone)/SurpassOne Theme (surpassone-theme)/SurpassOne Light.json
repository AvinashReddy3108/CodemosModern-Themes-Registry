    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#A7A19E", "fontStyle": "italic" }
        },
        {
            "name": "Keyword",
            "scope": [
                "keyword",
                "keyword.control",
                "storage.type",
                "storage.modifier",
                "keyword.other.using",
                "keyword.other.directive"
            ],
            "settings": { "foreground": "#8A6358" }
        },
        {
            "name": "Operator",
            "scope": ["keyword.operator", "keyword.operator.expression"],
            "settings": { "foreground": "#706A68" }
        },
        {
            "name": "String",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#4C4C4C" }
        },
        {
            "name": "String escape",
            "scope": ["constant.character.escape"],
            "settings": { "foreground": "#C05248", "fontStyle": "bold" }
        },
        {
            "name": "Number",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#4C4C4C" }
        },
        {
            "name": "Built-in constant",
            "scope": ["constant.language"],
            "settings": { "foreground": "#4C4C4C" }
        },
        {
            "name": "Variable language (this, self)",
            "scope": ["variable.language"],
            "settings": { "foreground": "#C05248", "fontStyle": "bold" }
        },
        {
            "name": "Type",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "entity.other.inherited-class",
                "support.type",
                "support.class",
                "entity.name.type.interface",
                "entity.name.type.enum",
                "entity.name.type.alias"
            ],
            "settings": { "foreground": "#9A5548" }
        },
        {
            "name": "Function definition",
            "scope": ["entity.name.function"],
            "settings": { "foreground": "#C05248", "fontStyle": "bold" }
        },
        {
            "name": "Function call",
            "scope": ["support.function", "meta.function-call"],
            "settings": { "foreground": "#333333" }
        },
        {
            "name": "Variable",
            "scope": [
                "variable",
                "variable.other",
                "variable.parameter",
                "support.variable"
            ],
            "settings": { "foreground": "#333333" }
        },
        {
            "name": "Property",
            "scope": [
                "variable.other.property",
                "support.other.property",
                "variable.other.object.property"
            ],
            "settings": { "foreground": "#333333" }
        },
        {
            "name": "Punctuation",
            "scope": ["punctuation", "meta.brace", "meta.bracket"],
            "settings": { "foreground": "#706A68" }
        },
        {
            "name": "Tag",
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#C05248", "fontStyle": "bold" }
        },
        {
            "name": "Tag attribute",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#4C4C4C" }
        },
        {
            "name": "Decorator / Annotation",
            "scope": [
                "meta.decorator",
                "meta.decorator entity.name.function",
                "punctuation.decorator"
            ],
            "settings": { "foreground": "#8A6358" }
        },
        {
            "name": "CSS property name",
            "scope": [
                "support.type.property-name.css",
                "support.type.property-name.scss",
                "support.type.property-name.less"
            ],
            "settings": { "foreground": "#8A6358" }
        },
        {
            "name": "CSS value",
            "scope": [
                "support.constant.property-value.css",
                "support.constant.color.css"
            ],
            "settings": { "foreground": "#4C4C4C" }
        },
        {
            "name": "CSS unit",
            "scope": ["keyword.other.unit.css", "keyword.other.unit.scss"],
            "settings": { "foreground": "#4C4C4C" }
        },
        {
            "name": "Regex",
            "scope": ["string.regexp"],
            "settings": { "foreground": "#4C4C4C" }
        },
        {
            "name": "Markdown heading",
            "scope": ["markup.heading", "entity.name.section.markdown"],
            "settings": { "foreground": "#C05248", "fontStyle": "bold" }
        },
        {
            "name": "Markdown bold",
            "scope": ["markup.bold"],
            "settings": { "fontStyle": "bold" }
        },
        {
            "name": "Markdown italic",
            "scope": ["markup.italic"],
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "Markdown link",
            "scope": ["markup.underline.link", "string.other.link"],
            "settings": { "foreground": "#4C4C4C" }
        },
        {
            "name": "Markdown code",
            "scope": ["markup.inline.raw", "markup.fenced_code"],
            "settings": { "foreground": "#4C4C4C" }
        },
        {
            "name": "JSON key",
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#8A6358" }
        },
        {
            "name": "YAML key",
            "scope": ["entity.name.tag.yaml"],
            "settings": { "foreground": "#8A6358" }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "type": "#9A5548",
        "class": "#9A5548",
        "interface": "#9A5548",
        "enum": "#9A5548",
        "enumMember": "#4C4C4C",
        "namespace": "#333333",
        "function.declaration": {
            "foreground": "#C05248",
            "fontStyle": "bold"
        },
        "method.declaration": { "foreground": "#C05248", "fontStyle": "bold" },
        "function": "#333333",
        "method": "#333333",
        "parameter": "#333333",
        "property": "#333333",
        "variable": "#333333",
        "variable.readonly": "#333333",
        "*.deprecated": {
            "foreground": "#A7A19E",
            "fontStyle": "strikethrough"
        }
    }
}
