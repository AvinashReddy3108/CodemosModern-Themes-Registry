        {
            "name": "Go builtins",
            "scope": ["support.function.builtin.go"],
            "settings": { "foreground": "#7A9189" }
        },
        {
            "name": "C/C++ preprocessor",
            "scope": [
                "keyword.control.directive.include",
                "keyword.control.directive.define",
                "keyword.control.directive.conditional",
                "meta.preprocessor"
            ],
            "settings": { "foreground": "#9A8CA8" }
        },
        {
            "name": "C/C++ types",
            "scope": [
                "support.type.sys-types.c",
                "support.type.sys-types.cpp",
                "storage.type.built-in.c",
                "storage.type.built-in.cpp"
            ],
            "settings": { "foreground": "#6A8A8A" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid"],
            "settings": { "foreground": "#8BA382", "fontStyle": "underline" }
        },
        {
            "name": "Deprecated",
            "scope": ["invalid.deprecated"],
            "settings": {
                "foreground": "#5A544D",
                "fontStyle": "strikethrough"
            }
        },
        {
            "name": "Support functions",
            "scope": ["support.function"],
            "settings": { "foreground": "#7A9189" }
        },
        {
            "name": "Support classes",
            "scope": ["support.class"],
            "settings": { "foreground": "#6A8A8A" }
        },
        {
            "name": "Support constants",
            "scope": ["support.constant"],
            "settings": { "foreground": "#B0A080" }
        },
        {
            "name": "Entity names",
            "scope": ["entity.name"],
            "settings": { "foreground": "#6A8A8A" }
        },
        {
            "name": "Namespace",
            "scope": ["entity.name.namespace", "entity.name.module"],
            "settings": { "foreground": "#6A8A8A" }
        }
    ],
    "semanticTokenColors": {
        "variable": "#D5D0C5",
        "variable.readonly": "#B0A080",
        "variable.defaultLibrary": "#8BA382",
        "parameter": { "foreground": "#B0A080", "fontStyle": "italic" },
        "function": "#7A9189",
        "function.defaultLibrary": "#7A9189",
        "method": "#7A9189",
        "class": { "foreground": "#6A8A8A", "fontStyle": "bold" },
        "interface": { "foreground": "#6A8A8A", "fontStyle": "italic" },
        "enum": "#6A8A8A",
        "enumMember": "#B0A080",
        "type": { "foreground": "#6A8A8A", "fontStyle": "italic" },
        "typeParameter": "#B0A080",
        "namespace": "#6A8A8A",
        "property": "#8A8579",
        "property.readonly": "#B0A080",
        "macro": "#9A8CA8",
        "keyword": "#6D8A66",
        "comment": { "foreground": "#5A544D", "fontStyle": "italic" },
        "string": "#D0C5B5",
        "number": "#9A8CA8",
        "regexp": "#8BA382",
        "operator": "#6D8A66",
        "decorator": "#9A8CA8"
    }
}
