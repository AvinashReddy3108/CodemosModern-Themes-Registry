    "tokenColors": [
        { "scope": ["emphasis"], "settings": { "fontStyle": "italic" } },
        { "scope": ["strong"], "settings": { "fontStyle": "bold" } },
        { "scope": ["header"], "settings": { "foreground": "#6D8A66" } },
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#5A544D", "fontStyle": "italic" }
        },
        {
            "name": "JSDoc keywords",
            "scope": [
                "comment keyword.codetag.notation",
                "comment.block.documentation keyword",
                "storage.type.class.jsdoc"
            ],
            "settings": { "foreground": "#9A8CA8" }
        },
        {
            "name": "JSDoc types",
            "scope": [
                "comment.block.documentation variable.other",
                "comment.block.documentation entity.name.type"
            ],
            "settings": { "foreground": "#6A8A8A", "fontStyle": "italic" }
        },
        {
            "name": "Strings",
            "scope": ["string"],
            "settings": { "foreground": "#D0C5B5" }
        },
        {
            "name": "String quotes",
            "scope": [
                "punctuation.definition.string.begin",
                "punctuation.definition.string.end"
            ],
            "settings": { "foreground": "#C0B5A5" }
        },
        {
            "name": "Template string punctuation",
            "scope": [
                "punctuation.definition.template-expression.begin",
                "punctuation.definition.template-expression.end"
            ],
            "settings": { "foreground": "#6D8A66" }
        },
        {
            "name": "Template string interpolation",
            "scope": ["meta.template.expression"],
            "settings": { "foreground": "#D5D0C5" }
        },
        {
            "name": "Constants",
            "scope": ["constant", "variable.other.constant"],
            "settings": { "foreground": "#B0A080" }
        },
        {
            "name": "Numbers",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#9A8CA8" }
        },
        {
            "name": "Boolean",
            "scope": ["constant.language.boolean"],
            "settings": { "foreground": "#8BA382" }
        },
        {
            "name": "Null/Undefined",
            "scope": ["constant.language.null", "constant.language.undefined"],
            "settings": { "foreground": "#8BA382", "fontStyle": "italic" }
        },
        {
            "name": "Keywords",
            "scope": ["keyword"],
            "settings": { "foreground": "#6D8A66" }
        },
        {
            "name": "Storage keywords",
            "scope": ["storage.type", "storage.modifier"],
            "settings": { "foreground": "#6D8A66", "fontStyle": "italic" }
        },
        {
            "name": "Control keywords",
            "scope": ["keyword.control"],
            "settings": { "foreground": "#6D8A66" }
        },
        {
            "name": "Import/Export",
            "scope": [
                "keyword.control.import",
                "keyword.control.export",
                "keyword.control.from"
            ],
            "settings": { "foreground": "#6D8A66", "fontStyle": "italic" }
        },
        {
            "name": "Function names",
            "scope": ["entity.name.function", "meta.function-call"],
            "settings": { "foreground": "#7A9189" }
        },
        {
            "name": "Function parameters",
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#B0A080", "fontStyle": "italic" }
        },
        {
            "name": "Arrow functions",
            "scope": ["storage.type.function.arrow"],
            "settings": { "foreground": "#6D8A66" }
        },
        {
            "name": "Classes",
            "scope": ["entity.name.type.class", "entity.name.class"],
            "settings": { "foreground": "#6A8A8A", "fontStyle": "bold" }
        },
        {
            "name": "Interfaces",
            "scope": ["entity.name.type.interface"],
            "settings": { "foreground": "#6A8A8A", "fontStyle": "italic" }
        },
        {
            "name": "Types",
            "scope": ["entity.name.type", "support.type"],
            "settings": { "foreground": "#6A8A8A", "fontStyle": "italic" }
        },
        {
            "name": "Type parameters",
            "scope": ["entity.name.type.parameter"],
            "settings": { "foreground": "#B0A080" }
        },
        {
            "name": "Variables",
            "scope": ["variable"],
            "settings": { "foreground": "#D5D0C5" }
        },
        {
            "name": "Language variables",
            "scope": ["variable.language"],
            "settings": { "foreground": "#8BA382", "fontStyle": "italic" }
        },
        {
            "name": "Object properties",
            "scope": ["variable.other.property", "meta.object-literal.key"],
            "settings": { "foreground": "#8A8579" }
        },
        {
            "name": "HTML tags",
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#6D8A66" }
        },
        {
            "name": "HTML attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#B0A080", "fontStyle": "italic" }
        },
        {
            "name": "HTML attribute values",
            "scope": ["string.quoted.double.html", "string.quoted.single.html"],
            "settings": { "foreground": "#D0C5B5" }
        },
        {
            "name": "CSS selectors",
            "scope": [
                "meta.selector",
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css"
            ],
            "settings": { "foreground": "#6A8A8A" }
        },
        {
            "name": "CSS properties",
            "scope": ["support.type.property-name.css"],
            "settings": { "foreground": "#7A9189" }
        },
        {
            "name": "CSS values",
            "scope": [
                "support.constant.property-value.css",
                "meta.property-value.css"
            ],
            "settings": { "foreground": "#B0A080" }
        },
        {
            "name": "CSS units",
            "scope": ["keyword.other.unit.css"],
            "settings": { "foreground": "#9A8CA8" }
        },
        {
            "name": "CSS pseudo",
            "scope": [
                "entity.other.attribute-name.pseudo-class.css",
                "entity.other.attribute-name.pseudo-element.css"
            ],
            "settings": { "foreground": "#6D8A66" }
        },
        {
            "name": "Operators",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#6D8A66" }
        },
        {
            "name": "Comparison operators",
            "scope": [
                "keyword.operator.comparison",
                "keyword.operator.relational"
            ],
            "settings": { "foreground": "#6A8A8A" }
        },
        {
            "name": "Logical operators",
            "scope": ["keyword.operator.logical"],
            "settings": { "foreground": "#6D8A66" }
        },
        {
            "name": "Punctuation",
            "scope": ["punctuation"],
            "settings": { "foreground": "#8A8579" }
        },
        {
            "name": "Brackets",
            "scope": ["punctuation.definition.block", "meta.brace"],
            "settings": { "foreground": "#8A8579" }
        },
        {
            "name": "RegExp",
            "scope": ["string.regexp"],
            "settings": { "foreground": "#8BA382" }
        },
        {
            "name": "RegExp groups",
            "scope": [
                "punctuation.definition.group.regexp",
                "keyword.operator.quantifier.regexp"
            ],
            "settings": { "foreground": "#9A8CA8" }
        },
        {
            "name": "Decorators/Annotations",
            "scope": ["meta.decorator", "punctuation.decorator"],
            "settings": { "foreground": "#9A8CA8" }
        },
        {
            "name": "Markdown headings",
            "scope": [
                "markup.heading",
                "heading.1.markdown",
                "heading.2.markdown",
                "heading.3.markdown"
            ],
            "settings": { "foreground": "#6D8A66", "fontStyle": "bold" }
        },
        {
            "name": "Markdown bold",
            "scope": ["markup.bold"],
            "settings": { "foreground": "#B0A080", "fontStyle": "bold" }
        },
        {
            "name": "Markdown italic",
            "scope": ["markup.italic"],
            "settings": { "foreground": "#9A8CA8", "fontStyle": "italic" }
        },
        {
            "name": "Markdown links",
            "scope": ["markup.underline.link", "string.other.link"],
            "settings": { "foreground": "#7A9189" }
        },
        {
            "name": "Markdown code",
            "scope": ["markup.inline.raw", "markup.fenced_code.block"],
            "settings": { "foreground": "#D0C5B5" }
        },
        {
            "name": "Markdown quotes",
            "scope": ["markup.quote"],
            "settings": { "foreground": "#5A544D", "fontStyle": "italic" }
        },
        {
            "name": "Markdown list",
            "scope": ["punctuation.definition.list.begin.markdown"],
            "settings": { "foreground": "#6D8A66" }
        },
        {
            "name": "JSON keys",
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#6D8A66" }
        },
        {
            "name": "JSON strings",
            "scope": ["string.quoted.double.json"],
            "settings": { "foreground": "#D0C5B5" }
        },
        {
            "name": "YAML keys",
            "scope": ["entity.name.tag.yaml"],
            "settings": { "foreground": "#6D8A66" }
        },
        {
            "name": "Python self/cls",
