            "settings": { "foreground": "#7BA3A3" }
        },
        {
            "name": "Logical operators",
            "scope": ["keyword.operator.logical"],
            "settings": { "foreground": "#7D9B76" }
        },
        {
            "name": "Punctuation",
            "scope": ["punctuation"],
            "settings": { "foreground": "#A89F8B" }
        },
        {
            "name": "Brackets",
            "scope": ["punctuation.definition.block", "meta.brace"],
            "settings": { "foreground": "#A89F8B" }
        },
        {
            "name": "RegExp",
            "scope": ["string.regexp"],
            "settings": { "foreground": "#A4C49B" }
        },
        {
            "name": "RegExp groups",
            "scope": [
                "punctuation.definition.group.regexp",
