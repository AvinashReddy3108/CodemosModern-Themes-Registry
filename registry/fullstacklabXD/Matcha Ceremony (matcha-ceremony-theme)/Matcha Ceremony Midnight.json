            "settings": { "foreground": "#7D9B76" }
        },
        {
            "name": "Operators",
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#7D9B76" }
        },
        {
            "name": "Comparison operators",
            "scope": [
                "keyword.operator.comparison",
