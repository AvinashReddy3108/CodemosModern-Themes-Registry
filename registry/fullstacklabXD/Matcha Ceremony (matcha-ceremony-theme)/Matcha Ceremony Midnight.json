            ],
            "settings": { "foreground": "#B8A9C9" }
        },
        {
            "name": "Decorators/Annotations",
            "scope": ["meta.decorator", "punctuation.decorator"],
            "settings": { "foreground": "#B8A9C9" }
        },
        {
            "name": "Markdown headings",
            "scope": [
                "markup.heading",
                "heading.1.markdown",
                "heading.2.markdown",
                "heading.3.markdown"
            ],
            "settings": { "foreground": "#7D9B76", "fontStyle": "bold" }
        },
        {
            "name": "Markdown bold",
            "scope": ["markup.bold"],
            "settings": { "foreground": "#C9B896", "fontStyle": "bold" }
        },
        {
            "name": "Markdown italic",
            "scope": ["markup.italic"],
            "settings": { "foreground": "#B8A9C9", "fontStyle": "italic" }
        },
        {
            "name": "Markdown links",
            "scope": ["markup.underline.link", "string.other.link"],
            "settings": { "foreground": "#8FA8A0" }
        },
        {
            "name": "Markdown code",
            "scope": ["markup.inline.raw", "markup.fenced_code.block"],
            "settings": { "foreground": "#E8DCC4" }
        },
        {
            "name": "Markdown quotes",
            "scope": ["markup.quote"],
            "settings": { "foreground": "#6B6357", "fontStyle": "italic" }
        },
        {
            "name": "Markdown list",
            "scope": ["punctuation.definition.list.begin.markdown"],
            "settings": { "foreground": "#7D9B76" }
        },
        {
            "name": "JSON keys",
