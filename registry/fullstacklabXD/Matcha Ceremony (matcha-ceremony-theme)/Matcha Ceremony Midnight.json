        },
        {
            "name": "Go builtins",
            "scope": ["support.function.builtin.go"],
            "settings": { "foreground": "#8FA8A0" }
        },
        {
            "name": "C/C++ preprocessor",
            "scope": [
                "keyword.control.directive.include",
                "keyword.control.directive.define",
                "keyword.control.directive.conditional",
                "meta.preprocessor"
            ],
            "settings": { "foreground": "#B8A9C9" }
        },
        {
            "name": "C/C++ types",
            "scope": [
                "support.type.sys-types.c",
                "support.type.sys-types.cpp",
                "storage.type.built-in.c",
                "storage.type.built-in.cpp"
            ],
            "settings": { "foreground": "#7BA3A3" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid"],
            "settings": { "foreground": "#A4C49B", "fontStyle": "underline" }
        },
        {
            "name": "Deprecated",
            "scope": ["invalid.deprecated"],
            "settings": {
                "foreground": "#6B6357",
                "fontStyle": "strikethrough"
            }
        },
        {
            "name": "Support functions",
            "scope": ["support.function"],
            "settings": { "foreground": "#8FA8A0" }
        },
        {
            "name": "Support classes",
            "scope": ["support.class"],
            "settings": { "foreground": "#7BA3A3" }
        },
        {
            "name": "Support constants",
            "scope": ["support.constant"],
            "settings": { "foreground": "#C9B896" }
        },
        {
            "name": "Entity names",
            "scope": ["entity.name"],
            "settings": { "foreground": "#7BA3A3" }
        },
        {
            "name": "Namespace",
            "scope": ["entity.name.namespace", "entity.name.module"],
            "settings": { "foreground": "#7BA3A3" }
        }
    ],
    "semanticTokenColors": {
        "variable": "#EDE8DC",
        "variable.readonly": "#C9B896",
        "variable.defaultLibrary": "#A4C49B",
        "parameter": { "foreground": "#C9B896", "fontStyle": "italic" },
        "function": "#8FA8A0",
        "function.defaultLibrary": "#8FA8A0",
        "method": "#8FA8A0",
        "class": { "foreground": "#7BA3A3", "fontStyle": "bold" },
        "interface": { "foreground": "#7BA3A3", "fontStyle": "italic" },
        "enum": "#7BA3A3",
        "enumMember": "#C9B896",
        "type": { "foreground": "#7BA3A3", "fontStyle": "italic" },
        "typeParameter": "#C9B896",
        "namespace": "#7BA3A3",
        "property": "#A89F8B",
        "property.readonly": "#C9B896",
        "macro": "#B8A9C9",
        "keyword": "#7D9B76",
        "comment": { "foreground": "#6B6357", "fontStyle": "italic" },
        "string": "#E8DCC4",
        "number": "#B8A9C9",
        "regexp": "#A4C49B",
        "operator": "#7D9B76",
        "decorator": "#B8A9C9"
    }
}
