    "tokenColors": [
        { "scope": ["emphasis"], "settings": { "fontStyle": "italic" } },
        { "scope": ["strong"], "settings": { "fontStyle": "bold" } },
        { "scope": ["header"], "settings": { "foreground": "#7D9B76" } },
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#6B6357", "fontStyle": "italic" }
        },
        {
            "name": "JSDoc keywords",
            "scope": [
                "comment keyword.codetag.notation",
                "comment.block.documentation keyword",
                "storage.type.class.jsdoc"
            ],
            "settings": { "foreground": "#B8A9C9" }
        },
        {
            "name": "JSDoc types",
            "scope": [
                "comment.block.documentation variable.other",
                "comment.block.documentation entity.name.type"
            ],
            "settings": { "foreground": "#7BA3A3", "fontStyle": "italic" }
        },
        {
            "name": "Strings",
            "scope": ["string"],
            "settings": { "foreground": "#E8DCC4" }
        },
        {
            "name": "String quotes",
            "scope": [
                "punctuation.definition.string.begin",
                "punctuation.definition.string.end"
            ],
            "settings": { "foreground": "#D4C4A8" }
        },
        {
            "name": "Template string punctuation",
            "scope": [
                "punctuation.definition.template-expression.begin",
                "punctuation.definition.template-expression.end"
            ],
            "settings": { "foreground": "#7D9B76" }
        },
        {
            "name": "Template string interpolation",
            "scope": ["meta.template.expression"],
            "settings": { "foreground": "#EDE8DC" }
        },
        {
            "name": "Constants",
            "scope": ["constant", "variable.other.constant"],
            "settings": { "foreground": "#C9B896" }
        },
        {
            "name": "Numbers",
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#B8A9C9" }
        },
        {
            "name": "Boolean",
            "scope": ["constant.language.boolean"],
            "settings": { "foreground": "#A4C49B" }
        },
        {
            "name": "Null/Undefined",
            "scope": ["constant.language.null", "constant.language.undefined"],
            "settings": { "foreground": "#A4C49B", "fontStyle": "italic" }
        },
        {
            "name": "Keywords",
            "scope": ["keyword"],
            "settings": { "foreground": "#7D9B76" }
        },
        {
            "name": "Storage keywords",
            "scope": ["storage.type", "storage.modifier"],
            "settings": { "foreground": "#7D9B76", "fontStyle": "italic" }
        },
        {
            "name": "Control keywords",
            "scope": ["keyword.control"],
            "settings": { "foreground": "#7D9B76" }
        },
        {
            "name": "Import/Export",
            "scope": [
                "keyword.control.import",
                "keyword.control.export",
                "keyword.control.from"
            ],
            "settings": { "foreground": "#7D9B76", "fontStyle": "italic" }
        },
        {
            "name": "Function names",
            "scope": ["entity.name.function", "meta.function-call"],
            "settings": { "foreground": "#8FA8A0" }
        },
        {
            "name": "Function parameters",
            "scope": ["variable.parameter"],
            "settings": { "foreground": "#C9B896", "fontStyle": "italic" }
        },
        {
            "name": "Arrow functions",
            "scope": ["storage.type.function.arrow"],
            "settings": { "foreground": "#7D9B76" }
        },
        {
            "name": "Classes",
            "scope": ["entity.name.type.class", "entity.name.class"],
            "settings": { "foreground": "#7BA3A3", "fontStyle": "bold" }
        },
        {
            "name": "Interfaces",
            "scope": ["entity.name.type.interface"],
            "settings": { "foreground": "#7BA3A3", "fontStyle": "italic" }
        },
        {
            "name": "Types",
            "scope": ["entity.name.type", "support.type"],
            "settings": { "foreground": "#7BA3A3", "fontStyle": "italic" }
        },
        {
            "name": "Type parameters",
            "scope": ["entity.name.type.parameter"],
            "settings": { "foreground": "#C9B896" }
        },
        {
            "name": "Variables",
            "scope": ["variable"],
            "settings": { "foreground": "#EDE8DC" }
        },
        {
            "name": "Language variables",
            "scope": ["variable.language"],
            "settings": { "foreground": "#A4C49B", "fontStyle": "italic" }
        },
        {
            "name": "Object properties",
