        {
            "name": "Link",
            "scope": "string.detected-link",
            "settings": { "foreground": "#58B0C7" }
        },
        {
            "name": "diff.header",
            "scope": ["meta.diff", "meta.diff.header"],
            "settings": { "foreground": "#FFFFFF" }
        },
        {
            "name": "diff.deleted",
            "scope": "markup.deleted",
            "settings": { "foreground": "#9E7070" }
        },
        {
            "name": "diff.inserted",
            "scope": "markup.inserted",
            "settings": { "foreground": "#57A05C" }
        },
        {
            "name": "diff.changed",
            "scope": "markup.changed",
            "settings": { "foreground": "#557EAE" }
        },
        {
            "scope": "constant.numeric.line-number.find-in-files - match",
            "settings": { "foreground": "#FFDE72" }
        },
        {
            "scope": "entity.name.filename.find-in-files",
            "settings": { "foreground": "#547FBD" }
        },
        {
            "name": "HTML - Tag Braces",
            "scope": [
                "punctuation.definition.tag.begin.html",
                "punctuation.definition.tag.end.html"
            ],
            "settings": { "foreground": "#e76666" }
        },
        {
            "name": "Markup: Braced-Link Title",
            "scope": ["string.other.link.title.markdown"],
            "settings": { "foreground": "#9079C7" }
        },
        {
            "name": "Markup: Punctuation - Quote",
            "scope": "markup.quote.markdown",
            "settings": { "foreground": "#6E7482" }
        },
        {
            "name": "Markup: Punctuation - Heading",
            "scope": ["punctuation.definition.heading.markdown"],
            "settings": { "foreground": "#78C988" }
        },
        {
            "name": "Markup: Punctuation - Bold",
            "scope": ["punctuation.definition.bold.markdown"],
            "settings": { "foreground": "#CB8080" }
        },
        {
            "name": "Markup: Emphasis Punctuation",
            "scope": "punctuation.definition.italic.markdown",
            "settings": { "foreground": "#87B1C2" }
        },
        {
            "name": "Markdown: Italic",
            "scope": "markup.italic.markdown",
            "settings": { "foreground": "#87B1C2", "fontStyle": "italic" }
        },
        {
            "name": "Markdown: Link",
            "scope": "markup.underline.link.markdown",
            "settings": { "foreground": "#9079C7", "fontStyle": "italic" }
        },
        {
            "name": "Markup: Bold",
            "scope": "markup.bold.markdown",
            "settings": { "foreground": "#CB8080" }
        },
        {
            "name": "Markup: Heading",
            "scope": ["markup.heading.markdown"],
            "settings": { "fontStyle": "bold", "foreground": "#78C988" }
        },
        {
            "name": "Markup: Quote",
            "scope": "markup.quote.markdown",
            "settings": { "fontStyle": "italic", "foreground": "#6E7482" }
        },
        {
            "name": "Markup: Separator",
            "scope": "meta.separator.markdown",
            "settings": { "fontStyle": "bold", "foreground": "#3B3E46" }
