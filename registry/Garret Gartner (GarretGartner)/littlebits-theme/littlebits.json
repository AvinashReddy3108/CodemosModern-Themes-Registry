    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "string.comment"],
            "settings": { "foreground": "#797D8AAB" }
        },
        {
            "name": "String",
            "scope": ["string", "string.template"],
            "settings": { "foreground": "#F7D061" }
        },
        {
            "name": "Number",
            "scope": "constant.numeric",
            "settings": { "foreground": "#F08858" }
        },
        {
            "name": "Embedded String Begin/End",
            "scope": [
                "string.embedded.begin",
                "string.embedded.end",
                "punctuation.definition.template-expression",
                "punctuation.section.embedded"
            ],
            "settings": { "foreground": "#7895DD" }
        },
        {
            "name": "Default Embedded Color",
            "scope": [
                "punctuation.section.embedded.begin.js",
                "punctuation.section.embedded.end.js",
                "punctuation.section.embedded.begin.erb",
                "punctuation.section.embedded.end.erb",
                "source.elixir.embedded",
                "punctuation.separator",
                "punctuation.accessor",
                "meta.brace"
            ],
            "settings": { "foreground": "#B1BBCB" }
        },
        {
            "name": "Source",
            "scope": ["meta.preprocessor.include.c"],
            "settings": { "foreground": "#F7CA59" }
        },
        {
            "name": "Built-in constant",
            "scope": "constant.language",
            "settings": { "foreground": "#D6376F" }
        },
        {
            "name": "User-defined constant",
            "scope": ["constant.character", "constant.other"],
            "settings": { "foreground": "#B459FF" }
        },
        {
            "name": "Language Variable",
            "scope": "variable.language",
            "settings": { "foreground": "#7FF2FF" }
        },
        {
            "name": "Keyword",
            "scope": [
                "keyword",
                "keyword.operator.logical",
                "keyword.operator.constructor"
            ],
            "settings": { "foreground": "#FF7D74" }
        },
        {
            "name": "Keyword Operator",
            "scope": "keyword.operator",
            "settings": { "foreground": "#FF7D74" }
        },
        {
            "name": "Storage",
            "scope": "storage",
            "settings": { "foreground": "#6BBBD2" }
        },
        {
            "name": "Types",
            "scope": "storage.type",
            "settings": { "foreground": "#AF77CE" }
        },
        {
            "name": "Enclosed",
            "scope": ["meta.conditional.switch.c", "meta.parens.block.c"],
            "settings": { "foreground": "#75C2CC" }
        },
        {
            "name": "Class",
            "scope": [
                "entity.name.class",
                "entity.name.module",
                "entity.name.type",
                "storage.identifier",
                "support.class"
            ],
            "settings": { "foreground": "#E8ABBE", "fontStyle": "italic" }
        },
        {
            "name": "Variable Object",
            "scope": [
                "variable.other.object",
                "variable.other.constant",
                "variable.other.global",
                "variable.other.readwrite.class",
                "variable.other.readwrite.instance",
                "variable.other.readwrite.batchfile",
                "variable.readwrite",
                "variable.readwrite.other.block"
            ],
            "settings": { "foreground": "#7FF2FF" }
        },
        {
            "name": "Other variable",
            "scope": [
                "variable.other",
                "variable.other.property",
                "variable.other.block"
            ],
            "settings": { "foreground": "#768CC2" }
        },
        {
            "name": "Other variable - MK",
            "scope": ["variable.other.makefile"],
            "settings": { "foreground": "#FF695E" }
        },
        {
            "name": "Inherited Class",
            "scope": "entity.other.inherited-class",
            "settings": { "foreground": "#5EAD5A" }
        },
        {
            "name": "Package Import",
            "scope": ["storage.modifier.import", "storage.modifier.package"],
            "settings": { "foreground": "#F06969" }
        },
        {
            "name": "Function name",
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#6EAB78" }
        },
        {
            "name": "Function Name - Defined",
            "scope": ["entity.name.function.preprocessor"],
            "settings": { "foreground": "#78A4E8" }
        },
        {
            "name": "Function argument",
            "scope": [
                "variable.parameter",
                "entity.name.variable.parameter",
                "parameter.variable"
            ],
            "settings": { "fontStyle": "italic", "foreground": "#E77E41" }
        },
        {
            "name": "Function call",
            "scope": ["entity.name.function-call", "meta.function.c"],
            "settings": { "foreground": "#D4D4D5" }
        },
        {
            "name": "Storage - Modifier",
            "scope": ["storage.modifier.c"],
            "settings": { "foreground": "#F7CD49" }
        },
        {
            "name": "Builtin Functions",
            "scope": ["function.support.builtin", "function.support.core"],
            "settings": { "foreground": "#569EC4" }
        },
        {
            "name": "Tag Name",
            "scope": ["entity.name.tag", "entity.name.tag.class.js"],
            "settings": { "foreground": "#FF5454" }
        },
        {
            "name": "Tag Class and ID",
            "scope": ["entity.name.tag.class", "entity.name.tag.id"],
            "settings": { "foreground": "#44BFC7" }
        },
        {
            "name": "Tag Attribute",
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#4499C7" }
        },
        {
            "name": "Library constant",
            "scope": "support.constant",
            "settings": { "foreground": "#F77488" }
        },
        {
            "name": "Library class/type",
            "scope": ["support.type", "support.variable"],
            "settings": { "foreground": "#FFC271" }
        },
        {
            "name": "Json Property",
            "scope": "support.dictionary.json",
            "settings": { "foreground": "#F16C55" }
        },
        {
            "name": "StyleSheet Property name",
            "scope": [
                "support.type.property-name.css",
                "support.type.property-name.scss",
                "support.type.property-name.less",
                "support.type.property-name.sass"
            ],
            "settings": { "foreground": "#72C76C" }
        },
        {
            "name": "CSS: Pseudo Attribute Names",
            "scope": [
                "entity.other.attribute-name.pseudo-class.css",
                "entity.other.attribute-name.pseudo-class.scss",
                "entity.other.attribute-name.pseudo-class.less",
                "entity.other.attribute-name.pseudo-class.sass",
                "entity.other.attribute-name.pseudo-element.css",
                "entity.other.attribute-name.pseudo-element.scss",
                "entity.other.attribute-name.pseudo-element.less",
                "entity.other.attribute-name.pseudo-element.sass"
            ],
            "settings": { "foreground": "#FF5454" }
        },
        {
            "name": "StyleSheet Property value",
            "scope": [
                "support.constant.css",
                "support.constant.scss",
                "support.constant.less",
                "support.constant.sass"
            ],
            "settings": { "foreground": "#4499C7" }
        },
        {
            "name": "StyleSheet Variable",
            "scope": [
                "variable.css",
                "variable.scss",
                "variable.less",
                "variable.sass"
            ],
            "settings": { "foreground": "#E27E4D" }
        },
        {
            "name": "StyleSheet Variable String",
            "scope": [
                "variable.css.string",
                "variable.scss.string",
                "variable.less.string",
                "variable.sass.string"
            ],
            "settings": { "foreground": "#ECCA42" }
        },
        {
            "name": "StyleSheet Unit",
            "scope": ["unit.css", "unit.scss", "unit.less", "unit.sass"],
            "settings": { "foreground": "#56b6c2" }
        },
        {
            "name": "StyleSheet Function",
            "scope": [
                "function.css",
                "function.scss",
                "function.less",
                "function.sass"
            ],
            "settings": { "foreground": "#D25D5D" }
        },
        {
            "name": "Library variable",
            "scope": "support.other.variable",
            "settings": { "foreground": "#66CCAD" }
        },
        {
            "name": "Invalid",
            "scope": "invalid",
            "settings": { "foreground": "#b32400" }
        },
        {
            "name": "Invalid deprecated",
            "scope": "invalid.deprecated",
            "settings": { "foreground": "#FFB04F" }
        },
        {
