{
    "name": "M0RX Dark",
    "type": "dark",
    "colors": {
        "editor.background": "#0d1117",
        "editor.foreground": "#c9d1d9",
        "activityBarBadge.background": "#58a6ff",
        "sideBarTitle.foreground": "#bbbbbb",
        "statusBar.background": "#161b22",
        "statusBar.foreground": "#58a6ff"
    },
    "tokenColors": [
        {
            "name": "Keywords",
            "scope": "keyword.control.m0rx, keyword.declaration.m0rx",
            "settings": { "foreground": "#ff7b72" }
        },
        {
            "name": "Types",
            "scope": "storage.type.m0rx",
            "settings": { "foreground": "#79c0ff" }
        },
        {
            "name": "Functions",
            "scope": "entity.name.function.m0rx",
            "settings": { "foreground": "#d2a8ff" }
        },
        {
            "name": "Strings",
            "scope": "string.quoted.double.m0rx",
            "settings": { "foreground": "#a5d6ff" }
        },
        {
            "name": "Numbers",
            "scope": "constant.numeric.m0rx",
            "settings": { "foreground": "#79c0ff" }
        },
        {
            "name": "Comments",
            "scope": "comment.line.m0rx, comment.block.m0rx",
            "settings": { "foreground": "#8b949e", "fontStyle": "italic" }
        },
        {
            "name": "Constants",
            "scope": "constant.language.m0rx",
            "settings": { "foreground": "#79c0ff" }
        },
        {
            "name": "AI Keywords",
            "scope": "keyword.ai.m0rx",
            "settings": { "foreground": "#ffa657" }
        },
        {
            "name": "Backend Keywords",
            "scope": "keyword.backend.m0rx",
            "settings": { "foreground": "#7ee787" }
        },
        {
            "name": "Operators",
            "scope": "keyword.operator.m0rx",
            "settings": { "foreground": "#ff7b72" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
