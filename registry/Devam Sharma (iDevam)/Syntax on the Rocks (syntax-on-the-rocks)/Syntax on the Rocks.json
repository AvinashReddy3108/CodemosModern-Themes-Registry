{
    "$schema": "vscode://schemas/color-theme",
    "name": "Syntax on the Rocks",
    "type": "dark",
    "semanticHighlighting": true,
    "colors": {
        "activityBar.background": "#0B0C10",
        "activityBar.foreground": "#c4b8b0",
        "activityBar.inactiveForeground": "#8a7d75",
        "activityBarBadge.background": "#fb923c",
        "activityBarBadge.foreground": "#020617",
        "badge.background": "#f973162e",
        "badge.foreground": "#fdba74",
        "button.background": "#fdba74",
        "button.foreground": "#020617",
        "button.hoverBackground": "#fb923c",
        "editor.background": "#0f172a",
        "editor.foreground": "#ffffff",
        "editorCursor.foreground": "#fdba74",
        "editorGroup.border": "#f973162e",
        "editorLineNumber.foreground": "#8a7d75",
        "editorLineNumber.activeForeground": "#fdba74",
        "editor.selectionBackground": "#f9731640",
        "editor.inactiveSelectionBackground": "#f9731626",
        "editorWhitespace.foreground": "#334155",
        "editorIndentGuide.background": "#f9731626",
        "editorIndentGuide.activeBackground": "#f9731652",
        "editor.lineHighlightBackground": "#ffffff0f",
        "editorLink.foreground": "#fdba74",
        "sideBar.background": "#0B0C10",
        "sideBar.foreground": "#c4b8b0",
        "sideBarTitle.foreground": "#fdba74",
        "statusBar.background": "#fb923c",
        "statusBar.foreground": "#020617",
        "statusBar.noFolderBackground": "#fb923c",
        "statusBar.debuggingBackground": "#fdba74",
        "statusBar.debuggingForeground": "#020617",
        "titleBar.activeBackground": "#020617",
        "titleBar.activeForeground": "#ffffff",
        "titleBar.inactiveBackground": "#0B0C10",
        "titleBar.inactiveForeground": "#c4b8b0",
        "tab.activeBackground": "#0f172a",
        "tab.activeForeground": "#ffffff",
        "tab.inactiveBackground": "#020617",
        "tab.inactiveForeground": "#c4b8b0",
        "tab.border": "#f9731626",
        "tab.activeBorderTop": "#fdba74",
        "terminal.background": "#0f172a",
        "terminal.foreground": "#ffffff",
        "terminalCursor.foreground": "#fdba74",
        "focusBorder": "#fdba74",
        "input.background": "#ffffff0f",
        "input.foreground": "#ffffff",
        "input.border": "#f973162e",
        "inputOption.activeBorder": "#fdba74",
        "dropdown.background": "#020617",
        "dropdown.foreground": "#ffffff",
        "dropdown.border": "#f973162e",
        "list.activeSelectionBackground": "#fdba74",
        "list.activeSelectionForeground": "#020617",
        "list.inactiveSelectionBackground": "#f973162e",
        "list.inactiveSelectionForeground": "#ffffff",
        "list.hoverBackground": "#ffffff12",
        "list.focusForeground": "#fdba74",
        "scrollbarSlider.background": "#f9731633",
        "scrollbarSlider.hoverBackground": "#f9731652",
        "scrollbarSlider.activeBackground": "#fb923c",
        "minimap.background": "#0f172a",
        "widget.shadow": "#00000066",
        "editorWidget.background": "#020617",
        "editorWidget.border": "#f973162e",
        "peekViewTitle.background": "#020617",
        "peekView.border": "#f9731640",
        "notificationCenterHeader.background": "#020617",
        "notifications.background": "#020617",
        "notifications.border": "#f973162e"
    },
    "tokenColors": [
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#8a7d75", "fontStyle": "italic" }
        },
        {
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#fdba74" }
        },
        {
            "scope": ["string", "punctuation.definition.string"],
            "settings": { "foreground": "#fed7aa" }
        },
        {
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#ffffff" }
        },
        {
            "scope": ["entity.name.type", "entity.name.class", "support.type"],
            "settings": { "foreground": "#fb923c" }
        },
        {
            "scope": ["variable", "meta.definition.variable"],
            "settings": { "foreground": "#e2e8f0" }
        },
        {
            "scope": ["constant.numeric", "constant.language"],
            "settings": { "foreground": "#fed7aa" }
        }
    ]
}
