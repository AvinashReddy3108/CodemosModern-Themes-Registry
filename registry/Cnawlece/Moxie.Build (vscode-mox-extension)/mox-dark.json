{
    "name": "mox-dark",
    "type": "dark",
    "colors": {
        "editor.background": "#000000",
        "editor.foreground": "#FFFFFF"
    },
    "tokenColors": [
        { "settings": { "foreground": "#FFFFFF", "background": "#000000" } },
        {
            "name": "Grey",
            "scope": ["extra.inside-double-quotes.colors.mox"],
            "settings": { "foreground": "#888888" }
        },
        {
            "name": "Red",
            "scope": [
                "database-functions.colors.mox",
                "extra.numbers.colors.mox"
            ],
            "settings": { "foreground": "#E20000" }
        },
        {
            "name": "Gold",
            "scope": ["operators.colors.mox"],
            "settings": { "foreground": "#FF8000" }
        },
        {
            "name": "Blue",
            "scope": [
                "keywords.colors.mox",
                "attributes.colors.mox",
                "top-query-functions.colors.mox"
            ],
            "settings": { "foreground": "#0000C8" }
        },
        {
            "name": "Green",
            "scope": ["comments.block.colors.mox", "comments.line.colors.mox"],
            "settings": { "foreground": "#008080" }
        },
        {
            "name": "Brown",
            "scope": ["built-in-variables.colors.mox"],
            "settings": { "foreground": "#804040" }
        },
        {
            "name": "Purple",
            "scope": ["work-query-functions.colors.mox"],
            "settings": { "foreground": "#740f8e" }
        }
    ],
    "$schema": "vscode://schemas/color-theme"
}
