    "tokenColors": [
        {
            "scope": [
                "comment",
                "punctuation.definition.comment",
                "string.comment"
            ],
            "settings": { "foreground": "#666666", "fontStyle": "italic" }
        },
        {
            "scope": [
                "constant",
                "entity.name.constant",
                "variable.other.constant",
                "variable.language"
            ],
            "settings": { "foreground": "#FF7EDE" }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.language",
                "support.constant",
                "constant.character",
                "variable.parameter",
                "keyword.other.unit"
            ],
            "settings": { "foreground": "#FF7EDE" }
        },
        {
            "scope": ["entity", "entity.name"],
            "settings": { "foreground": "#74F4FD" }
        },
        {
            "scope": [
                "entity.name.function",
                "support.function",
                "entity.name.tag"
            ],
            "settings": { "foreground": "#74F4FD", "fontStyle": "bold" }
        },
        {
            "scope": [
                "entity.name.type",
                "entity.other.attribute-name",
                "support.type",
                "support.class",
                "meta.tag"
            ],
            "settings": { "foreground": "#FF7EDE" }
        },
        {
            "scope": ["entity.other.inherited-class"],
            "settings": { "foreground": "#FF7EDE", "fontStyle": "italic" }
        },
        {
            "scope": ["variable", "string constant.other.placeholder"],
            "settings": { "foreground": "#FFFFFF" }
        },
        {
            "scope": ["variable.parameter.function"],
            "settings": { "foreground": "#FFFFFF" }
        },
        {
            "scope": [
                "variable.other.object",
                "variable.other.object.property"
            ],
            "settings": { "foreground": "#FFFFFF" }
        },
        {
            "scope": ["variable.other.readwrite.alias"],
            "settings": { "foreground": "#FF7EDE" }
        },
        {
            "scope": [
                "keyword",
                "storage.type",
                "storage.modifier",
                "keyword.operator.expression"
            ],
            "settings": { "foreground": "#74F4FD", "fontStyle": "bold" }
        },
        {
            "scope": ["keyword.control", "keyword.operator.new"],
            "settings": { "foreground": "#74F4FD", "fontStyle": "bold" }
        },
        {
            "scope": ["keyword.other.unit"],
            "settings": { "foreground": "#FF7EDE" }
        },
        {
            "scope": ["string", "entity.other.inherited-class"],
            "settings": { "foreground": "#FF7EDE" }
        },
        {
            "scope": [
                "string.quoted.double.html",
                "string.quoted.single.html",
                "string.unquoted.html",
                "punctuation.definition.string.begin.html",
                "punctuation.definition.string.end.html"
            ],
            "settings": { "foreground": "#FF7EDE" }
        },
        {
            "scope": [
                "string.quoted.double.xml",
                "string.quoted.single.xml",
                "string.unquoted.xml",
                "punctuation.definition.string.begin.xml",
                "punctuation.definition.string.end.xml"
            ],
            "settings": { "foreground": "#FF7EDE" }
        },
        {
            "scope": ["storage"],
            "settings": { "foreground": "#74F4FD", "fontStyle": "bold" }
        },
        {
            "scope": ["meta.preprocessor", "entity.name.function.preprocessor"],
            "settings": { "foreground": "#FFB86C" }
        },
        {
            "scope": ["markup.heading", "markup.bold"],
            "settings": { "fontStyle": "bold", "foreground": "#74F4FD" }
        },
        {
            "scope": ["markup.heading entity.name"],
            "settings": { "fontStyle": "bold", "foreground": "#74F4FD" }
        },
        { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
        {
            "scope": ["markup.code", "markup.inline.raw"],
            "settings": { "foreground": "#FF7EDE" }
        },
        { "scope": ["markup.quote"], "settings": { "foreground": "#666666" } },
        {
            "scope": ["markup.changed"],
            "settings": { "foreground": "#74F4FD" }
        },
        {
            "scope": ["markup.inserted"],
            "settings": { "foreground": "#FF7EDE" }
        },
        {
            "scope": ["markup.deleted"],
            "settings": { "foreground": "#FF5555" }
        },
        {
            "scope": ["markup.ignored", "markup.untracked"],
            "settings": { "foreground": "#666666" }
        },
        {
            "scope": ["punctuation.definition.list.begin.markdown"],
            "settings": { "foreground": "#FF7EDE" }
        },
        {
            "scope": ["meta.separator"],
            "settings": { "foreground": "#74F4FD", "fontStyle": "bold" }
        },
        {
            "scope": ["string.regexp", "constant.character.escape"],
            "settings": { "foreground": "#FF7EDE" }
        },
        {
            "scope": ["source.css string", "source.scss string"],
            "settings": { "foreground": "#FF7EDE" }
        },
        {
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.class.mixin.css"
            ],
            "settings": { "foreground": "#FF7EDE" }
        },
        {
            "scope": [
                "support.type.property-name.css",
                "support.type.property-name.scss",
                "support.type.property-name.less"
            ],
            "settings": { "foreground": "#FFFFFF" }
        },
        {
            "scope": [
                "entity.name.tag.css",
                "entity.name.tag.less",
                "entity.name.tag.custom.css"
            ],
            "settings": { "foreground": "#74F4FD" }
        },
        {
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#FFFFFF" }
        },
        {
            "scope": ["string.quoted.double.json"],
            "settings": { "foreground": "#FF7EDE" }
        },
        {
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#FF5555", "fontStyle": "underline" }
        },
        {
            "scope": ["invalid.deprecated"],
            "settings": {
                "foreground": "#FF5555",
                "fontStyle": "italic underline"
            }
        },
        {
            "scope": [
                "brackethighlighter.tag",
                "brackethighlighter.curly",
                "brackethighlighter.round",
                "brackethighlighter.square",
                "brackethighlighter.angle",
                "brackethighlighter.quote"
            ],
            "settings": { "foreground": "#666666" }
        },
        {
            "scope": ["brackethighlighter.unmatched"],
            "settings": { "foreground": "#FF5555" }
        }
    ]
}
