    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#8A8980", "fontStyle": "italic" }
        },
        {
            "name": "Strings",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#1D7A55" }
        },
        {
            "name": "String Escape Characters",
            "scope": ["constant.character.escape"],
            "settings": { "foreground": "#2A9A70" }
        },
        {
            "name": "Numbers",
            "scope": [
                "constant.numeric",
                "constant.numeric.integer",
                "constant.numeric.float",
                "constant.numeric.hex"
            ],
            "settings": { "foreground": "#B06020" }
        },
        {
            "name": "Constants",
            "scope": [
                "constant",
                "constant.language",
                "constant.language.boolean"
            ],
            "settings": { "foreground": "#B06020" }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.expression"
            ],
            "settings": { "foreground": "#5C5400" }
        },
        {
            "name": "Control Flow Keywords",
            "scope": [
                "keyword.control.flow",
                "keyword.control.conditional",
                "keyword.control.loop"
            ],
            "settings": { "foreground": "#5C5400", "fontStyle": "bold" }
        },
        {
            "name": "Operators",
            "scope": [
                "keyword.operator",
                "keyword.operator.assignment",
                "keyword.operator.arithmetic",
                "keyword.operator.logical"
            ],
            "settings": { "foreground": "#64635C" }
        },
        {
            "name": "Storage Types",
            "scope": ["storage", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#5C5400" }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "meta.function-call",
                "support.function"
            ],
            "settings": { "foreground": "#2850A0" }
        },
        {
            "name": "Function Parameters",
            "scope": ["variable.parameter", "meta.parameter"],
            "settings": { "foreground": "#3A3930", "fontStyle": "italic" }
        },
        {
            "name": "Classes and Types",
            "scope": [
                "entity.name.class",
                "entity.name.type",
                "support.class",
                "support.type"
            ],
            "settings": { "foreground": "#5A5500" }
        },
        {
            "name": "Interfaces",
            "scope": ["entity.name.type.interface"],
            "settings": { "foreground": "#5A5500", "fontStyle": "italic" }
        },
        {
            "name": "Type Parameters (Generics)",
            "scope": ["entity.name.type.parameter"],
            "settings": { "foreground": "#8050A0" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "variable.other"],
            "settings": { "foreground": "#100F0F" }
        },
        {
            "name": "Variable Properties",
            "scope": [
                "variable.other.property",
                "variable.other.object.property"
            ],
            "settings": { "foreground": "#3A3930" }
        },
        {
            "name": "Language Variables (this, self, super)",
            "scope": ["variable.language"],
            "settings": { "foreground": "#5C5400", "fontStyle": "italic" }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation",
                "punctuation.definition",
                "punctuation.separator",
                "punctuation.terminator"
            ],
            "settings": { "foreground": "#64635C" }
        },
        {
            "name": "Brackets",
            "scope": [
                "punctuation.definition.block",
                "punctuation.brackets",
                "meta.brace"
            ],
            "settings": { "foreground": "#64635C" }
        },
        {
            "name": "Tags (HTML/XML)",
            "scope": ["entity.name.tag", "punctuation.definition.tag"],
            "settings": { "foreground": "#5C5400" }
        },
        {
            "name": "Tag Attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#2850A0", "fontStyle": "italic" }
        },
        {
            "name": "CSS Selectors",
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css"
            ],
            "settings": { "foreground": "#5A5500" }
        },
        {
            "name": "CSS Properties",
            "scope": ["support.type.property-name.css"],
            "settings": { "foreground": "#2850A0" }
        },
        {
            "name": "CSS Values",
            "scope": ["support.constant.property-value.css"],
            "settings": { "foreground": "#1D7A55" }
        },
        {
            "name": "CSS Units",
            "scope": ["keyword.other.unit.css"],
            "settings": { "foreground": "#B06020" }
        },
        {
            "name": "Regex",
            "scope": ["string.regexp"],
            "settings": { "foreground": "#8050A0" }
        },
        {
            "name": "Embedded Code (Template Literals)",
            "scope": [
                "punctuation.definition.template-expression",
                "punctuation.section.embedded"
            ],
            "settings": { "foreground": "#5C5400" }
        },
        {
            "name": "Embedded Expression",
            "scope": ["meta.embedded", "source.embedded"],
            "settings": { "foreground": "#100F0F" }
        },
        {
            "name": "JSON Keys",
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#2850A0" }
        },
        {
            "name": "Markdown Headings",
            "scope": [
                "heading.1.markdown",
                "heading.2.markdown",
                "heading.3.markdown",
                "heading.4.markdown",
                "heading.5.markdown",
                "heading.6.markdown",
                "markup.heading"
            ],
            "settings": { "foreground": "#5C5400", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Bold",
            "scope": ["markup.bold"],
            "settings": { "foreground": "#B06020", "fontStyle": "bold" }
        },
        {
            "name": "Markdown Italic",
            "scope": ["markup.italic"],
            "settings": { "foreground": "#8050A0", "fontStyle": "italic" }
        },
        {
            "name": "Markdown Links",
            "scope": ["markup.underline.link", "string.other.link"],
            "settings": { "foreground": "#2850A0" }
        },
        {
            "name": "Markdown Code",
            "scope": ["markup.inline.raw", "markup.fenced_code.block"],
            "settings": { "foreground": "#1D7A55" }
        },
        {
            "name": "Markdown Quote",
            "scope": ["markup.quote"],
            "settings": { "foreground": "#8A8980", "fontStyle": "italic" }
        },
        {
            "name": "Markdown List",
            "scope": ["markup.list", "punctuation.definition.list"],
            "settings": { "foreground": "#64635C" }
        },
        {
            "name": "Import/Export",
            "scope": [
                "keyword.control.import",
                "keyword.control.export",
                "keyword.control.from"
            ],
            "settings": { "foreground": "#5C5400" }
        },
        {
            "name": "Module Names",
            "scope": ["entity.name.type.module", "entity.name.namespace"],
            "settings": { "foreground": "#5A5500" }
        },
        {
            "name": "Decorators / Annotations",
            "scope": ["meta.decorator", "punctuation.decorator"],
            "settings": { "foreground": "#8050A0" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#C04030", "fontStyle": "underline" }
        },
        {
            "name": "Deprecated",
            "scope": ["invalid.deprecated"],
            "settings": {
                "foreground": "#B06020",
                "fontStyle": "strikethrough"
            }
        },
        {
            "name": "Diff Inserted",
            "scope": ["markup.inserted", "punctuation.definition.inserted"],
            "settings": { "foreground": "#1D7A55" }
        },
        {
            "name": "Diff Deleted",
            "scope": ["markup.deleted", "punctuation.definition.deleted"],
            "settings": { "foreground": "#C04030" }
        },
        {
            "name": "Diff Changed",
            "scope": ["markup.changed", "punctuation.definition.changed"],
            "settings": { "foreground": "#5C5400" }
        },
        {
            "name": "YAML Keys",
            "scope": ["entity.name.tag.yaml"],
            "settings": { "foreground": "#2850A0" }
        },
        {
            "name": "TOML Keys",
            "scope": ["keyword.key.toml"],
            "settings": { "foreground": "#2850A0" }
        },
        {
            "name": "SQL Keywords",
            "scope": ["keyword.other.sql", "keyword.other.DML.sql"],
            "settings": { "foreground": "#5C5400" }
        },
        {
            "name": "Shell Variables",
            "scope": [
                "variable.other.normal.shell",
                "variable.other.positional.shell"
            ],
            "settings": { "foreground": "#B06020" }
        },
        {
            "name": "Shell Commands",
            "scope": ["support.function.builtin.shell"],
            "settings": { "foreground": "#2850A0" }
        },
        {
            "name": "Python Self",
            "scope": [
                "variable.parameter.function.language.special.self.python"
            ],
            "settings": { "foreground": "#5C5400", "fontStyle": "italic" }
        },
        {
            "name": "Python Magic Methods",
            "scope": ["support.function.magic.python"],
            "settings": { "foreground": "#8050A0" }
        },
        {
            "name": "Go Package",
            "scope": ["entity.name.package.go"],
            "settings": { "foreground": "#5A5500" }
        },
        {
            "name": "Rust Lifetime",
            "scope": ["storage.modifier.lifetime.rust"],
            "settings": { "foreground": "#8050A0", "fontStyle": "italic" }
        },
        {
            "name": "Rust Macro",
            "scope": ["entity.name.function.macro.rust"],
            "settings": { "foreground": "#8050A0" }
        },
        {
            "name": "C# Preprocessor",
            "scope": ["meta.preprocessor.cs"],
            "settings": { "foreground": "#8A8980" }
        },
        {
            "name": "JSX/TSX Component",
            "scope": [
                "support.class.component.tsx",
                "support.class.component.jsx"
            ],
            "settings": { "foreground": "#5A5500" }
        },
        {
            "name": "TypeScript Type Assertion",
            "scope": ["meta.type.annotation.ts", "meta.type.annotation.tsx"],
            "settings": { "foreground": "#5A5500" }
        },
        {
            "name": "Documentation Comments",
            "scope": ["comment.block.documentation", "comment.block.javadoc"],
            "settings": { "foreground": "#7A796F", "fontStyle": "italic" }
        },
        {
            "name": "Documentation Tags",
            "scope": [
                "storage.type.class.jsdoc",
                "punctuation.definition.block.tag.jsdoc"
            ],
            "settings": { "foreground": "#5C5400" }
        },
        {
            "name": "Documentation Variable",
            "scope": ["variable.other.jsdoc"],
            "settings": { "foreground": "#2850A0", "fontStyle": "italic" }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "class": "#5A5500",
        "interface": { "foreground": "#5A5500", "fontStyle": "italic" },
        "enum": "#5A5500",
        "enumMember": "#B06020",
        "struct": "#5A5500",
        "type": "#5A5500",
        "typeParameter": "#8050A0",
        "parameter": { "foreground": "#3A3930", "fontStyle": "italic" },
        "variable": "#100F0F",
        "variable.readonly": "#B06020",
        "variable.defaultLibrary": "#5C5400",
        "property": "#3A3930",
        "property.readonly": "#B06020",
        "function": "#2850A0",
        "function.defaultLibrary": "#2850A0",
        "method": "#2850A0",
        "macro": "#8050A0",
        "namespace": "#5A5500",
        "keyword": "#5C5400",
        "modifier": "#5C5400",
        "comment": { "foreground": "#8A8980", "fontStyle": "italic" },
        "string": "#1D7A55",
        "number": "#B06020",
        "regexp": "#8050A0",
        "operator": "#64635C",
        "decorator": "#8050A0"
    }
}
