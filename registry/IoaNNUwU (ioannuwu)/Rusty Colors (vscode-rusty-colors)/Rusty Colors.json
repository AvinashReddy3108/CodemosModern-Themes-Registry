            "settings": { "foreground": "#de8373" }
        },
        {
            "scope": [
                "support.variable.magic.python",
                "support.function.magic.python",
                "entity.name.function.constructor.cpp"
            ],
            "settings": { "foreground": "#de8373", "fontStyle": "bold italic" }
        },
        {
            "scope": ["constant.numeric.decimal", "constant.numeric"],
            "settings": { "foreground": "#69b6ba" }
        },
        {
            "scope": [
                "entity.name.namespace",
                "entity.name.module.rust",
                "string.quoted.other.lt-gt.include.cpp",
                "entity.name.scope-resolution.cpp",
                "entity.name.scope-resolution.function.call.cpp",
                "entity.name.scope-resolution.parameter.cpp",
                "meta.preprocessor.include.cpp",
                "entity.name.type.namespace.cs",
                "storage.modifier.import.java",
                "markup.underline.link.markdown",
                "markup.underline.link.image.markdown",
                "entity.name.package.go"
            ],
            "settings": { "foreground": "#70a9b9" }
        },
        {
            "scope": [
                "entity.name.type.template.cpp",
                "meta.template.call.cpp",
                "variable.language.generic-parameter.swift"
            ],
            "settings": { "foreground": "#57bdbb" }
        },
        {
            "scope": [
                "meta.function.call",
                "entity.name.function.call",
                "entity.name.function.member.cpp",
                "entity.name.function.cs",
                "entity.name.function.java",
                "entity.name.function.declaration.kotlin",
                "meta.function-call",
                "entity.other.attribute-name.pseudo-class.css",
                "string.other.link.title.markdown",
                "string.other.link.description.markdown",
                "support.function.go",
                "entity.name.command.shell",
                "support.function.swift"
            ],
            "settings": { "foreground": "#7cc2d5" }
        },
        {
            "scope": [
                "entity.name.function.preprocessor.cpp",
                "support.function.misc.css"
            ],
            "settings": { "foreground": "#7b97d2" }
        },
        {
            "scope": [
                "entity.name.function.macro.rust",
                "variable.other.metavariable.name.rust"
            ],
            "settings": { "foreground": "#6797ff" }
        },
        {
            "scope": [
                "variable.constant.other",
                "constant.other.caps",
                "variable.other.global.cpp",
                "entity.name.function.preprocessor.c"
            ],
            "settings": { "foreground": "#7b97d2" }
        },
        {
            "scope": [
                "variable.other.property",
                "support.variable.property",
                "entity.other.attribute-name",
                "entity.name.variable.property.cs",
                "variable.other.object.property",
                "support.type.property-name.css",
                "support.type.property-name.json",
                "support.type.property-name.toml",
                "markup.inline.raw.string.markdown",
                "string.unquoted.go.mod",
                "variable.other.proto",
                "support.other.proto",
                "meta.attribute.python",
                "variable.other.readwrite.batchfile",
                "punctuation.definition.variable.batchfile",
                "variable.other.normal.shell",
                "variable.other.assignment.shell"
            ],
            "settings": { "foreground": "#95acbd" }
        },
        {
            "scope": [
                "variable.language.self.rust",
                "variable.language.this",
                "variable.parameter.function.language.special.self.python",
                "variable.language.special.self.python"
            ],
            "settings": { "foreground": "#91a4d0" }
        },
        {
            "scope": ["markup.bold.markdown"],
            "settings": { "fontStyle": "bold" }
        },
        {
            "scope": ["markup.italic.markdown"],
            "settings": { "fontStyle": "italic" }
        },
        {
            "scope": [
                "entity.name.type.trait.rust",
                "entity.name.type.interface.cs",
                "punctuation.definition.annotation"
            ],
            "settings": { "foreground": "#82c67c" }
        },
        {
            "scope": [
                "punctuation.definition.lifetime.rust",
                "entity.name.type.lifetime.rust"
            ],
            "settings": { "foreground": "#798fde" }
        },
        {
            "scope": [
                "entity.name.type.option.rust",
                "entity.name.variable.enum-member",
                "constant.other.enum.java",
                "variable.other.enummember.swift"
            ],
            "settings": { "foreground": "#91a4d0" }
        },
        {
            "scope": ["entity.name.type.enum"],
            "settings": { "foreground": "#6ec0d9" }
        }
    ],
    "semanticTokenColors": {
        "keyword.unsafe": "#E06C75",
        "variable.constant": "#7b97d2",
        "builtinType": "#d9a958",
        "boolean": "#d9a958",
        "interface": "#82c67c",
        "enum": "#6ec0d9",
        "enumMember": "#91a4d0",
        "method.static": "#e08b83",
        "property": "#95acbd",
        "lifetime": "#798fde",
        "function.async": "#c581c4",
        "keyword.async": "#d9a958",
        "typeParameter": "#57bdbb",
        "typeAlias": "#de8373",
        "selfKeyword": "#91a4d0",
        "selfTypeKeyword": "#91a4d0",
        "regexp": { "color": "#D19A66", "fontStyle": "bold" },
        "tomlTableKey": "#95acbd",
        "tomlArrayKey": "#95acbd",
        "*.mutable": { "fontStyle": "underline" },
        "function.static": "#cf7664",
        "function.injected": "#74c9e0",
        "struct.injected": "#de8373",
        "namespace.injected": "#70a9b9",
        "macro.injected": "#6797ff",
        "string.injected": "#c2915f",
        "keyword.injected": "#d9a958",
        "comment.injected": "#5fc26e",
        "enumMember.injected": "#91a4d0",
        "enum.injected": "#6ec0d9",
        "typeAlias.injected": "#6ec0d9",
        "*.injected": "#bbb",
        "decorator": "#D4D4D4",
        "type": "#de8373",
        "function.declaration": "#de8373",
        "method.declaration": "#de8373"
    }
}
