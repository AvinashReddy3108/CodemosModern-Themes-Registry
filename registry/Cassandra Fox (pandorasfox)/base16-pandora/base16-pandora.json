    "tokenColors": [
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#FFBEE3", "fontStyle": "italic" }
        },
        {
            "scope": [
                "variable",
                "string constant.other.placeholder",
                "entity.name.variable.parameter",
                "entity.name.variable.local",
                "variable.parameter"
            ],
            "settings": { "foreground": "#B00B69" }
        },
        {
            "scope": ["variable.other.object.property"],
            "settings": { "foreground": "#008080" }
        },
        {
            "scope": ["constant.other.color"],
            "settings": { "foreground": "#9DDF69" }
        },
        {
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#B00B69" }
        },
        {
            "scope": ["invalid.deprecated"],
            "settings": { "foreground": "#A24030" }
        },
        {
            "scope": ["keyword", "storage.modifier"],
            "settings": { "foreground": "#A24030" }
        },
        {
            "scope": [
                "keyword.control",
                "keyword.control.flow",
                "keyword.control.from",
                "keyword.control.import",
                "keyword.control.as"
            ],
            "settings": { "foreground": "#A24030" }
        },
        {
            "scope": [
                "keyword.other.using",
                "keyword.other.namespace",
                "keyword.other.class",
                "keyword.other.new",
                "keyword.other.event",
                "keyword.other.this",
                "keyword.other.await",
                "keyword.other.var",
                "keyword.other.package",
                "keyword.other.import",
                "variable.language.this",
                "storage.type.ts"
            ],
            "settings": { "foreground": "#A24030" }
        },
        {
            "scope": ["keyword.type", "storage.type.primitive"],
            "settings": { "foreground": "#714CA6" }
        },
        {
            "scope": ["storage.type.function"],
            "settings": { "foreground": "#008080" }
        },
        {
            "scope": [
                "constant.other.color",
                "punctuation",
                "punctuation.section.class.end",
                "meta.tag",
                "punctuation.definition.tag",
                "punctuation.separator.inheritance.php",
                "punctuation.definition.tag.html",
                "punctuation.definition.tag.begin.html",
                "punctuation.definition.tag.end.html",
                "keyword.other.template",
                "keyword.other.substitution"
            ],
            "settings": { "foreground": "#F15C99" }
        },
        {
            "scope": ["punctuation.section.embedded", "variable.interpolation"],
            "settings": { "foreground": "#A24030" }
        },
        {
            "scope": [
                "entity.name.tag",
                "meta.tag.sgml",
                "markup.deleted.git_gutter"
            ],
            "settings": { "foreground": "#B00B69" }
        },
        {
            "scope": [
                "entity.name.function",
                "meta.function-call",
                "variable.function",
                "support.function",
                "keyword.other.special-method"
            ],
            "settings": { "foreground": "#008080" }
        },
        {
            "scope": ["meta.block variable.other"],
            "settings": { "foreground": "#B00B69" }
        },
        {
            "scope": ["support.other.variable", "string.other.link"],
            "settings": { "foreground": "#B00B69" }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.language",
                "support.constant",
                "constant.character",
                "constant.escape",
                "keyword.other.unit",
                "keyword.other"
            ],
            "settings": { "foreground": "#FF9153" }
        },
        {
            "scope": [
                "string",
                "constant.other.symbol",
                "constant.other.key",
                "entity.other.inherited-class",
                "markup.heading",
                "markup.inserted.git_gutter",
                "meta.group.braces.curly constant.other.object.key.js string.unquoted.label.js"
            ],
            "settings": { "foreground": "#9DDF69", "fontStyle": "" }
        },
        {
            "scope": [
                "entity.name",
                "support.type",
                "support.class",
                "support.other.namespace.use.php",
                "meta.use.php",
                "support.other.namespace.php",
                "markup.changed.git_gutter",
                "support.type.sys-types"
            ],
            "settings": { "foreground": "#FFCC00" }
        },
        {
            "scope": [
                "storage.type",
                "storage.modifier.package",
                "storage.modifier.import"
            ],
            "settings": { "foreground": "#FFCC00" }
        },
        {
            "scope": ["entity.name.variable.field"],
            "settings": { "foreground": "#008080" }
        },
        { "scope": ["support.type"], "settings": { "foreground": "#714CA6" } },
        {
            "scope": [
                "source.css support.type.property-name",
                "source.sass support.type.property-name",
                "source.scss support.type.property-name",
                "source.less support.type.property-name",
                "source.stylus support.type.property-name",
                "source.postcss support.type.property-name"
            ],
            "settings": { "foreground": "#714CA6" }
        },
        {
            "scope": [
                "entity.name.module.js",
                "variable.import.parameter.js",
                "variable.other.class.js"
            ],
            "settings": { "foreground": "#B00B69" }
        },
        {
            "scope": ["variable.language"],
            "settings": { "foreground": "#B00B69", "fontStyle": "italic" }
        },
        {
            "scope": ["entity.name.method.js"],
            "settings": { "foreground": "#008080", "fontStyle": "italic" }
        },
        {
            "scope": [
                "meta.class-method.js entity.name.function.js",
                "variable.function.constructor"
            ],
            "settings": { "foreground": "#008080" }
        },
        {
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#008080" }
        },
        {
            "scope": [
                "text.html.basic entity.other.attribute-name.html",
                "text.html.basic entity.other.attribute-name"
            ],
            "settings": { "foreground": "#FFCC00", "fontStyle": "italic" }
        },
        {
            "scope": ["entity.other.attribute-name.class"],
            "settings": { "foreground": "#FFCC00" }
        },
        {
            "scope": ["source.sass keyword.control"],
            "settings": { "foreground": "#008080" }
        },
        {
            "scope": ["markup.inserted"],
            "settings": { "foreground": "#9DDF69" }
        },
        {
            "scope": ["markup.deleted"],
            "settings": { "foreground": "#B00B69" }
        },
        {
            "scope": ["markup.changed"],
            "settings": { "foreground": "#A24030" }
        },
        { "scope": ["string.regexp"], "settings": { "foreground": "#714CA6" } },
        {
            "scope": ["constant.character.escape"],
            "settings": { "foreground": "#714CA6" }
        },
        {
            "scope": ["*url*", "*link*", "*uri*"],
            "settings": { "fontStyle": "underline" }
        },
